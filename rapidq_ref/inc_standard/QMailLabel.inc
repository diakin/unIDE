Declare Function ML_ShellExecute Lib "shell32.dll" Alias "ShellExecuteA" (hwnd As Long, lpOperation As String, lpFile As String, lpParameters As String, lpDirectory As String, nShowCmd As Long) As Long
Type QMailLabel extends QLabel
    Private:
    Param as string
    Public:
    MailTo  as string property Set SetMailTo
    Subject as string property Set SetSubject
    CC      as string property Set SetCC
    
    With This
    
    Property Set SetMailTo(Mail as string)
    If Mail <> .MailTo then
       .MailTo = Mail
       .Param =  Format$("MailTo:%s?Subject=%s&CC=%s",.MailTo,.Subject,.CC)
       .Caption = "e-Mail"
    End If
    End Property
    
    Property Set SetSubject(Subject as string)
    If Subject <> .Subject then
       .Subject = Subject
       .Param = Format$("MailTo:%s?Subject=%s&CC=%s",.MailTo,.Subject,.CC)
    End If
    End Property
    
    Property Set SetCC(CC as string)
    If CC <> .CC then
       .CC = CC
       .Param = Format$("MailTo:%s?Subject=%s&CC=%s",.MailTo,.Subject,.CC)
    End If
    End Property
    
    Sub Initialize
         .Font.Color = &HFF0000
         .Font.AddStyles fsUnderLine
         .Caption = "e-Mail"
         .Cursor = -21
    End Sub
    
    Event OnClick
    If .MailTo <> "" then
       ML_ShellExecute(0, "open", .Param, "", "",1)
       Else
       .Caption = "no address set"
    End If
    End Event
    
    End With
    
    Constructor
    Initialize
    End Constructor
End Type

$ENDIF   ' IncManager: __QMAILLABEL_INC
