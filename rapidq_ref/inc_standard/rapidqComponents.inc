EVENT Timer1.OnTimer
DEFINT i
DEFSNG floatAlias
DEFDBL DoubleAlias
DEFINT IntegerAlias
DEFSTR StrAlias = ""
FOR i = 1 TO This.WatchCount
  SELECT CASE This.Grid.Cell(3 , i)
  CASE "str"
    StrAlias = VARPTR$(VAL(This.Grid.Cell(2 , i)))
    This.Grid.Cell(1 , i) = StrAlias
  CASE "sng"
    MEMCPY(VARPTR(floatAlias) , VAL(This.Grid.Cell(2 , i)) , SIZEOF(SINGLE))
    This.Grid.Cell(1 , i) = STR$(floatAlias)
  CASE "dbl"
    MEMCPY(VARPTR(DoubleAlias) , VAL(This.Grid.Cell(2 , i)) , SIZEOF(DOUBLE))
    This.Grid.Cell(1 , i) = STR$(DoubleAlias)
  CASE ELSE
    MEMCPY(VARPTR(IntegerAlias) , VAL(This.Grid.Cell(2 , i)) , SIZEOF(INTEGER))
    This.Grid.Cell(1 , i) = STR$(IntegerAlias)
  END SELECT
NEXT i
DOEVENTS
END EVENT

FUNCTION CheckMatch(TheAddr AS LONG) AS INTEGER
  DEFINT i , matchs = 0 , n = This.WatchCount
  FOR i = 0 TO n
    IF TheAddr = VAL(This.Grid.Cell(2 , i)) THEN matchs = 1  :  EXIT FOR
  NEXT i

  RESULT = matchs
END FUNCTION

SUBI WatchInt(...)
DEFLNG addr = ParamVal(1)
IF This.CheckMatch(addr) = 0 THEN
  This.WatchCount ++
  IF ParamStrCount > 0 THEN This.Grid.Cell(0 , This.WatchCount) = ParamStr$(1)
  DEFINT i
  MEMCPY(VARPTR(i) , addr , SIZEOF(INTEGER))
  This.Grid.Cell(1 , This.WatchCount) = STR$(i)
  This.Grid.Cell(2 , This.WatchCount) = STR$(addr)
  This.Grid.Cell(3 , This.WatchCount) = "int"
  This.Timer1.Enabled = 1
  This.ReOrder
END IF
END SUBI

