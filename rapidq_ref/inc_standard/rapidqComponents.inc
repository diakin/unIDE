SUB ReSize(TheForm AS QFORM)
    Dim retVal As LONG
    'Get the capture window attributes
    retVal = capGetStatus(This.hCapWnd, This.CapStats, SIZEOF(This.CapStats))
    If retVal Then
        'Resize the parent form to fit
        Call SetWindowPos(TheForm.Handle, _
                    0&, _
                    0&, _
                    0&, _
                    .ImageWidth + (TheForm.Width - TheForm.ClientWidth), _
                    .ImageHeight + (TheForm.Height - TheForm.ClientHeight),_
                    SWP_NOMOVE Or SWP_NOZORDER Or SWP_NOSENDCHANGING)
'        'Resize the capture window to format size
        Call SetWindowPos(.hCapWnd, _
                    0&, _
                    0&, _
                    0&, _
                    .ImageWidth, _
                    .ImageHeight, _
                    SWP_NOMOVE Or SWP_NOZORDER Or SWP_NOSENDCHANGING)
