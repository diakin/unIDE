' NonBlocking: On Read operation, if there is nothing, Read returns nothing (="")

FUNCTION NonBlock(hSocket As LONG) As LONG
    DefInt arg=1
    Result=ioctlsocket(hSocket, FIONBIO, VarPtr(arg))
END FUNCTION
