'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
'' QLineGraph '''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
' Copyright (c) Jonathan Boles 2002 '''''''''''''''''''''''''''''''''''''
'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
' PROPERTIES ''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
' Height      AS Integer    - self explanatory                          '
' Width       AS Integer    -                                           '
' Top         AS Integer    -                                           '
' Left        AS Integer    -                                           '
' ExtrapolateToZero AS Boolean - whether the graph should start at 0,0  '
' AxisColour  AS Integer    - Colour for axes                           '
' TextColour  AS Integer    - Colour for text                           '
' BackColour  AS Integer    - Colour for background                     '
' LineColour  AS Integer    - Colour for plotted line                   ' 
' XTitle      AS String     - X axis title                              '
' YTitle      AS String     - Y axis title                              '
' Title       AS String     - Title for graph                           '
' Data        AS QStringGrid - Graph data, stored in form               '
'                           - x=Data.Cell(0,i) y=Data.Cell(1,i) where   '
'                           - i is an integer                           '
' TextFont    AS QFont      - Font for graph text                       '
' Visible     AS Boolean    -                                           '
' Hint        AS String     -                                           '
' ShowHint    AS Boolean    -                                           '
' Cursor      AS Integer    - Cursor for the graph                      ' 
'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
' METHODS '''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''
' SUB Initialise            - Initialise graphsystem                    '
' SUB SaveToFile            - save graph to .bmp (can't get this 2 work '
'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''

Type QLineGraph extends qobject
    Height as integer
    Width as integer
    Top as integer
    Left as integer
    ExtrapolateToZero as integer
    AxisColour as integer
    TextColour as integer
    BackColour as integer
    XTitle as string*50
    YTitle as string*50
    Title as string*100
    XScale as single
    YScale as single
    LineColour as integer
    Data as qstringgrid
    Visible as integer
    Hint as string*100
    TextFont as qfont
    Cursor as integer
    ShowHint as integer

    image as qcanvas
    maxX as single
    maxY as single
    powerX as integer
    powerY as integer
    roundedupX as long
    roundedupY as long
    
    Constructor
        Left=0
        Width=400
        Top=0
        Height=300
        AxisColour=0
        TextColour=0
        LineColour=&HFF
        BackColour=&HFFFFFF
        XTitle="X Axis"
        YTitle="Y Axis"
        Title="X Axis vs. Y Axis"
        ExtrapolateToZero=1
        Visible=1
    End Constructor

    Sub Paint
        with QLineGraph
        .image.visible=.visible
        .image.hint=.hint
        .image.font=.textfont
        .image.cursor=.cursor
        .image.showhint=.showhint
        ''''''''''' set size''''''''''''''''
        .image.height=.Height
        .image.width=.Width
        .image.left=.Left
        .image.top=.Top
        '''''''''' Clear the canvas '''''''''
        .image.fillrect(0,0, .image.width, .image.height, clWhite)
        '''''''''' write title ''''''''''''''
        .image.textout(int(0.5*.image.width)-int(.image.textwidth(rtrim$(.Title))/2),int(0.02*.image.height), rtrim$(.Title),.TextColour,.BackColour)
        '''''''''' write axis titles ''''''''
        .image.textout(int(0.52*.image.width)-int(.image.textwidth(rtrim$(.XTitle))/2),int(0.93*.image.height),rtrim$(.XTitle),.TextColour,.BackColour) ' inc2026: было textwidth(.YTitle), стало .XTitle: строка выводит XTitle и центрируется по его ширине, как заголовок в строке 102
        .image.textout(int(0.02*.image.width),int(0.45*.image.height),rtrim$(.YTitle),.TextColour,.BackColour)
        '''''''''' draw the axes ''''''''''''
        .image.line(int(0.15*.image.width), int(0.85*.image.height), int(0.9*.image.width), int(0.85*.image.height),.AxisColour) ' inc2026: было AxisColour без точки — необъявленная переменная (0), стало .AxisColour — поле типа (строка 47); в методах поля пишутся через имя типа или WITH (chapter10.html)
        .image.line(int(0.15*.image.width), int(0.1*.image.height), int(0.15*.image.width), int(0.85*.image.height),.AxisColour) ' inc2026: было AxisColour без точки — необъявленная переменная (0), стало .AxisColour — поле типа (строка 47); в методах поля пишутся через имя типа или WITH (chapter10.html)
        '''''''''' calculate scale ''''''''''
        for i=0 to .Data.RowCount
            if val(.Data.Cell(0,i))>.maxX then .maxX=int(val(.Data.Cell(0,i)))+1
        next
        for i=0 to .Data.RowCount
            if val(.Data.Cell(1,i))>.maxY then .maxY=int(val(.Data.Cell(1,i)))+1
        next

        'if int(log(.maxX)/log(10))+1=1 then
        .powerX=int(log(.maxX)/log(10))+1
        for i=10^(.powerX-1) to 10^.powerX step 10^(.powerX-1)
            if i>.maxX then exit for
        next
        .roundedupX=i
        'end if

        'if int(log(.maxY)/log(10))+1=1 then
        .powerY=int(log(.maxY)/log(10))+1
        for i=10^(.powerY-1) to 10^.powerY step 10^(.powerY-1)
            if i>.maxY then exit for
        next
        .roundedupY=i
        'end if
        
        ''''''''' Draw scale ''''''''''''''
        for i=0 to .roundedupX step 10^(.powerX-1)   ''''''''''' X
            .image.pset(int(0.15*.image.width)+(i/.roundedupX*int(0.74*.image.width)),int(0.85*.image.height)+2,.AxisColour) ' inc2026: было AxisColour без точки — необъявленная переменная (0), стало .AxisColour — поле типа (строка 47); в методах поля пишутся через имя типа или WITH (chapter10.html)
            .image.pset(int(0.15*.image.width)+(i/.roundedupX*int(0.74*.image.width)),int(0.85*.image.height)+1,.AxisColour) ' inc2026: было AxisColour без точки — необъявленная переменная (0), стало .AxisColour — поле типа (строка 47); в методах поля пишутся через имя типа или WITH (chapter10.html)
            .image.textout(int(0.15*.image.width)+(i/.roundedupX*int(0.74*.image.width))-.image.textwidth(str$(i))/2,int(0.85*.image.height)+5,str$(i),.TextColour,.BackColour)
        next
        for i=0 to .roundedupY step 10^(.powerY-1)   ''''''''''' Y
            .image.pset(int(0.15*.image.width)-1,int(0.85*.image.height)-(i/.roundedupY*int(0.74*.image.height)),.AxisColour) ' inc2026: было AxisColour без точки — необъявленная переменная (0), стало .AxisColour — поле типа (строка 47); в методах поля пишутся через имя типа или WITH (chapter10.html)
            .image.pset(int(0.15*.image.width)-2,int(0.85*.image.height)-(i/.roundedupY*int(0.74*.image.height)),.AxisColour) ' inc2026: было AxisColour без точки — необъявленная переменная (0), стало .AxisColour — поле типа (строка 47); в методах поля пишутся через имя типа или WITH (chapter10.html)
            .image.textout(int(0.15*.image.width)-5-.image.textwidth(str$(i)),int(0.85*.image.height)-(i/.roundedupY*int(0.74*.image.height))-int(.image.textheight(str$(i))/2),str$(i),.TextColour,.BackColour)
        next
        '''''''''' plot points ''''''''''''
        if .ExtrapolateToZero then ' inc2026: было ExtrapolateToZero без точки — необъявленная переменная (0), стало .ExtrapolateToZero — поле типа (строка 46, по умолчанию 1)
            .image.line(int(0.15*.image.width),int(0.85*.image.height), _
             int(0.15*.image.width)+(val(.Data.Cell(0,0))/.roundedupX*int(0.74*.image.width)),int(0.85*.image.height)-(val(.Data.Cell(1,0))/.roundedupY*int(0.74*.image.height)),.LineColour) ' inc2026: в строке 147 было Cell(0,i) и Cell(1,i) — i осталось после цикла по шкале Y (строка 139), стало строка 0: линия от начала координат к первой точке
        end if
        for i=1 to .Data.RowCount-1
            .image.line(int(0.15*.image.width)+(val(.Data.Cell(0,i-1))/.roundedupX*int(0.74*.image.width)),int(0.85*.image.height)-(val(.Data.Cell(1,i-1))/.roundedupY*int(0.74*.image.height)), _
                   int(0.15*.image.width)+(val(.Data.Cell(0,i))/.roundedupX*int(0.74*.image.width)),int(0.85*.image.height)-(val(.Data.Cell(1,i))/.roundedupY*int(0.74*.image.height)),.LineColour)
        next
        end with
    End Sub         

    Sub Initialise
        with QLineGraph
        QLineGraph.image.height=QLineGraph.Height
        QLineGraph.image.width=QLineGraph.Width
        QLineGraph.image.left=QLineGraph.Left
        QLineGraph.image.top=QLineGraph.Top
        QLineGraph.image.onpaint=QLineGraph.Paint
        .image.visible=.visible
        end with
    End Sub
  
    Sub SaveToFile(file as string)
        with QLineGraph
        dim d as QRect, bmp as qbitmap
        bmp.height=.image.height
        bmp.width=.image.width
        d.top=0
        d.left=0
        d.right=.image.width
        d.bottom=.image.height
        .image.copyrect(d, bmp, d)
        bmp.savetofile(file)
        end with
    end sub

End Type  
'============================================================================
'[build_inc] QGridColor.inc
'============================================================================
'QGridColor v 1.0.0
'Author : Nastase Eodor
'2004
'mail :eodor@idilis.ro

Const st1x16 = 0
Const st2x8  = 1
Const st4x4  = 2

Declare Sub CellClicked
Type QGridColor extends QPanel
     Private:
     Colors(16)     as integer
     SColors(16)    as string
     ColorCells(16) as QPanel
     Public:
     OnCellClick    as Event(CellClicked)
     FGColor        as integer
     BKColor        as integer
     Style          as integer Property Set SetStyle
     ShowCaption    as integer
     ShowHints      as integer Property Set SetShowHint

     Sub LoadColors
     With This
          .Colors(0) = 0               : .SColors(0) = "Black"
          .Colors(1) = &H800000        : .SColors(1) = "Navy"
          .Colors(2) = &H8000          : .SColors(2) = "Green"
          .Colors(3) = &H808000        : .SColors(3) = "Teal"
          .Colors(4) = &H80            : .SColors(4) = "Maroon"
          .Colors(5) = &H800080        : .SColors(5) = "Purple"
          .Colors(6) = &H8080          : .SColors(6) = "Olive"
          .Colors(7) = &HC0C0C0        : .SColors(7) = "Silver"
          .Colors(8) = &H808080        : .SColors(8) = "Gray"
          .Colors(9) = &HFF0000        : .SColors(9) = "Blue"
          .Colors(10) = &HFF00         : .SColors(10) = "Lime"
          .Colors(11) = &HFFFF00       : .SColors(11) = "Aqua"
          .Colors(12) = &HFF           : .SColors(12) = "Red"
          .Colors(13) = &HFF00FF       : .SColors(13) = "Fuchsia"
          .Colors(14) = &HFFFF         : .SColors(14) = "Yellow"
          .Colors(15) = &HFFFFFF       : .SColors(15) = "White"
     End With
     End Sub
     
     Sub CellClick(Button as integer,x as integer,y as integer,Shift as integer,Sender as QPanel)
     Dim i as integer
     With This
          If Button = 0 then
             If .ShowCaption then
                 For i = 0 to 15
                     If .ColorCells(i).Caption <> "BK" then
                        .ColorCells(i).Caption = ""
                     End If
                 Next i
             Sender.Caption = "FG"
             End If
             .FGColor = Sender.Color
             If .OnCellClick <> 0 then CallFunc .OnCellClick
          ElseIf Button = 1 then
             If .ShowCaption then
                For i = 0 to 15
                    If .ColorCells(i).Caption <> "FG" then
                       .ColorCells(i).Caption = ""
                    End If
                Next i
             Sender.Caption = "BK"
             End If
             .BKColor = Sender.Color
             If .OnCellClick <> 0 then CallFunc .OnCellClick
          End If
     End With
     End Sub
     
     Sub Draw
     Dim i as integer
     With This
          .BevelOuter = 0
          If .Style = st1x16 then
              For i = 0 to 15
                  .ColorCells(i).Parent      = This
                  .ColorCells(i).BevelOuter  = 0
                  .ColorCells(i).BorderStyle = 1
                  .ColorCells(i).Width       = .Width/16
                  .ColorCells(i).Height      = .Height -2
                  .ColorCells(i).Color       = .Colors(i)
                  .ColorCells(i).Top         = 1
                  .ColorCells(i).Left        = i*.Width/16
              Next i
          ElseIf .Style = st2x8 then
              For i = 0 to 7
                  .ColorCells(i).Parent      = This
                  .ColorCells(i).BevelOuter  = 0
                  .ColorCells(i).BorderStyle = 1
                  .ColorCells(i).Width       = .Width/8
                  .ColorCells(i).Height      = .Height/2 -1
                  .ColorCells(i).Color       = .Colors(i)
                  .ColorCells(i).Top         = 1
                  .ColorCells(i).Left        = i*.Width/8
              Next i
              For i = 0 to 7
                  .ColorCells(i+8).Parent      = This
                  .ColorCells(i+8).BevelOuter  = 0
                  .ColorCells(i+8).BorderStyle = 1
                  .ColorCells(i+8).Width       = .Width/8
                  .ColorCells(i+8).Height      = .Height/2 -1
                  .ColorCells(i+8).Color       = .Colors(i+8)
                  .ColorCells(i+8).Top         = 1 + .Height/2
                  .ColorCells(i+8).Left        = i*.Width/8
              Next i
          ElseIf .Style = st4x4 then
              For i = 0 to 3
                  .ColorCells(i).Parent      = This
                  .ColorCells(i).BevelOuter  = 0
                  .ColorCells(i).BorderStyle = 1
                  .ColorCells(i).Width       = .Width/4
                  .ColorCells(i).Height      = .Height/4 -1
                  .ColorCells(i).Color       = .Colors(i)
                  .ColorCells(i).Top         = 1
                  .ColorCells(i).Left        = i*.Width/4
              Next i
              For i = 0 to 3
                  .ColorCells(i+4).Parent      = This
                  .ColorCells(i+4).BevelOuter  = 0
                  .ColorCells(i+4).BorderStyle = 1
                  .ColorCells(i+4).Width       = .Width/4
                  .ColorCells(i+4).Height      = .Height/4 -2
                  .ColorCells(i+4).Color       = .Colors(i+4)
                  .ColorCells(i+4).Top         = 1 + .Height/4
                  .ColorCells(i+4).Left        = i*.Width/4
              Next i
              For i = 0 to 3
                  .ColorCells(i+8).Parent      = This
                  .ColorCells(i+8).BevelOuter  = 0
                  .ColorCells(i+8).BorderStyle = 1
                  .ColorCells(i+8).Width       = .Width/4
                  .ColorCells(i+8).Height      = .Height/4 -1
                  .ColorCells(i+8).Color       = .Colors(i+8)
                  .ColorCells(i+8).Top         = 1 + .Height/2
                  .ColorCells(i+8).Left        = i*.Width/4
              Next i
              For i = 0 to 3
                  .ColorCells(i+12).Parent      = This
                  .ColorCells(i+12).BevelOuter  = 0
                  .ColorCells(i+12).BorderStyle = 1
                  .ColorCells(i+12).Width       = .Width/4
                  .ColorCells(i+12).Height      = .Height/4 -1
                  .ColorCells(i+12).Color       = .Colors(i+12)
                  .ColorCells(i+12).Top         = 1 + 3* .Height/4
                  .ColorCells(i+12).Left        = i*.Width/4
              Next i
          End If
      For i = 0 to 15
          .ColorCells(i).OnMouseDown = This.CellClick
          .ColorCells(i).Hint        = .SColors(i)
          If .ShowHints then .ColorCells(i).ShowHint = 1
      Next i
      End With
      End Sub
      
      Property Set SetStyle(fStyle as integer)
      With This
          .Style = fStyle
          .Draw
      End With
      End Property
      
      Property Set SetShowHint(fShow as integer)
      Dim i as integer
      With This
           .ShowHints = fShow
           For i = 0 to 15
               If .ShowHints then
                  .ColorCells(i).Hint     = .SColors(i)
                  .ColorCells(i).ShowHint = 1
               End If
           Next i
      End With
      End Property

      Constructor
      LoadColors
      Draw
      End Constructor
End Type

