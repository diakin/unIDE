FUNCTION ShowDialogBox(TheBoxNum) AS LONG
	DIM WasCapturing	AS LONG
	DIM	DriverCaps	    AS CAPDRIVERCAPS

 	WasCapturing = False	
 	IF TheBoxNum > 0 THEN 
 		IF .Capture THEN 
 			WasCapturing = True
 			.Capture = False
 		END IF
        RESULT = capDriverGetCaps(This.hCapWnd, DriverCaps, sizeof (DriverCaps))

		SELECT CASE TheBoxNum     	' Video source Dialog box
		CASE 1                        'get video format
            IF DriverCaps.fHasDlgVideoFormat THEN  capDlgVideoFormat(This.hCapWnd) ELSE RESULT = False
		CASE 2                        'get video options
            IF DriverCaps.fHasDlgVideoSource THEN capDlgVideoSource(This.hCapWnd) ELSE RESULT = False
		CASE 3                        '??
            IF DriverCaps.fHasDlgVideoDisplay THEN capDlgVideoDisplay(This.hCapWnd) ELSE RESULT = False
		CASE ELSE                     'video compression
            capDlgVideoCompression(This.hCapWnd)
		END SELECT
       IF WasCapturing THEN .Capture = True
	END IF
END FUNCTION ' inc2026: было END SUB, стало END FUNCTION: блок открыт FUNCTION ShowDialogBox (строка 975)

SUB SetCapture(TheCaptureFlag AS LONG)
	.Capture = TheCaptureFlag
	IF .Init THEN
		IF .Capture THEN 
			.Capture = capCaptureSequenceNoFile(.hCapWnd)
			IF .Overlay THEN .Overlay = capOverlay(.hCapWnd, True)		'auto turn on Overlay
		ELSE
			IF .Overlay THEN .Overlay = capOverlay(.hCapWnd, False)		'auto turn off Overlay
			capCaptureStop(.hCapWnd)
		END IF
	END IF
'   .GetParameters:        .Capturing = .CapStats.fCapturingNow
END SUB

SUB SetYield(TheYieldFlag AS LONG)
    .CapParms.fYield = TheYieldFlag
    IF capCaptureSetSetup(.hCapWnd, This.CapParms, sizeof(This.CapParms)) = 0 THEN 
        IF .ShowErrors THEN ShowMessage "Set yield failed"
    ELSE
        .Yield = TheYieldFlag
    END IF
END SUB

SUB SetPreview(ThePreviewFlag AS LONG)
	.Preview = ThePreviewFlag
	IF .Init THEN 
		IF .Preview THEN
			capPreview(This.hCapWnd, True)
		ELSE
			capPreview(This.hCapWnd, 0&)
		END IF
	END IF
END SUB

SUB CleanUp
	IF .Init THEN 
		capPreview(.hCapWnd, 0&)
		capSetCallbackOnFrame(.hCapWnd, 0&)	'turn off callback
		capCaptureStop(.hCapWnd)
		capDriverDisconnect(.hCapWnd)
		DestroyWindow(.hCapWnd)
		.Init = False
	END IF
END SUB

FUNCTION GrabFrameToClipBoard() AS LONG
	DIM i as integer
	DIM T as single
	DIM info AS TBITMAP
	dim rtn as long
	Dim hBitmap as long
	DIM Bitmap1 AS QBITMAP

	capEditCopy(This.hCapWnd)
    IF clipboard.hasformat(CF_BITMAP) then		
        clipboard.open
        hBitmap=clipboard.GetAsHandle(CF_BITMAP)
        clipboard.close
	else
  		IF .ShowErrors THEN ShowMessage("Cliboard is not in a valid format")
        RESULT = 0: EXIT FUNCTION		'crashed!
	end if
	RESULT = GetObject(Bitmap1.Handle,SIZEOF(info),info)
	RESULT = GetObject(hBitmap,SIZEOF(info),info)
END FUNCTION

