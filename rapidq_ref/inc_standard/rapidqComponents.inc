SUB SetBitCount (TheBitCount AS WORD)
	DIM VideoFormat AS BITMAPINFO
	DIM SzbmpInfo AS DWORD: SzbmpInfo = SIZEOF(VideoFormat)

	IF TheBitCount > 0 THEN
		IF .Init THEN
			SzbmpInfo = capGetVideoFormat(This.hCapWnd, VideoFormat, SzbmpInfo)
			IF SzbmpInfo = 0 THEN 
          		IF .ShowErrors THEN 
                   .GetStatus
                   ShowMessage("Could not set camera bit depth: " + STR$(.Error))
                END IF
                EXIT SUB		'crashed!
