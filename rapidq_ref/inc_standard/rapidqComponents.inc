                found=found+str$(i)+","
                count++
              end if
            else
              if buffer<>value then
                found=found+str$(i)+","
                count++
              end if
            end if
        end select
      next i
      this.file.close
      if count>0 then
        found=left$(found,len(found)-1)
        for i=1 to count
          index=val(field$(found,",",i))
          if this.OnSearch<>0 then CALLFUNC(this.OnSearch,index)
        next i
        this.error=0
