'===========================================
' Mйthode affichage mise en page imprimante
'===========================================
Function Execute as boolean

  DIM DevM AS DEVMODE

  QPageSetup.PSD.lStructSize = SIZEOF(QPageSetup.PSD)
  QPageSetup.PSD.hWndOwner=Application.handle
  QPageSetup.PSD.Flags=PSD_MARGINS+PSD_MINMARGINS

  if QPageSetup.Caption<>"" then
    QPageSetup.PSD.Flags=QPageSetup.PSD.Flags+PSD_ENABLEPAGESETUPHOOK
    IF QPageSetup.MyWndProc = 0 THEN
      BIND QPageSetup.BindIndex TO QPageSetup.HookProc
      QPageSetup.MyWndProc = SetNewCallBack_4(QPageSetup.BindIndex) 'set new address of callback function
      QPageSetup.PSD.lpfnPageSetupHook = QPageSetup.MyWndProc
    END IF
  end if

  if QPageSetup.DisablePrinter then
    QPageSetup.PSD.Flags=QPageSetup.PSD.Flags+PSD_DISABLEPRINTER
  end if

  if QPageSetup.DisablePaper then
    QPageSetup.PSD.Flags=QPageSetup.PSD.Flags+PSD_DISABLEPAPER
  end if
  if QPageSetup.DisableOrient then
    QPageSetup.PSD.Flags=QPageSetup.PSD.Flags+PSD_DISABLEORIENTATION
  end if
  if QPageSetup.DisableMargins then
    QPageSetup.PSD.Flags=QPageSetup.PSD.Flags+PSD_DISABLEMARGINS
  end if

  MEMSET(DevM,0,sizeof(DevM))       'Makes Sure Memory's Cleared
  DevM.dmSize = sizeof(DevM)

  if QPageSetup.Orientation > 0 THEN
    DevM.dmFields = DM_ORIENTATION OR DevM.dmFields
    DevM.dmOrientation = QPageSetup.Orientation
    QPageSetup.PSD.hDevMode = UDTPTR(DevM)
  end if

  if QPageSetup.PaperSize > 0 Then
    DevM.dmFields = DM_PAPERSIZE OR DevM.dmFields
    DevM.dmPaperSize = QPageSetup.PaperSize
    QPageSetup.PSD.hDevMode = UDTPTR(DevM)
  end if

  if QPageSetup.Duplex >=0 then
    DevM.dmFields = DM_DUPLEX OR DevM.dmFields
    DevM.dmDuplex = QPageSetup.Duplex
    QPageSetup.PSD.hDevMode = UDTPTR(DevM)
  end if
  if QPageSetup.PrintColor > 0 THEN
    DevM.dmFields = DM_COLOR OR DevM.dmFields
    DevM.dmColor = QPageSetup.PrintColor
    QPageSetup.PSD.hDevMode = UDTPTR(DevM)
  End if

  if QPageSetup.PrintQuality < 0 THEN
    DevM.dmFields = DM_PRINTQUALITY OR DevM.dmFields
    DevM.dmPrintQuality = QPageSetup.PrintQuality
    QPageSetup.PSD.hDevMode = UDTPTR(DevM)
  Else
    DevM.dmFields = DM_PRINTQUALITY OR DevM.dmFields
    DevM.dmPrintQuality = -3
    QPageSetup.PSD.hDevMode = UDTPTR(DevM)
  end if

  if QPageSetup.Copies > 0 THEN
    DevM.dmFields = DM_COPIES OR DevM.dmFields
    DevM.dmCopies = QPageSetup.Copies
    QPageSetup.PSD.hDevMode = UDTPTR(DevM)
  else
    DevM.dmFields = DM_COPIES OR DevM.dmFields
    DevM.dmCopies = 1
    QPageSetup.PSD.hDevMode = UDTPTR(DevM)
  end if

  If QPageSetup.Collate >= 0 Then
    DevM.dmFields = DM_COLLATE OR DevM.dmFields
    DevM.dmcollate = QPageSetup.Collate
    QPageSetup.PSD.hDevMode = UDTPTR(DevM)
  End If

  If QPAgeSetup.DefaultSource > 0 THEN
    DevM.dmFields = DM_DEFAULTSOURCE OR DevM.dmFields
    DevM.dmDefaultSource = QPageSetup.DefaultSource
    QPageSetup.PSD.hDevMode = UDTPTR(DevM)
  End If

  'generate the main dialog box
  if PageSetupDlg(QPageSetup.PSD) then
    QPageSetup.Execute=true
    QPageSetup.PageWidth=Round(QPageSetup.PSD.ptPaperSizeX/100)
    QPageSetup.PageHeight=Round(QPageSetup.PSD.ptPaperSizeY/100)
    if QPageSetup.PageWidth>QPageSetup.PageHeight then
      QPageSetup.Orientation=true
    else
      QPageSetup.Orientation=false
    end if
    QPageSetup.MarginLeft=QPageSetup.PSD.rtMarginLeft/100
    QPageSetup.MarginTop=QPageSetup.PSD.rtMarginTop/100
    QPageSetup.MarginRight=QPageSetup.PSD.rtMarginRight/100
    QPageSetup.MarginBottom=QPageSetup.PSD.rtMarginBottom/100
  else
    QPageSetup.Execute=false
  end if

End Function

