SUB ClearWatch
  DEFINT x, y
  This.WatchCount = 0
  FOR x = 0 TO This.Grid.RowCount-1
    FOR y = 0 TO This.Grid.ColCount-1
      This.Grid.Cell(y,x) = ""
    NEXT y
  NEXT x
  This.Grid.RowCount=1
  This.ReOrder
END SUB

