'============================================================================
'=======================================================
' Type Objet
' Classe QVideo Version 1.3
'=======================================================
$IFNDEF __QVIDEO_INC
  $DEFINE __QVIDEO_INC
$ENDIF

$IFNDEF TRUE
$ENDIF

$IFNDEF FALSE
$ENDIF

$IFNDEF boolean
$ENDIF

$IFNDEF __WIN32API       'windows inc loaded?

$IFNDEF __RQINC2         'RapidQ2.inc loaded?
$ENDIF
$ENDIF

const VD_CLOSE=0
const VD_PLAY=1
const VD_PAUSE=2
const VD_STOP=3

Type QVideo extends Qobject
  '================================
  ' champs et proprietйs
  '================================
  Timer as QTIMER
  Lenght as long
  LenghtTime as long
  State as integer
  Handle as long
  FileOpen as boolean
  Error as string
  Parent as long
  BorderStyle as integer
  ImgWidth as short
  ImgHeight as short
  Left as short PROPERTY SET SetLeft
  Top as short PROPERTY SET SetTop
  Width as short PROPERTY SET SetWidth
  Height as short PROPERTY SET SetHeight
  CurrentFrame as Long PROPERTY SET SetCurrentFrame
  AudioOff as boolean PROPERTY SET SetAudioOff
  Caption as string PROPERTY SET SetCaption
  WindowState as integer PROPERTY SET SetWindowState
  Volume as integer PROPERTY SET SetVolume
  OnChange as EVENT(event_change) 

  '====================================
  ' proprietй volume du media
  '====================================
  Property Set SetVolume(volume as integer)
    dim vol as long

    if volume<=100 then
      QVideo.volume=volume
      if volume>50 then
        if volume=100 then
          waveOutSetVolume(0,&hffffffff)
        else
          vol=-((32767/50)*(100-volume)) 
          waveOutSetVolume(0,vol+(vol*65536))
        end if
      else
        vol=(32767/50)*volume 
        waveOutSetVolume(0,vol+(vol*65536))
      end if
    end if
  End Property

  '====================================
  ' proprietй affichage image du media
  '====================================
  Property Set SetCurrentFrame(frame as long)
    dim Retval as integer
    dim RetString as string

    if QVideo.FileOpen then
      if QVideo.State=VD_STOP or QVideo.State=VD_PAUSE then
        if frame<0 then
          QVideo.CurrentFrame=0
        else
          if frame>QVideo.Lenght then
            QVideo.CurrentFrame=QVideo.Lenght
          else
            QVideo.CurrentFrame=frame
          end if
        end if
        RetString=Space$(128)
        Retval=mciSendString("seek MEDIA to "+Str$(QVideo.CurrentFrame),varptr(RetString),128,0)
      end if
    end if
  End Property

  '====================================
  ' proprietй position x image du media
  '====================================
  Property Set SetLeft(left as short)
    if QVideo.FileOpen=True and QVideo.handle<>0 then
      QVideo.Left=left
      if QVideo.Parent=0 then SetForegroundWindow(QVideo.handle)
      MoveWindow(QVideo.handle,QVideo.Left,QVideo.Top,QVideo.Width,QVideo.Height,true)
    end if
  End Property

  '====================================
  ' proprietй position y image du media
  '====================================
  Property Set SetTop(top as short)
    if QVideo.FileOpen=True and QVideo.handle<>0 then
      QVideo.Top=top
      if QVideo.Parent=0 then SetForegroundWindow(QVideo.handle)
      MoveWindow(QVideo.handle,QVideo.Left,QVideo.Top,QVideo.Width,QVideo.Height,true)
    end if
  End Property

  '====================================
  ' proprietй largeur image du media
  '====================================
  Property Set SetWidth(width as short)
    if QVideo.FileOpen=True and QVideo.handle<>0 then
      QVideo.Width=width
      if QVideo.Parent=0 then SetForegroundWindow(QVideo.handle)
      MoveWindow(QVideo.handle,QVideo.Left,QVideo.Top,QVideo.Width,QVideo.Height,true)
    end if
  End Property

  '====================================
  ' proprietй hauteur image du media
  '====================================
  Property Set SetHeight(height as short)
    if QVideo.FileOpen=True and QVideo.handle<>0 then
      QVideo.Height=height
      if QVideo.Parent=0 then SetForegroundWindow(QVideo.handle)
      MoveWindow(QVideo.handle,QVideo.Left,QVideo.Top,QVideo.Width,QVideo.Height,true)
    end if
  End Property

  '====================================
  ' proprietй sans son du media
  '====================================
  PROPERTY SET SetAudioOff(audio as boolean)
    dim Retval as integer
    dim RetString as string

    if QVideo.FileOpen then
      RetString=Space$(128)
      if audio then
        Retval=mciSendString("set MEDIA audio all off",varptr(RetString),128,0)
      else
        Retval=mciSendString("set MEDIA audio all on",varptr(RetString),128,0)
      end if
    end if
  End Property

  '====================================
  ' proprietй caption du media
  '====================================
  PROPERTY SET SetCaption(caption as string)
    dim Retval as integer
    dim RetString as string

    QVideo.Caption=caption
    if QVideo.FileOpen=True and QVideo.Parent=0 then
      RetString=Space$(128)
      Retval=mciSendString("window MEDIA text "+caption,varptr(RetString),128,0)
    end if
  END PROPERTY
 
  '====================================
  ' proprietй etat fenetre du media
  '====================================
  PROPERTY SET SetWindowState(WindowState as integer)
    dim state as short

    if QVideo.FileOpen=True and QVideo.Parent=0 then
      if WindowState>-1 and WindowState<3 then
        if WindowState=0 then state=1
        if WindowState=1 then state=2
        if WindowState=2 then state=3
        QVideo.WindowState=WindowState
        ShowWindow(QVideo.handle,state)
      else
        QVideo.WindowState=0
      end if
    end if
  END PROPERTY

PRIVATE:

  '========================================
  ' Mйthode retourne le texte de l'erreur
  '========================================
  Function GetMciDescription(McierrNr As Long) As String
    dim Retval as Long
    dim RetString as String

    RetString=Space$(200)
    Retval=mciGetErrorString(McierrNr,RetString,200)
    if Retval then
      QVideo.GetMciDescription=RTRIM$(RetString)
    else
      QVideo.GetMciDescription=""
    end if
  End Function

  '========================================
  ' Mйthode dimension du mйdia
  '========================================
  Sub GetDimension
    dim rect as QRECT

    GetWindowRect(QVideo.handle,Rect)
    QVideo.width=rect.right-rect.left
    QVideo.height=rect.bottom-rect.top
  End Sub

  '==================================
  ' mйthode position du media
  '==================================
  Function GetPosition as long
    dim Retval as integer
    dim RetString as string

    if QVideo.FileOpen then
      RetString=Space$(128)
      Retval=mciSendString("status MEDIA position",varptr(RetString),128,0)
      if Retval=False then QVideo.GetPosition=val(RetString)
    end if
  End Function

  '========================================
  ' Mйthode dimension du mйdia
  '========================================
  Sub GetImgDimension(mediadim as string)
    dim sPos As long
    dim ePos As long
    dim left as short
    dim top as short

    ePos=instr(,mediadim," ")
    left=Val(Mid$(mediadim,1,ePos))
    sPos=ePos+1
    ePos=instr(sPos,mediadim," ")
    top=Val(Mid$(mediadim,sPos,ePos-sPos))
    sPos=ePos+1
    ePos=instr(sPos,mediadim," ")
    QVideo.ImgWidth=Val(Mid$(mediadim,sPos,ePos-sPos))
    sPos=ePos+1
    QVideo.ImgHeight=Val(Mid$(mediadim,sPos,Len(mediadim)-sPos))
  End Sub

  '====================================
  ' mйthode lecture mode du media
  '====================================
  Function GetMode as integer
    dim Retval as integer
    dim RetString as string

    if QVideo.FileOpen then
      RetString=Space$(128)
      Retval=mciSendString("status MEDIA mode",varptr(RetString),128,0)
      if instr(RetString,"stopped")>0 then QVideo.GetMode=VD_STOP
      if instr(RetString,"playing")>0 then QVideo.GetMode=VD_PLAY
      if instr(RetString,"paused")>0 then QVideo.GetMode=VD_PAUSE
    end if
  End Function

PUBLIC:

  '=================================
  ' mйthode fermeture fichier media
  '=================================
  Sub Close
    dim Retval as integer
    dim RetString as string

    QVideo.Timer.enabled=False
    RetString=Space$(128)
    Retval=mciSendString("stop MEDIA",varptr(RetString),128,0)
    RetString=Space$(128)
    Retval=mciSendString("close MEDIA",varptr(RetString),128,0)
    QVideo.FileOpen=False
    QVideo.Lenght=0
    QVideo.LenghtTime=0
    QVideo.Left=0
    QVideo.Top=0
    QVideo.Width=0
    QVideo.Height=0
    QVideo.ImgWidth=0
    QVideo.ImgHeight=0
    QVideo.CurrentFrame=0
    QVideo.State=VD_CLOSE
  End Sub

  '=================================
  ' mйthode ouverture fichier media
  '=================================
  Function Open(FileName as string) as boolean
    Dim Retval as Integer
    Dim RetString as String
    Dim FlagOpen as integer
    Dim Style as string

    if FileName<>"" then
      RetString=Space$(128)
      if QVideo.Parent<>0 then
        Retval=mciSendString("open "+FileName+" alias MEDIA parent "+ Str$(QVideo.Parent)+" style child",varptr(RetString),128,0)
      else
        if QVideo.BorderStyle=0 then Style="popup"
        if QVideo.BorderStyle<>0 then Style="overlapped"
        Retval=mciSendString("open "+FileName+" alias MEDIA style "+Style,varptr(RetString),128,0)
      end if
      if Retval=False then
        if QVideo.Parent=0 then
          if QVideo.caption<>"" then
            RetString=Space$(128)
            Retval=mciSendString("window MEDIA text "+QVideo.caption,varptr(RetString),128,0)
          else
            RetString=Space$(128)
            Retval=mciSendString("info MEDIA window text",varptr(RetString),128,0)
            if Retval=False then QVideo.Caption=RetString
          end if
        end if
        RetString=Space$(128)
        Retval=mciSendString("set MEDIA time format milliseconds",varptr(RetString),128,0)
        RetString=Space$(128)
        Retval=mciSendString("status MEDIA length",varptr(RetString),128,0)
        if Retval=False then QVideo.LenghtTime=Val(RetString)/1000
        RetString=Space$(128)
        Retval=mciSendString("set MEDIA time format frames",varptr(RetString),128,0)
        RetString=Space$(128)
        Retval=mciSendString("status MEDIA length",varptr(RetString),128,0)
        if Retval=False then
          QVideo.Lenght=Val(RetString)
          RetString=Space$(128)
          Retval=mciSendString("where MEDIA source",varptr(RetString),128,0)
          if Retval=False then
            QVideo.GetImgDimension(RetString)
            RetString=Space$(128)
            Retval=mciSendString("status MEDIA window handle",varptr(RetString),128,0)
            if Retval=False then
              QVideo.handle=val(RetString)
              if QVideo.Parent<>0 then
                QVideo.Width=QVideo.ImgWidth
                QVideo.Height=QVideo.ImgHeight
              else
                QVideo.GetDimension
              end if
              QVideo.State=VD_STOP
              QVideo.CurrentFrame=0
              QVideo.FileOpen=True
              QVideo.Open=True
              FlagOpen=True
            end if
          end if
        end if
      else
        QVideo.Error=QVideo.GetMciDescription(Retval)
      end if
      if FlagOpen=False then QVideo.Close
    end if
  End Function

  '=================================
  ' mйthode affichage media
  '=================================
  Sub Show
    dim Retval as integer
    dim RetString as string

    if QVideo.FileOpen then
      if QVideo.Parent=0 then SetForegroundWindow(QVideo.handle)
      RetString=Space$(128)
      Retval=mciSendString("window MEDIA state show",varptr(RetString),128,0)
    end if
  End Sub

  '==================================
  ' mйthode lecture du media
  '==================================
  Sub Play
    dim Retval as integer
    dim RetString as String

    if QVideo.FileOpen then
      QVideo.Timer.enabled=True
      if QVideo.Parent=0 then SetForegroundWindow(QVideo.handle)
      RetString = Space$(128)
      Retval=mciSendString("play MEDIA from "+Str$(QVideo.CurrentFrame),varptr(RetString),128,0)
      if Retval=False then QVideo.State=VD_PLAY
    end if
  End Sub

  '==================================
  ' mйthode arret du media
  '==================================
  Sub Stop
    dim Retval as integer
    dim RetString as string

    if QVideo.FileOpen then
      RetString=Space$(128)
      Retval=mciSendString("stop MEDIA",varptr(RetString),128,0)
      if Retval=False then
         QVideo.Timer.enabled=False
         QVideo.State=VD_STOP
        QVideo.CurrentFrame=0
        RetString=Space$(128)
        Retval=mciSendString("seek MEDIA to start",varptr(RetString),128,0)
      end if
    end if
  End Sub

  '==================================
  ' mйthode pause du media
  '==================================
  Sub Pause
    dim Retval as integer
    dim RetString as string

    if QVideo.FileOpen=true and QVideo.State=VD_PLAY then
      RetString=Space$(128)
      Retval=mciSendString("pause MEDIA",varptr(RetString),128,0)
      if Retval=False then
        QVideo.State=VD_PAUSE
        QVideo.Timer.enabled=False
        QVideo.CurrentFrame=QVideo.GetPosition
      end if
    end if
  End Sub

  '=======================================
  ' йvenement changementposition du media
  '=======================================
  Event Timer.OnTimer
    dim currentTime as long

    QVideo.currentFrame=QVideo.GetPosition
    currentTime=int(QVideo.currentFrame*(QVideo.LenghtTime/QVideo.Lenght))
    QVideo.State=QVideo.GetMode
    if QVideo.State=VD_STOP then QVideo.Stop
    if QVideo.OnChange<>0 then CALLFUNC(QVideo.OnChange,QVideo.currentFrame,currentTime)
  End Event

  Constructor
    State=VD_CLOSE
    Timer.interval=1000
    Timer.enabled=False
  End Constructor
End Type

'============================================================================
'[build_inc] QVolumeInfo.inc
'============================================================================
'************************************************************************************
'*                                                                                  *
'*  QVolumeInfo: Retrieve infromation from your connected volumes                   *
'*  ------------------------------------------------------------------------------  *
'*                                                                                  *
'*  Poperties:                                                                      *
'*      Serial: Serial given to volume during creation of partitions                *
'*      Name: Name of Drive                                                         *
'*      FileSystem: NTFS, FAT32 etc...                                              *
'*      DriveRoot: Driveletter of current drive                                     *
'*                                                                                  *
'*      Bytes: bytes / sector                                                       *
'*      Sectors: sectors / cluster                                                  *
'*      TotalClusters: total number of cluster on volume                            *
'*      FreeClusters: number of free clusters on volume                             *
'*      TotalBytes: total number of bytes on volume                                 *
'*      FreeBytes: number of free bytes on volume                                   *
'*      TotalSpace: short string representation of total space on volume            *
'*      FreeSpace: short string representation of free space on volume              *
'*                                                                                  *
'*      DriveType: drivetype as integer                                             *
'*      DriveTypeString: string representation of drivetype                         *
'*      DriveTypeUnknown: 0 if drivetype is known, 1 if drivetype is unknown        *
'*                                                                                  *
'*  ------------------------------------------------------------------------------  *
'*                                                                                  *
'*  Methods                                                                         *
'*      SelectDrive(DriveRoot): call this first before retrieving properties        *
'*      GetStringFormat(NumberOfBytes): returns a short string rep. (xx KB, MB, GB) *
'*                                                                                  *
'*  ------------------------------------------------------------------------------  *
'*  Author: Alain Besseleer alias Midipro2000                                       *
'*  Date: July 25, 2009                                                             *
'*  Version: 1.0                                                                    *
'*                                                                                  *
'************************************************************************************

$DEFINE __QVOLUMEINFO_INC

$IFNDEF __WIN32API				   'windows 32 definitions
$IFNDEF __QDRIVE_INC                'shared constants

$ENDIF
$ENDIF

Declare Function GetVolumeInformation_INC Lib "Kernel32" Alias "GetVolumeInformationA" _
    (ByVal lpRootPathName As String,  _
    byref lpVolumeNameBuffer As string, _ 
    ByVal nVolumeNameSize As Long,  _
    Byref lpVolumeSerialNumber As long,  _
    ByVal lpMaximumComponentLength As Long, _ 
    ByVal lpFileSystemFlags As Long,  _
    ByRef lpFileSystemNameBuffer As string, _ 
    ByVal nFileSystemNameSize As Long) As Long

Private Declare Function GetDiskFreeSpace_INC Lib "kernel32" Alias "GetDiskFreeSpaceA" _
    (ByVal lpRootPathName As String, _
    byref lpSectorsPerCluster As Long, _
    byref lpBytesPerSector As Long, _
    byref lpNumberOfFreeClusters As Long, _
    byref lpTtoalNumberOfClusters As Long) As Long

Declare Function GetDriveType_INC Lib "kernel32" Alias "GetDriveTypeA" _
    (ByVal nDrive As String) As Long

type QVolumeInfo extends QObject
    
    Public:
        Serial as string
        Name as string
        FileSytem as string
        DriveRoot as string
        
        Bytes as long
        Sectors as long
        TotalClusters as long
        FreeClusters as long
        
        TotalBytes as double
        FreeBytes as double
        
        TotalSpace as string
        FreeSpace as string
        
        DriveType as long
        DriveTypeString as string
        DriveTypeUnknown as integer
        
    function GetStringFormat(Bytes as double) as string
        select case bytes
        case is < 1024
            result = str$(Bytes) + " Bytes"
            
        case 1024 to 1024^2 -1
            result = format$("%.1f KB", Bytes/1024)
            
        case 1024^2 to 1024^3 -1
            result = format$("%.1f MB", Bytes/1024^2)
            
        case 1024^3 to 1024^4 -1
            result = format$("%.1f GB", Bytes/1024^3)
        
        case is >= 1024^4 ' inc2026: => заменено на >=, как в документации (operators.html)
            result = format$("%.1f TB", Bytes/1024^4)
            
        end select
    end function
    
    sub SelectDrive(DriveRoot as string)
        'format driveroot
        DEFSTR MyDriveRoot = left$(DriveRoot, 1) + ":\"         'need to copy this string!
        QVolumeInfo.Driveroot = MyDriveRoot - "\"
        
        '--- first call: GetVolumeInformation 
        Dim Serial As long
        Dim VName As string
        Dim FSName As String

        'Create buffers
        VName = String$(255, Chr$(0))
        FSName = String$(255, Chr$(0))

        'Get the volume information
        GetVolumeInformation_INC (MyDriveRoot, VName, 255, Serial , 0, 0, FSName, 255)
    
        'Strip the extra chr$(0)'s
        VName = VName - Chr$(0)
        FSName = FSName - Chr$(0)
        QVolumeInfo.Serial = hex$(Serial)
        QVolumeInfo.Name = VName
        QVolumeInfo.FileSytem = FSName
        
        '--- second call: GetDiskFreeSpace 
        
        Dim Bytes as Long
        Dim Sectors as Long
        Dim TotalClusters as Long
        Dim FreeClusters as Long
        
        Dim TotalBytes as double
        Dim FreeBytes as double
    
        'Retrieve information
        GetDiskFreeSpace_INC (MyDriveRoot, Sectors, Bytes, FreeClusters, TotalClusters)
        
        QVolumeInfo.Sectors = Sectors 
        QVolumeInfo.Bytes = Bytes 
        QVolumeInfo.FreeClusters = FreeClusters 
        QVolumeInfo.TotalClusters = TotalClusters 
    
        TotalBytes = TotalClusters * Sectors * Bytes
        QVolumeInfo.TotalBytes = TotalBytes 
    
        FreeBytes = FreeClusters * Sectors * Bytes
        QVolumeInfo.FreeBytes = FreeBytes 
        
        QVolumeInfo.TotalSpace = QVolumeInfo.GetStringFormat(TotalBytes)
        QVolumeInfo.FreeSpace = QVolumeInfo.GetStringFormat(FreeBytes)
        
        '--- third call: GetDriveType
        
        Dim DType as long
        
        DType = GetDriveType_INC(MyDriveRoot)
        QVolumeInfo.DriveType = DType 
        
        select case DType 
        Case 2
            QVolumeInfo.DriveTypeString = "Removable"
            QVolumeInfo.DriveTypeUnknown = 0
        Case 3
            QVolumeInfo.DriveTypeString = "Drive Fixed"
            QVolumeInfo.DriveTypeUnknown = 0
        Case Is = 4
            QVolumeInfo.DriveTypeString = "Remote"
            QVolumeInfo.DriveTypeUnknown = 0
        Case Is = 5
            QVolumeInfo.DriveTypeString = "Cd-Rom"
            QVolumeInfo.DriveTypeUnknown = 0
        Case Is = 6
            QVolumeInfo.DriveTypeString = "Ram disk"
            QVolumeInfo.DriveTypeUnknown = 0
        Case Else
            QVolumeInfo.DriveTypeString = "Unknown"
            QVolumeInfo.DriveTypeUnknown = 1
        End Select

    End sub 
    
end type

