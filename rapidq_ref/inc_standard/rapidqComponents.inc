'[build_inc] QToolBar.inc
'============================================================================
' ToolBar Component fo Rapidq
' Version 1.2 (stable)
' Coded by Nastase Eodor
' http://rqwork.evonet.ro
' mailTo: rqwork@evonet.ro

$IFNDEF __RQMEMORY
'~inc $Include "Memory.inc"   ' уже в сборке или заменён выбранной версией
$ENDIF

$DEFINE tbsButton     TBSTYLE_BUTTON
$DEFINE tbsCheck      TBSTYLE_CHECK
$DEFINE tbsCheckGroup TBSTYLE_CHECKGROUP
$DEFINE tbsDropDown   TBSTYLE_DROPDOWN

Type ToolButton
     Down     As Integer
     Enabled  As Integer
     Visible  As Integer
     Hint     As Integer
     ShowHint As Integer
     DropDown As Integer
End Type

Declare Sub EventTemplate_ToolBar_ButtonClick(ButtonIndex&)
Declare Sub EventTemplate_ToolBar_Command(NotifyCode&,CommandID&,hwndCtrl&)
Type QToolBar Extends QObject
     Private:
     NM             As NMHDR
     TTX            As TOOLTIPTEXT
     TBn            As TBNOTIFY
     R              As Rect
     P              As Point
     LF             As LOGFONT
     TB             As TBBUTTON
     ToolButton     As ToolButton
     IDCommand      As Integer
     NewProc        As Integer
     ClassProc      As Integer
     ParentProc     As Integer
     LastParentProc As Integer
     ParentWnd      As Integer
     Buttons        As QStringList
     Public:
     Handle         As Integer
     Parent         As QForm   Property Set SetParent
     Parent2        As QPanel  Property Set SetParent2
     Left           As Integer Property Set SetLeft
     Top            As Integer Property Set SetTop
     Width          As Integer Property Set SetWidth
     Height         As Integer Property Set SetHeight
     Enabled        As Integer Property Set SetEnabled
     Visible        As Integer Property Set SetVisible
     AutoSize       As Integer Property Set SetAutoSize
     Flat           As Integer Property Set SetFlat
     Transparent    As Integer Property Set SetTransparent
     Wrapable       As Integer Property Set SetWrapable
     Divider        As Integer Property Set SetDivider
     ButtonWidth    As Integer Property Set SetButtonWidth
     ButtonHeight   As Integer Property Set SetButtonHeight
     Font           As QFont   Property Set SetFont
     PopupMenu      As QPopupMenu
     Images         As QImageList
     HotImages      As QImageList
     DisabledImages As QImageList
     OnButtonClick  As Event(EventTemplate_ToolBar_ButtonClick)
     OnCommand      As Event(EventTemplate_ToolBar_Command)
     
     With This
     
     Function Button(Index&) As Integer
         Result = Val(.Buttons.Item(Index&))
     End Function
     
     Function ButtonCount As Integer
         Result = .Buttons.ItemCount
     End Function
     
     Sub CreateWnd
         If .Handle Then Exit Sub
         Dim R As Rect
         DefInt Style = ws_child Or tbstyle_tooltips' Or ccs_nomovex or ccs_noresize Or ccs_noparentalign
         Style = Style Or IIf(.Flat,TBSTYLE_FLAT,0) Or IIf(.Transparent,TBSTYLE_TRANSPARENT,0) Or IIf(.Wrapable,TBSTYLE_WRAPABLE,0) Or IIf(.Divider,0,CCS_NODIVIDER) Or ccs_nomovey
         .Handle = CreateWindowEx(0,"QToolBar","",Style,.Left,.Top,.Width,.Height,.ParentWnd,0,GetModuleHandle(0),0)
         If .Handle Then
            SendMessage(.Handle,TB_BUTTONSTRUCTSIZE,SizeOf(This.TB),0)
            SendMessage(.Handle,TB_SETEXTENDEDSTYLE, 0, SendMessageA(.Handle,TB_GETEXTENDEDSTYLE, 0, 0) Or TBSTYLE_EX_DRAWDDARROWS)
            SendMessage(.Handle,TB_SETIMAGELIST,0,.Images.Handle)
            If .HotImages.Count Then SendMessage(.Handle,TB_SETHOTIMAGELIST,0,.HotImages.Handle)
            If .DisabledImages.Count Then SendMessage(.Handle,TB_SETDISABLEDIMAGELIST,0,.DisabledImages.Handle)
            SendMessage(.Handle,WM_SETFONT,.Font.Handle,1)
            ShowWindow(.Handle,IIf(.Visible,SW_SHOW,SW_HIDE))
            If .AutoSize Then SendMessage(.Handle,TB_AUTOSIZE,0,0)
            SendMessage(.Handle,TB_GETITEMRECT,0,R)
            .ButtonWidth  =  R.Right - R.Left
            .ButtonHeight =  R.Bottom - R.Top
            UpdateWindow(GetParent(.Handle))
         End If
     End Sub

     Sub RecreateWnd
         DefInt i
         If .Handle Then
            DestroyWindow(.Handle)
            .Handle = 0
         End If
         .CreateWnd
         If .Handle Then
            For i = 0 To .ButtonCount -1
                MemCpy .TB,.Button(i),SizeOf(This.TB)
                SendMessage(.Handle,TB_ADDBUTTONS,1,.TB)
                If .TB.fsStyle = tbsCheck Or .TB.fsStyle = tbsCheckGroup Then
                   MemCpy .ToolButton,.TB.dwData,SizeOf(This.ToolButton)
                   SendMessage(.Handle,TB_CHECKBUTTON,.TB.idCommand,.ToolButton.Down)
                End If
            Next i
         End If
         If .AutoSize Then SendMessage(.Handle,TB_AUTOSIZE,0,0)
     End Sub
     
     Sub Invalidate
         If .Handle Then InvalidateRect(.Handle,0,0)
     End Sub
     
     Sub Update
         If .Handle Then UpdateWindow(.Handle)
     End Sub
     
     Sub Repaint
         If .Handle Then
            RedrawWindow(.Handle,0,0,RDW_ERASE Or RDW_INVALIDATE)
            .Update
         End If
     End Sub
     
     Sub Refresh
         If .HotImages.Count Then SendMessage(.Handle,TB_SETHOTIMAGELIST,0,.HotImages.Handle)
         If .DisabledImages.Count Then SendMessage(.Handle,TB_SETDISABLEDIMAGELIST,0,.DisabledImages.Handle)
     End Sub
     
     Function GetCommandID(Index&) As Integer
         Result = -1
         If Index& > -1 And Index& <.ButtonCount Then
            MemCpy .TB,.Button(Index&),SizeOf(This.TB)
            Result = .TB.idCommand
         End If
     End Function
     
     Function GetIndex(CommandID&) As Integer
         DefInt i
         Result = -1
         For i = 0 To .ButtonCount -1
             MemCpy .TB,.Button(i),SizeOf(This.TB)
             If .TB.idCommand = CommandID& Then Result = i
         Next i
     End Function
     
     Sub SetButtonImageIndex(Index&,ImageIndex&)
         MemCpy .TB,.Button(Index&),SizeOf(This.TB)
         .TB.iBitmap = ImageIndex&
         MemCpy .Button(Index&),.TB,SizeOf(This.TB)
         If .Handle Then SendMessage(.Handle,TB_CHANGEBITMAP,.TB.idCommand,ImageIndex&)
     End Sub

     Function GetButtonImageIndex(Index&) As Integer
         Result = -1
         MemCpy .TB,.Button(Index&),SizeOf(This.TB)
         Result = .TB.iBitmap
     End Function
     
     Sub SetButtonCaption(Index&,Caption$)
         MemCpy .TB,.Button(Index&),SizeOf(This.TB)
         If .TB.iString Then
            PtrFree(.TB.iString)
            .TB.iString = NewZStr(Caption$)
            MemCpy .Button(Index&),.TB,SizeOf(This.TB)
            .RecreateWnd
         End If
     End Sub
     
     Function GetButtonCaption(Index&) As String
         Result = ""
         MemCpy .TB,.Button(Index&),SizeOf(This.TB)
         Result = StrFromPtr(.TB.iString)
     End Function
     
     Sub SetButtonDropDown(Index&,DropDown As QPopupMenu)
         MemCpy .TB,.Button(Index&),SizeOf(This.TB)
         If .TB.dwData Then
            MemCpy .ToolButton,.TB.dwData,SizeOf(This.ToolButton)
            .ToolButton.DropDown = DropDown.Handle
            MemCpy .TB.dwData,.ToolButton,SizeOf(This.ToolButton)
            MemCpy .Button(Index&),.TB,SizeOf(This.TB)
         End If
     End Sub

     Function GetButtonDropDown(Index&) As Integer
         Result = 0
         MemCpy .TB,.Button(Index&),SizeOf(This.TB)
         If .TB.dwData Then
            MemCpy .ToolButton,.TB.dwData,SizeOf(This.ToolButton)
            Result = .ToolButton.DropDown
         End If
     End Function
     
     Sub SetButtonHint(Index&,Hint$)
         MemCpy .TB,.Button(Index&),SizeOf(This.TB)
         If .TB.dwData Then
            MemCpy .ToolButton,.TB.dwData,SizeOf(This.ToolButton)
            .ToolButton.Hint = NewZStr(Hint$)
            MemCpy .TB.dwData,.ToolButton,SizeOf(This.ToolButton)
            MemCpy .Button(Index&),.TB,SizeOf(This.TB)
         End If
     End Sub

     Function GetButtonHint(Index&) As String
         Result = ""
         MemCpy .TB,.Button(Index&),SizeOf(This.TB)
         If .TB.dwData Then
            MemCpy .ToolButton,.TB.dwData,SizeOf(This.ToolButton)
            Result = StrFromPtr(.ToolButton.Hint)
         End If
     End Function
     
     Sub SetButtonShowHint(Index&,ShowHint&)
         MemCpy .TB,.Button(Index&),SizeOf(This.TB)
         If .TB.dwData Then
            MemCpy .ToolButton,.TB.dwData,SizeOf(This.ToolButton)
            .ToolButton.ShowHint = ShowHint&
            MemCpy .TB.dwData,.ToolButton,SizeOf(This.ToolButton)
            MemCpy .Button(Index&),.TB,SizeOf(This.TB)
         End If
     End Sub

     Function GetButtonShowHint(Index&) As Integer
         Result = 0
         MemCpy .TB,.Button(Index&),SizeOf(This.TB)
         If .TB.dwData Then
            MemCpy .ToolButton,.TB.dwData,SizeOf(This.ToolButton)
            Result = .ToolButton.ShowHint
         End If
     End Function

     Sub SetButtonDown(Index&,Down&)
         DefInt CommandID = .GetCommandID(Index&)
         If CommandID <> -1 Then
            SendMessage(.Handle,TB_CHECKBUTTON,CommandID,Down&)
            MemCpy .TB,.Button(Index&),SizeOf(This.TB)
            If .TB.dwData Then
               MemCpy .ToolButton,.TB.dwData,SizeOf(This.ToolButton)
               .ToolButton.Down = Down&
               MemCpy .TB.dwData,.ToolButton,SizeOf(This.ToolButton)
               MemCpy .Button(Index&),.TB,SizeOf(This.TB)
             End If
         End If
     End Sub

     Function GetButtonDown(Index&) As Integer
         DefInt CommandID = .GetCommandID(Index&)
         Result = 0
         If CommandID <> -1 Then
            If .Handle Then
               Result = SendMessageA(.Handle,TB_ISBUTTONCHECKED,CommandID,0)
            Else
               MemCpy .TB,.Button(Index&),SizeOf(This.TB)
               If .TB.dwData Then
                  MemCpy .ToolButton,.TB.dwData,SizeOf(This.ToolButton)
                  Result = .ToolButton.Down
               End If
            End If
         End If
     End Function

     Sub SetButtonEnabled(Index&,Enabled&)
         DefInt CommandID = .GetCommandID(Index&)
         If CommandID <> -1 Then
            SendMessage(.Handle,TB_ENABLEBUTTON,CommandID,Enabled&)
            MemCpy .TB,.Button(Index&),SizeOf(This.TB)
            If .TB.dwData Then
               MemCpy .ToolButton,.TB.dwData,SizeOf(This.ToolButton)
               .ToolButton.Enabled = Enabled&
               MemCpy .TB.dwData,.ToolButton,SizeOf(This.ToolButton)
               MemCpy .Button(Index&),.TB,SizeOf(This.TB)
             End If
         End If
     End Sub

     Function GetButtonEnabled(Index&) As Integer
         DefInt CommandID = .GetCommandID(Index&)
         Result = 0
         If CommandID <> -1 Then
            If .Handle Then
               Result = SendMessageA(.Handle,TB_ISBUTTONENABLED,CommandID,0)
            Else
               MemCpy .TB,.Button(Index&),SizeOf(This.TB)
               If .TB.dwData Then
                  MemCpy .ToolButton,.TB.dwData,SizeOf(This.ToolButton)
                  Result = .ToolButton.Enabled
               End If
            End If
         End If
     End Function

     Sub SetButtonVisible(Index&,Visible&)
         DefInt CommandID = .GetCommandID(Index&)
         If CommandID <> -1 Then
            SendMessage(.Handle,TB_HIDEBUTTON,CommandID,Visible&)
            MemCpy .TB,.Button(Index&),SizeOf(This.TB)
            If .TB.dwData Then
               MemCpy .ToolButton,.TB.dwData,SizeOf(This.ToolButton)
               .ToolButton.Visible = Visible&
               MemCpy .TB.dwData,.ToolButton,SizeOf(This.ToolButton)
               MemCpy .Button(Index&),.TB,SizeOf(This.TB)
             End If
         End If
     End Sub

     Function GetButtonVisible(Index&) As Integer
         DefInt CommandID = .GetCommandID(Index&)
         Result = 0
         If CommandID <> -1 Then
            If .Handle Then
               Result = SendMessageA(.Handle,TB_ISBUTTONHIDDEN,CommandID,0)
            Else
               MemCpy .TB,.Button(Index&),SizeOf(This.TB)
               If .TB.dwData Then
                  MemCpy .ToolButton,.TB.dwData,SizeOf(This.ToolButton)
                  Result = .ToolButton.Visible
               End If
            End If
         End If
     End Function

     Property Set SetParent(Value As QForm)
         .ParentWnd = Value.Handle
         If .Handle Then
            SetParent(.Handle,Value.Handle)
            If GetWindowLong(.ParentWnd,GWL_WNDPROC) <> .ParentProc Then
               .LastParentProc = SetWindowLong(.ParentWnd,GWL_WNDPROC,.ParentProc)
            End If
         Else
            .CreateWnd
            If GetWindowLong(.ParentWnd,GWL_WNDPROC) <> .ParentProc Then
               .LastParentProc = SetWindowLong(.ParentWnd,GWL_WNDPROC,.ParentProc)
            End If
         End If
     End Property
     
     Property Set SetParent2(Value As QPanel)
         .ParentWnd = Value.Handle
         If .Handle Then
            SetParent(.Handle,Value.Handle)
            If GetWindowLong(.ParentWnd,GWL_WNDPROC) <> .ParentProc Then
               .LastParentProc = SetWindowLong(.ParentWnd,GWL_WNDPROC,.ParentProc)
            End If
         Else
            .CreateWnd
            If GetWindowLong(.ParentWnd,GWL_WNDPROC) <> .ParentProc Then
               .LastParentProc = SetWindowLong(.ParentWnd,GWL_WNDPROC,.ParentProc)
            End If
         End If
     End Property
     
     Property Set SetLeft(Value As Integer)
         .Left = Value
         If .Handle Then MoveWindow(.Handle,.Left,.Top,.Width,.Height,1)
     End Property
     
     Property Set SetTop(Value As Integer)
         .Top = Value
         If .Handle Then MoveWindow(.Handle,.Left,.Top,.Width,.Height,1)
     End Property
     
     Property Set SetWidth(Value As Integer)
         .Width = value
         If .Handle Then MoveWindow(.Handle,.Left,.Top,.Width,.Height,1)
     End Property
     
     Property Set SetHeight(Value As Integer)
         .Height = value
         If .Handle Then MoveWindow(.Handle,.Left,.Top,.Width,.Height,1)
     End Property
     
     Property Set SetFlat(Value As Integer)
         .Flat = value
         .RecreateWnd
     End Property
     
     Property Set SetAutosize(Value As Integer)
         .Autosize = value
         .RecreateWnd
         SendMessage(.Handle,TB_AUTOSIZE,0,0)
     End Property
     
     Property Set SetTransparent(Value As Integer)
         .Transparent = value
         .RecreateWnd
     End Property
     
     Property Set SetWrapable(Value As Integer)
         .Wrapable = Value
         .RecreateWnd
     End Property
     
     Property Set SetDivider(Value As Integer)
         .Divider = Value
         .RecreateWnd
     End Property
     
     Property Set SetEnabled(Value As Integer)
         .Enabled = Value
         If .Handle Then EnableWindow(.Handle,.Enabled)
     End Property
     
     Property Set SetVisible(Value As Integer)
         .Visible = value
         If .Handle Then ShowWindow(.Handle,IIf(Value,SW_SHOW,SW_HIDE))
     End Property
     
     Property Set SetButtonWidth(Value As Integer)
         .ButtonWidth = value
         If .Handle Then
            SendMessage(.Handle,TB_SETBUTTONSIZE,0,(.ButtonHeight * &H10000) Or (.ButtonWidth And &HFFFF))
            .Invalidate
         End If
     End Property

     Property Set SetButtonHeight(Value As Integer)
         .ButtonHeight = value
         If .Handle Then
            SendMessage(.Handle,TB_SETBUTTONSIZE,0,(.ButtonHeight * &H10000) Or (.ButtonWidth And &HFFFF))
            .Invalidate
         End If
     End Property
     
     Property Set SetFont(Value As QFont)
         .Font.Name    = Value.Name
         .Font.Size    = value.Size
         .Font.CharSet = value.CharSet
         If GetObject(Value.Handle,SizeOf(This.LF),.LF) Then
            If .LF.lfWeight > 400 Then .Font.AddStyles fsBold
            If .LF.lfItalic    Then .Font.AddStyles fsItalic
            If .LF.lfUnderline Then .Font.AddStyles fsUnderline
            If .LF.lfStrikeout Then .Font.AddStyles fsStrikeout
         End If
         If .Handle Then SendMessage(.Handle,WM_SETFONT,.Font.Handle,1)
     End Property
     
     Sub AddButton(ImageIndex&,Caption$,Style&)
         .IDCommand++
         .TB.fsStyle   = IIf(Style& = 0,TBSTYLE_BUTTON,Style&)
         .TB.fsState   = TBSTATE_ENABLED
         .TB.iBitmap   = ImageIndex&
         .TB.idCommand = .IDCommand
         .TB.iString   = IIf(Caption$ <> "",NewZStr(Caption$),0)
         .TB.dwData    = NewPtr(SizeOf(This.ToolButton),.ToolButton)
         If SendMessageA(.Handle,TB_ADDBUTTONS,1,.TB) Then
            .Buttons.AddItems Str$( NewPtr(SizeOf(This.TB),.TB) )
         End If
     End Sub
     
     Sub AddSeparator
         .TB.fsStyle   = TBSTYLE_SEP
         .TB.fsState   = TBSTATE_ENABLED
         .TB.iBitmap   = -1
         .TB.idCommand = -1
         .TB.dwData    = 0
         .TB.iString   = 0
         If SendMessageA(.Handle,TB_ADDBUTTONS,1,.TB) Then
            .Buttons.AddItems Str$( NewPtr(SizeOf(This.TB),.TB) )
         End If
     End Sub
     
     Sub InsButton(Index&,ImageIndex&,Caption$,Style&)
         .IDCommand++
         .TB.fsStyle   = IIf(Style& = 0,TBSTYLE_BUTTON,Style&)
         .TB.fsState   = TBSTATE_ENABLED
         .TB.iBitmap   = ImageIndex&
         .TB.idCommand = .IDCommand
         .TB.iString   = IIf(Caption$ <> "",NewZStr(Caption$),0)
         .TB.dwData    = NewPtr(SizeOf(This.ToolButton),.ToolButton)
         If SendMessageA(.Handle,TB_INSERTBUTTON,Index&,.TB) Then
            .Buttons.InsertItem Index&,Str$( NewPtr(SizeOf(This.TB),.TB) )
         End If
     End Sub
     
     Sub DelButton(Index&)
         If Index& > -1 And Index& < .ButtonCount Then ' inc2026: < .ButtonCount вместо < .ButtonCount -1: иначе последнюю кнопку удалить нельзя; допустимые индексы 0..ButtonCount-1, как проверка в GetCommandID (строка 143)
            DefInt Ptr = .Button(Index&)
            PtrFree(Ptr)
            .Buttons.DelItems Index&
            SendMessage(.Handle,TB_DELETEBUTTON,Index&,0)
         End If
     End Sub

     Function ParentWndProc(hWnd&,Msg&,wParam&,lParam&) As Integer
         Select Case Msg&
         Case WM_COMMAND
              DefInt Index
              If lParam& = .Handle Then
                 Index = SendMessageA(.Handle,TB_COMMANDTOINDEX,LoWord(wParam&),0)
                 If Index <> -1 Then
                    If SendMessageA(.Handle,TB_GETBUTTON,Index,.TB) Then
                       If .TB.fsStyle = tbsCheck Or .TB.fsStyle = tbsCheckGroup Then
                          If .TB.dwData Then
                             MemCpy .ToolButton,.TB.dwData,SizeOf(This.ToolButton)
                             .ToolButton.Down = SendMessageA(.Handle,TB_ISBUTTONCHECKED,LoWord(wParam&),0)
                             MemCpy .TB.dwData,.ToolButton,SizeOf(This.ToolButton)
                          End If
                       End If
                    End If
                    If .OnButtonClick Then CallFunc .OnButtonClick,Index
                 End If
              End If
         Case WM_NOTIFY
              MemCpy .NM,LParam&,SizeOf(This.NM)
              If .NM.code = TTN_NEEDTEXT Then
                 MemCpy .TTX,LParam&,SizeOf(This.TTX)
                 Index = .GetIndex(.TTx.hdr.idFrom)
                 MemCpy .TB,.Button(Index),SizeOf(This.TB)
                 If .TB.dwData Then
                    MemCpy .ToolButton,.TB.dwData,SizeOf(This.ToolButton)
                    If .ToolButton.ShowHint Then
                       .TTx.lpszText = .ToolButton.Hint
                       MemCpy LParam&,.TTX,SizeOf(This.TTX)
                    End If
                 End If
              End If
              If .NM.code = TBN_DROPDOWN Then
                 MemCpy .TBn,LParam&,SizeOf(This.TBn)
                 If .Tbn.iItem <> -1 Then
                    SendMessage(.Tbn.hdr.hwndFrom,TB_GETRECT,.Tbn.iItem,.R)
                    MapWindowPoints(.Tbn.hdr.hwndFrom,0,.R,2)
                    index = SendMessageA(.Tbn.hdr.hwndFrom,TB_COMMANDTOINDEX,.Tbn.iItem,0)
                    If SendMessageA(.Tbn.hdr.hwndFrom,TB_GETBUTTON,index,.TB) Then
                       If .TB.dwData Then
                          MemCpy .ToolButton,.TB.dwData,SizeOf(This.ToolButton)
                          TrackPopupMenu(.ToolButton.DropDown,0,.R.Left,.R.Bottom,0,.Tbn.hdr.hwndFrom,0)
                       End If
                    End If
                 End If
              End If
         End Select
         Result = CallWindowProc(.LastParentProc,hWnd&,Msg&,wParam&,lParam&)
     End Function
     
     Function WndProc(hWnd&,Msg&,wParam&,lParam&) As Integer
         Select Case Msg&
         Case WM_RBUTTONDOWN
              .P.x = LoWord(lParam&)
              .P.y = HiWord(lParam&)
              ClientToScreen(.Handle,.P)
              TrackPopupMenu(.PopupMenu.Handle,0,.P.x,.P.y,0,.Handle,0)
         Case WM_COMMAND
              If .OnCommand Then CallFunc .OnCommand,HiWord(wParam&),LoWord(wParam&),lParam&
         End Select
         Result = CallWindowProc(.ClassProc,hWnd&,Msg&,wParam&,lParam&)
     End Function
     
     Sub Register
         DefInt F4,ClassProc
         Dim Wc As WNDCLASS
         Bind F4 To This.WndProc
         .NewProc = SetNewCallBack_4(F4)
         Bind F4 To This.ParentWndProc
         .ParentProc = SetNewCallBack_4(F4)
         InitCommonControls
         If GetClassInfo(0,"ToolBarWindow32",Wc) Then
            .ClassProc = Wc.lpfnWndProc
            If GetClassInfo(GetModuleHandle(0),"QToolBar",Wc) = 0 Then
               Wc.lpfnWndProc   = .NewProc
               Wc.lpszClassName = NewZStr("QToolBar")
               Wc.hInstance     = GetModuleHandle(0)
               RegisterClass(Wc)
            End If
         End If
     End Sub
     
     End With
     
     Constructor
     Register
     IDCommand   = 10
     Autosize    = 1
     Visible     = 1
     Transparent = 1
     Width       = 221
     Height      = 26
     End Constructor
End Type

'============================================================================
'[build_inc] QToolBarEX.inc
'============================================================================
'
' Generic toolbar using QPanel & QCoolBtns v1.1
' Author:   d_homans@yahoo.com.au
' Date:     1 Mar 2011
'
' Note:
'   This is a modified version of my QToolBarEX. The QCoolBtns have been
'   moved into the 'PUBLIC' area of the code hence are "visible" to the
'   RapidFRM application, so that I can copy the bitmaps of the non-visible 
'   components for use elsewhere. 
'
'~inc $INCLUDE "QImageListEX.inc"                                             ' Build using a bmp "strip" image   ' уже в сборке или заменён выбранной версией

$IFNDEF MAXTOOLBTNS
$DEFINE MAXTOOLBTNS     64                                              ' User code can alter - to save memory...
$ENDIF                                                                  ' ... usage? or >64 button toolbars?

$IFNDEF __RQINC2
$ENDIF

$IFNDEF True
$ENDIF

DIM ButtonImages AS QImageListEX                                        ' MUST be global!

DECLARE SUB ToolBtnClick_Event(Index AS integer)

TYPE QToolBarEX EXTENDS QPANEL
WITH QToolBarEX

    BMP             AS string  PROPERTY SET SetBtnFile                  ' Load a bitmap file
    BMPHandle       AS integer PROPERTY SET SetBtnResource              ' Load a bitmap resource
    BtnCount        AS integer PROPERTY SET SetBtnCount                 ' Number of button images in bitmap "strip"
    BtnSpacer       AS integer PROPERTY SET SetBtnSpacing               ' Spacing between buttons
    BtnMask         AS integer PROPERTY SET SetBtnMask                  ' Defaults to bottom LHS pixel (of each image!)
    Cursor          AS integer PROPERTY SET SetCursor                   ' Cursor for all buttons
    Enabled         AS integer PROPERTY SET SetBtnEnable                ' Enable/disable all buttons
    GroupIndex      AS integer PROPERTY SET SetGroup                    ' Allows a button in a group to stay down
    Height          AS integer PROPERTY SET SetHeight                   ' Valid for align=alTop or alBottom
    Hint            AS string  PROPERTY SET SetHint                     ' CSV string, one token per button
    NumBMPs         AS integer PROPERTY SET SetBtnBitmaps               ' Number of images per button
    Width           AS integer PROPERTY SET SetWidth                    ' Valid for align=alLeft or alRight
    tbButtons(MAXTOOLBTNS)    AS QCOOLBTN                               ' Unable to "REDIM" on the fly

    OnSelect        AS EVENT(ToolBtnClick_Event)                        ' Button click event sub

PRIVATE:
    BtnWidth        AS integer
    BtnHeight       AS integer

PUBLIC:
    ' Property "meaningless" for alTop, alBottom (depends on parent)
    PROPERTY SET SetWidth(W AS integer)
        SELECT CASE .Align
            CASE alLeft, alRight
                IF W > 0 THEN
                    SUPER.Width=W
                    .Width=W
                    .BtnWidth=W-2
                END IF
        END SELECT
    END PROPERTY

    ' Property "meaningless" for alLeft, alRight (depends on parent)
    PROPERTY SET SetHeight(H AS integer)
        SELECT CASE .Align
            CASE alTop, alBottom
                IF H > 0 THEN
                    SUPER.Height=H
                    .Height=H
                    .BtnHeight=H-2
                END IF
        END SELECT
    END PROPERTY

    PROPERTY SET SetBtnEnable(state AS integer)
    DEFINT i, which

        IF state=False THEN which=False ELSE which=True             ' Just making sure its a 0/1
        FOR i=0 TO .BtnCount-1
            .tbButtons(i).Enabled=which
            .tbButtons(i).ShowHint=which
        NEXT i
        .Enabled=which
    END PROPERTY

    PROPERTY SET SetBtnCount(numButtons AS integer)
        IF (numButtons>0) AND (numButtons<=MAXTOOLBTNS) THEN
            .BtnCount=numButtons
        END IF
    END PROPERTY

    PROPERTY SET SetBtnSpacing(gap AS integer)
        IF gap >= 0 THEN
            .BtnSpacer=gap
        END IF
    END PROPERTY

    PROPERTY SET SetBtnMask(Mask AS integer)
        .BtnMask=Mask                                                   ' FIXME: Override default?
    END PROPERTY

    ' Bitmaps per button (1 to 4 for a QCoolBtn)
    PROPERTY SET SetBtnBitmaps(imgCount AS integer)
        IF (imgCount>0) AND (imgCount<5) THEN
            .NumBMPs=imgCount
        END IF
    END PROPERTY

    PROPERTY SET SetGroup(Index AS integer)
    DEFINT i, maxbtns

        ' NB IF BtnCount has not been set yet in user code, fudge it
        maxbtns=IIF(.BtnCount=0,MAXTOOLBTNS,.BtnCount)
        IF .GroupIndex<>Index THEN
            .GroupIndex=Index                                           ' Any non-zero value will do
            IF (Index=0) OR ((Index<>0) AND (.NumBMPs=4)) THEN          ' IF we have 4 imgs per button
                FOR i=0 TO maxbtns-1
                    .tbButtons(i).GroupIndex=Index                      ' Set the button
                NEXT i
            END IF
        END IF
    END PROPERTY
    
    PROPERTY SET SetCursor(curType AS integer)
        IF (curType >= -21) AND (curType <= 0) THEN
            .Cursor=curType
        END IF
    END PROPERTY

    ' Multi-hints CSV string. If button hint string present, then button hint is enabled
    PROPERTY SET SetHint(hString AS string)
    DEFINT i, count, maxbtns

        ' NB IF BtnCount has not been set yet in user code, fudge it
        maxbtns=IIF(.BtnCount=0,MAXTOOLBTNS,.BtnCount)
        IF hString="" THEN
            FOR i=0 TO maxbtns-1
                .tbButtons(i).Hint=""
                .tbButtons(i).ShowHint=False
            NEXT i
        ELSE
            count=TALLY(hString,",")+1
            FOR i=0 TO maxbtns-1
                IF (i+1)>count THEN EXIT FOR                            ' More Btns than hints?
                .tbButtons(i).Hint=FIELD$(hString,",",i+1)
                .tbButtons(i).ShowHint=True
            NEXT i
            FOR i=i TO maxbtns-1                                        ' Tidy up
                .tbButtons(i).ShowHint=False
            NEXT i
        END IF
        .Hint=hString
    END PROPERTY

PRIVATE:
    SUB WhichButton(Sender AS QCOOLBTN)
        IF .OnSelect>0 THEN
            CALLFUNC(.OnSelect,Sender.Tag)                              ' Call the click event
        END IF
    END SUB

    SUB InitButtons
    DEFINT i

        FOR i=0 TO .BtnCount-1
            .tbButtons(i).Parent=THIS
            SELECT CASE .Align
                CASE alLeft, alRight
                    .tbButtons(i).Left=1
                    .tbButtons(i).Top=i*(.BtnHeight+.BtnSpacer)+1       ' Fix for each button
                CASE alTop, alBottom
                    .tbButtons(i).Left=i*(.BtnWidth+.BtnSpacer)+1       ' ditto
                    .tbButtons(i).Top=1
            END SELECT
            .tbButtons(i).Width=.BtnWidth
            .tbButtons(i).Height=.BtnHeight
            .tbButtons(i).Spacing=0
            .tbButtons(i).Flat=True
            .tbButtons(i).Cursor=.Cursor
            .tbButtons(i).NumBMPs=.NumBMPs
            IF .NumBMPs=4 THEN
                .tbButtons(i).GroupIndex=.GroupIndex                    ' Only if images support it
            END IF
            .tbButtons(i).Tag=i                                         ' Internal use
            .tbButtons(i).BMP=ButtonImages.GetBMP(i)                    ' Load button image(s)
            .tbButtons(i).OnClick=THIS.WhichButton
        NEXT i
        FOR i=i TO MAXTOOLBTNS
            .tbButtons(i).Enabled=False
            .tbButtons(i).Visible=False
        NEXT i
    END SUB

    SUB ProcessTheButtons
    DEFINT imgWidth, imgHeight

        imgWidth=ButtonImages.Width\.NumBMPs                            ' Button img width
        imgHeight=ButtonImages.Height                                   ' Button img height

        SELECT CASE .Align
            CASE alTop, alBottom
                IF .Width=0 THEN                                        ' Using the bitmap dimensions
                    .BtnWidth=imgWidth+2                                ' Using a FIXED 1 pixel border
'                    .Width=(imgWidth+4)*.BtnCount+4                    ' Width may depend on Parent! Leaving as 0
                END IF
                IF .Height=0 THEN THIS.SetHeight(imgHeight+4)           ' 1 pixel border for button + ...
            CASE alLeft, alRight                                        ' ...1 pixel border for parent
                IF .Height=0 THEN                                       ' Using the bitmap dimensions
                    .BtnHeight=imgHeight+2
'                    .Height=(imgHeight+4)*.BtnCount+4                  ' Height may depend on Parent! Leaving as 0
                END IF
                IF .Width=0 THEN THIS.SetWidth(imgWidth+4)
        END SELECT
        .InitButtons
    END SUB

PUBLIC:
    PROPERTY SET SetBtnFile(FileStr AS string)
        IF FileExists(FileStr)=0 THEN  ShowMessage "File error! Cannot load bitmap": EXIT SUB
        IF .BtnCount=0 THEN ShowMessage "Button count not set! Cannot load bitmap": EXIT SUB
        IF (.Align=alClient) OR (.Align=alNone) THEN .Align=alTop       ' Not allowed default to top

        ButtonImages.FixWidth=0: ButtonImages.FixHeight=0               ' Default - no stretch
        SELECT CASE .Align
            CASE alLeft, alRight
                IF .Width>0 THEN ButtonImages.FixWidth=(.Width-4)*.NumBMPs   ' Not using defaults of bitmap?
            CASE alTop, alBottom
                IF .Height>0 THEN ButtonImages.FixHeight=.Height-4      '  Not using defaults of bitmap?
        END SELECT

        ButtonImages.ExtractFile(FileStr,.BtnCount,.BtnMask)            ' Load the image cache

        IF ButtonImages.Count<>.BtnCount THEN
            ShowMessage "Unknown error! Failed to load bitmap"
        ELSE
            .ProcessTheButtons
        END IF
    END PROPERTY

    PROPERTY SET SetBtnResource(ResIndex AS integer)
        IF .BtnCount=0 THEN ShowMessage "Button count not set! Cannot load bitmap": EXIT SUB
        IF (.Align=alClient) OR (.Align=alNone) THEN .Align=alTop       ' Not allowed default to top

        ButtonImages.FixWidth=0: ButtonImages.FixHeight=0               ' Default - no stretch
        SELECT CASE .Align
            CASE alLeft, alRight
                IF .Width>0 THEN ButtonImages.FixWidth=(.Width-4)*.NumBMPs
            CASE alTop, alBottom
                IF .Height>0 THEN ButtonImages.FixHeight=.Height-4
        END SELECT

        ButtonImages.ExtractRes(ResIndex,.BtnCount,.BtnMask)            ' Load the image cache

        IF ButtonImages.Count<>.BtnCount THEN
            ShowMessage "Unknown error! Failed to load bitmap"
        ELSE
            .ProcessTheButtons
        END IF
    END PROPERTY

    EVENT OnClick
    ' Do nothing on clicking the QPanel
    END EVENT

CONSTRUCTOR
    Align=alTop
    Left=0
    Top=0
    Width=0
    Height=0
    BtnCount=0
    BtnSpacer=1
    BtnMask=&hffffff
    NumBMPs=1
    GroupIndex=0
    Enabled=True
    Hint=""
    Cursor=0                                                            ' crDefault
    OnSelect=0                                                          ' Default no OnClick
END CONSTRUCTOR
END WITH
END TYPE

'============================================================================
'[build_inc] QTreeviewEx.inc
'============================================================================
$typecheck on
'~inc $include "fileops.inc"   ' уже в сборке или заменён выбранной версией

type QtreeviewEx extends Qtreeview

function getparent (i as integer) as integer
Dim startlevel as integer
startlevel = QtreeviewEx.item(i).level
if startlevel = 0 then result = -1
if i = -1 then result = i
do
if QtreeviewEx.item(i).level < startlevel then Exit do
dec(i)
loop until i = -1
result = i
end function
'_______________________________________________________________________________
function getindex(from as integer, itemtext as string) as integer
dim i as integer
i = From
do
if QtreeviewEx.item(i).text = itemtext then exit do
inc(i)
loop until i = QtreeviewEx.itemcount
if i = QtreeviewEx.itemcount then i = -1
result = i
end function
'_______________________________________________________________________________
function strgetparent(itemtext as string) as integer
dim i as integer
with QtreeviewEx
     i = .getindex(0, itemtext)
     i = .getparent(i)
     result = i
end with
end function
'_______________________________________________________________________________
Function getchildrenlist (i as integer) as string
if QtreeviewEx.item(i).haschildren = 0 then result = ""
dim startlevel as integer
dim templist as string
templist = ""
startlevel = QtreeviewEx.item(i).level + 1
inc(i)
do
if QtreeviewEx.item(i).level = startlevel then
templist = templist + QtreeviewEx.item(i).text + ","
elseif QtreeviewEx.item(i).level < startlevel then
exit do
end if
inc(i)
loop until i = QtreeviewEx.itemcount
result = left$(templist, len(templist) - 1)
end function
'_______________________________________________________________________________
sub addchildto (startfrom as integer, itemtext as string, childtext as string)
with QtreeviewEx
.addchilditems (.getindex(startfrom, itemtext), childtext)
end with
end sub
'_______________________________________________________________________________
function Branchlength (i as integer) as integer
defint startlevel, x, y
with qtreeviewex
if .item(i).haschildren = 0 then
    result = 1
else
    startlevel = .item(i).level
    x = i + 1
    y = .itemcount
    if x = y then result = 0

        do
        if .item(x).level <= startlevel then
            exit do
        else
            inc(x)
        end if
        loop until x = y
result = x - i
end if
end with
end function
'_______________________________________________________________________________
sub MoveDown (i as integer)
defint x,y, startlevel, destindex, howmany
dim sl as qstringlist

with QtreeviewEx
x = i + 1
y = .itemcount
if i = y then exit sub

startlevel = .item(i).level

do
if .item(x).level = startlevel then
    destindex = x + .branchlength(x) - 1
    exit do
elseif .item(x).level < startlevel then
    exit sub
end if
inc(x)
loop until x = y

.savetofile (homedir + "tmp_tree.tv")
end with

with sl
