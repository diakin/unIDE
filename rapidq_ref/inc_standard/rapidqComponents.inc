'*********************************************************************************

TYPE QWebCam EXTENDS QOBJECT

PUBLIC:
	CapStats       AS CAPSTATUS        'leave these public
	CapParms       AS CAPTUREPARMS

    'general prop/Methods
	hCapWnd        	AS LONG		'our capture window frame (not parent)
	CamNum			AS LONG		'in case more than one camera & driver, index 0 - 9
	Left			AS LONG
	Top				AS LONG
	Width			AS LONG
	Height			AS LONG
	Init 			AS LONG
	ImageHeight		AS LONG		PROPERTY SET SetImageHeight
	ImageWidth		AS LONG		PROPERTY SET SetImageWidth
	BitCount		AS WORD		PROPERTY SET SetBitCount
	Preview			AS LONG		PROPERTY SET SetPreview
	Capture 		AS LONG		PROPERTY SET SetCapture         'to file or each frame buffer
    Yield           AS LONG     PROPERTY SET SetYield           'Capture via background task?

	'This is an Event but Function pointers don't give absolute address so this doesnt work ->EVENT(OnFrame_EventTemplate)
    OnFrame 		AS LONG		PROPERTY SET SetOnFrame
    FrameNum        AS LONG     'Current frame captured
	FrameInterval	AS WORD		'Interval, in milliseconds, between frames are captured and displayed
	FramesDropped	AS LONG
    ShowErrors      As LONG
    Error           AS LONG     ' Error value after any operation
	Caption			AS STRING
	Tag				AS LONG		'window ID from createWindow function
	FormStyle		AS LONG
	Overlay			AS LONG
    FrameBuffers    AS LONG     'max number of requested frame buffers

    'additional CapStatus parameters-- use .GetStatus to load
    AudioHardware   AS LONG     'hardware present?
    AudioBuffers    AS LONG     'Actual number of audio buffers
    TimeElapsedMS   AS LONG     'Elapsed capture duration
    WaveSamples     AS LONG     '# of wave samples cap'td

WITH THIS

FUNCTION GetStatus() AS LONG
	RESULT = 0
	IF capGetStatus(.hCapWnd, This.CapStats, SIZEOF(This.CapStats)) THEN
		.ImageHeight = .CapStats.uiImageHeight
		.ImageWidth	= .CapStats.uiImageWidth
		.FramesDropped = .CapStats.dwCurrentVideoFramesDropped
		.Overlay = .CapStats.fOverlayWindow        ' Now Overlaying video?
		.Preview = .CapStats.fLiveWindow           'live capture?
        .FrameNum = .CapStats.dwCurrentVideoFrame
        .Error = .CapStats.dwReturn
        .AudioHardware = .CapStats.fAudioHardware
        .FrameBuffers = .CapStats.wNumVideoAllocated
        .AudioBuffers = .CapStats.wNumAudioAllocated
        .TimeElapsedMS = .CapStats.dwCurrentTimeElapsedMS
        .WaveSamples = .CapStats.dwCurrentWaveSamples
'     fScale As Long                          ' Scale image to client?
'     ptScroll_x As Long
'     ptScroll_y As Long
'     fUsingDefaultPalette As Long            ' Using default driver palette?
'     fCapFileExists As Long                  ' Does capture file exist?
'     hPalCurrent As Long                     ' Current palette in use
		RESULT = True
	END IF
END FUNCTION

FUNCTION GetParameters(MyParams AS CAPTUREPARMS) AS LONG
    RESULT = capCaptureGetSetup(.hCapWnd, MyParams, SizeOf(MyParams))
END FUNCTION

FUNCTION SetParameters(MyParams AS CAPTUREPARMS) AS LONG
    RESULT = capCaptureSetSetup(.hCapWnd, MyParams, SizeOf(MyParams))
END FUNCTION

FUNCTION CamInit(Form AS QFORM) AS LONG			'Create Cap Window, init the web cam
	DIM rtn AS LONG
	DIM	DriverCaps	AS CAPDRIVERCAPS

	IF .Init THEN EXIT FUNCTION		'been here before? Then don't run

	'**** use capCapture from vfw.inc  ******
	.hCapWnd = capCreateCaptureWindow(.Caption, .FormStyle, .Left, .Top, .Width, .Height, Form.Handle, .tag)
	IF .hCapWnd = 0 THEN
		IF .ShowErrors THEN 
            .GetStatus
            ShowMessage("Could not create capture window: " + STR$(.Error))
        END IF
		RESULT = 0
		EXIT FUNCTION
	END IF

	' Get the current streaming video parms, and reset with user values
    .GetParameters(This.CapParms)
	.CapParms.dwRequestMicroSecPerFrame = .FrameInterval '3333 = 30 frames per second
	.CapParms.fYield = .Yield                         ' capture in background/allow processing
	.CapParms.wNumVideoRequested = .FrameBuffers      ' max number of video frame buffs - just a guess
	.CapParms.fCaptureAudio = false                   ' don't capture audio
	.CapParms.AVStreamMaster = AVSTREAMMASTER_NONE    ' no audio/video syncing

    'set up the driver and capture, should do .GetStatus 'to check if values set...
    IF .SetParameters(This.CapParms) = 0 THEN
        IF .ShowErrors THEN ShowMessage "Set setup failed"
    END IF

	rtn = capDriverConnect (.hCapWnd, .CamNum)         'connect
	IF rtn THEN 
		capDriverGetCaps(.hCapWnd, DriverCaps, sizeof (DriverCaps))
		.Init = DriverCaps.fCaptureInitialized
		.CamNum = DriverCaps.wDeviceIndex	'reset Connect?
		.Overlay = DriverCaps.fHasOverlay
		IF .Overlay THEN .Overlay = capOverlay(.hCapWnd, True)		'auto turn on Overlay
		IF .Preview THEN
			capPreviewRate(.hCapWnd, .FrameInterval)
			.Preview = capPreview(.hCapWnd, True)
		END IF
		IF (.OnFrame <> 0) THEN
			IF capSetCallbackOnFrame(This.hCapWnd, This.OnFrame) = 0 THEN
        		IF .ShowErrors THEN ShowMessage "Frame Callback Error"
            END IF
		END IF
	ElSE
  		IF .ShowErrors THEN 
           .GetStatus
           ShowMessage("Could not connect to camera: " + STR$(.Error))
        END IF
	END IF
	RESULT = rtn
END FUNCTION

SUB SetOnFrame(TheCallBackAddr AS LONG)		'pass in 0 to turn off callback
	.OnFrame = TheCallBackAddr
	IF .Init THEN
		IF capSetCallbackOnFrame(This.hCapWnd, This.OnFrame) = 0 THEN 
            IF .ShowErrors THEN ShowMessage "Frame Callback Error"
        END IF
	END IF
END SUB

FUNCTION SetImageSize(TheImageWidth AS LONG, TheImageHeight AS LONG) AS LONG
	DIM VideoFormat AS BITMAPINFO
	DIM SzbmpInfo AS DWORD: SzbmpInfo = SIZEOF(VideoFormat)

	IF (TheImageHeight > 0) AND (TheImageWidth > 0) THEN
		.ImageWidth =  TheImageWidth
		.ImageHeight =  TheImageHeight
		IF .Init THEN
			SzbmpInfo = capGetVideoFormat(This.hCapWnd, VideoFormat, SzbmpInfo) 'get current format
			IF SzbmpInfo = 0 THEN 
          		IF .ShowErrors THEN 
                   .GetStatus
                   ShowMessage("Could not set image size: " + STR$(.Error))
                END IF
                RESULT = 0: EXIT FUNCTION		'crashed!
            END IF
			VideoFormat.bmiHeader_biSize = SzbmpInfo
			VideoFormat.bmiHeader_biHeight = TheImageHeight		'if positive, bitmap is bottom-up DIB (origin = lower left corner). If biHeight is negative,  bitmap is top-down DIB (origin = upper left corner)
			VideoFormat.bmiHeader_biWidth = TheImageWidth
			IF capSetVideoFormat(This.hCapWnd, VideoFormat, SzbmpInfo) THEN
        		.ImageWidth =  TheImageWidth
        		.ImageHeight =  TheImageHeight
				RESULT = True
      		ELSEIF .ShowErrors THEN 
                .GetStatus
                ShowMessage("Could not set image size: " + STR$(.Error))
                RESULT = False
			END IF
		END IF
	END IF
END FUNCTION

FUNCTION SetImageHeight (TheImageHeight AS LONG) AS LONG
	DIM VideoFormat AS BITMAPINFO
	DIM SzbmpInfo AS DWORD: SzbmpInfo = SIZEOF(VideoFormat)

	IF TheImageHeight > 0 THEN
		.ImageHeight =  TheImageHeight
		IF .Init THEN
			SzbmpInfo = capGetVideoFormat(This.hCapWnd, VideoFormat, SzbmpInfo)
			IF SzbmpInfo = 0 THEN 
          		IF .ShowErrors THEN 
                   .GetStatus
                   ShowMessage("Could not set image size: " + STR$(.Error))
                END IF
                RESULT = 0: EXIT FUNCTION		'crashed!
            END IF
			VideoFormat.bmiHeader_biSize = SzbmpInfo
			VideoFormat.bmiHeader_biHeight = TheImageHeight		'if positive, bitmap is bottom-up DIB (origin = lower left corner). If biHeight is negative,  bitmap is top-down DIB (origin = upper left corner)
			IF capSetVideoFormat(This.hCapWnd, VideoFormat, SzbmpInfo) THEN
				.ImageHeight =  TheImageHeight
				RESULT =  TheImageHeight
			END IF
		END IF
	END IF
END FUNCTION

FUNCTION SetImageWidth (TheImageWidth AS LONG) AS LONG ' inc2026: было SUB ... AS LONG с RESULT внутри и END SUB (строка 945); стало FUNCTION, как SetImageHeight (строка 902): результат используется в конструкторе, строка 1128
