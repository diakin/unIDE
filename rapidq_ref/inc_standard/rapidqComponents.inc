  AppVersion as string
  text as string
  Email as string
  Web as string
  AppFont as QFont
  TextFont as QFont
  EmailFont as QFont
  WebFont as QFont

  '==================================
  ' Mйthode affichage boite dialogue
  '==================================
  Sub Show
    with QAbout
      'definition image
      .image.parent=.cadre
      .image.top=15
      .image.left=10
      .image.autosize=true
      'definition label1
      .label1.autosize=true
      .label1.left=.image.left+.image.width+20
