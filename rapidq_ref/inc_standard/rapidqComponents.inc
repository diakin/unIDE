'============================================================================
'[build_inc] COMPORTxp.inc
'============================================================================

'Win32 File Handling Constants

'dwDesired Access Constants
Const GENERIC_READ_cmp          = &H80000000
CONST GENERIC_WRITE_cmp         = &H40000000

'Error Message Constants
CONST ERROR_OPEN_PORT                 = "There was an error opening the Comm Port.  "
CONST ERROR_PORT_BUFFERS              = "There was an error creating the Comm Port Buffers.  "
CONST ERROR_PURGE_BUFFERS             = "There was an error purging old data from the Comm Port Buffers.  "
CONST ERROR_TIMEOUTS                  = "There was an error setting the Comm Port timeouts.  "
CONST ERROR_RETRIEVE_PORTSETTINGS     = "There was an error retrieving the existing Comm Port settings.  "
CONST ERROR_CHANGING_PORTSETTINGS     = "There was an error changing the Comm Port settings.  "
CONST ERROR_CLOSING_PORT              = "There was an error closing the Comm Port.  "
CONST ERROR_WRITING_PORT              = "There was an error writing data to the Comm Port.  "
CONST ERROR_SENDING_DATA              = "Could not send all the data in time specified.  Try increasing your wait time."
CONST ERROR_GETTING_PORT_STATUS       = "There was an error getting the Comm Ports current status.  " 
CONST ERROR_READING_PORT              = "There was an error reading data from the Comm Port.  "

                                                    'See http://msdn.microsoft.com/library/default.asp?url=/library/en-us/debug/errlist_7oz7.asp
                                                    'for what codes mean

'Converts GetLastError codes to string messages.
Declare Function FormatMessage_COMPORTxp Lib "kernel32" Alias "FormatMessageA" _
    (dwFlags AS DWORD, _                            '[IN] Specifies aspects of the formatting process and how to interpret lpSource
    BYREF lpSource As LONG, _                       '[IN] Specifies the location of the message definition
    dwMessageId AS DWORD, _                         '[IN] Specifies the message identifier for the requested message
    dwLanguageId AS DWORD, _                        '[IN] Specifies the language identifier for the requested message
    BYREF lpBuffer As STRING, _                     '[OUT] Pointer to a buffer for the formatted message
    nSize AS DWORD, _                               '[IN] specifies the max number of characters that can be stored in the output buffer
    BYREF Arguments As Long) _                      '[IN] Pointer to an array of values that are used as insert values in the formatted message
      AS LONG                                       ''If function succeeds, returns non-zero. If function fails, returns 0. 

'Internal Declarations

TYPE MyCom_Port EXTENDS QObject

  'EVENTS
  OnComError    AS EVENT (OnComError_EventTemplate)
  OnOpen        AS EVENT (OnOpen_EventTemplate)
  OnClose       AS EVENT (OnClose_EventTemplate)
  OnWriteString AS EVENT (OnWriteString_EventTemplate)
  OnReadString  AS EVENT (OnReadString_EventTemplate)

  'PROPERTIES
  Handle            AS LONG
  Port              AS STRING
  BaudRate          AS DWORD
  DataBits          AS BYTE
  Parity            AS BYTE
  StopBits          AS BYTE
  ReadBufSize       AS DWORD
  WriteBufSize      AS DWORD
  BytesNotRead      AS DWORD
  BytesNotWritten   AS DWORD
  Connected         AS BYTE

  'Default property values
  CONSTRUCTOR
    Port            = "COM1"
    BaudRate        = 9600
    DataBits        = 8
    Parity          = NOPARITY
    StopBits        = 1
    ReadBufSize     = 1024
    WriteBufSize    = 1024
    BytesNotRead    = 0
    BytesNotWritten = 0
    Connected       = FALSE
  END CONSTRUCTOR

  'METHODS

  'Method FormatError (Convert GetLastError codes to String messages)
  PRIVATE:
  FUNCTION FormatError AS STRING

    DIM lngSource     AS LONG
    DIM lngArguments  AS LONG
    DIM Buffer        AS STRING
    DIM lngRet        AS LONG

    lngSource   =0
    lngArguments=0
    Buffer=SPACE$(1024)
    
    lngRet=FormatMessage_COMPORTxp (FORMAT_MESSAGE_FROM_SYSTEM, _
                         lngSource, _
                         GetLastError, _
                         LANG_NEUTRAL, _
                         Buffer, _
                         LEN(Buffer), _
                         lngArguments)
                         
    Result=LEFT$(Buffer,lngRet)
  
  END FUNCTION

  'Method GetStatus
  PRIVATE:
  SUB GetCommStatus

    DIM lngStatus     AS LONG
    DIM dwErrorFlags  AS DWORD
    DIM udtCommStat   AS COMSTAT
  
  'Clear any previous errors and get current status.
    lngStatus = ClearCommError(MyCom_Port.Handle, _
                               dwErrorFlags, _
                               udtCommStat)
                               
    IF lngStatus = 0 THEN
      IF MyCom_Port.OnComError > 0 THEN
        CALLFUNC (MyCom_Port.OnComError, ERROR_GETTING_PORT_STATUS & MyCom_Port.FormatError) ' inc2026: было ERROR_CHANGING_PORTSETTINGS, стало ERROR_GETTING_PORT_STATUS: ошибка ClearCommError - это ошибка получения состояния порта; константа ERROR_GETTING_PORT_STATUS (строка 139) объявлена и больше нигде не используется
      END IF 
    ELSE
      'Set BytesNotWritten and BytesNotRead Property
      MyCom_Port.BytesNotWritten = udtCommStat.cbOutQue
      MyCom_Port.BytesNotRead    = udtCommStat.cbInQue        
    END IF
    
  END SUB      

  'Method Open Port
  PUBLIC:
  SUB Open
    
    Dim udtCommTimeOuts As COMMTIMEOUTS
    DIM udtDCB          AS DCB
    DIM lngStatus       AS LONG
    
    'Open the Comm Port
    MyCom_Port.Handle = CreateFile(MyCom_Port.Port, _
                                GENERIC_READ_cmp OR GENERIC_WRITE_cmp, _
                                FILE_SHARE_READ OR FILE_SHARE_WRITE, _
                                0&, _ 
                                OPEN_EXISTING, _
                                FILE_ATTRIBUTE_NORMAL, _
                                0&)

    IF MyCom_Port.Handle = -1 THEN
      IF MyCom_Port.OnComError > 0 THEN
        CALLFUNC (MyCom_Port.OnComError,ERROR_OPEN_PORT & MyCom_Port.FormatError)
      END IF
      EXIT SUB
    END IF

    'Setup device buffers (1K is default).
    lngStatus = SetupComm(MyCom_Port.Handle,_
                    MyCom_Port.ReadBufSize,_
                    MyCom_Port.WriteBufSize)
                    
    IF lngStatus = 0 THEN
      IF MyCom_Port.OnComError > 0 THEN
        CALLFUNC (MyCom_Port.OnComError, ERROR_PORT_BUFFERS & MyCom_Port.FormatError)
      END IF 
      EXIT SUB
    END IF

    'Purge existing data in buffers.
    lngStatus = PurgeComm(MyCom_Port.Handle,_
                      PURGE_TXABORT Or PURGE_RXABORT Or PURGE_TXCLEAR Or PURGE_RXCLEAR)

    IF lngStatus = 0 THEN
      IF MyCom_Port.OnComError > 0 THEN
        CALLFUNC (MyCom_Port.OnComError, ERROR_PURGE_BUFFERS & MyCom_Port.FormatError)
      END IF 
      EXIT SUB
    END IF

    ' Set serial port timeouts values.
    udtCommTimeOuts.ReadIntervalTimeout         = -1
    udtCommTimeOuts.ReadTotalTimeoutMultiplier  = 0
    udtCommTimeOuts.ReadTotalTimeoutConstant    = 1000
    udtCommTimeOuts.WriteTotalTimeoutMultiplier = 0
    udtCommTimeOuts.WriteTotalTimeoutConstant = 1000 ' inc2026: было второе присваивание WriteTotalTimeoutMultiplier = 1000 (строкой выше уже 0), стало WriteTotalTimeoutConstant = 1000: поле WriteTotalTimeoutConstant (строка 16) иначе не задаётся, по образцу ReadTotalTimeoutMultiplier/Constant (строки 399-400)

    lngStatus = SetCommTimeouts(MyCom_Port.Handle,_
                      udtCommTimeOuts)
                      
    IF lngStatus = 0 THEN
      IF MyCom_Port.OnComError > 0 THEN
        CALLFUNC (MyCom_Port.OnComError, ERROR_TIMEOUTS & MyCom_Port.FormatError)
      END IF 
      EXIT SUB
    END IF

    'Get the current state (DCB) - we retain current values for 
    'communication settings we don't explicitly set.
    lngStatus = GetCommState (MyCom_Port.Handle, _
                              udtDCB)

    IF lngStatus = 0 THEN
      IF MyCom_Port.OnComError > 0 THEN
        CALLFUNC (MyCom_Port.OnComError, ERROR_RETRIEVE_PORTSETTINGS & MyCom_Port.FormatError)
      END IF 
      EXIT SUB
    END IF

    'Set our Communications State
    udtDCB.BaudRate = MyCom_Port.BaudRate
    udtDCB.ByteSize = MyCom_Port.DataBits
    udtDCB.Parity   = MyCom_Port.Parity
    udtDCB.StopBits = MyCom_Port.StopBits

    'This changes our settings
    lngStatus = SetCommState (MyCom_Port.Handle, _
                              udtDCB)
                              
    IF lngStatus = 0 THEN
      IF MyCom_Port.OnComError > 0 THEN
        CALLFUNC (MyCom_Port.OnComError, ERROR_CHANGING_PORTSETTINGS & MyCom_Port.FormatError)
      END IF 
    ELSE
      'Set Connected Property
      MyCom_Port.Connected = TRUE
      'Raise OnOpen Event
      IF MyCom_Port.OnOpen > 0 THEN
        CALLFUNC MyCom_Port.OnOpen
      END IF 
    END IF

  END SUB

  'Method Close
  PUBLIC:
  SUB Close
  
    DIM lngStatus AS LONG
    
    'Close COM Port
    lngStatus = CloseHandle (MyCom_Port.Handle)

    IF lngStatus = 0 THEN
      IF MyCom_Port.OnComError > 0 THEN
        CALLFUNC (MyCom_Port.OnComError, ERROR_CLOSING_PORT & MyCom_Port.FormatError)
      END IF 
    ELSE
      'Set Connected Property
      MyCom_Port.Connected = FALSE
      'Raise OnClose Event
      IF MyCom_Port.OnClose > 0 THEN
        CALLFUNC MyCom_Port.OnClose
      END IF 
    END IF

  END SUB
  
  'Method Writestring
  PUBLIC:
  SUB WriteString (strData AS STRING, intWait AS INTEGER)

    DIM lngStatus       AS LONG
    DIM dwBytesToWrite  AS DWORD
    DIM dwByesWritten   AS DWORD
  
    'Set number of bytes to be sent.
    dwBytesToWrite=LEN(strData)

    'Output the data.
    lngStatus = WriteFile(MyCom_Port.Handle, _
                          strData, _
                          dwBytesToWrite, _
                          dwByesWritten, _
                          0&)
                       
    IF lngStatus = 0 THEN
      IF MyCom_Port.OnComError > 0 THEN
        CALLFUNC (MyCom_Port.OnComError, ERROR_WRITING_PORT & MyCom_Port.FormatError)
      END IF 
    ELSE
      'Wait for data to be written
      Sleep(intWait)
      'See if there are any bytes still waiting to be written
      MyCom_Port.GetCommStatus
      'If all data has been sent Raise OnWriteString event
      IF MyCom_Port.BytesNotWritten = 0 THEN
        IF MyCom_Port.OnWriteString > 0 THEN
          CALLFUNC MyCom_Port.OnWriteString
        END IF
      ELSE
        IF MyCom_Port.OnComError > 0 THEN
        CALLFUNC (MyCom_Port.OnComError, ERROR_SENDING_DATA)
      END IF
      END IF 
    END IF

  END SUB

  'Method ReadString
  PUBLIC:
  FUNCTION ReadString (dwRdSize AS DWORD, intWait AS INTEGER) AS STRING

    DIM lngStatus     AS LONG
    DIM dwBytesRead   AS DWORD
    DIM strReadBuffer AS STRING

    'Make enough space in memory for ReadFile to put data in.
    strReadBuffer=SPACE$(MyCom_Port.ReadBufSize)
      
    'Read data from buffer
    lngStatus = ReadFile(MyCom_Port.Handle, _
                         strReadBuffer, _
                         dwRdSize, _
                         dwBytesRead, _
                         0&) ' inc2026: в строке 529 было MyPort.Handle (MyPort - имя экземпляра из примера в документации, работало только при CREATE MyPort AS MyCom_Port), стало MyCom_Port.Handle, как во всех остальных методах типа MyCom_Port
                         
    IF lngStatus = 0 THEN
      IF MyCom_Port.OnComError > 0 THEN
        CALLFUNC (MyCom_Port.OnComError, ERROR_READING_PORT & MyCom_Port.FormatError)
      END IF 
    ELSE
      'Set Return value for this Function
      Result = LEFT$(strReadBuffer, dwBytesRead)
      'Wait for more data to arrive in buffer
      Sleep(intWait)
      'Get number of bytes now waiting to be read
      MyCom_Port.GetCommStatus
      'Raise OnReadString event
      IF MyCom_Port.OnReadString > 0 THEN
        CALLFUNC MyCom_Port.OnReadString
      END IF 

    END IF

  END FUNCTION

END TYPE

'============================================================================
'[build_inc] HiLight.inc
'============================================================================
' Simple Syntax Hilighting example for Rapid-Q by William Yu
'
' QREdit        - Extension of QRichEdit with automatic syntax hilighting
'                 Not very complete, but you can handle all the special cases.
'
' NEW PROPERTIES:
'   HiLighColor - Color to use for hilighting keywords
'
' NEW METHODS:
'   AddSyntaxes - Add any keywords you want hilighted
'       HiLight - Call first time whenever you load a file, or add new lines
'
' There are actually 2 separate ways of doing this, the hard way, and the
' easy way.  The hard way is to learn RTF and create your own RTF document
' programmically. It's definitely more work than the easy way, which I'll
' demonstrate in this example.
' I've decided to incorporate this into a component for easy reuse.

'~app $APPTYPE GUI   ' сборка: задаёт программа, не inc
$TYPECHECK ON
'~inc $INCLUDE "RAPIDQ.INC"   ' уже в сборке или заменён выбранной версией

TYPE QREdit EXTENDS QRichEdit
  RichFont AS QFont
  Syntaxes(100) AS STRING       '-- Better way could be to use a ListBox
  MaxSyntax AS INTEGER
  HiLightColor AS INTEGER
  SUB HiLight
  '-- HiLight first time, call this whenever you insert line(s), or you
  '-- load a file.

    DIM TempStart AS INTEGER
    DIM I AS INTEGER, N AS INTEGER
    defstr UText
    WITH QREdit
      TempStart = .SelStart
      .SelStart = 0
      .SelLength = LEN(.Text)
      .SelAttributes = .RichFont
      UText=UCASE$(.Text)
''      USynt$=
      FOR I = 1 TO .MaxSyntax
        N = INSTR(UText, UCASE$(.Syntaxes(I)))-1
        WHILE N >= 0
          .SelStart = N
          .RichFont.AddStyles(fsBold)
          .RichFont.Color = .HiLightColor
          .SelLength = LEN(.Syntaxes(I))
          .SelAttributes = .RichFont
           N = INSTR(N+.SelLength, UCASE$(.Text), UCASE$(QREdit.Syntaxes(I)))-1
        WEND
        .SelLength = 0
        .RichFont.DelStyles(fsBold)
        .RichFont.Color = 0
        .Font = .RichFont
        .SelStart = TempStart
      NEXT I
    END WITH
  END SUB

  SUBI AddSyntaxes(...)
    DIM I AS INTEGER

    WITH QREdit
      FOR I = 1 TO ParamStrCount
        .Syntaxes(I+.MaxSyntax) = ParamStr$(I)
      NEXT
      .MaxSyntax = .MaxSyntax + ParamStrCount
    END WITH
  END SUBI

  EVENT OnKeyUp (Key AS WORD, Shift AS INTEGER)
    '' Don't want to re-hilight everything, try to isolate a keyword
    '' If you type too fast, this event might be skipped :)
    '' Also beware when the user splits up two words with a space,
    '' that condition isn't handled here.

    DIM I AS INTEGER, EndStr AS INTEGER, StartStr AS INTEGER
    DIM TempStart AS INTEGER, N AS INTEGER
    DIM Token AS STRING
    DIM T1 AS INTEGER, T2 AS INTEGER

    T1 = QREdit.SelStart
    T2 = QREdit.SelLength

    IF Key < 46 AND Key <> 8 THEN     '' Ignore arrows, pageup/down, etc.
      EXIT EVENT
    END IF

    WITH QREdit
      '' Isolate a token, separated by a space (but that's not always the case)
      FOR I = .SelStart TO LEN(.Text)
        IF MID$(.Text, I, 1) = " " OR MID$(.Text, I, 1) = CHR$(13) OR MID$(.Text, I, 1) = CHR$(10) THEN
          EXIT FOR
        END IF
      NEXT I
      EndStr = I
      FOR I = .SelStart TO 1 STEP -1
        IF MID$(.Text, I, 1) = " " OR MID$(.Text, I, 1) = CHR$(10) OR MID$(.Text, I, 1) = CHR$(13) THEN
          EXIT FOR
        END IF
      NEXT I
      StartStr = I+1
      Token = RTRIM$(LTRIM$(MID$(.Text, StartStr, EndStr - StartStr)))

      TempStart = .SelStart
      .SelStart = StartStr-1
      .SelLength = LEN(Token)
      .SelAttributes = .RichFont
      FOR I = 1 TO .MaxSyntax
        IF UCASE$(Token) = UCASE$(.Syntaxes(I)) THEN
          .SelStart = StartStr-1
          .RichFont.AddStyles(fsBold)
          .RichFont.Color = .HiLightColor
          .SelLength = LEN(.Syntaxes(I))
          .SelAttributes = .RichFont
        END IF
      NEXT I
      .SelLength = 0
      .SelStart = TempStart
      .RichFont.DelStyles(fsBold)
      .RichFont.Color = 0
      .Font = .RichFont
    END WITH

    QREdit.SelStart = T1
    QREdit.SelLength= T2
  END EVENT

  constRUCTOR
    PlainText = True
    RichFont.Name = "Courier"
    MaxSyntax = 0
    HiLightColor = &HAA0000
    Font = QREdit.RichFont
  END constRUCTOR
END TYPE

'~define $UNDEF QRICHEDIT   ' сборка: встроенный класс не подменяется
'~define $DEFINE QRICHEDIT QREdit   ' сборка: встроенный класс не подменяется

$TYPECHECK OFF   ' сборка: вернуть после HiLight.inc
'============================================================================
'[build_inc] QAnim.inc
'============================================================================
'=======================================================
' Type Objet
' Classe QAnim Version 1.0
'=======================================================
$IFNDEF TRUE
$ENDIF

$IFNDEF FALSE
$ENDIF

$IFNDEF boolean
$ENDIF

Type QAnim Extends QImage
  PRIVATE:
    Timer as QTimer
  PUBLIC:
    Speed as long property set SetSpeed
    ImageList as QimageList
    Index as short property set SetIndex
    Width as short property set SetWidth
    Height as short property set SetHeight
    BackColor as long property set SetBackColor
    Masked as boolean property set SetMasked
    Move as boolean property set SetMove

  '=====================================
  ' proprietй start/stop animation
  '=====================================
  Property Set SetMove(move as boolean)
    if move then
      if QAnim.ImageList.Count>0 then
        QAnim.Timer.Enabled=true
        QAnim.Move=true
      end if
    else
      QAnim.Timer.Enabled=false
      QAnim.Move=false
      QAnim.Index--
    end if
  End Property  
    
  '=====================================
  ' proprietй couleur de fond
  '=====================================
  Property Set SetBackColor(backcolor as long)
    QAnim.ImageList.bkcolor=backcolor
    if QAnim.ImageList.Count>0 and QAnim.visible=true then
      QAnim.bmp=QAnim.ImageList.GetBMP(QAnim.Index)
      if QAnim.visible=false then QAnim.visible=true
      QAnim.repaint
    end if
  End Property  

  '=========================================
  ' proprietй utilisation du masque image
  '=========================================
  Property Set SetMasked(masked as boolean)
    QAnim.ImageList.masked=masked
    if QAnim.ImageList.Count>0 and QAnim.visible=true then
      QAnim.bmp=QAnim.ImageList.GetBMP(QAnim.Index)
      if QAnim.visible=false then QAnim.visible=true
      QAnim.repaint
    end if
  End Property  
    
  '=====================================
  ' proprietй largeur image
  '=====================================
  Property Set SetWidth(width as short)
    super.width=width
    QAnim.ImageList.Width=width
  End Property  
  
  '=====================================
  ' proprietй hauteur image
  '=====================================
  Property Set SetHeight(height as short)
    super.height=height
    QAnim.ImageList.Height=height
  End Property  
    
  '=====================================
  ' proprietй vitesse animation
  '=====================================
  Property Set SetSpeed(speed as long)
    QAnim.Timer.Interval=speed
  End Property  

  '=====================================
  ' proprietй index image
  '=====================================
  Property Set SetIndex(index as short)
    if QAnim.ImageList.Count>0 then
      QAnim.Index=index
      QAnim.bmp=QAnim.ImageList.GetBMP(index)
      if QAnim.visible=false then QAnim.visible=true
      QAnim.repaint
    end if
  End Property  
  
  '=====================================
  ' evenement timer
  '=====================================
  Event Timer.OnTimer
    if QAnim.Index>QAnim.ImageList.Count-1 then QAnim.Index=0
    QAnim.bmp=QAnim.ImageList.GetBMP(QAnim.Index)
    if QAnim.visible=false then QAnim.visible=true
    QAnim.repaint
    QAnim.Index++
  End Event
      
  Constructor
    Timer.Enabled=false
    Timer.Interval=200
    Visible=false
    Index=0
    Move=false
    ImageList.masked=false
  End Constructor
End Type
      
