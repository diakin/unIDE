Type QProcess extends QObject
  Private:
    IdProcess as long
    hProcess as long
  Public:
    OnProcess as Event(OnProcess_event)
    Priority as long Property set SetPriority
  
    '==========================================
    ' proprietй prioritй process
    '==========================================  
    Property set SetPriority(priority as long)
      this.priority=priority
      IF this.hProcess THEN SetProcessPriority(this.hProcess,this.Priority) 
    end property

   Sub Suspend
        SuspendThread(this.hProcess)
   End Sub

   Sub Resume
        ResumeThread(this.hProcess)
   End Sub

  Private:
    '==========================================
    ' mйthode appelle process
    '==========================================  
    Sub Process
      if This.OnProcess<>0 then CALLFUNC this.OnProcess
    End Sub
    
  Public:
    '==========================================
    ' mйthode exйcution process
    '==========================================  
    Sub Open
      dim PtVar as long
      dim PtSub as long

       if this.hProcess<>0 then TerminateThread(this.hProcess,0)
       PtVar=varptr(this.IdProcess)
       PtSub=CODEPTR(this.Process)
       this.hProcess=CreateThread(0,0,PtSub,0,0,PtVar)
       SetProcessPriority(this.hProcess,this.Priority) 
    End Sub

    '==========================================
    ' mйthode fin process
    '==========================================  
    Sub Close
      if this.hProcess<>0 then TerminateThread(this.hProcess,0)
    End Sub

    Constructor
      priority=0
      IdProcess=0
      hProcess=0    
    End Constructor  
End Type

$ENDIF

'============================================================================
'[build_inc] QProgress.inc
'============================================================================
'=======================================================
'Classe QProgress
'Totally redone by Johnk, didn't work reliably anyway, allows Marquees on Windows95 - XP
'uses multi-threading because it won't udate on one thread
'If you use threading you cannot include another CodePtr(SUB), address is used up!!!
'=======================================================

$IFNDEF __QPROGRESS_INC  'don't reload
    $DEFINE __QPROGRESS_INC

    $IFNDEF __WIN32API  'APIs

        $IFNDEF __RQ2WIN32API
        $ENDIF
    $ENDIF

    $IFNDEF TRUE
    $ENDIF

    $IFNDEF FALSE
    $ENDIF

    $DEFINE gkMovingDot 5
    $DEFINE gkMovingRect 6
    $DEFINE gkMovingBlur 7
    $DEFINE gkBarberPole 8

    TYPE QProgress EXTENDS QIMAGE
        PRIVATE :
        BitMap      AS QBITMAP
        Increment   AS LONG
        ObjSize     AS INTEGER
        Offset      AS INTEGER  'moving graphic
        lpThreadAddr AS LONG    'address of the thread sub
        ThreadID    AS LONG     'for background tasking
        hThread     AS LONG     'handle of the thread
        TIMER       AS QTIMER  'background timer for marquee

        PUBLIC :
        Caption     AS STRING
        Gauge       AS QGAUGE
        StepSize    AS INTEGER
        Interval    AS SINGLE  'update interval
        Visible     AS INTEGER PROPERTY SET SetVisible
        Color       AS INTEGER PROPERTY SET SetColor
        BackColor   AS INTEGER PROPERTY SET SetBackColor
        Range       AS INTEGER PROPERTY SET SetRange
        value       AS INTEGER PROPERTY SET SetValue
        Kind        AS INTEGER PROPERTY SET SetKind
        Height      AS INTEGER PROPERTY SET SetHeight  'superclassing
        Width       AS INTEGER PROPERTY SET SetWidth  'etc..
        UseThreading AS INTEGER PROPERTY SET SetMultiThreading

        WITH THIS

            PRIVATE :

            '***********************************************
            'Create the pretty little graphic or "marquee" for Progress bars without know values
            '***********************************************
            SUB DrawObj
                DIM i AS INTEGER
                DIM j AS SINGLE
                DEFINT r = .Color AND &HFF
                DEFINT g = (.Color AND &HFF00) SHR 8
                DEFINT b = (.Color AND &HFF0000) SHR 16
                DEFINT r2 = .BackColor AND &HFF
                DEFINT g2 = (.BackColor AND &HFF00) SHR 8
                DEFINT b2 = (.BackColor AND &HFF0000) SHR 16

                IF .Kind > 4 THEN
                    .ObjSize = .Height  '* 0.8
                    .BitMap.Height = .ObjSize  'set dimensions for custom
                    .BitMap.Width = .Width * 2
                    .BitMap.FillRect(0 , 0 , .BitMap.Width , .BitMap.Height , .BackColor)
                    .Offset = (.BitMap.Width - .ObjSize) \ 2
                    IF .StepSize = 0 THEN .StepSize = .ObjSize \ 2

                    SELECT CASE .Kind
                        CASE gkMovingDot
                            .BitMap.Circle(.Offset , 0 , .Offset + .ObjSize , .ObjSize , .Color , .Color)

                        CASE gkMovingBlur
                            FOR i = 0 TO .Offset
                                j = i / .Offset  'set gradient
                                .BitMap.Line(i , 0 , i , .ObjSize , _
                                    RGB((r * j) + (r2 * (1 - j)) , (g * j) + (g2 * (1 - j)) , (b * j) + (b2 * (1 - j))))
                            NEXT i

                        CASE gkMovingRect
                            i = .Offset
                            j = 2
                            .BitMap.RoundRect(i , 0 , i - .ObjSize , .ObjSize , .ObjSize \ 4 , .ObjSize \ 4 , .Color)
                            i = i - .ObjSize - j
                            .BitMap.RoundRect(i , 0 , i - .ObjSize , .ObjSize , .ObjSize \ 4 , .ObjSize \ 4 , RGB((r * .7) + (r2 * .3) , (g * .7) + (g2 * .3) , (b * .7) + (b2 * .3)))
                            i = i - .ObjSize - j
                            .BitMap.RoundRect(i , 0 , i - .ObjSize , .ObjSize , .ObjSize \ 4 , .ObjSize \ 4 , RGB((r * .4) + (r2 * .6) , (g * .4) + (g2 * .6) , (b * .4) + (b2 * .6)))
                            i = i - .ObjSize - j
                            .BitMap.RoundRect(i , 0 , i - .ObjSize , .ObjSize , .ObjSize \ 4 , .ObjSize \ 4 , RGB((r * .2) + (r2 * .8) , (g * .2) + (g2 * .8) , (b * .2) + (b2 * .8)))

                        CASE gkBarberPole
                            FOR i = 1 TO .BitMap.Width
                                j = ((i MOD .ObjSize) / .ObjSize) ^2  'set gradient gamma
                                .BitMap.Line(i , 0 , 0 , i , _
                                    RGB((r * j) + (r2 * (1 - j)) , (g * j) + (g2 * (1 - j)) , (b * j) + (b2 * (1 - j))))
                            NEXT i
                    END SELECT
                    IF .Caption <> "" THEN .BitMap.TextOut(.Left + .Width \ 2 , 0 , .Caption , .Color , - 1)
                END IF
            END SUB

            PUBLIC :

            '***********************************************
            'Properties Get / Set
            '***********************************************

            PROPERTY SET SetMultiThreading(Flag AS INTEGER)
                IF Flag = TRUE THEN .UseThreading = TRUE ELSE .UseThreading = FALSE
            END PROPERTY

            PROPERTY SET SetBackColor(Clr AS INTEGER)
                .Gauge.BackColor = Clr
                .BackColor = Clr
                IF .Kind > 4 THEN .DrawObj  'custom BMP
            END PROPERTY

            PROPERTY SET SetColor(Clr AS INTEGER)
                .Color = Clr
                .Gauge.ForeColor = Clr
                IF .Kind > 4 THEN .DrawObj  'custom
            END PROPERTY

            PROPERTY SET SetWidth(Width AS INTEGER)
                Super.Width = Width
                This.Width = Width
                IF .Kind > 4 THEN .DrawObj  'custom
            END PROPERTY

            PROPERTY SET SetHeight(Height AS INTEGER)
                Super.Height = Height
                This.Height = Height
                IF .Kind > 4 THEN .DrawObj  'custom
            END PROPERTY

            PROPERTY SET SetRange(value AS INTEGER)
                .Gauge.Max = value
                .Gauge.Min = 0
            END PROPERTY

            PROPERTY SET SetKind(value AS INTEGER)
                .Kind = value
                IF value > 4 THEN  'custom
                    .DrawObj  'draw it, updated sizes
                    .Gauge.Enabled = FALSE
                    .Gauge.Visible = FALSE
                ELSE
                    .Gauge.Kind = value
                    .Gauge.Enabled = TRUE
                    .Gauge.Visible = TRUE
                END IF
            END PROPERTY

            PROPERTY SET SetValue(TheValue AS INTEGER)
                .Value = TheValue
                .Gauge.Position = TheValue
            END PROPERTY

            PRIVATE :

            '***********************************************
            'Timer routine -- called when timer reaches end of interval, stops on .Visible = False command
            'do not put a SLEEP command in this sub! only one thread is running, Also DoEvents does nothing
            '***********************************************
            SUB DrawMotionsTimer
                'IF (.visible = False) THEN .Timer.Enabled = False
                .Increment + = .StepSize
                IF .Increment > 0 THEN .Increment = - 1 * .Offset
                .Draw(.Increment , 0 , .BitMap.BMP)
            END SUB

            '***********************************************
            'Threading routine -- continual loop once thread starts
            '***********************************************
            SUB DrawMotions
                DIM i AS INTEGER
                DO  'Form is ready for painting
                    .Increment + = .StepSize
                    IF .Increment > 0 THEN .Increment = - 1 * .Offset
                    IF .Gauge.Enabled THEN
                        .Gauge.Position = .Value
                        .Gauge.Height = .Height
                        .Gauge.Width = .Width
                    ELSE
                        .Draw(.Increment , 0 , .BitMap.BMP)
                        .Repaint
                    END IF
                    'DOEVENTS
                    SLEEP This.Interval
                LOOP UNTIL (.Visible = FALSE)
                IF (.hThread <> 0) THEN TerminateThread(.hThread , 0&)  : .hThread = 0
            END SUB

            '***********************************************
            'Create Threading -- cannot use CodePtr (sub..) in any other code!
            '***********************************************
            SUB CreateMyThread
                .lpThreadAddr = CODEPTR(This.DrawMotions)
                .hThread = CreateThread(0& , 0& , This.lpThreadAddr , 0& , CREATE_SUSPENDED , VARPTR(This.ThreadID))
            END SUB

            '***********************************************
            'Timers /threads off OnClose command
            '***********************************************

            SUB Close
                .TIMER.Enabled = FALSE  'always turn off processes
                IF .UseThreading THEN
                    IF .hThread <> 0 THEN TerminateThread(.hThread , 0&)
                END IF
                .hThread = 0
            END SUB

            PUBLIC :

            '***********************************************
            'Timers get started OnShow by .Visible command
            '***********************************************

            PROPERTY SET SetVisible(TheState AS INTEGER)
                IF .Kind > 4 THEN
                    IF TheState <> 0 THEN  'show the form
                        IF .UseThreading THEN
                            IF .hThread = 0 THEN .CreateMyThread
                            DO :  LOOP UNTIL .Visible = TRUE  'wait for the form to appear
                            ResumeThread(.hThread)
                        ELSE
                            .TIMER.OnTimer = This.DrawMotionsTimer  'set our sub for time-out event
                            .TIMER.Interval = (.Interval * 1000) 'rescale for integer millisec.
                            .TIMER.Enabled = TRUE
                        END IF
                    ELSE
                        .Close
                    END IF
                END IF
                SUPER.Visible = TheState
            END PROPERTY

            '***********************************************
            CONSTRUCTOR
                UseThreading = FALSE  'default is Qtimer for marquees
                TIMER.Enabled = FALSE  'turn off until needed
                Visible = FALSE
                hThread = 0
                Left = 0
                Top = 0
                Width = 200
                Height = 20
                StepSize = 50
                Color = RGB(128 , 128 , 128) 'grey
                BackColor = 0
                Kind = 0  'gkText = 0, gkHorizontalBar = 1, gkVerticalBar = 2, gkPie = 3, gkNeedle = 4
                Gauge.Parent = QProgress
                Gauge.Left = 0
                Gauge.Top = 0
                BitMap.Width = 0  'don't allocate mem yet
                BitMap.Height = 0
                Interval = 0.500  '2 times/sec update
                Increment = 0
            END CONSTRUCTOR
        END WITH
    END TYPE

$ENDIF

'============================================================================
'[build_inc] QProgressBar.inc
'============================================================================
'=======================================================
'QProgressBar.inc, replaces QProgress.inc
'Code derived from windows Progress bar in RQ by Benjamin Maggi 
'and marquee sample code courtesy from David Burkley
'Ex: It uses real Windows Progress Bar (comctl32.dll)

'major Code reworking by Johnk into QComponent
'=======================================================

$IFNDEF __QPROGRESSBAR_INC         'don't reload
    $DEFINE __QPROGRESSBAR_INC

    $IFNDEF __WIN32API  'APIs

        '-- Window styles

        $IFNDEF __RQ2WIN32API

        $ENDIF
    $ENDIF

    $DEFINE PBS_OLD 0       'old school specific for QProgressBar
    'These are available only if the version of
    'comctl32.dll is greater than 4.70 (IE3 and later)
    $DEFINE PBM_SETMARQUEE &H040A
    $DEFINE PBM_GETSTEP &H040D
    $DEFINE PBM_GETBKCOLOR &H040E
    $DEFINE PBM_GETBARCOLOR &H040F
    $DEFINE PBM_SETSTATE &H0410
    $DEFINE PBM_GETSTATE &H0411

    $DEFINE PBS_MARQUEE 8
    $DEFINE PBS_SMOOTHREVERSE 16

    $DEFINE PBST_NORMAL 1
    $DEFINE PBST_ERROR 2
    $DEFINE PBST_PAUSED 3

    $IFNDEF TRUE
    $ENDIF

    $IFNDEF FALSE
    $ENDIF

TYPE QProgressBar EXTENDS QOBJECT

    PUBLIC :
        Parent      AS INTEGER PROPERTY SET SetParent
        Handle      AS INTEGER
        'Caption     AS STRING
        Interval    AS INTEGER                           'update interval
        Increment   AS INTEGER
        Visible     AS INTEGER PROPERTY SET SetVisible
        Max         AS INTEGER PROPERTY SET SetMax
        Min         AS INTEGER PROPERTY SET SetMin
        Color       AS INTEGER PROPERTY SET SetColor
        BackColor   AS INTEGER PROPERTY SET SetBackColor
        Position    AS INTEGER PROPERTY SET SetPosition
        Kind        AS INTEGER PROPERTY SET SetKind
        Top         AS INTEGER PROPERTY SET SetTop
        Left        AS INTEGER PROPERTY SET SetLeft
        Height      AS INTEGER PROPERTY SET SetHeight
        Width       AS INTEGER PROPERTY SET SetWidth  'etc..
        State       AS INTEGER PROPERTY SET SetState

    WITH THIS

    SUB Create
        DEFINT NewStyle = WS_CHILD OR WS_VISIBLE
        IF .Kind <> PBS_OLD THEN NewStyle = NewStyle OR .Kind
        .Handle = CreateWindowEx(0, "msctls_progress32", "", NewStyle, _
                    .Left, .Top, .Width, .Height, .Parent, 0, Application.hInstance, 0) ' inc2026: в строке 122 было .Top, .Left, стало .Left, .Top: у CreateWindowEx сначала x, потом y
    END SUB

    '***********************************************
    'Timers /threads off OnClose command
    '***********************************************

    SUB Close
        IF .Handle <> 0 THEN
            IF .Kind = PBS_MARQUEE THEN SendMessage(.Handle , PBM_SETMARQUEE , 0 , 0)
            DestroyWindow(.Handle)
            .Handle = 0
            .Visible = False
        END IF
    END SUB

    SUB SetRange                    'Set the range of the progress bar.
        'lParam LOWORD= minimum range,  HIWORD = maximum range; minimum range cannot be negative
        'default, min = 0, max = 100 ; max > min, highest range = 0 to 65,535. 
        IF This.Max > &HFFFF THEN This.Max = &HFFFF          '16 bit only
        IF This.Max > This.Min THEN SendMessage(This.Handle, PBM_SETRANGE, 0, This.Min + (This.Max SHL 16))
    END SUB

    'make a general reformat sub for operations on setting properties
    SUB ReDraw
        IF .Visible = False THEN EXIT SUB
        IF This.Handle = 0 THEN .Create         'make new one
        IF This.Handle = 0 THEN EXIT SUB        'failed!!
        .SetRange                               'take care of min / max properties

        IF .Kind <> PBS_MARQUEE THEN
            'step increment by which the progress bar increases its current position on PBM_STEPIT message, default is 10. 
            SendMessage(.Handle, PBM_SETSTEP, .Increment, 0)
            SendMessage (.Handle, PBM_SETBKCOLOR, 0, .BackColor)
            SendMessage (.Handle, PBM_SETBARCOLOR, 0, .Color)
            SendMessage(.Handle, PBM_SETPOS, .Position, 0)
        ELSE
            SendMessage(.Handle , PBM_SETMARQUEE , 1 , .Interval)    '1 = on, 40 = milliseconds update
        END IF

        'IF This.Visible THEN TheParams = TheParams OR SWP_SHOWWINDOW ELSE TheParams = TheParams OR SWP_HIDEWINDOW
        SetWindowPos(.Handle, 0, .Left, .Top, .Width, .Height, SWP_NOSIZE OR SWP_NOZORDER)
    END SUB

    '***********************************************
    'Properties Get / Set
    '***********************************************

    SUB SetParent(TheParent AS INTEGER)
        .Parent = TheParent
        IF .Parent = 0 THEN EXIT SUB

        IF .Handle = 0 THEN
            .Create
        ELSE
            IF TheParent THEN SetParent(.Handle, TheParent)
        END IF
        .ReDraw
    END SUB

    SUB SetMax(TheValue)
        .Max = TheValue
        .ReDraw
    END SUB

    SUB SetMin(TheValue)
        .Min = TheValue
        .ReDraw
    END SUB

    SUB SetPosition(TheValue AS INTEGER)
        .Position =  TheValue
        .ReDraw
    END SUB

    PROPERTY SET SetBackColor(Clr AS INTEGER)
        .BackColor = Clr
        .ReDraw
    END PROPERTY

    PROPERTY SET SetColor(Clr AS INTEGER)
        .Color = Clr
        .ReDraw
    END PROPERTY

    PROPERTY SET SetTop(Top AS INTEGER)
        .Top = Top
        .ReDraw
    END PROPERTY

    PROPERTY SET SetLeft(Left AS INTEGER)
        .Left = Left
        .ReDraw
    END PROPERTY

    PROPERTY SET SetWidth(Width AS INTEGER)
        .Width = Width
        .ReDraw
    END PROPERTY

    PROPERTY SET SetHeight(Height AS INTEGER)
        .Height = Height
        .ReDraw
    END PROPERTY

    PROPERTY SET SetKind(value AS INTEGER)
        IF value <> .Kind THEN
            .Close
            .Kind = value
            IF .Kind = PBS_VERTICAL THEN IF .Width > .Height THEN SWAP(.Width, .Height)
            .ReDraw
        END IF
    END PROPERTY

    PROPERTY SET SetState(value AS INTEGER)
        .State = value
        IF .State < 2 THEN  SendMessage(.Handle, PBM_SETSTATE, PBST_NORMAL, 0)
        IF .State = 2 THEN  SendMessage(.Handle, PBM_SETSTATE, PBST_ERROR, 0)
        IF .State = 3 THEN  SendMessage(.Handle, PBM_SETSTATE, PBST_PAUSED, 0)
        .ReDraw
    END PROPERTY

    PROPERTY SET SetVisible(TheState AS INTEGER)
        IF TheState = False THEN
            .Close                  'destroy
            .Visible = False
        ELSE
            .Visible = True
            .ReDraw                 'will recreate
        END IF
    END PROPERTY

    '***********************************************
    CONSTRUCTOR
        Visible = True
        Handle = 0
        Parent = 0
        Left = 0
        Top = 0
        Width = 100
        Height = 18
        Min = 0
        Max = 100
        Color = RGB(128 , 128 , 128) 'grey
        BackColor = 0
        Kind = PBS_OLD
        Interval = 40       '40 msec update
        Increment = 1
        State = 0       'normal
    END CONSTRUCTOR

    END WITH
END TYPE

$ENDIF

