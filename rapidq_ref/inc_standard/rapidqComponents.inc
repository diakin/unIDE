$IFNDEF __WIN32API ' inc2026: перенесено со строки 17 - условие только для констант SW_, объявления Run_* выше нужны всегда

' ShowWindow() Commands

$ENDIF

$DEFINE RUN_HWNDNEXT      2
$DEFINE RUN_CHILD      5

Declare Sub OnEnumWindows_eventTemplate(handle as Long,name as string,ClassName as string)
Declare Sub OnEnumFromPoint_eventTemplate(handle as Long,name as string,ClassName as string)

Type QRun EXTENDS QObject
  OnEnumWindows as EVENT(OnEnumWindows_eventTemplate)
  OnEnumFromPoint as EVENT(OnEnumWindows_eventTemplate)

  '=============================================================
  ' Mйthode trouvant le nom et chemin de l'application associй
  '=============================================================
  Function FindApplication(FileName as string) as string
    dim ExeName as string
    dim value as long
    
    ExeName=space$(255)
    value=Run_FindExecutable(FileName,"",ExeName)
    if value>32 then
      result=rtrim$(ExeName)
    else
      result=""
    end if
  End Function
  
  '=============================================================
  ' Mйthode йxecution d'un fichier associй ou application
  '=============================================================
  Sub FileRun(FileName as string,cmdShow as short)
    Run_ShellExecute(0,"open",FileName,"","",cmdShow)
  End Sub
  
  '=============================================================
  ' Mйthode йxecution application avec ouverture fichier
  '=============================================================
  Sub ExeRun(ExeName as string,Param as string,cmdShow as short)
    dim path as string
    
    path=LEFT$(ExeName,RINSTR(ExeName,"\")-1)
    Run_ShellExecute(0,"open",ExeName,Param,path,cmdShow)
  End Sub
  
  '=============================================================
  ' Mйthode йnumeration de toutes les fenetres de l'ecran
  '=============================================================
  Function EnumWindow(All as boolean) as boolean
    dim size as integer
    dim buffer as string
    dim name as string
    dim ClassName as string
    dim handle as long

    handle=Run_GetWindow(Run_GetDesktopWindow(),RUN_CHILD)
    result=handle<>0
    while handle<>0 
      if All or Run_IsWindowVisible(handle) then
        size=Run_GetTextLenght(handle)
        buffer=Space$(size)+chr$(0)
        size=Run_GetText(handle,buffer,Len(buffer))
        name=Left$(buffer,size)
        if name<>"" then
          buffer=Space$(255)
          size=Run_GetClassName(handle,buffer,255)
          if size>0 then
            ClassName=Left$(buffer,size)
          else
            ClassName=""
          end if
          if this.OnEnumWindows<>0 then CALLFUNC(this.OnEnumWindows,handle,name,ClassName)
        end if
      end if
      handle=Run_GetWindow(handle,RUN_HWNDNEXT)
    wend 
  End Function

  '=============================================================
  ' Mйthode trouve le handle enfant par son nom et sa classe
  '=============================================================
  Function FindChild(handle as long,class as string,name as string) as long
    result=Run_FindWindowEx(handle,0,class,name)
  End Function

  '=============================================================
  ' Mйthode йnumeration de la fenetre a la position x,y
  '=============================================================
  Function EnumFromPoint(x as long,y as long) as boolean
    dim size as integer
    dim buffer as string
    dim name as string
    dim ClassName as string
    dim handle as long

    handle=Run_WindowFromPoint(x,y)
    result=handle<>0
    size=Run_GetTextLenght(handle)
    buffer=Space$(size)+chr$(0)
    size=Run_GetText(handle,buffer,Len(buffer))
    name=Left$(buffer,size)
    if name<>"" then
      buffer=Space$(255)
      size=Run_GetClassName(handle,buffer,255)
      if size>0 then
        ClassName=Left$(buffer,size)
      else
        ClassName=""
      end if
      if this.OnEnumFromPoint<>0 then CALLFUNC(this.OnEnumFromPoint,handle,name,ClassName)
    end if
  End Function

  '=============================================================
  ' Mйthode fermeture fenetre
  '=============================================================
  Sub Close(handle as long)
    SendMessage handle,&H10,0,0
  End Sub

  '=============================================================
  ' Mйthode met la fenetre en icone
  '=============================================================
  Sub Minimize(handle as long)
    SendMessage handle,&H112,&HF020,0
  End Sub

  '=============================================================
  ' Mйthode met la fenetre en taille maxi
  '=============================================================
  Sub Maximize(handle as long)
    SendMessage handle,&H112,&HF030,0
  End Sub

  '=============================================================
  ' Mйthode restore l'etat de la fenetre
  '=============================================================
  Sub Restore(handle as long)
    SendMessage handle,&H112,&HF120,0
  End Sub

  '=============================================================
  ' Mйthode met le focus sur la fenetre
  '=============================================================
  Sub SetFocus(handle as long)
    SendMessage handle,&H7,0,0
  End Sub

  '=============================================================
  ' Mйthode met la fenetre en avant plan des autres
  '=============================================================
  Sub SetTopMost(handle as long,flag as boolean)
    dim index as integer

    if flag then
      index=-1
    else
      index=-2
    end if
    Run_SetWindowPos Handle,index,0,0,0,0,&H3 
  End Sub
End Type

'============================================================================
'[build_inc] QSavePlus.inc
'============================================================================
' ======================================= '
'  About QSavePlus
' ======================================= '
'-- QSavePlus is extends from QSaveDialog ,
'-- 1) If don't found any extension or found unusual extension in FileName,
'-- will show Add Extension Confirm Dialog.
'-- 2) Plus directory and FileName Checking.
'-- 3) show Confirm Dialog before save exist file.
'-- This code only test on Win98.

' Author : Suchart Chokphichitchai
' E-mail  : dragon_html@yahoo.com
' My skillfull about English Language is very weak.
' If you don't understand the description,
' or you found bug of this code.
' Please contact me to modify it.

'$TYPECHECK ON
$ESCAPECHARS ON

' ======================================= '
'  const
' ======================================= '
const dot = "."  :const Quo$ = chr$(39)

Function delMark$( s as string ) As String
s=replaceSubstr$(s," ","")
s=replaceSubstr$(s,"\t","")
delMark$=replaceSubstr$(s,"*.","")
End Function

' ======================================= '
'  OBJECT Extends
' ======================================= '

TYPE QSaveplus Extends QSaveDialog
Private:
saveDialogRet AS INTEGER
goOut AS INTEGER

Function item( i as integer ) As String
' Result example '
'-- item(1)="*.*"
'-- item(2)="*.js"
'-- item(3)="*.php3;*.php"
Result = Field$( QSaveplus.Filter, "|", i*2 )
End Function
Function itemCount As Integer
' Result example ' ( value of number of all item )
'-- itemCount = 7
Result = Tally(QSaveplus.Filter,"|")\2
End Function
Function extCount( i as integer ) As Integer
' Result example ' ( value of number of extension in one item)
'-- extCount(1) = 1 [ *.* ]
'-- extCount(2) = 1 [ *.js ]
'-- extCount(3) = 2 [ *.php3;*.php ]
Result = Tally( QSaveplus.item( i ), "*." )
End Function
Function ext( t as Integer, i as integer ) As String
dim e as string
' Result example '
'-- ext(3,1) = "php3"
'-- ext(3,2) = "php"
e = Field$( QSaveplus.item( t ), ";", i )
Result = delMark$( e )
End Function
Function Exten$ As String
' Result example '
'-- if FilterIndex = 4
'--   Exten$ = "pl"
'-- if FilterIndex = 2
'--   Exten$ = "js"
Result = QSaveplus.ext( QSaveplus.FilterIndex, 1 )
End Function
Function DirExist As Integer
dim fileDir$ AS string
dim BslPos as integer
' Result example '
'-- if dir of FileName is exist.
'-- DirExist=1
'-- if dir of FileName is not exist.
'-- DirExist=0
BslPos = RINSTR(QSaveplus.Filename,"\\")
fileDir$ = Delete$(QSaveplus.Filename, BslPos+1, len(QSaveplus.Filename)-BslPos)
'ShowMessage "DirName="+fileDir$
Result = DirExists(fileDir$)
End Function
Function NoExten As INTEGER
dim FileLC$ as string
dim EachExt$ as string
dim FoundExt as integer
dim cou as integer
' Result example '
'-- if FilterIndex = 2
'--   if not found extension (Ex. c:\abc )
'--   or if found unusual extension. (Ex. c:\abc.ss)
'--     NoExten=1
'--   but if found usual extension. (Ex c:\abc.js)
'--     NoExten=0
FoundExt=False
FileLC$ = LCASE$(QSaveplus.FileName)
FOR cou = 1 TO QSaveplus.ExtCount( QSaveplus.FilterIndex ) '-- EXTCOUNT
	EachExt$ = dot+LCASE$( QSaveplus.Ext( QSaveplus.FilterIndex, cou ) ) '-- EXT
	'  ShowMessage "right str= "+Right$(FileLC$,LEN(EachExt$))+_
	'  "\r\extension"+str$(cou)+"= "+EachExt$
	IF Right$(FileLC$,LEN(EachExt$)) = EachExt$ THEN
		FoundExt = True
		exit for
	END IF
NEXT
IF FoundExt = False THEN
	Result = True
ELSE
	Result = False
END IF
End Function
Function PlusExt As String
' Result example '
'-- if FilterIndex=2
'--   if FileName="c:\abc."
'--     add only "js"
'--   if FileName="c:\abc"
'--     add ".js"
IF right$(QSaveplus.Filename,1) = dot THEN
	Result = QSaveplus.Filename+QSavePlus.Exten$
ELSE
	Result = QSaveplus.Filename+dot+QSavePlus.Exten$
END IF
End Function
Function Validname As INTEGER
' Result example '
'-- if found ">" in FileName
'--  Validname=0
IF instr(QSaveplus.Filename,">") <> 0 THEN
	Result = False
ELSE
	Result = True
END IF
End Function
Sub goOutTrue
'-- go out the loop. by set goOut=1
QSavePlus.goOut = True
END Sub
Sub FileExistDlg
'-- if FileName is exist, show Confirm Dialog.
IF fileExists(QSaveplus.Filename) THEN
	'-- FileName is exist.
	IF MESSAGEDLG(Quo$+QSaveplus.FileName+Quo$+_
	" already exists.\r\nDo you want to replace it?",_
	mtConfirmation, mbYes OR mbNo, 0) = mrYes THEN
	'-- if select Yes
	QSavePlus.goOutTrue
END IF
ELSE
	'-- FileName is not exist.
	QSavePlus.goOutTrue
END IF '-- if not cancel
END Sub
Public:
Function Execute2 AS Integer
dim mrValue as integer
QSavePlus.goOut = False
Do
'-- Execute and keep value in saveDialogRet.
QSavePlus.saveDialogRet = QSaveplus.Execute

IF QSavePlus.saveDialogRet = False THEN '-- Click Cancel button.
	QSavePlus.goOutTrue
ELSE '-- Click Save button.
	IF QSavePlus.Validname = True THEN '-- FileName is valid.
		IF QSavePlus.dirExist = False THEN ' === Directory of FileName is not exist. === '
			MESSAGEDLG(QSaveplus.Filename+_
			"\r\nPath does not exist."+_
			"\r\nPlease verify the correct path was given.",_
			mtWarning, mbOK, 0)
			QSaveplus.Filename=CurDir$+"\\*."+QSavePlus.Exten$
		ELSEIF QSavePlus.NoExten = True THEN ' === No extension or False extension. === '
			IF QSaveplus.FilterIndex = 1 THEN '-- FilterIndex is "All Files"
				QSavePlus.FileExistDlg
			ELSE '-- FilterIndex is not "All Files", Select add extension or not.
				mrValue=MESSAGEDLG(QSaveplus.FileName+_
				"\r\nThere is no file extension in the file name."+_
				"\r\nDo you want to add '"+QSavePlus.Exten$+"' extension automatically?",_
				mtConfirmation, mbYes OR mbNo OR mbCancel, 0)
				IF (mrValue = mrYes) OR (mrValue = mrNo) THEN
					IF mrValue = mrYes THEN
						QSaveplus.Filename = QSavePlus.PlusExt
					END IF
					QSavePlus.FileExistDlg
				END IF
			END IF
		ELSE ' === Found usual extension of Filter. === '
			QSavePlus.FileExistDlg
		END IF
	ELSE '-- FileName is invalid.
		MESSAGEDLG(QSaveplus.Filename+_
		"\r\nThe above file name is invalid.",_
		mtWarning, mbOK, 0)
	END IF
END IF '-- saveDialogRet
Loop Until QSavePlus.goOut = True
Result = QSavePlus.saveDialogRet
END Function
END TYPE
