      QTEXTEDIT.mnuSelectAll.Caption=caption
    END PROPERTY
        
    '========================================
    ' Mйthode annuler derniere modification
    '========================================          
    SUB Undo
      SendMessage(QTEXTEDIT.Handle,&HC7,0,0)
    END SUB 
        
    '========================================
    ' Mйthode couper
    '========================================          
    SUB Cut
      QTEXTEDIT.CutToClipBoard
    END SUB
        
