DEFLNG addr = ParamVal(1)
IF This.CheckMatch(addr) = 0 THEN
  This.WatchCount ++
  IF ParamStrCount > 0 THEN This.Grid.Cell(0 , This.WatchCount) = ParamStr$(1)
  DEFSTR i = VARPTR$(addr)
  This.Grid.Cell(1 , This.WatchCount) = i
  This.Grid.Cell(2 , This.WatchCount) = STR$(addr)
  This.Grid.Cell(3 , This.WatchCount) = "str"
  This.Timer1.Enabled = 1
  This.ReOrder
END IF
END SUBI

