	TmpStr = TheFileName				'RQ does not pass the string pointer to function!!
	capGrabFrameNoStop(This.hCapWnd)
	RESULT = capFileSaveDIB(This.hCapWnd, VARPTR(TmpStr))	' need this to send pointer
