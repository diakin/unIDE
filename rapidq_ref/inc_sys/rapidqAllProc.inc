'**********************************************************************************
' ---- SoundEx , fix the RapidQ SOUND statement for newer versions of Windows  ----
'  by Jacques Phillipe
'**********************************************************************************
'already have GetVersionEx decl
Declare Function gRQ2_GetVersion Lib "kernel32" Alias "GetVersion" () As Long
'don't conflict with Beep
Declare Function gRQ2_Beep Lib "kernel32" Alias "Beep" (ByVal dwFreq As Long,  ByVal dwDuration As Long) As Long
DefInt gRQ2_SND_OS_Version = gRQ2_GetVersion And 255
Sub SoundEx (Freq As Long, Duration As Long) ' hz, 1/18 s = ~50 ms
  If gRQ2_SND_OS_Version < 5 Then  ' >5 = XP
    Sound Freq, Duration
  Else
    gRQ2_Beep (Freq, Duration * 55) ' hz ms 55 = 1000/18.2 = 54.9
  End If
End Sub
$UNDEF Sound
$DEFINE Sound SoundEx
' ---- End SoundEx ------------------

