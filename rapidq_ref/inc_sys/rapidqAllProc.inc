'~dup Function INVZ(Z()AS DOUBLE ) AS DOUBLE   ' повтор, первое: Math.inc(263)
'~dup     re = Z(0): im = Z(1) 
'~dup     Z(0) =  re / ( re * re + im * im)   
'~dup     Z(1) =  im / ( re * re + im * im)                 
'~dup     INVZ = Z()                          
'~dup End Function   
'--------------------------------------------------------------------------------
'     LOGZ() returns the natural logarithm of a complex number
'--------------------------------------------------------------------------------
'~dup Function LOGZ(Z()AS DOUBLE ) AS DOUBLE      ' повтор, первое: Math.inc(272)
'~dup     re = Z(0): im = Z(1) 
'~dup     Z(0) =  LOG (re / ( re * re + im * im))   
'~dup     Z(1) =  im / ( re * re + im * im)                 
'~dup     LOGZ = Z()                          
'~dup End Function   
'--------------------------------------------------------------------------------
'    LOG10() returns the base 10 log of x
'--------------------------------------------------------------------------------
'~dup  Function LOG10(value AS DOUBLE) AS DOUBLE   ' повтор, первое: Math.inc(281)
'~dup   LOG10 = (LOG (value) * LOG(10 * rqE))
'~dup  End Function
'--------------------------------------------------------------------------------
'     LOG10Z() returns the 10-th logarithm of z (base is 10)
'--------------------------------------------------------------------------------
'~dup Function LOG10Z(Z()AS DOUBLE ) AS DOUBLE      ' повтор, первое: Math.inc(289)
'~dup     re = Z(0): im = Z(1)
'~dup     Z(0) =  LOG (re / ( re * re + im * im))/ LOG (10)   
'~dup     Z(1) =  im / ( re * re + im * im) / LOG (10)                
'~dup     LOG10Z = Z()                          
'~dup End Function   
'--------------------------------------------------------------------------------
'     LOGAZ() returns the a-th logarithm of z (base is a)
'--------------------------------------------------------------------------------
'~dup Function LOGAZ(Z()AS DOUBLE ) AS DOUBLE      ' повтор, первое: Math.inc(298)
'~dup     re = Z(0): im = Z(1) : a = Z(3) 
'~dup     Z(0) =  LOG (re / ( re * re + im * im))/ LOG (a)   
'~dup     Z(1) =  im / ( re * re + im * im) / LOG (a)                
'~dup     LOGAZ = Z()                          
'~dup End Function   
'--------------------------------------------------------------------------------
'    MAGZ() returns the absolute value of a complex number
'--------------------------------------------------------------------------------
'~dup Function MAGZ(Z()AS DOUBLE ) AS DOUBLE   ' повтор, первое: Math.inc(307)
'~dup     re = Z(0): im = Z(1) 
'~dup     Z(0) = SQR( re * re + im * im)   '= |Z| 
'~dup     Z(1) = 0                  
'~dup     MAGZ = Z()                          
'~dup End Function
'--------------------------------------------------------------------------------
'    MULZ() returns the product of two complex numbers
'--------------------------------------------------------------------------------
'~dup Function MULZ(Z()AS DOUBLE ) AS DOUBLE      ' повтор, первое: Math.inc(316)
'~dup     re1 = Z(0): im1 = Z(1) : re2 = Z(2) : im2 = Z(3)
'~dup     Z(0) = re1 * re2 - im1 * im2
'~dup     Z(1) = re1 * im2 + re2 * im1
'~dup     Z(2) = 0
'~dup     Z(3) = 0 
'~dup     MULZ = Z()   
'~dup End Function
'--------------------------------------------------------------------------------
'    NORZ() returns the normal form of a complex value
'--------------------------------------------------------------------------------
' Z = x + iy = re + i*im   =   r*e^i*theta
'~dup Function NORZ(Z()AS DOUBLE ) AS DOUBLE   ' повтор, первое: Math.inc(328)
'~dup     re = Z(0): im = Z(1) 
'~dup     Z(0) = SQR( re * re + im * im)    ' = r = value 
'~dup     Z(1) = ATAN (im / re)             ' = theta = argument     
