FUNCTION FindProcessId(name AS STRING) AS LONG
name = UCASE$(name)
'print"name=";name
DIM processes(NUM_PROCESSES) AS LONG, size AS LONG, procUsed AS LONG
size = NUM_PROCESSES * SIZEOF(LONG)

