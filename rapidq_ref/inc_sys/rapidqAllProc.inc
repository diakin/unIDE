    Result = Ptr
End Function

Function StrFromPtr(P&) As String
    DefStr s = ""
    If P& Then
       DefInt L = HeapSize(GetProcessHeap,HEAP_NO_SERIALIZE,P&)
       If L <> &HFFFFFFFF Then
          s = Space$(L)
          MemCpy VarPTR(s),P&,L
       Else
          s = ""
       End If
    End If
    Result = s
End Function

