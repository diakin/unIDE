function GetDecl(code$) as string

' Array to return
Dim Args(3) as string
defint fs,fe,fl,ns,ne,nl,ls,le,ll

'ft$=function type; fn$=function name; lib$=lib file; rt$=return type
defstr ft$, fn$, lib$, rt$

fs=InStr(UCase$(code$),"DECLARE ")+8 ' quicker
fe=InStr(fs,code$," ")
