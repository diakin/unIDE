'-- **************************************************************************'
function   Hex2Dec (HexStr as string) as string

DEFdbl numb
defdbl number
DEFBYTE x,length, y
number = 0
length = LEN(HexStr)
FOR x = 1 TO length
	y = length - x
	
	digit$ = UCASE$(MID$(HexStr,x,1))
	SELECT CASE digit$
	CASE "A"
		numb = 10 * 16^y
	CASE "B"
		numb = 11 * 16^y
	CASE "C"
		numb = 12 * 16^y
	CASE "D"
		numb = 13 * 16^y
	CASE "E"
		numb = 14 * 16^y
	CASE "F"
		numb = 15 * 16^y
	CASE ELSE
		numb = VAL(LCASE$(digit$)) * 16^y
	END SELECT
	number = number + numb
	qw:
NEXT

if number>10^6 then 
	n1=fix(number/1000000) 
	n2=(number-n1*1000000)    
	NumNul=6-len(str$(n2)) 
	TrNul$=string$(NumNul, "0")
	
	Dec$ = STR$(n1)+TrNul$+str$(n2)
	
else
	Dec$ = STR$(number)
end if
Hex2Dec=Dec$

END function

