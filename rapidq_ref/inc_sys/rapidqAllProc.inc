'~dup SUB io2RndInter (io$, rndf$, LostP)   ' повтор, первое: Files.inc(1100)
'~dup 'convert text file with the two-fields per string "point,data" format
'~dup ' to binary format with interpolation of missed points
'~dup '---- for example -----
'~dup ' 0,17.78091 
'~dup ' 1,16.64166
'~dup '     points 2,3 is missed
'~dup ' 4,19.87037  
'~dup ' 5,16.64123 
'~dup '------------------------------------
'~dup 'io$   - source text file
'~dup 'rndf$ - destination binary file
'~dup 'LostP - return number of missed points (use @LostP )
'~dup ' call io2RndInter (io$, rndf$, @LostP)
'~dup '------------------------------------
'~dup dim io2RndFile2 as QfileStream
'~dup dim io2Rndtmp as QfileStream
'~dup dim io2RndList as QSTRINGLIST 
'~dup dim ioNumPnt as integer
'~dup dim i0 as integer
'~dup 
'~dup defsng pnt
'~dup if fileexists (io$)=0 then showmessage ("io2RndInter File not found "+io$):exit sub
'~dup if FileSize(io$)<1 then showmessage ("io2RndInter Zero size file "+io$):LostP=-99:exit sub
'~dup 
'~dup io2RndList.LoadFromFile (io$)
'~dup ArgName$=FullPathNoExt(rndf$)+"Arg"+STRIPFILEEXT(rndf$)
'~dup io2RndFile2.Open(rndf$, fmCreate)   
'~dup io2Rndtmp.Open(ArgName$, fmCreate)   
'~dup 
'~dup pntOld = 0: AdatOld! = 0: LostP = 1:j=0: i0=0
'~dup i0=val(Field$(io2RndList.Item(0),",", 1))
'~dup 
'~dup for k=0 to io2RndList.ItemCount-1
'~dup 	pnt=val(Field$(io2RndList.Item(k),",", 1))
'~dup 	Adat!=val( Field$(io2RndList.Item(k),",", 2) )
'~dup 	IF pnt = i0 THEN
'~dup 		io2RndFile2.WriteNum(Adat!,Num_SINGLE )
'~dup 		'io2Rndtmp.WriteLine (str$(pnt)+" "+str$(Adat!) )
'~dup 		io2Rndtmp.WriteNum (pnt,Num_SINGLE)
'~dup 		pntOld = pnt: AdatOld! = Adat!
'~dup 	elseif pnt < i0 then
'~dup 		io2RndFile2.WriteNum(Adat!,Num_SINGLE )
'~dup 		'io2Rndtmp.WriteLine (str$(i0)+" "+str$(Adat!) )
'~dup 		io2Rndtmp.WriteNum (pnt,Num_SINGLE)
'~dup 		pntOld = i0: AdatOld! = Adat!
'~dup 	else
'~dup 		IF pnt <> pntOld THEN ki! = (Adat! - AdatOld!) / (pnt - pntOld) ELSE GOTO ex1
'~dup 		FOR j = i0 TO pnt - 1
'~dup 			LostP = LostP + 1
'~dup 			Adat1! = AdatOld! + ki!
'~dup 			io2RndFile2.WriteNum(Adat1!,Num_SINGLE )
'~dup 			'io2Rndtmp.WriteLine (str$(j)+" "+str$(Adat1!) )
'~dup 			io2Rndtmp.WriteNum (j,Num_SINGLE)
'~dup 			AdatOld! = Adat1!
'~dup 		NEXT j
'~dup 		AdatOld! = Adat!: pntOld = pnt:
'~dup 		'io2Rndtmp.WriteLine (str$(pnt)+" "+str$(Adat!) )
'~dup 		io2Rndtmp.WriteNum (pnt,Num_SINGLE)
'~dup 		io2RndFile2.WriteNum(Adat!,Num_SINGLE )
'~dup 		i0 = j
'~dup 	END IF
'~dup 	ex1:
'~dup 	inc i0
'~dup next k
'~dup io2RndFile2.close
'~dup io2Rndtmp.close
'~dup 'print "io2Rnd completed"
'~dup END SUB

