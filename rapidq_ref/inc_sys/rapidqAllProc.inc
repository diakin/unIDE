'~dup End Function
'-------------------------------------------------------------------------------
'   COTH() returns the hyperbolic cotangent of x
'-------------------------------------------------------------------------------
'~dup Function COTH(value AS DOUBLE) AS DOUBLE   ' повтор, первое: Math.inc(163)
'~dup  SELECT CASE value
'~dup   CASE 0
'~dup    MessageBox("ERROR: Invalid Argument !!!", "COTH - Error", 0) 
'~dup   CASE ELSE
'~dup    COTH = COSH(value) / SINH(value)
'~dup   END SELECT 
'~dup End Function
'-------------------------------------------------------------------------------
'   DEG2RAD() returns radians instead of degrees
'-------------------------------------------------------------------------------
