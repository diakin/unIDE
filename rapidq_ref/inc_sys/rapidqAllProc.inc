'~dup End Function
'-------------------------------------------------------------------------------
'   COSH() returns the hyperbolic cosine of x
'-------------------------------------------------------------------------------
'~dup Function COSH(value AS DOUBLE) AS DOUBLE   ' повтор, первое: Math.inc(132)
'~dup  COSH = (0.5 * (EXP(value) + EXP(value * -1)))
'~dup  IF value = 0 THEN COSH = 1
'~dup End Function
'--------------------------------------------------------------------------------
'   COSZ() returns the cosine of a complex number
'--------------------------------------------------------------------------------
'~dup Function COSZ(Z()AS DOUBLE ) AS DOUBLE   ' повтор, первое: Math.inc(139)
'~dup     re = Z(0): im = Z(1) 
'~dup     Z(0) = COS(re) * COSH(im)
'~dup     Z(1) = SIN(re) * SINH(im)
'~dup     COSZ = Z()  
'~dup End Function
'--------------------------------------------------------------------------------
'   COSHZ() sine of a complex number
'--------------------------------------------------------------------------------
'~dup Function COSHZ(Z()AS DOUBLE ) AS DOUBLE   ' повтор, первое: Math.inc(148)
'~dup     re = Z(0): im = Z(1) 
'~dup     Z(0) = COSH(re) * COS(im)
'~dup     Z(1) = SINH(re) * SIN(im)
