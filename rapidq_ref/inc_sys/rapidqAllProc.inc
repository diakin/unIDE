'~dup FUNCTION CByteNum (ByteStr$,Num_Type as short ) as variant   ' повтор, первое: conversion.inc(337)
'~dup 'print"CByteNum ByteStr$=";ByteStr$
'~dup 'Andrew Shelkovenko dec 2003
'~dup '' converts   number of Num_Type type to bytes sequence.
'~dup 'Num_Type can be next value:
'~dup 'const Num_SHORT = 2
'~dup 'const Num_WORD = 3
'~dup 'const Num_LONG = 4
'~dup 'const Num_DWORD = 5
'~dup 'const Num_SINGLE = 6
'~dup 'const Num_DOUBLE = 8
'~dup 
'~dup 
'~dup DIM M AS QMemoryStream
'~dup select case Num_Type
'~dup case Num_BYTE
'~dup 	ShowMessage "Can't to write BYTE.Wrong parameter type - Num_BYTE": exit funCTION
'~dup case  Num_SHORT: M.Write (ByteStr$):m.Position=0:CByteNum=m.ReadNum(Num_SHORT)
'~dup case  Num_WORD:  M.Write (ByteStr$):m.Position=0:CByteNum=m.ReadNum(Num_WORD)
'~dup case  Num_LONG:  M.Write (ByteStr$):m.Position=0:CByteNum=m.ReadNum(Num_LONG)
'~dup case  Num_DWORD: M.Write (ByteStr$):m.Position=0:CByteNum=m.ReadNum(Num_DWORD)
'~dup case  Num_SINGLE:M.Write (ByteStr$):m.Position=0:CByteNum=m.ReadNum(Num_SINGLE)
'~dup case  Num_DOUBLE:M.Write (ByteStr$):m.Position=0:CByteNum=m.ReadNum(Num_DOUBLE)
'~dup 	
'~dup case else
'~dup 	M.Write (ByteStr$):m.Position=0:CByteNum=m.ReadNum(Num_DOUBLE)
'~dup end select
'~dup 
'~dup M.Close
'~dup 
'~dup end funCTION

