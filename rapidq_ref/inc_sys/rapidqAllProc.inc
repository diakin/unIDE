'~dup sub SubDirCopy (DirSrc$, DirDst$, mask$) '- -----------------------------------'   ' повтор, первое: Files.inc(550)
'~dup 'Andrew Shelkovenko dec 2003
'~dup 'Copy DirSrc$ directory with full subdir structure and files (by mask$) to DirDst$
'~dup dim FileSrc as QFileStream
'~dup dim FileDst as QFileStream
'~dup 
'~dup 'Index=0
'~dup NumFiles=0
'~dup defint nsd1, nsd2
'~dup defstr mask
'~dup nsd1=0:nsd2=0
'~dup NumDir=0
'~dup ArrNumDir=500
'~dup dim SubDir(500) as string
'~dup 
'~dup ArrNumFil=500
'~dup dim FileNames (500) as string
'~dup mask="*.*"
'~dup if right$(DirSrc$,1)<> BkSl then DirSrc$=DirSrc$+BkSl
'~dup if right$(DirDst$,1)<> BkSl then DirDst$=DirDst$+BkSl
'~dup SubDir(0)=DirSrc$
'~dup 
'~dup sss1:
'~dup for i=NSD1 to Nsd2 'current level sudirs'
'~dup 	'print "374 SubDir(",i,")=",SubDir(i)
'~dup 	SubDirname$=dir$(SubDir(i)+mask, faDirectory)
'~dup 	
'~dup 	while    SubDirname$ <>""
'~dup 		if FileRec.Size =0 and SubDirname$<> "." and SubDirname$<> ".." then ''
'~dup 			inc adddir
'~dup 			inc NumDir 'add subdir'
'~dup 			if NumDir=ArrNumDir then ArrNumDir=ArrNumDir+300: redim SubDir(ArrNumDir) as string
'~dup 			SubDir(NumDir)=SubDir(i)+SubDirname$+"\"
'~dup 			'print "383 SubDir(", NumDir, ")=",SubDir(NumDir)
'~dup 		else
'~dup 		end if
'~dup 		SubDirname$=dir$
'~dup 		doevents:if stops1=1 then stops1=0: exit sub
'~dup 	wend
'~dup 	
'~dup 	'search files in current subdirectory
'~dup 	Fn$=dir$(SubDir(i)+mask$,faAnyFile-faDirectory) ':-)
'~dup 	while Fn$ <>""
'~dup 		if  Fn$<> "." and Fn$<> ".."  then 'and FileRec.Size <>0'
'~dup 			inc NumFiles
'~dup 			if NumFiles=ArrNumFil then ArrNumFil=ArrNumFil+300: redim FileNames(ArrNumFil) as string:'print "redim FileNames"
'~dup 			FileNames(NumFiles)=SubDir(i)+Fn$
'~dup 			'print "FileNames(",NumFiles,")=" ,FileNames(NumFiles)
'~dup 			
'~dup 		else
'~dup 		end if
'~dup 		Fn$=dir$
'~dup 	wend
'~dup next i
'~dup 
'~dup if adddir>0 then
'~dup 	NSD1=NSD2+1       
'~dup 	NSD2=NSD2+adddir  
'~dup 	adddir=0
'~dup 	goto sss1 'repeat with new sub level 
'~dup else
'~dup end if
'~dup 
'~dup ' got subdirs list in SubDir(i) array and file list with full path in FileNames(j)
'~dup ' now create subdirs structure with new path
'~dup 
'~dup for i1=0 to i-1
'~dup 	NewSubDir$=SubDir(i1)-DirSrc$
'~dup 	NewSubDir$=DirDst$+NewSubDir$
'~dup 	MKSubDir (NewSubDir$)
'~dup next i1
'~dup 
'~dup for j=1 to NumFiles
'~dup 	FileSrc.Open(FileNames(j), fmOpenRead) 
'~dup 	if FileSrc.size=0 then FileSrc.close: goto nextj1
'~dup 	
'~dup 	NewFileName$=FileNames(j)-DirSrc$
'~dup 	NewFileName$=DirDst$+NewFileName$
'~dup 	'print "NewFileName$=" ,NewFileName$
'~dup 	FileDst.Open(NewFileName$, fmCreate) 
'~dup 	FileDst.CopyFrom  (FileSrc, 0)''
'~dup 	FileSrc.close''
'~dup 	FileDst.close
'~dup 	nextj1:
'~dup next j
'~dup 
'~dup end sub

