		If ( zzz= True) And ( zz1= False) Then 
			'Call WABAddEmail(WABTemp) 
			
			if instr(EmailList.text,wzz$)=0 then
				erow=UBound(WABEmail)
				ReDim WABEmail(erow + 1) As String 
