Type NCCALCSIZE_PARAMS  ' used when client rect needs to be calculated
   'rgrc(0 To 2) As RECT
   rgrc0Left As Long
   rgrc0Top As Long
   rgrc0Right As Long
   rgrc0Bottom As Long
   rgrc1Left As Long
   rgrc1Top As Long
   rgrc1Right As Long
   rgrc1Bottom As Long
   rgrc2Left As Long
   rgrc2Top As Long
   rgrc2Right As Long
   rgrc2Bottom As Long
   lppos As Long 'pointer to WINDOWPOS
End Type
Type WINDOWPOS          ' used when sizing or moving
   hWnd As Long
   hWndInsertAfter As Long
   X As Long
   Y As Long
   Cx As Long
   Cy As Long
   Flags As Long
End Type

Type MOVESIZE       ' Custom, used to track core window data
    wRgn As Long
    'wRect As RECT
    wRectLeft As Long
    wRectTop As Long
    wRectRight As Long
    wRectBottom As Long
    'mPts As POINTAPI
    mPtsX As Long
    mPtsY As Long
    hitTest As Long
    Action As Long
    Tag As Long
End Type

