    ValSrc$=FileSourse.ReadLine : 'print "ValSrc$=" ,ValSrc$
    ValSrc=val(ValSrc$) :         'print "ValSrc=" ,ValSrc
    FileDest.Write (ValSrc)
  wend

  FileSourse.CLOSE
  FileDest.CLOSE

