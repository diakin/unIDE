				EmailList.additems wzz$
				infomsg$=EmailList.item(erow-1)
'call  AddClrString ("585:infomsg$="+(infomsg$), clred, LogEdit)
				doevents
			end if
			
		End If 
	End If 
	
	NextEml1: 
	wabPos = WABRight 
next ie5

End Sub 

