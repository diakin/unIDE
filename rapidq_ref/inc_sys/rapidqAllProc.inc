'-------------------------------------------------------------------------------
'   FAC() returns the factorial of the integer x
'-------------------------------------------------------------------------------
'~dup Function FAC(value AS LONG) AS LONG   ' повтор, первое: Math.inc(211)
'~dup  SELECT CASE value
'~dup   CASE IS < 13  
'~dup    N = value      
'~dup    value = 1 
'~dup     For I = 1 to N
'~dup      value = value * I
'~dup     NEXT I 
'~dup    FAC = value
'~dup   CASE IS > 12
'~dup    MessageBox("ERROR: Invalid Argument !!! Argument must <= 12!", "FAC - Error", 0)
'~dup  END SELECT  
'~dup End Function
