'~dup FUNCTION vidnum$ (Num, dig%) as string   ' повтор, первое: conversion.inc(115)
'~dup 'Andrew Shelkovenko dec 2003
'~dup 'A  function that returns the string representation of  of a rounded numeric expression.
'~dup 'Syntax: vidnum$ (numeric-expression, dig%) 
'~dup 'Num$ = vidnum$ (999999.2366666666, 4)
'~dup 'Return  999999.2367 
'~dup 'Num$ = vidnum$ (-0.236, 4)
'~dup 'Return  -0.236
'~dup 'Num$ =vidnum$ (-12389.236, -2)
'~dup 'Return -12400
'~dup 'Details:
'~dup 'dig% - number of significant digits 
'~dup 
'~dup Num$=str$(Num)
'~dup pntPos=instr(Num$,".")
'~dup if pntPos=0 then 
'~dup digMax=0
'~dup else
'~dup digMax=Len(Num$)-pntPos
'~dup end if
'~dup  
'~dup if dig%>digMax then dig%=digMax 
'~dup vidnum$ = STR$((  CLNG(  abs(Num) * 10 ^ dig%) / 10 ^ dig%)*sgn(Num))
'~dup END FUNCTION
'
