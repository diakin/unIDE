'~dup function   Hex2Dec (HexStr as string) as string   ' повтор, первое: conversion.inc(141)
'~dup 
'~dup DEFdbl numb
'~dup defdbl number
'~dup DEFBYTE x,length, y
'~dup number = 0
'~dup length = LEN(HexStr)
'~dup FOR x = 1 TO length
'~dup 	y = length - x
'~dup 	
'~dup 	digit$ = UCASE$(MID$(HexStr,x,1))
'~dup 	SELECT CASE digit$
'~dup 	CASE "A"
'~dup 		numb = 10 * 16^y
'~dup 	CASE "B"
'~dup 		numb = 11 * 16^y
'~dup 	CASE "C"
'~dup 		numb = 12 * 16^y
'~dup 	CASE "D"
'~dup 		numb = 13 * 16^y
'~dup 	CASE "E"
'~dup 		numb = 14 * 16^y
'~dup 	CASE "F"
'~dup 		numb = 15 * 16^y
'~dup 	CASE ELSE
'~dup 		numb = VAL(LCASE$(digit$)) * 16^y
'~dup 	END SELECT
'~dup 	number = number + numb
'~dup 	qw:
'~dup NEXT
'~dup 
'~dup if number>10^6 then 
'~dup 	n1=fix(number/1000000) 
'~dup 	n2=(number-n1*1000000)    
'~dup 	NumNul=6-len(str$(n2)) 
'~dup 	TrNul$=string$(NumNul, "0")
'~dup 	
'~dup 	Dec$ = STR$(n1)+TrNul$+str$(n2)
'~dup 	
'~dup else
'~dup 	Dec$ = STR$(number)
'~dup end if
'~dup Hex2Dec=Dec$
'~dup 
'~dup END function

