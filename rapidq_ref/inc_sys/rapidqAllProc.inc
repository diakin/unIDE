'~dup FUNCTION ByteReOrder (ByteStr$,ReOrder$ ) as string   ' повтор, первое: conversion.inc(303)
'~dup 'Andrew Shelkovenko dec 2003
'~dup ' A function that reorder bytes in string.
'~dup 'ByteStr$ - Sourse string
'~dup 'ReOrder$ - new byte order
'~dup 
'~dup 'ReOrder$="21342"
'~dup 'old position - 2, new position - 1
'~dup 'old position - 1, new position - 2
'~dup 'old position - 3, new position - 3
'~dup 'old position - 4, new position - 4
'~dup 'old position - 2, new position - 5
'~dup 
'~dup ~tmp$=""
'~dup 
'~dup LenB=Len(ByteStr$)
'~dup LenR=Len(ReOrder$)
'~dup 
'~dup for i=1 to LenB
'~dup 	poz$=ReOrder$[i]
'~dup 	if val(poz$)> LenB then ShowMessage( "ReOrder index outbound input string"):exit FUNCTION
'~dup 	if i<= LenR then
'~dup 		byt$=ByteStr$[val(poz$)]
'~dup 	else
'~dup 		byt$=ByteStr$[i]
'~dup 	end if
'~dup 	~tmp$=~tmp$+byt$
'~dup next
'~dup 
'~dup ByteReOrder=~tmp$
'~dup 
'~dup end FUNCTION

