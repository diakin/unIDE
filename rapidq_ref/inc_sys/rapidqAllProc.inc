'-------------------------------------------------------------------------------
'   GCD() returns the greatest common denominator of two integers
'   based on the Euclidean algorithm
'-------------------------------------------------------------------------------
'~dup Function GCD(value1 AS DOUBLE, value2 AS DOUBLE ) AS LONG   ' повтор, первое: Math.inc(228)
'~dup   ERROR% = 0
'~dup   SELECT CASE value1
'~dup    CASE IS <> INT(value1) 'Integer check
'~dup     ERROR% = 1
'~dup    CASE 0                 'ZERO check
'~dup     ERROR% = 2
'~dup   END SELECT  
'~dup   SELECT CASE value2
'~dup    CASE IS <> INT(value2) 'Integer check
'~dup     ERROR% = 1
'~dup    CASE 0                 'ZERO Check
'~dup     ERROR% = 2
'~dup   END SELECT 
'~dup   SELECT CASE ERROR%
'~dup    CASE 0
'~dup     value1 = ABS(value1) : value2 = ABS(value2)    'Euclidean algorithm
'~dup      DO
'~dup       Res = value1 - value2 * INT(value1/value2)
'~dup       IF Res = 0 THEN GCD = value2
'~dup       value1 = value2
'~dup       value2 = Res
'~dup      LOOP UNTIL Res = 0  
'~dup    CASE 1
'~dup      GCD = 0  
'~dup      MessageBox("Invalid Argument (no INTEGER)!!!", "GCD - Error", 0) 
'~dup    CASE 2
'~dup      GCD = 0
'~dup      MessageBox("Invalid Argument (ZERO)!!!", "GCD - Error", 0) 
'~dup   END SELECT
'~dup End Function
'--------------------------------------------------------------------------------
'   INVZ() returns the reciprocal value of a complex number
'--------------------------------------------------------------------------------
