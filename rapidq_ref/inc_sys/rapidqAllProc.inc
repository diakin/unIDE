Function ExtractFileExt(File As String) As String
   Defint Pt,i
   If File = "" then Exit Function
   Pt = 0
   For i = 1 to Len(File)
       If File[i] = "." then Pt = i
   Next i
   If Pt = 0 then
      Result = ""
   Else
      Result = Mid$(File,Pt + 1,Len(File))
   End If
End Function

Function DelFileExt(File As String) As String
   Defint Pt,i
   If File = "" then Exit Function
   Pt = 0
   For i = 1 to Len(File)
       If File[i] = "." then Pt = i
   Next i
   If Pt = 0 then
      Result = File
   Else
      Result = Mid$(File,1,Pt - 1)
   End If
End Function

