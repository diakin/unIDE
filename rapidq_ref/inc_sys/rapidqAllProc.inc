'==========================================
' Return Dec from bin
'==========================================
function BinToDec(bin as string)as long
  dim bit as integer
  dim i as integer
  dim value as integer
  
  bin=REVERSE$(bin)
  bit=1
  value=0
  for i=1 to len(bin)
    if mid$(bin,i,1)="1" then value=value+bit
    bit=bit*2
  next i
  result=value
end function

