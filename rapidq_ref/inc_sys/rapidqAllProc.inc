'--------------------------------------------------------------------------------
'   SINZ() sine of a complex number
'--------------------------------------------------------------------------------
'~dup Function SINZ(Z()AS DOUBLE ) AS DOUBLE   ' повтор, первое: Math.inc(393)
'~dup     re = Z(0): im = Z(1) 
'~dup     Z(0) = SIN(re) * COSH(im)
'~dup     Z(1) = COS(re) * SINH(im)
'~dup     SINZ = Z()  
'~dup End Function
'--------------------------------------------------------------------------------
'   SINHZ() sine of a complex number
'--------------------------------------------------------------------------------
'~dup Function SINHZ(Z()AS DOUBLE ) AS DOUBLE   ' повтор, первое: Math.inc(402)
'~dup     re = Z(0): im = Z(1) 
'~dup     Z(0) = SINH(re) * COS(im)
'~dup     Z(1) = COSH(re) * SIN(im)
'~dup     SINHZ = Z()  
'~dup End Function
'--------------------------------------------------------------------------------
'   SQRZ() returns the square root of acomplex number
'--------------------------------------------------------------------------------
'~dup Function SQRZ(Z()AS DOUBLE ) AS DOUBLE   ' повтор, первое: Math.inc(411)
'~dup     re = Z(0): im = Z(1)     
'~dup     Z(0) = ((re + SQR(re * re + im * im)) * 0.5) ^ 0.5   
'~dup     Z(1) = (((re * -1) + SQR(re * re + im * im)) * 0.5) ^ 0.5
'~dup     SQRZ = Z()  
'~dup End Function
'-------------------------------------------------------------------------------
'   SUBZ() returns the difference of two complex numbers
'-------------------------------------------------------------------------------
'~dup Function SUBZ(Z()AS DOUBLE ) AS DOUBLE   ' повтор, первое: Math.inc(420)
'~dup     re1 = Z(0): im1 = Z(1) : re2 = Z(2) : im2 = Z(3)
'~dup     Z(0) = re1 - re2
'~dup     Z(1) = im1 - im2
'~dup     Z(2) = 0
'~dup     Z(3) = 0 
'~dup     SUBZ = Z()  
'~dup End Function
'--------------------------------------------------------------------------------
'   TANH() returns the hyperbolic tangent of x
'--------------------------------------------------------------------------------
'~dup Function TANH(value AS DOUBLE) AS DOUBLE   ' повтор, первое: Math.inc(431)
'~dup     TANH = SINH(value) / COSH(value)
'~dup     IF value = 0 THEN TANH = 0
'~dup End Function
'--------------------------------------------------------------------------------
'   TANZ() returns the tangent of a complex number
'--------------------------------------------------------------------------------
'~dup Function TANZ(Z()AS DOUBLE ) AS DOUBLE   ' повтор, первое: Math.inc(438)
'~dup     re1 = Z(0): im1 = Z(1) 
'~dup     Z(0) =  SIN(2 * re) / (COS(2 * re) + COSH(2 * im))
'~dup     Z(1) =  SINH(2 * im) / (COS(2 * re) + COSH(2 * im))  
'~dup     TANZ = Z()  
'~dup End Function


