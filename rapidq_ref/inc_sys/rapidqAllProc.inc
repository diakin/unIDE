function SysDir (dir as string) as string
  DIM fo_reg AS QRegistry
  fo_reg.RootKey = &H80000001
  fo_reg.openkey ("Software\Microsoft\Windows\CurrentVersion\Explorer\Shell Folders", 0)
  result = fo_reg.readstring(dir) + "\"
end function
