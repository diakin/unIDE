'~dup const rqPI = 3.141592654 '(This is PI)   ' повтор, первое: Math.inc(1)
'~dup const rqE = 2.718281828  '(This is e)   ' повтор, первое: Math.inc(2)
'~dup const rqh = 6.62620 * 10 ^ (-34)   '(J*S: Planck const.)   ' повтор, первое: Math.inc(3)
'~dup const rqc = 2.997925 * 10 ^ 8      '(m/s: velocity of light in vacuum)   ' повтор, первое: Math.inc(4)
'-------------------------------------------------------------------------------
'   ACOSH() returns the hyperbolic areacosine of x
'-------------------------------------------------------------------------------
'~dup Function ACOSH(value AS DOUBLE) AS DOUBLE   ' повтор, первое: Math.inc(8)
'~dup   SELECT CASE value
'~dup    CASE IS < 1
'~dup     MessageBox("Invalid Argument !!!", "ACOSH - Error", 0) 
'~dup    CASE IS >= 1
'~dup     ACOSH =  ( LOG (value + SQR( value ^ 2 - 1 )))
'~dup   END SELECT
'~dup End Function
'-------------------------------------------------------------------------------
'   ACOT() returns the arccotangent of x
'-------------------------------------------------------------------------------
'~dup Function ACOT(value AS DOUBLE) AS DOUBLE   ' повтор, первое: Math.inc(19)
'~dup  ACOT = ((rqPI / 2) - ATAN (value))
'~dup End Function
'-------------------------------------------------------------------------------
'   ACOTH() returns the hyperbolic areacotangent of x
'-------------------------------------------------------------------------------
'~dup Function ACOTH(value AS DOUBLE) AS DOUBLE   ' повтор, первое: Math.inc(25)
'~dup  SELECT CASE ABS (value)
'~dup   CASE IS > 1
'~dup    ACOTH =  (LOG((value + 1) / (value - 1)) * 0.5)
'~dup   CASE ELSE        
'~dup    MessageBox("ERROR: Invalid Argument !!!", "ACOTH - Error", 0)     
'~dup  END SELECT
'~dup End Function
'-------------------------------------------------------------------------------
'   ACOSEC() returns the arccosecans of x
'-------------------------------------------------------------------------------
'~dup Function ACOSEC(value AS DOUBLE) AS DOUBLE   ' повтор, первое: Math.inc(36)
'~dup  SELECT CASE ABS (value)
'~dup   CASE IS < 1
'~dup    MessageBox("Invalid Argument !!!", "ACOSEC - Error", 0) 
'~dup   CASE ELSE          
'~dup    ACOSEC =  (ASIN(1/value))
'~dup   END SELECT 
'~dup End Function
'-------------------------------------------------------------------------------
'   ACOSECH() returns the hyperbolic arccosecans of x
'-------------------------------------------------------------------------------
'~dup Function ACOSECH(value AS DOUBLE) AS DOUBLE   ' повтор, первое: Math.inc(47)
'~dup  SELECT CASE ABS(value)
'~dup   CASE = 0
'~dup    MessageBox("Invalid Argument !!!", "ACOSECH - Error", 0) 
'~dup   CASE ELSE          
'~dup    ACOSECH =  (ASINH(1 / value))
'~dup  END SELECT 
'~dup End Function
'-------------------------------------------------------------------------------
'   ADDZ() returns the sum of two complex numbers
'-------------------------------------------------------------------------------
'~dup Function ADDZ(Z()AS DOUBLE ) AS DOUBLE   ' повтор, первое: Math.inc(58)
'~dup     re1 = Z(0): im1 = Z(1) : re2 = Z(2) : im2 = Z(3)
'~dup     Z(0) = re1 + re2
'~dup     Z(1) = im1 + im2
'~dup     Z(2) = 0
'~dup     Z(3) = 0 
'~dup     ADDZ = Z()  
'~dup End Function
'-------------------------------------------------------------------------------
'   ASINH() returns the hyperbolic areasine of x
'-------------------------------------------------------------------------------
'~dup Function ASINH(value AS DOUBLE) AS DOUBLE   ' повтор, первое: Math.inc(69)
'~dup  ASINH = LOG (value + (SQR(value * value + 1)))
'~dup End Function
'-------------------------------------------------------------------------------
'   ASEC() returns the arccosecans of x
'-------------------------------------------------------------------------------
'~dup Function ASEC(value AS DOUBLE) AS DOUBLE   ' повтор, первое: Math.inc(75)
'~dup  SELECT CASE ABS (value)
'~dup   CASE IS < 1
'~dup     MessageBox("ERROR:Invalid Argument !!!", "ASEC - Error", 0)
'~dup   CASE ELSE          
'~dup    ASEC =  (rqPI / 2 - ASIN( 1 / value))
'~dup  END SELECT 
'~dup End Function
'-------------------------------------------------------------------------------
'   ASECH() returns the hyperbolic arccosecans of x
'-------------------------------------------------------------------------------
'~dup Function ASECH(value AS DOUBLE) AS DOUBLE   ' повтор, первое: Math.inc(86)
'~dup  SELECT CASE ABS (value)
'~dup   CASE IS > 1
'~dup    MessageBox("ERROR:Invalid Argument !!!", "ASECH - Error", 0) 
'~dup   CASE IS <= 0
'~dup    MessageBox("ERROR:Invalid Argument !!!", "ASECH - Error", 0) 
'~dup   CASE ELSE          
'~dup    ASECH = (ACOSH(1 / value))
'~dup  END SELECT 
'~dup End Function
'-------------------------------------------------------------------------------
'   ATANH() returns the hyperbolic areatangent of x
'-------------------------------------------------------------------------------
'~dup Function ATANH(value AS DOUBLE) AS DOUBLE   ' повтор, первое: Math.inc(99)
'~dup  SELECT CASE ABS(value)
'~dup   CASE IS < 1
'~dup    ATANH = (LOG((1 + value) / (1 - value)) * 0.5)
'~dup   CASE 0
'~dup    ATANH = 1
'~dup   CASE ELSE
'~dup    MessageBox("ERROR:Invalid Argument !!!", "ATANH - Error", 0) 
'~dup  END SELECT
'~dup End Function
'--------------------------------------------------------------------------------
