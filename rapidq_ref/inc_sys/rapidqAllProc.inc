Function GetSubjCodePage( Subject As String) As String
zza$=Subject
CodePage$=field$(zza$,"?",2)
result=""
if CodePage$ <>"" then
	result=CodePage$
elseif CodePage$="" and isKOI8(zza$)=1 then
	result="koi8-r"
else
	result=""
end if

end function

'*****************************************
Function GetSubjCodeMethod( Subject As String) As String
result=lcase$(field$(Subject,"?",3))
end function

