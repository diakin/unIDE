ft$=Mid$(code$,fs,fl)
ft$=LTRIM$(RTRIM$(ft$))
Args(0)=ft$ ' Function type

ns=fe+1
ne=InStr(ns,code$," ")
nl=ne-ns
fn$=Mid$(code$,ns,nl)
fn$=LTRIM$(RTRIM$(fn$))
Args(1)=fn$ ' Function name

ls=InStr(UCase$(code$),"LIB ")+4
le=InStr(ls,code$," ")
ll=le-ls
lib$=Mid$(code$,ls,ll)
lib$=LTRIM$(RTRIM$(lib$))
Args(2)=lib$

For i=0 to 3
result=Args(i)
Next i
end function

