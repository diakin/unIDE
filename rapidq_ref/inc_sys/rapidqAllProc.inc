'~dup FUNCTION SaveStringEx(ss$ as STRING ,FileName as STRING, mode as integer  ) AS integer   ' повтор, первое: Files.inc(417)
'~dup ' save string SS$ to file FileName. 
'~dup 'Mode=0 - overwrite, 
'~dup 'Mode=1 - append string ss$ to file FileName
'~dup 'Mode=2 - append  crlf+ss$ to file FileName
'~dup 
'~dup result=0
'~dup 
'~dup if FileName="" then showmessage ("FUNCTION SaveString. Wrong FileName="+FileName):exit function
'~dup 
'~dup DIM fileStr as QFileStream
'~dup 
'~dup if mode=0 then
'~dup 	result=0
'~dup 	fileStr.open (FileName,65535 ) 'fmCreate'
'~dup 	result=-1
'~dup 	FileStr.WriteStr(ss$, len(ss$)) 
'~dup 	FileStr.Close
'~dup elseif mode=1 or mode=2 then
'~dup 	if fileexists(FileName)=0 then md=65535:crl="" else md=2:crl$=crlf 'showmessage ("FUNCTION SaveString. Can't open File="+FileName):exit function
'~dup 	fileStr.open (FileName,md ) 'fmOpenReadWrite = 2
'~dup 	fileStr.Position=fileStr.size
'~dup 	result=-1
'~dup 	if mode=1 then FileStr.WriteStr(ss$, len(ss$)) else FileStr.WriteStr(crl$+ss$, len(crl$+ss$))
'~dup 	FileStr.Close
'~dup else
'~dup end if
'~dup 
'~dup result=1
'~dup 
'~dup END FUNCTION

