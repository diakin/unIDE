		endpos2=instr(begpos+1,Source,"?=")
		print"endpos2=";endpos2
		endpos=instr(endpos2+1,Source,"?=")
		print"endpos=";endpos
		if begpos2=0 then begpos2=len(Source)
		encodedword$=mid$(Source,begpos,begpos2-begpos)
		print"encodedword$=";encodedword$
		' decode encoded-words
		codepage$=field$(encodedword$,"?",2) ' windows-1251
		print"codepage$=";codepage$
		
		codeMode$=ucase$(field$(encodedword$,"?",3)) ' Q 
		print"codeMode$=";codeMode$
		if codeMode$<>"Q" then 
			QPMSGHeaderDecode=Source
			exit function
		end if
		headerTxt$=field$(encodedword$,"?",4) '
		headerTxt$=replacesubstr$(headerTxt$,"_","=20") ' replace white spaces
		
		print"headerTxt$=";headerTxt$
		lastpartHeader$=field$(encodedword$,"?=",3)
		print"lastpartHeader$=";lastpartHeader$
		
		HexCharCount=tally(headerTxt$,"=")
		print"HexCharCount=";HexCharCount
		for ii=1 to HexCharCount
			HexChar$=field$(headerTxt$,"=",ii+1)
			print"HexChar$=";HexChar$
			headerTxtConv$=headerTxtConv$+chr$(val(CONVBASE$(HexChar$, 16, 10)))
			print"headerTxtConv$=";headerTxtConv$
		next ii
		'chartooem(headerTxtConv$,headerTxtConv$)
		result=result+headerTxtConv$+lastpartHeader$
		begpos=begpos2
	next j
else
	result  = Source 
end if
QPMSGHeaderDecode = result 
print"result=";result
End Function 

