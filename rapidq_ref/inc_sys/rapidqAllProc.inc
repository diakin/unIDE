'   about and ACL.  First are the various information classes available to
'   the user.
'

'~dup Public Const AclRevisionInformation = 1   ' повтор, первое: WIN32API.INC(1239)
'~dup Public Const AclSizeInformation = 2   ' повтор, первое: WIN32API.INC(1240)
'
'   This record is returned/sent if the user is requesting/setting the
