'~dup end funCTION

'-- **************************************************************************'

' LIKE Function - pattern matching routine for Rapid-Q by William Yu
' This emulates the VB LIKE operator.
' Thanks to Thomas Binder for the original C code
'
' ?   Any single character.
' *   Zero or more characters.
' #   Any single digit (0-9).
' [charlist]  Any single character in charlist.
' [!charlist] Any single character not in charlist.
'
' A group of one or more characters (charlist) enclosed in brackets ([ ])
' can be used to match any single character in string and can include almost
' any character code, including digits.
'
' Note:   To match the special characters left bracket ([), question
' mark (?), number sign (#), and asterisk (*), enclose them in brackets.
' The right bracket (]) can't be used within a group to match itself, but
' it can be used outside a group as an individual character.
'
' By using a hyphen (-) to separate the upper and lower bounds of the range,
' charlist can specify a range of characters. For example, [A-Z] results in
' a match if the corresponding character position in string contains any
' uppercase letters in the range A-Z. Multiple ranges are included within
' the brackets without delimiters.


'~dup DECLARE FUNCTION Like(ParseString AS STRING, Pattern AS STRING) AS INTEGER   ' повтор, первое: conversion.inc(433)
'~dup DECLARE FUNCTION IsDigit(S AS STRING) AS INTEGER   ' повтор, первое: conversion.inc(434)

'~dup const INVERT = "!"       '-- Some like ^ or ~ instead, whatever you want   ' повтор, первое: conversion.inc(436)

'-- **************************************************************************'
'~dup FUNCTION IsDigit(S AS STRING) AS INTEGER   ' повтор, первое: conversion.inc(439)
'~dup   IF S >= "0" AND S <= "9" THEN
'~dup     IsDigit = 1
'~dup   ELSE
'~dup     IsDigit = 0
'~dup   END IF
'~dup END FUNCTION


'-- **************************************************************************'
'~dup FUNCTION Like(ParseString AS STRING, Pattern AS STRING) AS INTEGER   ' повтор, первое: conversion.inc(465)
'~dup   DIM prev AS INTEGER, matched AS INTEGER, reverse AS INTEGER
'~dup 
'~dup   WHILE Pattern <> ""
'~dup     SELECT CASE MID$(Pattern, 1, 1)
'~dup       CASE "?"
'~dup         IF ParseString = "" THEN
'~dup            Like = 0
'~dup            EXIT FUNCTION
'~dup         END IF
'~dup       CASE "#"
'~dup         IF IsDigit(MID$(ParseString, 1, 1)) = 0 THEN
'~dup            Like = 0
'~dup            EXIT FUNCTION
'~dup         END IF
'~dup       CASE "*"
'~dup         DO
'~dup           Pattern = MID$(Pattern, 2, LEN(Pattern)-1)
'~dup         LOOP UNTIL MID$(Pattern, 1, 1) <> "*"
'~dup         IF Pattern = "" THEN
'~dup            Like = 1
'~dup            EXIT FUNCTION
'~dup         END IF
'~dup         WHILE ParseString <> ""
'~dup            IF Like(ParseString, Pattern) THEN
'~dup               Like = 1
'~dup               EXIT FUNCTION
'~dup            END IF
'~dup            IF ParseString <> "" THEN
'~dup               ParseString = MID$(ParseString, 2, LEN(ParseString)-1)
'~dup            END IF
'~dup         WEND
'~dup         Like = 0
'~dup         EXIT FUNCTION
'~dup       CASE "["
'~dup         reverse = (MID$(Pattern, 2, 1) = INVERT)
'~dup         IF reverse THEN
'~dup            Pattern = MID$(Pattern, 2, LEN(Pattern)-1)
'~dup         END IF
'~dup         prev = 256: matched = 0
'~dup         DO
'~dup            Pattern = MID$(Pattern, 2, LEN(Pattern)-1)
'~dup            IF (Pattern <> "") AND (esc <> 0 OR MID$(Pattern, 1, 1) <> "]") THEN
'~dup               IF MID$(Pattern, 1, 1) = "-" THEN
'~dup                  Pattern = MID$(Pattern, 2, LEN(Pattern)-1)
'~dup                  IF Pattern = "" THEN
'~dup                     Like = 0
'~dup                     EXIT FUNCTION
'~dup                  END IF
'~dup                  matched = matched OR (MID$(ParseString, 1, 1) <= MID$(Pattern, 1, 1) AND ASC(MID$(ParseString, 1, 1)) >= prev)
'~dup               ELSE
'~dup                  matched = matched OR (MID$(ParseString, 1, 1) = MID$(Pattern, 1, 1))
'~dup               END IF
'~dup               prev = ASC(MID$(Pattern, 1, 1))
'~dup            ELSE
'~dup               EXIT DO
'~dup            END IF
'~dup            esc = 0
'~dup         LOOP
'~dup         IF (prev = 256 OR MID$(Pattern, 1, 1) <> "]" OR ABS(matched) = ABS(reverse)) THEN
'~dup            Like = 0
'~dup            EXIT FUNCTION
'~dup         END IF
'~dup       CASE ELSE
'~dup         IF MID$(ParseString, 1, 1) <> MID$(Pattern, 1, 1) THEN
'~dup            Like = 0
'~dup            EXIT FUNCTION
'~dup         END IF
'~dup     END SELECT
'~dup     ParseString = MID$(ParseString, 2, LEN(ParseString)-1)
'~dup     Pattern = MID$(Pattern, 2, LEN(Pattern)-1)
'~dup   WEND
'~dup 
'~dup   Like = ABS(LEN(ParseString) = 0)
'~dup END FUNCTION

