'~dup 	pnt=val(Field$(io2RndList.Item(k),",", 1))
'~dup 	Adat!=val( Field$(io2RndList.Item(k),",", 2) )
'~dup 	IF pnt = i0 THEN
'~dup 		io2RndFile2.WriteNum(Adat!,Num_SINGLE )
'~dup 		'io2Rndtmp.WriteLine (str$(pnt)+" "+str$(Adat!) )
'~dup 		io2Rndtmp.WriteNum (pnt,Num_SINGLE)
'~dup 		pntOld = pnt: AdatOld! = Adat!
'~dup 	elseif pnt < i0 then
'~dup 		io2RndFile2.WriteNum(Adat!,Num_SINGLE )
'~dup 		'io2Rndtmp.WriteLine (str$(i0)+" "+str$(Adat!) )
'~dup 		io2Rndtmp.WriteNum (pnt,Num_SINGLE)
'~dup 		pntOld = i0: AdatOld! = Adat!
'~dup 	else
'~dup 		IF pnt <> pntOld THEN ki! = (Adat! - AdatOld!) / (pnt - pntOld) ELSE GOTO ex1
'~dup 		FOR j = i0 TO pnt - 1
'~dup 			LostP = LostP + 1
'~dup 			Adat1! = AdatOld! + ki!
'~dup 			io2RndFile2.WriteNum(Adat1!,Num_SINGLE )
