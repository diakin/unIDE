$IFNDEF _AMIB
$DEFINE _AMIB
$Option Explicit

Declare Function CreateCompatibleBitmap_AMIB Lib "gdi32" Alias "CreateCompatibleBitmap" ( _
		ByVal hdc As Long, ByVal nWidth As Long, ByVal nHeight As Long) As Long
