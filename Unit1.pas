const
  // Режим F4: окно FAR не уже, редактор рядом с ним - не уже (пикселей)
  FarHalfMinWidth = 200;
  FarHalfMinEditor = 150;
  FarSplitterWidth = 5;
  FarBtnW = 22;
  FarBtnH = 18;

// Utils - unIDE FAR: двухпанельный файловый менеджер поверх области
// редактора (вкладки, тулбар, лог и остальное остаются видны). Окно
// создаётся при первом открытии и дальше только прячется (F10) - пути
// панелей держит само; при новом открытии папки перечитываются.
procedure TForm1.FarMenuClick(Sender: TObject);
var
  StartDir: string;
begin
  if FFar = nil then
  begin
    StartDir := '';
    if FCurrentFileName <> '' then
      StartDir := ExtractFilePath(FCurrentFileName);
    if (StartDir = '') or not DirectoryExists(StartDir) then
      StartDir := ExtractFilePath(Application.ExeName);
    FFar := TFarView.Create(Self);
    FFar.Visible := False;
    FFar.Parent := pnlMain;
    FFar.OnClose := FarClose;
    FFar.OnStatus := FarStatus;
    FFar.OnEditFile := FarEditFile;
    FFar.OnLeave := FarLeave;
    FFarOwnWin := -1;
    FFar.LoadState(SettingsFileName, StartDir);
  end
  else if FFarHalf and FFarCollapsed then
  begin
    // Режим F4, FAR свёрнут - развернуть
    FarCollapse(False);
    Exit;
  end
  else if not FFar.Visible then
    FFar.RereadAll;
  FFar.Visible := True;
  FarLayout;
  FFar.BringToFront;
  if FFar.CanFocus then
    FFar.SetFocus;
  StatusBar1.SimpleText := 'unIDE FAR ' + FarBuild + ': F10 - закрыть';
  StatusBar1.SimplePanel := True;
end;

// Место окна unIDE FAR: вся ширина pnlMain, от строки вкладок до лога
// (сплиттер лога, лог, вторая строка состояния - внизу pnlMain). Вторая
// панель разделённого редактора и строка объявления - под окном FAR.
procedure TForm1.FarLayout;
var
  TopEdge, BottomEdge, NewWidth, MaxWidth, RightEdge: Integer;

  procedure TakeBottom(ACtl: TControl);
  begin
    if (ACtl <> nil) and ACtl.Visible and (ACtl.Parent = pnlMain) and
       (ACtl.Top < BottomEdge) then
      BottomEdge := ACtl.Top;
  end;

begin
  if FFar = nil then
    Exit;
  // Режим F4: FAR - на месте распорки, остальное - редактору
  if FFarHalf and (FFarSpacer <> nil) and FFarSpacer.Visible then
  begin
    // Свёрнут - полоска с одной кнопкой []
    if FFarCollapsed then
    begin
      if FFarSpacer.Width <> RightPanelCollapsedWidth then
        FFarSpacer.Width := RightPanelCollapsedWidth;
      if FFarBtnMin <> nil then
        FFarBtnMin.Visible := False;
      if FFarBtnRestore <> nil then
      begin
        FFarBtnRestore.SetBounds(FFarSpacer.Left + 2, FFarSpacer.Top + 2,
          FFarSpacer.Width - 4, FarBtnH);
        FFarBtnRestore.Enabled := True;
        FFarBtnRestore.Visible := True;
        FFarBtnRestore.BringToFront;
      end;
      Exit;
    end;
    // Ширина - заданная сплиттером (HalfWidth), без неё - половина; не
    // уже FarHalfMinWidth, редактору - не меньше FarHalfMinEditor
    NewWidth := FFar.HalfWidth;
    if NewWidth <= 0 then
      NewWidth := pnlMain.ClientWidth div 2;
    MaxWidth := pnlMain.ClientWidth - FarHalfMinEditor - FarSplitterWidth;
    if NewWidth > MaxWidth then
      NewWidth := MaxWidth;
    if NewWidth < FarHalfMinWidth then
      NewWidth := FarHalfMinWidth;
    if FFarSpacer.Width <> NewWidth then
      FFarSpacer.Width := NewWidth;
    FFar.SetBounds(FFarSpacer.Left, FFarSpacer.Top, FFarSpacer.Width,
      FFarSpacer.Height);
    // Кнопки _ и [] - в правом верхнем углу окна FAR; у развёрнутого []
    // - FAR на всю ширину (FarBtnClick)
    if (FFarBtnMin <> nil) and (FFarBtnRestore <> nil) then
    begin
      RightEdge := FFarSpacer.Left + FFarSpacer.Width - 2;
      FFarBtnRestore.SetBounds(RightEdge - FarBtnW, FFarSpacer.Top,
        FarBtnW, FarBtnH);
      FFarBtnMin.SetBounds(RightEdge - 2 * FarBtnW - 2, FFarSpacer.Top,
        FarBtnW, FarBtnH);
      FFarBtnRestore.Enabled := True;
      FFarBtnMin.Visible := True;
      FFarBtnRestore.Visible := True;
      FFarBtnMin.BringToFront;
      FFarBtnRestore.BringToFront;
    end;
    Exit;
  end;
  if not FFar.Visible then
    Exit;
  TopEdge := 0;
  if (FTabs <> nil) and FTabs.Visible and (FTabs.Parent = pnlMain) then
    TopEdge := FTabs.Top + FTabs.Height;
  BottomEdge := pnlMain.ClientHeight;
  TakeBottom(Splitter1);
  TakeBottom(pnlLog);
  TakeBottom(Panel2);
  if BottomEdge < TopEdge then
    BottomEdge := TopEdge;
  FFar.SetBounds(0, TopEdge, pnlMain.ClientWidth, BottomEdge - TopEdge);
end;

// F10 в unIDE FAR: папки панелей - в editor.ini, окно прячется, фокус -
// редактору
procedure TForm1.FarClose(Sender: TObject);
begin
  if FFar = nil then
    Exit;
  // Закрыт в режиме F4: редактор - снова на всю область, файл F4 остаётся
  // обычной вкладкой
  FarBeginUpdate;
  try
    if FFarHalf then
    begin
      FFarHalf := False;
      FFarCollapsed := False;
      FFarOwnWin := -1;
      FFarCreatedFile := '';
      if FFarSplitter <> nil then
        FFarSplitter.Visible := False;
      if FFarBtnMin <> nil then
        FFarBtnMin.Visible := False;
      if FFarBtnRestore <> nil then
        FFarBtnRestore.Visible := False;
      if FFarSpacer <> nil then
        FFarSpacer.Visible := False;
      FFar.SetSingle(-1);
    end;
    FFar.SaveState(SettingsFileName);
    FFar.Visible := False;
  finally
    FarEndUpdate;
  end;
  FFarEatF10Up := True;
  StatusBar1.SimplePanel := False;
  UpdateStatusBarInfo;
  if RichEdit1.CanFocus then
    RichEdit1.SetFocus;
end;

// Сообщения unIDE FAR (клавиша не сделана, папку не открыть) - строкой
// состояния
procedure TForm1.FarStatus(const AText: string);
begin
  StatusBar1.SimpleText := AText;
  StatusBar1.SimplePanel := True;
end;

// Режим F4: распорка шириной в половину pnlMain со стороны активной панели
// FAR (alLeft / alRight, крайняя), FAR - поверх неё с одной панелью,
// редактор (FLeftHost, alClient) - на оставшейся половине. Редактор не
// меняет родителя - RichEdit не пересоздаётся.
procedure TForm1.FarHalfOn;
begin
  if FFar = nil then
    Exit;
  if FFarSpacer = nil then
  begin
    FFarSpacer := TPanel.Create(Self);
    FFarSpacer.Visible := False;
    FFarSpacer.BevelOuter := bvNone;
    FFarSpacer.Caption := '';
    FFarSpacer.ParentBackground := False;
    FFarSpacer.Color := clNavy;
    FFarSpacer.Parent := pnlMain;
  end;
  if FFarSplitter = nil then
  begin
    // Сплиттер: при перетаскивании - линия-след (rsPattern), ширина
    // ставится при отпускании (FarSplitterMoved)
    FFarSplitter := TSplitter.Create(Self);
    FFarSplitter.Visible := False;
    FFarSplitter.Width := FarSplitterWidth;
    FFarSplitter.Beveled := False;
    FFarSplitter.AutoSnap := False;
    FFarSplitter.MinSize := FarHalfMinWidth;
    FFarSplitter.ResizeStyle := rsPattern;
    FFarSplitter.Color := $00D06800;   // как разделитель правой панели
    FFarSplitter.OnMoved := FarSplitterMoved;
    FFarSplitter.Parent := pnlMain;
  end;
  if FFarBtnMin = nil then
  begin
    FFarBtnMin := TUiButton.Create(Self);
    FFarBtnMin.Visible := False;
    FFarBtnMin.Parent := pnlMain;
    FFarBtnMin.Caption := '_';
    FFarBtnMin.Hint := 'Свернуть панель FAR';
    FFarBtnMin.ShowHint := True;
    FFarBtnMin.OnClick := FarBtnClick;
    FFarBtnRestore := TUiButton.Create(Self);
    FFarBtnRestore.Visible := False;
    FFarBtnRestore.Parent := pnlMain;
    FFarBtnRestore.Caption := '[]';
    FFarBtnRestore.Hint := 'Свёрнута - развернуть до прежней ширины; ' +
      'развёрнута - FAR на всю ширину (файл остаётся вкладкой)';
    FFarBtnRestore.ShowHint := True;
    FFarBtnRestore.OnClick := FarBtnClick;
  end;
  FarBeginUpdate;
  try
    FFarHalf := True;
    FFarCollapsed := False;
    FFar.SetSingle(FFar.ActiveIndex);
    if FFar.ActiveIndex = 0 then
    begin
      FFarSpacer.Align := alLeft;
      FFarSpacer.Left := -10;    // левее всех alLeft
    end
    else
    begin
      FFarSpacer.Align := alRight;
      FFarSpacer.Left := pnlMain.ClientWidth + 10;  // правее всех alRight
    end;
    FFarSpacer.Visible := True;
    FarLayout;
    FarPlaceSplitter;
    FFar.BringToFront;
    FarLayout;
  finally
    FarEndUpdate;
  end;
end;

// Смена места и ширины окна FAR в режиме F4 (вкл / выкл, сплиттер,
// свернуть / развернуть) - как у правой панели (ApplyRightPanelWidth):
// перерисовка на время раскладки выключена, потом полосы прокрутки
// редактора заново (FormResizeEvent) и всё окно перерисовывается со всеми
// дочерними окнами. Иначе редактор, сдвинутый влево, оставался на экране
// на прежнем месте, а на новом была пустота.
procedure TForm1.FarBeginUpdate;
begin
  if FFarUpdateDepth = 0 then
    SendMessage(Handle, WM_SETREDRAW, 0, 0);
  Inc(FFarUpdateDepth);
end;

procedure TForm1.FarEndUpdate;
begin
  if FFarUpdateDepth <= 0 then
    Exit;
  Dec(FFarUpdateDepth);
  if FFarUpdateDepth > 0 then
    Exit;
  try
    FormResizeEvent(Self);
  finally
    SendMessage(Handle, WM_SETREDRAW, 1, 0);
    RedrawWindow(Handle, nil, 0, RDW_ERASE or RDW_FRAME or RDW_INVALIDATE or
                 RDW_ALLCHILDREN or RDW_UPDATENOW);
  end;
end;

// Сплиттер - сразу за распоркой, со стороны редактора
procedure TForm1.FarPlaceSplitter;
begin
  if (FFarSplitter = nil) or (FFarSpacer = nil) then
    Exit;
  FFarSplitter.Visible := False;
  if FFarSpacer.Align = alLeft then
  begin
    FFarSplitter.Align := alLeft;
    FFarSplitter.Left := FFarSpacer.Left + FFarSpacer.Width;
  end
  else
  begin
    FFarSplitter.Align := alRight;
    FFarSplitter.Left := FFarSpacer.Left - FFarSplitter.Width;
  end;
  FFarSplitter.Visible := True;
end;

// Сплиттер отпустили: новая ширина окна FAR - запомнить (editor.ini,
// [Far] HalfWidth) и разложить
procedure TForm1.FarSplitterMoved(Sender: TObject);
begin
  if (FFar = nil) or (FFarSpacer = nil) then
    Exit;
  FarBeginUpdate;
  try
    FFar.HalfWidth := FFarSpacer.Width;
    FarLayout;
  finally
    FarEndUpdate;
  end;
end;

// _ - свернуть FAR; [] у свёрнутого - развернуть до прежней ширины, у
// развёрнутого - FAR на всю ширину с обеими панелями: режим F4 кончается,
// файл остаётся обычной вкладкой (без вопроса о сохранении)
procedure TForm1.FarBtnClick(Sender: TObject);
begin
  if Sender = FFarBtnMin then
    FarCollapse(True)
  else if FFarCollapsed then
    FarCollapse(False)
  else
    FarHalfOff;
end;

// Режим F4: свернуть окно FAR до полоски с кнопкой [] (фокус - редактору)
// или развернуть до прежней ширины (HalfWidth не меняется)
procedure TForm1.FarCollapse(ACollapse: Boolean);
begin
  if not FFarHalf or (FFar = nil) or (ACollapse = FFarCollapsed) then
    Exit;
  FFarCollapsed := ACollapse;
  FarBeginUpdate;
  try
    if ACollapse then
    begin
      FFar.Visible := False;
      if FFarSplitter <> nil then
        FFarSplitter.Visible := False;
      FarLayout;
    end
    else
    begin
      FFar.Visible := True;
      FarLayout;
      FarPlaceSplitter;
      FFar.BringToFront;
      FarLayout;
    end;
  finally
    FarEndUpdate;
  end;
  if ACollapse then
  begin
    if RichEdit1.CanFocus then
      RichEdit1.SetFocus;
  end
  else if FFar.CanFocus then
    FFar.SetFocus;
end;

// Конец режима F4: распорка убрана, FAR - снова две панели на всю область
procedure TForm1.FarHalfOff;
begin
  FarBeginUpdate;
  try
    FarHalfOffLayout;
  finally
    FarEndUpdate;
  end;
  if (FFar <> nil) and FFar.CanFocus then
    FFar.SetFocus;
end;

procedure TForm1.FarHalfOffLayout;
begin
  FFarHalf := False;
  FFarOwnWin := -1;
  FFarCreatedFile := '';
  FFarEditSaved := False;
  if FFarSplitter <> nil then
    FFarSplitter.Visible := False;
  if FFarBtnMin <> nil then
    FFarBtnMin.Visible := False;
  if FFarBtnRestore <> nil then
    FFarBtnRestore.Visible := False;
  if FFarSpacer <> nil then
    FFarSpacer.Visible := False;
  if FFar = nil then
    Exit;
  // Был свёрнут - окно FAR снова видно
  FFarCollapsed := False;
  FFar.Visible := True;
  FFar.SetSingle(-1);
  FarLayout;
  FFar.BringToFront;
end;

// F4 / Shift+F4 в unIDE FAR: файл - в редактор во второй половине. Путь
// редактору - в кодировке Windows или коротким именем 8.3 (FarToAnsiPath)
procedure TForm1.FarEditFile(const AFileName: WideString; ACreated: Boolean);
var
  FN: string;
  WasOpen: Boolean;
  WinIdx: Integer;
begin
  FN := FarToAnsiPath(AFileName);
  if FN = '' then
  begin
    FarStatus('unIDE FAR: имя файла с символами вне кодировки Windows, ' +
      'короткого имени нет - редактор его не откроет');
    Exit;
  end;
  // F4 ещё раз, другой файл: прежний файл F4, если в нём ничего не
  // меняли, закрывается; изменённый остаётся вкладкой
  if FFarHalf and (FFarOwnWin >= 0) and (FFarOwnWin = FWindowsIndex) and
     FWindows[FFarOwnWin].Used and not RichEdit1.Modified and
     (IndexOfWindowByFile(FN) <> FFarOwnWin) then
    CloseWindow(FFarOwnWin);
  WasOpen := IndexOfWindowByFile(FN) >= 0;
  if not FFarHalf then
    FarHalfOn;
  OpenNamedFile(FN);
  WinIdx := IndexOfWindowByFile(FN);
  if (WinIdx >= 0) and not WasOpen then
    FFarOwnWin := WinIdx
  else
    FFarOwnWin := -1;
  if ACreated then
    FFarCreatedFile := FN
  else
    FFarCreatedFile := '';
  FFarEditSaved := False;
  StatusBar1.SimpleText := 'unIDE FAR: Esc - закрыть редактор, ' +
    'F2 / Shift+F2 - сохранить / сохранить как';
  StatusBar1.SimplePanel := True;
  if RichEdit1.CanFocus then
    RichEdit1.SetFocus;
end;

// Tab в FAR с одной панелью - в редактор
procedure TForm1.FarLeave(Sender: TObject);
begin
  if FFarHalf and RichEdit1.CanFocus then
    RichEdit1.SetFocus;
end;

// Esc в редакторе в режиме F4. Вкладку, которую открыл F4, - закрыть
// (изменённый файл - вопрос Сохранить / Не сохранять / Отмена; Отмена -
// редактор остаётся); вкладка, открытая до F4, остаётся. Дальше FAR - снова
// на всю область.
procedure TForm1.FarEditorEsc;
var
  WinIdx: Integer;
  SearchRec: TSearchRec;
  IsEmpty: Boolean;
begin
  WinIdx := FWindowsIndex;
  if (FFarOwnWin >= 0) and (WinIdx = FFarOwnWin) and
     (WinIdx <= WindowsItemCount - 1) then
  begin
    CloseWindow(WinIdx);
    if FWindows[WinIdx].Used then
      Exit;  // Отмена в вопросе о сохранении
    // Пустой файл от Shift+F4, который так и не сохранили, - убрать
    if (FFarCreatedFile <> '') and not FFarEditSaved then
    begin
      IsEmpty := False;
      if SysUtils.FindFirst(FFarCreatedFile, faAnyFile, SearchRec) = 0 then
      begin
        IsEmpty := SearchRec.Size = 0;
        SysUtils.FindClose(SearchRec);
      end;
      if IsEmpty then
        SysUtils.DeleteFile(FFarCreatedFile);
    end;
  end;
  FarHalfOff;
end;

// Меню Utils: IncManager и Find inc file - про inc-файлы RapidQ, доступны
// только в проектах Basic (RapidQ Basic, FreeBASIC). Зовётся по простою,
// когда сменился текущий проект (тип читается из editor.ini)
procedure TForm1.UtilsMenuOpen(Sender: TObject);
var
  PrjType: string;
  IsBasic: Boolean;
begin
  FUtilsPrjKey := FCurrentProject;
  FUtilsPrjDone := True;
  IsBasic := False;
  if (FCurrentProject <> '') and ProjectExists(FCurrentProject) then
  begin
    PrjType := ProjectTypeOf(FCurrentProject);
    IsBasic := (CompareText(PrjType, 'RapidQ Basic') = 0) or
               (CompareText(PrjType, 'FreeBASIC') = 0);
  end;
  mIncManager.Enabled := IsBasic;
  mFindInc.Enabled := IsBasic;
end;

// Окно поиска inc-файла (DlgFindInc). AName - имя для поиска ('' - без
// поиска). Копировать - в папку inc текущего проекта (её читает rc.exe),
// без неё - в папку общих inc.
procedure TForm1.FindIncShow(const AName: string);
var
  SysDir, RefDir, TargetDir, CurDir, IncDir, CfgSys, UserDir, Mode,
  OwnDir: string;
begin
  IncRefDirs(SysDir, RefDir);
  // Порядок поиска: Include (папка -I проекта), папка с общими inc, если
  // она другая, папка главного .bas (или открытого файла), папка выше
  RapidQIncludeDirs(CurDir, IncDir);
  RapidQIncSettings(FCurrentProject, CfgSys, UserDir, Mode, OwnDir);
  // UserDir из настроек - Include User; папка -I проекта - IncDir
  TargetDir := ExcludeTrailingPathDelimiter(RapidQIncDir);
  if TargetDir = '' then
    TargetDir := ExcludeTrailingPathDelimiter(SysDir);
  if FFindIncDlg = nil then
  begin
    FFindIncDlg := TDlgFindInc.Create(Self);
    TDlgFindInc(FFindIncDlg).OnOpenFile := IncMgrOpenFile;
  end;
  TDlgFindInc(FFindIncDlg).ShowFind(AName, RefDir, SysDir, TargetDir,
                                    CurDir, IncDir, UserDir);
end;

// Перед сборкой RapidQ: $INCLUDE (с вложенными), $RESOURCE и DLL из
// DECLARE ... LIB - на месте ли (RqDeps). Нет - окно DlgRqDeps: поиск по
// Include (-I), общей Include, папке программы и папке выше, копирование
// в папку -I (DLL - в папку программы). Имена, про которые просили не
// спрашивать, - editor.ini [RqDepsIgnore], ключ - путь главного .bas.
// False - сборку отменили.
function TForm1.RqDepsBeforeBuild(const ABas, AIncDir: string): Boolean;
var
  Scan: TRqDepScan;
  Roots, CopyLog, Ignore: TStringList;
  Ini: TIniFile;
  SysDir, RefDir, UserDir, CfgSys, Mode, OwnDir, MainDir, BasKey,
  IgnoreText, Rest: string;
  ItemIdx, SepPos: Integer;
  Dep: TRqDep;
  Scheme: TClrScheme;
begin
  // Окно недостающих файлов немодальное: пока оно открыто, вторая сборка
  // его не открывает - окно поднимается наверх
  if RqDepsDialogActive then
  begin
    LogComp('Окно недостающих файлов уже открыто: сборка продолжится после ' +
            'него');
    Result := False;
    Exit;
  end;
  Result := True;
  BasKey := LowerCase(ExpandFileName(ABas));
  Scan := TRqDepScan.Create;
  Roots := TStringList.Create;
  CopyLog := TStringList.Create;
  Ignore := TStringList.Create;
  try
    Ignore.Sorted := True;
    Ignore.Duplicates := dupIgnore;
    IgnoreText := '';
    if FileExists(SettingsFileName) then
    begin
      Ini := TIniFile.Create(SettingsFileName);
      try
        IgnoreText := Ini.ReadString('RqDepsIgnore', BasKey, '');
      finally
        Ini.Free;
      end;
    end;
    Rest := IgnoreText;
    while Rest <> '' do
    begin
      SepPos := Pos('|', Rest);
      if SepPos = 0 then
        SepPos := Length(Rest) + 1;
      if Trim(Copy(Rest, 1, SepPos - 1)) <> '' then
        Ignore.Add(UpperCase(Trim(Copy(Rest, 1, SepPos - 1))));
      Delete(Rest, 1, SepPos);
    end;

    // В логе - отдельным шагом до "--- Компиляция"
    LogComp('--- Препроцессор: ' + ExtractFileName(ABas) +
            ' - $INCLUDE, $RESOURCE, DLL из DECLARE ... LIB');
    // На панели хода над редактором: "Препроцессор ..."; итог - зелёным не
    // показывается (сразу идёт "Компиляция"), недостающие - красным
    BusyBegin('Препроцессор ' + ExtractFileName(ABas));
    try
      Scan.Scan(ABas, AIncDir);
      Scan.DropNames(Ignore);
    finally
      if Scan.MissingCount = 0 then
        BusyEnd('', True)
      else
        BusyEnd(Format('Препроцессор: нет файлов %d', [Scan.MissingCount]),
                False);
    end;
    if Ignore.Count > 0 then
      LogComp('Препроцессор: не проверяются по выбору (editor.ini ' +
              '[RqDepsIgnore]): ' + StringReplace(IgnoreText, '|', ', ',
                                                  [rfReplaceAll]));
    if Scan.MissingCount = 0 then
    begin
      LogComp(Format('Препроцессор: прочитано файлов %d, недостающих нет',
                     [Scan.ScannedFiles.Count]));
      Exit;
    end;
    for ItemIdx := 0 to Scan.Count - 1 do
    begin
      Dep := Scan[ItemIdx];
      if Dep.Missing then
        LogComp(Format('Нет файла (%s) %s - %s(%d)',
                       [RqDepKindNames[Dep.Kind], Dep.Name, Dep.FromFile,
                        Dep.FromLine]));
    end;

    IncRefDirs(SysDir, RefDir);
    RapidQIncSettings(FCurrentProject, CfgSys, UserDir, Mode, OwnDir);
    MainDir := ExcludeTrailingPathDelimiter(Scan.MainDir);
    // Сначала Include UnIde, потом Include User (папку -I смотреть незачем:
    // недостающих в ней нет); найденное в Include User окно проверит
    Roots.Add('Include UnIde|' + CfgSys);
    Roots.Add('Include User|' + UserDir);
    Roots.Add('папка программы|' + MainDir);
    Roots.Add('папка выше|' + ExtractFileDir(MainDir));
    // Свои папки - кнопка [...] в окне
    RqDepsAddUserRoots(Roots, SettingsFileName);

    // Просмотр текста в окне - с подсветкой схемой программы
    Scheme := SchemeCopyFor(ABas);
    try
      Result := RqDepsDialog(Self, Scan, Roots, RefDir, SysDir, CopyLog,
                             Ignore, Scheme, SettingsFileName,
                             SearchDirsDialog, StrictEditLine);
    finally
      Scheme.Free;
    end;
    for ItemIdx := 0 to CopyLog.Count - 1 do
      LogComp(CopyLog[ItemIdx]);
    if Result and (Ignore.Count > 0) then
    begin
      IgnoreText := '';
      for ItemIdx := 0 to Ignore.Count - 1 do
      begin
        if IgnoreText <> '' then
          IgnoreText := IgnoreText + '|';
        IgnoreText := IgnoreText + Ignore[ItemIdx];
      end;
      Ini := TIniFile.Create(SettingsFileName);
      try
        Ini.WriteString('RqDepsIgnore', BasKey, IgnoreText);
      finally
        Ini.Free;
      end;
    end;
  finally
    Ignore.Free;
    CopyLog.Free;
    Roots.Free;
    Scan.Free;
  end;
end;

// Окно Directory Tree как список папок поиска окна утилиты (недостающие
// файлы, строгая проверка). Справа - стандартные папки AFixed (всегда в
// списке, удалить нельзя, галку снять можно) и свои папки из AItems (см.
// SearchDirs: "U1|папка", "U0|папка", "F0|папка"); свои добавляются из
// дерева и удаляются. Ищется только отмеченное; вложенную в отмеченную
// папку отметить нельзя - её и так обойдут. Горячие папки не трогаются.
// OK - AItems заново.
function TForm1.SearchDirsDialog(const ACaption: string;
                                 AFixed, AItems: TStrings): Boolean;
var
  Dlg: TDlgHotFolders;
  ItemIdx, ListIdx: Integer;
begin
  Result := False;
  Dlg := TDlgHotFolders.Create(Self);
  try
    Dlg.Caption := ACaption;
    FHfPath := Dlg.edPath;
    FHfNote := Dlg.lblNote;
    FHfNote.Caption := '';
    FHfNoteMissing := False;
    FHfPath.OnChange := HfPathChange;
    FHfTree := Dlg.tvFolders;
    FHfList := Dlg.lstFolders;
    FHfSearchMode := True;
    Dlg.btnAdd.OnClick := HfAddClick;
    Dlg.btnDel.OnClick := HfDelClick;
    FHfTree.OnExpanding := HfTreeExpanding;
    FHfTree.OnChange := HfTreeChange;
    FHfTree.OnDblClick := HfTreeDblClick;
    FHfList.OnClick := HfListClick;
    HfListPrepare;
    FHfList.OnClickCheck := HfListCheck;
    HfFillDrives;

    // Стандартные - первыми, с галкой, если её не снимали
    for ItemIdx := 0 to AFixed.Count - 1 do
      if Trim(AFixed[ItemIdx]) <> '' then
      begin
        ListIdx := FHfList.Items.Add(ExcludeTrailingPathDelimiter(
                                       AFixed[ItemIdx]));
        FHfList.Checked[ListIdx] := SearchDirsFixedOn(AItems, AFixed[ItemIdx]);
      end;
    FHfFixedCount := FHfList.Items.Count;
    for ItemIdx := 0 to AItems.Count - 1 do
      if Copy(AItems[ItemIdx], 1, 1) = 'U' then
      begin
        ListIdx := FHfList.Items.Add(Copy(AItems[ItemIdx], 4, MaxInt));
        FHfList.Checked[ListIdx] := Copy(AItems[ItemIdx], 2, 1) = '1';
      end;
    HfSearchFixNested(-1);
    if FHfList.Items.Count > 0 then
    begin
      FHfList.ItemIndex := 0;
      HfSelectPath(FHfList.Items[0]);
      HfNote('Стандартные папки (первые ' + IntToStr(FHfFixedCount) +
             ') не удаляются - галку можно снять');
    end;

    if Dlg.ShowModal <> mrOk then
      Exit;
    HfSearchFixNested(-1);
    AItems.Clear;
    for ListIdx := 0 to FHfList.Items.Count - 1 do
      if ListIdx < FHfFixedCount then
      begin
        if not FHfList.Checked[ListIdx] then
          AItems.Add('F0|' + FHfList.Items[ListIdx]);
      end
      else if FHfList.Checked[ListIdx] then
        AItems.Add('U1|' + FHfList.Items[ListIdx])
      else
        AItems.Add('U0|' + FHfList.Items[ListIdx]);
    Result := True;
  finally
    FHfSearchMode := False;
    FHfFixedCount := 0;
    FHfTree := nil;
    FHfList := nil;
    FHfPath := nil;
    FHfNote := nil;
    Dlg.Free;
  end;
end;

// Папки поиска: отмеченная внутри другой отмеченной - галка снимается
// (подпапки и так обходятся). AChanged - строка, у которой только что
// поставили галку: если она внутри отмеченной - снимается её галка, если
// она объемлет отмеченные - снимаются их. -1 - проверить весь список.
procedure TForm1.HfSearchFixNested(AChanged: Integer);
var
  OuterIdx, InnerIdx: Integer;
  Note: string;
begin
  if (FHfList = nil) or not FHfSearchMode then
    Exit;
  Note := '';
  if (AChanged >= 0) and FHfList.Checked[AChanged] then
  begin
    for OuterIdx := 0 to FHfList.Items.Count - 1 do
      if (OuterIdx <> AChanged) and FHfList.Checked[OuterIdx] and
         SearchDirInside(FHfList.Items[AChanged], FHfList.Items[OuterIdx]) then
      begin
        FHfList.Checked[AChanged] := False;
        Note := '  Не отмечена: она внутри ' + FHfList.Items[OuterIdx] +
                ' - её подпапки и так ищутся';
        FHfRedDir := FHfList.Items[OuterIdx];
        FHfList.Invalidate;
        Break;
      end;
    if FHfList.Checked[AChanged] then
      for InnerIdx := 0 to FHfList.Items.Count - 1 do
        if (InnerIdx <> AChanged) and FHfList.Checked[InnerIdx] and
           SearchDirInside(FHfList.Items[InnerIdx], FHfList.Items[AChanged]) then
        begin
          FHfList.Checked[InnerIdx] := False;
          Note := '  Сняты галки вложенных папок: они внутри ' +
                  FHfList.Items[AChanged];
        end;
  end
  else
    // Весь список: по порядку, первая отмеченная остаётся
    for InnerIdx := 0 to FHfList.Items.Count - 1 do
      if FHfList.Checked[InnerIdx] then
        for OuterIdx := 0 to FHfList.Items.Count - 1 do
          if (OuterIdx <> InnerIdx) and FHfList.Checked[OuterIdx] and
             SearchDirInside(FHfList.Items[InnerIdx], FHfList.Items[OuterIdx]) then
          begin
            FHfList.Checked[InnerIdx] := False;
            Break;
          end;
  if Note <> '' then
    HfNote(Trim(Note));
end;

// Меню Started Util: все видимые окна программы, кроме главного, - окна
// утилит (недостающие файлы, строгая проверка, Find In Files, INC Manager,
// окна отладчика ...). Немодальное окно может уйти под главное; пункт
// поднимает его. Перестраивается по простою, только когда набор окон или
// их заголовки сменились.
// Не настроен компилятор (папка не задана, exe не найден): в лог сборки и
// окном - иначе сообщение легко пропустить среди строк лога. Снимок
// RapidQ (повторные сборки копии) окном не прерывается.
procedure TForm1.SettingsAlert(const AText: string);
begin
  LogComp(AText);
  if FRqProbeActive then
    Exit;
  MessageDlg(AText, mtWarning, [mbOK], 0);
end;

// Короткое имя окна утилиты для плашки: до " - " / ":", не длиннее 18
function UtilShortName(const ACaption: string): string;
var
  CutAt: Integer;
begin
  Result := Trim(ACaption);
  CutAt := Pos(' - ', Result);
  if CutAt > 1 then
    Result := Copy(Result, 1, CutAt - 1);
  CutAt := Pos(':', Result);
  if CutAt > 1 then
    Result := Copy(Result, 1, CutAt - 1);
  if Length(Result) > 18 then
    Result := Copy(Result, 1, 17) + '.';
end;

// Плашки - правее последнего пункта строки меню, по ширине текста
procedure TForm1.UtilChipsPlace;
var
  ChipIdx, NextLeft, ChipWidth: Integer;
  Chip: TPanel;
begin
  if (FUtilChips = nil) or (FMenuBar = nil) then
    Exit;
  if FMenuBar.TopCount > 0 then
    NextLeft := FMenuBar.TopRect(FMenuBar.TopCount - 1).Right + 12
  else
    NextLeft := 8;
  for ChipIdx := 0 to FUtilChips.Count - 1 do
  begin
    Chip := TPanel(FUtilChips[ChipIdx]);
    // Canvas строки меню защищённый - меряем канвой окна
    Canvas.Font := Chip.Font;
    ChipWidth := Canvas.TextWidth(Chip.Caption) + 16;
    if (Chip.Left <> NextLeft) or (Chip.Width <> ChipWidth) or
       (Chip.Height <> FMenuBar.Height - 4) then
      Chip.SetBounds(NextLeft, 2, ChipWidth, FMenuBar.Height - 4);
    Inc(NextLeft, ChipWidth + 6);
  end;
end;

// Цвета плашки: окно развёрнуто - яркая, свёрнуто - серая
const
  UtilChipShownColor = $0000C8FF;
  UtilChipHiddenColor = $00A0A0A0;

// Окно программы по указателю из Tag пункта или плашки; nil - его уже нет
// (закрылось после постройки меню). Указатель только сравнивается со
// списком окон, сам не разыменовывается
function TForm1.UtilFormOf(ATag: Integer): TCustomForm;
var
  FormIdx: Integer;
begin
  Result := nil;
  for FormIdx := 0 to Screen.CustomFormCount - 1 do
    if Integer(Screen.CustomForms[FormIdx]) = ATag then
    begin
      Result := Screen.CustomForms[FormIdx];
      Exit;
    end;
end;

// Окно - на экран и наверх: свёрнутое - развернуть
procedure TForm1.UtilShowForm(AForm: TCustomForm);
begin
  if not AForm.Visible then
    Exit;
  if AForm.WindowState = wsMinimized then
    AForm.WindowState := wsNormal;
  AForm.BringToFront;
  if AForm.CanFocus then
    AForm.SetFocus;
end;

// Цвет и подсказка плашек - по тому, свёрнуто ли окно
procedure TForm1.UtilChipsPaint;
var
  ChipIdx: Integer;
  Chip: TPanel;
  OneForm: TCustomForm;
begin
  if FUtilChips = nil then
    Exit;
  for ChipIdx := 0 to FUtilChips.Count - 1 do
  begin
    Chip := TPanel(FUtilChips[ChipIdx]);
    OneForm := UtilFormOf(Chip.Tag);
    if OneForm = nil then
      Continue;
    if OneForm.WindowState <> wsMinimized then
    begin
      if Chip.Color <> UtilChipShownColor then
        Chip.Color := UtilChipShownColor;
      Chip.Hint := OneForm.Caption + ' - щелчок сворачивает окно';
    end
    else
    begin
      if Chip.Color <> UtilChipHiddenColor then
        Chip.Color := UtilChipHiddenColor;
      Chip.Hint := OneForm.Caption + ' - окно свёрнуто, щелчок разворачивает';
    end;
  end;
end;

procedure TForm1.UtilMenuUpdate;
var
  FormIdx: Integer;
  OneForm: TCustomForm;
  Sig: string;
  Item: TMenuItem;
  Chip: TPanel;
  Listed: TList;
begin
  if FUtilMenu = nil then
    Exit;

  Listed := TList.Create;
  try
    Sig := '';
    for FormIdx := 0 to Screen.CustomFormCount - 1 do
    begin
      OneForm := Screen.CustomForms[FormIdx];
      if (OneForm = Self) or not OneForm.Visible or (OneForm.Caption = '') then
        Continue;
      Listed.Add(OneForm);
      // Свёрнуто ли окно, в подпись не входит: плашка при щелчке не
      // пересоздаётся, только перекрашивается (UtilChipsPaint)
      Sig := Sig + IntToHex(Integer(OneForm), 8) + OneForm.Caption + #1;
    end;
    if Sig = FUtilSig then
    begin
      // Набор тот же; строка меню могла сменить шрифт или высоту, окно -
      // свернуться или развернуться
      UtilChipsPaint;
      UtilChipsPlace;
      Exit;
    end;
    FUtilSig := Sig;
    FUtilMenu.Clear;
    for FormIdx := 0 to Listed.Count - 1 do
    begin
      OneForm := TCustomForm(Listed[FormIdx]);
      Item := TMenuItem.Create(FUtilMenu);
      Item.Caption := StringReplace(OneForm.Caption, '&', '&&', [rfReplaceAll]);
      Item.Tag := Integer(OneForm);
      Item.OnClick := UtilMenuClick;
      FUtilMenu.Add(Item);
    end;
    // Плашки в строке меню - заново, по тем же окнам
    if FUtilChips = nil then
      FUtilChips := TList.Create;
    for FormIdx := 0 to FUtilChips.Count - 1 do
      TObject(FUtilChips[FormIdx]).Free;
    FUtilChips.Clear;
    if FMenuBar <> nil then
      for FormIdx := 0 to Listed.Count - 1 do
      begin
        OneForm := TCustomForm(Listed[FormIdx]);
        Chip := TPanel.Create(Self);
        Chip.Parent := FMenuBar;
        Chip.BevelOuter := bvNone;
        Chip.ParentBackground := False;
        // Яркая: открытое окно утилиты должно быть видно сразу. Цвет
        // текста - не clBlack: его тема заменяет своим (UiThemeFgSys).
        // Цвет фона и подсказка - UtilChipsPaint
        Chip.Color := UtilChipShownColor;
        Chip.ParentFont := False;
        Chip.Font.Name := 'Tahoma';
        Chip.Font.Height := -11;
        Chip.Font.Style := [fsBold];
        Chip.Font.Color := TColor($00101010);
        Chip.Caption := UtilShortName(OneForm.Caption);
        Chip.ShowHint := True;
        Chip.Cursor := crHandPoint;
        Chip.Tag := Integer(OneForm);
        Chip.OnClick := UtilChipClick;
        FUtilChips.Add(Chip);
      end;
    UtilChipsPaint;
    UtilChipsPlace;
  finally
    Listed.Free;
  end;

  // Пустое меню строка меню не раскрывает - пункт-пояснение
  if FUtilMenu.Count = 0 then
  begin
    Item := TMenuItem.Create(FUtilMenu);
    Item.Caption := '(открытых окон утилит нет)';
    Item.Enabled := False;
    FUtilMenu.Add(Item);
  end;
  if FMenuBar <> nil then
    FMenuBar.Invalidate;
end;

// Пункт Started Util: окно - наверх (свёрнутое - развернуть)
procedure TForm1.UtilMenuClick(Sender: TObject);
var
  OneForm: TCustomForm;
begin
  OneForm := UtilFormOf(TComponent(Sender).Tag);
  if OneForm = nil then
    Exit;
  UtilShowForm(OneForm);
  UtilChipsPaint;
end;

// Плашка окна в строке меню: окно развёрнуто - свернуть (плашка серая),
// свёрнуто - развернуть и наверх (плашка снова яркая).
//
// Сворачивание, а не Hide: свёрнутое окно для программы остаётся видимым
// (Visible = True), и конструктор форм работает с ним так же, как с
// развёрнутым. Спрятанная через Hide форма конструктора при щелчке по
// вкладке .dfm показывалась кусками.
//
// Плашка здесь только перекрашивается: пересоздать её из её же OnClick
// нельзя
procedure TForm1.UtilChipClick(Sender: TObject);
var
  OneForm: TCustomForm;
begin
  OneForm := UtilFormOf(TComponent(Sender).Tag);
  if OneForm = nil then
    Exit;
  if OneForm.WindowState = wsMinimized then
    UtilShowForm(OneForm)
  else
    OneForm.WindowState := wsMinimized;
  UtilChipsPaint;
end;

// Имя из сообщения rc.exe "$INCLUDE file X does not exist"; '' - такого нет
function RqMissingInclude(ALines: TStrings): string;
const
  Head = '$INCLUDE FILE ';
  Tail = ' DOES NOT EXIST';
var
  LineIdx, HeadPos, TailPos: Integer;
  Up: string;
begin
  Result := '';
  for LineIdx := 0 to ALines.Count - 1 do
  begin
    Up := UpperCase(ALines[LineIdx]);
    HeadPos := Pos(Head, Up);
    TailPos := Pos(Tail, Up);
    if (HeadPos > 0) and (TailPos > HeadPos) then
    begin
      Result := Trim(Copy(ALines[LineIdx], HeadPos + Length(Head),
                          TailPos - HeadPos - Length(Head)));
      if (Result <> '') and (Result[1] in ['"', '<']) then
        Result := Copy(Result, 2, Length(Result) - 2);
      Exit;
    end;
  end;
end;

// Файл из INC Manager - во вкладку; ALine (с 1) - строка, 0 - без перехода
procedure TForm1.IncMgrOpenFile(const AFile: string; ALine: Integer);
