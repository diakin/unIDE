// Пункт меню Search folders... - тот же список, но без подсказанной папки
procedure TForm1.HotFoldersClick(Sender: TObject);
begin
  ShowHotFolders('');
end;

// Раскрывает дерево до нужной папки и выделяет её.
//
// Заглушки в узлах приходится дочитывать вручную: Expand поднимет OnExpanding
// только для узла, который УЖЕ виден, а мы идём вглубь по ещё не открытым.
procedure TForm1.HfSelectPath(const APath: string);
var
  Parts: TStringList;
  Node, Child: TTreeNode;
  I, K: Integer;
  S: string;
begin
  if (FHfTree = nil) or (APath = '') then
    Exit;

  Parts := TStringList.Create;
  try
    S := APath;
    while S <> '' do
    begin
      K := Pos('\', S);
      if K = 0 then
      begin
        Parts.Add(S);
        Break;
      end;
      if K > 1 then
        Parts.Add(Copy(S, 1, K - 1));
      S := Copy(S, K + 1, Length(S));
    end;

    if Parts.Count = 0 then
      Exit;

    // Корневой узел - буква диска, записана как 'D:'
    Node := nil;
    for I := 0 to FHfTree.Items.Count - 1 do
      if (FHfTree.Items[I].Parent = nil) and
         (CompareText(FHfTree.Items[I].Text, Parts[0]) = 0) then
      begin
        Node := FHfTree.Items[I];
        Break;
      end;

    if Node = nil then
      Exit;

    for I := 1 to Parts.Count - 1 do
    begin
      if (Node.Count = 1) and (Node.Item[0].Text = '') then
        HfFillNode(Node);
      Node.Expand(False);

      Child := Node.getFirstChild;
      while Child <> nil do
      begin
        if CompareText(Child.Text, Parts[I]) = 0 then
          Break;
        Child := Child.getNextSibling;
      end;

      if Child = nil then
        Break; // такой подпапки нет - показываем то, до чего дошли
      Node := Child;
    end;

    if (Node.Count = 1) and (Node.Item[0].Text = '') then
      HfFillNode(Node);
    Node.Expand(False);
    Node.MakeVisible;
    Node.Selected := True;
  finally
    Parts.Free;
  end;
end;

// Папка на уровень выше программы.
//
// Именно туда чаще всего и переезжает дерево проекта: exe сидит в подпапке,
// а рядом с ней лежат остальные каталоги. Для корня диска родителя нет -
// в этом случае возвращаем пустую строку.
function TForm1.ParentOfExeDir: string;
var
  S: string;
begin
  S := ExcludeTrailingPathDelimiter(ExtractFilePath(Application.ExeName));
  Result := ExtractFilePath(S);
  if Length(Result) < 3 then
    Result := ''; // выше корня диска подниматься некуда
end;

// Папка, которую диалоги должны предлагать по умолчанию.
//
// Порядок: папка текущего файла, потом папка открытого проекта, потом папка
// программы. Пустую строку не возвращаем никогда: при пустом InitialDir
// Windows подставит ТЕКУЩИЙ каталог процесса, а он к этому моменту может
// указывать куда угодно - см. ofNoChangeDir в FormCreate.
function TForm1.SuggestDir: string;
begin
  Result := '';

  if FCurrentFileName <> '' then
    Result := ExtractFilePath(FCurrentFileName);

  // У нового файла пути ещё нет - показываем папку проекта
  if (Result = '') or not DirectoryExists(Result) then
    if FCurrentProject <> '' then
      Result := ProjectDir(FCurrentProject);

  if (Result = '') or not DirectoryExists(Result) then
    Result := ExtractFilePath(Application.ExeName);

  Result := ExcludeTrailingPathDelimiter(Result);
end;

// Спрашивает про КАЖДУЮ находку и возвращает путь, по которому файл брать.
// Пустая строка - пользователь отказался.
//
// Поиск по имени вполне может наткнуться не на тот файл: рядом с рабочей
// папкой обычно лежат её резервные копии, и Unit1.pas найдётся в каждой.
// Поэтому решение остаётся за человеком - он видит оба пути целиком.
//
// Если прежняя папка на месте, файл КОПИРУЕТСЯ обратно в неё. Так находка
// из бэкапа возвращается в работу, а путь в .prj остаётся верным и править
// его не придётся.
function TForm1.ConfirmRelocate(const AOld, ANew: string): string;
var
  Dir, Msg: string;
  CanCopy: Boolean;
  Res: Integer;
begin
  Result := '';

  Dir := ExtractFilePath(AOld);
  CanCopy := (Dir <> '') and DirectoryExists(Dir) and not FRelocateFromInc;

  if not FRelocateAll then
  begin
    if FRelocateFromInc then
      Msg := 'Файл не найден:'#13#10 + AOld + #13#10#13#10 +
      'Есть в папке Include (общая папка inc):'#13#10 + ANew + #13#10#13#10 +
      'Открыть его оттуда? На прежнее место он не копируется.'
    else
    begin
    Msg := 'Файл не найден:'#13#10 + AOld + #13#10#13#10 +
    'Найдена копия:'#13#10 + ANew + #13#10#13#10;

if CanCopy then
      Msg := Msg + 'Скопировать её на прежнее место и открыть оттуда?'
    else
      Msg := Msg + 'Прежней папки больше нет.'#13#10 +
      'Открыть файл прямо по найденному пути?';
    end;

Res := MessageDlg('7588:' + Msg, mtConfirmation, [mbYes, mbNo, mbYesToAll], 0);

    if Res = mrYesToAll then
      FRelocateAll := True   // дальше не спрашиваем до конца этого прогона
    else if Res <> mrYes then
      Exit;                  // отказ: окно останется помеченным как потерянное
  end;

  if CanCopy then
  begin
    // False = перезаписывать разрешено, но перезаписывать тут нечего:
    // мы здесь как раз потому, что файла по прежнему пути нет
    if Windows.CopyFile(PChar(ANew), PChar(AOld), False) then
    begin
      Result := AOld;
      Exit;
    end;

    ShowMessage('7606:Не удалось скопировать файл:'#13#10 + ANew + #13#10 +
    'в'#13#10 + AOld + #13#10#13#10 +
    'Файл будет открыт по найденному пути.');
  end;

  Result := ANew;
end;

// Отмеченные галочкой и реально существующие папки. Результат освобождает
// вызывающий.
function TForm1.CheckedHotFolders: TStringList;
var
  I: Integer;
begin
  Result := TStringList.Create;
  if FHotFolders = nil then
    Exit;

  for I := 0 to FHotFolders.Count - 1 do
    if (FHotFolders.Objects[I] <> nil) and DirectoryExists(FHotFolders[I]) then
      Result.Add(IncludeTrailingPathDelimiter(FHotFolders[I]));
end;

// Рекурсивный обход папки в поисках файла по имени.
//
// AParentName задаёт дополнительное требование: имя папки, в которой файл
// должен лежать. С ним находка гораздо надёжнее - Unit1.pas в дереве может
// быть десяток, а вот Unit1.pas внутри папки SyntaxHLClaude, скорее всего,
// один. Пустое значение снимает требование.
function TForm1.FindFileInTree(const ADir, AName, AParentName: string;
                               Depth: Integer): string;
var
  SR: TSearchRec;
  Base, Own: string;
begin
  Result := '';
  if (AName = '') or (Depth < 0) then
    Exit;
  // Время на обход вышло - дальше не ищем (см. FRelocateDeadline)
  if (FRelocateDeadline <> 0) and
     (Longint(GetTickCount - FRelocateDeadline) > 0) then
  begin
    FRelocateCut := True;
    Exit;
  end;

  Base := IncludeTrailingPathDelimiter(ADir);

  if FileExists(Base + AName) then
  begin
    Own := ExtractFileName(ExcludeTrailingPathDelimiter(Base));
    if (AParentName = '') or (CompareText(Own, AParentName) = 0) then
    begin
      Result := Base + AName;
      Exit;
    end;
  end;

  if Depth = 0 then
    Exit;

  if FindFirst(Base + '*.*', faDirectory, SR) = 0 then
  try
    repeat
      if ((SR.Attr and faDirectory) = 0) or
         (SR.Name = '.') or (SR.Name = '..') then
        Continue;

      Result := FindFileInTree(Base + SR.Name, AName, AParentName, Depth - 1);
      if Result <> '' then
        Exit;
    until FindNext(SR) <> 0;
  finally
    FindClose(SR);
  end;
end;

// Ищет переехавший файл, приставляя хвост его пути к папке программы.
//
// Проект мог быть собран на другой машине: в .prj лежит
//     D:\_F\balan\_SyntaxHLClaude\SyntaxHLClaude\Unit1.pas
// а то же дерево теперь по
//     D:\308\disk_C\0diakin2_0\_SyntaxHLClaude\SyntaxHLClaude\
// Общего у двух путей только ХВОСТ, поэтому пробуем ExeDir + хвост, начиная
// с самого длинного и укорачивая до одного имени файла.
//
// Длинный хвост ПЕРВЫМ, а не наоборот. При обратном порядке путь
// ...\SyntaxHLClaude7Good\Unit1.pas нашёл бы Unit1.pas прямо в папке
// программы - файл с тем же именем, но не тот. Возвращает '', если не нашли.
function TForm1.RelocateInBase(const AFile, ABase: string): string;
var
  Parts: TStringList;
  Base, Tail, Cand: string;
  I, K, Sep: Integer;
begin
  Result := '';
  if (AFile = '') or (ABase = '') then
    Exit;

  Base := IncludeTrailingPathDelimiter(ABase);

  Parts := TStringList.Create;
  try
    // Режем путь на составляющие, справа налево
    Tail := AFile;
    while Tail <> '' do
    begin
      Sep := LastDelimiter('\/', Tail);
      if Sep = 0 then
      begin
        Parts.Insert(0, Tail);
        Break;
      end;
      Parts.Insert(0, Copy(Tail, Sep + 1, Length(Tail) - Sep));
      Tail := Copy(Tail, 1, Sep - 1);
    end;

    // Буква диска и пустые куски в хвост не годятся
    for I := Parts.Count - 1 downto 0 do
      if (Trim(Parts[I]) = '') or (Pos(':', Parts[I]) > 0) then
        Parts.Delete(I);

    if Parts.Count = 0 then
      Exit;

    for K := Parts.Count downto 1 do
    begin
      Tail := '';
      for I := Parts.Count - K to Parts.Count - 1 do
        if Tail = '' then
          Tail := Parts[I]
        else
          Tail := Tail + '\' + Parts[I];

      Cand := Base + Tail;
      if FileExists(Cand) then
      begin
        Result := Cand;
        Exit;
      end;
    end;
  finally
    Parts.Free;
  end;
end;

// Потерянный .inc / .cmp с тем же именем в папке Include UnIde, потом в
// Include User (IDE Options - Compilers - RapidQ Basic). '' - нет.
function TForm1.RelocateIncStandard(const AFile: string): string;
var
  Ext, SysDir, UserDir, Mode, OwnDir, Cand: string;
  DirIdx: Integer;
begin
  Result := '';
  Ext := LowerCase(ExtractFileExt(AFile));
  if (Ext <> '.inc') and (Ext <> '.cmp') then
    Exit;
  RapidQIncSettings('', SysDir, UserDir, Mode, OwnDir);
  for DirIdx := 0 to 1 do
  begin
    // Include UnIde, потом Include User
    if DirIdx = 0 then
      Cand := SysDir
    else
      Cand := UserDir;
    if (Cand = '') or not DirectoryExists(Cand) then
      Continue;
    Cand := IncludeTrailingPathDelimiter(Cand) + ExtractFileName(AFile);
    if FileExists(Cand) and
       (CompareText(ExpandFileName(Cand), ExpandFileName(AFile)) <> 0) then
    begin
      Result := Cand;
      Exit;
    end;
  end;
end;

// Полный поиск потерянного файла: сначала рядом с программой, потом в папке
// уровнем выше, и только в самом конце - по отмеченным горячим папкам.
//
// У ЛЮБОЙ находки имя папки должно совпадать с именем папки, где файл лежал
// раньше. Без этой проверки RelocateInBase на последнем шаге приставляет к
// базе один голый файл, и D:\...\test5444455\Unit1.pas "находился" как
// Unit1.pas в папке программы - совершенно другой файл с тем же именем.
// Совпадение по папке пропускает то, что нужно: переехавшее дерево целиком
// (папка та же, изменился путь до неё) и копию из бэкапа (projects\x.prj
// лежит в projects и там, и там).
function TForm1.RelocateFile(const AFile: string): string;
var
  Hot: TStringList;
  Parent, Up: string;
  I: Integer;

  // Годится ли кандидат: непустой и лежит в папке с тем же именем
  function Accept(const ACand: string): Boolean;
  begin
    Result := (ACand <> '') and
              (CompareText(ExtractFileName(ExcludeTrailingPathDelimiter(
      ExtractFilePath(ACand))), Parent) = 0);
  end;

begin
  Result := '';
  FRelocateFromInc := False;
  if AFile = '' then
    Exit;

  // inc RapidQ - сначала в папке Include (RQInc): там старые inc под
  // своими именами, а файлы из inc_sys и incOld переехали туда или
  // переименованы (debug.inc -> debug_sys.inc)
  Result := RelocateIncStandard(AFile);
  if Result <> '' then
  begin
    FRelocateFromInc := True;
    Exit;
  end;

  // Имя папки, в которой файл лежал раньше
  Parent := ExtractFileName(
    ExcludeTrailingPathDelimiter(ExtractFilePath(AFile)));

  // Папки в пути нет - сверять не с чем, и ловить одноимённые файлы по всему
  // диску мы не станем
  if Parent = '' then
    Exit;

  Result := RelocateInBase(AFile, ExtractFilePath(Application.ExeName));
  if Accept(Result) then
    Exit;

  // Папка НА УРОВЕНЬ ВЫШЕ программы. Дерево проекта обычно переезжает
  // целиком, exe сидит в одной из его подпапок - значит потерянный файл
  // почти наверняка где-то рядом, в соседней ветке.
  Up := ParentOfExeDir;
  if Up <> '' then
  begin
    Result := RelocateInBase(AFile, Up);
    if Accept(Result) then
      Exit;

    // Обход дерева - не дольше RelocateSearchMs: программу могли положить
    // в папку, над которой лежит весь диск (hang.log: 150 с при запуске).
    // При загрузке проекта запас общий на все потерянные файлы.
    if FRelocateUpEnd <> 0 then
      FRelocateDeadline := FRelocateUpEnd
    else
      FRelocateDeadline := GetTickCount + RelocateSearchMs;
    FRelocateCut := False;
    try
      Result := FindFileInTree(Up, ExtractFileName(AFile), Parent,
                               HotSearchDepth);
    finally
      FRelocateDeadline := 0;
    end;
    if FRelocateCut then
      Dbg('8781: ' + ExtractFileName(AFile) + ': поиск в ' + Up +
      ' остановлен по времени (' + IntToStr(RelocateSearchMs) +
      ' мс) - дерево слишком большое. Не найден: ' + AFile, clRed);
          if Accept(Result) then
          Exit;
  end;

  Hot := CheckedHotFolders;
  try
    for I := 0 to Hot.Count - 1 do
    begin
      Result := RelocateInBase(AFile, Hot[I]);
      if Accept(Result) then
        Exit;
    end;

    // Хвост нигде не совпал - ищем по одному имени файла внутри самих
    // горячих папок. Здесь имя прежней папки уже НЕ проверяется: папку
    // назвал сам пользователь, и файл мог переехать в её подпапку с
    // другим именем - ровно это и предлагает сделать сообщение о
    // ненайденных файлах. Для автоматического поиска рядом с программой
    // проверка остаётся: там легко подхватить чужой одноимённый файл.
    for I := 0 to Hot.Count - 1 do
    begin
      Result := FindFileInTree(Hot[I], ExtractFileName(AFile), '',
                               HotSearchDepth);
      if Result <> '' then
        Exit;
    end;
  finally
    Hot.Free;
  end;

  // Ничего подходящего: окно останется в списке с красным крестиком
  Result := '';
end;

// Путь как есть, если файл на месте; иначе - найденный рядом с программой.
// Если не нашли и там, возвращаем исходный: вызывающий сам решит, что делать.
function TForm1.ResolveFileName(const AFile: string): string;
var
  Found: string;
begin
  Result := AFile;
  if (AFile = '') or FileExists(AFile) then
    Exit;

  Found := RelocateFile(AFile);
  if Found = '' then
    Exit;

  // Находку показываем пользователю: она могла прийти из резервной копии
  Found := ConfirmRelocate(AFile, Found);
  if Found <> '' then
    Result := Found;
end;

// Отрезает у двух путей общий хвост - остаются те папки, которыми они
// различаются. Именно их и показываем в сообщении: полные пути к файлу читать
// неудобно, а разница между деревьями видна сразу.
procedure TForm1.SplitCommonTail(const AOld, ANew: string;
                                 var HeadOld, HeadNew: string);
var
  I, J, K: Integer;
begin
  HeadOld := AOld;
  HeadNew := ANew;

  // Идём с конца, пока символы совпадают. Регистр не учитываем: у путей он
  // ничего не значит.
  I := Length(AOld);
  J := Length(ANew);
  while (I > 0) and (J > 0) and
        (AnsiUpperCase(AOld[I]) = AnsiUpperCase(ANew[J])) do
  begin
    Dec(I);
    Dec(J);
  end;

  // Совпадение могло оборваться посреди имени папки - доводим границу до
  // ближайшего разделителя, иначе в сообщении окажется огрызок имени
  K := I + 1;
  while (K <= Length(AOld)) and not (AOld[K] in ['\', '/']) do
    Inc(K);

  if K > Length(AOld) then
    Exit; // общего хвоста по границам папок нет - показываем пути целиком

  HeadOld := Copy(AOld, 1, K);
  HeadNew := Copy(ANew, 1, J + (K - I));
end;

// Сообщает, что дерево файлов переехало, и предлагает записать новые пути
// в .prj. Без этого они живут только в памяти до конца сеанса.
procedure TForm1.AskSaveRelocated(const AProject, AOld, ANew: string;
                                  ACount: Integer);
var
  HeadOld, HeadNew: string;
begin
  if (AProject = '') or (ACount <= 0) then
    Exit;

  SplitCommonTail(AOld, ANew, HeadOld, HeadNew);

  // Один файл - про "папку проекта" говорить рано: скорее всего его просто
  // взяли из соседнего каталога. Показываем сам файл.
  if ACount = 1 then
  begin
    if MessageDlg('7903:Файл теперь открыт по другому пути:'#13#10#13#10 +
    'был  ' + AOld + #13#10 +
    'стал ' + ANew + #13#10#13#10 +
    'Записать новый путь в файл проекта?',
                  mtConfirmation, [mbYes, mbNo], 0) = mrYes then
      SaveProjectTo(AProject);
    Exit;
  end;

  if MessageDlg('7912:Папка проекта изменилась:'#13#10#13#10 +
  'со  ' + HeadOld + #13#10 +
  'на  ' + HeadNew + #13#10#13#10 +
                Format('Файлов найдено по новому пути: %d.', [ACount]) + #13#10 +
  'Сохранить файл проекта с новыми путями?',
                mtConfirmation, [mbYes, mbNo], 0) = mrYes then
    SaveProjectTo(AProject);
end;

// Пункт Windows -> Check wrong file names.
//
// Проходит по занятым слотам и сверяет пути с диском. Флаг Broken при этом
// не только ставится, но и СНИМАЕТСЯ: файл мог вернуться на место, пока
// программа работала.
procedure TForm1.CheckWrongNamesClick(Sender: TObject);
var
  I, N: Integer;
  SL: TStringList;
begin
  SL := TStringList.Create;
  try
    N := 0;
    for I := 0 to WindowsItemCount - 1 do
    begin
      if not FWindows[I].Used then
        Continue;

      // Новый файл ещё не сохранён - у него нет пути, и терять нечего
      if IsUntitledName(FWindows[I].FileName) then
        Continue;

      if FileExists(FWindows[I].FileName) then
      begin
        FWindows[I].Broken := False;
        Continue;
      end;

      FWindows[I].Broken := True;
      Inc(N);
      SL.Add(Format('%d  %s', [I + 1, FWindows[I].FileName]));
    end;

    RebuildWindowsMenu;

    if N = 0 then
      ShowMessage('7957:Все файлы на месте.')
    else
      ShowMessage(Format('7959:Не найдено файлов: %d', [N]) + #13#10#13#10 +
                  SL.Text + #13#10 +
      'В меню Windows они помечены красным крестиком.');
  finally
    SL.Free;
  end;
end;

// Сколько окон сейчас помечено как потерянные
function TForm1.BrokenWindowsCount: Integer;
var
  I: Integer;
begin
  Result := 0;
  for I := 0 to WindowsItemCount - 1 do
    if FWindows[I].Used and FWindows[I].Broken then
      Inc(Result);
end;

// Одна попытка найти все потерянные файлы. Возвращает, сколько нашлось.
//
// Сообщений об ИТОГЕ сама не показывает - их формирует вызывающий, потому что
// попыток может быть две: до и после того, как пользователь указал папки.
// Пути в записях окон переписываются, так что следующий Save Prj положит
// в .prj уже актуальные.
function TForm1.RelocateBrokenWindows: Integer;
var
  I, Cur, Found, Changed: Integer;
  NewName, OldSample, NewSample: string;
  CurFixed: Boolean;
begin
  Found := 0;
  Changed := 0;
  CurFixed := False;
  OldSample := '';
  NewSample := '';

  // "Да для всех" действует только на этот прогон
  FRelocateAll := False;

  for I := 0 to WindowsItemCount - 1 do
  begin
    if (not FWindows[I].Used) or (not FWindows[I].Broken) then
      Continue;

    NewName := RelocateFile(FWindows[I].FileName);
    if NewName = '' then
      Continue;

    // Спрашиваем про каждый файл отдельно: находка могла прийти из копии
    NewName := ConfirmRelocate(FWindows[I].FileName, NewName);
    if NewName = '' then
      Continue; // отказались - окно так и остаётся потерянным

    // Путь МЕНЯЕТСЯ только если скопировать на прежнее место не вышло.
    // Когда копия легла обратно, в .prj править нечего.
    if CompareText(NewName, FWindows[I].FileName) <> 0 then
    begin
      Inc(Changed);
      if OldSample = '' then
      begin
        OldSample := FWindows[I].FileName;
        NewSample := NewName;
      end;
    end;

    FWindows[I].FileName := NewName;
    FWindows[I].Text := LoadTextFile(NewName);
    FWindows[I].IsUtf8 := FFileIsUtf8;
    FWindows[I].HasBom := FFileHasBom;
    FWindows[I].Broken := False;
    FWindows[I].MapValid := False;
    Inc(Found);

    if I = FWindowsIndex then
      CurFixed := True;
  end;

  Result := Found;
  if Found = 0 then
    Exit;

  RebuildWindowsMenu;
  RefreshAllTabCaptions;

  // Текущее окно было пустым - показываем только что прочитанный текст.
  // Индекс временно сбрасываем, иначе StoreCurrentWindow внутри ActivateWindow
  // затрёт его содержимым редактора, то есть пустотой.
  if CurFixed then
  begin
    Cur := FWindowsIndex;
    FWindowsIndex := -1;
    ActivateWindow(Cur);
  end;

  AskSaveRelocated(FCurrentProject, OldSample, NewSample, Changed);
end;

// Пункт Windows -> Find lost files...
//
// Сначала пробуем найти молча - рядом с программой и в уже отмеченных папках.
// Не вышло - сразу открываем список папок: спрашивать "поискать ли ещё?"
// незачем, ответ и так очевиден. После закрытия окна пробуем повторно.
procedure TForm1.TryFindDisabledClick(Sender: TObject);
var
  Found: Integer;
begin
  if BrokenWindowsCount = 0 then
  begin
    ShowMessage('8068:Потерянных файлов нет - все открытые файлы на месте.');
    Exit;
  end;

  if RelocateBrokenWindows > 0 then
    Exit; // нашлись сразу, окно папок не понадобилось

  // Папку над программой уже обошли и там пусто - открываем список папок,
  // подставив её же: пользователю останется добавить соседний каталог
  ShowHotFolders(ParentOfExeDir);

  Found := RelocateBrokenWindows;
  if Found = 0 then
    ShowMessage('8081:Потерянные файлы найти не удалось.' + #13#10#13#10 +
    'Добавьте в список папку, внутри которой они лежат,' + #13#10 +
    'и повторите поиск.');
end;

// Открывает проект: читает .prj и поднимает все перечисленные в нём окна
procedure TForm1.LoadProject(const AName: string);
var
  Ini: TProjectIni;
  PrjDir: string;
  I, J, CurIdx, TabCnt, TabWin, Relocated: Integer;
  Raw, Path, Src, Key, OldSample, NewSample: string;
  HotRecent, HotItem: string;
  HotSep, HotWin, HotBm: Integer;
  StartTick, StageTick, TClose, TFiles, TShow, FileCount: Cardinal;
  ActIdx: Integer;      // активная вкладка - для этапа в startup.log
begin
  StartTick := GetTickCount;
  TClose := 0;
  TFiles := 0;
  TShow := 0;
  FileCount := 0;
  if not ProjectExists(AName) then
  begin
    ShowMessage('8095:Проекта нет в списке проектов: ' + AName);
    Exit;
  end;

  if not ConfirmSaveAll then
    Exit;

  // Снимки живых значений - от прежнего проекта; у нового классы форм
  // могут совпадать по имени (TForm1), и чужой снимок лёг бы не туда.
  // Там же - конструктор форм и логи прежнего проекта.
  if CompareText(AName, FCurrentProject) <> 0 then
  begin
    SnapReset;
    ProjectSwitchReset;
  end;

  StageTick := GetTickCount;
  CloseAllWindows;
  TClose := GetTickCount - StageTick;
  StageTick := GetTickCount;

  Relocated := 0;
  OldSample := '';
  NewSample := '';
  FRelocateAll := False; // спрашиваем заново при каждой загрузке проекта
  // Автопоиск потерянных файлов над папкой программы - общий запас времени
  // на всю загрузку (RelocateFile)
  FRelocateUpEnd := GetTickCount + RelocateSearchMs;

  // Раздел проекта в editor.ini: [Project.<имя>], ключи бывших разделов .prj
  // с приставкой (Windows_win0, Tabs_0, Bookmarks_...) - см. PrjStore
  PrjDir := ProjectDir(AName);
  Ini := TProjectIni.Create(SettingsFileName, AName);
  try
    CurIdx := StrToIntDef(StripIniComment(Ini.ReadString('Windows', 'Index', '0')), 0);

    // Слоты занимаем ТЕМИ ЖЕ индексами, что в файле: на них ссылаются закладки
    // в разделе [Bookmarks] через ключи вида bmarkCaption<окно>,<номер>.
    for I := 0 to WindowsItemCount - 1 do
    begin
      // Путь берём как есть, без обрезки по ';' - см. StripIniComment
      Raw := Trim(Ini.ReadString('Windows', 'win' + IntToStr(I), ''));
      if Raw = '' then
        Continue;

      // Файла по записанному пути может не быть (папку перенесли) -
      // пробуем найти его рядом с программой по хвосту пути
      // Прямые косые - обратными (D:/папка/файл.inc записан, когда файл
      // открывали из сообщения компилятора, до правки OpenNamedFile)
      Src := StringReplace(PrjPathFromStore(PrjDir, StripLeadingNumber(Raw)),
      '/', '\', [rfReplaceAll]);
                           Path := ResolveFileName(Src);
      // Тот же файл уже в списке другой записью пути - второй раз не
      // открываем (слот остаётся пустым, его вкладка и закладки не грузятся)
                           if IndexOfWindowByFile(Path) >= 0 then
                           Continue;

                           if CompareText(Path, Src) <> 0 then
      begin
        Inc(Relocated);
        if OldSample = '' then
        begin
          OldSample := Src;
          NewSample := Path;
        end;
      end;
      FWindows[I].Used := True;
      FWindows[I].FileName := Path;
      FWindows[I].CursorPos :=
        StrToIntDef(StripIniComment(Ini.ReadString('Windows', 'curposic' + IntToStr(I), '0')), 0);
      // Главный .bas, если файл открыт из дерева Includes
      Raw := Trim(Ini.ReadString('Windows', 'incowner' + IntToStr(I), ''));
      if Raw <> '' then
        FWindows[I].IncOwner :=
          ResolveFileName(PrjPathFromStore(PrjDir, Raw))
      else
        FWindows[I].IncOwner := '';
      FWindows[I].Modified := False;
      FWindows[I].MapValid := False;

      if FileExists(Path) then
      begin
        Inc(FileCount);
        StartupStage('Чтение ' + ExtractFileName(Path));
        FWindows[I].Text := LoadTextFile(Path);
        FWindows[I].IsUtf8 := FFileIsUtf8;
        FWindows[I].HasBom := FFileHasBom;
        FWindows[I].Broken := False;
      end
      else
      begin
        // Файла нет - окно остаётся в списке, но помечается нерабочим.
        // Разбираться с такими будут пункты Remove missing files from list
        // и Find lost files...
        FWindows[I].Text := '';
        FWindows[I].Broken := True;
      end;

      // Закладки этого окна: читаем подряд, пока ключи не кончатся
      SetLength(FWindows[I].Bookmarks, 0);
      BmHistDropWindow(I);
      J := 0;
      while True do
      begin
        // Первый индекс - НОМЕР ЗАКЛАДКИ, второй - номер окна
        Key := IntToStr(J) + ',' + IntToStr(I);
        Raw := Trim(Ini.ReadString('Bookmarks', 'bmarkCaption' + Key, ''));
        if Raw = '' then
          Break;

        SetLength(FWindows[I].Bookmarks, J + 1);
        FWindows[I].Bookmarks[J].LineNo := LeadingNumber(Raw);
        FWindows[I].Bookmarks[J].Text := StripLeadingNumber(Raw);
        FWindows[I].Bookmarks[J].CharPos :=
          StrToIntDef(StripIniComment(
          Ini.ReadString('Bookmarks', 'bmarkPosic' + Key, '0')), 0);
        FWindows[I].Bookmarks[J].Pinned :=
          Ini.ReadString('Bookmarks', 'bmarkHot' + Key, '') = '1';
        Inc(J);
      end;
      // Файл мог измениться после сохранения проекта - номера строк
      // проверяются по тексту, ненайденные закладки помечаются
      if not FWindows[I].Broken then
        BmValidateWindow(I);
    end;

    // Hot Bookmarks: недавно посещённые - в историю посещений, по порядку
    HotRecent := Ini.ReadString('HotBookmarks', 'Recent', '');
    while HotRecent <> '' do
    begin
      HotSep := Pos(';', HotRecent);
      if HotSep = 0 then
        HotSep := Length(HotRecent) + 1;
      HotItem := Trim(Copy(HotRecent, 1, HotSep - 1));
      Delete(HotRecent, 1, HotSep);
      HotWin := StrToIntDef(Copy(HotItem, 1, Pos(',', HotItem) - 1), -1);
      HotBm := StrToIntDef(Copy(HotItem, Pos(',', HotItem) + 1, MaxInt), -1);
      if (HotWin >= 0) and (HotWin <= WindowsItemCount - 1) and
         FWindows[HotWin].Used and (HotBm >= 0) and
         (HotBm <= High(FWindows[HotWin].Bookmarks)) then
        PushBmHistory(HotWin, HotBm);
    end;

    // Восстанавливаем набор вкладок. Делаем это ДО ActivateWindow: та вызовет
    // EnsureTab, и если вкладка нужного окна уже есть, она просто выберется,
    // а не добавится второй раз в конец панели.
    TabCnt := StrToIntDef(StripIniComment(Ini.ReadString('Tabs', 'TabCount', '0')), 0);
    if (FTabs <> nil) and (TabCnt > 0) then
    begin
      FLockTabs := True;
      try
        FTabs.Tabs.Clear;
        SetLength(FTabWin, 0);
        for I := 0 to TabCnt - 1 do
        begin
          Raw := Trim(Ini.ReadString('Tabs', IntToStr(I), ''));
          if Raw = '' then
            Continue;

          // Значение начинается с номера окна, дальше путь - он нужен только
          // для читаемости файла, слот определяется номером
          TabWin := LeadingNumber(Raw);
          if (TabWin < 0) or (TabWin > WindowsItemCount - 1) then
            Continue;
          if not FWindows[TabWin].Used then
            Continue;
          if TabIndexOfWindow(TabWin) >= 0 then
            Continue; // дубликат в файле

          // В порядке файла, но одноимённые .pas и .dfm - рядом
          InsertTabAt(TabInsertPos(TabWin), TabWin);
        end;
      finally
        FLockTabs := False;
      end;
    end;
  finally
    Ini.Free;
    FRelocateUpEnd := 0;   // дальше - свой запас на каждый поиск
  end;

  TFiles := GetTickCount - StageTick;
  FCurrentProject := AName;
  UpdateCompilerCaption;

  // Восстанавливаем активное окно. Если указанного в файле нет - берём первое.
  ActIdx := -1;
  if (CurIdx >= 0) and (CurIdx < WindowsItemCount) and FWindows[CurIdx].Used then
    ActIdx := CurIdx
  else
    for I := 0 to WindowsItemCount - 1 do
      if FWindows[I].Used then
      begin
        ActIdx := I;
        Break;
      end;
  if ActIdx >= 0 then
    StartupStage('Открытие активной вкладки ' +
      ExtractFileName(FWindows[ActIdx].FileName) + ' (' +
      IntToStr(Length(FWindows[ActIdx].Text) div 1024) + ' КБ): уход с прежней')
  else
    StartupStage('Открытие активной вкладки: открытых файлов нет');
  StageTick := GetTickCount;
  if ActIdx >= 0 then
    ActivateWindow(ActIdx);

  TShow := GetTickCount - StageTick;
  RebuildProjectsMenu;
  RebuildWindowsMenu;
  Caption := AppTitle + ' - [' + AName + '] ' +
             ExtractFileName(FCurrentFileName);
  // Время открытия проекта - в HiLite log; показ активной вкладки по
  // частям - строка 5364 выше
  Dbg(Format('Проект %s: открытие %d мс (закрытие прежних окон %d, ' +
  'чтение файлов %d - %d шт., закладки, вкладки; показ вкладки %d)',
             [AName, GetTickCount - StartTick, TClose, TFiles, FileCount,
             TShow]), clNavy);


  // Спрашиваем В САМОМ КОНЦЕ: SaveProjectTo зовёт StoreCurrentWindow, а тот
  // должен работать по уже поднятому активному окну
  AskSaveRelocated(AName, OldSample, NewSample, Relocated);

  // Слепок берём ПОСЛЕ AskSaveRelocated: она могла сама записать проект
  // с новыми путями, и тогда состав уже совпадает с файлом
  FProjectSig := ProjectSignature;
end;

// Слепок того, что реально попадает в .prj и при этом меняется по воле
// пользователя: набор окон, набор вкладок и закладки.
//
// Осознанно НЕ входят:
//   - номер активного окна: он меняется на каждом переключении вкладки,
//     и проект считался бы изменённым просто от чтения кода;
//   - позиции кареток: меняются от любого движения курсора;
//   - номера строк у закладок: JumpToBookmark подправляет их сам при
//     переходе, а это тоже не правка проекта.
// Текст закладки в слепок входит: его меняет только Set BookMark, то есть
// осмысленное действие пользователя.
function TForm1.ProjectSignature: string;
var
  I, J: Integer;
  SL: TStringList;
begin
  SL := TStringList.Create;
  try
    for I := 0 to WindowsItemCount - 1 do
      if FWindows[I].Used then
      begin
        SL.Add('w' + IntToStr(I) + ' ' + FWindows[I].FileName);
        for J := 0 to High(FWindows[I].Bookmarks) do
          SL.Add('  b' + IntToStr(J) + ' ' + FWindows[I].Bookmarks[J].Text);
      end;

    for I := 0 to High(FTabWin) do
      SL.Add('t ' + IntToStr(FTabWin[I]));

    Result := SL.Text;
  finally
    SL.Free;
  end;
end;

// Предлагает сохранить проект, если его состав изменился с момента загрузки.
// False означает "пользователь передумал выходить".
// Цвета в окне настроек правили, но не записали - спросить при выходе.
// Сам вопрос задаёт окно настроек: там известны и файл схемы, и путь
// записи, тот же, что у кнопки Save.
function TForm1.ConfirmSaveSchema: Boolean;
begin
  Result := True;
  if (Form2 = nil) or not Form2.IsBuilt then
    Exit;
  Result := Form2.ConfirmSaveSchema(True);
end;

function TForm1.ConfirmSaveProject: Boolean;
begin
  Result := True;

  // Проекта нет - сохранять некуда. Открытые окна при этом могут быть,
  // но для них нужен SaveProjectAs с вводом имени, а навязывать его
  // при выходе неуместно.
  if FCurrentProject = '' then
    Exit;

  if ProjectSignature = FProjectSig then
    Exit;

  // Autosave Project desktop - без вопроса
  if FEnv.AutosaveDesktop then
  begin
    SaveProjectTo(FCurrentProject);
    Exit;
  end;

  case MessageDlg('8315:Состав проекта "' + FCurrentProject + '" изменился:' +
                  #13#10 + 'список окон, вкладок или закладок.' + #13#10#13#10 +
    'Сохранить проект?',
                  mtConfirmation, [mbYes, mbNo, mbCancel], 0) of
    mrYes:
      SaveProjectTo(FCurrentProject);
    mrNo:
      ; // выходим без сохранения
  else
    Result := False; // Отмена - остаёмся в программе
  end;
end;

// Запоминает в .prj, какая вкладка была активной. Только её, ничего больше.
//
// Полное сохранение проекта для этого не годится: состав окон пользователь
// мог и не захотеть сохранять, а вернуться в ту же вкладку он хочет всегда.
// Поэтому правим один ключ Index в уже существующем файле.
//
// Проверка перед записью обязательна. Если человек открыл новый файл, на
// вопрос о сохранении проекта ответил "нет" и вышел, то в файле этого окна
// нет, а индекс указывал бы на него. При следующей загрузке слот оказался
// бы пустым, и активной стала бы случайная вкладка.
procedure TForm1.SaveActiveTabToProject;
var
  Ini: TProjectIni;
  Raw, Stored: string;
  SpPos: Integer;
begin
  if FCurrentProject = '' then
    Exit;
  if (FWindowsIndex < 0) or (FWindowsIndex >= WindowsItemCount) then
    Exit;
  if not FWindows[FWindowsIndex].Used then
    Exit;

  if not ProjectExists(FCurrentProject) then
    Exit;

  Ini := TProjectIni.Create(SettingsFileName, FCurrentProject);
  try
    Raw := Trim(Ini.ReadString('Windows', 'win' + IntToStr(FWindowsIndex), ''));
    if Raw = '' then
      Exit; // такого окна в файле нет

    // Значение записано как "<порядковый номер> <путь>"; разделитель
    // может быть и #160 - разбор общий, StripLeadingNumber
    SpPos := Length(Raw);
    Stored := StripLeadingNumber(Raw);
    if Length(Stored) = SpPos then
      Exit; // номера в начале нет

    // Слот мог быть занят другим файлом - тогда индекс соврёт
    Stored := PrjPathFromStore(ProjectDir(FCurrentProject), Stored);
    if CompareText(Stored, FWindows[FWindowsIndex].FileName) <> 0 then
      Exit;

    Ini.WriteString('Windows', 'Index', IntToStr(FWindowsIndex));
  finally
    Ini.Free;
  end;
end;

// Записывает текущий список окон в проект AName, создавая папку при надобности
procedure TForm1.SaveProjectTo(const AName: string);
var
  Ini: TProjectIni;
  I, J, N: Integer;
  HotPinned, HotRecentList: TList;
  HotText: string;
begin
  if Trim(AName) = '' then
    Exit;

  // Проекта нет в списке - запись в [Projects]: папка проекта - папка
  // активного файла, его нет на диске - projects\<имя>
  if not ProjectExists(AName) then
    if (FCurrentFileName <> '') and FileExists(FCurrentFileName) then
      RegisterProject(AName, ExtractFilePath(FCurrentFileName))
    else
      RegisterProject(AName, ProjectsDir + AName + '\');

  StoreCurrentWindow; // в записи окна должны лежать свежие текст и каретка

  // Раздел проекта в editor.ini (PrjStore): пути окон и вкладок - полные,
  // editor.ini у каждого компьютера свой
  Ini := TProjectIni.Create(SettingsFileName, AName);
  try
    // Раздел окон переписываем целиком, иначе остались бы ключи win<N>
    // от закрытых окон. Остальные ключи проекта при этом не трогаются.
    Ini.EraseSection('Windows');
    Ini.WriteString('Windows', 'Index', IntToStr(FWindowsIndex));

    N := 0;
    for I := 0 to WindowsItemCount - 1 do
      if FWindows[I].Used then
      begin
        Inc(N);
        Ini.WriteString('Windows', 'win' + IntToStr(I),
                        IntToStr(N) + ' ' + FWindows[I].FileName);
        Ini.WriteString('Windows', 'curposic' + IntToStr(I),
                        IntToStr(FWindows[I].CursorPos));
        if FWindows[I].IncOwner <> '' then
          Ini.WriteString('Windows', 'incowner' + IntToStr(I),
                          FWindows[I].IncOwner);
      end;

    // Вкладки. Набор вкладок - это не то же самое, что список окон: в панели
    // оседают только те файлы, с которыми работали, поэтому храним отдельно.
    // Значение ключа - номер ОКНА и путь, ключ - порядковый номер вкладки.
    Ini.EraseSection('Tabs');
    if FTabs <> nil then
    begin
      Ini.WriteString('Tabs', 'TabIndex', IntToStr(FTabs.TabIndex));
      Ini.WriteString('Tabs', 'TabCount', IntToStr(Length(FTabWin)));
      for I := 0 to High(FTabWin) do
        if FWindows[FTabWin[I]].Used then
          Ini.WriteString('Tabs', IntToStr(I),
                          IntToStr(FTabWin[I]) + ' ' +
                          FWindows[FTabWin[I]].FileName);
    end;

    // Закладки. Раздел переписываем целиком, иначе остались бы ключи
    // от удалённых закладок и закрытых окон.
    Ini.EraseSection('Bookmarks');
    for I := 0 to WindowsItemCount - 1 do
      if FWindows[I].Used then
        for J := 0 to High(FWindows[I].Bookmarks) do
        begin
          // Порядок индексов: сначала НОМЕР ЗАКЛАДКИ, потом номер окна
          Ini.WriteString('Bookmarks',
                          Format('bmarkCaption%d,%d', [J, I]),
                          Format('%d %s', [FWindows[I].Bookmarks[J].LineNo,
                                 FWindows[I].Bookmarks[J].Text]));
          Ini.WriteString('Bookmarks',
                          Format('bmarkPosic%d,%d', [J, I]),
                          IntToStr(FWindows[I].Bookmarks[J].CharPos));
          if FWindows[I].Bookmarks[J].Pinned then
            Ini.WriteString('Bookmarks', Format('bmarkHot%d,%d', [J, I]), '1');
        end;

    // Hot Bookmarks: недавние (без закреплённых - те в Bookmarks) по порядку
    HotPinned := TList.Create;
    HotRecentList := TList.Create;
    try
      HotBmCollect(HotPinned, HotRecentList);
      HotText := '';
      for I := 0 to HotRecentList.Count - 1 do
      begin
        if HotText <> '' then
          HotText := HotText + ';';
        HotText := HotText + IntToStr(Integer(HotRecentList[I]) shr 16) + ',' +
                   IntToStr(Integer(HotRecentList[I]) and $FFFF);
      end;
      Ini.EraseSection('HotBookmarks');
      if HotText <> '' then
        Ini.WriteString('HotBookmarks', 'Recent', HotText);
    finally
      HotRecentList.Free;
      HotPinned.Free;
    end;
  finally
    Ini.Free;
  end;

  FCurrentProject := AName;
  FProjectSig := ProjectSignature; // то, что сейчас лежит в файле
  RebuildProjectsMenu;
  Caption := AppTitle + ' - [' + AName + '] ' +
             ExtractFileName(FCurrentFileName);
end;

// Удаляет ТОЛЬКО файл описания проекта. Папка с исходниками остаётся:
// проект - это список окон, а не сами файлы, и пути в нём абсолютные.
// Подсказки пунктов меню VCL не показывает всплывающими окнами - они приходят
// сюда через Application.OnHint. Выводим их в статус-бар, переключая его в
// режим одной строки: путь к файлу длинный, в отдельную панель не влезет.
// Диалог открытия файла в папке с исходниками текущего проекта: папке его
// главного файла (цель сборки: .dpr, .lpr, .bas ...), этот файл в диалоге
// уже выбран. Выбрать можно и несколько файлов - откроются все. Цели нет на
// диске - папка описания проекта (.prj), его нет - <projects>\<имя>. Без
// открытого проекта - корень projects, оттуда видно все проекты сразу.
// С нажатым Shift - как раньше, папка в проводнике.
procedure TForm1.OpenProjectFolderClick(Sender: TObject);
var
  Dir, Target: string;
  OldOptions: TOpenOptions;
  FileIdx: Integer;
begin
  Dir := '';
  Target := '';
  if FCurrentProject <> '' then
  begin
    Target := ProjectTargetFind(FCurrentProject);
    if (Target <> '') and FileExists(Target) then
      Dir := ExtractFilePath(Target)
    else
    begin
      Target := '';
      Dir := ProjectDir(FCurrentProject);
      if Dir = '' then
        Dir := ProjectsDir + FCurrentProject;
    end;
  end;

  if (Dir = '') or not DirectoryExists(Dir) then
  begin
    Target := '';
    Dir := ProjectsDir;
  end;

  if not DirectoryExists(Dir) then
  begin
    ShowMessage('8497:Папка не найдена:'#13#10 + Dir);
    Exit;
  end;

  if GetKeyState(VK_SHIFT) < 0 then
  begin
    if Target <> '' then
      // Папка с выделенным главным файлом
      ShellExecute(Handle, 'open', 'explorer.exe',
                   PChar('/select,"' + Target + '"'), nil, SW_SHOWNORMAL)
    else
      ShellExecute(Handle, 'open', PChar(Dir), nil, nil, SW_SHOWNORMAL);
    Exit;
  end;

  // Диалог тот же, что у File - Open (фильтры те же), на время - с выбором
  // нескольких файлов и с выбранным главным файлом
  OldOptions := OpenDialog1.Options;
  OpenDialog1.Options := OpenDialog1.Options + [ofAllowMultiSelect];
  OpenDialog1.InitialDir := Dir;
  OpenDialog1.FileName := ExtractFileName(Target);
  try
    if not OpenDialog1.Execute then
      Exit;
    for FileIdx := 0 to OpenDialog1.Files.Count - 1 do
      OpenNamedFile(OpenDialog1.Files[FileIdx]);
  finally
    OpenDialog1.Options := OldOptions;
    OpenDialog1.FileName := '';
  end;
end;

// Показывает полный путь текущего файла в поле над статус-баром
procedure TForm1.UpdatePathBar;
var
  FN: string;
  SR: TSearchRec;
begin
  if FStatus2 = nil then
    Exit;

  FN := '';
  if (FWindowsIndex >= 0) and FWindows[FWindowsIndex].Used then
  begin
    if FCurrentFileName <> '' then
      FN := FCurrentFileName
    else
      // Новый файл ещё не сохранён - показываем условное имя из записи окна
      FN := FWindows[FWindowsIndex].FileName;
  end;

  // Путь из проекта может быть составным: папка проекта + относительный
  // путь модуля (projects\X\..\X\Unit1.pas). Показываем его без '..' и
  // '.'. Внутреннее имя файла не трогаем - по нему сверяются вкладки,
  // точки останова и прочее.
  if (Pos('\..\', FN) > 0) or (Pos('\.\', FN) > 0) then
    FN := ExpandFileName(FN);

  FStatus2.Panels[0].Text := FN;

  // Размер и дата берутся С ДИСКА, а не из памяти. Поэтому у изменённого
  // файла они показывают то, что лежит в файле, а не то, что на экране, -
  // и у нового файла пусты вовсе.
  FStatus2.Panels[1].Text := '';
  FStatus2.Panels[2].Text := '';

  if (FN = '') or not FileExists(FN) then
    Exit;

  if FindFirst(FN, faAnyFile, SR) = 0 then
  try
    FStatus2.Panels[1].Text := FormatFloat('#,##0', SR.Size) + ' б';
    FStatus2.Panels[2].Text :=
      FormatDateTime('dd.mm.yyyy hh:nn', FileDateToDateTime(SR.Time));
  finally
    FindClose(SR);
  end;
end;

// Панель пути занимает всё, что осталось от размера и даты
procedure TForm1.Status2Resize(Sender: TObject);
var
  W: Integer;
begin
  if FStatus2 = nil then
    Exit;

  W := FStatus2.Width - FStatus2.Panels[1].Width - FStatus2.Panels[2].Width - 8;
  if W < 80 then
    W := 80;
  FStatus2.Panels[0].Width := W;
end;

// Клик по полю копирует путь целиком - но только если пользователь ничего
// не выделил сам. Иначе протянуть мышью для частичного копирования было бы
// невозможно: OnClick срабатывает и после протяжки.
// Клик по панели пути копирует его в буфер обмена. По остальным панелям
// не копируем: там нечего забирать.
procedure TForm1.Status2MouseDown(Sender: TObject; Button: TMouseButton;
                                  Shift: TShiftState; X, Y: Integer);
begin
  if Button <> mbLeft then
    Exit;
  if (FStatus2 = nil) or (FStatus2.Panels[0].Text = '') then
    Exit;
  if X > FStatus2.Panels[0].Width then
    Exit;

  Clipboard.AsText := FStatus2.Panels[0].Text;

  StatusBar1.SimpleText := 'Путь скопирован в буфер обмена';
  StatusBar1.SimplePanel := True;
end;

procedure TForm1.AppHint(Sender: TObject);
begin
  if Application.Hint = '' then
  begin
    StatusBar1.SimplePanel := False; // вернули обычные панели
    UpdateStatusBarInfo;
  end
  else
  begin
    StatusBar1.SimpleText := Application.Hint;
    StatusBar1.SimplePanel := True;
  end;
end;

// Закрытие проекта. Окна, вкладки и закладки очищаются, редактор остаётся
// пустым - открытым не должно остаться ничего, что принадлежало проекту.
//
// Спрашиваем в том же порядке, что и при смене проекта: сначала о составе
// проекта, потом о несохранённых файлах. Отказ на любом вопросе оставляет
// всё как было.
procedure TForm1.CloseProjectClick(Sender: TObject);
begin
  if FCurrentProject = '' then
  begin
    ShowMessage('8603:Выберите проект из списка');
    Exit;
  end;

  if not ConfirmSaveProject then
    Exit;
  if not ConfirmSaveAll then
    Exit;

  ProjectClosedReset;

  ShowMessage('8625:Выберите проект из списка');
end;

// Проекта больше нет (закрыт или удалён): окна, вкладки, закладки,
// конструктор и логи очищаются, редактор остаётся пустым. Вопросы о
// сохранении - до вызова, у вызывающего.
procedure TForm1.ProjectClosedReset;
begin
  CloseAllWindows;

  FCurrentProject := '';
  FProjectSig := '';
  SnapReset;          // снимки были от закрытого проекта
  ProjectSwitchReset;

  RebuildProjectsMenu;
  RebuildWindowsMenu;
  ReBuildBookmarksMenu;
  Caption := AppTitle + ' - ' + DisplayName;
  UpdatePathBar;
  RefreshStatusBar;
end;

// Смена проекта. Правки формы в конструкторе к этому времени уже в тексте
// вкладок и сохранены (или отвергнуты) в ConfirmSaveAll - закрываем его без
// вопросов. Логи прежнего проекта (сборка, ошибки, работающая программа)
// очищаются; HiLite log - журнал самой IDE, он остаётся.
procedure TForm1.ProjectSwitchReset;
begin
  // Конструктор форм: форма прежнего проекта и его откат
  if FDesigner <> nil then
  begin
    DsgPaletteReset;
    FreeAndNil(FDesigner);
  end;
  FreeAndNil(FRqDesigner);
  FRqDsgLastDfm := '';
  DsgFreeOther;
  FDsgDfm := '';
  FDsgHiddenForRun := False;
  if FDsgUndo <> nil then
    FDsgUndo.Clear;
  if FDsgUndoPas <> nil then
    FDsgUndoPas.Clear;
  if FDsgMade <> nil then
    FDsgMade.Clear;

  // Логи прежнего проекта
  if CompLogEdit <> nil then
    CompLogEdit.Clear;
  if ErrLogEdit <> nil then
    ErrLogEdit.Clear;
  if RuntimeLog <> nil then
    RuntimeLog.Clear;

  // Программа прежнего проекта, если ещё запущена, работает дальше: её
  // окончание по-прежнему отслеживает RunTimerTick
  if (FRunList <> nil) and (FRunList.Count > 0) then
    LogComp('Программа прежнего проекта ещё работает');
end;

// Убрать проект из реестра. Реестр - единственное место, где имя проекта
// связано с путём, и пока запись жива, проект остаётся в меню и после
// удаления его файла.
procedure TForm1.UnregisterProject(const AName: string);
var
  I: Integer;
begin
  if FProjectReg = nil then
    LoadProjectReg;

  I := FProjectReg.IndexOfName(AName);
  if I >= 0 then
  begin
    FProjectReg.Delete(I);
    SaveProjectReg;
  end;
end;

// Можно ли удалять эту папку. Пустая строка - можно, иначе причина отказа.
//
// Корень диска и общая папка projects\ отсекаются из-за проектов старой
// раскладки: там .prj лежал не в своей папке, и папкой проекта оказалась бы
// общая. Папка со средой - чтобы не удалить работающую программу.
function TForm1.ProjectFolderBlockReason(const ADirSl: string): string;
var
  Dir: string;
begin
  Result := '';
  Dir := ExcludeTrailingPathDelimiter(ADirSl);

  if Dir = '' then
    Result := 'Папка проекта не определена'
  else if Length(Dir) <= 3 then
    Result := 'Это корень диска'
  else if CompareText(ADirSl, ProjectsDir) = 0 then
    Result := 'Это общая папка проектов, в ней лежат и другие'
  else if AnsiStartsText(ADirSl, ExtractFilePath(Application.ExeName)) then
    Result := 'В этой папке находится сама среда';
end;

// Папка уходит в корзину (FOF_ALLOWUNDO), а не стирается насовсем: ошибка
// здесь стоит дорого, а откат из корзины ничего не стоит.
function TForm1.DeleteProjectFolder(const ADir: string): Boolean;
var
  Op: TSHFileOpStruct;
  Src: string;
  Res: Integer;
begin
  // Список путей для оболочки заканчивается двумя нулями
  Src := ExcludeTrailingPathDelimiter(ADir) + #0#0;

  FillChar(Op, SizeOf(Op), 0);
  Op.Wnd := Handle;
  Op.wFunc := FO_DELETE;
  Op.pFrom := PChar(Src);
  Op.fFlags := FOF_ALLOWUNDO or FOF_NOCONFIRMATION;

  Res := SHFileOperation(Op);
  Result := (Res = 0) and (Op.fAnyOperationsAborted = False);

  if not Result then
    LogRaw('Delete Project: папка не удалена, код ' + IntToStr(Res) +
    '  ' + #149 + '  ' + ADir);
end;

// Удаление проектов: окно со списком всех проектов реестра, нужные
// отмечаются галками. Два исхода, общих для всех отмеченных:
//   - только описание (.prj), файлы остаются - по умолчанию. Основной
//     случай - готовые проекты, открытые здесь: их файлы среде не
//     принадлежат (рабочая копия репозитория, чужой проект, дубликат после
//     Scan projects folder);
//   - папка проекта целиком - в корзину. Для проектов, заведённых здесь.
//     Папку, которую трогать нельзя (ProjectFolderBlockReason), проект
//     не удаляет вовсе - он остаётся в списке, причина - в итоге.
// Проект, чьего .prj уже нет, в любом режиме просто убирается из списка.
// Перед удалением - подтверждение с числом проектов и, для папок, с числом
// открытых и несохранённых файлов из них.
procedure TForm1.DeleteProjectClick(Sender: TObject);
var
  Dlg: TDlgDelPrj;
  Lst: TCheckListBox;
  Names, Sorted: TStringList;
  Nm, DirSl, Dir, Reason, S, Report: string;
  I, J, Cnt, Open, Dirty, Done, Skipped: Integer;
  Folders, CurGone, CurChecked: Boolean;
begin
  if FProjectReg = nil then
    LoadProjectReg;
  if FProjectReg.Count = 0 then
  begin
    ShowMessage('8721:Список проектов пуст.');
    Exit;
  end;

  Names := TStringList.Create;
  Sorted := TStringList.Create;
  // Окно описано в DlgDelPrj.dfm; здесь - обработчики и список проектов
  Dlg := TDlgDelPrj.Create(Self);
  try
    // По имени, без учёта регистра
    for I := 0 to FProjectReg.Count - 1 do
      if FProjectReg.Names[I] <> '' then
        Sorted.Add(FProjectReg.Names[I]);
    Sorted.Sort;

    Lst := Dlg.lstDelPrj;
    Lst.OnClickCheck := DelPrjClickCheck;
    Dlg.btnMark.OnClick := DelPrjCheckAll;
    Dlg.btnUnmark.OnClick := DelPrjCheckAll;
    for I := 0 to Sorted.Count - 1 do
    begin
      Nm := Sorted[I];
      DirSl := ProjectDir(Nm);
      S := Nm + '   ' + #149 + '   ' + DirSl;
      if CompareText(Nm, FCurrentProject) = 0 then
        S := S + '   (открыт)';
      if not DirectoryExists(DirSl) then
        S := S + '   (папки нет)';
      Lst.Items.Add(S);
      Names.Add(Nm);
    end;
    Dlg.FitScrollWidth;
    Dlg.LoadPlacement(SettingsFileName);

    Dlg.ShowModal;
    Dlg.SavePlacement(SettingsFileName);
    if Dlg.ModalResult <> mrOk then
      Exit;

    Folders := Dlg.rbAll.Checked;

    // Подтверждение: сколько проектов и, для папок, что открыто из них
    Cnt := 0;
    Open := 0;
    Dirty := 0;
    CurChecked := False;
    for I := 0 to Lst.Items.Count - 1 do
      if Lst.Checked[I] then
      begin
        Inc(Cnt);
        if CompareText(Names[I], FCurrentProject) = 0 then
          CurChecked := True;
        if Folders then
        begin
          DirSl := ProjectDir(Names[I]);
          for J := 0 to High(FWindows) do
            if FWindows[J].Used and
               AnsiStartsText(DirSl, FWindows[J].FileName) then
            begin
              Inc(Open);
              if FWindows[J].Modified then
                Inc(Dirty);
            end;
        end;
      end;
    if Cnt = 0 then
      Exit;

    if Folders then
    begin
      S := 'Удалить проектов: ' + IntToStr(Cnt) + ' вместе с папками ' +
      '(в корзину)?';
 if Open > 0 then
      begin
        S := S + #13#10#13#10'Открыто файлов из этих папок: ' + IntToStr(Open);
        if Dirty > 0 then
          S := S + ', из них с несохранёнными изменениями: ' +
               IntToStr(Dirty);
      end;
    end
    else
      S := 'Убрать из списка проектов: ' + IntToStr(Cnt) + '? Файлы ' +
      'проектов останутся на месте.';
if MessageDlg('8865:' + S, mtConfirmation, [mbYes, mbNo], 0) <> mrYes then
        Exit;

    // Открытый проект удаляется - его окна закроются. Если удаляется только
    // описание, файлы остаются, и несохранённое предлагаем сохранить; папка
    // же уходит в корзину целиком, и сохранять в неё нечего
    if CurChecked and not Folders then
      if not ConfirmSaveAll then
        Exit;

    Done := 0;
    Skipped := 0;
    Report := '';
    CurGone := False;
    for I := 0 to Lst.Items.Count - 1 do
    begin
      if not Lst.Checked[I] then
        Continue;
      Nm := Names[I];
      DirSl := ProjectDir(Nm);
      Dir := ExcludeTrailingPathDelimiter(DirSl);

      if not DirectoryExists(DirSl) then
        // Папки уже нет - только запись в списке
        LogRaw('Убран из списка: ' + Nm + '  ' + #149 + '  ' + DirSl)
      else if Folders then
      begin
        Reason := ProjectFolderBlockReason(DirSl);
        if Reason <> '' then
        begin
          Inc(Skipped);
          Report := Report + #13#10 + Nm + ': ' + Reason;
          Continue;
        end;
        if not DeleteProjectFolder(Dir) then
        begin
          Inc(Skipped);
          Report := Report + #13#10 + Nm + ': папку удалить не удалось';
          Continue;
        end;
        LogRaw('Проект удалён вместе с папкой: ' + Nm + '  ' + #149 +
        '  ' + Dir);
      end
      else
        LogRaw('Убран из списка проектов: ' + Nm + '  ' + #149 + '  ' +
               DirSl);

      // Раздел проекта в editor.ini и запись в [Projects]
      IniReplaceSection(SettingsFileName, ProjectSectionPrefix + Nm, nil);
      UnregisterProject(Nm);
      Inc(Done);
      if CompareText(Nm, FCurrentProject) = 0 then
        CurGone := True;
    end;
  finally
    Dlg.Free;
    Sorted.Free;
    Names.Free;
  end;

  // Открытый проект удалён - редактор очищается, как при Close Project
  if CurGone then
    ProjectClosedReset
  else
    RebuildProjectsMenu;

  if Skipped > 0 then
    ShowMessage('8934:Удалено проектов: ' + IntToStr(Done) + ', не удалено: ' +
                IntToStr(Skipped) + #13#10 + Report);
end;

// Кнопки "Отметить все" (Tag = 1) и "Снять все" (Tag = 0) окна удаления
procedure TForm1.DelPrjCheckAll(Sender: TObject);
var
  Lst: TCheckListBox;
  I: Integer;
begin
  if not (Sender is TUiButton) or (TUiButton(Sender).Owner = nil) then
    Exit;
  Lst := TCheckListBox(TUiButton(Sender).Owner.FindComponent('lstDelPrj'));
  if Lst = nil then
    Exit;
  for I := 0 to Lst.Items.Count - 1 do
    Lst.Checked[I] := TUiButton(Sender).Tag = 1;
  DelPrjClickCheck(Lst);
end;

// Кнопка "Удалить" доступна, только когда что-то отмечено
procedure TForm1.DelPrjClickCheck(Sender: TObject);
var
  Lst: TCheckListBox;
  Btn: TComponent;
  I: Integer;
  Any: Boolean;
begin
  if not (Sender is TCheckListBox) then
    Exit;
  Lst := TCheckListBox(Sender);
  Any := False;
  for I := 0 to Lst.Items.Count - 1 do
    if Lst.Checked[I] then
    begin
      Any := True;
      Break;
    end;
  if Lst.Owner <> nil then
  begin
    Btn := Lst.Owner.FindComponent('btnDelPrj');
    if Btn is TUiButton then
      TUiButton(Btn).Enabled := Any;
  end;
end;

// Имя проекта по пункту меню Projects: подпись "Имя  •  Тип"
function ProjectNameOfItem(AItem: TMenuItem): string;
var
  SepAt: Integer;
begin
  Result := StripHotkey(AItem.Caption);
  SepAt := Pos('  ' + #149, Result);
  if SepAt > 0 then
    Result := Copy(Result, 1, SepAt - 1);
end;

procedure TForm1.ProjectItemClick(Sender: TObject);
begin
  if not (Sender is TMenuItem) then
    Exit;

  // Scan projects folder: просто перечитать папку
  if TMenuItem(Sender).Tag = -1 then
  begin
    RebuildProjectsMenu;
    Exit;
  end;

  // Имя проекта - начало подписи, до " • тип" (RebuildProjectsMenu)
  LoadProject(ProjectNameOfItem(TMenuItem(Sender)));
end;

// Копирование папки со всем содержимым. Имена внутри не меняются: правило
// "файл назван по проекту" действует только на верхнем уровне папки.
function TForm1.CopyDirTree(const ASrc, ADst: string): Boolean;
var
  SR: TSearchRec;
begin
  Result := ForceDirectories(ExcludeTrailingPathDelimiter(ADst));
  if not Result then
    Exit;

  if FindFirst(ASrc + '*.*', faAnyFile, SR) <> 0 then
    Exit;
  try
    repeat
      if (SR.Name = '.') or (SR.Name = '..') then
        Continue;

      if (SR.Attr and faDirectory) <> 0 then
      begin
        if not CopyDirTree(IncludeTrailingPathDelimiter(ASrc + SR.Name),
                           IncludeTrailingPathDelimiter(ADst + SR.Name)) then
        begin
          Result := False;
          Exit;
        end;
      end
      else if not CopyFile(PChar(ASrc + SR.Name), PChar(ADst + SR.Name),
                           False) then
      begin
        Result := False;
        Exit;
      end;
    until FindNext(SR) <> 0;
  finally
    FindClose(SR);
  end;
end;

// Копирование файлов проекта в новую папку. Файл, названный по проекту,
// переезжает под новым именем: Old.dpr -> New.dpr, Old.res -> New.res,
// Old.prj -> New.prj. Остальные сохраняют имена.
// AOldTarget - имя .dpr без расширения, если оно не совпадает с именем
// проекта: его .dpr, .res, .dof, .cfg тоже получают новое имя, как при
// Save Project As в среде Delphi. Пусто - не нужно.
//
// AOnlyNamed - для старой раскладки, где .prj лежал прямо в projects:
// копировать оттуда всё нельзя, там файлы чужих проектов, поэтому берём
// только файлы с именем проекта.
//
// Возвращает число скопированных файлов или -1 при ошибке.
function TForm1.CopyProjectFiles(const AOldDir, ANewDir, AOldTarget,
                                 AOldName, ANewName: string;
                                 AOnlyNamed: Boolean): Integer;
var
  SR: TSearchRec;
  Src, Dst, Base: string;
begin
  Result := 0;
  if FindFirst(AOldDir + '*.*', faAnyFile, SR) <> 0 then
    Exit;
  try
    repeat
      if (SR.Name = '.') or (SR.Name = '..') then
        Continue;

      Src := AOldDir + SR.Name;

      if (SR.Attr and faDirectory) <> 0 then
      begin
        if AOnlyNamed then
          Continue;
        if not CopyDirTree(IncludeTrailingPathDelimiter(Src),
                           IncludeTrailingPathDelimiter(ANewDir + SR.Name)) then
        begin
          Result := -1;
          Exit;
        end;
        Continue;
      end;

      Base := ChangeFileExt(SR.Name, '');
      if AOnlyNamed and (CompareText(Base, AOldName) <> 0) then
        Continue;

      if (CompareText(Base, AOldName) = 0) or
         ((AOldTarget <> '') and (CompareText(Base, AOldTarget) = 0)) then
        Dst := ANewDir + ANewName + ExtractFileExt(SR.Name)
      else
        Dst := ANewDir + SR.Name;

      if not CopyFile(PChar(Src), PChar(Dst), False) then
      begin
        Result := -1;
        Exit;
      end;
      Inc(Result);
    until FindNext(SR) <> 0;
  finally
    FindClose(SR);
  end;
end;

// Цель сборки в описании нового проекта: та же по расширению, но в новой
// папке и с новым именем. Расширение берём у прежней цели - у Delphi это
// .dpr, у других типов своё.
procedure TForm1.FixProjectTarget(const AProject, ADir, AName: string);
var
  Target, NewTarget: string;
begin
  Target := ProjectTargetOf(AProject);
  if Target = '' then
    Exit;
  NewTarget := ADir + AName + ExtractFileExt(Target);
  if FileExists(NewTarget) then
    SetProjectTarget(AProject, NewTarget);
end;

// Окна, открытые из старой папки, переводим на копии в новой: после Save
// Project As работа идёт в новом проекте, и правки должны попадать в его
// файлы, а не обратно в исходный. Файл, переименованный вместе с проектом,
// ищем под новым именем.
//
// Окна из других папок не трогаем - к проекту они отношения не имеют.
procedure TForm1.RepointWindows(const AOldDir, ANewDir, AOldTarget,
                                AOldName, ANewName: string);
var
  I: Integer;
  FN, NewFN, Base: string;
begin
  if (AOldDir = '') or (CompareText(AOldDir, ANewDir) = 0) then
    Exit;

  for I := 0 to WindowsItemCount - 1 do
  begin
    if not FWindows[I].Used then
      Continue;

    FN := FWindows[I].FileName;
    if not AnsiStartsText(AOldDir, FN) then
      Continue;

    NewFN := ANewDir + Copy(FN, Length(AOldDir) + 1, Length(FN));
    Base := ChangeFileExt(ExtractFileName(FN), '');
    if (CompareText(Base, AOldName) = 0) or
       ((AOldTarget <> '') and (CompareText(Base, AOldTarget) = 0)) then
      NewFN := ExtractFilePath(NewFN) + ANewName + ExtractFileExt(FN);

    if not FileExists(NewFN) then
      Continue;

    FWindows[I].FileName := NewFN;
    if I = FWindowsIndex then
      FCurrentFileName := NewFN;
  end;

  RefreshAllTabCaptions;
end;

// Save Project As: новое имя - это новая папка projects\<Имя>, своя запись
// в реестре и копия файлов проекта под новыми именами. Прежний проект
// остаётся на диске и в списке нетронутым.
procedure TForm1.SaveProjectAsClick(Sender: TObject);
var
  S, OldName, OldDir, NewDir: string;
  Cnt: Integer;
  OldTarget, NewDpr, OldPrgName, FixErr: string;
begin
  S := FCurrentProject;
  if not InputQuery('Save Project As', 'Имя проекта:', S) then
    Exit;

  S := Trim(S);
  if S = '' then
    Exit;

  // Имя проекта становится именем папки, поэтому недопустимые символы отсекаем
  if (Pos('\', S) > 0) or (Pos('/', S) > 0) or (Pos(':', S) > 0) or
     (Pos('*', S) > 0) or (Pos('?', S) > 0) or (Pos('"', S) > 0) or
     (Pos('<', S) > 0) or (Pos('>', S) > 0) or (Pos('|', S) > 0) then
  begin
    ShowMessage('9180:В имени проекта нельзя использовать символы \ / : * ? " < > |');
    Exit;
  end;

  // Прежнее имя - это обычное сохранение, копировать нечего
  if CompareText(S, FCurrentProject) = 0 then
  begin
    SaveProjectTo(S);
    Exit;
  end;

  NewDir := IncludeTrailingPathDelimiter(ProjectsDir + S);

  // Проект Delphi: .dpr переименовывается вместе с проектом, и новое имя
  // попадёт в строку program - оно должно быть идентификатором. OldTarget -
  // имя .dpr, если оно не совпадает с именем проекта (файлы с именем
  // проекта CopyProjectFiles переименовывает и так).
  OldTarget := '';
  if (FCurrentProject <> '') and
     (ProjectBuildKind(FCurrentProject) = bkDelphi) and
     (CompareText(ExtractFileExt(ProjectTargetOf(FCurrentProject)),
  '.dpr') = 0) then
  begin
    if not IsPascalIdent(S) then
    begin
      ShowMessage('9197:Имя проекта Delphi станет именем .dpr и программы ' +
      '(program). Допустимы латинские буквы, цифры и _, ' +
      'первой не цифра.');
                  Exit;
    end;
    if CompareText(ExtractFilePath(ProjectTargetOf(FCurrentProject)),
                   ProjectDir(FCurrentProject)) = 0 then
      OldTarget := ChangeFileExt(ExtractFileName(
        ProjectTargetOf(FCurrentProject)), '');
    if CompareText(OldTarget, FCurrentProject) = 0 then
      OldTarget := '';
  end;

  if ProjectExists(S) then
  begin
    ShowMessage('9196:Проект с таким именем уже есть в списке:'#13#10 +
                ProjectDir(S));
    Exit;
  end;

  if not ForceDirectories(ExcludeTrailingPathDelimiter(NewDir)) then
  begin
    ShowMessage('9202:Не удалось создать папку'#13#10 + NewDir);
    Exit;
  end;

  OldName := FCurrentProject;
  OldDir := '';
  if OldName <> '' then
  begin
    OldDir := ProjectDir(OldName);
    if DirectoryExists(OldDir) then
    begin
      Cnt := CopyProjectFiles(OldDir, NewDir, OldTarget, OldName, S,
                              CompareText(OldDir, ProjectsDir) = 0);
      if Cnt < 0 then
      begin
        ShowMessage('9217:Не удалось скопировать файлы проекта из'#13#10 + OldDir);
        Exit;
      end;
      LogRaw(Format('Save Project As: скопировано файлов %d  %s  %s',
                    [Cnt, #149, NewDir]));
    end;
  end;

  // Запись в [Projects] и раздел проекта - копия прежнего (тип, цель,
  // папка вывода...), окна и вкладки перепишет SaveProjectTo
  RegisterProject(S, NewDir);
  if OldName <> '' then
    IniCopySection(SettingsFileName, ProjectSectionPrefix + OldName,
                   ProjectSectionPrefix + S);
  // Цель сборки теперь в новой папке
  FixProjectTarget(S, NewDir, S);
  // Строка program в новом .dpr - по новому имени
  NewDpr := NewDir + S + '.dpr';
  if FileExists(NewDpr) then
  begin
    if not DprFixProgramName(NewDpr, OldPrgName, FixErr) then
      LogRaw('Save Project As: имя в строке program не исправлено: ' + FixErr)
    else if OldPrgName <> '' then
      LogRaw('Save Project As: program ' + OldPrgName + ' заменено на ' +
      'program ' + S);
  end;
  RepointWindows(OldDir, NewDir, OldTarget, OldName, S);
  SaveProjectTo(S);
  RebuildProjectsMenu;
end;

// NewProject: заводит пустой проект. Папку под его файлы создаём сразу -
// пользоваться ей необязательно, но так она есть под рукой.
// OpenPrjFile: открывает editor.ini - там раздел текущего проекта
// [Project.<имя>] - как обычный текстовый файл, на строке этого раздела
procedure TForm1.OpenPrjFileClick(Sender: TObject);
var
  Lines: TStringList;
  First, Last: Integer;
begin
  if not FileExists(SettingsFileName) then
  begin
    ShowMessage('9250:Файл настроек не найден:'#13#10 + SettingsFileName);
    Exit;
  end;
  OpenNamedFile(SettingsFileName);
  if FCurrentProject = '' then
    Exit;
  Lines := TStringList.Create;
  try
    Lines.LoadFromFile(SettingsFileName);
    First := IniFindSection(Lines, ProjectSectionPrefix + FCurrentProject,
                            Last);
  finally
    Lines.Free;
  end;
  if First >= 0 then
    GotoLine(First);
end;

// SaveProject: сначала все изменённые окна и вкладки - на диск
// (SaveAllModified), потом сам проект под текущим именем, без вопросов.
// Файлы, которые сохранить не удалось, перечисляются; проект при этом всё
// равно записывается - список окон в нём от этого не зависит. Если проекта
// ещё нет, ведёт себя как SaveProjectAs - имя всё равно нужно спросить.
procedure TForm1.SaveProjectClick(Sender: TObject);
var
  Failed: TStringList;
begin
  Failed := TStringList.Create;
  try
    if not SaveAllModified(Failed) then
      ShowMessage('9385:Не сохранены файлы:'#13#10 + Failed.Text +
                  #13#10'Проект сохраняется, эти окна остаются изменёнными.');
  finally
    Failed.Free;
  end;

  if FCurrentProject = '' then
    SaveProjectAsClick(Sender)
  else
    SaveProjectTo(FCurrentProject);
end;

// ---------------------------------------------------------------------------
//  Закладки
//
//  Список закладок свой у каждого окна и хранится в его записи. В проекте они
//  лежат в разделе [Bookmarks] с ключами, где первый индекс - номер ОКНА:
//      bmarkCaption0,1=5157 PID = SHELL(...)
//      bmarkPosic0,1=137229
//  Именно поэтому при загрузке проекта окна занимают те же слоты, что в файле.
// ---------------------------------------------------------------------------

// 0-базовый индекс строки, в которой стоит каретка
function TForm1.CurrentLineIndex: Integer;
var
  Sel: TCharRange;
begin
  Result := 0;
  if not RichEdit1.HandleAllocated then
    Exit;
  SendMessageA(RichEdit1.Handle, EM_EXGETSEL, 0, Integer(@Sel));
  Result := SendMessageA(RichEdit1.Handle, EM_EXLINEFROMCHAR, 0, Sel.cpMin);
end;

// Прокручивает окно так, чтобы строка с кареткой оказалась примерно посередине.
//
// EM_SCROLLCARET только делает каретку видимой - после поиска строка обычно
// оказывается у нижнего края, и контекста под ней не видно.
procedure TForm1.CenterCaretLine;
var
  TopLine, CaretLine, Visible, Want: Integer;
  R: TRect;
begin
  if not RichEdit1.HandleAllocated then
    Exit;
  if LineHeight <= 0 then
    Exit;

  Windows.GetClientRect(RichEdit1.Handle, R);
  Visible := R.Bottom div LineHeight;
  if Visible < 3 then
    Exit; // окно слишком низкое, центрировать нечего

  CaretLine := CurrentLineIndex;
  TopLine := SendMessageA(RichEdit1.Handle, EM_GETFIRSTVISIBLELINE, 0, 0);

  Want := CaretLine - Visible div 2;
  if Want < 0 then
    Want := 0;

  // EM_LINESCROLL сдвигает ОТНОСИТЕЛЬНО текущей позиции
  if Want <> TopLine then
    SendMessageA(RichEdit1.Handle, EM_LINESCROLL, 0, Want - TopLine);
end;

// Постоянные пункты подменю BookMarks
procedure TForm1.BuildBookmarksMenu;
begin
  // Подписи содержат текст кода - ускорители в них только мешают
  mBookmarks.AutoHotkeys := maManual;
  // При открытии меню - квадратики с номерами, текущая закладка выделена
  mBookmarks.OnClick := mBookmarksClick;
  // Hot Bookmarks - список строится при каждом открытии меню
  if mHotBM <> nil then
  begin
    mHotBM.AutoHotkeys := maManual;
    mHotBM.OnClick := HotBmMenuClick;
  end;


  RebuildBookmarksMenu;

end;

// Перестраивает список закладок ТЕКУЩЕГО окна
procedure TForm1.RebuildBookmarksMenu;
var
  I: Integer;
  It: TMenuItem;
begin
  // Список закладок изменился - и метки на полосе тоже
  if MarksBox <> nil then
    MarksBox.Invalidate;

  if (mBookmarks = nil) or (mBmSep = nil) then
    Exit;

  // Пункты списка - без владельца (Create(nil)), их освобождает сам
  // mBookmarks. С владельцем-формой они входили в Form1.ComponentCount, а
  // по нему считается отпечаток состава формы (OwnFormPrint): у вкладок с
  // разным числом закладок он был разный, и при каждом переходе снимок
  // формы снимался заново, а инспектор разбирал Unit1.dfm целиком.

  while mBookmarks.Count > mBmSep.MenuIndex + 1 do
    mBookmarks.Items[mBookmarks.Count - 1].Free;

  if (FWindowsIndex < 0) or not FWindows[FWindowsIndex].Used or
     (Length(FWindows[FWindowsIndex].Bookmarks) = 0) then
  begin
    It := TMenuItem.Create(nil);
    It.Caption := '(no bookmarks)';
    It.Enabled := False;
    mBookmarks.Add(It);
    Exit;
  end;

  for I := 0 to High(FWindows[FWindowsIndex].Bookmarks) do
  begin
    It := TMenuItem.Create(nil);
    It.Caption := BookmarkCaption(FWindowsIndex, I);
    It.Hint := FWindows[FWindowsIndex].Bookmarks[I].Text; // полная строка
    It.Tag := I;
    It.OnClick := BookmarkItemClick;
    // Строки закладки в файле нет (BmValidateWindow)
    It.Enabled := not FWindows[FWindowsIndex].Bookmarks[I].Missing;
    mBookmarks.Add(It);
  end;
  BmMenuMarks;
end;

// Квадратики с номерами закладок у пунктов списка - такие же, как на
// полосе меток. Закладка на строке с кареткой - текущая: квадратик
// красный, пункт - по умолчанию (Default): строка меню UiMenus выделяет
// его при открытии, меню Windows показывает жирным.
procedure TForm1.BmMenuMarks;
const
  MarkBmpSize = 16;
var
  ItemIdx, BmIdx, CaretLine: Integer;
  MenuItem: TMenuItem;
  IsCurrent: Boolean;
  NumText: string;
  MarkRect: TRect;
  MarkCanvas: TCanvas;
begin
  if (mBookmarks = nil) or (mBmSep = nil) or (FWindowsIndex < 0) or
     not FWindows[FWindowsIndex].Used then
    Exit;
  if RichEdit1.HandleAllocated then
    CaretLine := CurrentLineIndex
  else
    CaretLine := -1;
  for ItemIdx := mBmSep.MenuIndex + 1 to mBookmarks.Count - 1 do
  begin
    MenuItem := mBookmarks.Items[ItemIdx];
    BmIdx := MenuItem.Tag;
    if not Assigned(MenuItem.OnClick) or (BmIdx < 0) or
       (BmIdx > High(FWindows[FWindowsIndex].Bookmarks)) then
      Continue;
    IsCurrent := (FWindows[FWindowsIndex].Bookmarks[BmIdx].LineNo =
                  CaretLine + 1) and
                 not FWindows[FWindowsIndex].Bookmarks[BmIdx].Missing;

    // Рамка в 1 пиксель цвета фуксии вокруг квадратика - прозрачный цвет:
    // меню рисует значок прозрачным по левому нижнему пикселю
    MenuItem.Bitmap.Width := MarkBmpSize;
    MenuItem.Bitmap.Height := MarkBmpSize;
    MarkCanvas := MenuItem.Bitmap.Canvas;
    MarkCanvas.Brush.Style := bsSolid;
    MarkCanvas.Brush.Color := clFuchsia;
    MarkCanvas.FillRect(Rect(0, 0, MarkBmpSize, MarkBmpSize));
    MarkRect := Rect(1, 1, MarkBmpSize - 1, MarkBmpSize - 1);
    MarkCanvas.Pen.Style := psSolid;
    MarkCanvas.Pen.Color := UiColor('Gutter.BmBorder');
    if IsCurrent then
      MarkCanvas.Brush.Color := UiColor('Gutter.BmCurBG')
    else
      MarkCanvas.Brush.Color := UiColor('Gutter.BmBG');
    MarkCanvas.Rectangle(MarkRect.Left, MarkRect.Top, MarkRect.Right,
                         MarkRect.Bottom);
    MarkCanvas.Brush.Style := bsClear;
    MarkCanvas.Font.Name := 'Tahoma';
    MarkCanvas.Font.Height := -10;
    MarkCanvas.Font.Style := [fsBold];
    if IsCurrent then
      MarkCanvas.Font.Color := UiColor('Gutter.BmCurText')
    else
      MarkCanvas.Font.Color := UiColor('Gutter.BmText');
    NumText := IntToStr((BmIdx + 1) mod 100);
    DrawTextA(MarkCanvas.Handle, PChar(NumText), Length(NumText), MarkRect,
              DT_CENTER or DT_VCENTER or DT_SINGLELINE or DT_NOCLIP);

    if MenuItem.Default <> IsCurrent then
      MenuItem.Default := IsCurrent;
  end;
end;

// Проверка закладок окна WinIdx по его тексту (FWindows[].Text).
//
// Номер строки в .prj записан на момент сохранения проекта. Если файл с
// тех пор изменился вне окна (git pull, правка в другом редакторе), номер
// указывает на другую строку. Для каждой закладки:
//   - строка LineNo без отступов равна тексту закладки - всё на месте;
//   - иначе по всему тексту ищутся строки, равные тексту закладки; из них
//     берётся ближайшая к прежнему номеру (выше или ниже - смотря что
//     удаляли или вставляли), номер и позиция исправляются;
//   - такой строки нет - закладка помечается Missing: пункт меню серый,
//     метки на полосе нет. Номер остаётся прежним.
// Вызывается при загрузке проекта для каждого окна и при показе окна.

// Строка ALine без пробелов и табуляций по краям равна AText. Без Trim:
// при поиске сравнение идёт с каждой строкой файла, а Trim на каждую
// строку - выделение памяти.
function BmLineIs(const ALine, AText: string): Boolean;
var
  FirstCol, LastCol: Integer;
begin
  Result := False;
  FirstCol := 1;
  LastCol := Length(ALine);
  while (FirstCol <= LastCol) and (ALine[FirstCol] <= ' ') do
    Inc(FirstCol);
  while (LastCol >= FirstCol) and (ALine[LastCol] <= ' ') do
    Dec(LastCol);
  if LastCol - FirstCol + 1 <> Length(AText) then
    Exit;
  if Length(AText) = 0 then
  begin
    Result := True;
    Exit;
  end;
  Result := CompareMem(@ALine[FirstCol], @AText[1], Length(AText));
end;

procedure TForm1.BmValidateWindow(WinIdx: Integer);
var
  TextLines: TStringList;
  BmIdx, LineIdx, OldIdx, BestIdx, PosInLine: Integer;
  LineStarts: array of Integer;
  BmText: string;
begin
  if (WinIdx < 0) or (WinIdx > WindowsItemCount - 1) or
     not FWindows[WinIdx].Used or
     (Length(FWindows[WinIdx].Bookmarks) = 0) then
    Exit;
  TextLines := TStringList.Create;
  try
    TextLines.Text := FWindows[WinIdx].Text;
    // Начала строк в координатах редактора: перевод строки - один символ
    SetLength(LineStarts, TextLines.Count + 1);
    LineStarts[0] := 0;
    for LineIdx := 0 to TextLines.Count - 1 do
      LineStarts[LineIdx + 1] := LineStarts[LineIdx] +
                                 Length(TextLines[LineIdx]) + 1;

    for BmIdx := 0 to High(FWindows[WinIdx].Bookmarks) do
    begin
      BmText := FWindows[WinIdx].Bookmarks[BmIdx].Text;
      FWindows[WinIdx].Bookmarks[BmIdx].Missing := False;
      if BmText = '' then
        Continue;
      OldIdx := FWindows[WinIdx].Bookmarks[BmIdx].LineNo - 1;
      if (OldIdx >= 0) and (OldIdx < TextLines.Count) and
         BmLineIs(TextLines[OldIdx], BmText) then
        BestIdx := OldIdx
      else
      begin
        BestIdx := -1;
        for LineIdx := 0 to TextLines.Count - 1 do
          if BmLineIs(TextLines[LineIdx], BmText) then
            if (BestIdx < 0) or
               (Abs(LineIdx - OldIdx) < Abs(BestIdx - OldIdx)) then
              BestIdx := LineIdx;
      end;
      if BestIdx < 0 then
      begin
        FWindows[WinIdx].Bookmarks[BmIdx].Missing := True;
        Continue;
      end;
      // Позиция - на первом символе текста, после отступа
      PosInLine := 0;
      while (PosInLine < Length(TextLines[BestIdx])) and
            (TextLines[BestIdx][PosInLine + 1] in [' ', #9]) do
        Inc(PosInLine);
      FWindows[WinIdx].Bookmarks[BmIdx].LineNo := BestIdx + 1;
      FWindows[WinIdx].Bookmarks[BmIdx].CharPos :=
        LineStarts[BestIdx] + PosInLine;
    end;
  finally
    TextLines.Free;
  end;
end;

// Строка с текстом закладки, ближайшая к прежней позиции AOldPos - и выше,
// и ниже неё. Выше - если часть текста над закладкой удалили, ниже - если
// вставили. Годится только строка, которая без отступов РАВНА тексту
// закладки: вхождение внутри более длинной строки не считается.
// Ответ - позиция текста, -1 - такой строки нет.
function TForm1.BmFindNearest(const AText: string; AOldPos: Integer): Integer;
var
  TextLen, SearchPos, HitPos, BeforePos, AfterPos: Integer;

  function WholeLine(APos: Integer): Boolean;
  var
    HitLine: Integer;
  begin
    HitLine := SendMessageA(RichEdit1.Handle, EM_EXLINEFROMCHAR, 0, APos);
    Result := (HitLine >= 0) and (HitLine < RichEdit1.Lines.Count) and
              (Trim(RichEdit1.Lines[HitLine]) = AText);
  end;

begin
  Result := -1;
  if (AText = '') or not RichEdit1.HandleAllocated then
    Exit;
  TextLen := RichEdit1.GetTextLen;
  if AOldPos < 0 then
    AOldPos := 0;
  if AOldPos > TextLen then
    AOldPos := TextLen;

  // Первая подходящая строка от прежней позиции вниз
  AfterPos := -1;
  SearchPos := AOldPos;
  while SearchPos < TextLen do
  begin
    HitPos := FindTextEd(AText, SearchPos, TextLen - SearchPos, [stMatchCase]);
    if HitPos < 0 then
      Break;
    if WholeLine(HitPos) then
    begin
      AfterPos := HitPos;
      Break;
    end;
    SearchPos := HitPos + 1;
  end;

  // Последняя подходящая строка выше прежней позиции
  BeforePos := -1;
  SearchPos := 0;
  while SearchPos < AOldPos do
  begin
    HitPos := FindTextEd(AText, SearchPos,
                         AOldPos + Length(AText) - SearchPos, [stMatchCase]);
    if (HitPos < 0) or (HitPos >= AOldPos) then
      Break;
    if WholeLine(HitPos) then
      BeforePos := HitPos;
    SearchPos := HitPos + 1;
  end;

  if AfterPos < 0 then
    Result := BeforePos
  else if BeforePos < 0 then
    Result := AfterPos
  else if AfterPos - AOldPos <= AOldPos - BeforePos then
    Result := AfterPos
  else
    Result := BeforePos;
end;

// Номера строк в подписях пунктов закладок - без пересборки списка
procedure TForm1.BmMenuCaptionsUpdate;
var
  ItemIdx, BmIdx: Integer;
  NewCaption: string;
begin
  if (mBookmarks = nil) or (mBmSep = nil) or (FWindowsIndex < 0) or
     not FWindows[FWindowsIndex].Used then
    Exit;
  for ItemIdx := mBmSep.MenuIndex + 1 to mBookmarks.Count - 1 do
  begin
    BmIdx := mBookmarks.Items[ItemIdx].Tag;
    if (BmIdx < 0) or (BmIdx > High(FWindows[FWindowsIndex].Bookmarks)) or
       not Assigned(mBookmarks.Items[ItemIdx].OnClick) then
      Continue;
    NewCaption := BookmarkCaption(FWindowsIndex, BmIdx);
    if mBookmarks.Items[ItemIdx].Caption <> NewCaption then
      mBookmarks.Items[ItemIdx].Caption := NewCaption;
  end;
end;

// Переход по закладке
procedure TForm1.BookmarkItemClick(Sender: TObject);
var
  I: Integer;
begin
  if not (Sender is TMenuItem) then
    Exit;

  I := TMenuItem(Sender).Tag;
  JumpToBookmark(FWindowsIndex, I, True);

  // Номер строки мог измениться - правим подпись ЭТОГО пункта на месте.
  // Пересобирать список нельзя: он освободил бы сам Sender.
  if (FWindowsIndex >= 0) and FWindows[FWindowsIndex].Used and
     (I >= 0) and (I <= High(FWindows[FWindowsIndex].Bookmarks)) then
  begin
    TMenuItem(Sender).Caption := BookmarkCaption(FWindowsIndex, I);
    TMenuItem(Sender).Hint := FWindows[FWindowsIndex].Bookmarks[I].Text;
  end;
end;

// Add BookMark: ставит закладку на строку, где стоит каретка
procedure TForm1.BmAddClick(Sender: TObject);
var
  LineIdx, N, I: Integer;
  Sel: TCharRange;
begin
  if (FWindowsIndex < 0) or not FWindows[FWindowsIndex].Used then
  begin
    ShowMessage('9421:Нет открытого окна.');
    Exit;
  end;

  LineIdx := CurrentLineIndex;

  // Повторную закладку на той же строке не добавляем
  for I := 0 to High(FWindows[FWindowsIndex].Bookmarks) do
    if FWindows[FWindowsIndex].Bookmarks[I].LineNo = LineIdx + 1 then
    begin
      ShowMessage('9431:На этой строке закладка уже есть.');
      Exit;
    end;

  SendMessageA(RichEdit1.Handle, EM_EXGETSEL, 0, Integer(@Sel));

  N := Length(FWindows[FWindowsIndex].Bookmarks);
  SetLength(FWindows[FWindowsIndex].Bookmarks, N + 1);
  FWindows[FWindowsIndex].Bookmarks[N].LineNo := LineIdx + 1;
  FWindows[FWindowsIndex].Bookmarks[N].CharPos := Sel.cpMin;
  if LineIdx < RichEdit1.Lines.Count then
    FWindows[FWindowsIndex].Bookmarks[N].Text := Trim(RichEdit1.Lines[LineIdx])
  else
    FWindows[FWindowsIndex].Bookmarks[N].Text := '';

  // Новая закладка - сразу в историю посещений, а значит, и в Hot Bookmarks
  PushBmHistory(FWindowsIndex, N);
  RebuildBookmarksMenu;
end;

// Delete BookMark: убирает закладку со строки, где стоит каретка
procedure TForm1.BmDeleteClick(Sender: TObject);
var
  LineIdx, I, J: Integer;
begin
  if (FWindowsIndex < 0) or not FWindows[FWindowsIndex].Used then
    Exit;

  LineIdx := CurrentLineIndex;

  for I := 0 to High(FWindows[FWindowsIndex].Bookmarks) do
    if FWindows[FWindowsIndex].Bookmarks[I].LineNo = LineIdx + 1 then
    begin
      for J := I to High(FWindows[FWindowsIndex].Bookmarks) - 1 do
        FWindows[FWindowsIndex].Bookmarks[J] :=
          FWindows[FWindowsIndex].Bookmarks[J + 1];
      SetLength(FWindows[FWindowsIndex].Bookmarks,
                Length(FWindows[FWindowsIndex].Bookmarks) - 1);
      BmHistDeleted(FWindowsIndex, I);
      RebuildBookmarksMenu;
      Exit;
    end;

  // Без окна сообщения - строкой состояния
  StatusBar1.SimpleText := 'На этой строке закладки нет';
  StatusBar1.SimplePanel := True;
end;

// Sort BookMark: упорядочивает список по номеру строки.
// Закладок в окне единицы, поэтому обычная сортировка вставками.
procedure TForm1.BmSortClick(Sender: TObject);
var
  I, J, HistIdx: Integer;
  Tmp: TBookmark;
  TmpOrig: Integer;
  OrigIdx: array of Integer;   // прежний номер закладки на месте I
  NewIdx: array of Integer;    // новый номер закладки с прежним номером
begin
  if (FWindowsIndex < 0) or not FWindows[FWindowsIndex].Used then
    Exit;

  SetLength(OrigIdx, Length(FWindows[FWindowsIndex].Bookmarks));
  for I := 0 to High(OrigIdx) do
    OrigIdx[I] := I;

  for I := 1 to High(FWindows[FWindowsIndex].Bookmarks) do
  begin
    Tmp := FWindows[FWindowsIndex].Bookmarks[I];
    TmpOrig := OrigIdx[I];
    J := I - 1;
    while (J >= 0) and
          (FWindows[FWindowsIndex].Bookmarks[J].LineNo > Tmp.LineNo) do
    begin
      FWindows[FWindowsIndex].Bookmarks[J + 1] :=
        FWindows[FWindowsIndex].Bookmarks[J];
      OrigIdx[J + 1] := OrigIdx[J];
      Dec(J);
    end;
    FWindows[FWindowsIndex].Bookmarks[J + 1] := Tmp;
    OrigIdx[J + 1] := TmpOrig;
  end;

  // История хранит номера закладок - переводим на новые
  SetLength(NewIdx, Length(OrigIdx));
  for I := 0 to High(OrigIdx) do
    NewIdx[OrigIdx[I]] := I;
  for HistIdx := 0 to High(FBmHistWin) do
    if (FBmHistWin[HistIdx] = FWindowsIndex) and
       (FBmHistIdx[HistIdx] >= 0) and (FBmHistIdx[HistIdx] <= High(NewIdx)) then
      FBmHistIdx[HistIdx] := NewIdx[FBmHistIdx[HistIdx]];

  RebuildBookmarksMenu;
end;

// Закладка BmIdx окна WinIdx - из списка; номера следующих сдвигаются,
// история переходов (LastBM) - тоже
procedure TForm1.BmDeleteAt(WinIdx, BmIdx: Integer);
var
  MoveIdx: Integer;
begin
  if (WinIdx < 0) or not FWindows[WinIdx].Used or (BmIdx < 0) or
     (BmIdx > High(FWindows[WinIdx].Bookmarks)) then
    Exit;
  for MoveIdx := BmIdx to High(FWindows[WinIdx].Bookmarks) - 1 do
    FWindows[WinIdx].Bookmarks[MoveIdx] := FWindows[WinIdx].Bookmarks[MoveIdx + 1];
  SetLength(FWindows[WinIdx].Bookmarks, Length(FWindows[WinIdx].Bookmarks) - 1);
  BmHistDeleted(WinIdx, BmIdx);
end;

// Закладки текущего окна - заново по его тексту в редакторе: какие строки
// есть (номера поправляются), каких нет (Missing). Ответ - сколько нет.
function TForm1.BmRefreshMissing: Integer;
var
  BmIdx: Integer;
begin
  Result := 0;
  if (FWindowsIndex < 0) or not FWindows[FWindowsIndex].Used then
    Exit;
  StoreCurrentWindow;            // текст редактора - в FWindows[].Text
  BmValidateWindow(FWindowsIndex);
  for BmIdx := 0 to High(FWindows[FWindowsIndex].Bookmarks) do
    if FWindows[FWindowsIndex].Bookmarks[BmIdx].Missing then
      Inc(Result);
end;

// Clear List: закладки окна списком с галками, удаляются отмеченные
procedure TForm1.BmClearClick(Sender: TObject);
var
  Dlg: TDlgBmClear;
  BmIdx, Removed: Integer;
  ItemText: string;
begin
  if (FWindowsIndex < 0) or not FWindows[FWindowsIndex].Used then
    Exit;
  if Length(FWindows[FWindowsIndex].Bookmarks) = 0 then
    Exit;
  BmRefreshMissing;

  Dlg := TDlgBmClear.Create(Self);
  try
    Dlg.lblTitle.Caption := 'Закладки ' +
      ExtractFileName(FWindows[FWindowsIndex].FileName) +
    ': отмеченные будут удалены';
  for BmIdx := 0 to High(FWindows[FWindowsIndex].Bookmarks) do
    begin
      ItemText := IntToStr(BmIdx + 1) + '.  ' +
                  BookmarkCaption(FWindowsIndex, BmIdx);
      if FWindows[FWindowsIndex].Bookmarks[BmIdx].Missing then
        // Objects <> nil - признак несуществующей (DlgBmClear)
        Dlg.lstBm.Items.AddObject(ItemText + '   [строки нет в файле]',
                                  TObject(1))
      else
        Dlg.lstBm.Items.Add(ItemText);
      Dlg.lstBm.Checked[BmIdx] := True;
    end;
    Dlg.UpdateCount;
    UiApplyForm(Dlg);
    if Dlg.ShowModal <> mrOk then
      Exit;

    // С конца: номера ещё не удалённых не сдвигаются
    Removed := 0;
    for BmIdx := Dlg.lstBm.Items.Count - 1 downto 0 do
      if Dlg.lstBm.Checked[BmIdx] then
      begin
        BmDeleteAt(FWindowsIndex, BmIdx);
        Inc(Removed);
      end;
  finally
    Dlg.Free;
  end;
  if Removed > 0 then
    RebuildBookmarksMenu;
end;

// Delete Missing: закладки, строк которых в файле больше нет (серые в
// списке), - из списка
procedure TForm1.BmDelMissingClick(Sender: TObject);
var
  BmIdx, MissingCount: Integer;
begin
  if (FWindowsIndex < 0) or not FWindows[FWindowsIndex].Used then
    Exit;
  MissingCount := BmRefreshMissing;
  if MissingCount = 0 then
  begin
    RebuildBookmarksMenu;        // номера строк могли поправиться
    ShowMessage('9515:Несуществующих закладок в этом окне нет.');
    Exit;
  end;
  if MessageDlg('9518:Удалить закладки, строк которых нет в файле: ' +
                IntToStr(MissingCount) + '?',
                mtConfirmation, [mbYes, mbNo], 0) <> mrYes then
  begin
    RebuildBookmarksMenu;
    Exit;
  end;
  for BmIdx := High(FWindows[FWindowsIndex].Bookmarks) downto 0 do
    if FWindows[FWindowsIndex].Bookmarks[BmIdx].Missing then
      BmDeleteAt(FWindowsIndex, BmIdx);
  RebuildBookmarksMenu;
end;


// Подпись пункта меню для закладки: номер строки плюс начало текста.
//
// Строки кода бывают длинными - в HTML запросто на пару сотен символов, - и
// такой пункт растягивает меню на весь экран. Обрезаем для показа, а полный
// текст кладём в Hint: он виден в статус-баре при наведении. В самой записи
// закладки текст остаётся целым, по нему идёт поиск позиции.
function TForm1.BookmarkCaption(WinIdx, BmIdx: Integer): string;
const
  MaxCaptionLen = 70;
begin
  Result := FWindows[WinIdx].Bookmarks[BmIdx].Text;
  if Length(Result) > MaxCaptionLen then
    Result := Copy(Result, 1, MaxCaptionLen) + '...';
  Result := Format('%d %s', [FWindows[WinIdx].Bookmarks[BmIdx].LineNo, Result]);
end;

// Запоминает посещённую закладку: прежняя запись о ней убирается, новая
// встаёт в конец. Каждая закладка в истории один раз, поэтому LastBM
// проходит все посещённые закладки, а не одни и те же две, между которыми
// переходили по меню.
procedure TForm1.PushBmHistory(WinIdx, BmIdx: Integer);
var
  HistIdx, HistLen: Integer;
begin
  for HistIdx := High(FBmHistWin) downto 0 do
    if (FBmHistWin[HistIdx] = WinIdx) and (FBmHistIdx[HistIdx] = BmIdx) then
      BmHistRemoveAt(HistIdx);
  HistLen := Length(FBmHistWin);
  SetLength(FBmHistWin, HistLen + 1);
  SetLength(FBmHistIdx, HistLen + 1);
  FBmHistWin[HistLen] := WinIdx;
  FBmHistIdx[HistLen] := BmIdx;
  FBmHistPos := HistLen + 1;
end;

// Убирает запись истории; указатель остаётся на той же закладке
procedure TForm1.BmHistRemoveAt(HistIdx: Integer);
var
  MoveIdx: Integer;
begin
  if (HistIdx < 0) or (HistIdx > High(FBmHistWin)) then
    Exit;
  for MoveIdx := HistIdx to High(FBmHistWin) - 1 do
  begin
    FBmHistWin[MoveIdx] := FBmHistWin[MoveIdx + 1];
    FBmHistIdx[MoveIdx] := FBmHistIdx[MoveIdx + 1];
  end;
  SetLength(FBmHistWin, Length(FBmHistWin) - 1);
  SetLength(FBmHistIdx, Length(FBmHistIdx) - 1);
  if HistIdx < FBmHistPos then
    Dec(FBmHistPos);
  if FBmHistPos > Length(FBmHistWin) then
    FBmHistPos := Length(FBmHistWin);
end;

// Закладки окна сброшены (окно закрыто, перечитано из проекта, Clear)
procedure TForm1.BmHistDropWindow(WinIdx: Integer);
var
  HistIdx: Integer;
begin
  for HistIdx := High(FBmHistWin) downto 0 do
    if FBmHistWin[HistIdx] = WinIdx then
      BmHistRemoveAt(HistIdx);
end;

// Закладка BmIdx окна удалена: её записи убираются, номера следующих
// закладок этого окна сдвигаются на один
procedure TForm1.BmHistDeleted(WinIdx, BmIdx: Integer);
var
  HistIdx: Integer;
begin
  for HistIdx := High(FBmHistWin) downto 0 do
    if FBmHistWin[HistIdx] = WinIdx then
    begin
      if FBmHistIdx[HistIdx] = BmIdx then
        BmHistRemoveAt(HistIdx)
      else if FBmHistIdx[HistIdx] > BmIdx then
        Dec(FBmHistIdx[HistIdx]);
    end;
end;

// Записи на закладки, которых уже нет (окно не занято, номер за концом
// списка), - убрать
procedure TForm1.BmHistCompact;
var
  HistIdx, WinIdx: Integer;
begin
  for HistIdx := High(FBmHistWin) downto 0 do
  begin
    WinIdx := FBmHistWin[HistIdx];
    if (WinIdx < 0) or (WinIdx > WindowsItemCount - 1) or
       not FWindows[WinIdx].Used or (FBmHistIdx[HistIdx] < 0) or
       (FBmHistIdx[HistIdx] > High(FWindows[WinIdx].Bookmarks)) then
      BmHistRemoveAt(HistIdx);
  end;
end;

// Переход на закладку.
//
// Позиция ищется ПО ТЕКСТУ подписи, а не берётся из CharPos: при правке файла
// абсолютное смещение уезжает, а строка кода остаётся той же. CharPos при этом
// не бесполезен - от него начинается поиск, чтобы при нескольких одинаковых
// строках выбралась ближайшая к прежнему месту. Найденная позиция тут же
// записывается обратно, так что закладка сама себя подправляет.
procedure TForm1.JumpToBookmark(WinIdx, BmIdx: Integer; Remember: Boolean);
var
  Txt: string;
  P, StartFrom, NewPos: Integer;
begin
  if (WinIdx < 0) or (WinIdx > WindowsItemCount - 1) then
    Exit;
  if not FWindows[WinIdx].Used then
    Exit;

  // Закладка может быть в другом окне - сначала переключаемся
  if WinIdx <> FWindowsIndex then
    ActivateWindow(WinIdx);

  if (BmIdx < 0) or (BmIdx > High(FWindows[WinIdx].Bookmarks)) then
    Exit;

  NewPos := FWindows[WinIdx].Bookmarks[BmIdx].CharPos;
  Txt := FWindows[WinIdx].Bookmarks[BmIdx].Text;

  if Txt <> '' then
  begin
    // Ищем средствами самого контрола.
    //
    // Раньше здесь был Pos по RichEdit1.Text - и это была ошибка: Text приходит
    // из WM_GETTEXT, где перевод строки может занимать ДВА байта, а EM_SETSEL
    // считает его одним. Смещения расходились тем сильнее, чем больше строк
    // выше. FindText возвращает позицию в тех же координатах, что SelStart.
    //
    // Сначала - строка, равная тексту закладки, ближайшая к прежнему месту
    // выше или ниже (BmFindNearest). Такой нет (строку правили) - прежний
    // поиск вхождения: от прежнего места вниз, потом с начала.
    P := BmFindNearest(Txt, NewPos);
    if P < 0 then
    begin
      StartFrom := NewPos - Length(Txt);
      if StartFrom < 0 then
        StartFrom := 0;
      P := FindTextEd(Txt, StartFrom, RichEdit1.GetTextLen, [stMatchCase]);
      if P < 0 then
        P := FindTextEd(Txt, 0, RichEdit1.GetTextLen, [stMatchCase]);
    end;


    if P >= 0 then
      NewPos := P;
  end;

  // Фокус ставим ДО каретки: контрол показывает её только когда активен,
  // да и прокрутка к каретке в неактивном окне работает не всегда
  if RichEdit1.CanFocus then
    RichEdit1.SetFocus;

  RichEdit1.SelStart := NewPos;
  RichEdit1.SelLength := 0;
  SendMessageA(RichEdit1.Handle, EM_SCROLLCARET, 0, 0);
  CenterCaretLine;

  // Подправляем закладку под актуальное состояние текста
  FWindows[WinIdx].Bookmarks[BmIdx].CharPos := NewPos;
  FWindows[WinIdx].Bookmarks[BmIdx].LineNo :=
    SendMessageA(RichEdit1.Handle, EM_EXLINEFROMCHAR, 0, NewPos) + 1;

  if Remember then
    PushBmHistory(WinIdx, BmIdx);

  // ВНИМАНИЕ: RebuildBookmarksMenu здесь вызывать НЕЛЬЗЯ. Она освобождает
  // пункты списка, в том числе тот, чей OnClick сейчас выполняется, - после
  // возврата из обработчика VCL продолжила бы работать с разрушенным объектом.
  // Обновление подписи оставлено на вызывающую сторону.
  UpdateStatusBarInfo;
end;

// Set BookMark: переставляет на текущую каретку ту закладку, на которую
// переходили последней. Рабочий сценарий - прыгнули по закладке, увидели, что
// она уехала, нашли нужное место руками и поправили её здесь.
procedure TForm1.BmSetClick(Sender: TObject);
var
  WinIdx, BmIdx, LineIdx: Integer;
  Sel: TCharRange;
begin
  if FBmHistPos <= 0 then
  begin
    ShowMessage('9626:Сначала перейдите на закладку, которую нужно переставить.');
    Exit;
  end;

  WinIdx := FBmHistWin[FBmHistPos - 1];
  BmIdx := FBmHistIdx[FBmHistPos - 1];

  if (WinIdx <> FWindowsIndex) or not FWindows[WinIdx].Used then
  begin
    ShowMessage('9635:Последняя закладка была в другом окне.');
    Exit;
  end;
  if (BmIdx < 0) or (BmIdx > High(FWindows[WinIdx].Bookmarks)) then
    Exit;

  SendMessageA(RichEdit1.Handle, EM_EXGETSEL, 0, Integer(@Sel));
  LineIdx := SendMessageA(RichEdit1.Handle, EM_EXLINEFROMCHAR, 0, Sel.cpMin);

  FWindows[WinIdx].Bookmarks[BmIdx].CharPos := Sel.cpMin;
  FWindows[WinIdx].Bookmarks[BmIdx].LineNo := LineIdx + 1;
  FWindows[WinIdx].Bookmarks[BmIdx].Missing := False;
  if LineIdx < RichEdit1.Lines.Count then
    FWindows[WinIdx].Bookmarks[BmIdx].Text := Trim(RichEdit1.Lines[LineIdx]);

  RebuildBookmarksMenu;
end;

// LastBM: шаг назад по истории закладок. Повторные нажатия проходят все
// посещённые закладки от последней к самой ранней; после самой ранней -
// снова последняя.
procedure TForm1.LastBMClick(Sender: TObject);
begin
  BmHistCompact;
  if Length(FBmHistWin) < 2 then
  begin
    // Без окна сообщения - строкой состояния
    StatusBar1.SimpleText := 'Предыдущей закладки нет';
    StatusBar1.SimplePanel := True;
    Exit;
  end;

  Dec(FBmHistPos);
  if FBmHistPos < 1 then
    FBmHistPos := Length(FBmHistWin);
  // Remember = False: переход по истории порядок в ней не меняет, иначе
  // LastBM снова ходил бы между двумя последними
  JumpToBookmark(FBmHistWin[FBmHistPos - 1], FBmHistIdx[FBmHistPos - 1], False);

  // Здесь пересобрать список можно: Sender - это mLastBM, а не пункт списка
  RebuildBookmarksMenu;
end;


// ---------------------------------------------------------------------------
//  Несохранённые изменения
//
//  Спрашиваем в момент, когда активное окно меняется: при переключении через
//  меню Windows, при открытии другого файла, при создании нового и при загрузке
//  проекта. Плюс при выходе.
//
//  Раньше проверять достаточно было ТОЛЬКО текущее окно: каждое переключение
//  задаёт вопрос, а отказ снимает флаг Modified. Инвариант держался сам собой,
//  пока текст правил только человек в редакторе.
//
//  Конструктор форм и инспектор объектов пишут и в НЕактивные вкладки: правка
//  компонента меняет .dfm и .pas сразу, а открыт при этом один из них. Поэтому
//  при выходе спрашиваем ещё и про остальные изменённые окна -
//  ConfirmSaveOthers.
// ---------------------------------------------------------------------------

// Предлагает сохранить текущее окно. False означает "пользователь передумал",
// и вызывающая сторона должна отменить своё действие.
function TForm1.ConfirmSaveCurrent: Boolean;
var
  Nm: string;
begin
  Result := True;

  if (FWindowsIndex < 0) or (FWindowsIndex > WindowsItemCount - 1) then
    Exit;
  if not FWindows[FWindowsIndex].Used then
    Exit;
  if not RichEdit1.Modified then
    Exit;

  if FCurrentFileName <> '' then
    Nm := ExtractFileName(FCurrentFileName)
  else
    Nm := FWindows[FWindowsIndex].FileName;

  case MessageDlg('9708:Сохранить изменения в файле ' + Nm + '?',
                  mtConfirmation, [mbYes, mbNo, mbCancel], 0) of
    mrYes:
      Result := SaveCurrentFile; // сорвалось сохранение - считаем отказом
    mrNo:
    begin
      // Правки остаются в памяти окна, но повторно об этом файле не
      // спрашиваем - иначе вопрос всплывал бы на каждом переключении.
      // Сохранить его по-прежнему можно вручную через Save.
      RichEdit1.Modified := False;
      FWindows[FWindowsIndex].Modified := False;
      Result := True;
    end;
  else
    Result := False; // Отмена
  end;
end;


// Остальные изменённые окна - те, которые правил конструктор или инспектор,
// пока активным было другое. False - человек отменил выход.
function TForm1.ConfirmSaveOthers: Boolean;
var
  Cur, I: Integer;
  Nm: string;
begin
  Result := True;
  Cur := FWindowsIndex;
  for I := 0 to WindowsItemCount - 1 do
  begin
    if (I = Cur) or not FWindows[I].Used or not FWindows[I].Modified then
      Continue;
    Nm := FWindows[I].FileName;
    if Nm = '' then
      Nm := '(без имени)'
    else
      Nm := ExtractFileName(Nm);
    case MessageDlg('9745:Сохранить изменения в файле ' + Nm + '?',
                    mtConfirmation, [mbYes, mbNo, mbCancel], 0) of
      mrYes:
      begin
        ActivateWindow(I);       // сохраняем через обычный путь
        if not SaveCurrentFile then
        begin
          Result := False;
          Break;
        end;
      end;
      mrNo:
      // Правки остаются в памяти окна до конца работы программы
        FWindows[I].Modified := False;
    else
      Result := False;
      Break;
    end;
  end;

  if (FWindowsIndex <> Cur) and (Cur >= 0) and (Cur < WindowsItemCount) and
     FWindows[Cur].Used then
    ActivateWindow(Cur);
end;

function TForm1.SaveSourcesBeforeBuild: Boolean;
var
  Current, Index: Integer;
  Ext, FileLabel: string;
begin
  Result := True;
  Current := FWindowsIndex;
  for Index := 0 to WindowsItemCount - 1 do
  begin
    if (Index = Current) or not FWindows[Index].Used or
       not FWindows[Index].Modified then
      Continue;
    if (FWindows[Index].FileName = '') or
       IsUntitledName(FWindows[Index].FileName) then
      Continue;               // файл без имени к сборке не относится
    Ext := LowerCase(ExtractFileExt(FWindows[Index].FileName));
    // Сборка RapidQ: её исходники - .bas и include (.inc, .bi)
    if FBuildRapidQ then
    begin
      if (Ext <> '.bas') and (Ext <> '.rqb') and (Ext <> '.rq') and
         (Ext <> '.inc') and (Ext <> '.bi') then
        Continue;
    end
    else if (Ext <> '.pas') and (Ext <> '.dfm') and (Ext <> '.dpr') and
            (Ext <> '.inc') then
      Continue;
    FileLabel := ExtractFileName(FWindows[Index].FileName);
    ActivateWindow(Index);    // сохраняем через обычный путь
    if not SaveCurrentFile then
    begin
      LogComp('Компиляция отменена: не удалось сохранить ' + FileLabel);
      Result := False;
      Break;
    end;
    LogComp('Сохранено перед сборкой: ' + FileLabel);
  end;
  if (FWindowsIndex <> Current) and (Current >= 0) and
     (Current < WindowsItemCount) and FWindows[Current].Used then
    ActivateWindow(Current);
end;

// Save Project: все изменённые окна - на диск, без вопросов. Текущее - по
// флагу редактора (запись окна обновляется только при уходе с вкладки),
// остальные - по записям окон: их правки могли прийти и от конструктора с
// инспектором. Сохранение - обычным путём, SaveCurrentFile: окно без имени
// спросит имя, файл, изменённый на диске снаружи, - что делать. Окно,
// которое сохранить не удалось или имени для которого не дали, остаётся
// изменённым и попадает в AFailed. False - такие есть.
function TForm1.SaveAllModified(AFailed: TStrings): Boolean;
var
  Cur, I: Integer;
  Nm: string;
begin
  Result := True;
  Cur := FWindowsIndex;

  if (Cur >= 0) and (Cur < WindowsItemCount) and FWindows[Cur].Used and
     RichEdit1.Modified then
  begin
    Nm := ExtractFileName(FWindows[Cur].FileName);
    if not SaveCurrentFile then
    begin
      Result := False;
      AFailed.Add(Nm);
    end;
  end;

  for I := 0 to WindowsItemCount - 1 do
  begin
    if (I = Cur) or not FWindows[I].Used or not FWindows[I].Modified then
      Continue;
    Nm := ExtractFileName(FWindows[I].FileName);
    ActivateWindow(I);       // сохраняем через обычный путь
    if not SaveCurrentFile then
    begin
      Result := False;
      AFailed.Add(Nm);
    end;
  end;

  if (FWindowsIndex <> Cur) and (Cur >= 0) and (Cur < WindowsItemCount) and
     FWindows[Cur].Used then
    ActivateWindow(Cur);
end;

// Все изменённые окна: текущее и остальные. Перед тем, что закрывает
// окна разом, - загрузка и закрытие проекта, новый проект. Переключение
// окон о сохранении не спрашивает, поэтому изменённых может быть
// несколько. False - человек отменил.
function TForm1.ConfirmSaveAll: Boolean;
begin
  AutoSaveEditorFiles;
  Result := ConfirmSaveCurrent;
  if Result then
    Result := ConfirmSaveOthers;
end;

// ---------------------------------------------------------------------------
//  Вкладки
//
//  Вкладка - это ярлык на окно из FWindows, не отдельная сущность. Поэтому
//  TTabControl, а не TPageControl: страницы не нужны, текст всегда показывает
//  один и тот же RichEdit, меняется лишь то, какое окно в него подставлено.
//
//  Набор вкладок складывается сам: вкладка появляется в момент, когда окно
//  становится активным. Так в панели оседают файлы, с которыми реально
//  работают, а остальные остаются доступны через меню Windows.
//
//  Новая вкладка встаёт в конец, кроме одноимённых .pas и .dfm: они
//  всегда рядом, модуль слева, форма справа (TabInsertPos). То же при
//  загрузке проекта - пары собираются, в каком бы порядке вкладки ни
//  лежали в .prj.
// ---------------------------------------------------------------------------

function TForm1.TabIndexOfWindow(WinIdx: Integer): Integer;
var
  I: Integer;
begin
  Result := -1;
  for I := 0 to High(FTabWin) do
    if FTabWin[I] = WinIdx then
    begin
      Result := I;
      Exit;
    end;
end;

// Место для новой вкладки окна WinIdx. У .pas и .dfm ищется вкладка
// одноимённой пары - тот же путь, другое из двух расширений: модуль
// встаёт перед формой, форма - сразу за модулем. Пары нет или файл
// другого типа - в конец.
function TForm1.TabInsertPos(WinIdx: Integer): Integer;
var
  I, W: Integer;
  Ext, PairExt, Base: string;
begin
  Result := Length(FTabWin);
  Ext := LowerCase(ExtractFileExt(FWindows[WinIdx].FileName));
  if Ext = '.pas' then
    PairExt := '.dfm'
  else if Ext = '.dfm' then
    PairExt := '.pas'
  else
    Exit;
  Base := ChangeFileExt(FWindows[WinIdx].FileName, '');

  for I := 0 to High(FTabWin) do
  begin
    W := FTabWin[I];
    if (W < 0) or (W > WindowsItemCount - 1) or not FWindows[W].Used then
      Continue;
    if (LowerCase(ExtractFileExt(FWindows[W].FileName)) = PairExt) and
       (CompareText(ChangeFileExt(FWindows[W].FileName, ''), Base) = 0) then
    begin
      if Ext = '.pas' then
        Result := I
      else
        Result := I + 1;
      Exit;
    end;
  end;
end;

// Вкладка окна WinIdx на место APos, остальные сдвигаются вправо.
// Соответствие FTabWin заполняем ДО вставки в панель: Tabs.Insert
// немедленно вызывает перерисовку, и TabsDrawTab уже должна знать, какому
// окну принадлежит каждый индекс. Иначе она выходит, не нарисовав ничего.
// Вызывать под FLockTabs.
procedure TForm1.InsertTabAt(APos, WinIdx: Integer);
var
  I: Integer;
begin
  if (APos < 0) or (APos > Length(FTabWin)) then
    APos := Length(FTabWin);
  SetLength(FTabWin, Length(FTabWin) + 1);
  for I := High(FTabWin) downto APos + 1 do
    FTabWin[I] := FTabWin[I - 1];
  FTabWin[APos] := WinIdx;
  FTabs.Tabs.Insert(APos, TabCaptionFor(WinIdx));
end;

// Показывает вкладку окна, создавая её при необходимости
procedure TForm1.EnsureTab(WinIdx: Integer);
var
  I: Integer;
begin
  if FTabs = nil then
    Exit;
  if (WinIdx < 0) or (WinIdx > WindowsItemCount - 1) then
    Exit;
  if not FWindows[WinIdx].Used then
    Exit;

  // Все изменения делаем под замком: присваивание TabIndex поднимает
  // OnChanging и OnChange, а они снова полезли бы переключать окна
  FLockTabs := True;
  try
    I := TabIndexOfWindow(WinIdx);
    if I < 0 then
    begin
      // В конец, а одноимённые .pas и .dfm - рядом
      I := TabInsertPos(WinIdx);
      InsertTabAt(I, WinIdx);
      FNewTabAdded := True;
    end;
    FTabs.TabIndex := I;
  finally
    FLockTabs := False;
  end;

  // Состав окон изменился - одноимённые вкладки могли стать неоднозначными
  if FNewTabAdded then
  begin
    FNewTabAdded := False;
    RefreshAllTabCaptions;
  end;
end;

// Подпись вкладки после Save As: имя файла могло измениться
procedure TForm1.UpdateTabCaption(WinIdx: Integer);
var
  I: Integer;
begin
  if FTabs = nil then
    Exit;
  I := TabIndexOfWindow(WinIdx);
  if I < 0 then
    Exit;

  FLockTabs := True;
  try
    FTabs.Tabs[I] := TabCaptionFor(WinIdx);
  finally
    FLockTabs := False;
  end;
end;

// Вопрос о несохранённом задаём ДО смены вкладки: если пользователь передумал,
// достаточно запретить переключение, и возвращать выбор назад не придётся.
// Подписи всех вкладок разом.
//
// Нужна там, где меняется СОСТАВ окон: появление второго Unit1.pas меняет
// подпись и у первого, а он про это сам не узнает.
procedure TForm1.RefreshAllTabCaptions;
var
  I: Integer;
begin
  if FTabs = nil then
    Exit;

  FLockTabs := True;
  try
    for I := 0 to FTabs.Tabs.Count - 1 do
      if (I <= High(FTabWin)) and (FTabWin[I] >= 0) and
         (FTabWin[I] < WindowsItemCount) and FWindows[FTabWin[I]].Used then
        FTabs.Tabs[I] := TabCaptionFor(FTabWin[I]);
  finally
    FLockTabs := False;
  end;
end;

// Смена вкладки не спрашивает о сохранении: окно не закрывается, его текст
// и признак изменений остаются в слоте. Изменённые вкладки помечены
// маркером; вопрос - при закрытии вкладки, смене проекта и выходе.
procedure TForm1.TabsChanging(Sender: TObject; var AllowChange: Boolean);
begin
  AllowChange := True;
end;

// Клик по вкладке обрабатывается так же, как клик в меню Windows
procedure TForm1.TabsChange(Sender: TObject);
var
  W: Integer;
begin
  if FLockTabs then
    Exit;
  if (FTabs.TabIndex < 0) or (FTabs.TabIndex > High(FTabWin)) then
    Exit;

  W := FTabWin[FTabs.TabIndex];
  if W = FWindowsIndex then
    Exit;

  ActivateWindow(W);
end;


// Знак между именем файла и его главным .bas на вкладке ("Lib.inc « Main.bas")
const
  TabOwnerMark = ' « ';
  // Начало подписи вкладки файла с видом "по формату": место под кнопку
  // Txt / Fmt. Сам текст не рисуется - ширину вкладки Windows считает по
  // подписи, а на этом месте рисуется кнопка (TabsDrawTab). Одна строка
  // для обоих видов: при переключении ширина вкладки не меняется.
  TabFmtPrefix = 'Fmt';
  // Поля кнопки Txt / Fmt по ширине (слева и справа вместе), пикселей
  TabFmtPadding = 4;

  // Подпись вкладки. Пробелы по краям - не украшение: ширину вкладки Windows
  // считает по тексту, а нам нужно место под маркер изменений слева и крестик
  // справа. Owner-draw поверх этого рисует настоящее содержимое.
  // Имя файла и папки и при прямых косых в пути (D:/папка/файл.inc - так путь
  // приходит из сообщений компилятора): ExtractFileName Delphi 7 делит путь
  // только по "\" и ":"
function TabFileName(const APath: string): string;
begin
  Result := ExtractFileName(StringReplace(APath, '/', '\', [rfReplaceAll]));
end;

function TabDirName(const APath: string): string;
begin
  Result := ExtractFileName(ExcludeTrailingPathDelimiter(
    ExtractFilePath(StringReplace(APath, '/', '\', [rfReplaceAll]))));
end;

function TForm1.TabCaptionFor(WinIdx: Integer): string;
var
  I: Integer;
  IsMod, Dup: Boolean;
  Nm, Dir: string;
begin
  // У активного окна флаг берём у самого редактора: в записи окна он
  // обновляется только при переключении
  if WinIdx = FWindowsIndex then
    IsMod := RichEdit1.Modified
  else
    IsMod := FWindows[WinIdx].Modified;

  Nm := TabFileName(FWindows[WinIdx].FileName);

  // Если такое же имя занято другим окном, дописываем папку. Два разных
  // Unit1.pas на вкладках иначе неотличимы, и второй из них выглядит как
  // лишняя вкладка, открытая вместо переключения на первый.
  Dup := False;
  for I := 0 to WindowsItemCount - 1 do
    if (I <> WinIdx) and FWindows[I].Used and
       (CompareText(TabFileName(FWindows[I].FileName), Nm) = 0) then
    begin
      Dup := True;
      Break;
    end;

  if Dup then
  begin
    Dir := TabDirName(FWindows[WinIdx].FileName);
    if Dir <> '' then
      Nm := Nm + ' [' + Dir + ']';
  end;

  // Полный путь и главный .bas файла $INCLUDE - в подсказке (TabHintFor),
  // на вкладке только имя: длинные подписи не помещаются
  Result := Nm;
  if IsMod then
    Result := '* ' + Result;
  // Место под кнопку Txt / Fmt - самым первым, у левого края вкладки
  if TabHasFmtView(WinIdx) then
    Result := TabFmtPrefix + Result;

  // Хвост под кнопку закрытия. Клик по ней ловится по координате X,
  // см. TabsMouseDown и TabCloseWidth.
  Result := Result + '   x';
end;

// Подсказка вкладки: полный путь, главный .bas (файл подключён через
// $INCLUDE), признак несохранённых изменений
function TForm1.TabHintFor(WinIdx: Integer): string;
var
  IsMod: Boolean;
begin
  Result := '';
  if (WinIdx < 0) or (WinIdx > WindowsItemCount - 1) or not FWindows[WinIdx].Used then
    Exit;
  Result := StringReplace(FWindows[WinIdx].FileName, '/', '\', [rfReplaceAll]);
  if FWindows[WinIdx].IncOwner <> '' then
    Result := Result + #13#10'Подключён в ' +
              StringReplace(FWindows[WinIdx].IncOwner, '/', '\', [rfReplaceAll]);
  if WinIdx = FWindowsIndex then
    IsMod := RichEdit1.Modified
  else
    IsMod := FWindows[WinIdx].Modified;
  if IsMod then
    Result := Result + #13#10'Изменён, не сохранён';
  if TabHasFmtView(WinIdx) then
    Result := Result + #13#10'Txt / Fmt слева - текст / по формату (F12)';
end;

// Подсказка - у вкладки под мышью. Сменилась вкладка - прежнюю подсказку
// убираем (CancelHint), новая появится после обычной задержки
procedure TForm1.TabsMouseMove(Sender: TObject; Shift: TShiftState; X, Y: Integer);
var
  Idx: Integer;
begin
  Idx := FTabs.IndexOfTabAt(X, Y);
  if Idx = FTabHintIdx then
    Exit;
  FTabHintIdx := Idx;
  if (Idx >= 0) and (Idx <= High(FTabWin)) then
    FTabs.Hint := TabHintFor(FTabWin[Idx])
  else
    FTabs.Hint := '';
  Application.CancelHint;
end;

// Подпись вкладки рисуем сами: у активной фон салатовый, хвост "x" -
// красный. Шрифт у всех вкладок одинаковый, чтобы ширину, которую Windows
// считает по тексту подписи, не распирало.
procedure TForm1.TabsDrawTab(ADC: HDC; const ARect: TRect; ATab: Integer;
                             AActive: Boolean);
var
  C: TCanvas;
  S, Main, Cross, OwnerPart: string;
  P, X, Y, OwnerPos: Integer;
  TabWin, FmtWidth, BtnWidth, BtnHeight: Integer;
  HasFmt, ShowFmt: Boolean;
  BtnRect: TRect;
  BtnText: string;
  TextColor, BackColor: TColor;
begin
  C := TCanvas.Create;
  try
    C.Handle := ADC;
    if AActive then
      C.Brush.Color := UiColor('Tabs.ActiveBG')
    else
      C.Brush.Color := UiColor('Tabs.InactiveBG');
    C.Brush.Style := bsSolid;
    C.FillRect(ARect);

    if (ATab < 0) or (ATab >= FTabs.Tabs.Count) then
      Exit;
    S := FTabs.Tabs[ATab];

    // Хвост подписи - кнопка закрытия (см. TabCaptionFor и TabCloseWidth)
    Main := S;
    Cross := '';
    P := Length(S);
    while (P > 0) and (S[P] = ' ') do
      Dec(P);
    if (P > 0) and (S[P] = 'x') then
    begin
      Cross := 'x';
      Main := TrimRight(Copy(S, 1, P - 1));
    end;

    C.Font := FTabs.Font;
    C.Font.Color := UiColor('Tabs.Text');
    C.Brush.Style := bsClear;

    // Кнопка Txt / Fmt (TabCaptionFor: место под неё - TabFmtPrefix)
    TabWin := -1;
    if ATab <= High(FTabWin) then
      TabWin := FTabWin[ATab];
    HasFmt := TabHasFmtView(TabWin) and
              (Copy(Main, 1, Length(TabFmtPrefix)) = TabFmtPrefix);
    FmtWidth := 0;
    if HasFmt then
    begin
      Delete(Main, 1, Length(TabFmtPrefix));
      FmtWidth := C.TextWidth(TabFmtPrefix);
      ShowFmt := FWindows[TabWin].FmtShown;
      // Прямоугольник: ширина - по надписи (шире из Txt и Fmt, чтобы при
      // переключении кнопка не меняла размер), высота - по вкладке
      C.Font.Size := 7;
      C.Font.Style := [fsBold];
      BtnWidth := C.TextWidth('Txt');
      if C.TextWidth('Fmt') > BtnWidth then
        BtnWidth := C.TextWidth('Fmt');
      BtnWidth := BtnWidth + TabFmtPadding;
      BtnHeight := (ARect.Bottom - ARect.Top) - 6;
      if BtnHeight < C.TextHeight('Txt') + 2 then
        BtnHeight := C.TextHeight('Txt') + 2;
      BtnRect.Left := ARect.Left + 5;
      BtnRect.Top := ARect.Top + ((ARect.Bottom - ARect.Top) - BtnHeight) div 2;
      BtnRect.Right := BtnRect.Left + BtnWidth;
      BtnRect.Bottom := BtnRect.Top + BtnHeight;
      // Свой цвет кнопки (Tabs.FmtBtn), не цвет подписи: кнопку видно
      // отдельно от имени файла. Txt - рамка и надпись этим цветом, Fmt -
      // залитый им квадрат с надписью Tabs.FmtBtnText
      TextColor := UiColor('Tabs.FmtBtn');
      BackColor := UiColor('Tabs.FmtBtnText');
      C.Pen.Color := TextColor;
      C.Pen.Width := 1;
      if ShowFmt then
      begin
        C.Brush.Style := bsSolid;
        C.Brush.Color := TextColor;
        BtnText := 'Fmt';
      end
      else
      begin
        C.Brush.Style := bsClear;
        BtnText := 'Txt';
      end;
      C.Rectangle(BtnRect.Left, BtnRect.Top, BtnRect.Right, BtnRect.Bottom);
      // Рамка Txt - в два пикселя: тонкая на фоне вкладки теряется
      if not ShowFmt then
        C.Rectangle(BtnRect.Left + 1, BtnRect.Top + 1, BtnRect.Right - 1,
                    BtnRect.Bottom - 1);
      C.Brush.Style := bsClear;
      if ShowFmt then
        C.Font.Color := BackColor
      else
        C.Font.Color := TextColor;
      C.TextOut(BtnRect.Left + (BtnWidth - C.TextWidth(BtnText)) div 2,
                BtnRect.Top + (BtnHeight - C.TextHeight(BtnText)) div 2,
                BtnText);
      C.Font := FTabs.Font;
      C.Font.Color := UiColor('Tabs.Text');
      // Имя файла - правее кнопки, даже если места под неё (TabFmtPrefix)
      // в этом шрифте вышло меньше
      if BtnRect.Right + 6 > ARect.Left + 6 + FmtWidth then
        FmtWidth := BtnRect.Right - ARect.Left;
    end;

    // Главный файл include (TabCaptionFor) - своим цветом
    OwnerPart := '';
    OwnerPos := Pos(TabOwnerMark, Main);
    if OwnerPos > 0 then
    begin
      OwnerPart := Copy(Main, OwnerPos, MaxInt);
      Main := Copy(Main, 1, OwnerPos - 1);
    end;

    Y := ARect.Top + ((ARect.Bottom - ARect.Top) - C.TextHeight('Wg')) div 2;
    X := ARect.Left + 6 + FmtWidth;
    C.TextOut(X, Y, Main);
    if OwnerPart <> '' then
    begin
      X := X + C.TextWidth(Main);
      C.Font.Color := UiColor('Tabs.Owner');
      C.TextOut(X, Y, OwnerPart);
      C.Font.Color := UiColor('Tabs.Text');
    end;

    if Cross <> '' then
    begin
      // Крестик приметным цветом - только у активной вкладки
      if AActive then
        C.Font.Color := UiColor('Tabs.CloseOn')
      else
        C.Font.Color := UiColor('Tabs.CloseOff');
      C.Font.Style := C.Font.Style + [fsBold];
      X := ARect.Right - TabCloseWidth +
           (TabCloseWidth - C.TextWidth(Cross)) div 2;
      C.TextOut(X, Y, Cross);
    end;

    // Вкладка второй панели редактора - черта снизу цветом кнопки Txt / Fmt
    if (FSplit <> nil) and FSplit.Shown and (TabWin >= 0) and
       (TabWin = FSplitWin) then
    begin
      C.Brush.Style := bsSolid;
      C.Brush.Color := UiColor('Tabs.FmtBtn');
      C.FillRect(Rect(ARect.Left + 2, ARect.Bottom - 3, ARect.Right - 2,
                      ARect.Bottom - 1));
    end;
  finally
    C.Handle := 0;
    C.Free;
  end;
end;

// Ширина хвоста подписи, который считается кнопкой закрытия
function TForm1.TabCloseWidth: Integer;
begin
  Result := 16;
end;

// У файла есть вид "по формату" (FmtKindOf: .md, .html, .mht, .rtf, .rvf)
function TForm1.TabHasFmtView(WinIdx: Integer): Boolean;
begin
  Result := (WinIdx >= 0) and (WinIdx <= WindowsItemCount - 1) and
            FWindows[WinIdx].Used and
            (FmtKindOf(FWindows[WinIdx].FileName) <> fkNone);
end;

// Ширина места под кнопку Txt / Fmt от левого края вкладки (щелчок левее -
// по кнопке)
function TForm1.TabFmtWidth: Integer;
var
  MeasureBmp: TBitmap;
  BtnRight: Integer;
begin
  MeasureBmp := TBitmap.Create;
  try
    MeasureBmp.Canvas.Font := FTabs.Font;
    Result := 6 + MeasureBmp.Canvas.TextWidth(TabFmtPrefix);
    // Кнопка шире отведённого места (TabsDrawTab) - щелчок по всей кнопке
    MeasureBmp.Canvas.Font.Size := 7;
    MeasureBmp.Canvas.Font.Style := [fsBold];
    BtnRight := MeasureBmp.Canvas.TextWidth('Txt');
    if MeasureBmp.Canvas.TextWidth('Fmt') > BtnRight then
      BtnRight := MeasureBmp.Canvas.TextWidth('Fmt');
    BtnRight := 5 + BtnRight + TabFmtPadding;
    if BtnRight > Result then
      Result := BtnRight;
  finally
    MeasureBmp.Free;
  end;
end;

// Клик по крестику закрывает вкладку, не трогая само окно
procedure TForm1.TabsMouseDown(Sender: TObject; Button: TMouseButton;
                               Shift: TShiftState; X, Y: Integer);
var
  Idx: Integer;
  R: TRect;
begin
  if Button <> mbLeft then
    Exit;

  Idx := FTabs.IndexOfTabAt(X, Y);
  if Idx < 0 then
    Exit;

  // unIDE FAR открыт (на всю область или в режиме F4): курсор активной
  // панели - на файл вкладки (кроме щелчка по крестику закрытия)
  if (FFar <> nil) and FFar.Visible and
     (Idx <= High(FTabWin)) and (FTabWin[Idx] >= 0) and
     (FTabWin[Idx] <= WindowsItemCount - 1) then
  begin
    R := FTabs.TabRect(Idx);
    if (FTabs.Tabs.Count <= 1) or (X < R.Right - TabCloseWidth) then
      FFar.ShowFile(FWindows[FTabWin[Idx]].FileName);
  end;

  // Кнопка Txt / Fmt у левого края вкладки. Вкладку под ней Windows
  // уже сделала активной (выбор вкладки - до OnMouseDown); если нет -
  // вид меняется у её окна и окно показывается
  if (Idx <= High(FTabWin)) and TabHasFmtView(FTabWin[Idx]) then
  begin
    R := FTabs.TabRect(Idx);
    if X < R.Left + TabFmtWidth then
    begin
      if FTabWin[Idx] = FWindowsIndex then
        FmtToggle
      else
      begin
        FWindows[FTabWin[Idx]].FmtShown := not FWindows[FTabWin[Idx]].FmtShown;
        ActivateWindow(FTabWin[Idx]);
      end;
      Exit;
    end;
  end;

  // Кнопка закрытия - это хвост подписи, поэтому проверяем попадание
  // в правую часть вкладки
  if FTabs.Tabs.Count <= 1 then
    Exit; // единственную вкладку крестик не закрывает

  R := FTabs.TabRect(Idx);
  if X >= R.Right - TabCloseWidth then
    CloseTab(Idx);
end;

// Убирает вкладку из панели. Окно при этом остаётся открытым и доступным
// через меню Windows - вкладки лишь показывают, с чем работают сейчас.
procedure TForm1.CloseTab(TabIdx: Integer);
var
  I, NewIdx: Integer;
  WasActive: Boolean;
begin
  if (TabIdx < 0) or (TabIdx > High(FTabWin)) then
    Exit;

  // Последнюю вкладку не закрываем: панель опустела бы, и переключаться стало
  // бы не на что - пришлось бы идти в меню Windows. Один файл всегда на виду.
  //
  // Считаем по самому контролу, а не по длине FTabWin: если массив и панель
  // когда-нибудь разойдутся, ориентироваться надо на то, что видит пользователь.
  if FTabs.Tabs.Count <= 1 then
    Exit;
  if Length(FTabWin) <= 1 then
    Exit;

  WasActive := (FTabWin[TabIdx] = FWindowsIndex);

  FLockTabs := True;
  try
    FTabs.Tabs.Delete(TabIdx);
    for I := TabIdx to High(FTabWin) - 1 do
      FTabWin[I] := FTabWin[I + 1];
    SetLength(FTabWin, Length(FTabWin) - 1);
  finally
    FLockTabs := False;
  end;

  if Length(FTabWin) = 0 then
    Exit;

  // Закрыли активную вкладку - переходим на соседнюю
  if WasActive then
  begin
    NewIdx := TabIdx;
    if NewIdx > High(FTabWin) then
      NewIdx := High(FTabWin);
    if ConfirmSaveCurrent then
      ActivateWindow(FTabWin[NewIdx]);
  end
  else
    EnsureTab(FWindowsIndex); // выбор мог съехать при удалении
end;

// Перечитывает файл активной вкладки с диска, отбрасывая то, что лежало
// в памяти окна. Нужно, когда файл изменили снаружи - другим редактором,
// сборкой, системой контроля версий.
procedure TForm1.ReloadFileClick(Sender: TObject);
var
  W: Integer;
begin
  if (FTabs = nil) or (FTabs.TabIndex < 0) or (FTabs.TabIndex > High(FTabWin)) then
    Exit;

  W := FTabWin[FTabs.TabIndex];
  if (W < 0) or (W > WindowsItemCount - 1) or not FWindows[W].Used then
    Exit;
  ReloadWindowFromDisk(W, True);
end;

// Перечитать окно W с диска. AAsk - спросить, если в окне есть
// несохранённое (ReloadFileClick); проверка изменений снаружи спрашивает
// сама. False - файла нет или отказались.
function TForm1.ReloadWindowFromDisk(W: Integer; AAsk: Boolean): Boolean;
var
  FN, LoadedText: string;
  IsMod, SavedUtf8, SavedBom: Boolean;
begin
  Result := False;
  FN := FWindows[W].FileName;
  if not FileExists(FN) then
  begin
    ShowMessage('10131:Файл не найден:'#13#10 + FN);
    Exit;
  end;

  // Флаг изменений у активного окна живёт в самом редакторе, у остальных -
  // в записи: там он обновляется только при переключении
  if W = FWindowsIndex then
    IsMod := RichEdit1.Modified
  else
    IsMod := FWindows[W].Modified;

  if IsMod and AAsk then
    if MessageDlg('10143:В файле ' + ExtractFileName(FN) + ' есть несохранённые ' +
    'изменения.'#13#10'Перечитать с диска, потеряв их?',
                  mtWarning, [mbYes, mbNo], 0) <> mrYes then
      Exit;
  Result := True;

  // LoadTextFile пишет кодировку в поля формы - они относятся к АКТИВНОМУ
  // окну, поэтому для чужого окна значения приходится вернуть на место
  SavedUtf8 := FFileIsUtf8;
  SavedBom := FFileHasBom;

  // Файл не открылся (его держит другой процесс) - окно остаётся как было,
  // время файла не запоминается: проверка диска попробует ещё раз
  try
    LoadedText := LoadTextFile(FN);
  except
    on E: Exception do
    begin
      FFileIsUtf8 := SavedUtf8;
      FFileHasBom := SavedBom;
      Result := False;
      if AAsk then
        ShowMessage('Файл не прочитан:'#13#10 + FN + #13#10#13#10 + E.Message)
      else if CompareText(FDiskReadFail, FN) <> 0 then
      begin
        FDiskReadFail := FN;
        LogComp(ExtractFileName(FN) + ': изменён на диске, но не прочитан ' +
        '- окно не обновлено, следующая проверка попробует снова (' +
                E.Message + ')');
      end;
      Exit;
    end;
  end;
  if CompareText(FDiskReadFail, FN) = 0 then
    FDiskReadFail := '';
  FWindows[W].Text := LoadedText;
  FWindows[W].IsUtf8 := FFileIsUtf8;
  FWindows[W].HasBom := FFileHasBom;

  if W <> FWindowsIndex then
  begin
    FFileIsUtf8 := SavedUtf8;
    FFileHasBom := SavedBom;
  end;

  FWindows[W].Modified := False;
  FWindows[W].Broken := False;

  // Карта построена по прежнему тексту и больше не годится
  FWindows[W].MapValid := False;
  SetLength(FWindows[W].CommentRanges, 0);
  SetLength(FWindows[W].StringRanges, 0);

  // Каретку сохраняем, но файл мог стать короче
  if FWindows[W].CursorPos > Length(FWindows[W].Text) then
    FWindows[W].CursorPos := 0;

  if W = FWindowsIndex then
    // ActivateWindow на СВОЁМ же окне не вызывает StoreCurrentWindow,
    // так что свежий текст не будет затёрт содержимым редактора
    ActivateWindow(W)
  else
    UpdateTabCaption(W); // могла уйти звёздочка

  RebuildWindowsMenu;
end;

procedure TForm1.CloseTabClick(Sender: TObject);
begin
  CloseTab(FTabs.TabIndex);
end;

// "Закрыть все" на деле означает "оставить только текущую": панель без единой
// вкладки бесполезна, а активное окно всё равно нужно чем-то показывать.
procedure TForm1.CloseAllTabsClick(Sender: TObject);
begin
  if Length(FTabWin) <= 1 then
    Exit;

  FLockTabs := True;
  try
    FTabs.Tabs.Clear;
    SetLength(FTabWin, 0);
  finally
    FLockTabs := False;
  end;
  EnsureTab(FWindowsIndex);
end;


// Убирает вкладку окна, ничего больше не трогая. В отличие от CloseTab здесь
// нет ни защиты последней вкладки, ни переключения на соседнюю: окно закрывают
// совсем, и вкладка обязана уйти вместе с ним.
procedure TForm1.RemoveTabOf(WinIdx: Integer);
var
  TabI, I: Integer;
begin
  if FTabs = nil then
    Exit;
  TabI := TabIndexOfWindow(WinIdx);
  if TabI < 0 then
    Exit;

  FLockTabs := True;
  try
    FTabs.Tabs.Delete(TabI);
    for I := TabI to High(FTabWin) - 1 do
      FTabWin[I] := FTabWin[I + 1];
    SetLength(FTabWin, Length(FTabWin) - 1);
  finally
    FLockTabs := False;
  end;

  // Одноимённость могла пропасть вместе с закрытым окном
  RefreshAllTabCaptions;
end;

// Закрывает окно: освобождает слот, убирает вкладку и, если закрыли активное,
// переходит на любое оставшееся.
procedure TForm1.CloseWindow(WinIdx: Integer);
var
  I, NewIdx: Integer;
begin
  if (WinIdx < 0) or (WinIdx > WindowsItemCount - 1) then
    Exit;
  if not FWindows[WinIdx].Used then
    Exit;

  // Спросить о несохранённом можно только про активное окно - у остальных
  // изменений не бывает по построению
  if WinIdx = FWindowsIndex then
    if not ConfirmSaveCurrent then
      Exit;

  RemoveTabOf(WinIdx);

  FWindows[WinIdx].Used := False;
  FWindows[WinIdx].FileName := '';
  FWindows[WinIdx].IncOwner := '';
  FWindows[WinIdx].Text := '';
  FWindows[WinIdx].CursorPos := 0;
  FWindows[WinIdx].Modified := False;
  FWindows[WinIdx].Broken := False;
  FWindows[WinIdx].FmtShown := False;
  FWindows[WinIdx].MapValid := False;
  SetLength(FWindows[WinIdx].CommentRanges, 0);
  SetLength(FWindows[WinIdx].StringRanges, 0);
  SetLength(FWindows[WinIdx].Bookmarks, 0);
  BmHistDropWindow(WinIdx);

  if WinIdx = FWindowsIndex then
  begin
    FWindowsIndex := -1;

    NewIdx := -1;
    for I := 0 to WindowsItemCount - 1 do
      if FWindows[I].Used then
      begin
        NewIdx := I;
        Break;
      end;

    if NewIdx >= 0 then
      ActivateWindow(NewIdx)
    else
    begin
      // Не осталось ни одного окна
      FCurrentFileName := '';
      FLockHighlight := True;
      try
        RichEdit1.Lines.Clear;
      finally
        FLockHighlight := False;
      end;
      RichEdit1.Modified := False;
      Caption := AppTitle;
      UpdatePathBar;
      RichEdit1.Invalidate;
      // Просмотр закрытой вкладки - убрать
      FmtApplyTab;
    end;
  end;
  SplitWindowClosed(WinIdx);

  RebuildWindowsMenu;
  RebuildBookmarksMenu;
end;

procedure TForm1.CloseCurrentWindowClick(Sender: TObject);
begin
  if FWindowsIndex >= 0 then
    CloseWindow(FWindowsIndex);
end;

// Массовое закрытие окон.
//
// Отметить несколько пунктов прямо в меню Windows невозможно: меню Win32
// закрывается на первом же клике, и держать его раскрытым штатных средств нет.
// Поэтому список дублируется в диалоге с галочками - TCheckListBox.
// Кнопка "Отметить все" в диалоге. Работает переключателем: если отмечено
// уже всё, снимает галочки - так удобнее, чем два отдельных пункта.
// Окно без заголовка ведёт себя как меню: щелчок мимо него закрывает.
// Кнопки закрытия у такого окна нет, поэтому это основной путь отказа.
procedure TForm1.DlgDeactivate(Sender: TObject);
begin
  if Sender is TForm then
    TForm(Sender).ModalResult := mrCancel;
end;

procedure TForm1.DlgCheckAllClick(Sender: TObject);
var
  I: Integer;
  AllSet: Boolean;
begin
  if FDlgCheckList = nil then
    Exit;

  AllSet := True;
  for I := 0 to FDlgCheckList.Items.Count - 1 do
    if not FDlgCheckList.Checked[I] then
    begin
      AllSet := False;
      Break;
    end;

  for I := 0 to FDlgCheckList.Items.Count - 1 do
    FDlgCheckList.Checked[I] := not AllSet;
end;

procedure TForm1.DelWinListClick(Sender: TObject);
var
  Dlg: TDlgWinList;
  Lst: TCheckListBox;
  Pnl, Root, Cap: TPanel;
  BtnOk, BtnCancel, BtnAll: TUiButton;
  Map: array of Integer;
  I, N, MaxW, W, H, MinW, WAll, WOk, WCancel, ItemH: Integer;
  R: TRect;
  Bmp: TBitmap;
begin
  N := WindowsInUse;
  if N = 0 then
  begin
    ShowMessage('10370:Нет открытых окон.');
    Exit;
  end;

  // Окно описано в DlgWinList.dfm: без заголовка и рамки, чтобы читалось
  // как раскрытое меню, а не отдельный диалог. Рамку даёт панель pnlRoot
  // своим бевелом, роль кнопки закрытия - Esc и потеря фокуса. Размеры в
  // .dfm - начальные: ниже они пересчитываются под содержимое.
  Dlg := TDlgWinList.Create(Self);
  try
    Dlg.OnDeactivate := DlgDeactivate;
    Root := Dlg.pnlRoot;
    Cap := Dlg.pnlCaption;
    Pnl := Dlg.pnlButtons;
    Lst := Dlg.lstWindows;
    BtnAll := Dlg.btnAll;
    BtnOk := Dlg.btnOk;
    BtnCancel := Dlg.btnCancel;
    BtnAll.OnClick := DlgCheckAllClick;
    FDlgCheckList := Lst;

    SetLength(Map, 0);
    for I := 0 to WindowsItemCount - 1 do
      if FWindows[I].Used then
      begin
        SetLength(Map, Length(Map) + 1);
        Map[High(Map)] := I;
        Lst.Items.Add(Format('%d  %s', [Length(Map), FWindows[I].FileName]));
        // Файла на диске нет (красный крестик в меню) - отмечен сразу
        Lst.Checked[Lst.Items.Count - 1] := FWindows[I].Broken;
      end;

    // Размер окна подгоняем под содержимое: ширину по самому длинному пути,
    // высоту по числу строк. Меряем на временном холсте шрифтом списка -
    // у самого списка канвы нет.
    Bmp := TBitmap.Create;
    try
      Bmp.Canvas.Font.Assign(Lst.Font);
      MaxW := 0;
      for I := 0 to Lst.Items.Count - 1 do
      begin
        W := Bmp.Canvas.TextWidth(Lst.Items[I]);
        if W > MaxW then
          MaxW := W;
      end;
      // Высота строки - по шрифту: окна у списка ещё нет, и его
      // ItemHeight пока прежний, 16
      ItemH := Bmp.Canvas.TextHeight('Wg') + 2;
    finally
      Bmp.Free;
    end;

    // Ширины кнопок - тоже по тексту, с полями по 18 пикселей с каждой
    // стороны. Считаем до размера окна: от них зависит его минимальная ширина.
    Bmp := TBitmap.Create;
    try
      Bmp.Canvas.Font.Assign(Pnl.Font);
      WAll := Bmp.Canvas.TextWidth('Отметить все') + 36;
      WOk := Bmp.Canvas.TextWidth('Закрыть отмеченные') + 36;
      WCancel := Bmp.Canvas.TextWidth('Отмена') + 36;
    finally
      Bmp.Free;
    end;

    // К тексту добавляем флажок, полосу прокрутки и поля панели Root
    W := MaxW + 26 + GetSystemMetrics(SM_CXVSCROLL) + 2 * Root.BorderWidth + 8;

    // Но не уже, чем нужно кнопкам внизу: три кнопки, зазоры между ними
    // и отступы от краёв
    MinW := WAll + WOk + WCancel + 3 * 8 + 2 * 14;
    if W < MinW then
      W := MinW;
    if W > Screen.WorkAreaRect.Right - Screen.WorkAreaRect.Left - 40 then
      W := Screen.WorkAreaRect.Right - Screen.WorkAreaRect.Left - 40;
    Dlg.ClientWidth := W;

    H := Lst.ItemHeight;
    if H < ItemH then
      H := ItemH;
    H := H * Lst.Items.Count + Cap.Height + Pnl.Height + 2 * Root.BorderWidth + 6;
    if H > Screen.WorkAreaRect.Bottom - Screen.WorkAreaRect.Top - 80 then
      H := Screen.WorkAreaRect.Bottom - Screen.WorkAreaRect.Top - 80;
    if H < 120 then
      H := 120;
    Dlg.ClientHeight := H;

    // Кнопки: ширины - по тексту, правые прижаты к правому краю якорями
    BtnAll.Width := WAll;
    BtnCancel.Width := WCancel;
    BtnCancel.Left := Dlg.ClientWidth - BtnCancel.Width - 14;
    BtnOk.Width := WOk;
    BtnOk.Left := BtnCancel.Left - BtnOk.Width - 8;

    // Ставим окно под пунктом меню Windows - так оно читается как его
    // продолжение, а не как случайный диалог посреди экрана
    if GetMenuItemRectApi(Handle, MainMenu1.Handle, mWindows.MenuIndex, R) then
    begin
      Dlg.Left := R.Left;
      Dlg.Top := R.Bottom;
    end
    else
    begin
      // Меню могло быть недоступно - тогда просто по центру главной формы
      Dlg.Left := Left + (Width - Dlg.Width) div 2;
      Dlg.Top := Top + (Height - Dlg.Height) div 2;
    end;

    // Не даём окну уйти за пределы рабочей области экрана
    if Dlg.Left + Dlg.Width > Screen.WorkAreaRect.Right then
      Dlg.Left := Screen.WorkAreaRect.Right - Dlg.Width;
    if Dlg.Top + Dlg.Height > Screen.WorkAreaRect.Bottom then
      Dlg.Top := Screen.WorkAreaRect.Bottom - Dlg.Height;
    if Dlg.Left < Screen.WorkAreaRect.Left then
      Dlg.Left := Screen.WorkAreaRect.Left;
    if Dlg.Top < Screen.WorkAreaRect.Top then
      Dlg.Top := Screen.WorkAreaRect.Top;

    if Dlg.ShowModal <> mrOk then
      Exit;

    // Идём с конца: CloseWindow меняет состав окон, но индексы слотов в Map
    // остаются верными - в FWindows ничего не сдвигается
    for I := Lst.Items.Count - 1 downto 0 do
      if Lst.Checked[I] then
        CloseWindow(Map[I]);
  finally
    FDlgCheckList := nil;
    Dlg.Free;
  end;
end;


// Windows -> Remove missing files from list: закрывает окна, файлов которых
// нет на диске (Broken - красный крестик в меню Windows)
procedure TForm1.RemoveMissingClick(Sender: TObject);
var
  WinIdx, Removed: Integer;
begin
  Removed := 0;
  for WinIdx := WindowsItemCount - 1 downto 0 do
    if FWindows[WinIdx].Used and FWindows[WinIdx].Broken then
    begin
      CloseWindow(WinIdx);
      if not FWindows[WinIdx].Used then
        Inc(Removed);
    end;
  RebuildWindowsMenu;
  StatusBar1.SimpleText := Format('Windows: убрано из списка окон без ' +
  'файла на диске: %d. Открыто окон: %d из %d.',
                                  [Removed, WindowsInUse, WindowsItemCount]);
  StatusBar1.SimplePanel := True;
end;

// ---------------------------------------------------------------------------
//  Поиск
//
//  Панель видна постоянно и не прячется в меню: искать приходится чаще всего
//  остального. Поля Find и Replace - комбобоксы, они же хранят историю.
//  Где искать и заменять - список области (cmbScope, см. SearchScope):
//  в файле, список (найденное в файле - в Match list), во вкладках, в
//  файлах проекта, на диске. Кнопки Find->, <-Find, Replace, All работают
//  по выбранной области.
// ---------------------------------------------------------------------------

// Область поиска - пункты cmbScope по порядку (см. SearchScope)
const
  ScopeFile = 0;      // в файле
  ScopeList = 1;      // в файле, найденное - в Match list
  ScopeTabs = 2;      // во вкладках
  ScopeProject = 3;   // в файлах проекта
  ScopeDisk = 4;      // на диске
  ScopeFileSearch = 5; // искать файл: файлы по маске, без образца

  // Раскладка в три ряда по 24 пикселя (панель под надписью - около 75):
  //   1: [Find      ] [<-Find][Find->]
  //   2: [Replace   ] [Replace][All][Undo]
  //   3: [Normal ] [Case] [В файле       ]
  // Режим поиска, галка Case и область - в третьем ряду.
procedure TForm1.BuildSearchPanel;
const
  Row1 = 1;
var
  X, W, I, Arrow, R, D: Integer;
  Bmp: TBitmap;

  // Ширина текста шрифтом панели поиска - замер на временном холсте: у
  // самих контролов оконного хэндла ещё может не быть
  function TextW(const S: string): Integer;
  begin
    Result := Bmp.Canvas.TextWidth(S);
  end;

begin
  Arrow := GetSystemMetrics(SM_CXVSCROLL);

  Bmp := TBitmap.Create;
  try
    Bmp.Canvas.Font.Assign(pnlSearchIn.Font);

    cmbFind.Top := Row1 + 1;
    cmbFind.Width := 100;

    cmbReplace.Width := 100;

    X := 110;
    Inc(X, 57);
    Inc(X, 37);

    Inc(X, 49);
    UndoBtn.Font.Assign(pnlSearchIn.Font);
    UndoBtn.Font.Style := [fsBold];

    cmbMode.Items.Add('Normal');
    cmbMode.Items.Add('WholeWord');
    cmbMode.Items.Add('Go to line');
    cmbMode.ItemIndex := 0;

    // Сам список - по пункту Normal, он стоит почти всегда. Раскрывающаяся
    // часть шире, по самому длинному пункту: CB_SETDROPPEDWIDTH задаёт её
    // отдельно от поля. Плата: выбранный WholeWord или Go to line в
    // закрытом поле виден не целиком.
    W := 0;
    for I := 0 to cmbMode.Items.Count - 1 do
      if TextW(cmbMode.Items[I]) > W then
        W := TextW(cmbMode.Items[I]);
    cmbMode.Width := TextW('WholeWord') + Arrow + 6;
    SendMessage(cmbMode.Handle, CB_SETDROPPEDWIDTH, W + Arrow + 8, 0);

    chkCase.Left := cmbMode.Left + cmbMode.Width + 4;
    chkCase.Width := TextW(chkCase.Caption) + 20;

    cmbScope.Left := chkCase.Left + chkCase.Width + 4;
    // Порядок пунктов важен (ScopeFile ... ScopeDisk), подписи - нет
    cmbScope.Items.Add('В окне');
    cmbScope.Items.Add('Список');
    cmbScope.Items.Add('Во вкладках');
    cmbScope.Items.Add('В проекте');
    cmbScope.Items.Add('На диске');
    cmbScope.Items.Add('Искать файл');
    cmbScope.ItemIndex := ScopeFile;
    // Выбрали «Искать файл» мышью или Enter - окно поиска файлов сразу.
    // Перебор пунктов стрелками при закрытом списке окно не открывает.
    FScopeOldProc := cmbScope.WindowProc;
    cmbScope.WindowProc := ScopeWndProc;
    cmbScope.OnKeyDown := ScopeKeyDown;

    W := 0;
    for I := 0 to cmbScope.Items.Count - 1 do
      if TextW(cmbScope.Items[I]) > W then
        W := TextW(cmbScope.Items[I]);
    cmbScope.Width := W + Arrow + 8;

    // Правый край первой строки - вровень с третьей, самой длинной: лишнее
    // место отдаём полю поиска, кнопки за ним сдвигаем. Find-> встаёт у
    // правого края рамки.
    R := cmbScope.Left + cmbScope.Width;

    D := R - (BtnNext.Left + BtnNext.Width);
    if D > 0 then
    begin
      cmbFind.Width := cmbFind.Width + D;
      BtnPrev.Left := BtnPrev.Left + D;
      BtnNext.Left := BtnNext.Left + D;
    end;

    // Вторая строка - по первой: поле замены той же ширины, что поле
    // поиска, и Replace ровно под <-Find. Две колонки читаются лучше, чем
    // две строки, выровненные только по правому краю; Undo при этом
    // до края рамки не доходит.
    cmbReplace.Width := cmbFind.Width;
    BtnRepl.Left := BtnPrev.Left;
    BtnAll.Left := BtnRepl.Left + BtnRepl.Width + 3;
    UndoBtn.Left := BtnAll.Left + BtnAll.Width + 3;
    UndoBtn.Left :=2;// BtnAll.Left + BtnAll.Width + 3;
  finally
    Bmp.Free;
  end;
end;

// Ширина рамки поиска - по самому правому полю плюс рамка. Считается по
// факту расстановки, а не заданным числом: поле добавится или станет шире -
// рамка подстроится сама.
procedure TForm1.FitSearchBox;
var
  I, R: Integer;
begin
  if (grpSearch = nil) or (pnlSearchIn = nil) then
    Exit;

  R := 0;
  for I := 0 to pnlSearchIn.ControlCount - 1 do
    if pnlSearchIn.Controls[I].Left + pnlSearchIn.Controls[I].Width > R then
      R := pnlSearchIn.Controls[I].Left + pnlSearchIn.Controls[I].Width;

  // Разница между шириной рамки и её клиентской частью - это обе боковые
  // кромки; плюс отступ справа, как слева у первого поля
  // grpSearch.Width := R + (grpSearch.Width - grpSearch.ClientWidth) + 8;
end;

procedure TForm1.FindPanelClick(Sender: TObject);
begin
  ToggleSearchPanel;
end;

// Поиск теперь живёт на тулбаре и виден всегда, прятать его незачем.
// Ctrl+F просто переводит фокус в поле ввода.
procedure TForm1.ToggleSearchPanel;
begin
  if (cmbFind <> nil) and cmbFind.CanFocus then
  begin
    cmbFind.SetFocus;
    cmbFind.SelectAll;
  end;
end;

function TForm1.SearchOptions: TSearchTypes;
begin
  Result := [];
  if chkCase.Checked then
    Include(Result, stMatchCase);
  if cmbMode.ItemIndex = 1 then
    Include(Result, stWholeWord);
end;

// Кладёт строку в начало истории комбобокса, убирая дубликат
procedure TForm1.AddHistory(Cmb: TUiComboBox; const S: string);
var
  I: Integer;
begin
  if (Cmb = nil) or (S = '') then
    Exit;

  I := Cmb.Items.IndexOf(S);
  if I >= 0 then
    Cmb.Items.Delete(I);
  Cmb.Items.Insert(0, S);

  while Cmb.Items.Count > 20 do
    Cmb.Items.Delete(Cmb.Items.Count - 1);

  // Text сбрасывается при правке Items, поэтому возвращаем его на место
  Cmb.Text := S;
end;

procedure TForm1.GotoLine(LineIdx: Integer);
var
  P: Integer;
begin
  if LineIdx < 0 then
    Exit;
  P := SendMessageA(RichEdit1.Handle, EM_LINEINDEX, LineIdx, 0);
  if P < 0 then
    Exit;

  if RichEdit1.CanFocus then
    RichEdit1.SetFocus;
  RichEdit1.SelStart := P;
  RichEdit1.SelLength := 0;
  SendMessageA(RichEdit1.Handle, EM_SCROLLCARET, 0, 0);
  CenterCaretLine;
  UpdateStatusBarInfo;
end;


// Из чего состоят слова. Байты со старшим битом тоже считаем буквами: в
// CP1251 там кириллица, и русское слово в комментарии должно искаться целиком
// так же, как английское.
function IsWordChar(C: Char): Boolean;
begin
  Result := (C in ['a'..'z', 'A'..'Z', '0'..'9', '_']) or (C >= #128);
end;

// Позиция вхождения образца в строке начиная с FromPos, или 0.
//
// Учитывает и галку Case, и режим WholeWord: в нём вхождение засчитывается,
// только если с обеих сторон от него стоит не буква и не цифра. Одного Pos
// здесь мало - он нашёл бы Form внутри TForm1.
function TForm1.MatchPosFrom(const Line, Pattern: string;
                             FromPos: Integer): Integer;
var
  L, P: string;
  PL, Idx: Integer;
begin
  Result := 0;
  PL := Length(Pattern);
  if (PL = 0) or (PL > Length(Line)) then
    Exit;
  if FromPos < 1 then
    FromPos := 1;

  if chkCase.Checked then
  begin
    L := Line;
    P := Pattern;
  end
  else
  begin
    L := AnsiUpperCase(Line);
    P := AnsiUpperCase(Pattern);
  end;

  Idx := PosEx(P, L, FromPos);

  // Обычный режим и Go to line - годится первое же вхождение
  if (cmbMode = nil) or (cmbMode.ItemIndex <> 1) then
  begin
    Result := Idx;
    Exit;
  end;

  while Idx > 0 do
  begin
    if ((Idx = 1) or (not IsWordChar(L[Idx - 1]))) and
       ((Idx + PL > Length(L)) or (not IsWordChar(L[Idx + PL]))) then
    begin
      Result := Idx;
      Exit;
    end;
    Idx := PosEx(P, L, Idx + 1);
  end;
end;

// Позиция первого подходящего вхождения в строке или 0. Не просто "есть/нет":
// по этой позиции потом выделяется найденный фрагмент в редакторе.
function TForm1.MatchPosInLine(const Line, Pattern: string): Integer;
begin
  Result := MatchPosFrom(Line, Pattern, 1);
end;

procedure TForm1.FileFindNext;
var
  S: string;
  P, StartFrom: Integer;
begin
  S := cmbFind.Text; // без Trim: образец должен совпадать с введённым дословно
  if S = '' then
    Exit;
  AddHistory(cmbFind, S);

  // Режим перехода по номеру строки: искать нечего, просто прыгаем
  if cmbMode.ItemIndex = 2 then
  begin
    GotoLine(StrToIntDef(S, 1) - 1);
    Exit;
  end;

  StartFrom := RichEdit1.SelStart + RichEdit1.SelLength;
  P := FindTextEd(S, StartFrom, RichEdit1.GetTextLen, SearchOptions);
  if P < 0 then
    // Дошли до конца - продолжаем с начала файла
    P := FindTextEd(S, 0, RichEdit1.GetTextLen, SearchOptions);

  if P < 0 then
  begin
    StatusBar1.SimpleText := 'Не найдено: ' + S;
    StatusBar1.SimplePanel := True;
    Exit;
  end;

  if RichEdit1.CanFocus then
    RichEdit1.SetFocus;
  RichEdit1.SelStart := P;
  RichEdit1.SelLength := Length(S);
  SendMessageA(RichEdit1.Handle, EM_SCROLLCARET, 0, 0);
  CenterCaretLine;
  UpdateStatusBarInfo;

  if SearchScope = ScopeList then
    BuildMatchList;
end;

// Поиск назад. FindText умеет искать только вперёд, поэтому идём от начала
// файла и запоминаем последнее совпадение, оказавшееся левее каретки.
procedure TForm1.FileFindPrev;
var
  S: string;
  P, Best, Limit: Integer;
begin
  S := cmbFind.Text; // без Trim: образец должен совпадать с введённым дословно
  if S = '' then
    Exit;
  AddHistory(cmbFind, S);

  Limit := RichEdit1.SelStart;
  Best := -1;
  P := FindTextEd(S, 0, RichEdit1.GetTextLen, SearchOptions);
  while (P >= 0) and (P < Limit) do
  begin
    Best := P;
    P := FindTextEd(S, P + 1, RichEdit1.GetTextLen, SearchOptions);
  end;

  if Best < 0 then
  begin
    StatusBar1.SimpleText := 'Выше ничего не найдено: ' + S;
    StatusBar1.SimplePanel := True;
    Exit;
  end;

  if RichEdit1.CanFocus then
    RichEdit1.SetFocus;
  RichEdit1.SelStart := Best;
  RichEdit1.SelLength := Length(S);
  SendMessageA(RichEdit1.Handle, EM_SCROLLCARET, 0, 0);
  CenterCaretLine;
  UpdateStatusBarInfo;

  if SearchScope = ScopeList then
    BuildMatchList;
end;

// Пошаговая замена. Переходим к очередному вхождению, показываем его в
// редакторе и спрашиваем. Ответ - и Да, и Нет - ведёт к следующему; выход
// только по Отмене или когда вхождения кончились.
//
// Поиск идёт от каретки к концу файла, без закольцовывания: иначе после
// ответа "Нет" мы бы вернулись к тому же месту и спрашивали бесконечно.
procedure TForm1.FileReplace;
var
  S, R: string;
  P, N: Integer;
begin
  S := cmbFind.Text; // без Trim: образец должен совпадать с введённым дословно
  if S = '' then
    Exit;
  R := cmbReplace.Text;

  AddHistory(cmbFind, S);
  AddHistory(cmbReplace, R);
  // Текст замены попадает и в историю поиска: после замены его часто
  // требуется найти
  AddHistory(cmbFind, R);
  cmbFind.Text := S; // но в поле оставляем сам образец

  N := 0;
  P := RichEdit1.SelStart;

  while True do
  begin
    P := FindTextEd(S, P, RichEdit1.GetTextLen, SearchOptions);
    if P < 0 then
      Break;

    if RichEdit1.CanFocus then
      RichEdit1.SetFocus;
    RichEdit1.SelStart := P;
    RichEdit1.SelLength := Length(S);
    SendMessageA(RichEdit1.Handle, EM_SCROLLCARET, 0, 0);
    CenterCaretLine;

    case MessageDlg('11014:Заменить это вхождение?' + #13#10#13#10 + S + '  ->  ' + R,
                    mtConfirmation, [mbYes, mbNo, mbCancel], 0) of
      mrYes:
      begin
        RichEdit1.SelText := R;
        Inc(N);
        P := P + Length(R); // продолжаем ЗА вставленным текстом
      end;
      mrNo:
        P := P + Length(S);
    else
      Break; // Отмена
    end;
  end;

  StatusBar1.SimpleText := Format('Заменено: %d', [N]);
  StatusBar1.SimplePanel := True;
  UpdateStatusBarInfo;

  if SearchScope = ScopeList then
    BuildMatchList;
end;

// ---------------------------------------------------------------------------
//  Индикатор хода долгой операции
//
//  Пока идёт длинный цикл, поток не возвращается в очередь сообщений, и окно
//  перестаёт отвечать: не перерисовывается, не реагирует на мышь. На файле
//  в сто мегабайт это выглядит как зависшая программа.
//
//  Поэтому цикл сам отдаёт управление - через ProgressStep, но НЕ на каждой
//  итерации: Application.ProcessMessages стоит дороже самой работы. Раз
//  в сто миллисекунд достаточно, чтобы окно было живым, а кнопка Стоп
//  нажималась.
// ---------------------------------------------------------------------------

procedure TForm1.ProgAbortClick(Sender: TObject);
begin
  FProgAbort := True;
end;

procedure TForm1.ProgressStart(const ACaption: string);
var
  Dlg: TDlgProgress;
begin
  FProgAbort := False;
  FProgLastTick := GetTickCount;

  // Окно описано в DlgProgress.dfm. Создаётся один раз; подпись и полоса
  // дальше идут через FProgLabel и FProgBar (ProgressStep)
  if FProgForm = nil then
  begin
    Dlg := TDlgProgress.Create(Self);
    FProgForm := Dlg;
    FProgLabel := Dlg.lblStage;
    FProgBar := Dlg.barProgress;
    Dlg.btnStop.OnClick := ProgAbortClick;
  end;

  FProgForm.Caption := ACaption;
  FProgLabel.Caption := 'Подготовка...';
  FProgBar.Position := 0;

  // Главное окно на время работы ввода не принимает: иначе из-под
  // ProcessMessages можно запустить вторую такую же операцию
  Self.Enabled := False;

  FProgForm.Show;
  FProgForm.Update;
end;

// Отдаёт управление очереди сообщений, если с прошлого раза прошло больше
// ста миллисекунд. False означает, что нажали Стоп и работу надо прервать.
function TForm1.ProgressStep(APos, AMax: Integer; const AText: string): Boolean;
var
  T: Cardinal;
  Pct: Integer;
begin
  Result := not FProgAbort;
  if (not Result) or (FProgForm = nil) then
    Exit;

  T := GetTickCount;
  if T - FProgLastTick < 100 then
    Exit; // ещё рано, работаем дальше
  FProgLastTick := T;

  if AMax > 0 then
  begin
    Pct := MulDiv(APos, 100, AMax);
    if Pct < 0 then
      Pct := 0;
    if Pct > 100 then
      Pct := 100;
    FProgBar.Position := Pct;
  end;

  // Та же подпись - не трогаем: каждая смена Caption - перерисовка
  if FProgLabel.Caption <> AText then
    FProgLabel.Caption := AText;

  Application.ProcessMessages;
  Result := not FProgAbort; // Стоп могли нажать прямо сейчас
end;

procedure TForm1.ProgressStop;
begin
  Self.Enabled := True; // ВСЕГДА, иначе окно останется мёртвым

  if FProgForm <> nil then
    FProgForm.Hide;

  if Self.CanFocus then
    Self.SetFocus;
end;

// Массовая замена. Идёт В ПАМЯТИ, одним проходом, а не через выделение.
//
// Раньше здесь был цикл: FindText, потом SelStart, SelLength и SelText на
// каждое вхождение. На файле в 32 МБ это означало тысячи обменов сообщениями
// с контролом, и на каждое вхождение - снимок, EN_CHANGE и заказ пересборки
// карты. Плюс GetTextLen по три раза за итерацию. Замена кавычек в большом
// файле уходила в минуты, а поток всё это время не возвращался в очередь
// сообщений - окно переставало отвечать.
//
// Здесь текст забирается ОДИН раз, собирается результат и пишется обратно
// ОДНИМ присваиванием. Карта пересобирается тоже один раз, в конце.
procedure TForm1.FileReplaceAll;
var
  S, R, Src, Hay, Pat, Res: string;
  P, N, PL, Start, Used, Cap: Integer;
  WholeW, Aborted: Boolean;

  // Дописывает кусок в Res, расширяя буфер вдвое по мере надобности.
  // Обычная склейка Res := Res + ... на таком объёме давала бы
  // перевыделение памяти на каждом вхождении.
  procedure Append(const APart: string);
  var
    L: Integer;
  begin
    L := Length(APart);
    if L = 0 then
      Exit;

    while Used + L > Cap do
    begin
      Cap := Cap * 2;
      SetLength(Res, Cap);
    end;

    Move(APart[1], Res[Used + 1], L);
    Inc(Used, L);
  end;

// Границы слова для режима WholeWord. Смотрим по ИСХОДНОМУ тексту:
// в Hay он мог быть приведён к верхнему регистру, но набор символов
// слова от регистра не зависит.
  function AtWordBounds(APos: Integer): Boolean;
  begin
    Result := ((APos = 1) or (not IsWordChar(Src[APos - 1]))) and
              ((APos + PL > Length(Src)) or (not IsWordChar(Src[APos + PL])));
  end;

begin
  S := cmbFind.Text; // без Trim: образец должен совпадать с введённым дословно
  if S = '' then
    Exit;
  R := cmbReplace.Text;

  AddHistory(cmbFind, S);
  AddHistory(cmbReplace, R);

  if MessageDlg('11212:Заменить ВСЕ вхождения во всём файле?' + #13#10#13#10 +
                S + '  ->  ' + R + #13#10#13#10 +
  'Откатить можно будет через Edit - Отменить массовую замену.',
                mtWarning, [mbYes, mbNo], 0) <> mrYes then
    Exit;

  ProgressStart('Замена по всему файлу');
  try
    // Резервная копия текста до замены. RichEdit хранит лишь один шаг отмены,
    // а массовая замена делает сотни правок - своими силами их не откатить.
    Src := GetEditorText;
    FReplaceBackup := Src;
    FReplaceBackupWin := FWindowsIndex;
    SetLength(FReplBackups, 0);   // Undo - эта замена, не прежний All

    PL := Length(S);
    WholeW := (cmbMode <> nil) and (cmbMode.ItemIndex = 1);

    // Для поиска без учёта регистра работаем по копии в верхнем регистре.
    // Вырезаем куски всё равно из ИСХОДНОГО текста, поэтому регистр
    // незатронутых мест сохраняется.
    if chkCase.Checked then
    begin
      Hay := Src;
      Pat := S;
    end
    else
    begin
      Hay := AnsiUpperCase(Src);
      Pat := AnsiUpperCase(S);
    end;

    Cap := Length(Src) + 1024;
    SetLength(Res, Cap);
    Used := 0;

    N := 0;
    Start := 1;
    Aborted := False;
    P := PosEx(Pat, Hay, Start);

    while P > 0 do
    begin
      if WholeW and not AtWordBounds(P) then
      begin
        // Не целое слово - ищем дальше, ничего не заменяя
        P := PosEx(Pat, Hay, P + 1);
        Continue;
      end;

      Append(Copy(Src, Start, P - Start));
      Append(R);
      Inc(N);

      Start := P + PL;

      // Показываем, докуда дошли по ИСХОДНОМУ тексту, и заодно даём окну
      // ожить. Внутри стоит своя отсечка по времени, так что вызов на
      // каждом вхождении недорог.
      if not ProgressStep(Start, Length(Src),
                          Format('Заменено: %d', [N])) then
      begin
        Aborted := True;
        Break;
      end;

      P := PosEx(Pat, Hay, Start); // продолжаем ЗА образцом, не за заменой
    end;

    // Прервали на середине - текст НЕ трогаем вовсе. Записывать половину
    // замен нечестно: пользователь не увидит, где проходит граница.
    if Aborted then
    begin
      FReplaceBackup := '';
      StatusBar1.SimpleText :=
        Format('Замена прервана, текст не изменён (найдено: %d)', [N]);
      StatusBar1.SimplePanel := True;
      Exit;
    end;

    // Хвост после последнего вхождения
    Append(Copy(Src, Start, Length(Src) - Start + 1));
    SetLength(Res, Used);

    if N > 0 then
    begin
      FLockHighlight := True;
      try
        SetEditorText(Res);
      finally
        FLockHighlight := False;
      end;

      RichEdit1.SelStart := 0;
      RichEdit1.SelLength := 0;
      RichEdit1.Modified := True;

      // Текст сменился целиком - карта строится заново, один раз
      RebuildCommentRangeMap;
      RichEditLinesCount := SendMessageA(RichEdit1.Handle, EM_GETLINECOUNT, 0, 0);
      UpdateVisibleBounds;
      RichEdit1.Invalidate;
      RefreshTabsModified;
    end;
  finally
    ProgressStop;
  end;

  StatusBar1.SimpleText := Format('Заменено: %d', [N]);
  StatusBar1.SimplePanel := True;

  if SearchScope = ScopeList then
    BuildMatchList;
end;

// ---------------------------------------------------------------------------
//  Область поиска и замены (список cmbScope)
//
//    В окне            - текущий файл: Find-> / <-Find - следующее и
//                        предыдущее вхождение, Replace - по одному с
//                        вопросом, All - все сразу (FileFindNext,
//                        FileFindPrev, FileReplace, FileReplaceAll)
//    Список            - то же, и найденное в файле - в Match list
//    Во вкладках       - открытые вкладки;
//    В проекте         - файлы проекта (окно Find In Files: расширения);
//    На диске          - папки (окно Find In Files: папки, расширения);
//    Искать файл       - то же окно, но ищутся сами файлы по маскам
//                        (расширения и поле масок), образец не нужен; в
//                        Match list - имена файлов с размером и временем,
//                        щелчок открывает файл (FileSearchShow).
//  Для трёх последних: Find-> - Match list по области и переход к первому
//  вхождению, следующие нажатия - к следующему по списку (<-Find - к
//  предыдущему); Replace - поиск заново и по одному вхождению с вопросом,
//  файл открывается в редакторе; открытый для этого файл после своих
//  вхождений сохраняется (если что-то заменено) и закрывается, Undo
//  возвращает его с диска; All - поиск заново, вопрос с числом
//  вхождений и файлов, замена во всех. Файлы, открытые в редакторе,
//  меняются в редакторе (сохранять - как обычно); не открытые -
//  перезаписываются на диске в своей кодировке. Undo возвращает всё, что
//  поменял последний All, - и окна, и файлы на диске; окно, закрытое
//  после замены, - прежним текстом в файл, в его кодировке.
//  Режим Go to line - всегда в текущем файле.
// ---------------------------------------------------------------------------

function TForm1.SearchScope: Integer;
begin
  Result := ScopeFile;
  if cmbScope <> nil then
    Result := cmbScope.ItemIndex;
  if (Result < ScopeFile) or (Result > ScopeFileSearch) then
    Result := ScopeFile;
  // Go to line - переход по номеру строки в текущем файле
  if (cmbMode <> nil) and (cmbMode.ItemIndex = 2) then
    Result := ScopeFile;
end;

// Ключ списка в Match list: область, образец, Case, режим. Совпал с
// текущим - Find-> идёт по готовому списку, не ищет заново
function TForm1.MatchKeyFor(AScope: Integer; const APattern: string): string;
begin
  Result := IntToStr(AScope) + '|' + APattern + '|' +
            IntToStr(Ord(chkCase.Checked)) + '|' + IntToStr(cmbMode.ItemIndex);
end;

// Искать файл: окно поиска на диске в режиме масок; Find-> и <-Find
// открывают его, поиск - кнопкой «Найти» в нём
procedure TForm1.FileSearchShow;
begin
  if FFifRunning then
  begin
    FFifAbort := True;   // идёт поиск - кнопка его останавливает
    Exit;
  end;
  FifShowWindow(False, True);
end;

// Список «где искать»: «Искать файл», выбранный в раскрытом списке мышью
// или Enter (CBN_SELENDOK), - сразу окно поиска файлов. Стрелки при
// закрытом списке его не открывают: CBN_SELENDOK без раскрытого списка не
// считается. Окно - сообщением, когда список уже закрылся.
procedure TForm1.ScopeWndProc(var Message: TMessage);
begin
  FScopeOldProc(Message);
  if Message.Msg <> CN_COMMAND then
    Exit;
  case TWMCommand(Message).NotifyCode of
    CBN_DROPDOWN:
      FScopeDropped := True;
    CBN_SELENDOK:
      if FScopeDropped and (cmbScope.ItemIndex = ScopeFileSearch) then
        PostMessage(Handle, WM_USER + 325, 0, 0);
    CBN_CLOSEUP:
      FScopeDropped := False;
  end;
end;

// Enter на закрытом списке, где стоит «Искать файл», - окно поиска файлов
procedure TForm1.ScopeKeyDown(Sender: TObject; var Key: Word;
                              Shift: TShiftState);
begin
  if (Key = VK_RETURN) and not cmbScope.DroppedDown and
     (cmbScope.ItemIndex = ScopeFileSearch) then
  begin
    Key := 0;
    PostMessage(Handle, WM_USER + 325, 0, 0);
  end;
end;

procedure TForm1.WMScopeFileSearch(var Msg: TMessage);
begin
  if (cmbScope <> nil) and (cmbScope.ItemIndex = ScopeFileSearch) then
    FileSearchShow;
end;

procedure TForm1.DoFindNext(Sender: TObject);
begin
  if SearchScope = ScopeFileSearch then
    FileSearchShow
  else if SearchScope <= ScopeList then
    FileFindNext
  else
    MultiFindStep(True);
end;

procedure TForm1.DoFindPrev(Sender: TObject);
begin
  if SearchScope = ScopeFileSearch then
    FileSearchShow
  else if SearchScope <= ScopeList then
    FileFindPrev
  else
    MultiFindStep(False);
end;

procedure TForm1.DoReplace(Sender: TObject);
begin
  if SearchScope = ScopeFileSearch then
  begin
    StatusBar1.SimpleText := 'Искать файл: замены нет - только поиск файлов';
    StatusBar1.SimplePanel := True;
  end
  else if SearchScope <= ScopeList then
    FileReplace
  else
    MultiReplace;
end;

procedure TForm1.DoReplaceAll(Sender: TObject);
begin
  if SearchScope = ScopeFileSearch then
  begin
    StatusBar1.SimpleText := 'Искать файл: замены нет - только поиск файлов';
    StatusBar1.SimplePanel := True;
  end
  else if SearchScope <= ScopeList then
    FileReplaceAll
  else
    MultiReplaceAll;
end;

// Во вкладках - ровно то, что открыто вкладками, и в их порядке; текст из
// памяти (с несохранёнными правками). Результат - число вхождений
function TForm1.TabsToList(const APattern: string): Integer;
var
  TabIdx, WinIdx, MatchCount, Files: Integer;
begin
  Result := 0;
  Files := 0;
  StoreCurrentWindow;
  EnsureMatchForm;
  FMatchPattern := APattern;
  ResetMatchRows;
  for TabIdx := 0 to High(FTabWin) do
  begin
    WinIdx := FTabWin[TabIdx];
    if (WinIdx < 0) or (WinIdx > WindowsItemCount - 1) or
       not FWindows[WinIdx].Used then
      Continue;
    MatchCount := ScanTextForMatches(FWindows[WinIdx].FileName, WinIdx,
                                     FWindows[WinIdx].Text, APattern);
    if MatchCount > 0 then
    begin
      Inc(Result, MatchCount);
      Inc(Files);
    end;
  end;
  FillMatchGrid;
  if Result = 0 then
    FMatchForm.Caption := 'Match list - во вкладках ничего не найдено'
  else
    FMatchForm.Caption := Format('Match list - %d в %d вкладках',
                                 [Result, Files]);
  if not FMatchForm.Visible then
    PlaceMatchForm;
  FMatchForm.Show;
end;

// Match list по области (вкладки, проект, диск) - поиск заново. False -
// список не построен (пустой образец, поиск остановлен или его список
// заменили).
// AFindButton - вызов от Find-> / <-Find: для области "На диске" только
// открывается окно Find In Files (папки, маски можно поправить), поиск -
// кнопкой "Найти" в нём. Replace и All ищут сразу
function TForm1.SearchToList(AFindButton: Boolean): Boolean;
var
  Pattern: string;
begin
  Result := False;
  Pattern := cmbFind.Text; // без Trim: образец - как введён
  if Pattern = '' then
    Exit;
  AddHistory(cmbFind, Pattern);
  FMatchKey := '';
  FMatchCur := -1;
  case SearchScope of
    ScopeTabs:
      TabsToList(Pattern);
    ScopeProject, ScopeDisk:
    begin
      if AFindButton and (SearchScope = ScopeDisk) then
      begin
        FifShowWindow(False);
        Dbg('Find In Files (Find->): окно показано, поиск - кнопкой ' +
            '"Найти" в нём', clGray);
        Exit;
      end;
      EnsureMatchForm;
      ResetMatchRows;
      FillMatchGrid;
      FifShowWindow(SearchScope = ScopeProject);
      // Список файлов проекта прервали Стопом - или он ещё собирается
      // (Find-> нажали снова во время сбора)
      if FFifListAborted or FFifListing then
      begin
        Dbg('Find In Files (Find->): поиск не начат - список файлов ' +
            'прерван или ещё собирается', clGray);
        Exit;
      end;
      Dbg('Find In Files (Find->): окно показано, поиск запускается', clGray);
      FifRun;
      if FFifListTaken then
        Exit;
    end;
  else
    Exit;
  end;
  FMatchKey := MatchKeyFor(SearchScope, Pattern);
  Result := True;
end;

// Следующее (APrev = False) или предыдущее вхождение в Match list от
// AFrom; по кругу. -1 - вхождений нет
function TForm1.NextHitRow(AFrom: Integer; AForward: Boolean): Integer;
var
  Step, RowIdx, RowCount: Integer;
begin
  Result := -1;
  RowCount := Length(FMatchRows);
  if RowCount = 0 then
    Exit;
  if AForward then
    Step := 1
  else
    Step := -1;
  if (AFrom < 0) or (AFrom >= RowCount) then
    if AForward then
      AFrom := -1
    else
      AFrom := RowCount;
  RowIdx := AFrom;
  repeat
    RowIdx := RowIdx + Step;
    if RowIdx >= RowCount then
      RowIdx := 0
    else if RowIdx < 0 then
      RowIdx := RowCount - 1;
    if FMatchRows[RowIdx].Kind = mrkHit then
    begin
      Result := RowIdx;
      Exit;
    end;
  until RowIdx = AFrom;
end;

// Find-> / <-Find для вкладок, проекта, диска: по готовому списку, если он
// для того же образца и области, иначе - поиск заново и первое (для
// <-Find - последнее) вхождение
procedure TForm1.MultiFindStep(AForward: Boolean);
var
  Pattern: string;
  RowIdx: Integer;
begin
  Pattern := cmbFind.Text;
  if Pattern = '' then
    Exit;
  if FFifRunning then
  begin
    FFifAbort := True;   // идёт поиск - кнопка его останавливает
    Exit;
  end;
  if (FMatchKey <> MatchKeyFor(SearchScope, Pattern)) or (FMatchForm = nil) or
     not FMatchForm.Visible or (Length(FMatchRows) = 0) then
  begin
    if not SearchToList(True) then
      Exit;
    RowIdx := NextHitRow(-1, AForward);
  end
  else
  begin
    AddHistory(cmbFind, Pattern);
    RowIdx := NextHitRow(FMatchCur, AForward);
  end;
  if RowIdx < 0 then
  begin
    StatusBar1.SimpleText := 'Не найдено: ' + Pattern;
    StatusBar1.SimplePanel := True;
    Exit;
  end;
  ShowMatchRow(RowIdx);
  JumpToMatch(RowIdx);
end;

// Строка Match list - выделить в гриде; её группа свёрнута - раскрывается
procedure TForm1.ShowMatchRow(ARow: Integer);
var
  GrpIdx: Integer;
begin
  if (FMatchGrid = nil) or (ARow < 0) or (ARow + 1 >= FMatchGrid.RowCount) then
    Exit;
  if FMatchGrid.RowHeights[ARow + 1] <= 0 then
  begin
    GrpIdx := ARow;
    while (GrpIdx >= 0) and (FMatchRows[GrpIdx].Kind <> mrkGroup) do
      Dec(GrpIdx);
    if (GrpIdx < 0) or not FMatchRows[GrpIdx].Collapsed then
      Exit;
    FMatchRows[GrpIdx].Collapsed := False;
    ApplyMatchRowHeights(GrpIdx);
    FMatchGrid.Invalidate;
    if FMatchGrid.RowHeights[ARow + 1] <= 0 then
      Exit;
  end;
  FMatchGrid.Row := ARow + 1;
end;

// Совпадает ли выделение в редакторе с образцом (с учётом Case)
function TForm1.SelectionIsPattern(const APattern: string): Boolean;
var
  SelText: string;
begin
  Result := False;
  if RichEdit1.SelLength <> Length(APattern) then
    Exit;
  SelText := SelTextA(Length(APattern) + 1);
  if chkCase.Checked then
    Result := SelText = APattern
  else
    Result := AnsiUpperCase(SelText) = AnsiUpperCase(APattern);
end;

// Replace для вкладок, проекта, диска: поиск заново, затем по каждому
// вхождению - файл в редакторе, вопрос Да / Нет / Отмена. Позиции
// следующих вхождений той же строки сдвигаются на разницу длин
procedure TForm1.MultiReplace;
var
  Pattern, Replacement, FileName, CurFile: string;
  RowIdx, LaterIdx, Done, Skipped, Shift, LineNo, FileDone, Saved: Integer;
  CurOpenedHere: Boolean;
begin
  Pattern := cmbFind.Text;
  if Pattern = '' then
    Exit;
  if FFifRunning then
  begin
    FFifAbort := True;
    Exit;
  end;
  Replacement := cmbReplace.Text;
  AddHistory(cmbReplace, Replacement);
  if not SearchToList then
    Exit;

  Done := 0;
  Skipped := 0;
  Saved := 0;
  Shift := Length(Replacement) - Length(Pattern);
  // Файл, по которому идём: открыт ли здесь (вкладки до замены не было) и
  // сколько в нём заменено - по ним он закрывается (FinishReplFile)
  CurFile := '';
  CurOpenedHere := False;
  FileDone := 0;
  RowIdx := 0;
  while RowIdx <= High(FMatchRows) do
  begin
    if FMatchRows[RowIdx].Kind <> mrkHit then
    begin
      Inc(RowIdx);
      Continue;
    end;
    FileName := FMatchRows[RowIdx].FileName;
    if CompareText(FileName, CurFile) <> 0 then
    begin
      FinishReplFile(CurFile, CurOpenedHere, FileDone, Saved);
      CurFile := FileName;
      CurOpenedHere := IndexOfWindowByFile(FileName) < 0;
      FileDone := 0;
    end;
    ShowMatchRow(RowIdx);
    JumpToMatch(RowIdx);
    LineNo := FMatchRows[RowIdx].LineNo;
    // Файл не открылся или текст уже другой - вхождение пропускается
    if (CompareText(FCurrentFileName, FileName) <> 0) or
       not SelectionIsPattern(Pattern) then
    begin
      Inc(Skipped);
      Inc(RowIdx);
      Continue;
    end;
    case MessageDlg('Заменить это вхождение?' + #13#10 +
                    ExtractFileName(FileName) + ', строка ' +
                    IntToStr(LineNo + 1) + #13#10#13#10 +
                    Pattern + '  ->  ' + Replacement,
                    mtConfirmation, [mbYes, mbNo, mbCancel], 0) of
      mrYes:
      begin
        RichEdit1.SelText := Replacement;
        Inc(Done);
        Inc(FileDone);
        if Shift <> 0 then
          for LaterIdx := RowIdx + 1 to High(FMatchRows) do
            if (FMatchRows[LaterIdx].Kind = mrkHit) and
               (FMatchRows[LaterIdx].LineNo = LineNo) and
               (CompareText(FMatchRows[LaterIdx].FileName, FileName) = 0) then
              Inc(FMatchRows[LaterIdx].MatchPos, Shift);
      end;
      mrNo:
        ;
    else
      Break;
    end;
    Inc(RowIdx);
  end;
  // Последний файл (и при Отмене - тот, на котором остановились)
  FinishReplFile(CurFile, CurOpenedHere, FileDone, Saved);

  // Список - до замены: следующий Find-> ищет заново
  FMatchKey := '';
  StatusBar1.SimpleText := Format('Заменено: %d', [Done]);
  if Saved > 0 then
    StatusBar1.SimpleText := StatusBar1.SimpleText +
      Format('; файлов, открытых для замены, сохранено и закрыто: %d ' +
    '(Undo - вернуть их)', [Saved]);
             if Skipped > 0 then
             StatusBar1.SimpleText := StatusBar1.SimpleText +
             Format(', пропущено: %d (файл не открылся или текст изменился)', [Skipped]);
             StatusBar1.SimplePanel := True;
             UpdateStatusBarInfo;
             RefreshTabsModified;
end;

// Замена всех вхождений в тексте - по правилам поиска (Case, WholeWord).
// ACount - сколько заменено
function TForm1.ReplaceInText(const ASrc, APattern, AReplace: string;
                              var ACount: Integer): string;
var
  Hay, Pat, Res: string;
  PatLen, Start, FoundAt, Used, Cap: Integer;
  WholeW: Boolean;

  procedure Append(const APart: string);
  var
    PartLen: Integer;
  begin
    PartLen := Length(APart);
    if PartLen = 0 then
      Exit;
    while Used + PartLen > Cap do
    begin
      Cap := Cap * 2;
      SetLength(Res, Cap);
    end;
    Move(APart[1], Res[Used + 1], PartLen);
    Inc(Used, PartLen);
  end;

  function AtWordBounds(APos: Integer): Boolean;
  begin
    Result := ((APos = 1) or not IsWordChar(ASrc[APos - 1])) and
              ((APos + PatLen > Length(ASrc)) or
               not IsWordChar(ASrc[APos + PatLen]));
  end;

begin
  ACount := 0;
  Result := ASrc;
  PatLen := Length(APattern);
  if (PatLen = 0) or (ASrc = '') then
    Exit;
  WholeW := (cmbMode <> nil) and (cmbMode.ItemIndex = 1);
  if chkCase.Checked then
  begin
    Hay := ASrc;
    Pat := APattern;
  end
  else
  begin
    Hay := AnsiUpperCase(ASrc);
    Pat := AnsiUpperCase(APattern);
  end;
  Cap := Length(ASrc) + 1024;
  SetLength(Res, Cap);
  Used := 0;
  Start := 1;
  FoundAt := PosEx(Pat, Hay, Start);
  while FoundAt > 0 do
  begin
    if WholeW and not AtWordBounds(FoundAt) then
    begin
      FoundAt := PosEx(Pat, Hay, FoundAt + 1);
      Continue;
    end;
    Append(Copy(ASrc, Start, FoundAt - Start));
    Append(AReplace);
    Inc(ACount);
    Start := FoundAt + PatLen;
    FoundAt := PosEx(Pat, Hay, Start);
  end;
  if ACount = 0 then
    Exit;
  Append(Copy(ASrc, Start, Length(ASrc) - Start + 1));
  SetLength(Res, Used);
  Result := Res;
end;

// Прочитать файл с диска как есть (для Undo)
function ReadRawFile(const AFile: string; var AText: string): Boolean;
var
  Stream: TFileStream;
begin
  Result := False;
  AText := '';
  try
    Stream := TFileStream.Create(AFile, fmOpenRead or fmShareDenyNone);
    try
      SetLength(AText, Stream.Size);
      if Stream.Size > 0 then
        Stream.ReadBuffer(AText[1], Stream.Size);
    finally
      Stream.Free;
    end;
    Result := True;
  except
    AText := '';
  end;
end;

// Записать файл как есть (Undo)
function WriteRawFile(const AFile, AText: string): Boolean;
var
  Stream: TFileStream;
begin
  Result := False;
  try
    Stream := TFileStream.Create(AFile, fmCreate);
    try
      if AText <> '' then
        Stream.WriteBuffer(AText[1], Length(AText));
    finally
      Stream.Free;
    end;
    Result := True;
  except
  end;
end;

// Копия до замены All - для Undo
procedure TForm1.AddReplBackup(const AFile, AText: string; AOnDisk, AIsUtf8,
                               AHasBom: Boolean);
var
  BackupIdx: Integer;
begin
  BackupIdx := Length(FReplBackups);
  SetLength(FReplBackups, BackupIdx + 1);
  FReplBackups[BackupIdx].FileName := AFile;
  FReplBackups[BackupIdx].Text := AText;
  FReplBackups[BackupIdx].OnDisk := AOnDisk;
  FReplBackups[BackupIdx].IsUtf8 := AIsUtf8;
  FReplBackups[BackupIdx].HasBom := AHasBom;
end;

// Replace по одному: файл AFile пройден. Открыт здесь (до замены вкладки
// не было) - с заменами сохраняется (прежние байты - в копию для Undo) и
// вкладка закрывается; без замен - просто закрывается. Был открыт раньше -
// остаётся как есть, несохранённым. ASaved - сколько файлов записано
procedure TForm1.FinishReplFile(const AFile: string; AOpenedHere: Boolean;
                                AReplaced: Integer; var ASaved: Integer);
var
  WinIdx: Integer;
  Raw: string;
begin
  if not AOpenedHere or (AFile = '') then
    Exit;
  WinIdx := IndexOfWindowByFile(AFile);
  if WinIdx < 0 then
    Exit;
  if WinIdx <> FWindowsIndex then
    ActivateWindow(WinIdx);
  if AReplaced > 0 then
  begin
    if not ReadRawFile(AFile, Raw) then
      Exit;   // прочитать не удалось - вкладка остаётся, сохранять вручную
    if not SaveCurrentFile then
      Exit;
    // Первая запись этой серии - Undo теперь относится к ней
    if ASaved = 0 then
    begin
      SetLength(FReplBackups, 0);
      FReplaceBackup := '';
    end;
    AddReplBackup(AFile, Raw, True, False, False);
    Inc(ASaved);
  end;
  CloseWindow(WinIdx);
end;

// Новый текст окна AWinIdx: текущее - в редактор (одна карта, один раз),
// остальные - в память окна
procedure TForm1.SetWindowTextReplaced(AWinIdx: Integer; const AText: string);
begin
  if AWinIdx = FWindowsIndex then
  begin
    FLockHighlight := True;
    try
      SetEditorText(AText);
    finally
      FLockHighlight := False;
    end;
    RichEdit1.SelStart := 0;
    RichEdit1.SelLength := 0;
    RichEdit1.Modified := True;
    RebuildCommentRangeMap;
    RichEditLinesCount := SendMessageA(RichEdit1.Handle, EM_GETLINECOUNT, 0, 0);
    UpdateVisibleBounds;
    RichEdit1.Invalidate;
  end
  else
  begin
    FWindows[AWinIdx].Text := AText;
    FWindows[AWinIdx].Modified := True;
    FWindows[AWinIdx].MapValid := False;
    SetLength(FWindows[AWinIdx].CommentRanges, 0);
    SetLength(FWindows[AWinIdx].StringRanges, 0);
    if FWindows[AWinIdx].CursorPos > Length(AText) then
      FWindows[AWinIdx].CursorPos := 0;
    UpdateTabCaption(AWinIdx);
  end;
end;

// All для вкладок, проекта, диска: поиск заново, вопрос с числом
// вхождений и файлов, замена. Открытые файлы - в редакторе, остальные -
// на диске в своей кодировке (ReadTextFileDecoded / SaveTextFile)
procedure TForm1.MultiReplaceAll;
var
  Pattern, Replacement, Src, Res, Raw, Question: string;
  Files: TStringList;
  RowIdx, FileIdx, WinIdx, Total, FilesOnDisk, Count, Done, DoneFiles,
    Failed: Integer;
  SavedUtf8, SavedBom, FileUtf8, FileBom: Boolean;
begin
  Pattern := cmbFind.Text;
  if Pattern = '' then
    Exit;
  if FFifRunning then
  begin
    FFifAbort := True;
    Exit;
  end;
  Replacement := cmbReplace.Text;
  AddHistory(cmbReplace, Replacement);
  if not SearchToList then
    Exit;

  Files := TStringList.Create;
  try
    Total := 0;
    FilesOnDisk := 0;
    for RowIdx := 0 to High(FMatchRows) do
      if (FMatchRows[RowIdx].Kind = mrkGroup) and
         (FMatchRows[RowIdx].HitCount > 0) then
      begin
        Files.Add(FMatchRows[RowIdx].FileName);
        Inc(Total, FMatchRows[RowIdx].HitCount);
        if IndexOfWindowByFile(FMatchRows[RowIdx].FileName) < 0 then
          Inc(FilesOnDisk);
      end;
    if Total = 0 then
    begin
      StatusBar1.SimpleText := 'Не найдено: ' + Pattern;
      StatusBar1.SimplePanel := True;
      Exit;
    end;

    Question := Format('Заменить все вхождения: %d в %d файлах?',
                       [Total, Files.Count]) + #13#10#13#10 +
                Pattern + '  ->  ' + Replacement;
    if FilesOnDisk > 0 then
      Question := Question + #13#10#13#10 +
        Format('Не открыты в редакторе: %d - они будут перезаписаны на диске.',
               [FilesOnDisk]);
    Question := Question + #13#10'Откатить - кнопка Undo.';
    if MessageDlg(Question, mtWarning, [mbYes, mbNo], 0) <> mrYes then
      Exit;

    StoreCurrentWindow;
    SetLength(FReplBackups, 0);
    FReplaceBackup := '';
    Done := 0;
    DoneFiles := 0;
    Failed := 0;
    SavedUtf8 := FFileIsUtf8;
    SavedBom := FFileHasBom;
    try
      for FileIdx := 0 to Files.Count - 1 do
      begin
        WinIdx := IndexOfWindowByFile(Files[FileIdx]);
        if WinIdx >= 0 then
        begin
          if WinIdx = FWindowsIndex then
            Src := GetEditorText
          else
            Src := FWindows[WinIdx].Text;
          Res := ReplaceInText(Src, Pattern, Replacement, Count);
          if Count = 0 then
            Continue;
          if WinIdx = FWindowsIndex then
            AddReplBackup(FWindows[WinIdx].FileName, Src, False, FFileIsUtf8,
                          FFileHasBom)
          else
            AddReplBackup(FWindows[WinIdx].FileName, Src, False,
                          FWindows[WinIdx].IsUtf8, FWindows[WinIdx].HasBom);
          SetWindowTextReplaced(WinIdx, Res);
        end
        else
        begin
          if not ReadRawFile(Files[FileIdx], Raw) then
          begin
            Inc(Failed);
            Continue;
          end;
          Src := ReadTextFileDecoded(Files[FileIdx]);
          FileUtf8 := FFileIsUtf8;
          FileBom := FFileHasBom;
          Res := ReplaceInText(Src, Pattern, Replacement, Count);
          if Count = 0 then
            Continue;
          FFileIsUtf8 := FileUtf8;
          FFileHasBom := FileBom;
          try
            SaveTextFile(Files[FileIdx], Res);
            AddReplBackup(Files[FileIdx], Raw, True, False, False);
          except
            Inc(Failed);
            Continue;
          end;
        end;
        Inc(Done, Count);
        Inc(DoneFiles);
      end;
    finally
      FFileIsUtf8 := SavedUtf8;
      FFileHasBom := SavedBom;
    end;
  finally
    Files.Free;
  end;

  FMatchKey := '';
  RefreshTabsModified;
  if FMatchForm <> nil then
    FMatchForm.Caption := Format('Match list - заменено %d в %d файлах ' +
    '(список - до замены)', [Done, DoneFiles]);
                                 StatusBar1.SimpleText := Format('Заменено: %d в %d файлах', [Done, DoneFiles]);
                                 if Failed > 0 then
                                 StatusBar1.SimpleText := StatusBar1.SimpleText +
                                 Format(', не удалось записать: %d', [Failed]);
                                 StatusBar1.SimplePanel := True;
                                 UpdateStatusBarInfo;
end;

// Undo после All по вкладкам, проекту, диску: окна - прежний текст в
// окно (если файл открыт), файлы на диске - прежние байты
procedure TForm1.UndoMultiReplace;
var
  BackupIdx, WinIdx, Restored, Failed: Integer;
  SavedUtf8, SavedBom: Boolean;
begin
  Restored := 0;
  Failed := 0;
  StoreCurrentWindow;
  for BackupIdx := 0 to High(FReplBackups) do
  begin
    if FReplBackups[BackupIdx].OnDisk then
    begin
      if WriteRawFile(FReplBackups[BackupIdx].FileName,
                      FReplBackups[BackupIdx].Text) then
        Inc(Restored)
      else
        Inc(Failed);
      Continue;
    end;
    WinIdx := IndexOfWindowByFile(FReplBackups[BackupIdx].FileName);
    if WinIdx < 0 then
    begin
      // Окно закрыли (сохранив замену или нет) - прежний текст на диск, в
      // кодировке, в которой файл был открыт
      SavedUtf8 := FFileIsUtf8;
      SavedBom := FFileHasBom;
      try
        FFileIsUtf8 := FReplBackups[BackupIdx].IsUtf8;
        FFileHasBom := FReplBackups[BackupIdx].HasBom;
        try
          SaveTextFile(FReplBackups[BackupIdx].FileName,
                       FReplBackups[BackupIdx].Text);
          Inc(Restored);
        except
          Inc(Failed);
        end;
      finally
        FFileIsUtf8 := SavedUtf8;
        FFileHasBom := SavedBom;
      end;
      Continue;
    end;
    SetWindowTextReplaced(WinIdx, FReplBackups[BackupIdx].Text);
    Inc(Restored);
  end;
  SetLength(FReplBackups, 0);
  RefreshTabsModified;
  StatusBar1.SimpleText := Format('Отменена замена All: файлов %d', [Restored]);
  if Failed > 0 then
    StatusBar1.SimpleText := StatusBar1.SimpleText +
      Format(', не удалось записать: %d', [Failed]);
  StatusBar1.SimplePanel := True;
  UpdateStatusBarInfo;
end;

// Смена фильтра пересобирает список
procedure TForm1.ChkDisableRemClick(Sender: TObject);
begin
  BuildMatchList;
end;

// Возврат текста к состоянию до массовой замены
procedure TForm1.UndoReplaceAllClick(Sender: TObject);
begin
  // Последней была замена All по вкладкам, проекту или диску
  if Length(FReplBackups) > 0 then
  begin
    UndoMultiReplace;
    Exit;
  end;
  if FReplaceBackup = '' then
  begin
    ShowMessage('11337:Нет сохранённой копии: массовая замена не выполнялась.');
    Exit;
  end;

  if FReplaceBackupWin <> FWindowsIndex then
  begin
    ShowMessage('11343:Копия относится к другому окну. Переключитесь на него.');
    Exit;
  end;

  SetEditorText(FReplaceBackup);
  FReplaceBackup := '';

  RebuildCommentRangeMap;
  RichEdit1.Invalidate;
  UpdateStatusBarInfo;
end;

// Готовит подпись пункта Search: показывает выделенный фрагмент в фигурных
// скобках. Многострочное выделение сводим в одну строку и подрезаем - иначе
// пункт растянул бы меню на весь экран.
procedure TForm1.PopupMenuPopup(Sender: TObject);
const
  MaxLen = 40;
var
  S, L: string;
  I: Integer;
  ClickPt: TPoint;
  ClickChar: Integer;
  PopupSel: string;
  PopupMark: TBreakMark;
begin
  if pmuSearch = nil then
    Exit;

  // Вкладка с просмотром по формату: "Как текст" / "По формату" (меню
  // редактора - значит, сейчас текст)
  if pmuFmtText <> nil then
  begin
    pmuFmtText.Visible := FmtTabHasView;
    pmuFmtFormat.Visible := FmtTabHasView;
    pmuSepFmt.Visible := FmtTabHasView;
    pmuFmtFormat.Checked := False;
    pmuFmtText.Checked := True;
  end;

  // Для подписи хватает начала выделения
  S := SelTextA(MaxLen * 4);
  for I := 1 to Length(S) do
    if S[I] in [#13, #10, #9] then
      S[I] := ' ';
  S := Trim(S);

  if Length(S) > MaxLen then
    S := Copy(S, 1, MaxLen) + '...';

  pmuSearch.Caption := 'Search {' + S + '}';
  pmuSearch.Enabled := S <> '';

  // Регистр: выделение, а без него - слово под кареткой
  if S = '' then
    S := IdentAtCaret;
  if pmuUpper <> nil then
  begin
    pmuUpper.Caption := 'To UpperCase {' + S + '}';
    pmuUpper.Enabled := S <> '';
    pmuLower.Caption := 'To LowerCase {' + S + '}';
    pmuLower.Enabled := S <> '';
  end;

  // Debug: строка на языке файла - Паскаль или RapidQ Basic
  if pmuDebug <> nil then
  begin
    L := DebugLang;
    if L = 'bas' then
      pmuDebug.Caption := 'Debug (LogEdit)'
    else
      pmuDebug.Caption := 'Debug (RuntimeLog)';
    pmuDebug.Enabled := (L <> '') and (DebugExpr(L) <> '');
  end;

  // Run to cursor: файл на диске, программа не идёт или стоит
  if pmuRunToCursor <> nil then
    pmuRunToCursor.Enabled := (FCurrentFileName <> '') and DbgCanStep;

  // Add watch: имя там, где щёлкнули правой кнопкой; меню с клавиатуры
  // VCL вызывает в левом верхнем углу редактора - тогда имя у каретки.
  // Не на имени - пункт серый.
  // Строка щелчка - для пункта условия точки останова
  FPopupCondLine := CurrentLineIndex;
  if pmuAddWatch <> nil then
  begin
    FPopupWatchExpr := '';
    ClickPt := RichEdit1.ScreenToClient(FPopupMenu.PopupAt);
    if ((ClickPt.X <> 0) or (ClickPt.Y <> 0)) and
       PtInRect(RichEdit1.ClientRect, ClickPt) and
       (WindowFromPoint(FPopupMenu.PopupAt) = RichEdit1.Handle) then
    begin
      ClickChar := DbgCharAtClient(ClickPt);
      if ClickChar >= 0 then
        FPopupCondLine := SendMessageA(RichEdit1.Handle, EM_EXLINEFROMCHAR, 0,
                                       ClickChar);
      // Щелчок по выделению в одной строке - выражение целиком
      // ("SumIdx * 2"), как у Ctrl+F5; иначе - имя под мышью
      if (ClickChar >= 0) and (RichEdit1.SelLength > 0) and
         (ClickChar >= RichEdit1.SelStart) and
         (ClickChar <= RichEdit1.SelStart + RichEdit1.SelLength) then
      begin
        PopupSel := SelTextA(200);
        if (Pos(#13, PopupSel) = 0) and (Pos(#10, PopupSel) = 0) then
          FPopupWatchExpr := Trim(PopupSel);
      end;
      if (FPopupWatchExpr = '') and (ClickChar >= 0) then
        FPopupWatchExpr := DbgExprAtChar(ClickChar);
    end
    else
      FPopupWatchExpr := DbgExprAtCaret;
    if FPopupWatchExpr <> '' then
      pmuAddWatch.Caption := 'Add watch {' + FPopupWatchExpr + '}'#9'Ctrl+F5'
    else
      pmuAddWatch.Caption := 'Add watch'#9'Ctrl+F5';
    pmuAddWatch.Enabled := FPopupWatchExpr <> '';
  end;

  // Условие точки останова (RapidQ): у строки щелчка, с нынешним условием
  if pmuBreakCond <> nil then
  begin
    PopupMark := nil;
    if (FCurrentFileName <> '') and (FPopupCondLine >= 0) then
      PopupMark := DbgMarkAt(FCurrentFileName, FPopupCondLine);
    if (PopupMark <> nil) and (PopupMark.Condition <> '') then
      pmuBreakCond.Caption := 'Breakpoint condition {' +
                              PopupMark.Condition + '}...'
    else
      pmuBreakCond.Caption := 'Breakpoint condition...';
    pmuBreakCond.Enabled := (FCurrentFileName <> '') and (FPopupCondLine >= 0);
  end;
end;

// Переносит выделенный фрагмент в поле поиска. Сам поиск не запускаем -
// пользователь сначала выбирает режим и галки.
//
// Текст берётся ДОСЛОВНО, без Trim и без замены пробельных символов: искать
// надо ровно то, что выделено. Приводится к одной строке только ПОДПИСЬ
// пункта меню, и делает это PopupMenuPopup на своей копии.
procedure TForm1.SearchSelectedClick(Sender: TObject);
var
  S: string;
begin
  S := SelTextA(MaxInt);
  if S = '' then
    Exit;

  AddHistory(cmbFind, S);
  if cmbFind.CanFocus then
    cmbFind.SetFocus;
end;

// ---------------------------------------------------------------------------
//  Окно результатов поиска
//
//  Один грид на два режима. Обычный поиск по текущему файлу кладёт в него одну
//  группу, Find In Files - по группе на каждый файл, где что-то нашлось.
//  Заголовок группы - строка с путём и квадратиком +/-, под ним вхождения.
//  Свёрнутая группа не удаляется из массива: её строкам просто ставится
//  нулевая высота, поэтому индексы вхождений остаются прежними.
// ---------------------------------------------------------------------------

// Создаёт окно, если его ещё нет. Дальше оно только показывается и прячется:
// пересоздавать форму на каждый поиск незачем.
procedure TForm1.EnsureMatchForm;
var
  Dlg: TDlgMatchList;
begin
  if FMatchForm <> nil then
    Exit;

  // Окно описано в DlgMatchList.dfm. Здесь - обработчики (все они работают
  // с данными главного окна) и то, что считается от констант
  // MatchFormWidth и MatchRowHeight: по ним же ищется место окна и
  // раскладываются колонки при смене размера.
  Dlg := TDlgMatchList.Create(Self);
  FMatchForm := Dlg;
  FMatchGrid := Dlg.grdMatches;
  FMatchBottom := Dlg.pnlBottom;
  chkDisableRem := Dlg.chkDisableRem;

  FMatchForm.ClientWidth := MatchFormWidth;
  FMatchForm.OnClose := MatchFormClose;
  FMatchForm.OnResize := MatchFormResize;

  // Три колонки: номер строки, текст, счётчик вхождений. Счётчик вынесен
  // в отдельную колонку - в одной ячейке с путём он наезжал на длинные пути.
  FMatchGrid.DefaultRowHeight := MatchRowHeight;
  FMatchGrid.ColWidths[0] := 44;
  FMatchGrid.ColWidths[2] := 66;
  FMatchGrid.ColWidths[1] := MatchFormWidth - 44 - 66 - 22;
  // Рисуем сами (DefaultDrawing = False в .dfm): заголовки групп,
  // квадратики и подсветку вхождений штатной отрисовкой грида не получить
  FMatchGrid.OnDrawCell := MatchGridDrawCell;
  // Не OnClick: MouseToCell по координатам нажатия отдаёт строку сразу, а
  // OnClick сработал бы уже после того, как грид сам переставит выделение
  FMatchGrid.OnMouseDown := MatchGridMouseDown;

  // Фильтр комментариев относится к списку, поэтому и живёт на его окне
  chkDisableRem.OnClick := ChkDisableRemClick;

  // Цвета IDE (Light / Dark)
  UiApplyForm(FMatchForm);
end;

// Ставит окно справа от главного, с нахлёстом в MatchOverlap.
//
// Положение пересчитываем на каждый показ: главное окно могли подвинуть или
// развернуть, а список должен оставаться при нём.
procedure TForm1.PlaceMatchForm;
var
  L, ScrLeft, ScrRight: Integer;
begin
  if FMatchForm = nil then
    Exit;

  FMatchForm.ClientWidth := MatchFormWidth;
  FMatchForm.Top := Top;
  FMatchForm.Height := Height;

  ScrLeft := Screen.WorkAreaLeft;
  ScrRight := Screen.WorkAreaLeft + Screen.WorkAreaWidth;

  L := Left + Width - MatchOverlap;

  // За правый край рабочей области не уводим: иначе список окажется наполовину
  // за экраном, и как раз им пользоваться и не получится
  if L + FMatchForm.Width > ScrRight then
    L := ScrRight - FMatchForm.Width;
  if L < ScrLeft then
    L := ScrLeft;

  FMatchForm.Left := L;
  MatchFormResize(nil);
end;

// Текстовая колонка занимает всё, что осталось от окна
procedure TForm1.MatchFormResize(Sender: TObject);
var
  W: Integer;
begin
  if (FMatchForm = nil) or (FMatchGrid = nil) then
    Exit;

  W := FMatchForm.ClientWidth - FMatchGrid.ColWidths[0] -
       FMatchGrid.ColWidths[2] - 22;
  if W < 120 then
    W := 120;
  FMatchGrid.ColWidths[1] := W;
end;

procedure TForm1.ResetMatchRows;
begin
  SetLength(FMatchRows, 0);
end;

// Добавляет заголовок файла и возвращает его индекс: вызывающий потом
// проставит в него HitCount, когда досчитает вхождения
function TForm1.AddMatchGroup(const AFile: string; AWinIdx: Integer): Integer;
var
  N: Integer;
begin
  N := Length(FMatchRows);
  SetLength(FMatchRows, N + 1);
  FMatchRows[N].Kind := mrkGroup;
  FMatchRows[N].FileName := AFile;
  FMatchRows[N].WinIdx := AWinIdx;
  FMatchRows[N].LineNo := -1;
  FMatchRows[N].MatchPos := 0;
  FMatchRows[N].Text := '';
  FMatchRows[N].HitCount := 0;
  // Find In Files: сначала только имена файлов, вхождения - по щелчку
  // на плюсе (или Find-> раскрывает группу, в которую переходит)
  FMatchRows[N].Collapsed := FFifRunning;
  Result := N;
end;

procedure TForm1.AddMatchHit(const AFile: string; AWinIdx, ALineNo,
                             AMatchPos: Integer; const ALine: string);
var
  N: Integer;
begin
  N := Length(FMatchRows);
  SetLength(FMatchRows, N + 1);
  FMatchRows[N].Kind := mrkHit;
  FMatchRows[N].FileName := AFile;
  FMatchRows[N].WinIdx := AWinIdx;
  FMatchRows[N].LineNo := ALineNo;
  FMatchRows[N].MatchPos := AMatchPos;
  FMatchRows[N].Text := TrimLeft(ALine);
  FMatchRows[N].HitCount := 0;
  FMatchRows[N].Collapsed := False;
end;

// Переносит массив в грид. Текст ячеек не заполняем: рисуем всё сами, а Cells
// нужны гриду только чтобы знать размерность.
procedure TForm1.FillMatchGrid;
begin
  if FMatchGrid = nil then
    Exit;

  if Length(FMatchRows) = 0 then
  begin
    FMatchGrid.RowCount := 2;
    FMatchGrid.RowHeights[1] := MatchRowHeight;
    FMatchGrid.Row := 1;
    Exit;
  end;

  FMatchGrid.RowCount := Length(FMatchRows) + 1;
  FMatchGrid.Row := 1;
  ApplyMatchRowHeights;
  FMatchGrid.Invalidate;
end;

// Высоты строк: у свёрнутой группы её вхождения прячутся.
//
// Не ноль, а минус ширина линии сетки. Грид считает занятое строкой место как
// высота + GridLineWidth, поэтому при нуле от каждой спрятанной строки
// остаётся её разделитель: сто восемьдесят свёрнутых вхождений давали сплошную
// серую полосу в сто восемьдесят пикселей. При -GridLineWidth сумма ровно
// ноль, и строка исчезает целиком.
// AFirst - с какой строки (новые строки по ходу поиска, FifGridGrow)
procedure TForm1.ApplyMatchRowHeights(AFirst: Integer);
var
  I, Grp, Hidden: Integer;
begin
  if FMatchGrid = nil then
    Exit;

  Hidden := -FMatchGrid.GridLineWidth;
  if AFirst < 0 then
    AFirst := 0;

  // Группа строки AFirst - ближайший заголовок выше
  Grp := -1;
  for I := AFirst - 1 downto 0 do
    if (I <= High(FMatchRows)) and (FMatchRows[I].Kind = mrkGroup) then
    begin
      Grp := I;
      Break;
    end;
  for I := AFirst to High(FMatchRows) do
  begin
    if FMatchRows[I].Kind = mrkGroup then
    begin
      Grp := I;
      FMatchGrid.RowHeights[I + 1] := MatchRowHeight;
    end
    else
      if (Grp >= 0) and FMatchRows[Grp].Collapsed then
        FMatchGrid.RowHeights[I + 1] := Hidden
      else
        FMatchGrid.RowHeights[I + 1] := MatchRowHeight;
  end;
end;

procedure TForm1.MatchGridDrawCell(Sender: TObject; ACol, ARow: Integer;
                                   Rect: TRect; State: TGridDrawState);
var
  Cnv: TCanvas;
  Idx, Saved, X, P, Q, BoxSize, BoxLeft, BoxTop, BoxMid: Integer;
  S, Part: string;
  Selected: Boolean;
begin
  Cnv := FMatchGrid.Canvas;
  Cnv.Font := FMatchGrid.Font;
  // Цвета - таблицы (FixedColor, Color, Font.Color), а не системные: их
  // ставят цвета IDE (IDE Light / IDE Dark)

  // Клип по ячейке. Без него длинная строка вылезает за колонку и пачкает
  // соседние: штатной отрисовки, которая это делает сама, мы лишились.
  Saved := SaveDC(Cnv.Handle);
  try
    IntersectClipRect(Cnv.Handle, Rect.Left, Rect.Top, Rect.Right, Rect.Bottom);

    // --- шапка
    if ARow = 0 then
    begin
      Cnv.Brush.Color := FMatchGrid.FixedColor;
      Cnv.FillRect(Rect);
      Cnv.Font.Color := FMatchGrid.Font.Color;
      case ACol of
        0: S := 'Line';
        1: S := 'Текст строки';
      else
        S := 'Matches';
      end;
      Cnv.TextOut(Rect.Left + 3, Rect.Top + 1, S);
      Exit;
    end;

    Idx := ARow - 1;
    if (Idx < 0) or (Idx > High(FMatchRows)) then
    begin
      Cnv.Brush.Color := FMatchGrid.Color;
      Cnv.FillRect(Rect);
      Exit;
    end;

    // --- заголовок файла: свой цвет (Match.FileBG, Match.FileText) и
    // полужирный - строку файла видно среди найденных строк
    if FMatchRows[Idx].Kind = mrkGroup then
    begin
      Cnv.Brush.Color := UiColor('Match.FileBG');
      Cnv.FillRect(Rect);
      Cnv.Font.Color := UiColor('Match.FileText');
      Cnv.Font.Style := [fsBold];

      // Искать файл: строка-файл без вхождений - без квадратика, справа
      // размер и время
      if FMatchRows[Idx].HitCount < 0 then
      begin
        Cnv.Brush.Style := bsClear;
        if ACol = 1 then
          Cnv.TextOut(Rect.Left + 3, Rect.Top + 1, FMatchRows[Idx].FileName +
                      '      ' + FMatchRows[Idx].Text);
        Cnv.Brush.Style := bsSolid;
        Exit;
      end;
      if ACol = 0 then
      begin
        BoxSize := 9;
        BoxLeft := Rect.Left + 5;
        BoxTop := Rect.Top + (Rect.Bottom - Rect.Top - BoxSize) div 2;
        BoxMid := BoxSize div 2;

        Cnv.Brush.Color := FMatchGrid.Color;
        Cnv.Pen.Color := clGray;
        Cnv.Rectangle(BoxLeft, BoxTop, BoxLeft + BoxSize, BoxTop + BoxSize);

        Cnv.Pen.Color := FMatchGrid.Font.Color;
        Cnv.MoveTo(BoxLeft + 2, BoxTop + BoxMid);
        Cnv.LineTo(BoxLeft + BoxSize - 2, BoxTop + BoxMid);

        // Свёрнутая группа - плюс: к минусу добавляется вертикальная черта
        if FMatchRows[Idx].Collapsed then
        begin
          Cnv.MoveTo(BoxLeft + BoxMid, BoxTop + 2);
          Cnv.LineTo(BoxLeft + BoxMid, BoxTop + BoxSize - 2);
        end;
      end
      else if ACol = 1 then
      begin
        Cnv.Brush.Style := bsClear;
        Cnv.TextOut(Rect.Left + 3, Rect.Top + 1, FMatchRows[Idx].FileName);
        Cnv.Brush.Style := bsSolid;
      end
      else
      begin
        S := IntToStr(FMatchRows[Idx].HitCount);
        Cnv.Brush.Style := bsClear;
        Cnv.TextOut(Rect.Right - 6 - Cnv.TextWidth(S), Rect.Top + 1, S);
        Cnv.Brush.Style := bsSolid;
      end;
      Exit;
    end;

    // --- найденная строка
    Selected := gdSelected in State;

    if Selected then
    begin
      Cnv.Brush.Color := clHighlight;
      Cnv.Font.Color := clHighlightText;
    end
    else
    begin
      Cnv.Brush.Color := FMatchGrid.Color;
      Cnv.Font.Color := FMatchGrid.Font.Color;
    end;
    Cnv.FillRect(Rect);

    if ACol = 0 then
    begin
      // Номер строки прижимаем вправо: так столбик цифр читается колонкой
      S := IntToStr(FMatchRows[Idx].LineNo + 1);
      Cnv.Brush.Style := bsClear;
      Cnv.TextOut(Rect.Right - 5 - Cnv.TextWidth(S), Rect.Top + 1, S);
      Cnv.Brush.Style := bsSolid;
      Exit;
    end;

    // Счётчик бывает только у заголовка файла - у вхождения ячейка пустая
    if ACol = 2 then
      Exit;

    S := FMatchRows[Idx].Text;
    X := Rect.Left + 3;

    // Без образца подсвечивать нечего - выводим строку одним куском
    if FMatchPattern = '' then
    begin
      Cnv.Brush.Style := bsClear;
      Cnv.TextOut(X, Rect.Top + 1, S);
      Cnv.Brush.Style := bsSolid;
      Exit;
    end;

    // Разрезаем строку по вхождениям и рисуем кусками. Ищем ровно тем же
    // MatchPosFrom, что и сам поиск: иначе в режиме WholeWord подсветились бы
    // и куски слов, которых в списке нет.
    P := 1;
    while P <= Length(S) do
    begin
      Q := MatchPosFrom(S, FMatchPattern, P);
      if Q = 0 then
        Break;

      if Q > P then
      begin
        Part := Copy(S, P, Q - P);
        Cnv.Brush.Style := bsClear;
        Cnv.TextOut(X, Rect.Top + 1, Part);
        Cnv.Brush.Style := bsSolid;
        Inc(X, Cnv.TextWidth(Part));
      end;

      // Найденный кусок - своим спокойным цветом (Match.HitBG,
      // Match.HitText), а не системным цветом выделения
      Part := Copy(S, Q, Length(FMatchPattern));
      Cnv.Brush.Color := UiColor('Match.HitBG');
      Cnv.Font.Color := UiColor('Match.HitText');
      Cnv.TextOut(X, Rect.Top + 1, Part);
      Inc(X, Cnv.TextWidth(Part));

      if Selected then
      begin
        Cnv.Brush.Color := clHighlight;
        Cnv.Font.Color := clHighlightText;
      end
      else
      begin
        Cnv.Brush.Color := FMatchGrid.Color;
        Cnv.Font.Color := FMatchGrid.Font.Color;
      end;

      P := Q + Length(FMatchPattern);
    end;

    if P <= Length(S) then
    begin
      Part := Copy(S, P, Length(S) - P + 1);
      Cnv.Brush.Style := bsClear;
      Cnv.TextOut(X, Rect.Top + 1, Part);
      Cnv.Brush.Style := bsSolid;
    end;

  finally
    RestoreDC(Cnv.Handle, Saved);
  end;
end;

procedure TForm1.MatchGridMouseDown(Sender: TObject; Button: TMouseButton;
                                    Shift: TShiftState; X, Y: Integer);
var
  C, R, Idx: Integer;
begin
  if Button <> mbLeft then
    Exit;

  FMatchGrid.MouseToCell(X, Y, C, R);
  if R < 1 then
    Exit;

  // Спрятанная строка всё равно попадает под MouseToCell, если по её месту
  // щёлкнуть. Именно отсюда и брались переходы не в тот файл: клик по серой
  // полосе свёрнутой группы отдавал одну из её скрытых строк.
  if FMatchGrid.RowHeights[R] <= 0 then
    Exit;

  Idx := R - 1;
  if (Idx < 0) or (Idx > High(FMatchRows)) then
    Exit;

  // По заголовку сворачиваем группу целиком, а не только по квадратику:
  // попасть в девять пикселей мышью труднее, чем в строку
  if (FMatchRows[Idx].Kind = mrkGroup) and (FMatchRows[Idx].HitCount < 0) then
    // Искать файл: строка-файл - открыть файл
    OpenNamedFile(FMatchRows[Idx].FileName)
  else if FMatchRows[Idx].Kind = mrkGroup then
    ToggleMatchGroup(Idx)
  else
    JumpToMatch(Idx);
end;

procedure TForm1.ToggleMatchGroup(Idx: Integer);
begin
  if (Idx < 0) or (Idx > High(FMatchRows)) then
    Exit;
  if FMatchRows[Idx].Kind <> mrkGroup then
    Exit;

  // Выделение переводим на сам заголовок ДО сворачивания: если оно останется
  // на строке, которой сейчас дадут нулевую высоту, грид попытается её
  // показать и утащит прокрутку в непонятное место
  FMatchGrid.Row := Idx + 1;

  FMatchRows[Idx].Collapsed := not FMatchRows[Idx].Collapsed;
  ApplyMatchRowHeights;
  FMatchGrid.Invalidate;
end;

// Ищет слот по имени файла. Пути приводим ExpandFileName: один и тот же файл
// мог попасть в список из папки абсолютным путём, а в окно - относительным
// или другой записью, и простое сравнение строк их не сведёт.
function TForm1.IndexOfWindowByFile(const AFile: string): Integer;
var
  I: Integer;
  Target, Short, Cur: string;
begin
  Result := -1;
  if AFile = '' then
    Exit;

  Target := ExpandFileName(AFile);
  Short := ExtractShortPathName(Target); // пусто, если файла нет на диске

  for I := 0 to WindowsItemCount - 1 do
  begin
    if (not FWindows[I].Used) or (FWindows[I].FileName = '') then
      Continue;

    Cur := ExpandFileName(FWindows[I].FileName);
    if CompareText(Cur, Target) = 0 then
    begin
      Result := I;
      Exit;
    end;

    // Запасной ход: один и тот же файл мог быть записан длинным именем, а
    // другой раз коротким 8.3. Короткая форма у них общая.
    if (Short <> '') and
       (CompareText(ExtractShortPathName(Cur), Short) = 0) then
    begin
      Result := I;
      Exit;
    end;
  end;
end;

// Переход по найденной строке. Файл мог быть и не открыт - тогда открываем.
procedure TForm1.JumpToMatch(Idx: Integer);
var
  FN: string;
  I, W, LineStart: Integer;
begin
  if (Idx < 0) or (Idx > High(FMatchRows)) then
    Exit;

  FN := FMatchRows[Idx].FileName;
  if FN = '' then
    Exit;
  FMatchCur := Idx;

  // Слот ищем заново, а не берём из строки: между поиском и кликом окно могли
  // закрыть, и по старому индексу лежит уже другой файл
  W := IndexOfWindowByFile(FN);

  if W < 0 then
  begin
    OpenNamedFile(FN);
    W := IndexOfWindowByFile(FN);
    if W < 0 then
      Exit; // не открылся - переходить некуда
  end;

  if W <> FWindowsIndex then
    ActivateWindow(W);

  // Запоминаем слот во всех строках этого файла: соседнее вхождение уже не
  // пойдёт открывать файл заново
  for I := 0 to High(FMatchRows) do
    if CompareText(FMatchRows[I].FileName, FN) = 0 then
      FMatchRows[I].WinIdx := W;

  // Подсвечиваем найденное штатным выделением редактора: отрисовка выделения
  // уже есть в DrawRun, и мышью получается ровно тот же вид
  LineStart := SendMessageA(RichEdit1.Handle, EM_LINEINDEX,
                            FMatchRows[Idx].LineNo, 0);

  if (LineStart < 0) or (FMatchRows[Idx].MatchPos <= 0) then
  begin
    GotoLine(FMatchRows[Idx].LineNo); // позиции нет - просто встаём на строку
    Exit;
  end;

  if RichEdit1.CanFocus then
    RichEdit1.SetFocus;

  RichEdit1.SelStart := LineStart + FMatchRows[Idx].MatchPos - 1;
  RichEdit1.SelLength := Length(FMatchPattern);
  SendMessageA(RichEdit1.Handle, EM_SCROLLCARET, 0, 0);
  CenterCaretLine;
  UpdateStatusBarInfo;
end;

procedure TForm1.MatchFormClose(Sender: TObject; var Action: TCloseAction);
begin
  Action := caHide; // окно переиспользуем, а не пересоздаём
end;

// Собирает список строк, в которых встретился образец - по текущему файлу.
// Группа тут всегда одна, но формат строк общий с Find In Files.
procedure TForm1.BuildMatchList;
var
  S: string;
  N: Integer;
begin
  S := cmbFind.Text; // без Trim: образец должен совпадать с введённым дословно
  if S = '' then
    Exit;
  AddHistory(cmbFind, S);

  // Идёт Find In Files: Match list теперь под этот список, поиск
  // останавливается и строки в список больше не добавляет
  if FFifRunning then
  begin
    FFifAbort := True;
    FFifListTaken := True;
  end;

  EnsureMatchForm;
  FMatchPattern := S;
  FMatchKey := '';
  ResetMatchRows;

  N := ScanTextForMatches(FCurrentFileName, FWindowsIndex, GetEditorText, S);

  FillMatchGrid;
  FMatchForm.Caption := Format('Match list - %d', [N]);
  PlaceMatchForm;
  FMatchForm.Show;
end;

// ---------------------------------------------------------------------------
//  Find In Files
//
//  Три области на выбор: открытые вкладки, файлы текущего проекта, папка.
//  Для открытых файлов берём текст ИЗ ПАМЯТИ, а не с диска: несохранённые
//  правки тоже должны находиться.
// ---------------------------------------------------------------------------

// Прогоняет готовый текст по строкам. Возвращает число вхождений и, если
// хоть одно нашлось, успевает завести под них группу.
function TForm1.ScanTextForMatches(const AFile: string; AWinIdx: Integer;
                                   const AText, APattern: string): Integer;
var
  L: TStringList;
  I, Grp, MPos: Integer;
begin
  Result := 0;
  Grp := -1;

  L := TStringList.Create;
  try
    L.Text := AText;
    for I := 0 to L.Count - 1 do
    begin
      MPos := MatchPosInLine(L[I], APattern);
      if MPos = 0 then
        Continue;

      // Признак комментария берётся из схемы ТЕКУЩЕГО файла. Для чужого
      // расширения он может не подойти - это осознанное упрощение.
      if (chkDisableRem <> nil) and chkDisableRem.Checked and
         FScheme.IsCommentLine(L[I]) then
        Continue;

      if Grp < 0 then
        Grp := AddMatchGroup(AFile, AWinIdx);

      AddMatchHit(AFile, AWinIdx, I, MPos, L[I]);
      Inc(Result);
    end;

    if Grp >= 0 then
      FMatchRows[Grp].HitCount := Result;
  finally
    L.Free;
  end;
end;

// ---------------------------------------------------------------------------
//  Find In Files: файлы проекта и файлы на диске
//
//  Окно Find In Files (DlgFifDisk) немодальное: главное окно и Match list
//  во время поиска работают. Найденное попадает в Match list сразу, по
//  мере просмотра файлов (FifStep, раз в 100 мс); кнопка "Найти" на время
//  поиска - "Стоп"; кнопки Find->, Replace, All главного окна - тоже стоп.
//  Расширения - список с галками в окне: для файлов проекта - расширения
//  файлов проекта (с числом файлов), для диска - свой список
//  ([FindInFiles] DiskExts в editor.ini) плюс поле других масок.
//
//  Открытый в окне файл берётся из памяти (с несохранёнными правками), и
//  строка результата сразу знает его окно. Остальные читаются с диска как
//  есть, в кодировке Windows: UTF-8 не перекодируется, русский образец в
//  файле UTF-8 не найдётся.
//  Пропускаются: файлы больше 32 МБ и двоичные (нулевой байт в первых 4 КБ).
// ---------------------------------------------------------------------------

// Папки поиска на диске - строка через ";" (кнопка "..." подставляет все
// отмеченные в Directory Tree). Пустые убираются, \ в конце - тоже.
procedure FifSplitDirs(const AText: string; ADirs: TStrings);
var
  Rest, Item: string;
  SemiAt: Integer;
begin
  ADirs.Clear;
  Rest := AText;
  while Rest <> '' do
  begin
    SemiAt := Pos(';', Rest);
    if SemiAt = 0 then
      SemiAt := Length(Rest) + 1;
    Item := Trim(Copy(Rest, 1, SemiAt - 1));
    Delete(Rest, 1, SemiAt);
    if Length(Item) > 3 then
      Item := ExcludeTrailingPathDelimiter(Item);
    if Item <> '' then
      ADirs.Add(Item);
  end;
end;

// Расширение из строки списка ".pas  (12)" - до пробела, в нижнем регистре
function FifExtOfItem(const AItem: string): string;
var
  SpaceAt: Integer;
begin
  Result := Trim(AItem);
  SpaceAt := Pos(' ', Result);
  if SpaceAt > 0 then
    Result := Copy(Result, 1, SpaceAt - 1);
  Result := LowerCase(Result);
end;

// Есть ли расширение AExt в списке через ";" (".pas;.inc")
function FifExtInList(const AExt, AList: string): Boolean;
begin
  Result := (AExt <> '') and
            (Pos(';' + LowerCase(AExt) + ';', ';' + LowerCase(AList) + ';') > 0);
end;

// Добавить расширение в список через ";", если его там нет
procedure FifExtAdd(var AList: string; const AExt: string);
begin
  if (AExt = '') or FifExtInList(AExt, AList) then
    Exit;
  if AList <> '' then
    AList := AList + ';';
  AList := AList + LowerCase(AExt);
end;

// Окно Find In Files: создать (один раз), заполнить и показать. Во время
// поиска - только показать
procedure TForm1.FifShowWindow(AProject: Boolean; AFileMode: Boolean);
var
  Dlg: TDlgFifDisk;
  Ini: TIniFile;
  DirText, OtherMasks: string;
  SubDirs: Boolean;
begin
  if FFifDlg = nil then
  begin
    Dlg := TDlgFifDisk.Create(Self);
    FFifDlg := Dlg;
    // Строка хода меняется во время поиска - без мерцания
    Dlg.DoubleBuffered := True;
    Dlg.btnOk.OnClick := FifFindClick;
    Dlg.btnCancel.OnClick := FifCloseClick;
    Dlg.btnBrowse.OnClick := FifBrowseClick;
    Dlg.btnExtAll.OnClick := FifExtAllClick;
    Dlg.btnExtNone.OnClick := FifExtNoneClick;
    Dlg.btnExtDelete.OnClick := FifExtDeleteClick;
    Dlg.btnMaskAdd.OnClick := FifMaskAddClick;
    Dlg.OnClose := FifDlgClose;
    UiApplyForm(Dlg);
  end;
  Dlg := TDlgFifDisk(FFifDlg);
  if FFifRunning or FFifListing then
  begin
    Dlg.Show;
    Exit;
  end;
  FFifListAborted := False;

  FFifProject := AProject;
  FFifFileMode := AFileMode and not AProject;
  DirText := '';
  OtherMasks := '';
  SubDirs := True;
  if FileExists(SettingsFileName) then
  begin
    Ini := TIniFile.Create(SettingsFileName);
    try
      DirText := Ini.ReadString('FindInFiles', 'Dir', '');
      OtherMasks := Ini.ReadString('FindInFiles', 'OtherMasks', '');
      SubDirs := Ini.ReadBool('FindInFiles', 'SubDirs', True);
    finally
      Ini.Free;
    end;
  end;

  if AProject then
  begin
    Dlg.Caption := 'Find In Files - файлы проекта';
    Dlg.lblDir.Caption := 'Проект';
    Dlg.edDir.Text := FCurrentProject;
    Dlg.edDir.Enabled := False;
    Dlg.btnBrowse.Enabled := False;
    Dlg.lblMask.Enabled := False;
    Dlg.edMask.Text := '';
    Dlg.edMask.Enabled := False;
    Dlg.chkSub.Enabled := False;
    // Список масок проекта - расширения его файлов, не правится
    Dlg.btnMaskAdd.Enabled := False;
    Dlg.btnExtDelete.Enabled := False;
  end
  else
  begin
    if FFifFileMode then
      Dlg.Caption := 'Искать файл - по маскам, на диске'
    else
      Dlg.Caption := 'Find In Files - на диске';
    Dlg.lblDir.Caption := 'Папки';
    if DirText = '' then
      if FCurrentFileName <> '' then
        DirText := ExtractFilePath(FCurrentFileName)
      else
        DirText := ProjectsDir;
    Dlg.edDir.Text := DirText;
    Dlg.edDir.Enabled := True;
    Dlg.btnBrowse.Enabled := True;
    Dlg.lblMask.Enabled := True;
    Dlg.edMask.Text := OtherMasks;
    Dlg.edMask.Enabled := True;
    Dlg.chkSub.Enabled := True;
    Dlg.btnMaskAdd.Enabled := True;
    Dlg.btnExtDelete.Enabled := True;
    Dlg.chkSub.Checked := SubDirs;
  end;

  // Окно - сразу: список файлов проекта для галок расширений собирается
  // в FifFillExts, на большой папке долго, и ход его виден в окне
  Dlg.btnOk.Caption := 'Найти';
  Dlg.Show;
  Dlg.Update;
  FifFillExts;
  if FFifListAborted then
    Exit;
  if FFifFileMode then
    FifStatus('Ищутся файлы по маскам: отмеченные расширения и поле масок ' +
              '(QColorDialog*.inc). Поле Find не нужно')
  else if cmbFind.Text = '' then
    FifStatus('Образец поиска - в поле Find главного окна')
  else
    FifStatus('Образец: ' + cmbFind.Text);
end;

// Список расширений с галками.
//   Файлы проекта: расширения файлов проекта (FifProjectFiles) и число
//     файлов; снятые галки - [FindInFiles] ProjExtsOff.
//   Диск: [FindInFiles] DiskExts, отмеченные - DiskExtsOn. Без них (editor.ini
//     прежней версии) - из прежних масок Masks: *.ext - в список, отмечены.
procedure TForm1.FifFillExts;
var
  Dlg: TDlgFifDisk;
  Ini: TIniFile;
  Files, Exts: TStringList;
  KnownExts, CheckedExts, OffExts, OldMasks, MaskItem, Ext, Note: string;
  FileIdx, ExtIdx, Found, SemiAt: Integer;
  ListOk: Boolean;
begin
  Dlg := TDlgFifDisk(FFifDlg);
  KnownExts := '';
  CheckedExts := '';
  OffExts := '';
  OldMasks := '';
  Ini := nil;
  if FileExists(SettingsFileName) then
    Ini := TIniFile.Create(SettingsFileName);
  try
    if Ini <> nil then
    begin
      KnownExts := Ini.ReadString('FindInFiles', 'DiskExts', '');
      CheckedExts := Ini.ReadString('FindInFiles', 'DiskExtsOn', '');
      OffExts := Ini.ReadString('FindInFiles', 'ProjExtsOff', '');
      OldMasks := Ini.ReadString('FindInFiles', 'Masks', '');
    end;
  finally
    Ini.Free;
  end;

  Dlg.lstExt.Items.BeginUpdate;
  try
    Dlg.lstExt.Items.Clear;
    if FFifProject then
    begin
      Files := TStringList.Create;
      Exts := TStringList.Create;
      try
        Exts.Sorted := True;
        Exts.CaseSensitive := False;
        FFifAbort := False;
        FFifProjCacheValid := False;
        // Ход обхода - в окне (FifProgress), кнопка - Стоп
        FFifListing := True;
        FFifLastTick := 0;
        Dlg.btnOk.Caption := 'Стоп';
        try
          ListOk := FifProjectFiles(Files, Note);
        finally
          FFifListing := False;
          Dlg.btnOk.Caption := 'Найти';
        end;
        if not ListOk then
        begin
          Dlg.btnOk.Enabled := False;
          FifStatus('Проект не открыт');
          Exit;
        end;
        Dlg.btnOk.Enabled := True;
        if FFifAbort then
        begin
          FFifListAborted := True;
          FFifAbort := False;
          FifStatus(Format('Список файлов проекта прерван (собрано: %d). ' +
                           'Поиск не начат; Найти - собрать заново',
                           [Files.Count]));
        end
        else
        begin
          FFifProjCache := Files.Text;
          FFifProjCacheNote := Note;
          FFifProjCacheValid := True;
        end;
        for FileIdx := 0 to Files.Count - 1 do
        begin
          Ext := LowerCase(ExtractFileExt(Files[FileIdx]));
          if Ext = '' then
            Continue;
          if Exts.Find(Ext, Found) then
            Exts.Objects[Found] := TObject(Integer(Exts.Objects[Found]) + 1)
          else
            Exts.AddObject(Ext, TObject(1));
        end;
        for ExtIdx := 0 to Exts.Count - 1 do
        begin
          Found := Dlg.lstExt.Items.Add(Exts[ExtIdx] + '  (' +
                                        IntToStr(Integer(Exts.Objects[ExtIdx])) + ')');
          Dlg.lstExt.Checked[Found] := not FifExtInList(Exts[ExtIdx], OffExts);
        end;
      finally
        Exts.Free;
        Files.Free;
      end;
    end
    else
    begin
      Dlg.btnOk.Enabled := True;
      if KnownExts = '' then
      begin
        // Прежние маски: *.ext - в список расширений, отмеченными
        if OldMasks = '' then
          OldMasks := '*.pas;*.dpr;*.inc;*.dfm';
        while OldMasks <> '' do
        begin
          SemiAt := Pos(';', OldMasks);
          if SemiAt = 0 then
            SemiAt := Length(OldMasks) + 1;
          MaskItem := Trim(Copy(OldMasks, 1, SemiAt - 1));
          Delete(OldMasks, 1, SemiAt);
          if (Copy(MaskItem, 1, 2) = '*.') and (Pos('*', Copy(MaskItem, 3, MaxInt)) = 0) and
             (Pos('?', MaskItem) = 0) then
          begin
            FifExtAdd(KnownExts, Copy(MaskItem, 2, MaxInt));
            FifExtAdd(CheckedExts, Copy(MaskItem, 2, MaxInt));
          end;
        end;
        // Частые расширения - в список без галок
        FifExtAdd(KnownExts, '.bas');
        FifExtAdd(KnownExts, '.bi');
        FifExtAdd(KnownExts, '.rqb');
        FifExtAdd(KnownExts, '.ino');
        FifExtAdd(KnownExts, '.ini');
        FifExtAdd(KnownExts, '.txt');
      end;
      while KnownExts <> '' do
      begin
        SemiAt := Pos(';', KnownExts);
        if SemiAt = 0 then
          SemiAt := Length(KnownExts) + 1;
        Ext := LowerCase(Trim(Copy(KnownExts, 1, SemiAt - 1)));
        Delete(KnownExts, 1, SemiAt);
        if Ext = '' then
          Continue;
        Found := Dlg.lstExt.Items.Add(Ext);
        Dlg.lstExt.Checked[Found] := FifExtInList(Ext, CheckedExts);
      end;
    end;
  finally
    Dlg.lstExt.Items.EndUpdate;
  end;
end;

// Отмеченные расширения - через ";"
function TForm1.FifCheckedExts: string;
var
  Dlg: TDlgFifDisk;
  ItemIdx: Integer;
begin
  Result := '';
  Dlg := TDlgFifDisk(FFifDlg);
  for ItemIdx := 0 to Dlg.lstExt.Items.Count - 1 do
    if Dlg.lstExt.Checked[ItemIdx] then
      FifExtAdd(Result, FifExtOfItem(Dlg.lstExt.Items[ItemIdx]));
end;

// Маски вида *.ext и .ext из поля других масок - в список расширений,
// отмеченными; в поле остаётся остальное. Результат - сколько масок ушло
// в список
function TForm1.FifMasksToExts: Integer;
var
  Dlg: TDlgFifDisk;
  Rest, MaskItem, Kept, Ext: string;
  SemiAt, ItemIdx, Found: Integer;
begin
  Result := 0;
  Dlg := TDlgFifDisk(FFifDlg);
  Rest := Dlg.edMask.Text;
  Kept := '';
  while Rest <> '' do
  begin
    SemiAt := Pos(';', Rest);
    if SemiAt = 0 then
      SemiAt := Length(Rest) + 1;
    MaskItem := Trim(Copy(Rest, 1, SemiAt - 1));
    Delete(Rest, 1, SemiAt);
    if MaskItem = '' then
      Continue;
    // .ext - то же, что *.ext
    if (MaskItem[1] = '.') and (Length(MaskItem) > 1) then
      MaskItem := '*' + MaskItem;
    if (Copy(MaskItem, 1, 2) = '*.') and (Pos('*', Copy(MaskItem, 3, MaxInt)) = 0) and
       (Pos('?', MaskItem) = 0) and (Length(MaskItem) > 2) then
    begin
      Inc(Result);
      Ext := LowerCase(Copy(MaskItem, 2, MaxInt));
      Found := -1;
      for ItemIdx := 0 to Dlg.lstExt.Items.Count - 1 do
        if FifExtOfItem(Dlg.lstExt.Items[ItemIdx]) = Ext then
          Found := ItemIdx;
      if Found < 0 then
        Found := Dlg.lstExt.Items.Add(Ext);
      Dlg.lstExt.Checked[Found] := True;
      Continue;
    end;
    if Kept <> '' then
      Kept := Kept + ';';
    Kept := Kept + MaskItem;
  end;
  Dlg.edMask.Text := Kept;
end;

// Настройки окна - в editor.ini, [FindInFiles]
procedure TForm1.FifSaveSettings;
var
  Dlg: TDlgFifDisk;
  Ini: TBufIniFile;
  AllExts, CheckedExts, OffExts, OldOff, Ext: string;
  ItemIdx, SemiAt: Integer;
  Present: string;
begin
  Dlg := TDlgFifDisk(FFifDlg);
  Ini := TBufIniFile.Create(SettingsFileName);
  try
    if FFifProject then
    begin
      // Снятые галки этого проекта плюс прежние снятые расширения, которых
      // в этом проекте нет
      OldOff := Ini.ReadString('FindInFiles', 'ProjExtsOff', '');
      Present := '';
      OffExts := '';
      for ItemIdx := 0 to Dlg.lstExt.Items.Count - 1 do
      begin
        Ext := FifExtOfItem(Dlg.lstExt.Items[ItemIdx]);
        FifExtAdd(Present, Ext);
        if not Dlg.lstExt.Checked[ItemIdx] then
          FifExtAdd(OffExts, Ext);
      end;
      while OldOff <> '' do
      begin
        SemiAt := Pos(';', OldOff);
        if SemiAt = 0 then
          SemiAt := Length(OldOff) + 1;
        Ext := Trim(Copy(OldOff, 1, SemiAt - 1));
        Delete(OldOff, 1, SemiAt);
        if not FifExtInList(Ext, Present) then
          FifExtAdd(OffExts, Ext);
      end;
      Ini.WriteString('FindInFiles', 'ProjExtsOff', OffExts);
    end
    else
    begin
      AllExts := '';
      CheckedExts := '';
      for ItemIdx := 0 to Dlg.lstExt.Items.Count - 1 do
      begin
        Ext := FifExtOfItem(Dlg.lstExt.Items[ItemIdx]);
        FifExtAdd(AllExts, Ext);
        if Dlg.lstExt.Checked[ItemIdx] then
          FifExtAdd(CheckedExts, Ext);
      end;
      Ini.WriteString('FindInFiles', 'Dir', Trim(Dlg.edDir.Text));
      Ini.WriteString('FindInFiles', 'DiskExts', AllExts);
      Ini.WriteString('FindInFiles', 'DiskExtsOn', CheckedExts);
      Ini.WriteString('FindInFiles', 'OtherMasks', Trim(Dlg.edMask.Text));
      Ini.WriteBool('FindInFiles', 'SubDirs', Dlg.chkSub.Checked);
    end;
  finally
    Ini.Free;
  end;
end;

// Строка хода поиска в окне Find In Files
procedure TForm1.FifStatus(const AText: string);
begin
  // Тот же текст - не перерисовывать
  if (FFifDlg <> nil) and (TDlgFifDisk(FFifDlg).lblStatus.Caption <> AText) then
    TDlgFifDisk(FFifDlg).lblStatus.Caption := AText;
end;

// "<приставка><путь>": путь сокращается (MinimizeName) так, чтобы строка
// влезла в ширину строки хода
function TForm1.FifPathLine(const APrefix, APath: string): string;
var
  Dlg: TDlgFifDisk;
  Room: Integer;
begin
  Result := APrefix + APath;
  if FFifDlg = nil then
    Exit;
  Dlg := TDlgFifDisk(FFifDlg);
  Dlg.Canvas.Font.Assign(Dlg.lblStatus.Font);
  Room := Dlg.lblStatus.Width - Dlg.Canvas.TextWidth(APrefix) - 8;
  if Room < 40 then
    Room := 40;
  Result := APrefix + MinimizeName(APath, Dlg.Canvas, Room);
end;

// Новые строки Match list - в грид. Выделение и прокрутку не трогаем:
// пользователь может уже работать со списком
procedure TForm1.FifGridGrow;
var
  OldRows: Integer;
begin
  if (FMatchGrid = nil) or FFifListTaken or (Length(FMatchRows) = 0) then
    Exit;
  if FMatchGrid.RowCount = Length(FMatchRows) + 1 then
    Exit;
  OldRows := FMatchGrid.RowCount;
  FMatchGrid.RowCount := Length(FMatchRows) + 1;
  // Новые строки: вхождения свёрнутых групп - нулевой высоты. Пустой список
  // показывал одну строку-заглушку (RowCount = 2) - с первой строки
  ApplyMatchRowHeights(OldRows - 2);
  FMatchGrid.Invalidate;
end;

// Шаг поиска: раз в 100 мс - строка хода, новые строки Match list и
// очередь сообщений (окно, Match list и редактор работают). False -
// поиск остановлен
function TForm1.FifStep(const AText: string): Boolean;
begin
  Result := not FFifAbort;
  if not Result then
    Exit;
  if GetTickCount - FFifLastTick < 100 then
    Exit;
  FFifLastTick := GetTickCount;
  // Строка хода - реже, чем шаг (раз в 300 мс): иначе путь файла мелькал
  if GetTickCount - FFifStatusTick >= 300 then
  begin
    FFifStatusTick := GetTickCount;
    FifStatus(AText);
  end;
  FifGridGrow;
  if FFifRunning and (FMatchForm <> nil) and not FFifListTaken then
    FMatchForm.Caption := Format('Match list - %d в %d файлах (поиск...)',
                                 [FFifTotal, FFifFiles]);
  Application.ProcessMessages;
  Result := not FFifAbort;
end;

