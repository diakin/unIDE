procedure TForm1.WMNotify(var Message: TWMNotify);
begin
  inherited;
  if (Message.NMHdr^.hwndFrom = RichEdit1.Handle) and (Message.NMHdr^.code = EN_SELCHANGE) then
  begin
    UpdateStatusBarInfo;
    UpdatePairMatch;

    // Подсветку номера строки обновляем ЗДЕСЬ. Щелчок мышью по тексту не
    // вызывает перерисовку редактора - каретка просто переезжает, WM_PAINT
    // не приходит, и панель номеров сама бы не обновилась.
    UpdateLineNumbers;
  end;
end;

