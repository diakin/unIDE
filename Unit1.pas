// Скрипты сменились: светлые значки палитры - заново, тёмные строит
// UiApplyGlyph после сброса прежних
procedure TForm1.PaletteIconsApplied(Sender: TObject);
var
  Btns: TList;
  BtnIdx: Integer;
  LightBack: TColor;
begin
  if FDsgPalette = nil then
    Exit;
  if UiDarkBack then
    LightBack := clBtnFace
  else
