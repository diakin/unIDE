// Меню из ресурсного скрипта .rc (первый ресурс MENU или MENUEX) - в
// мастер, как единственный набор: там же снимаются ненужные пункты
procedure TForm1.DsgMenuFromResource;
var
  Dlg: TOpenDialog;
  Lines: TStringList;
  Tpl: TMenuTemplate;
  Templates: TList;
begin
  if (FDesigner = nil) or (FDesigner.Form = nil) then
    Exit;
  Dlg := TOpenDialog.Create(nil);
  Lines := TStringList.Create;
  try
    Dlg.Title := 'Меню из ресурсного скрипта';
    Dlg.Filter := 'Ресурсный скрипт (*.rc)|*.rc|Все файлы (*.*)|*.*';
    if not Dlg.Execute then
      Exit;
    Lines.LoadFromFile(Dlg.FileName);
    Tpl := MenuTemplateFromRc(Lines.Text, ExtractFileName(Dlg.FileName));
  finally
    Lines.Free;
    Dlg.Free;
  end;
  if Tpl = nil then
  begin
    ShowMessage('В файле нет ресурса MENU / MENUEX.');
    Exit;
  end;

  Templates := TList.Create;
  try
    Templates.Add(Tpl);
    DsgMenuWizardShow(Templates, '', False);
  finally
    MenuFreeTemplates(Templates);
    Templates.Free;
  end;
end;

// Select Menu: меню формы (TMainMenu, TPopupMenu) списком - выбранное
// выделяется в конструкторе и в дереве объектов
procedure TForm1.DsgMenuSelect;
var
  AllNames, MenuNames: TStringList;
  DfmText, Cls: string;
  Index, Picked: Integer;
begin
  if (FDesigner = nil) or (FDesigner.Form = nil) then
    Exit;
  DfmText := DsgGetText;
  AllNames := TStringList.Create;
  MenuNames := TStringList.Create;
  try
    if DfmObjectNames(DfmText, FDesigner.RootName, AllNames) then
      for Index := 0 to AllNames.Count - 1 do
      begin
        Cls := DfmObjectClass(DfmText, AllNames[Index]);
        if MenuIsMainClass(Cls) or MenuIsPopupClass(Cls) then
          MenuNames.Add(AllNames[Index]);
      end;
    if MenuNames.Count = 0 then
    begin
      ShowMessage('В форме нет меню.');
      Exit;
    end;
    Picked := MenuPickDialog('Select Menu', 'Меню формы:', MenuNames);
    if Picked < 0 then
      Exit;
    FDesigner.SelectByName(MenuNames[Picked]);
    DsgSelect(MenuNames[Picked]);
  finally
    MenuNames.Free;
    AllNames.Free;
  end;
end;

function TForm1.DsgMenuItemName: string;
