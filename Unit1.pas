// Autosave options - Editor files: изменённые файлы с именем - на диск без
// вопроса. Файлы без имени и те, что сохранить не вышло, остаются
// изменёнными: о них спросят как обычно.
procedure TForm1.AutoSaveEditorFiles;
var
  Cur, WinIdx: Integer;
  FileLabel: string;

  function Named(AWinIdx: Integer): Boolean;
  begin
    Result := (FWindows[AWinIdx].FileName <> '') and
              not IsUntitledName(FWindows[AWinIdx].FileName);
  end;

begin
  if not FEnv.AutosaveEditor then
    Exit;
  Cur := FWindowsIndex;
  if (Cur >= 0) and (Cur < WindowsItemCount) and FWindows[Cur].Used and
     RichEdit1.Modified and Named(Cur) then
  begin
    FileLabel := ExtractFileName(FWindows[Cur].FileName);
    if SaveCurrentFile then
      LogComp('Autosave: ' + FileLabel)
    else
      LogComp('Autosave: не удалось сохранить ' + FileLabel);
  end;
  for WinIdx := 0 to WindowsItemCount - 1 do
  begin
    if (WinIdx = Cur) or not FWindows[WinIdx].Used or
       not FWindows[WinIdx].Modified or not Named(WinIdx) then
      Continue;
    FileLabel := ExtractFileName(FWindows[WinIdx].FileName);
    ActivateWindow(WinIdx);    // сохраняем через обычный путь
    if SaveCurrentFile then
      LogComp('Autosave: ' + FileLabel)
    else
      LogComp('Autosave: не удалось сохранить ' + FileLabel);
  end;
  if (FWindowsIndex <> Cur) and (Cur >= 0) and (Cur < WindowsItemCount) and
     FWindows[Cur].Used then
    ActivateWindow(Cur);
end;

// ---------------------------------------------------------------------------
//  Окно хода сборки (DlgCompProgress): что собирается, этапы, текущая
//  строка вывода, полоса, число ошибок и предупреждений, кнопка Стоп.
//
//  Сборка RapidQ через FreeBASIC (CompileRapidQFb) открывает окно всегда и
//  ведёт этапы сама - FCompDlgOwned. Остальные сборки (Delphi, FreeBASIC,
//  RapidQ rc.exe) - по Preferences - Show compiler progress: окно на время
//  работы компилятора, один этап (CompProgressStart ... CompProgressDone).
//  Удачная сборка - окно закрывается само, если стоит флажок "Закрывать
//  окно после удачной сборки" (editor.ini, [Preferences]
//  CompProgressAutoClose); с ошибками - остаётся до "Закрыть".
// ---------------------------------------------------------------------------

// Файл проекта в параметрах (.dpr, .bas ...): последнее слово, не ключ
function CompProjectOf(const AParams: string): string;
var
  CharIdx: Integer;
  ParamWord: string;
  InQuote: Boolean;

  procedure TakeWord;
  begin
    if (ParamWord <> '') and (ParamWord[1] <> '-') and (ParamWord[1] <> '/') then
      Result := ParamWord;
    ParamWord := '';
  end;

begin
  Result := '';
  ParamWord := '';
  InQuote := False;
  for CharIdx := 1 to Length(AParams) do
    if AParams[CharIdx] = '"' then
      InQuote := not InQuote
    else if (AParams[CharIdx] = ' ') and not InQuote then
      TakeWord
    else
      ParamWord := ParamWord + AParams[CharIdx];
  TakeWord;
  Result := ExtractFileName(Result);
end;

// Окно создаётся один раз; здесь - новая сборка в нём и показ
function TForm1.CompDlgOpen(const AProgram: string): TDlgCompProgress;
var
  Ini: TIniFile;
begin
  if FCompDlg = nil then
  begin
    FCompDlg := TDlgCompProgress.Create(Self);
    if FileExists(SettingsFileName) then
    begin
      Ini := TIniFile.Create(SettingsFileName);
      try
        FCompDlg.chkAutoClose.Checked :=
          Ini.ReadBool('Preferences', 'CompProgressAutoClose', True);
      finally
        Ini.Free;
      end;
    end;
    FCompDlg.chkAutoClose.OnClick := CompDlgAutoCloseClick;
    UiApplyForm(FCompDlg);
  end;
  Result := FCompDlg;
  FCompDlgStage := -1;
  FCompProgHints := 0;
  FCompProgWarns := 0;
  FCompProgErrors := 0;
  Result.BeginBuild(AProgram);
  if not Result.Visible then
  begin
    Result.Show;
    // Над главным окном, как окна Arduino
    SetWindowLong(Result.Handle, GWL_HWNDPARENT, Integer(Handle));
  end;
  Result.Update;
end;

procedure TForm1.CompDlgAutoCloseClick(Sender: TObject);
var
  Ini: TIniFile;
begin
  if FCompDlg = nil then
    Exit;
  Ini := TIniFile.Create(SettingsFileName);
  try
    Ini.WriteBool('Preferences', 'CompProgressAutoClose',
                  FCompDlg.chkAutoClose.Checked);
  finally
    Ini.Free;
  end;
end;

// В окне хода нажали Стоп
function TForm1.CompAbortWanted: Boolean;
begin
  Result := (FCompDlg <> nil) and FCompDlg.Building and
            FCompDlg.AbortRequested;
end;

procedure TForm1.CompProgressStart(const AExe, AParams: string);
begin
  if FCompDlgOwned then
    Exit;   // этапы ведёт сама сборка
  FCompDlgStage := -1;
  if not FEnv.ShowCompileProgress then
    Exit;
  CompDlgOpen(CompProjectOf(AParams) + '  (' + ExtractFileName(AExe) + ')');
  FCompDlg.Caption := 'Ход сборки';
  FCompDlgStage := FCompDlg.AddStage('Компиляция: ' + ExtractFileName(AExe), 1);
  FCompDlg.StartStage(FCompDlgStage, 0, '');
end;

// Строка вывода компилятора: счётчики ошибок и предупреждений; у fbc со
// сборкой RapidQ - ещё и шаг fbc (RqFbFbcLine). Саму строку окно уже
// показало (LogComp).
procedure TForm1.CompProgressLine(const ALine: string);
var
  LowLine, ErrFile: string;
  ErrLine: Integer;
  IsError: Boolean;

  // Метка сообщения компилятора: "Unit1.pas(12) Error: ..." или в начале
  function HasTag(const ATag: string): Boolean;
  begin
    Result := (Pos(' ' + ATag, LowLine) > 0) or
              (Copy(LowLine, 1, Length(ATag)) = ATag);
  end;

begin
  if (FCompDlg = nil) or not FCompDlg.Building then
    Exit;
  LowLine := LowerCase(ALine);
  // fbc: "файл(строка) error N: ..." и "файл(строка) warning N(M): ..."
  if FbParseErrorLine(ALine, ErrFile, ErrLine, IsError) then
  begin
    if IsError then
      Inc(FCompProgErrors)
    else
      Inc(FCompProgWarns);
  end
  else if HasTag('error:') or HasTag('fatal:') or FbIsErrorLine(ALine) then
    Inc(FCompProgErrors)
  else if HasTag('warning:') then
    Inc(FCompProgWarns)
  else if HasTag('hint:') then
    Inc(FCompProgHints);
  FCompDlg.SetCounts(FCompProgErrors, FCompProgWarns, FCompProgHints);
  if FCompDlgOwned then
    RqFbFbcLine(ALine);
end;

procedure TForm1.CompProgressDone(AExitCode: Integer);
var
  Built: Boolean;
begin
  if FCompDlgOwned or (FCompDlg = nil) or not FCompDlg.Building or
     (FCompDlgStage < 0) then
    Exit;
  Built := (AExitCode = 0) and (FCompProgErrors = 0);
  FCompDlg.EndStage(FCompDlgStage, Built, '');
  if Built then
    FCompDlg.FinishBuild(True, 'Готово')
  else if FCompProgErrors > 0 then
    FCompDlg.FinishBuild(False, 'Есть ошибки - Error log')
  else
    FCompDlg.FinishBuild(False, 'Код завершения ' + IntToStr(AExitCode));
  FCompDlgStage := -1;
end;

// ---------------------------------------------------------------------------
//  Editor Options: Margin and gutter, Code Insight (FEdIns, EnvOptions).
//
//  Margin and gutter: линия правого поля (EdDrawRightMargin - поверх кадра
//  редактора), полоса слева (Panel1: номера строк PaintBox1 и метки
//  MarksBox), её ширина.
//
//  Code Insight:
//  - Code completion: список имён (CodeInsight, TCiListPopup) по
//    Ctrl+Space всегда, после точки - с задержкой, если включено, и на
//    третьей букве имени (вне строк и комментариев), если включено.
//    После точки - члены типа выражения перед ней (с предками; классы
//    VCL - из исходников Delphi, Compilers - Delphi - DelphiPath\Source);
//    тип не нашёлся - списка нет. Без точки - имена файла, члены класса
//    подпрограммы и имена модулей uses. В не-Pascal файлах - слова файла.
//    Стрелки, PgUp/PgDn - выбор, Enter и Tab - вставить, Esc - закрыть;
//    набор букв сужает список.
//  - Code parameters: параметры подпрограммы подсказкой у каретки - по
//    Ctrl+Shift+Space всегда, после "(" - с задержкой, если включено.
//  - Tooltip expression evaluation: значение под мышью на остановке
//    отладчика (DbgHintTimerTick).
//  - Tooltip symbol insight: объявление имени под мышью (Pascal).
//  Клавиши редактора приходят в CiBeforeMessage (до контрола) и
//  CiAfterMessage (после) из NewRichEditProc.
// ---------------------------------------------------------------------------

const
  // Видимость членов в CiTypeMembers
  CiAccAll = 0;
  CiAccOutside = 1;
  CiAccOwn = 2;

type
  // Имена модуля из uses (interface-часть) и по чему они прочитаны
  TCiUnitEntry = class
  public
    Key: string;
    Syms: TCiSymbols;
    constructor Create;
    destructor Destroy; override;
  end;

constructor TCiUnitEntry.Create;
begin
  inherited Create;
  Syms := TCiSymbols.Create;
end;

destructor TCiUnitEntry.Destroy;
begin
  Syms.Free;
  inherited Destroy;
end;

// Цвет тёмный (по яркости)
function CiIsDark(AColor: TColor): Boolean;
var
  RgbValue: Integer;
begin
  RgbValue := ColorToRGB(AColor);
  Result := (GetRValue(RgbValue) * 30 + GetGValue(RgbValue) * 59 +
             GetBValue(RgbValue) * 11) div 100 < 128;
end;

procedure TForm1.EdInsightLoad;
begin
  EdLoadInsight(SettingsFileName, FEdIns, CiIsDark(RichEdit1.Color));
end;

// Настройки поменяли (окно настроек): записать и применить
procedure TForm1.EdInsightChanged;
begin
  EdSaveInsight(SettingsFileName, FEdIns);
  EdApplyGutter;
  if FDbgHintTimer <> nil then
    FDbgHintTimer.Interval := CiTickMs;
  SymHintSetup;
  if not FEdIns.CodeCompletion and not FEdIns.CodeParams and
     (FCiTimer <> nil) then
    FCiTimer.Enabled := False;
  if RichEdit1.HandleAllocated then
    RichEdit1.Invalidate;
end;

// Шаг таймеров подсказок под мышью: показ - когда мышь простояла тик
function TForm1.CiTickMs: Integer;
begin
  Result := FEdIns.DelayMs div 2;
  if Result < 100 then
    Result := 100;
end;

procedure TForm1.EdApplyGutter;
begin
  if (Panel1 = nil) or (PaintBox1 = nil) then
    Exit;
  PaintBox1.Visible := FEdIns.ShowLineNumbers;
  Panel1.Visible := FEdIns.ShowGutter;
  UpdateGutterWidth;
end;

// Линия правого поля - в кадр редактора (PaintDoubleBuffered)
procedure TForm1.EdDrawRightMargin(ADC: HDC; AWidth, AHeight: Integer);
var
  OldFont: HFONT;
  TextSize: TSize;
  LineX: Integer;
  LinePen, OldPen: HPEN;
  PenColor: TColor;
begin
  if not FEdIns.ShowRightMargin or (FEdIns.RightMargin <= 0) then
    Exit;
  OldFont := SelectObject(ADC, RichEdit1.Font.Handle);
  try
    // По десяти знакам - точнее, чем по одному
    if not GetTextExtentPoint32(ADC, 'MMMMMMMMMM', 10, TextSize) then
      Exit;
  finally
    SelectObject(ADC, OldFont);
  end;
  LineX := FEdIns.RightMargin * TextSize.cx div 10 - FScrollX;
  if (LineX < 0) or (LineX >= AWidth) then
    Exit;
  if CiIsDark(RichEdit1.Color) then
    PenColor := $00505050
  else
    PenColor := $00C0C0C0;
  LinePen := CreatePen(PS_SOLID, 1, ColorToRGB(PenColor));
  OldPen := SelectObject(ADC, LinePen);
  try
    MoveToEx(ADC, LineX, 0, nil);
    LineTo(ADC, LineX, AHeight);
  finally
    SelectObject(ADC, OldPen);
    DeleteObject(LinePen);
  end;
end;

function TForm1.CiIsPascalFile: Boolean;
var
  Ext: string;
begin
  Ext := LowerCase(ExtractFileExt(FCurrentFileName));
  Result := (Ext = '.pas') or (Ext = '.pp') or (Ext = '.dpr') or
            (Ext = '.lpr') or (Ext = '.inc') or (Ext = '.dpk');
end;

function TForm1.CiCaretPos: Integer;
var
  Sel: TCharRange;
begin
  Result := 0;
  if not RichEdit1.HandleAllocated then
    Exit;
  SendMessageA(RichEdit1.Handle, EM_EXGETSEL, 0, Integer(@Sel));
  Result := Sel.cpMax;
end;

// Строка с позицией ACharPos: текст, номер, начало (позиция первого знака)
function TForm1.CiLineOf(ACharPos: Integer; var ALineIdx,
                         ALineStart: Integer): string;
begin
  Result := '';
  ALineIdx := SendMessageA(RichEdit1.Handle, EM_EXLINEFROMCHAR, 0, ACharPos);
  ALineStart := SendMessageA(RichEdit1.Handle, EM_LINEINDEX, ALineIdx, 0);
  if (ALineIdx >= 0) and (ALineIdx < RichEdit1.Lines.Count) then
    Result := RichEdit1.Lines[ALineIdx];
end;

// Начало имени перед кареткой: AStart - его позиция, результат - набранное
function TForm1.CiPrefixAt(ACaret: Integer; var AStart: Integer): string;
var
  LineText: string;
  LineIdx, LineStart, Col: Integer;
begin
  LineText := CiLineOf(ACaret, LineIdx, LineStart);
  Col := ACaret - LineStart;    // знаков до каретки
  if Col > Length(LineText) then
    Col := Length(LineText);
  AStart := Col;
  while (AStart > 0) and
        (LineText[AStart] in ['A'..'Z', 'a'..'z', '0'..'9', '_']) do
    Dec(AStart);
  Result := Copy(LineText, AStart + 1, Col - AStart);
  AStart := LineStart + AStart;
end;

// Каретка на экране: X, низ строки; ALineTop - верх строки
function TForm1.CiCaretScreen(var ALineTop: Integer): TPoint;
var
  RowHeight: Integer;
begin
  RowHeight := LineHeight;
  if RowHeight <= 0 then
    RowHeight := 16;
  Result := RichEdit1.ClientToScreen(FOwnCaretPt);
  ALineTop := Result.Y;
  Result.Y := Result.Y + RowHeight;
end;

// Имя под позицией ACharPos (без цепочки через точки); ALineIdx - строка
function TForm1.CiWordAt(ACharPos: Integer; var ALineIdx: Integer): string;
var
  LineText: string;
  LineStart, StartCol, EndCol: Integer;
begin
  Result := '';
  ALineIdx := -1;
  if (ACharPos < 0) or not RichEdit1.HandleAllocated then
    Exit;
  LineText := CiLineOf(ACharPos, ALineIdx, LineStart);
  StartCol := ACharPos - LineStart + 1;
  if (StartCol < 1) or (StartCol > Length(LineText)) or
     not (LineText[StartCol] in ['A'..'Z', 'a'..'z', '0'..'9', '_']) then
    Exit;
  EndCol := StartCol;
  while (StartCol > 1) and
        (LineText[StartCol - 1] in ['A'..'Z', 'a'..'z', '0'..'9', '_']) do
    Dec(StartCol);
  while (EndCol < Length(LineText)) and
        (LineText[EndCol + 1] in ['A'..'Z', 'a'..'z', '0'..'9', '_']) do
    Inc(EndCol);
  if LineText[StartCol] in ['0'..'9'] then
    Exit;
  if (StartCol > 1) and (LineText[StartCol - 1] in ['#', '$']) then
    Exit;
  Result := Copy(LineText, StartCol, EndCol - StartCol + 1);
end;

// Строки текущего файла как есть и очищенные (заглавными, как у панели
// объявления) - заново, только если текст изменился
procedure TForm1.CiEnsureDeclCache;
var
  Text, Key: string;
  LineIdx, CleanState: Integer;
begin
  Text := GetEditorText;
  Key := FCurrentFileName + '|' + IntToStr(Length(Text)) + '|' +
         IntToHex(Crc32Of(Text), 8);
  if (FCiDeclSrc <> nil) and (Key = FCiDeclKey) then
    Exit;
  if FCiDeclSrc = nil then
  begin
    FCiDeclSrc := TStringList.Create;
    FCiDeclCl := TStringList.Create;
  end;
  FCiDeclSrc.Text := Text;
  FCiDeclCl.Clear;
  CleanState := 0;
  for LineIdx := 0 to FCiDeclSrc.Count - 1 do
    FCiDeclCl.Add(UpperCase(DeclCleanLine(FCiDeclSrc[LineIdx], CleanState)));
  FCiDeclKey := Key;
end;

// Объявление имени AWordU (заглавными), встреченного в строке ALine:
// текст объявления (заголовок подпрограммы - до ")"), AFile - файл, если
// объявление в другом модуле, ADeclLine - его строка. '' - не нашлось.
function TForm1.CiDeclText(const AWordU: string; ALine: Integer;
                           var AFile: string; var ADeclLine: Integer): string;
var
  DeclLine, DeclCol, ExtraIdx: Integer;
  Text: string;
begin
  Result := '';
  AFile := '';
  ADeclLine := -1;
  if (AWordU = '') or DeclIsKeyword(AWordU) then
    Exit;
  CiEnsureDeclCache;
  if (ALine < 0) or (ALine >= FCiDeclCl.Count) then
    Exit;
  if FindPascalDecl(FCiDeclCl, ALine, AWordU, DeclLine, DeclCol) then
  begin
    Result := Trim(StringReplace(FCiDeclSrc[DeclLine], #9, ' ',
                                 [rfReplaceAll]));
    // Заголовок на нескольких строках - до закрывающей скобки
    ExtraIdx := DeclLine + 1;
    while (Pos('(', Result) > 0) and (Pos(')', Result) = 0) and
          (ExtraIdx < FCiDeclSrc.Count) and (ExtraIdx <= DeclLine + 8) do
    begin
      Result := Result + ' ' + Trim(StringReplace(FCiDeclSrc[ExtraIdx], #9,
      ' ', [rfReplaceAll]));
                                                  Inc(ExtraIdx);
    end;
    ADeclLine := DeclLine;
  end
  else if FindDeclInUnits(FCiDeclSrc, FCiDeclCl, AWordU, AFile, DeclLine,
                          DeclCol, Text) then
  begin
    Result := Text;
    ADeclLine := DeclLine;
  end;
end;

procedure TForm1.CiFreeAll;
var
  CacheIdx: Integer;
begin
  if FCiUnitCache <> nil then
    for CacheIdx := 0 to FCiUnitCache.Count - 1 do
      FCiUnitCache.Objects[CacheIdx].Free;
  FreeAndNil(FCiUnitCache);
  FreeAndNil(FCiSyms);
  FreeAndNil(FCiFileSyms);
  FreeAndNil(FCiDeclSrc);
  FreeAndNil(FCiDeclCl);
  FreeAndNil(FCiUsesList);
end;

// Папка установки Delphi (Compilers - Delphi - DelphiPath) с \ на конце;
// '' - не задана
function TForm1.CiDelphiRoot: string;
var
  Ini: TIniFile;
begin
  Result := '';
  if not FileExists(SettingsFileName) then
    Exit;
  Ini := TIniFile.Create(SettingsFileName);
  try
    Result := StripIniComment(Ini.ReadString(CompilerSection('Delphi'),
    'DelphiPath', ''));
                                             if Result = '' then
                                             Result := StripIniComment(Ini.ReadString('Compiler.Delphi',
      'DelphiPath', ''));
                                                                                      if Result = '' then
                                                                                      Result := StripIniComment(Ini.ReadString('Compiler', 'DelphiPath', ''));
  finally
    Ini.Free;
  end;
  if Result <> '' then
    Result := IncludeTrailingPathDelimiter(Result);
end;

// Папки исходников VCL и RTL Delphi, которые есть на диске
procedure TForm1.CiDelphiSourceDirs(ADirs: TStrings);
const
  SubDirs: array[0..4] of string = (
  'Source\Vcl\', 'Source\Rtl\Common\', 'Source\Rtl\Sys\',
  'Source\Rtl\Win\', 'Source\Internet\');
    var
    Root: string;
    DirIdx: Integer;
begin
  ADirs.Clear;
  Root := CiDelphiRoot;
  if Root = '' then
    Exit;
  for DirIdx := Low(SubDirs) to High(SubDirs) do
    if DirectoryExists(Root + SubDirs[DirIdx]) then
      ADirs.Add(Root + SubDirs[DirIdx]);
end;

// Файл модуля AUnit: модуль проекта (рядом с файлом, из .dpr), иначе
// исходник Delphi; '' - не найден
function TForm1.CiUnitFileByName(const AUnit: string): string;
var
  DprUnits, Dirs: TStringList;
  Dpr: string;
  DirIdx: Integer;
begin
  DprUnits := TStringList.Create;
  Dirs := TStringList.Create;
  try
    Dpr := DelphiTargetDpr;
    if Dpr <> '' then
      ParseDprUnits(Dpr, DprUnits);
    Result := DeclUnitFile(AUnit, ExtractFilePath(FCurrentFileName), DprUnits,
                           ExtractFilePath(Dpr));
    if Result <> '' then
      Exit;
    CiDelphiSourceDirs(Dirs);
    for DirIdx := 0 to Dirs.Count - 1 do
      if FileExists(Dirs[DirIdx] + AUnit + '.pas') then
      begin
        Result := Dirs[DirIdx] + AUnit + '.pas';
        Exit;
      end;
  finally
    Dirs.Free;
    DprUnits.Free;
  end;
end;

// Имена interface-части модуля AFile - из кэша, разбор заново, только
// если файл (или его вкладка) изменился
function TForm1.CiUnitSyms(const AFile: string): TCiSymbols;
var
  WinIdx, CacheIdx: Integer;
  Key: string;
  Entry: TCiUnitEntry;
  UnitSrc: TStringList;
begin
  if FCiUnitCache = nil then
    FCiUnitCache := TStringList.Create;
  WinIdx := IndexOfWindowByFile(AFile);
  if WinIdx >= 0 then
    Key := 'w' + IntToHex(Crc32Of(FWindows[WinIdx].Text), 8)
  else
    Key := 'f' + IntToStr(FileAge(AFile));
  CacheIdx := FCiUnitCache.IndexOf(LowerCase(AFile));
  if CacheIdx >= 0 then
    Entry := TCiUnitEntry(FCiUnitCache.Objects[CacheIdx])
  else
  begin
    Entry := TCiUnitEntry.Create;
    FCiUnitCache.AddObject(LowerCase(AFile), Entry);
  end;
  if Entry.Key <> Key then
  begin
    Entry.Syms.Clear;
    UnitSrc := TStringList.Create;
    try
      try
        if WinIdx >= 0 then
          UnitSrc.Text := FWindows[WinIdx].Text
        else
          UnitSrc.LoadFromFile(AFile);
        CiScanPascal(UnitSrc, True, Entry.Syms);
      except
        Entry.Syms.Clear;   // файл занят или недоступен
      end;
    finally
      UnitSrc.Free;
    end;
    Entry.Key := Key;
  end;
  Result := Entry.Syms;
end;

// Файлы модулей из uses текущего файла - в порядке поиска компилятора
// (с конца списка)
procedure TForm1.CiUsesFiles(AFiles: TStrings);
var
  Units: TStringList;
  UnitIdx: Integer;
  FileName: string;
begin
  AFiles.Clear;
  CiEnsureDeclCache;
  // Тот же текст - тот же список (поиск файлов модулей не повторяется)
  if (FCiUsesList <> nil) and (FCiUsesKey = FCiDeclKey) then
  begin
    AFiles.Assign(FCiUsesList);
    Exit;
  end;
  Units := TStringList.Create;
  try
    DeclUsesUnits(FCiDeclSrc, FCiDeclCl, Units);
    for UnitIdx := Units.Count - 1 downto 0 do
    begin
      FileName := CiUnitFileByName(Units[UnitIdx]);
      if (FileName <> '') and (CompareText(FileName, FCurrentFileName) <> 0) then
        AFiles.Add(FileName);
    end;
    // System - всегда: TObject и прочее
    FileName := CiUnitFileByName('System');
    if FileName <> '' then
      AFiles.Add(FileName);
    if FCiUsesList = nil then
      FCiUsesList := TStringList.Create;
    FCiUsesList.Assign(AFiles);
    FCiUsesKey := FCiDeclKey;
  finally
    Units.Free;
  end;
end;

// Тип с именем ATypeName: в текущем файле, в модулях из uses, потом во
// всех исходниках Delphi. ASource - имена файла, где он объявлен (там и
// его члены).
function TForm1.CiFindType(const ATypeName: string; var ASym: TCiSymbol;
                           var ASource: TCiSymbols): Boolean;
var
  Files, Dirs: TStringList;
  FileIdx, DirIdx: Integer;
  Found: TSearchRec;

  function FindIn(ASyms: TCiSymbols): Boolean;
  var
    SymIdx: Integer;
  begin
    Result := False;
    if ASyms = nil then
      Exit;
    for SymIdx := 0 to ASyms.Count - 1 do
      if (ASyms[SymIdx].Kind = ckType) and (ASyms[SymIdx].Owner = '') and
         (CompareText(ASyms[SymIdx].Name, ATypeName) = 0) then
      begin
        ASym := ASyms[SymIdx];
        ASource := ASyms;
        Result := True;
        Exit;
      end;
  end;

begin
  Result := FindIn(FCiFileSyms);
  if Result then
    Exit;
  Files := TStringList.Create;
  Dirs := TStringList.Create;
  try
    CiUsesFiles(Files);
    for FileIdx := 0 to Files.Count - 1 do
      if FindIn(CiUnitSyms(Files[FileIdx])) then
      begin
        Result := True;
        Exit;
      end;
    // Предок из модуля, которого нет в uses этого файла (TWinControl у
    // TCustomEdit) - во всех исходниках Delphi; разобранные - в кэше
    CiDelphiSourceDirs(Dirs);
    for DirIdx := 0 to Dirs.Count - 1 do
      if FindFirst(Dirs[DirIdx] + '*.pas', faAnyFile and not faDirectory,
                   Found) = 0 then
      try
      repeat
        if FindIn(CiUnitSyms(Dirs[DirIdx] + Found.Name)) then
        begin
          Result := True;
          Exit;
        end;
      until FindNext(Found) <> 0;
      finally
        FindClose(Found);
      end;
  finally
    Dirs.Free;
    Files.Free;
  end;
end;

// Члены типа ATypeName и его предков - в AOut. Одноимённый член предка
// не повторяется; у переобъявленного без типа (property Text;) тип и
// описание берутся у предка. AAccess - какие члены видны, как у
// компилятора: CiAccAll - все (для поиска типа), CiAccOutside - снаружи
// класса: private и protected - только объявленные в этом же файле,
// CiAccOwn - из метода самого класса (Self): protected предков тоже.
procedure TForm1.CiTypeMembers(const ATypeName: string; AOut: TCiSymbols;
                               AAccess: Integer);
var
  TypeName, Parent: string;
  TypeSym: TCiSymbol;
  Source: TCiSymbols;
  Names: TStringList;
  Level, SymIdx, NameIdx: Integer;
  Member: TCiSymbol;
  Merged: TCiSymbols;
begin
  Names := TStringList.Create;
  Merged := TCiSymbols.Create;
  try
    Names.Sorted := True;
    Names.CaseSensitive := False;
    TypeName := ATypeName;
    for Level := 1 to 32 do
    begin
      if (TypeName = '') or not CiFindType(TypeName, TypeSym, Source) then
        Break;
      if not CiIsStructType(TypeSym.Detail) then
      begin
        // TFoo = TBar - члены TBar
        TypeName := CiAliasType(TypeSym.Detail);
        Continue;
      end;
      for SymIdx := 0 to Source.Count - 1 do
      begin
        Member := Source[SymIdx];
        if (CompareText(Member.Owner, TypeSym.Name) <> 0) or
           (Member.Kind = ckType) then
          Continue;
        NameIdx := Names.IndexOf(Member.Name);
        if NameIdx >= 0 then
        begin
          // Уже есть от потомка: без описания - дополнить описанием
          // предка, даже скрытого (published OnClick; - тип у protected
          // OnClick: TNotifyEvent в TControl)
          NameIdx := Integer(Names.Objects[NameIdx]);
          if (Merged[NameIdx].Detail = '') and (Member.Detail <> '') then
            Merged.SetDetail(NameIdx, Member.Detail);
          Continue;
        end;
        // Чужой модуль: private не видно никогда, protected - только
        // из потомка
        if (AAccess <> CiAccAll) and (Source <> FCiFileSyms) and
           ((Member.Visibility = cvPrivate) or
            ((Member.Visibility = cvProtected) and
             (AAccess = CiAccOutside))) then
          Continue;
        Names.AddObject(Member.Name, TObject(Merged.Count));
        Merged.Add(Member);
      end;
      Parent := CiParentType(TypeSym.Detail);
      if CompareText(Parent, TypeSym.Name) = 0 then
        Break;
      TypeName := Parent;
    end;
    AOut.AddAll(Merged);
  finally
    Merged.Free;
    Names.Free;
  end;
end;

// Тип члена AMember у типа ATypeName (с предками); '' - нет или не имя типа
function TForm1.CiMemberType(const ATypeName, AMember: string): string;
var
  Members: TCiSymbols;
  SymIdx: Integer;
begin
  Result := '';
  Members := TCiSymbols.Create;
  try
    CiTypeMembers(ATypeName, Members, CiAccAll);
    for SymIdx := 0 to Members.Count - 1 do
      if CompareText(Members[SymIdx].Name, AMember) = 0 then
      begin
        Result := CiTypeOfSymbol(Members[SymIdx]);
        Exit;
      end;
  finally
    Members.Free;
  end;
end;

// Тип имени AName в строке ALine текущего файла: Self, параметр и
// локальная переменная подпрограммы, член её класса, имя файла, имя
// модулей uses. Имя - тип сам (TForm1.) - он же.
function TForm1.CiNameType(const AName: string; ALine: Integer): string;
var
  SymIdx, RoutineIdx, FileIdx: Integer;
  Routine, Symbol, TypeSym: TCiSymbol;
  Files: TStringList;
  Source: TCiSymbols;
  UnitSyms: TCiSymbols;
begin
  Result := '';
  // Подпрограмма, в которой каретка: ближайшая выше
  RoutineIdx := -1;
  for SymIdx := 0 to FCiFileSyms.Count - 1 do
  begin
    Symbol := FCiFileSyms[SymIdx];
    if (Symbol.Kind in [ckProcedure, ckFunction]) and (Symbol.Line <= ALine) and
       ((RoutineIdx < 0) or (Symbol.Line > FCiFileSyms[RoutineIdx].Line)) then
      RoutineIdx := SymIdx;
  end;
  if RoutineIdx >= 0 then
    Routine := FCiFileSyms[RoutineIdx]
  else
  begin
    Routine.Name := '';
    Routine.Owner := '';
    Routine.Detail := '';
    Routine.Line := 0;
  end;

  if CompareText(AName, 'Self') = 0 then
  begin
    Result := Routine.Owner;
    Exit;
  end;
  if CompareText(AName, 'Result') = 0 then
  begin
    if RoutineIdx >= 0 then
      Result := CiTypeOfSymbol(Routine);
    Exit;
  end;
  // Параметр
  if RoutineIdx >= 0 then
  begin
    Result := CiParamType(Routine.Detail, AName);
    if Result <> '' then
      Exit;
  end;
  // Локальная переменная: между заголовком подпрограммы и кареткой
  if RoutineIdx >= 0 then
    for SymIdx := 0 to FCiFileSyms.Count - 1 do
    begin
      Symbol := FCiFileSyms[SymIdx];
      if (Symbol.Kind = ckVariable) and (Symbol.Owner = '') and
         (Symbol.Line >= Routine.Line) and (Symbol.Line <= ALine) and
         (CompareText(Symbol.Name, AName) = 0) then
      begin
        Result := CiTypeOfSymbol(Symbol);
        Exit;
      end;
    end;
  // Член класса подпрограммы (поле, свойство, метод)
  if Routine.Owner <> '' then
  begin
    Result := CiMemberType(Routine.Owner, AName);
    if Result <> '' then
      Exit;
  end;
  // Глобальное в файле и в модулях uses
  for SymIdx := 0 to FCiFileSyms.Count - 1 do
  begin
    Symbol := FCiFileSyms[SymIdx];
    if (Symbol.Owner = '') and (Symbol.Kind <> ckType) and
       (CompareText(Symbol.Name, AName) = 0) then
    begin
      Result := CiTypeOfSymbol(Symbol);
      if Result <> '' then
        Exit;
    end;
  end;
  Files := TStringList.Create;
  try
    CiUsesFiles(Files);
    for FileIdx := 0 to Files.Count - 1 do
    begin
      UnitSyms := CiUnitSyms(Files[FileIdx]);
      for SymIdx := 0 to UnitSyms.Count - 1 do
      begin
        Symbol := UnitSyms[SymIdx];
        if (Symbol.Owner = '') and (Symbol.Kind <> ckType) and
           (CompareText(Symbol.Name, AName) = 0) then
        begin
          Result := CiTypeOfSymbol(Symbol);
          if Result <> '' then
            Exit;
        end;
      end;
    end;
  finally
    Files.Free;
  end;
  // Имя типа: TForm1. - члены самого типа
  if CiFindType(AName, TypeSym, Source) then
    Result := TypeSym.Name;
end;

// Цепочка имён перед точкой в позиции ADotPos (позиция самой точки):
// FObjEdit. - FObjEdit; Form1.Edit1. - Form1, Edit1. False - перед точкой
// не имя или вызов со скобками.
function TForm1.CiChainBefore(ADotPos: Integer; AParts: TStrings;
                              var ALineIdx: Integer): Boolean;
var
  LineText: string;
  LineStart, Col, NameEnd: Integer;
begin
  Result := False;
  AParts.Clear;
  LineText := CiLineOf(ADotPos, ALineIdx, LineStart);
  Col := ADotPos - LineStart;    // знаков перед точкой
  repeat
    while (Col >= 1) and (LineText[Col] = ' ') do
      Dec(Col);
    NameEnd := Col;
    while (Col >= 1) and
          (LineText[Col] in ['A'..'Z', 'a'..'z', '0'..'9', '_']) do
      Dec(Col);
    if (NameEnd = Col) or (LineText[Col + 1] in ['0'..'9']) then
      Exit;
    AParts.Insert(0, Copy(LineText, Col + 1, NameEnd - Col));
    while (Col >= 1) and (LineText[Col] = ' ') do
      Dec(Col);
    if (Col >= 1) and (LineText[Col] = '.') then
      Dec(Col)
    else
      Break;
  until False;
  // Перед цепочкой - "^" или ")" : разыменование или вызов - не разбираем
  Result := not ((Col >= 1) and (LineText[Col] in [')', ']', '^']));
end;

// Члены типа выражения перед точкой ADotPos - в AOut. False - тип не
// найден.
function TForm1.CiMembersAtDot(ADotPos: Integer; AOut: TCiSymbols): Boolean;
var
  Parts: TStringList;
  LineIdx, PartIdx: Integer;
  TypeName: string;
begin
  Result := False;
  Parts := TStringList.Create;
  try
    if not CiChainBefore(ADotPos, Parts, LineIdx) or (Parts.Count = 0) then
      Exit;
    TypeName := CiNameType(Parts[0], LineIdx);
    for PartIdx := 1 to Parts.Count - 1 do
    begin
      if TypeName = '' then
        Break;
      TypeName := CiMemberType(TypeName, Parts[PartIdx]);
    end;
    if TypeName = '' then
      Exit;
    // Self. - изнутри класса (protected предков видно), остальное -
    // снаружи
    if (Parts.Count = 1) and (CompareText(Parts[0], 'Self') = 0) then
      CiTypeMembers(TypeName, AOut, CiAccOwn)
    else
      CiTypeMembers(TypeName, AOut, CiAccOutside);
    Result := AOut.Count > 0;
  finally
    Parts.Free;
  end;
end;

// События - как в списке Delphi: вместо типа (TNotifyEvent) его
// объявление, OnClick: procedure(Sender: TObject)
procedure TForm1.CiExpandEvents(ASyms: TCiSymbols);
var
  Expanded: TStringList;
  SymIdx, CacheIdx, ColonPos: Integer;
  TypeName, TypeText, Low: string;
  TypeSym: TCiSymbol;
  Source: TCiSymbols;
begin
  Expanded := TStringList.Create;
  try
    Expanded.Sorted := True;
    Expanded.CaseSensitive := False;
    for SymIdx := 0 to ASyms.Count - 1 do
    begin
      if ASyms[SymIdx].Kind <> ckProperty then
        Continue;
      TypeName := CiTypeOfSymbol(ASyms[SymIdx]);
      if TypeName = '' then
        Continue;
      CacheIdx := Expanded.IndexOfName(TypeName);
      if CacheIdx >= 0 then
        TypeText := Copy(Expanded[CacheIdx], Length(TypeName) + 2, MaxInt)
      else
      begin
        TypeText := '';
        if CiFindType(TypeName, TypeSym, Source) then
        begin
          TypeText := Trim(TypeSym.Detail);
          Low := LowerCase(TypeText);
          if (Copy(Low, 1, 9) = 'procedure') or (Copy(Low, 1, 8) = 'function') then
          begin
            if Copy(Low, Length(Low) - 9, 10) = ' of object' then
              SetLength(TypeText, Length(TypeText) - 10);
          end
          else
            TypeText := '';
        end;
        Expanded.Add(TypeName + '=' + TypeText);
      end;
      if TypeText = '' then
        Continue;
      // ": TNotifyEvent" - тип после последнего ':' на нулевой глубине;
      // у свойства-массива [Index: Integer] остаётся
      ColonPos := Length(ASyms[SymIdx].Detail);
      while (ColonPos > 0) and (ASyms[SymIdx].Detail[ColonPos] <> ':') do
        Dec(ColonPos);
      if ColonPos > 0 then
        ASyms.SetDetail(SymIdx, Copy(ASyms[SymIdx].Detail, 1, ColonPos) + ' ' +
                        TypeText);
    end;
  finally
    Expanded.Free;
  end;
end;

// Имена текущего файла - заново, только если текст изменился
procedure TForm1.CiEnsureFileSyms;
begin
  if FCiSyms = nil then
  begin
    FCiSyms := TCiSymbols.Create;
    FCiFileSyms := TCiSymbols.Create;
  end;
  CiEnsureDeclCache;
  if FCiFileKey <> FCiDeclKey then
  begin
    FCiFileSyms.Clear;
    if CiIsPascalFile then
      CiScanPascal(FCiDeclSrc, False, FCiFileSyms)
    else
      CiScanWords(FCiDeclSrc, FCiFileSyms);
    FCiFileKey := FCiDeclKey;
  end;
end;

// Список без точки - что видно в строке ALine: имена файла вне классов,
// члены класса подпрограммы (с предками), имена модулей uses вне классов
procedure TForm1.CiCollect(ALine: Integer);
var
  Files: TStringList;
  FileIdx, SymIdx, RoutineIdx: Integer;
  UnitSyms: TCiSymbols;
  Symbol: TCiSymbol;
begin
  CiEnsureFileSyms;
  FCiSyms.Clear;
  if not CiIsPascalFile then
  begin
    FCiSyms.AddAll(FCiFileSyms);
    Exit;
  end;
  RoutineIdx := -1;
  for SymIdx := 0 to FCiFileSyms.Count - 1 do
  begin
    Symbol := FCiFileSyms[SymIdx];
    if Symbol.Owner = '' then
      FCiSyms.Add(Symbol);
    if (Symbol.Kind in [ckProcedure, ckFunction]) and (Symbol.Line <= ALine) and
       ((RoutineIdx < 0) or (Symbol.Line > FCiFileSyms[RoutineIdx].Line)) then
      RoutineIdx := SymIdx;
  end;
  if (RoutineIdx >= 0) and (FCiFileSyms[RoutineIdx].Owner <> '') then
    CiTypeMembers(FCiFileSyms[RoutineIdx].Owner, FCiSyms, CiAccOwn);
  Files := TStringList.Create;
  try
    CiUsesFiles(Files);
    for FileIdx := 0 to Files.Count - 1 do
    begin
      UnitSyms := CiUnitSyms(Files[FileIdx]);
      for SymIdx := 0 to UnitSyms.Count - 1 do
        if UnitSyms[SymIdx].Owner = '' then
          FCiSyms.Add(UnitSyms[SymIdx]);
    end;
  finally
    Files.Free;
  end;
end;

procedure TForm1.CiShowCompletion(AAuto: Boolean);
var
  Prefix, LineText: string;
  ScreenPt: TPoint;
  LineTop, ColorIdx, LineIdx, LineStart: Integer;
  AfterDot: Boolean;
begin
  if not RichEdit1.HandleAllocated or RichEdit1.ReadOnly then
    Exit;
  CiHideParams;
  SymHintHide;
  Prefix := CiPrefixAt(CiCaretPos, FCiPrefixStart);
  // Не Pascal - слова файла: без начала имени список бессмыслен
  if not CiIsPascalFile and (Prefix = '') then
    Exit;
  LineText := CiLineOf(FCiPrefixStart, LineIdx, LineStart);
  AfterDot := CiIsPascalFile and (FCiPrefixStart > LineStart) and
              (FCiPrefixStart - LineStart <= Length(LineText)) and
              (LineText[FCiPrefixStart - LineStart] = '.');
  Screen.Cursor := crHourGlass;
  try
    CiEnsureFileSyms;
    if AfterDot then
    begin
      // После точки - только члены типа выражения перед ней. Тип не
      // нашёлся - списка нет: все имена подряд здесь только мешают
      FCiSyms.Clear;
      if not CiMembersAtDot(FCiPrefixStart - 1, FCiSyms) then
      begin
        if not AAuto then
          StatusBar1.Panels[0].Text := 'Code completion: тип выражения ' +
          'перед точкой не найден';
      Exit;
      end;
    end
    else
      CiCollect(LineIdx);
    FCiSyms.SortUnique;
    CiExpandEvents(FCiSyms);
  finally
    Screen.Cursor := crDefault;
  end;
  if FCiPopup = nil then
  begin
    FCiPopup := TCiListPopup.Create(Self);
    FCiPopup.OnAccept := CiAcceptClick;
  end;
  for ColorIdx := 0 to 8 do
    FCiPopup.KindColors[ColorIdx] := TColor(FEdIns.Colors[ColorIdx]);
  if FEdIns.Colors[CiColBackground] = CiWindowColor then
  begin
    FCiPopup.BackColor := RichEdit1.Color;
    FCiPopup.TextColor := BaseFontColor;
  end
  else
  begin
    FCiPopup.BackColor := TColor(FEdIns.Colors[CiColBackground]);
    if CiIsDark(FCiPopup.BackColor) then
      FCiPopup.TextColor := clWhite
    else
      FCiPopup.TextColor := clBlack;
  end;
  FCiPopup.SetSymbols(FCiSyms);
  if FCiPopup.ApplyFilter(Prefix) = 0 then
  begin
    CiHideCompletion;
    Exit;
  end;
  ScreenPt := CiCaretScreen(LineTop);
  FCiPopup.ShowAt(ScreenPt.X, ScreenPt.Y, LineTop);
end;

function TForm1.CiCompletionShown: Boolean;
begin
  Result := (FCiPopup <> nil) and FCiPopup.IsShown;
end;

procedure TForm1.CiHideCompletion;
begin
  if FCiPopup <> nil then
    FCiPopup.HidePopup;
end;

// Выбранное имя - вместо набранного начала
procedure TForm1.CiAccept;
var
  Name: string;
  Caret: Integer;
begin
  if not CiCompletionShown then
    Exit;
  Name := FCiPopup.SelectedName;
  CiHideCompletion;
  if Name = '' then
    Exit;
  Caret := CiCaretPos;
  if Caret < FCiPrefixStart then
    Exit;
  RichEdit1.SelStart := FCiPrefixStart;
  RichEdit1.SelLength := Caret - FCiPrefixStart;
  RichEdit1.SelText := Name;
end;

procedure TForm1.CiAcceptClick(Sender: TObject);
begin
  CiAccept;
  if RichEdit1.CanFocus then
    RichEdit1.SetFocus;
end;

// Набрали или стёрли знак при открытом списке: список по новому началу
procedure TForm1.CiRefilter;
var
  Caret, PrefixStart: Integer;
  Prefix: string;
begin
  if not CiCompletionShown then
    Exit;
  Caret := CiCaretPos;
  Prefix := CiPrefixAt(Caret, PrefixStart);
  if (Caret < FCiPrefixStart) or (PrefixStart <> FCiPrefixStart) then
  begin
    CiHideCompletion;
    Exit;
  end;
  if FCiPopup.ApplyFilter(Prefix) = 0 then
    CiHideCompletion;
end;

// Открытая скобка перед кареткой в той же строке (позиция) и имя перед
// ней; -1 - нет
function TForm1.CiOpenParen(var AName: string; var ALineIdx: Integer): Integer;
var
  LineText: string;
  LineStart, Col, Depth, NameEnd, NameStart: Integer;
begin
  Result := -1;
  AName := '';
  LineText := CiLineOf(CiCaretPos, ALineIdx, LineStart);
  Col := CiCaretPos - LineStart;
  if Col > Length(LineText) then
    Col := Length(LineText);
  Depth := 0;
  while Col >= 1 do
  begin
    if LineText[Col] = ')' then
      Inc(Depth)
    else if LineText[Col] = '(' then
    begin
      if Depth = 0 then
        Break;
      Dec(Depth);
    end;
    Dec(Col);
  end;
  if Col < 1 then
    Exit;
  NameEnd := Col - 1;
  while (NameEnd >= 1) and (LineText[NameEnd] = ' ') do
    Dec(NameEnd);
  NameStart := NameEnd;
  while (NameStart >= 1) and
        (LineText[NameStart] in ['A'..'Z', 'a'..'z', '0'..'9', '_']) do
    Dec(NameStart);
  AName := Copy(LineText, NameStart + 1, NameEnd - NameStart);
  if AName = '' then
    Exit;
  Result := LineStart + Col - 1;
end;

// Параметры подпрограммы, в скобках которой стоит каретка
procedure TForm1.CiShowParams;
var
  Name, DeclText, DeclFile, HintText: string;
  LineIdx, OpenPos, DeclLine, ParenFrom, ParenTo, Depth, CharIdx: Integer;
  ScreenPt: TPoint;
  LineTop: Integer;
  HintRect: TRect;
begin
  CiHideParams;
  if not RichEdit1.HandleAllocated or not CiIsPascalFile then
    Exit;
  OpenPos := CiOpenParen(Name, LineIdx);
  if OpenPos < 0 then
    Exit;
  DeclText := CiDeclText(UpperCase(Name), LineIdx, DeclFile, DeclLine);
  if DeclText = '' then
    Exit;
  ParenFrom := Pos('(', DeclText);
  if ParenFrom = 0 then
    HintText := 'No parameters expected'
  else
  begin
    Depth := 0;
    ParenTo := Length(DeclText);
    for CharIdx := ParenFrom to Length(DeclText) do
    begin
      if DeclText[CharIdx] = '(' then
        Inc(Depth)
      else if DeclText[CharIdx] = ')' then
      begin
        Dec(Depth);
        if Depth = 0 then
        begin
          ParenTo := CharIdx;
          Break;
        end;
      end;
    end;
    HintText := Copy(DeclText, ParenFrom + 1, ParenTo - ParenFrom - 1);
  end;
  if FCiParamWnd = nil then
    FCiParamWnd := HintWindowClass.Create(Self);
  ScreenPt := CiCaretScreen(LineTop);
  HintRect := FCiParamWnd.CalcHintRect(700, HintText, nil);
  OffsetRect(HintRect, ScreenPt.X, ScreenPt.Y + 2);
  FCiParamWnd.ActivateHint(HintRect, HintText);
  FCiParamShown := True;
  FCiParamOpen := OpenPos;
  FCiParamLine := LineIdx;
end;

procedure TForm1.CiHideParams;
begin
  if FCiParamShown and (FCiParamWnd <> nil) then
    FCiParamWnd.ReleaseHandle;
  FCiParamShown := False;
end;

// Каретка ушла из скобок или на другую строку - подсказка параметров уходит
procedure TForm1.CiCheckParams;
var
  Name: string;
  LineIdx, OpenPos: Integer;
begin
  if not FCiParamShown then
    Exit;
  OpenPos := CiOpenParen(Name, LineIdx);
  if (OpenPos <> FCiParamOpen) or (LineIdx <> FCiParamLine) then
    CiHideParams;
end;

procedure TForm1.CiHideAll;
begin
  CiHideCompletion;
  CiHideParams;
  SymHintHide;
  if FCiTimer <> nil then
    FCiTimer.Enabled := False;
end;

// Сообщение редактору - до контрола. True - обработано здесь, контролу не
// отдавать.
function TForm1.CiBeforeMessage(var Message: TMessage): Boolean;
var
  CtrlDown, ShiftDown: Boolean;
begin
  Result := False;
  case Message.Msg of
    WM_CHAR:
      if FCiSwallowChar <> #0 then
    begin
      Result := Char(Message.WParam) = FCiSwallowChar;
      FCiSwallowChar := #0;
    end;
    WM_KEYDOWN:
    begin
      SymHintHide;
      CtrlDown := GetKeyState(VK_CONTROL) < 0;
      ShiftDown := GetKeyState(VK_SHIFT) < 0;
      if (Message.WParam = VK_SPACE) and CtrlDown then
      begin
        if ShiftDown then
          CiShowParams
        else
          CiShowCompletion(False);
        FCiSwallowChar := ' ';
        Result := True;
      end
      else if CiCompletionShown then
      case Message.WParam of
        VK_UP:
        begin
          FCiPopup.MoveSel(-1);
          Result := True;
        end;
        VK_DOWN:
        begin
          FCiPopup.MoveSel(1);
          Result := True;
        end;
        VK_PRIOR:
        begin
          FCiPopup.MoveSel(-11);
          Result := True;
        end;
        VK_NEXT:
        begin
          FCiPopup.MoveSel(11);
          Result := True;
        end;
        VK_RETURN, VK_TAB:
        begin
          CiAccept;
          if Message.WParam = VK_RETURN then
            FCiSwallowChar := #13
          else
            FCiSwallowChar := #9;
          Result := True;
        end;
        VK_ESCAPE:
        begin
          CiHideCompletion;
          FCiSwallowChar := #27;
          Result := True;
        end;
      end
      else if FCiParamShown and (Message.WParam = VK_ESCAPE) then
      begin
        CiHideParams;
        FCiSwallowChar := #27;
        Result := True;
      end;
    end;
    WM_MOUSEWHEEL:
      if CiCompletionShown then
    begin
      if SmallInt(HiWord(Message.WParam)) > 0 then
        FCiPopup.MoveSel(-3)
      else
        FCiPopup.MoveSel(3);
      Result := True;
    end;
  end;
  if Result then
    Message.Result := 0;
end;

// Сообщение редактору - после контрола: текст и каретка уже новые
procedure TForm1.CiAfterMessage(const Message: TMessage);
const
  // Список по первым буквам: столько знаков имени, и пауза перед показом -
  // пока набор идёт без остановки, список не открывается на каждой букве
  CiAutoPrefixLen = 3;
  CiAutoDelayMs = 120;
var
  TypedChar: Char;
  Prefix: string;
  PrefixStart: Integer;
  AutoList: Boolean;
begin
  case Message.Msg of
    WM_CHAR:
    begin
      TypedChar := Char(Message.WParam);
      if CiCompletionShown then
      begin
        if TypedChar in ['A'..'Z', 'a'..'z', '0'..'9', '_', #8] then
          CiRefilter
        else
          CiHideCompletion;
      end;
      if ((TypedChar = '.') and FEdIns.CodeCompletion) or
         ((TypedChar = '(') and FEdIns.CodeParams) then
        if CiIsPascalFile then
        begin
          if FCiTimer = nil then
          begin
            FCiTimer := TTimer.Create(Self);
            FCiTimer.OnTimer := CiTimerTick;
          end;
          FCiTimer.Enabled := False;
          FCiTimer.Interval := FEdIns.DelayMs;
          if TypedChar = '.' then
            FCiTimerMode := 1
          else
            FCiTimerMode := 2;
          FCiTriggerPos := CiCaretPos;
          FCiTimer.Enabled := True;
        end;
      // Третья буква имени - список имён, во всех файлах. Ровно третья:
      // закрытый по Esc список при наборе дальше не открывается снова.
      // В строке и в комментарии - нет.
      AutoList := False;
      if FEdIns.CodeCompletion and not CiCompletionShown and
         (TypedChar in ['A'..'Z', 'a'..'z', '0'..'9', '_']) then
      begin
        Prefix := CiPrefixAt(CiCaretPos, PrefixStart);
        AutoList := (Length(Prefix) = CiAutoPrefixLen) and
                    (Prefix[1] in ['A'..'Z', 'a'..'z', '_']);
        if AutoList and not FMapStale then
          AutoList := not InRanges(StringRanges, PrefixStart) and
                      not InRanges(CommentRanges, PrefixStart);
      end;
      if AutoList then
      begin
        if FCiTimer = nil then
        begin
          FCiTimer := TTimer.Create(Self);
          FCiTimer.OnTimer := CiTimerTick;
        end;
        FCiTimer.Enabled := False;
        FCiTimer.Interval := CiAutoDelayMs;
        FCiTimerMode := 1;
        FCiTriggerPos := CiCaretPos;
        FCiTimer.Enabled := True;
      end;
      CiCheckParams;
    end;
    WM_KEYDOWN:
    begin
      if CiCompletionShown then
        CiRefilter;
      CiCheckParams;
    end;
    WM_LBUTTONDOWN, WM_KILLFOCUS, WM_VSCROLL, WM_HSCROLL:
      CiHideAll;
  end;
end;

// Задержка после "." или "(" прошла: каретка там же - список или параметры
procedure TForm1.CiTimerTick(Sender: TObject);
begin
  FCiTimer.Enabled := False;
  if not RichEdit1.Focused or (CiCaretPos <> FCiTriggerPos) then
    Exit;
  if FCiTimerMode = 1 then
    CiShowCompletion(True)
  else
    CiShowParams;
end;

// ---------------------------------------------------------------------------
//  Tooltip symbol insight: объявление имени под мышью
// ---------------------------------------------------------------------------

procedure TForm1.SymHintSetup;
begin
  if FEdIns.TooltipSymbol then
  begin
    if FSymHintTimer = nil then
    begin
      FSymHintTimer := TTimer.Create(Self);
      FSymHintTimer.OnTimer := SymHintTimerTick;
    end;
    FSymHintTimer.Interval := CiTickMs;
    FSymHintTimer.Enabled := True;
  end
  else
  begin
    if FSymHintTimer <> nil then
      FSymHintTimer.Enabled := False;
    SymHintHide;
  end;
end;

procedure TForm1.SymHintHide;
begin
  FSymHintWord := '';
  if (FSymHintWnd <> nil) and FSymHintWnd.HandleAllocated and
     IsWindowVisible(FSymHintWnd.Handle) then
    FSymHintWnd.ReleaseHandle;
end;

procedure TForm1.SymHintTimerTick(Sender: TObject);
var
  CursorPt, ClientPt: TPoint;
  CharPos, LineIdx, DeclLine: Integer;
  WordText, DeclText, DeclFile, HintText: string;
  HintRect: TRect;
begin
  // На остановке отладчика под мышью - значение (DbgHintTimerTick)
  if ((FDbgSession <> nil) and not FDbgSession.Finished and
      FDbgSession.Paused) or (FRqDbgOn and FRqDbgPaused) or
     CiCompletionShown or FCiParamShown then
  begin
    SymHintHide;
    Exit;
  end;
  if not Application.Active or not RichEdit1.HandleAllocated or
     not GetCursorPos(CursorPt) or
     (WindowFromPoint(CursorPt) <> RichEdit1.Handle) or
     (GetKeyState(VK_LBUTTON) < 0) or (GetKeyState(VK_RBUTTON) < 0) then
  begin
    SymHintHide;
    FSymHintPt := Point(-1, -1);
    Exit;
  end;
  ClientPt := RichEdit1.ScreenToClient(CursorPt);
  CharPos := DbgCharAtClient(ClientPt);
  WordText := CiWordAt(CharPos, LineIdx);
  if WordText = '' then
  begin
    SymHintHide;
    FSymHintPt := CursorPt;
    Exit;
  end;
  // То же имя уже разобрано (показано или объявления нет)
  if CompareText(WordText, FSymHintWord) = 0 then
    Exit;
  // Ждём, пока мышь постоит на месте один тик
  if (CursorPt.X <> FSymHintPt.X) or (CursorPt.Y <> FSymHintPt.Y) then
  begin
    SymHintHide;
    FSymHintPt := CursorPt;
    Exit;
  end;
  SymHintHide;
  FSymHintWord := WordText;
  if not CiIsPascalFile then
    Exit;
  DeclText := CiDeclText(UpperCase(WordText), LineIdx, DeclFile, DeclLine);
  if DeclText = '' then
    Exit;
  if DeclFile <> '' then
    HintText := DeclText + #13#10 + ExtractFileName(DeclFile) + ' (' +
                IntToStr(DeclLine + 1) + ')'
  else
    HintText := DeclText + #13#10 + ExtractFileName(FCurrentFileName) + ' (' +
                IntToStr(DeclLine + 1) + ')';
  if FSymHintWnd = nil then
    FSymHintWnd := HintWindowClass.Create(Self);
  HintRect := FSymHintWnd.CalcHintRect(700, HintText, nil);
  OffsetRect(HintRect, CursorPt.X + 12, CursorPt.Y + 18);
  FSymHintWnd.ActivateHint(HintRect, HintText);
  FSymHintWord := WordText;
end;

procedure TForm1.DbgWatchRefresh;
var
  ExprIdx: Integer;
  State, ValueText, TypeText, Where: string;
  Item: TListItem;
  Names: TStringList;

  procedure SetSub(AItem: TListItem; ASubIdx: Integer; const AText: string);
  begin
    while AItem.SubItems.Count <= ASubIdx do
      AItem.SubItems.Add('');
    if AItem.SubItems[ASubIdx] <> AText then
      AItem.SubItems[ASubIdx] := AText;
  end;

begin
  if (FWatchWnd = nil) or (FWatchList = nil) then
    Exit;
  // Отладчик RapidQ - свои значения (файл состояния)
  if (FDbgSession = nil) and FRqDbgOn then
  begin
    RqDbgWatchRefresh;
    Exit;
  end;
  // Состояние вместо значений
  State := '';
  Where := '';
  if FDbgSession = nil then
    State := '<программа не запущена>'
  else if FDbgSession.Finished then
    State := '<программа завершилась>'
  else if not FDbgSession.Paused then
    State := '<программа выполняется>'
  else if FDbgSyms = nil then
    State := '<нет отладочной информации: ' + FDbgSymsError + '>'
  else
  begin
    Names := TStringList.Create;
    try
      Where := FDbgSyms.ProcLocals(FDbgSession.ImageBase,
                                   FDbgSession.StopEip, Names);
    finally
      Names.Free;
    end;
    if Where = '' then
      Where := 'Остановка вне процедур с отладочной информацией'
    else
      Where := 'Остановка в ' + Where;
  end;
  if Where = '' then
    Where := State;
  if FWatchWnd.lblWhere.Caption <> ' ' + Where then
    FWatchWnd.lblWhere.Caption := ' ' + Where;

  FWatchWnd.lvWatch.Items.BeginUpdate;
  try
    while FWatchWnd.lvWatch.Items.Count > FWatchList.Count do
      FWatchWnd.lvWatch.Items.Delete(FWatchWnd.lvWatch.Items.Count - 1);
    while FWatchWnd.lvWatch.Items.Count < FWatchList.Count do
      FWatchWnd.lvWatch.Items.Add;
    for ExprIdx := 0 to FWatchList.Count - 1 do
    begin
      Item := FWatchWnd.lvWatch.Items[ExprIdx];
      if Item.Caption <> FWatchList[ExprIdx] then
        Item.Caption := FWatchList[ExprIdx];
      TypeText := '';
      if State <> '' then
        ValueText := State
      else
      begin
        // Имя не нашлось - разбор поиска в Compilation log, один раз на
        // каждый разный разбор
        FDbgSyms.WantNote := True;
        try
          ValueText := FDbgSyms.Evaluate(FWatchList[ExprIdx],
                                         FDbgSession.ImageBase,
                                         FDbgSession.StopEip,
                                         FDbgSession.StopRegs,
                                         FDbgSession.ReadMemory, TypeText);
        finally
          FDbgSyms.WantNote := False;
        end;
        if (FDbgSyms.LastNote <> '') and
           (Pos(#1 + FDbgSyms.LastNote + #1, FWatchNotes) = 0) then
        begin
          if Length(FWatchNotes) > 20000 then
            FWatchNotes := '';
          FWatchNotes := FWatchNotes + #1 + FDbgSyms.LastNote + #1;
          LogComp('Watch: ' + FDbgSyms.LastNote);
        end;
      end;
      SetSub(Item, 0, ValueText);
      SetSub(Item, 1, WatchCondGet(FWatchList[ExprIdx]));
      SetSub(Item, 2, TypeText);
    end;
  finally
    FWatchWnd.lvWatch.Items.EndUpdate;
  end;
  WatchArrUpdate;
end;

function TForm1.DbgWatchSelected: Integer;
begin
  Result := -1;
  if (FWatchWnd <> nil) and (FWatchWnd.lvWatch.Selected <> nil) then
    Result := FWatchWnd.lvWatch.Selected.Index;
  if Result >= FWatchList.Count then
    Result := -1;
end;

procedure TForm1.WatchAddClick(Sender: TObject);
var
  ExprText: string;
begin
  ExprText := '';
  if InputQuery('Watch', 'Выражение (имя или Имя.Поле):', ExprText) and
     (Trim(ExprText) <> '') then
    DbgAddWatch(ExprText);
end;

procedure TForm1.WatchEditClick(Sender: TObject);
var
  ExprIdx: Integer;
  ExprText, OldCond: string;
begin
  ExprIdx := DbgWatchSelected;
  if ExprIdx < 0 then
  begin
    WatchAddClick(Sender);
    Exit;
  end;
  ExprText := FWatchList[ExprIdx];
  if not InputQuery('Watch', 'Выражение (имя или Имя.Поле):', ExprText) then
    Exit;
  // Условие строки остаётся у неё и при новом выражении
  OldCond := WatchCondGet(FWatchList[ExprIdx]);
  WatchCondSet(FWatchList[ExprIdx], '');
  if Trim(ExprText) = '' then
    FWatchList.Delete(ExprIdx)
  else
  begin
    FWatchList[ExprIdx] := Trim(ExprText);
    WatchCondSet(FWatchList[ExprIdx], OldCond);
  end;
  DbgWatchRefresh;
end;

procedure TForm1.WatchDeleteClick(Sender: TObject);
var
  ExprIdx: Integer;
begin
  ExprIdx := DbgWatchSelected;
  if ExprIdx < 0 then
    Exit;
  WatchCondSet(FWatchList[ExprIdx], '');
  FWatchList.Delete(ExprIdx);
  DbgWatchRefresh;
  if FWatchWnd.lvWatch.Items.Count > 0 then
  begin
    if ExprIdx >= FWatchWnd.lvWatch.Items.Count then
      ExprIdx := FWatchWnd.lvWatch.Items.Count - 1;
    FWatchWnd.lvWatch.Selected := FWatchWnd.lvWatch.Items[ExprIdx];
  end;
end;

procedure TForm1.WatchDeleteAllClick(Sender: TObject);
begin
  FWatchList.Clear;
  FWatchCondExprs.Clear;
  FWatchCondTexts.Clear;
  DbgWatchRefresh;
end;

// Условие строки Watch, '' - нет
function TForm1.WatchCondGet(const AExpr: string): string;
var
  CondIdx: Integer;
begin
  Result := '';
  if FWatchCondExprs = nil then
    Exit;
  for CondIdx := 0 to FWatchCondExprs.Count - 1 do
    if CompareText(FWatchCondExprs[CondIdx], Trim(AExpr)) = 0 then
    begin
      Result := FWatchCondTexts[CondIdx];
      Exit;
    end;
end;

// Условие строки Watch; пустое - убрать
procedure TForm1.WatchCondSet(const AExpr, ACond: string);
var
  CondIdx: Integer;
begin
  for CondIdx := 0 to FWatchCondExprs.Count - 1 do
    if CompareText(FWatchCondExprs[CondIdx], Trim(AExpr)) = 0 then
    begin
      if Trim(ACond) = '' then
      begin
        FWatchCondExprs.Delete(CondIdx);
        FWatchCondTexts.Delete(CondIdx);
      end
    else
      FWatchCondTexts[CondIdx] := Trim(ACond);
      Exit;
    end;
  if Trim(ACond) = '' then
    Exit;
  FWatchCondExprs.Add(Trim(AExpr));
  FWatchCondTexts.Add(Trim(ACond));
end;

// Условие строки Watch: точка останова отладчика RapidQ, где выражение
// вычисляется, стоит, только если оно выполнено. Вписывается в отладочную
// копию при сборке.
procedure TForm1.WatchCondClick(Sender: TObject);
var
  ExprIdx, InstrIdx: Integer;
  ExprText, CondText: string;
begin
  ExprIdx := DbgWatchSelected;
  if ExprIdx < 0 then
    Exit;
  ExprText := FWatchList[ExprIdx];
  CondText := WatchCondGet(ExprText);
  if not InputQuery('Watch: условие', 'Условие для ' + ExprText +
  ' (=10, <5, <> 0; пусто - без условия):', CondText) then
                    Exit;
                    CondText := Trim(CondText);
                    if (CondText <> '') and not RqDbgWatchCondValid(CondText) then
  begin
    ShowMessage('Условие начинается со сравнения: =, <>, <, >, <=, >= ' +
    '(например  =10  или  <> "abc"), без ":" и комментария.');
                Exit;
  end;
  WatchCondSet(ExprText, CondText);
  if CondText = '' then
    LogComp('Watch: условие для ' + ExprText + ' снято')
  else
    LogComp('Watch: условие ' + ExprText + ' ' + CondText + ' - точки ' +
    'останова RapidQ, где выражение вычисляется, стоят, только ' +
    'если оно выполнено');
    // Идёт отладка: условие из копии или после пересборки
            if FRqDbgOn and (FRqDbgInstr <> nil) and (CondText <> '') then
    begin
      InstrIdx := FRqDbgInstr.WatchIndex(ExprText);
      if (InstrIdx < 0) or (FRqDbgInstr.WatchCondition(InstrIdx) <> CondText) then
        LogComp('  условие не вписано в эту сборку - действует после ' +
        'пересборки (Ctrl+F2, затем F9)');
    end;
  DbgWatchRefresh;
end;

// Двойной щелчок: по столбцу «Условие» - условие, иначе - выражение
procedure TForm1.WatchDblClick(Sender: TObject);
var
  ClickPt: TPoint;
  ColLeft, CondCol: Integer;
begin
  GetCursorPos(ClickPt);
  ClickPt := FWatchWnd.lvWatch.ScreenToClient(ClickPt);
  CondCol := 2;   // Выражение, Значение, Условие, Тип
  ColLeft := -GetScrollPos(FWatchWnd.lvWatch.Handle, SB_HORZ);
  if FWatchWnd.lvWatch.Columns.Count > CondCol then
  begin
    ColLeft := ColLeft + FWatchWnd.lvWatch.Columns[0].Width +
               FWatchWnd.lvWatch.Columns[1].Width;
    if (ClickPt.X >= ColLeft) and
       (ClickPt.X < ColLeft + FWatchWnd.lvWatch.Columns[CondCol].Width) and
       (DbgWatchSelected >= 0) then
    begin
      WatchCondClick(Sender);
      Exit;
    end;
  end;
  WatchEditClick(Sender);
end;

// Параметры и локальные переменные процедуры, где стоит программа, - все
// в список
procedure TForm1.WatchLocalsClick(Sender: TObject);
var
  Names: TStringList;
  NameIdx: Integer;
  VarText: string;
begin
  // RapidQ: параметры и локальные из файла состояния
  if (FDbgSession = nil) and FRqDbgOn then
  begin
    if not FRqDbgPaused or (FRqDbgVars = nil) then
    begin
      ShowMessage('Watch: программа не стоит на остановке.');
      Exit;
    end;
    for NameIdx := 0 to FRqDbgVars.Count - 1 do
    begin
      VarText := FRqDbgVars[NameIdx];
      if Copy(VarText, 1, 1) = 'g' then
        Continue;
      VarText := Copy(VarText, 3, MaxInt);
      VarText := Copy(VarText, 1, Pos(#9, VarText) - 1);
      if (VarText <> '') and (FWatchList.IndexOf(VarText) < 0) then
        FWatchList.Add(VarText);
    end;
    DbgWatchRefresh;
    Exit;
  end;
  if (FDbgSession = nil) or not FDbgSession.Paused or (FDbgSyms = nil) then
  begin
    ShowMessage('Watch: программа не стоит на остановке или нет ' +
    'отладочной информации.');
                Exit;
  end;
  Names := TStringList.Create;
  try
    FDbgSyms.ProcLocals(FDbgSession.ImageBase, FDbgSession.StopEip, Names);
    for NameIdx := 0 to Names.Count - 1 do
      if FWatchList.IndexOf(Names[NameIdx]) < 0 then
        FWatchList.Add(Names[NameIdx]);
  finally
    Names.Free;
  end;
  DbgWatchRefresh;
end;

procedure TForm1.WatchKeyDown(Sender: TObject; var Key: Word;
                              Shift: TShiftState);
begin
  case Key of
    VK_INSERT:
    begin
      WatchAddClick(Sender);
      Key := 0;
    end;
    VK_DELETE:
    begin
      WatchDeleteClick(Sender);
      Key := 0;
    end;
    VK_RETURN:
    begin
      WatchEditClick(Sender);
      Key := 0;
    end;
  end;
end;

// ---------------------------------------------------------------------------
//  Массив в окне Watch
//
//  Выбранное выражение - статический массив: справа панель. Вверху тип и
//  границы, поля индексов (по одному на измерение) и значение ячейки с
//  этими индексами. Ниже таблица: для одномерного - индекс и значение, для
//  двумерного - строки по первому индексу, столбцы по второму. Для трёх
//  измерений и больше таблицы нет - только поля и ячейка.
//
//  Значения в таблице читаются из памяти программы при отрисовке: видимые
//  ячейки, а не весь массив. Щелчок по ячейке - её индексы в поля; правка
//  поля - переход таблицы к ячейке.
// ---------------------------------------------------------------------------

// Пусто - программа стоит и отладочная информация есть; иначе состояние
function TForm1.WatchStateText: string;
begin
  Result := '';
  if (FDbgSession = nil) and FRqDbgOn then
    Result := '<массивы RapidQ пока не показываются>'
  else if FDbgSession = nil then
    Result := '<программа не запущена>'
  else if FDbgSession.Finished then
    Result := '<программа завершилась>'
  else if not FDbgSession.Paused then
    Result := '<программа выполняется>'
  else if FDbgSyms = nil then
    Result := '<нет отладочной информации>';
end;

procedure TForm1.WatchArrBuild;
begin
  FWatchArrPanel := TPanel.Create(FWatchWnd);
  FWatchArrPanel.Parent := FWatchWnd;
  FWatchArrPanel.BevelOuter := bvNone;
  FWatchArrPanel.Caption := '';
  FWatchArrPanel.Width := 380;
  FWatchArrPanel.Align := alRight;
  FWatchArrPanel.Visible := False;

  FWatchArrSplit := TSplitter.Create(FWatchWnd);
  FWatchArrSplit.Parent := FWatchWnd;
  FWatchArrSplit.Align := alRight;
  FWatchArrSplit.Width := 4;
  FWatchArrSplit.MinSize := 120;
  FWatchArrSplit.Visible := False;

  FWatchArrTop := TPanel.Create(FWatchWnd);
  FWatchArrTop.Parent := FWatchArrPanel;
  FWatchArrTop.BevelOuter := bvNone;
  FWatchArrTop.Caption := '';
  FWatchArrTop.Height := 74;
  FWatchArrTop.Align := alTop;

  FWatchArrType := TLabel.Create(FWatchWnd);
  FWatchArrType.Parent := FWatchArrTop;
  FWatchArrType.Left := 6;
  FWatchArrType.Top := 4;
  FWatchArrType.ShowAccelChar := False;

  FWatchArrCell := TLabel.Create(FWatchWnd);
  FWatchArrCell.Parent := FWatchArrTop;
  FWatchArrCell.Left := 6;
  FWatchArrCell.Top := 52;
  FWatchArrCell.ShowAccelChar := False;
  FWatchArrCell.Font.Style := [fsBold];

  FWatchArrGrid := TDrawGrid.Create(FWatchWnd);
  FWatchArrGrid.Parent := FWatchArrPanel;
  FWatchArrGrid.Align := alClient;
  FWatchArrGrid.BorderStyle := bsNone;
  FWatchArrGrid.DefaultDrawing := False;
  FWatchArrGrid.DefaultRowHeight := 18;
  FWatchArrGrid.Options := [goFixedVertLine, goFixedHorzLine, goVertLine,
                            goHorzLine, goColSizing, goThumbTracking];
  FWatchArrGrid.OnDrawCell := WatchArrDrawCell;
  FWatchArrGrid.OnSelectCell := WatchArrSelectCell;
end;

// Панель справа: показать или убрать. Окно расширяется на её ширину, если
// иначе списку выражений осталось бы мало места, и сужается обратно.
procedure TForm1.WatchArrShow(AVisible: Boolean);
begin
  if (FWatchArrPanel = nil) or (FWatchArrPanel.Visible = AVisible) then
    Exit;
  if AVisible then
  begin
    if FWatchWnd.ClientWidth - FWatchArrPanel.Width < 400 then
    begin
      FWatchArrGrown := FWatchArrPanel.Width + FWatchArrSplit.Width;
      FWatchWnd.Width := FWatchWnd.Width + FWatchArrGrown;
    end;
    FWatchArrPanel.Visible := True;
    // Разделитель - левее панели: порядок alRight задаёт Left
    FWatchArrSplit.Left := FWatchArrPanel.Left - FWatchArrSplit.Width;
    FWatchArrSplit.Visible := True;
  end
  else
  begin
    FWatchArrSplit.Visible := False;
    FWatchArrPanel.Visible := False;
    if FWatchArrGrown > 0 then
    begin
      FWatchWnd.Width := FWatchWnd.Width - FWatchArrGrown;
      FWatchArrGrown := 0;
    end;
    FWatchArrExpr := '';
  end;
end;

// Поля индексов и таблица под измерения FWatchArr
procedure TForm1.WatchArrSetup;
const
  MaxRows = 1000000;
  EditWidth = 64;
var
  DimIdx, Count1, Count2: Integer;
  DimText: string;
  Edit: TUiEdit;
begin
  for DimIdx := 0 to High(FWatchArrEdits) do
    FWatchArrEdits[DimIdx].Free;
  SetLength(FWatchArrEdits, FWatchArr.DimCount);

  DimText := '';
  for DimIdx := 0 to FWatchArr.DimCount - 1 do
  begin
    if DimText <> '' then
      DimText := DimText + ', ';
    DimText := DimText + IntToStr(FWatchArr.Lo[DimIdx]) + '..' +
               IntToStr(FWatchArr.Hi[DimIdx]);

    Edit := TUiEdit.Create(FWatchWnd);
    Edit.Parent := FWatchArrTop;
    Edit.Left := 6 + DimIdx * (EditWidth + 6);
    Edit.Top := 24;
    Edit.Width := EditWidth;
    Edit.Text := IntToStr(FWatchArr.Lo[DimIdx]);
    Edit.Hint := 'Индекс ' + IntToStr(DimIdx + 1) + ': ' +
                 IntToStr(FWatchArr.Lo[DimIdx]) + '..' +
                 IntToStr(FWatchArr.Hi[DimIdx]);
    Edit.ShowHint := True;
    Edit.OnChange := WatchArrEditChange;
    FWatchArrEdits[DimIdx] := Edit;
  end;
  FWatchArrType.Caption := FWatchArrExpr + ': [' + DimText + '] ' +
                           FWatchArr.TypeText;
  FWatchArrType.Hint := FWatchArrType.Caption;

  Count1 := FWatchArr.Hi[0] - FWatchArr.Lo[0] + 1;
  if Count1 > MaxRows then
    Count1 := MaxRows;
  Count2 := 1;
  if FWatchArr.DimCount = 2 then
    Count2 := FWatchArr.Hi[1] - FWatchArr.Lo[1] + 1;
  FWatchArrLock := True;
  try
    // Пустой динамический массив (или пустая первая строка) - таблицы нет
    if (Count1 <= 0) or (Count2 <= 0) then
      FWatchArrGrid.Visible := False
    else
    case FWatchArr.DimCount of
      1:
      begin
        FWatchArrGrid.ColCount := 2;
        FWatchArrGrid.RowCount := Count1 + 1;
        FWatchArrGrid.FixedCols := 1;
        FWatchArrGrid.FixedRows := 1;
        FWatchArrGrid.ColWidths[0] := 70;
        FWatchArrGrid.ColWidths[1] := 260;
        FWatchArrGrid.Visible := True;
      end;
      2:
      begin
        if Count2 > MaxRows then
          Count2 := MaxRows;
        FWatchArrGrid.ColCount := Count2 + 1;
        FWatchArrGrid.RowCount := Count1 + 1;
        FWatchArrGrid.FixedCols := 1;
        FWatchArrGrid.FixedRows := 1;
        FWatchArrGrid.DefaultColWidth := 90;
        FWatchArrGrid.ColWidths[0] := 60;
        FWatchArrGrid.Visible := True;
      end;
    else
      FWatchArrGrid.Visible := False;
    end;
    if FWatchArrGrid.Visible then
    begin
      FWatchArrGrid.Row := 1;
      FWatchArrGrid.Col := 1;
    end;
  finally
    FWatchArrLock := False;
  end;
  UiPaintTree(FWatchArrPanel);
end;

// Выбрано другое выражение или новая остановка: массив ли это, и какой
procedure TForm1.WatchArrUpdate;
var
  ExprIdx, DimIdx: Integer;
  ExprText, ErrText: string;
  NewInfo: TDbgArrayInfo;
  SameShape: Boolean;
begin
  if (FWatchWnd = nil) or (FWatchArrPanel = nil) then
    Exit;
  // RapidQ: панели массива нет
  if (FDbgSession = nil) and FRqDbgOn then
  begin
    WatchArrShow(False);
    Exit;
  end;
  ExprIdx := DbgWatchSelected;
  if ExprIdx < 0 then
  begin
    WatchArrShow(False);
    Exit;
  end;
  ExprText := FWatchList[ExprIdx];

  if WatchStateText <> '' then
  begin
    // Программа не стоит: размеры массива не узнать. Панель того же
    // выражения остаётся (значения - состоянием), другого - убирается
    if CompareText(ExprText, FWatchArrExpr) <> 0 then
      WatchArrShow(False)
    else
    begin
      FWatchArrGrid.Invalidate;
      WatchArrCellShow;
    end;
    Exit;
  end;

  if not FDbgSyms.ArrayInfo(ExprText, FDbgSession.ImageBase,
                            FDbgSession.StopEip, FDbgSession.StopRegs,
                            FDbgSession.ReadMemory, NewInfo, ErrText) then
  begin
    WatchArrShow(False);
    // Тип назван массивом, а разобрать не вышло - причина в Compilation
    // log, один раз на разную причину
    if (Pos('ARRAY', UpperCase(NewInfo.TypeText)) > 0) and (ErrText <> '') and
       (Pos(#1 + ErrText + #1, FWatchNotes) = 0) then
    begin
      FWatchNotes := FWatchNotes + #1 + ErrText + #1;
      LogComp('Watch: ' + ExprText + ' - таблица массива: ' + ErrText);
    end;
    Exit;
  end;

  // Тот же массив - поля и таблица остаются, с прежними индексами
  SameShape := FWatchArrPanel.Visible and
               (CompareText(ExprText, FWatchArrExpr) = 0) and
               (NewInfo.DimCount = FWatchArr.DimCount);
  if SameShape then
    for DimIdx := 0 to NewInfo.DimCount - 1 do
      if (NewInfo.Lo[DimIdx] <> FWatchArr.Lo[DimIdx]) or
         (NewInfo.Hi[DimIdx] <> FWatchArr.Hi[DimIdx]) then
        SameShape := False;
  FWatchArr := NewInfo;
  FWatchArrExpr := ExprText;
  WatchArrShow(True);
  if not SameShape then
    WatchArrSetup;
  FWatchArrGrid.Invalidate;
  WatchArrCellShow;
end;

// Индексы из полей; не число - нижняя граница
procedure TForm1.WatchArrIndices(var AIndex: array of Integer);
var
  DimIdx: Integer;
begin
  for DimIdx := 0 to High(AIndex) do
    if DimIdx <= High(FWatchArrEdits) then
      AIndex[DimIdx] := StrToIntDef(Trim(FWatchArrEdits[DimIdx].Text),
                                    FWatchArr.Lo[DimIdx])
    else
      AIndex[DimIdx] := 0;
end;

// Значение ячейки по индексам из полей
procedure TForm1.WatchArrCellShow;
var
  Index: array[0..DbgMaxArrayDims - 1] of Integer;
  DimIdx: Integer;
  IdxText, ValueText, StateText: string;
begin
  if (FWatchArrCell = nil) or (FWatchArr.DimCount = 0) then
    Exit;
  WatchArrIndices(Index);
  IdxText := '';
  for DimIdx := 0 to FWatchArr.DimCount - 1 do
  begin
    if IdxText <> '' then
      IdxText := IdxText + ', ';
    IdxText := IdxText + IntToStr(Index[DimIdx]);
  end;
  StateText := WatchStateText;
  if StateText <> '' then
    ValueText := StateText
  else
    ValueText := FDbgSyms.ArrayElement(FWatchArr,
                                       Slice(Index, FWatchArr.DimCount), FDbgSession.ReadMemory);
  FWatchArrCell.Caption := FWatchArrExpr + '[' + IdxText + '] = ' + ValueText;
end;

// Поле индекса изменили: значение ячейки и переход таблицы к ней
procedure TForm1.WatchArrEditChange(Sender: TObject);
var
  Index: array[0..DbgMaxArrayDims - 1] of Integer;
  NewRow, NewCol: Integer;
begin
  WatchArrCellShow;
  if FWatchArrLock or not FWatchArrGrid.Visible then
    Exit;
  WatchArrIndices(Index);
  NewRow := Index[0] - FWatchArr.Lo[0] + 1;
  if FWatchArr.DimCount = 2 then
    NewCol := Index[1] - FWatchArr.Lo[1] + 1
  else
    NewCol := 1;
  if (NewRow < 1) or (NewRow >= FWatchArrGrid.RowCount) or
     (NewCol < 1) or (NewCol >= FWatchArrGrid.ColCount) then
    Exit;
  FWatchArrLock := True;
  try
    FWatchArrGrid.Row := NewRow;
    FWatchArrGrid.Col := NewCol;
  finally
    FWatchArrLock := False;
  end;
end;

// Щелчок по ячейке таблицы - её индексы в поля
procedure TForm1.WatchArrSelectCell(Sender: TObject; ACol, ARow: Integer;
                                    var CanSelect: Boolean);
begin
  if FWatchArrLock or (ARow < 1) or (ACol < 1) or
     (Length(FWatchArrEdits) < FWatchArr.DimCount) then
    Exit;
  FWatchArrLock := True;
  try
    FWatchArrEdits[0].Text := IntToStr(FWatchArr.Lo[0] + ARow - 1);
    if FWatchArr.DimCount = 2 then
      FWatchArrEdits[1].Text := IntToStr(FWatchArr.Lo[1] + ACol - 1);
  finally
    FWatchArrLock := False;
  end;
  WatchArrCellShow;
end;

// Ячейка таблицы: заголовки - индексы, значения - из памяти программы
procedure TForm1.WatchArrDrawCell(Sender: TObject; ACol, ARow: Integer;
                                  Rect: TRect; State: TGridDrawState);
var
  Grid: TDrawGrid;
  CellText: string;
  Index: array[0..1] of Integer;
begin
  Grid := TDrawGrid(Sender);
  CellText := '';
  if (ARow = 0) and (ACol = 0) then
  begin
    if FWatchArr.DimCount = 1 then
      CellText := 'Индекс';
  end
  else if ARow = 0 then
  begin
    if FWatchArr.DimCount = 1 then
      CellText := 'Значение'
    else
      CellText := IntToStr(FWatchArr.Lo[1] + ACol - 1);
  end
  else if ACol = 0 then
    CellText := IntToStr(FWatchArr.Lo[0] + ARow - 1)
  else if WatchStateText = '' then
  begin
    Index[0] := FWatchArr.Lo[0] + ARow - 1;
    if FWatchArr.DimCount = 2 then
    begin
      Index[1] := FWatchArr.Lo[1] + ACol - 1;
      CellText := FDbgSyms.ArrayElement(FWatchArr, Index,
                                        FDbgSession.ReadMemory);
    end
    else
      CellText := FDbgSyms.ArrayElement(FWatchArr, Slice(Index, 1),
                                        FDbgSession.ReadMemory);
  end;

  if gdFixed in State then
  begin
    Grid.Canvas.Brush.Color := UiColor('Ide.WindowBG');
    Grid.Canvas.Font.Color := UiColor('Ide.WindowText');
  end
  else if gdSelected in State then
  begin
    Grid.Canvas.Brush.Color := UiColor('ObjTree.SelBG');
    Grid.Canvas.Font.Color := UiColor('ObjTree.SelText');
  end
  else
  begin
    Grid.Canvas.Brush.Color := UiColor('Ide.ListBG');
    Grid.Canvas.Font.Color := UiColor('Ide.ListText');
  end;
  Grid.Canvas.FillRect(Rect);
  Grid.Canvas.Brush.Style := bsClear;
  Grid.Canvas.TextRect(Rect, Rect.Left + 4,
                       Rect.Top + (Rect.Bottom - Rect.Top - Grid.Canvas.TextHeight('0')) div 2,
                       CellText);
  Grid.Canvas.Brush.Style := bsSolid;
end;

