// ---------------------------------------------------------------------------
//  Вкладка Objects для файлов RapidQ: дерево объектов, созданных через
//  CREATE ... END CREATE (как вкладка Objects в RQdebugger, BuildObjTree).
//  Узлы - те же TDfmNode, что у форм Delphi: имя, класс, строка CREATE,
//  дальше в них лягут свойства и события из снимка.
//
//  CREATE внутри другого CREATE - его потомок. Комментарии (' и REM) не в
//  счёт; строка делится на операторы по ":" вне кавычек, так что
//  "CREATE ... : END CREATE" в одной строке тоже разбирается. END CREATE
//  без CREATE и CREATE без END CREATE показываются с пометкой. Рядом с
//  объектом - номер строки CREATE, щелчок - к ней (CodeTreeClick).
//  Разбирается текст из редактора, с несохранёнными правками; объекты из
//  $INCLUDE-файлов пока не показываются.
// ---------------------------------------------------------------------------

// Операторы строки RapidQ: без комментария ', разделены ":" вне кавычек
procedure RapidQSplitStatements(const ALine: string; AParts: TStrings);
var
  CharIdx, StartPos: Integer;
  InQuote: Boolean;

  procedure AddPart(AEnd: Integer);
  var
    Stmt: string;
  begin
    Stmt := Trim(Copy(ALine, StartPos, AEnd - StartPos));
    if Stmt <> '' then
      AParts.Add(Stmt);
  end;

begin
  AParts.Clear;
  InQuote := False;
  StartPos := 1;
  for CharIdx := 1 to Length(ALine) do
  case ALine[CharIdx] of
    '"':
    InQuote := not InQuote;
    '''':
    if not InQuote then
    begin
      AddPart(CharIdx);
      Exit;
    end;
    ':':
    if not InQuote then
    begin
      AddPart(CharIdx);
      StartPos := CharIdx + 1;
    end;
  end;
  AddPart(Length(ALine) + 1);
end;

// Первое слово оператора заглавными; ARest - то, что после него
function RapidQFirstWord(const AStmt: string; var ARest: string): string;
var
  WordEnd: Integer;
begin
  WordEnd := 1;
  while (WordEnd <= Length(AStmt)) and (AStmt[WordEnd] > ' ') do
    Inc(WordEnd);
  Result := UpperCase(Copy(AStmt, 1, WordEnd - 1));
  ARest := Trim(Copy(AStmt, WordEnd, MaxInt));
end;

// Имя объекта из "DIM [SHARED] Имя AS ..." как в тексте (без перевода в
// заглавные)
function RapidQDimName(const AStmt: string): string;
var
  Rest, Tail: string;
begin
  RapidQFirstWord(AStmt, Rest);           // DIM
  if RapidQFirstWord(Rest, Tail) = 'SHARED' then
    Rest := Tail;
  RapidQFirstWord(Rest, Tail);
  Result := Trim(Copy(Rest, 1, Length(Rest) - Length(Tail)));
end;

// Присваивание в блоке CREATE: "Width = 100", "Font.Name = "courier"",
// "OnClick = BtnClick". AName - то, что слева, AValue - текст справа как
// есть (выражение не вычисляется).
function RapidQAssignment(const AStmt: string; var AName, AValue: string): Boolean;
var
  CharIdx: Integer;
begin
  Result := False;
  if (AStmt = '') or not (AStmt[1] in ['A'..'Z', 'a'..'z', '_']) then
    Exit;
  CharIdx := 1;
  while (CharIdx <= Length(AStmt)) and
        (AStmt[CharIdx] in ['A'..'Z', 'a'..'z', '0'..'9', '_', '.']) do
    Inc(CharIdx);
  AName := Copy(AStmt, 1, CharIdx - 1);
  while (CharIdx <= Length(AStmt)) and (AStmt[CharIdx] <= ' ') do
    Inc(CharIdx);
  if (CharIdx > Length(AStmt)) or (AStmt[CharIdx] <> '=') then
    Exit;
  AValue := Trim(Copy(AStmt, CharIdx + 1, MaxInt));
  Result := True;
end;

// Parent, заданный в коде явно, - узел дерева переезжает под этот объект.
// Вложенность CREATE даёт родителя по умолчанию, но "Parent = DesignTab"
// в блоке или "MenuPanel.Parent = DesignTab" в коде его меняет - так и в
// работающей программе. Порядок:
//   1. Parent = ... в самом блоке CREATE (последнее присваивание);
//   2. Имя.Parent = ... вне блоков (ACodeParents: "Имя=Родитель", в
//      Objects - номер строки), первое по тексту.
// Родитель - объект с таким именем; выражение (Form.Panel1, Tab(0)) не
// разбирается, узел тогда остаётся где был. Себя и своих потомков в
// родители не берёт. Под новым родителем узел встаёт по номеру строки
// CREATE.
procedure RapidQApplyParents(ANodes, ARoots: TList; ACodeParents: TStrings);
var
  NodeIdx, PropIdx, CodeIdx, InsIdx, CodeLine: Integer;
  Node, Target, Walk: TDfmNode;
  ParentName: string;
  IsDescendant: Boolean;

  function FindByName(const AName: string): TDfmNode;
  var
    FindIdx: Integer;
  begin
    Result := nil;
    for FindIdx := 0 to ANodes.Count - 1 do
      if CompareText(TDfmNode(ANodes[FindIdx]).Name, AName) = 0 then
      begin
        Result := TDfmNode(ANodes[FindIdx]);
        Exit;
      end;
  end;

// Имя объекта из значения: идентификатор целиком, иначе ''
  function PlainName(const AValue: string): string;
  var
    CharIdx: Integer;
  begin
    Result := Trim(AValue);
    for CharIdx := 1 to Length(Result) do
      if not (Result[CharIdx] in ['A'..'Z', 'a'..'z', '0'..'9', '_']) then
      begin
        Result := '';
        Exit;
      end;
  end;

begin
  for NodeIdx := 0 to ANodes.Count - 1 do
  begin
    Node := TDfmNode(ANodes[NodeIdx]);
    if Node.Name = '' then
      Continue;
    ParentName := '';
    CodeLine := -1;
    for PropIdx := Node.PropN.Count - 1 downto 0 do
      if CompareText(Node.PropN[PropIdx], 'Parent') = 0 then
      begin
        ParentName := PlainName(Node.PropV[PropIdx]);
        Break;
      end;
    if ParentName = '' then
    begin
      CodeIdx := ACodeParents.IndexOfName(Node.Name);
      if CodeIdx >= 0 then
      begin
        ParentName := PlainName(ACodeParents.Values[Node.Name]);
        CodeLine := Integer(ACodeParents.Objects[CodeIdx]);
      end;
    end;
    if ParentName = '' then
      Continue;
    Target := FindByName(ParentName);
    if (Target = nil) or (Target = Node) or (Target = Node.Parent) then
      Continue;
    // Цикл: родитель - сам узел или его потомок
    IsDescendant := False;
    Walk := Target.Parent;
    while Walk <> nil do
    begin
      if Walk = Node then
      begin
        IsDescendant := True;
        Break;
      end;
      Walk := Walk.Parent;
    end;
    if IsDescendant then
      Continue;

    if Node.Parent <> nil then
      Node.Parent.Children.Remove(Node)
    else
      ARoots.Remove(Node);
    InsIdx := 0;
    while (InsIdx < Target.Children.Count) and
          (TDfmNode(Target.Children[InsIdx]).CreateLine <= Node.CreateLine) do
      Inc(InsIdx);
    Target.Children.Insert(InsIdx, Node);
    Node.Parent := Target;
    if CodeLine >= 0 then
      Node.Note := Node.Note + '  Parent: строка ' + IntToStr(CodeLine + 1);
  end;
end;

// Узлы объектов CREATE из строк ALines - в ANodes (владеет ими он), корни
// (CREATE вне других CREATE) - в ARoots. Присваивания внутри блока -
// свойствами узла (PropN, PropV; в PropN.Objects - номер строки), On... -
// событиями (EvN, EvV, номер строки в EvN.Objects). Результат - число
// объектов.
//
// Объекты DIM: "DIM [SHARED] Имя AS Qкласс" вне блоков CREATE - тоже узел
// (так пишут формы вручную, и так выглядит перевод RqToFb в _rqfb, где
// каждый CREATE стал DIM). Свойства и события такого объекта - строки
// "Имя.Свойство = значение" ниже по тексту, первое присваивание каждого
// свойства (дальше это уже работа программы).
function RapidQCreateNodes(ALines: TStrings; ANodes, ARoots: TList): Integer;
var
  DimNodes: TStringList;   // ИМЯ -> узел объекта DIM, с сортировкой
  DimIdx, DotPos: Integer;
  UpLine, ObjPart, MemberPart: string;
  Parts, CodeParents: TStringList;
  OpenNodes: TList;   // узлы CREATE, для которых ещё не было END CREATE
  LineIdx, PartIdx, NodeIdx: Integer;
  FirstWord, Rest, Tail, NameWord, ClassPart, PropName, PropValue: string;
  Parent, Node: TDfmNode;

  function NewNode(AParent: TDfmNode; ALine: Integer): TDfmNode;
  begin
    Result := TDfmNode.Create;
    ANodes.Add(Result);
    Result.Line := ALine;
    Result.CreateLine := ALine;
    Result.FromCode := True;
    Result.Note := '[' + IntToStr(ALine + 1) + ']';
    Result.Parent := AParent;
    if AParent <> nil then
      AParent.Children.Add(Result)
    else
      ARoots.Add(Result);
  end;

begin
  Result := 0;
  Parts := TStringList.Create;
  CodeParents := TStringList.Create;
  OpenNodes := TList.Create;
  DimNodes := TStringList.Create;
  DimNodes.Sorted := True;
  DimNodes.Duplicates := dupIgnore;
  try
    for LineIdx := 0 to ALines.Count - 1 do
    begin
      // Быстрый отсев: вне блоков CREATE нужны только строки со словами
      // CREATE и DIM и присваивания через точку (Имя.Parent = ...)
      if OpenNodes.Count = 0 then
      begin
        UpLine := UpperCase(ALines[LineIdx]);
        if (Pos('CREATE', UpLine) = 0) and (Pos('DIM', UpLine) = 0) and
           ((Pos('.', UpLine) = 0) or (Pos('=', UpLine) = 0)) then
          Continue;
      end;
      RapidQSplitStatements(ALines[LineIdx], Parts);
      for PartIdx := 0 to Parts.Count - 1 do
      begin
        FirstWord := RapidQFirstWord(Parts[PartIdx], Rest);
        if FirstWord = 'REM' then
          Break;   // дальше в строке - комментарий
        if FirstWord = 'CREATE' then
        begin
          if OpenNodes.Count > 0 then
            Parent := TDfmNode(OpenNodes[OpenNodes.Count - 1])
          else
            Parent := nil;
          Node := NewNode(Parent, LineIdx);
          // "MenuText AS QRichEdit"; другой вид - целиком в имя
          Node.Name := Rest;
          NameWord := RapidQFirstWord(Rest, Tail);
          if NameWord <> '' then
          begin
            ClassPart := '';
            if RapidQFirstWord(Tail, ClassPart) = 'AS' then
            begin
              Node.Name := Copy(Rest, 1, Length(NameWord));
              Node.ClassNm := Trim(ClassPart);
            end;
          end;
          OpenNodes.Add(Node);
          Inc(Result);
        end
        else if (FirstWord = 'END') and
                (RapidQFirstWord(Rest, Tail) = 'CREATE') then
        begin
          if OpenNodes.Count > 0 then
          begin
            TDfmNode(OpenNodes[OpenNodes.Count - 1]).EndLine := LineIdx;
            OpenNodes.Delete(OpenNodes.Count - 1);
          end
          else
          begin
            Node := NewNode(nil, LineIdx);
            Node.ClassNm := 'END CREATE без CREATE';
          end;
        end
        else if (OpenNodes.Count > 0) and
                RapidQAssignment(Parts[PartIdx], PropName, PropValue) then
        begin
          // Свойство или событие объекта, чей блок сейчас открыт
          Node := TDfmNode(OpenNodes[OpenNodes.Count - 1]);
          if UpperCase(Copy(PropName, 1, 2)) = 'ON' then
          begin
            Node.EvN.AddObject(PropName, TObject(LineIdx));
            Node.EvV.Add(PropValue);
          end
          else
          begin
            Node.PropN.AddObject(PropName, TObject(LineIdx));
            Node.PropV.Add(PropValue);
            Node.PropRaw.Add(PropValue);
          end;
        end
        else if (OpenNodes.Count = 0) and (FirstWord = 'DIM') then
        begin
          // DIM [SHARED] Имя AS Qкласс - объект
          NameWord := RapidQFirstWord(Rest, Tail);
          if NameWord = 'SHARED' then
          begin
            UpLine := Tail;
            NameWord := RapidQFirstWord(UpLine, Tail);
          end;
          ClassPart := '';
          if (NameWord <> '') and (Pos('(', NameWord) = 0) and
             (RapidQFirstWord(Tail, ClassPart) = 'AS') and
             (UpperCase(Copy(Trim(ClassPart), 1, 1)) = 'Q') and
             (Pos(' ', Trim(ClassPart)) = 0) and
             (DimNodes.IndexOf(NameWord) < 0) then
          begin
            Node := NewNode(nil, LineIdx);
            // Имя - как в тексте, не заглавными
            Node.Name := RapidQDimName(Parts[PartIdx]);
            Node.ClassNm := Trim(ClassPart);
            Node.EndLine := LineIdx;
            Node.IsDim := True;
            DimNodes.AddObject(NameWord, Node);
            Inc(Result);
          end;
        end
        else if (OpenNodes.Count = 0) and (DimNodes.Count > 0) and
                RapidQAssignment(Parts[PartIdx], PropName, PropValue) and
                (Pos('.', PropName) > 0) and
                (DimNodes.IndexOf(UpperCase(Copy(PropName, 1,
                  Pos('.', PropName) - 1))) >= 0) then
        begin
          // Имя.Свойство = значение у объекта DIM
          DotPos := Pos('.', PropName);
          ObjPart := UpperCase(Copy(PropName, 1, DotPos - 1));
          MemberPart := Copy(PropName, DotPos + 1, MaxInt);
          DimIdx := DimNodes.IndexOf(ObjPart);
          Node := TDfmNode(DimNodes.Objects[DimIdx]);
          if MemberPart <> '' then
          begin
            if UpperCase(Copy(MemberPart, 1, 2)) = 'ON' then
            begin
              if Node.EvN.IndexOf(MemberPart) < 0 then
              begin
                Node.EvN.AddObject(MemberPart, TObject(LineIdx));
                Node.EvV.Add(PropValue);
              end;
            end
            else if Node.PropN.IndexOf(MemberPart) < 0 then
            begin
              Node.PropN.AddObject(MemberPart, TObject(LineIdx));
              Node.PropV.Add(PropValue);
              Node.PropRaw.Add(PropValue);
              if LineIdx > Node.EndLine then
                Node.EndLine := LineIdx;
            end;
          end;
        end
        else if (OpenNodes.Count = 0) and
                RapidQAssignment(Parts[PartIdx], PropName, PropValue) and
                (Length(PropName) > 7) and
                (CompareText(Copy(PropName, Length(PropName) - 6, 7),
        '.Parent') = 0) then
        begin
          // "MenuPanel.Parent = DesignTab" в коде - первое по тексту
          NameWord := Copy(PropName, 1, Length(PropName) - 7);
          if (Pos('.', NameWord) = 0) and
             (CodeParents.IndexOfName(NameWord) < 0) then
            CodeParents.AddObject(NameWord + '=' + PropValue,
                                  TObject(LineIdx));
        end;
      end;
    end;

    // Явный Parent - узел под указанным объектом
    RapidQApplyParents(ANodes, ARoots, CodeParents);

    // CREATE, который так и не закрыт
    for NodeIdx := 0 to OpenNodes.Count - 1 do
    begin
      Node := TDfmNode(OpenNodes[NodeIdx]);
      Node.Note := Node.Note + '  нет END CREATE';
    end;
  finally
    DimNodes.Free;
    OpenNodes.Free;
    CodeParents.Free;
    Parts.Free;
  end;
end;

// Инспектор для файла RapidQ: дерево объектов CREATE. Свойств у узлов пока
// нет - их даст снимок программы.
procedure TForm1.RefreshRapidQInspector;
var
  Lines: TStringList;
  Roots: TList;
  RootIdx, ObjCount, CustomCount: Integer;
begin
  ObjCancelEdit;
  FObjCurNode := nil;
  FObjDfmBinary := False;
  ClearDfmNodes;
  // Ветка Delphi после RapidQ должна строиться заново, не по старым ключам
  FObjRapidQ := True;
  FObjDfmKey := '';
  FObjTreeKey := '';
  FObjTreeDfm := '';
  FObjDfmFile := '';
  FObjFormClass := '';
  FObjCacheFile := '';
  FObjLinesUnsure := False;
  if FObjRoots = nil then
    FObjRoots := TList.Create;
  // Снимок относится к главному .bas: у вкладки .inc - к цели проекта
  FRqInspMain := RapidQTargetBas(False);

  Lines := TStringList.Create;
  Roots := TList.Create;
  try
    Lines.Text := GetEditorTextCR;
    ObjCount := RapidQCreateNodes(Lines, FDfmNodes, Roots);
    CustomCount := RapidQLoadCustomTypes(Lines, FCurrentFileName);
    RenderObjTree(Roots);
    for RootIdx := 0 to Roots.Count - 1 do
      FObjRoots.Add(Roots[RootIdx]);
    if ObjCount = 0 then
      FObjSource.Caption := '  ' + ExtractFileName(FCurrentFileName) +
      ': объектов CREATE и DIM ... AS Q... в файле нет'
    else
      FObjSource.Caption := '  ' + ExtractFileName(FCurrentFileName) +
      ': объектов (CREATE, DIM) - ' + IntToStr(ObjCount) +
      ', классов TYPE ... EXTENDS - ' +
      IntToStr(CustomCount) +
      '. Значения - текст из блоков CREATE, снимка пока нет';
if not RapidQComponentsReady(False) then
        FObjSource.Caption := FObjSource.Caption +
        '. Component.data не найден - список свойств ' +
        'классов не показывается';
if RapidQHasSnapshot and not FRqSnapOff then
        begin
          FObjSource.Caption := '  ' + ExtractFileName(FCurrentFileName) +
          ': объектов CREATE - ' + IntToStr(ObjCount) +
          '  +  снимок ' + TimeToStr(FRqProbeTime) +
          '.  Щелчок здесь - убрать снимок';
          if RapidQSnapStale then
            FObjSource.Caption := FObjSource.Caption + '.  Текст менялся ' +
            'после снимка - значения прежние, Update snapshot - снять заново';
FObjSource.Cursor := crHandPoint;
        end
      else
        FObjSource.Cursor := crDefault;
    RqSnapBtnState;
  finally
    Roots.Free;
    Lines.Free;
  end;
  RqDsgSync;
end;

// Описание компонентов RapidQ загружено. Сначала - файл из настроек
// ([Compiler.RapidQ Basic] CompDataFile, IDE Options - Compilers - поле
// Components); задан другой, чем загружен, - загружается заново. Не задан
// или его нет - папки поиска по порядку:
//   рядом с exe;
//   rapidq_ref рядом с exe (туда его кладёт пересборка, CopyOwnRunFiles);
//   rapidq_ref в папке выше exe (exe в Output\, rapidq_ref - рядом с .dpr);
//   папка компилятора RapidQ из настроек ([Compiler.RapidQ Basic] CompPath);
//   rapidq_ref каждого проекта в папке projects у exe
//   (projects\SyntaxHLClaude\rapidq_ref - исходники самого редактора).
// В первой папке, где что-то нашлось, берётся общий ComponentAll.data; нет
// его или он пустой - Component.data и к нему Component1.data той же папки;
// нет и его - один Component1.data. Загружается один раз за сеанс.
// AReport - не нашлось: каждый проверенный файл и что с ним - в лог.
function TForm1.RapidQComponentsReady(AReport: Boolean): Boolean;
const
  AllName = 'ComponentAll.data';
  MainName = 'Component.data';
  ExtraName = 'Component1.data';
var
  Dirs, Tried: TStringList;
  Ini: TIniFile;
  ExeDir, CompDir, Extra, SetFile: string;
  DirIdx, Members, Added, TryIdx: Integer;
  Found: TSearchRec;

  procedure AddDir(const ADir: string);
  var
    Full: string;
  begin
    if ADir = '' then
      Exit;
    Full := IncludeTrailingPathDelimiter(ExpandFileName(ADir));
    if Dirs.IndexOf(Full) < 0 then
      Dirs.Add(Full);
  end;

// Загрузить AFile; True - классы есть. Что вышло - в Tried.
  function TryLoad(const AFile: string): Boolean;
  begin
    Result := False;
    if not FileExists(AFile) then
    begin
      Tried.Add(AFile + ' - нет файла');
      Exit;
    end;
    Result := RqLoadComponents(AFile) > 0;
    if not Result then
      Tried.Add(AFile + ' - есть, но классов в нём не прочитано');
  end;

begin
  CompDir := '';
  SetFile := '';
  if FileExists(SettingsFileName) then
  begin
    Ini := TIniFile.Create(SettingsFileName);
    try
      CompDir := Trim(Ini.ReadString(CompilerSection('RapidQ Basic'),
      'CompPath', ''));
                                     SetFile := Trim(Ini.ReadString(CompilerSection('RapidQ Basic'),
      'CompDataFile', ''));
    finally
      Ini.Free;
    end;
  end;

  // Загружен тот, что задан; не задан никакой или заданного нет на диске
  // (тогда загружен найденный в папках) - готово
  Result := (RqComponentFile <> '') and
            ((SetFile = '') or not FileExists(SetFile) or
             (CompareText(ExpandFileName(SetFile), RqComponentFile) = 0));
  if Result then
    Exit;

  Dirs := TStringList.Create;
  Tried := TStringList.Create;
  try
    // Файл из настроек. Component.data - с добавкой Component1.data рядом.
    if SetFile <> '' then
    begin
      if TryLoad(ExpandFileName(SetFile)) then
      begin
        Result := True;
        LogComp('Описание компонентов RapidQ (из настроек): ' +
                RqComponentFile + ', классов ' + IntToStr(RqClassCount));
        Extra := ExtractFilePath(RqComponentFile) + ExtraName;
        if (CompareText(ExtractFileName(RqComponentFile), MainName) = 0) and
           FileExists(Extra) then
        begin
          Added := RqMergeComponents(Extra, Members);
          LogComp('  из ' + Extra + ' добавлено классов ' + IntToStr(Added) +
          ', свойств и событий у прежних классов ' +
                  IntToStr(Members));
        end;
        Exit;
      end;
      Tried[Tried.Count - 1] := Tried[Tried.Count - 1] +
      '   (IDE Options - Compilers - Components)';
    end;

    Dirs.CaseSensitive := False;
    ExeDir := ExtractFilePath(Application.ExeName);
    AddDir(ExeDir);
    AddDir(ExeDir + 'rapidq_ref');
    AddDir(ExtractFilePath(ExcludeTrailingPathDelimiter(ExeDir)) + 'rapidq_ref');
    // В CompPath бывает и папка, и путь к rc.exe
    if (CompDir <> '') and FileExists(CompDir) then
      CompDir := ExtractFilePath(CompDir);
    AddDir(CompDir);
    // Проекты в папке projects: у исходников редактора rapidq_ref свой
    if FindFirst(ProjectsDir + '*', faDirectory, Found) = 0 then
    try
      repeat
        if ((Found.Attr and faDirectory) <> 0) and (Found.Name <> '.') and
           (Found.Name <> '..') and
           DirectoryExists(ProjectsDir + Found.Name + '\rapidq_ref') then
          AddDir(ProjectsDir + Found.Name + '\rapidq_ref');
      until FindNext(Found) <> 0;
    finally
      FindClose(Found);
    end;

    for DirIdx := 0 to Dirs.Count - 1 do
    begin
      Extra := '';
      if TryLoad(Dirs[DirIdx] + AllName) then
        Result := True
      else if TryLoad(Dirs[DirIdx] + MainName) then
      begin
        Result := True;
        Extra := Dirs[DirIdx] + ExtraName;
      end
      else if TryLoad(Dirs[DirIdx] + ExtraName) then
        Result := True;
      if not Result then
        Continue;
      LogComp('Описание компонентов RapidQ: ' + RqComponentFile +
      ', классов ' + IntToStr(RqClassCount));
              if (Extra <> '') and FileExists(Extra) then
      begin
        Added := RqMergeComponents(Extra, Members);
        LogComp('  из ' + Extra + ' добавлено классов ' + IntToStr(Added) +
        ', свойств и событий у прежних классов ' + IntToStr(Members));
      end;
      Exit;
    end;

    if AReport then
    begin
      LogComp('Описание компонентов RapidQ не найдено. Проверено:');
      for TryIdx := 0 to Tried.Count - 1 do
        LogComp('    ' + Tried[TryIdx]);
      LogComp('  ComponentAll.data лежит в репозитории в rapidq_ref. Укажите ' +
      'его в IDE Options - Compilers - RapidQ Basic - Components ' +
      'или положите в одну из этих папок');
    end;
  finally
    Tried.Free;
    Dirs.Free;
  end;
end;

// Разбор строки $INCLUDE и поиск файла - ниже, у вкладки Includes;
// RapidQLoadCustomTypes зовёт их раньше
function RapidQIncludeName(const ALine: string): string; forward;
function RapidQResolveInclude(const AName, AMainDir,
                              AIncDir: string): string; forward;

// Папки поиска $INCLUDE - как у компилятора и вкладки Includes: папка
// главного .bas (у вкладки .inc - цели проекта) и Include из настроек
procedure TForm1.RapidQIncludeDirs(var AMainDir, AIncDir: string);
var
  MainBas: string;
begin
  MainBas := RapidQTargetBas(False);
  if MainBas <> '' then
    AMainDir := ExtractFilePath(MainBas)
  else
    AMainDir := ExtractFilePath(FCurrentFileName);
  AIncDir := RapidQIncDir;
end;

// Папки inc RapidQ (rapidq_ref/RQInc.md). В настройках компилятора две:
//   Include UnIde (SysIncPath) - набор, который ставится с unIDE:
//     rapidq_ref\RQInc - RQProc.inc, RQControls.inc и проверенные
//     отдельные inc; пусто - эта папка рядом с exe;
//   Include User (IncPath) - свой общий путь пользователя.
// Проект (Project Properties) выбирает одну: IncMode = sys (по умолчанию),
// user или own - своя папка IncPath раздела Project; список своих папок,
// из которых выбирали, - IncPaths ("|"). Проект прежней версии: IncMode
// нет, IncPath есть - своя папка.
// ASysDir - Include UnIde, AUserDir - Include User, AMode - sys/user/own,
// AOwnDir - своя папка проекта.
procedure TForm1.RapidQIncSettings(const AProject: string;
                                   var ASysDir, AUserDir, AMode, AOwnDir: string);
var
  Ini: TIniFile;
  Prj: TProjectIni;
begin
  ASysDir := '';
  AUserDir := '';
  AMode := 'sys';
  AOwnDir := '';
  if FileExists(SettingsFileName) then
  begin
    Ini := TIniFile.Create(SettingsFileName);
    try
      ASysDir := Trim(Ini.ReadString(CompilerSection('RapidQ Basic'),
                                     'SysIncPath', ''));
      AUserDir := Trim(Ini.ReadString(CompilerSection('RapidQ Basic'),
                                      'IncPath', ''));
    finally
      Ini.Free;
    end;
  end;
  if ASysDir = '' then
    ASysDir := RapidQIncUnIdeDefault;
  if (AProject = '') or not FileExists(SettingsFileName) then
    Exit;
  Prj := TProjectIni.Create(SettingsFileName, AProject);
  try
    AMode := LowerCase(Trim(Prj.ReadString('Project', 'IncMode', '')));
    AOwnDir := Trim(Prj.ReadString('Project', 'IncPath', ''));
  finally
    Prj.Free;
  end;
  if (AMode <> 'sys') and (AMode <> 'user') and (AMode <> 'own') then
  begin
    if AOwnDir <> '' then
      AMode := 'own'
    else
      AMode := 'sys';
  end;
  if (AMode = 'own') and (AOwnDir = '') then
    AMode := 'sys';
end;

// Include UnIde по умолчанию: rapidq_ref\RQInc рядом с exe ('' - её нет)
function TForm1.RapidQIncUnIdeDefault: string;
begin
  Result := ExtractFilePath(Application.ExeName) + 'rapidq_ref\RQInc';
  if not DirectoryExists(Result) then
    Result := '';
end;

// Папка inc для сборки и разбора RapidQ текущего проекта (она же -I для
// rc.exe): выбранная в Project Properties - Include UnIde, Include User
// или своя папка проекта
function TForm1.RapidQIncDir: string;
var
  SysDir, UserDir, Mode, OwnDir: string;
begin
  RapidQIncSettings(FCurrentProject, SysDir, UserDir, Mode, OwnDir);
  if Mode = 'own' then
    Result := OwnDir
  else if Mode = 'user' then
    Result := UserDir
  else
    Result := SysDir;
end;

// Классы программы (TYPE ... EXTENDS) и её константы (CONST Имя = целое,
// для показа перечислений словами) - из текста ALines файла AFile и всех
// файлов, которые он подключает через $INCLUDE, с вложенными. Класс
// берётся из первого файла, где он встретился: сам текст, затем include по
// порядку строк. Результат - число классов.
function TForm1.RapidQLoadCustomTypes(ALines: TStrings;
                                      const AFile: string): Integer;
const
  MaxDepth = 20;
var
  MainDir, IncDir: string;
  Visited: TStringList;

  procedure ScanIncludes(AText: TStrings; ALevel: Integer);
  var
    LineIdx: Integer;
    IncName, Full: string;
    Nested: TStringList;
  begin
    for LineIdx := 0 to AText.Count - 1 do
    begin
      IncName := RapidQIncludeName(AText[LineIdx]);
      if IncName = '' then
        Continue;
      Full := RapidQResolveInclude(IncName, MainDir, IncDir);
      if (Full = '') or (Visited.IndexOf(UpperCase(Full)) >= 0) then
        Continue;
      Visited.Add(UpperCase(Full));
      Nested := TStringList.Create;
      try
        try
          Nested.LoadFromFile(Full);
        except
          Continue;
        end;
        RqParseTypes(Nested, Full);
        RqParseConsts(Nested);
        if ALevel < MaxDepth then
          ScanIncludes(Nested, ALevel + 1);
      finally
        Nested.Free;
      end;
    end;
  end;

begin
  RqClearCustom;
  RqClearConsts;
  RapidQIncludeDirs(MainDir, IncDir);
  Visited := TStringList.Create;
  try
    Visited.Add(UpperCase(ExpandFileName(AFile)));
    RqParseTypes(ALines, AFile);
    RqParseConsts(ALines);
    ScanIncludes(ALines, 1);
  finally
    Visited.Free;
  end;
  Result := RqCustomCount;
end;

// ---------------------------------------------------------------------------
//  Правка свойств объекта RapidQ в инспекторе
//
//  Свойство задано в блоке CREATE - меняется его значение в той же строке
//  (отступ, другие операторы через ":" и комментарий остаются). Не задано
//  (строка таблицы приглушённая) - новая строка "Свойство = значение" в
//  блоке после последнего присваивания объекта, с тем же отступом; нет
//  присваиваний - сразу после CREATE, на уровень глубже. Вариантам
//  перечисления - список из описания компонентов, цвету - константы cl...,
//  строке - ввод без кавычек (кавычки ставятся при записи). Свойства
//  только для чтения, массивы и ресурсы не правятся.
// ---------------------------------------------------------------------------

// Присваивание AName в строке ALine RapidQ: "Width = 100", в том числе
// одним из операторов через ":" ("CREATE B AS QBUTTON : Caption = "a:b"").
// AValStart, AValLen - где в строке значение (от 1, без пробелов по краям);
// комментарий ' после значения и другие операторы не входят. False - нет.
function RapidQFindAssign(const ALine, AName: string;
                          var AValStart, AValLen: Integer): Boolean;
var
  CharIdx, StmtStart, NamePos, EqPos, ValEnd: Integer;
  InQuote, AtBreak: Boolean;

  // Оператор ALine[StmtStart..AEnd-1] - "AName = значение"?
  function CheckStmt(AEnd: Integer): Boolean;
  begin
    Result := False;
    NamePos := StmtStart;
    while (NamePos < AEnd) and (ALine[NamePos] in [' ', #9]) do
      Inc(NamePos);
    if CompareText(Copy(ALine, NamePos, Length(AName)), AName) <> 0 then
      Exit;
    EqPos := NamePos + Length(AName);
    if (EqPos < AEnd) and
       (ALine[EqPos] in ['A'..'Z', 'a'..'z', '0'..'9', '_', '.', '$']) then
      Exit;   // длиннее: Width и WidthMax
    while (EqPos < AEnd) and (ALine[EqPos] in [' ', #9]) do
      Inc(EqPos);
    if (EqPos >= AEnd) or (ALine[EqPos] <> '=') then
      Exit;
    AValStart := EqPos + 1;
    while (AValStart < AEnd) and (ALine[AValStart] in [' ', #9]) do
      Inc(AValStart);
    ValEnd := AEnd - 1;
    while (ValEnd >= AValStart) and (ALine[ValEnd] in [' ', #9]) do
      Dec(ValEnd);
    AValLen := ValEnd - AValStart + 1;
    Result := True;
  end;

begin
  Result := False;
  AValStart := 0;
  AValLen := 0;
  InQuote := False;
  StmtStart := 1;
  for CharIdx := 1 to Length(ALine) + 1 do
  begin
    AtBreak := CharIdx > Length(ALine);
    if not AtBreak then
      if ALine[CharIdx] = '"' then
        InQuote := not InQuote
      else if not InQuote and (ALine[CharIdx] in [':', '''']) then
        AtBreak := True;
    if not AtBreak then
      Continue;
    if CheckStmt(CharIdx) then
    begin
      Result := True;
      Exit;
    end;
    if (CharIdx <= Length(ALine)) and (ALine[CharIdx] = '''') then
      Exit;   // дальше комментарий
    StmtStart := CharIdx + 1;
  end;
end;

// Строка RapidQ в кавычках. Кавычка внутри - через CHR$(34): в литерале
// RapidQ её не записать.
function RapidQQuote(const AText: string): string;
var
  QuotePos: Integer;
  Rest: string;
begin
  if Pos('"', AText) = 0 then
  begin
    Result := '"' + AText + '"';
    Exit;
  end;
  Result := '';
  Rest := AText;
  QuotePos := Pos('"', Rest);
  while QuotePos > 0 do
  begin
    if Result <> '' then
      Result := Result + ' + ';
    Result := Result + '"' + Copy(Rest, 1, QuotePos - 1) + '" + CHR$(34)';
    Delete(Rest, 1, QuotePos);
    QuotePos := Pos('"', Rest);
  end;
  if Rest <> '' then
    Result := Result + ' + "' + Rest + '"';
end;

// Текст из литерала "..." без кавычек; не литерал (выражение, число) -
// False
function RapidQUnquote(const AValue: string; var AText: string): Boolean;
var
  Value: string;
begin
  Value := Trim(AValue);
  Result := (Length(Value) >= 2) and (Value[1] = '"') and
            (Value[Length(Value)] = '"') and
            (Pos('"', Copy(Value, 2, Length(Value) - 2)) = 0);
  if Result then
    AText := Copy(Value, 2, Length(Value) - 2);
end;

// Где вставить новое присваивание в блок CREATE объекта ANode: номер строки
// (новая строка встаёт перед ней) - после последнего присваивания этого
// объекта, а нет их - сразу после CREATE. AIndent - отступ (как у
// последнего присваивания; нет их - как у следующей строки, если она
// глубже CREATE, иначе отступ CREATE плюс табуляция или два пробела),
// AEq - вид знака: "=" или " = ", как у последнего присваивания.
// -1 - блок в одну строку (его правит RapidQInsertBeforeEnd) или END
// CREATE не найден.
// Левая часть присваивания свойства AProp объекта ANode в коде: в блоке
// CREATE - само свойство, у объекта DIM - "Имя.Свойство"
function RapidQAssignName(ANode: TDfmNode; const AProp: string): string;
begin
  if ANode.IsDim then
    Result := ANode.Name + '.' + AProp
  else
    Result := AProp;
end;

// Строка объекта DIM ANode в ALines всё ещё его: DIM ... Имя
function RapidQDimLineOk(ALines: TStrings; ANode: TDfmNode): Boolean;
var
  LineUp: string;
begin
  Result := False;
  if (ANode.CreateLine < 0) or (ANode.CreateLine >= ALines.Count) then
    Exit;
  LineUp := UpperCase(ALines[ANode.CreateLine]);
  Result := (Pos('DIM', LineUp) > 0) and (Pos(UpperCase(ANode.Name), LineUp) > 0);
end;

function RapidQInsertPlace(ALines: TStrings; ANode: TDfmNode;
                           var AIndent, AEq: string): Integer;
var
  LastLine, ItemIdx, ItemLine, EqPos: Integer;
  CreateIndent, NextIndent, LastText: string;

  function IndentOf(const AText: string): string;
  var
    CharIdx: Integer;
  begin
    CharIdx := 1;
    while (CharIdx <= Length(AText)) and (AText[CharIdx] in [' ', #9]) do
      Inc(CharIdx);
    Result := Copy(AText, 1, CharIdx - 1);
  end;

begin
  Result := -1;
  AIndent := '';
  AEq := ' = ';
  // Объект DIM: новая строка "Имя.Свойство = ..." - за последней строкой
  // его свойств (или за DIM), с её отступом
  if ANode.IsDim then
  begin
    if (ANode.CreateLine < 0) or (ANode.CreateLine >= ALines.Count) then
      Exit;
    LastLine := ANode.CreateLine;
    for ItemIdx := 0 to ANode.PropN.Count - 1 do
    begin
      ItemLine := Integer(ANode.PropN.Objects[ItemIdx]);
      if (ItemLine > LastLine) and (ItemLine <= ANode.EndLine) then
        LastLine := ItemLine;
    end;
    for ItemIdx := 0 to ANode.EvN.Count - 1 do
    begin
      ItemLine := Integer(ANode.EvN.Objects[ItemIdx]);
      if (ItemLine > LastLine) and (ItemLine <= ANode.EndLine) then
        LastLine := ItemLine;
    end;
    if LastLine >= ALines.Count then
      Exit;
    Result := LastLine + 1;
    LastText := ALines[LastLine];
    AIndent := IndentOf(LastText);
    if LastLine > ANode.CreateLine then
    begin
      EqPos := Pos('=', LastText);
      if (EqPos > 1) and (LastText[EqPos - 1] <> ' ') then
        AEq := '=';
    end;
    Exit;
  end;
  if (ANode.CreateLine < 0) or (ANode.EndLine <= ANode.CreateLine) or
     (ANode.EndLine >= ALines.Count) then
    Exit;
  LastLine := ANode.CreateLine;
  for ItemIdx := 0 to ANode.PropN.Count - 1 do
  begin
    ItemLine := Integer(ANode.PropN.Objects[ItemIdx]);
    if (ItemLine > LastLine) and (ItemLine < ANode.EndLine) then
      LastLine := ItemLine;
  end;
  for ItemIdx := 0 to ANode.EvN.Count - 1 do
  begin
    ItemLine := Integer(ANode.EvN.Objects[ItemIdx]);
    if (ItemLine > LastLine) and (ItemLine < ANode.EndLine) then
      LastLine := ItemLine;
  end;
  Result := LastLine + 1;

  CreateIndent := IndentOf(ALines[ANode.CreateLine]);
  if LastLine > ANode.CreateLine then
  begin
    LastText := ALines[LastLine];
    AIndent := IndentOf(LastText);
    // Вид "=": есть пробел перед ним - " = ", нет - "="
    EqPos := Pos('=', LastText);
    if (EqPos > 1) and (LastText[EqPos - 1] <> ' ') then
      AEq := '=';
  end
  else
  begin
    NextIndent := IndentOf(ALines[ANode.CreateLine + 1]);
    if Length(NextIndent) > Length(CreateIndent) then
      AIndent := NextIndent
    else if (Pos(#9, CreateIndent) > 0) or (CreateIndent = '') then
      AIndent := CreateIndent + #9
    else
      AIndent := CreateIndent + '  ';
  end;
end;

// Операторы строки RapidQ как есть (через ":" вне кавычек), без пробелов по
// краям, и комментарий: ' вне кавычек или REM в начале оператора - до
// конца строки, с самим знаком.
procedure RapidQSplitKeep(const ALine: string; AParts: TStrings;
                          var AComment: string);
var
  CharIdx, StmtStart, WordPos: Integer;
  InQuote: Boolean;

  // Оператор с позиции StmtStart начинается с REM - комментарий
  function StartsWithRem: Boolean;
  begin
    WordPos := StmtStart;
    while (WordPos <= Length(ALine)) and (ALine[WordPos] in [' ', #9]) do
      Inc(WordPos);
    Result := (UpperCase(Copy(ALine, WordPos, 3)) = 'REM') and
              ((WordPos + 3 > Length(ALine)) or
               (ALine[WordPos + 3] in [' ', #9]));
  end;

  procedure AddPart(AEnd: Integer);
  var
    Part: string;
  begin
    Part := Trim(Copy(ALine, StmtStart, AEnd - StmtStart));
    if Part <> '' then
      AParts.Add(Part);
  end;

begin
  AParts.Clear;
  AComment := '';
  InQuote := False;
  StmtStart := 1;
  if StartsWithRem then
  begin
    AComment := Trim(Copy(ALine, WordPos, MaxInt));
    Exit;
  end;
  for CharIdx := 1 to Length(ALine) do
  begin
    if ALine[CharIdx] = '"' then
      InQuote := not InQuote
    else if not InQuote and (ALine[CharIdx] = '''') then
    begin
      AddPart(CharIdx);
      AComment := Trim(Copy(ALine, CharIdx, MaxInt));
      Exit;
    end
    else if not InQuote and (ALine[CharIdx] = ':') then
    begin
      AddPart(CharIdx);
      StmtStart := CharIdx + 1;
      if StartsWithRem then
      begin
        AComment := Trim(Copy(ALine, WordPos, MaxInt));
        Exit;
      end;
    end;
  end;
  AddPart(Length(ALine) + 1);
end;

// Однострочные блоки "CREATE ... : ... : END CREATE" - по строке на
// оператор; комментарий конца строки - на строку CREATE. AText - строки
// через CR (GetEditorTextCR), результат - так же. ACount - сколько строк
// развёрнуто. ACaretLine - номер строки (с 0) до и после развёртки.
function RapidQExpandCreateLines(const AText: string; var ACount: Integer;
                                 var ACaretLine: Integer): string;
var
  Lines, Parts, Output: TStringList;
  LineIdx, PartIdx, IndentLen, OldCaret: Integer;
  Comment, Indent, Rest, Tail: string;
  HasEnd: Boolean;
begin
  ACount := 0;
  OldCaret := ACaretLine;
  Lines := TStringList.Create;
  Parts := TStringList.Create;
  Output := TStringList.Create;
  try
    Lines.Text := AText;
    for LineIdx := 0 to Lines.Count - 1 do
    begin
      if Pos('CREATE', UpperCase(Lines[LineIdx])) = 0 then
      begin
        Output.Add(Lines[LineIdx]);
        Continue;
      end;
      RapidQSplitKeep(Lines[LineIdx], Parts, Comment);
      HasEnd := False;
      for PartIdx := 1 to Parts.Count - 1 do
        if (RapidQFirstWord(Parts[PartIdx], Rest) = 'END') and
           (RapidQFirstWord(Rest, Tail) = 'CREATE') then
          HasEnd := True;
      if (Parts.Count < 2) or not HasEnd or
         (RapidQFirstWord(Parts[0], Rest) <> 'CREATE') then
      begin
        Output.Add(Lines[LineIdx]);
        Continue;
      end;
      IndentLen := 0;
      while (IndentLen < Length(Lines[LineIdx])) and
            (Lines[LineIdx][IndentLen + 1] in [' ', #9]) do
        Inc(IndentLen);
      Indent := Copy(Lines[LineIdx], 1, IndentLen);
      if Comment <> '' then
        Output.Add(Indent + Parts[0] + '   ' + Comment)
      else
        Output.Add(Indent + Parts[0]);
      for PartIdx := 1 to Parts.Count - 1 do
        Output.Add(Indent + Parts[PartIdx]);
      Inc(ACount);
      if LineIdx < OldCaret then
        Inc(ACaretLine, Parts.Count - 1);
    end;
    // Строки - через CR, как пришли; последний перевод - как был
    Result := '';
    for LineIdx := 0 to Output.Count - 1 do
    begin
      if LineIdx > 0 then
        Result := Result + #13;
      Result := Result + Output[LineIdx];
    end;
    if (AText <> '') and (AText[Length(AText)] in [#13, #10]) then
      Result := Result + #13;
  finally
    Output.Free;
    Parts.Free;
    Lines.Free;
  end;
end;

// Оператор AStmt - в строку ALine перед END CREATE объекта AObjName, тем
// же разделителем, что перед END CREATE: "... : enabled=0 :   END CREATE"
// -> "... : enabled=0 :   AStmt :   END CREATE". Вложенные CREATE ... END
// CREATE в той же строке пропускаются: вставка - в блок самого объекта.
// False - CREATE объекта или его END CREATE в строке нет.
function RapidQInsertBeforeEnd(const ALine, AObjName, AStmt: string;
                               var ANewLine: string): Boolean;
var
  CharIdx, StmtStart, WordPos, Depth: Integer;
  InQuote, AtBreak: Boolean;
  Stmt, FirstWord, Rest, Tail: string;
begin
  Result := False;
  InQuote := False;
  StmtStart := 1;
  Depth := 0;     // 0 - CREATE объекта ещё не встречен
  for CharIdx := 1 to Length(ALine) + 1 do
  begin
    AtBreak := CharIdx > Length(ALine);
    if not AtBreak then
      if ALine[CharIdx] = '"' then
        InQuote := not InQuote
      else if not InQuote and (ALine[CharIdx] in [':', '''']) then
        AtBreak := True;
    if not AtBreak then
      Continue;
    Stmt := Trim(Copy(ALine, StmtStart, CharIdx - StmtStart));
    FirstWord := RapidQFirstWord(Stmt, Rest);
    if FirstWord = 'REM' then
      Exit;
    if FirstWord = 'CREATE' then
    begin
      if Depth > 0 then
        Inc(Depth)
      else if RapidQFirstWord(Rest, Tail) = UpperCase(AObjName) then
        Depth := 1;
    end
    else if (FirstWord = 'END') and (RapidQFirstWord(Rest, Tail) = 'CREATE') and
            (Depth > 0) then
    begin
      Dec(Depth);
      if Depth = 0 then
      begin
        WordPos := StmtStart;
        while (WordPos < CharIdx) and (ALine[WordPos] in [' ', #9]) do
          Inc(WordPos);
        // Пробелы после ":" перед END CREATE - такие же перед новым
        ANewLine := Copy(ALine, 1, WordPos - 1) + AStmt + ' :' +
                    Copy(ALine, StmtStart, MaxInt);
        Result := True;
        Exit;
      end;
    end;
    if (CharIdx <= Length(ALine)) and (ALine[CharIdx] = '''') then
      Exit;
    StmtStart := CharIdx + 1;
  end;
end;

// Вид "=" в строке: у последнего присваивания перед "=" пробел - " = ",
// нет - "="; присваиваний нет - " = "
function RapidQEqStyle(const ALine: string): string;
var
  CharIdx: Integer;
  InQuote: Boolean;
begin
  Result := ' = ';
  InQuote := False;
  for CharIdx := 1 to Length(ALine) do
    if ALine[CharIdx] = '"' then
      InQuote := not InQuote
    else if not InQuote and (ALine[CharIdx] = '''') then
      Exit
    else if not InQuote and (ALine[CharIdx] = '=') and (CharIdx > 1) then
      if ALine[CharIdx - 1] in [' ', #9] then
        Result := ' = '
      else
        Result := '=';
end;

// Описание свойства AName объекта AObj по цепочке его классов. Font.Name
// - свойство Name класса QFONT, если Font у класса этого типа. nil - нет.
function RapidQMemberOf(AObj: TDfmNode; const AName: string): TRqMember;
var
  Chain: TList;
  DotPos: Integer;
  HeadMember: TRqMember;
  FontCls: TRqClass;
begin
  Result := nil;
  Chain := TList.Create;
  try
    RqClassChain(AObj.ClassNm, Chain);
    RqDefaultOf(Chain, AName, Result);
    if Result <> nil then
      Exit;
    DotPos := Pos('.', AName);
    if DotPos = 0 then
      Exit;
    RqDefaultOf(Chain, Copy(AName, 1, DotPos - 1), HeadMember);
    if (HeadMember = nil) or
       (CompareText(HeadMember.TypeName, 'QFONT') <> 0) then
      Exit;
    FontCls := RqFindClass('QFONT');
    if FontCls <> nil then
      Result := FontCls.PropOf(Copy(AName, DotPos + 1, MaxInt));
  finally
    Chain.Free;
  end;
end;

// Таблицы свойств и событий объекта RapidQ AObj (TDfmNode).
//   Заданное в блоке CREATE - текстом исходника и номером строки (колонка
//   «Строка кода»).
//   Остальное - серым по классу и всем его базовым (класс программы TYPE
//   ... EXTENDS, затем описание из ComponentAll.data): свойства со
//   значением по умолчанию (CONSTRUCTOR ближайшего класса или запись
//   описания), события с параметрами обработчика.
procedure TForm1.RapidQFillObjTables(AObj: TObject);
var
  Obj: TDfmNode;
  Chain: TList;
  Seen: TStringList;
  RqCls, ChainCls, FontCls: TRqClass;
  RqMember, FontMember: TRqMember;
  Item: TListItem;
  ItemIdx, ChainIdx, LiveIdx, FontIdx: Integer;
  MemberName, DefText, LiveText, SrcText, ParentName: string;
  Live, FontParents, ParentLive: TStringList;
begin
  Obj := TDfmNode(AObj);
  Live := RapidQLiveProps(Obj.Name);
  Chain := TList.Create;
  Seen := TStringList.Create;
  FontParents := TStringList.Create;
  try
    FontParents.Sorted := True;
    FontParents.CaseSensitive := False;
    Seen.Sorted := True;
    Seen.CaseSensitive := False;
    RqClassChain(Obj.ClassNm, Chain);
    if Chain.Count > 0 then
      RqCls := TRqClass(Chain[0])
    else
      RqCls := nil;

    FObjHeader.Caption := '  ' + Obj.Name + ': ' + Obj.ClassNm;
    if Obj.CreateLine >= 0 then
      FObjHeader.Caption := FObjHeader.Caption + '   строка ' +
                            IntToStr(Obj.CreateLine + 1);
    if (RqCls <> nil) and RqCls.IsCustom then
      FObjHeader.Caption := FObjHeader.Caption + '   (EXTENDS ' +
                            RqCls.BaseName + ', ' +
                            ExtractFileName(RqCls.SrcFile) + ':' +
                            IntToStr(RqCls.SrcLine + 1) + ')'
    else if (RqCls = nil) and (Obj.ClassNm <> '') and
            (RqComponentFile <> '') then
      FObjHeader.Caption := FObjHeader.Caption + '   (класс не описан)';

    // Значение из снимка; у заданных в CREATE выражение - рядом, если
    // отличается от значения
    for ItemIdx := 0 to Obj.PropN.Count - 1 do
    begin
      Item := FObjProps.Items.Add;
      Item.Caption := Obj.PropN[ItemIdx];
      SrcText := Obj.PropV[ItemIdx];
      LiveText := SrcText;
      if (Live <> nil) and (Live.IndexOfName(Obj.PropN[ItemIdx]) >= 0) then
      begin
        // Число перечисления - словом: BorderStyle 2 -> bsSizeable
        RqDefaultOf(Chain, Obj.PropN[ItemIdx], RqMember);
        LiveText := RqChoiceText(RqMember, Live.Values[Obj.PropN[ItemIdx]]);
        if CompareText(Trim(LiveText), Trim(SrcText)) <> 0 then
          LiveText := LiveText + '   (код: ' + SrcText + ')';
      end;
      Item.SubItems.Add(LiveText);
      Item.SubItems.Add(IntToStr(Integer(Obj.PropN.Objects[ItemIdx]) + 1));
      Item.Data := Pointer(ItemIdx);
      Seen.Add(Obj.PropN[ItemIdx]);
    end;
    for ChainIdx := 0 to Chain.Count - 1 do
    begin
      ChainCls := TRqClass(Chain[ChainIdx]);
      for ItemIdx := 0 to ChainCls.Props.Count - 1 do
      begin
        MemberName := ChainCls.Props[ItemIdx];
        if (Obj.PropN.IndexOf(MemberName) >= 0) or
           (Seen.IndexOf(MemberName) >= 0) then
          Continue;
        Seen.Add(MemberName);
        DefText := RqDefaultOf(Chain, MemberName, RqMember);
        if (Live <> nil) and (Live.IndexOfName(MemberName) >= 0) then
          DefText := RqChoiceText(RqMember, Live.Values[MemberName]);
        Item := FObjProps.Items.Add;
        Item.Caption := MemberName;
        Item.SubItems.Add(DefText);
        Item.Data := Pointer(-1);
      end;
    end;
    // Поля шрифта: у свойства типа QFONT (Font, TabInactiveFont) - строки
    // Font.Name, Font.Size... по классу QFONT, то, что можно задать. Сам
    // Font - объект, в блоке CREATE задаются его поля: Font.Size = 10.
    FontCls := RqFindClass('QFONT');
    if FontCls <> nil then
      for ChainIdx := 0 to Chain.Count - 1 do
      begin
        ChainCls := TRqClass(Chain[ChainIdx]);
        for ItemIdx := 0 to ChainCls.Props.Count - 1 do
        begin
          RqMember := TRqMember(ChainCls.Props.Objects[ItemIdx]);
          if CompareText(RqMember.TypeName, 'QFONT') <> 0 then
            Continue;
          if FontParents.IndexOf(RqMember.Name) < 0 then
            FontParents.Add(RqMember.Name);
          for FontIdx := 0 to FontCls.Props.Count - 1 do
          begin
            FontMember := TRqMember(FontCls.Props.Objects[FontIdx]);
            if not FontMember.CanWrite or
               (Pos('ARRAY', UpperCase(FontMember.TypeName)) > 0) or
               (CompareText(FontMember.Name, 'Handle') = 0) then
              Continue;
            MemberName := RqMember.Name + '.' + FontMember.Name;
            if Seen.IndexOf(MemberName) >= 0 then
              Continue;
            Seen.Add(MemberName);
            DefText := FontMember.DefValue;
            if (Live <> nil) and (Live.IndexOfName(MemberName) >= 0) then
              DefText := RqChoiceText(FontMember, Live.Values[MemberName]);
            Item := FObjProps.Items.Add;
            Item.Caption := MemberName;
            Item.SubItems.Add(DefText);
            Item.Data := Pointer(-1);
          end;
        end;
      end;
    // Что есть в снимке, но не в списке класса
    if Live <> nil then
      for LiveIdx := 0 to Live.Count - 1 do
      begin
        MemberName := Live.Names[LiveIdx];
        if (MemberName = '') or (Seen.IndexOf(MemberName) >= 0) then
          Continue;
        Seen.Add(MemberName);
        Item := FObjProps.Items.Add;
        Item.Caption := MemberName;
        Item.SubItems.Add(Live.Values[MemberName]);
        Item.Data := Pointer(-1);
      end;
    FObjProps.AlphaSort;
    // Font - узлом с плюсом, поля под ним (RqPropsTree)
    RqPropsTree(FontParents);

    // Parent - имя родителя текстом: присвоенное в блоке (Parent = Panel1)
    // или блок CREATE, в котором стоит объект. Хэндл родителя из снимка -
    // в SubItems[3], справа в той же ячейке (ObjPropsPostPaint).
    for ItemIdx := 0 to FObjProps.Items.Count - 1 do
    begin
      Item := FObjProps.Items[ItemIdx];
      if CompareText(Item.Caption, 'Parent') <> 0 then
        Continue;
      if Integer(Item.Data) >= 0 then
        ParentName := Trim(Obj.PropV[Integer(Item.Data)])
      else
      begin
        ParentName := '';
        if Obj.Parent <> nil then
          ParentName := Obj.Parent.Name;
        if Item.SubItems.Count = 0 then
          Item.SubItems.Add('');
        Item.SubItems[0] := ParentName;
      end;
      ParentLive := nil;
      if ParentName <> '' then
        ParentLive := RapidQLiveProps(ParentName);
      if (ParentLive <> nil) and (ParentLive.IndexOfName('Handle') >= 0) then
      begin
        while Item.SubItems.Count < 3 do
          Item.SubItems.Add('');
        Item.SubItems.Add('Handle ' + ParentLive.Values['Handle']);
      end;
      Break;
    end;

    for ItemIdx := 0 to Obj.EvN.Count - 1 do
    begin
      Item := FObjEvents.Items.Add;
      Item.Caption := Obj.EvN[ItemIdx];
      Item.SubItems.Add(Obj.EvV[ItemIdx]);
      Item.Data := Pointer(Obj.EvN.Objects[ItemIdx]);   // строка назначения
    end;
    Seen.Clear;
    for ChainIdx := 0 to Chain.Count - 1 do
    begin
      ChainCls := TRqClass(Chain[ChainIdx]);
      for ItemIdx := 0 to ChainCls.Events.Count - 1 do
      begin
        MemberName := ChainCls.Events[ItemIdx];
        if (Obj.EvN.IndexOf(MemberName) >= 0) or
           (Seen.IndexOf(MemberName) >= 0) then
          Continue;
        Seen.Add(MemberName);
        Item := FObjEvents.Items.Add;
        Item.Caption := MemberName;
        Item.SubItems.Add(TRqEvent(ChainCls.Events.Objects[ItemIdx]).Params);
        Item.Data := Pointer(-1);
      end;
    end;
    FObjEvents.AlphaSort;
  finally
    FontParents.Free;
    Seen.Free;
    Chain.Free;
  end;
end;

// Начало правки строки AItem таблицы свойств объекта RapidQ
procedure TForm1.RapidQBeginEdit(AItem: TListItem);
const
  LVM_GETSUBITEMRECT = $1000 + 56;
  LVIR_BOUNDS = 0;
var
  Obj: TDfmNode;
  Member: TRqMember;
  ItemIdx, ChoiceIdx: Integer;
  PropName, OldText, LitText, TypeUp: string;
  CellRect: TRect;
  IsColor, IsEnum: Boolean;
begin
  if FObjCurNode = nil then
    Exit;
  Obj := TDfmNode(FObjCurNode);
  ItemIdx := Integer(AItem.Data);
  PropName := ObjPropRowName(AItem);
  // Parent - переход к родителю (RqGotoParent); второй щелчок двойного
  // приходит уже в таблицу родителя - не правка
  if CompareText(PropName, 'Parent') = 0 then
  begin
    if GetTickCount - FRqToggleTick > GetDoubleClickTime then
      RqGotoParent(AItem);
    Exit;
  end;
  if GetTickCount - FRqToggleTick <= GetDoubleClickTime then
    Exit;
  // Узел (Font) - раскрыть или свернуть, как в инспекторе Delphi
  if RqPropIsNode(AItem) then
  begin
    // Двойной щелчок по плюсу: первым щелчком узел уже переключён
    if GetTickCount - FRqToggleTick > GetDoubleClickTime then
      RqPropExpand(PropName, Copy(AItem.Caption, 1, 1) = '+');
    Exit;
  end;
  Member := RapidQMemberOf(Obj, PropName);
  TypeUp := '';
  if Member <> nil then
  begin
    TypeUp := UpperCase(Member.TypeName);
    // Шрифт - объект: задаются его поля, строки под узлом Font
    if TypeUp = 'QFONT' then
    begin
      ShowMessage(PropName + ' - объект QFONT. В блоке CREATE задаются его ' +
      'поля: ' + PropName + '.Name, ' + PropName + '.Size, ' +
                  PropName + '.Color... - они под узлом ' + PropName + '.');
      Exit;
    end;
    if not Member.CanWrite then
    begin
      ShowMessage(PropName + ' - только для чтения, в коде не задаётся.');
      Exit;
    end;
    if (Pos('ARRAY', TypeUp) > 0) or (TypeUp = 'RESOURCE') then
    begin
      ShowMessage(PropName + ' (' + Member.TypeName + ') одной строкой ' +
      'присваивания не задаётся - правьте его в коде.');
                  Exit;
    end;
  end;
  // Блок может быть и в одну строку: "CREATE A AS QX : ... : END CREATE"
  if (Obj.CreateLine < 0) or (Obj.EndLine < Obj.CreateLine) then
  begin
    ShowMessage('У объекта ' + Obj.Name + ' нет END CREATE - некуда ' +
    'писать свойство.');
                Exit;
  end;

  if ItemIdx >= 0 then
  begin
    if ItemIdx >= Obj.PropN.Count then
      Exit;
    FObjEditInsert := False;
    FObjEditLine := Integer(Obj.PropN.Objects[ItemIdx]);
    OldText := Obj.PropV[ItemIdx];
  end
  else
  begin
    FObjEditInsert := True;
    FObjEditLine := -1;
    OldText := '';
    if AItem.SubItems.Count > 0 then
      OldText := AItem.SubItems[0];
  end;
  FRqEditSrcOld := OldText;
  FObjEditName := PropName;
  FObjEditIdx := ItemIdx;
  FObjEditType := nil;
  FObjThemeColor := '';
  FObjEditIsStr := False;
  FObjEditArray := False;
  FObjEditCode := False;
  FObjEditGroup := False;

  CellRect.Top := 1;               // колонка значения
  CellRect.Left := LVIR_BOUNDS;
  SendMessage(FObjProps.Handle, LVM_GETSUBITEMRECT, AItem.Index,
              Integer(@CellRect));

  IsColor := (Member <> nil) and (Member.Choices.IndexOf('<default>') >= 0);
  IsEnum := (Member <> nil) and (Member.Choices.Count > 0) and not IsColor;
  if IsEnum then
    for ChoiceIdx := 0 to Member.Choices.Count - 1 do
      if Copy(Member.Choices[ChoiceIdx], 1, 1) = '<' then
        IsEnum := False;

  if IsEnum then
  begin
    // Перечисление и False|True - только варианты из описания
    FObjComboColors := False;
    FObjCombo.Style := csDropDownList;
    FObjCombo.Items.Clear;
    for ChoiceIdx := 0 to Member.Choices.Count - 1 do
      FObjCombo.Items.Add(RqChoiceName(Member.Choices[ChoiceIdx]));
    FObjCombo.ItemIndex := FObjCombo.Items.IndexOf(Trim(OldText));
    FObjEditOld := FObjCombo.Text;
    FObjActive := FObjCombo;
  end
  else if IsColor then
  begin
    // Цвет - константы cl... или число (&H00FF00)
    FObjComboColors := True;
    FObjColorRq := True;
    FObjCombo.Style := csDropDown;
    FObjCombo.Items.Clear;
    RqConstNames('cl', FObjCombo.Items);
    if Trim(OldText) = '<default>' then
      FObjCombo.Text := ''
    else
      FObjCombo.Text := Trim(OldText);
    FObjEditOld := FObjCombo.Text;
    FObjActive := FObjCombo;
  end
  else
  begin
    // Строка - без кавычек; выражение ("a" + b$) и числа - как есть
    if TypeUp = 'STRING' then
    begin
      if FObjEditInsert then
      begin
        FObjEditIsStr := True;
        FObjEdit.Text := OldText;
      end
      else if RapidQUnquote(OldText, LitText) then
      begin
        FObjEditIsStr := True;
        FObjEdit.Text := LitText;
      end
      else
        FObjEdit.Text := OldText;
    end
    else
      FObjEdit.Text := OldText;
    FObjEditOld := FObjEdit.Text;
    FObjActive := FObjEdit;
  end;

  FObjActive.SetBounds(CellRect.Left, CellRect.Top,
                       CellRect.Right - CellRect.Left,
                       CellRect.Bottom - CellRect.Top + 2);
  FObjActive.Visible := True;
  FObjActive.SetFocus;
  if FObjActive = FObjEdit then
    FObjEdit.SelectAll;
  FObjEditing := True;
end;

// Запись правки свойства объекта RapidQ в текст активной вкладки
procedure TForm1.RapidQApplyEdit;
var
  Obj: TDfmNode;
  EditText, NewText, CurLine, NewLine, LineIndent, EqText, OldSrc,
    OldStr: string;
  LineNo, LineStart, LineLen, ValStart, ValLen, InsAt, OldNum: Integer;
  Lines: TStringList;

  procedure TextChanged;
  begin
    ShowMessage('Текст изменился после разбора - инспектор обновлён, ' +
    'повторите правку.');
                ObjScheduleRelines(Obj, FObjEditName);
  end;

begin
  if FObjActive = FObjCombo then
    EditText := Trim(FObjCombo.Text)
  else if FObjEditIsStr then
    EditText := FObjEdit.Text
  else
    EditText := Trim(FObjEdit.Text);
  // Не изменилось или пусто (у нестроки) - ничего не пишем
  if (EditText = FObjEditOld) or ((EditText = '') and not FObjEditIsStr) then
  begin
    ObjCancelEdit;
    Exit;
  end;
  if FObjEditIsStr then
    NewText := RapidQQuote(EditText)
  else
    NewText := EditText;

  FObjEditing := False;   // до всего остального: уход фокуса снова вызовет нас
  FObjActive.Visible := False;
  if FObjCurNode = nil then
    Exit;
  Obj := TDfmNode(FObjCurNode);

  // Перевод _rqfb: правка - в исходник RapidQ и тут же сюда
  if FRqFbTab then
  begin
    if RqFbAskMode then
      RqFbLinkedSet(Obj.Name, FObjEditName, NewText, FRqEditSrcOld,
                    not FObjEditInsert);
    Exit;
  end;

  Inc(FObjOwnWrite);
  try
    if not FObjEditInsert then
    begin
      // Значение в строке присваивания - на новое; строка сверяется:
      // в ней то же присваивание с тем же значением
      LineNo := FObjEditLine;
      LineStart := SendMessageA(RichEdit1.Handle, EM_LINEINDEX, LineNo, 0);
      if LineStart < 0 then
      begin
        TextChanged;
        Exit;
      end;
      LineLen := SendMessageA(RichEdit1.Handle, EM_LINELENGTH, LineStart, 0);
      CurLine := ReadLineText(LineNo, LineStart, LineLen);
      if not RapidQFindAssign(CurLine, RapidQAssignName(Obj, FObjEditName),
                              ValStart, ValLen) or
         (Trim(Copy(CurLine, ValStart, ValLen)) <> Trim(FRqEditSrcOld)) then
      begin
        TextChanged;
        Exit;
      end;
      // Было выражение - строка с ним остаётся комментарием, под ней -
      // новое значение
      OldSrc := Trim(FRqEditSrcOld);
      if not RqDsgNumber(RapidQMemberOf(Obj, FObjEditName), OldSrc, OldNum) and
         not RapidQUnquote(OldSrc, OldStr) then
      begin
        if not RqReplaceExprLine(LineNo, LineStart, CurLine, ValStart, ValLen,
                                 RapidQAssignName(Obj, FObjEditName),
                                 NewText) then
        begin
          TextChanged;
          Exit;
        end;
        ObjScheduleRelines(Obj, FObjEditName);
        Exit;
      end;
      EditorFreeze;
      try
        RichEdit1.SelStart := LineStart + ValStart - 1;
        RichEdit1.SelLength := ValLen;
        RichEdit1.SelText := NewText;
      finally
        EditorThaw;
      end;
      LogComp('Инспектор RapidQ: ' + Obj.Name + '.' + FObjEditName + ' = ' +
              NewText + '   (строка ' + IntToStr(LineNo + 1) + ')');
    end
    else
    begin
      // Новая строка в блоке CREATE (у объекта DIM - за строками его
      // свойств); строка CREATE или DIM сверяется с узлом
      Lines := TStringList.Create;
      try
        Lines.Text := GetEditorTextCR;
        if Obj.IsDim then
        begin
          if not RapidQDimLineOk(Lines, Obj) then
          begin
            TextChanged;
            Exit;
          end;
        end
        else if (Obj.CreateLine >= Lines.Count) or
           (Pos('CREATE', UpperCase(Lines[Obj.CreateLine])) = 0) or
           (Pos(UpperCase(Obj.Name), UpperCase(Lines[Obj.CreateLine])) = 0) then
        begin
          TextChanged;
          Exit;
        end;
        if (Obj.EndLine = Obj.CreateLine) and not Obj.IsDim then
          InsAt := -1
        else
          InsAt := RapidQInsertPlace(Lines, Obj, LineIndent, EqText);
      finally
        Lines.Free;
      end;
      if (Obj.EndLine = Obj.CreateLine) and not Obj.IsDim then
      begin
        // Блок в одну строку: оператор - перед его END CREATE, через ":"
        LineNo := Obj.CreateLine;
        LineStart := SendMessageA(RichEdit1.Handle, EM_LINEINDEX, LineNo, 0);
        if LineStart < 0 then
        begin
          TextChanged;
          Exit;
        end;
        LineLen := SendMessageA(RichEdit1.Handle, EM_LINELENGTH, LineStart, 0);
        CurLine := ReadLineText(LineNo, LineStart, LineLen);
        if not RapidQInsertBeforeEnd(CurLine, Obj.Name, FObjEditName +
                                     RapidQEqStyle(CurLine) + NewText, NewLine) then
        begin
          TextChanged;
          Exit;
        end;
        EditorFreeze;
        try
          RichEdit1.SelStart := LineStart;
          RichEdit1.SelLength := LineLen;
          RichEdit1.SelText := NewLine;
        finally
          EditorThaw;
        end;
        LogComp('Инспектор RapidQ: ' + Obj.Name + '.' + FObjEditName +
        ' = ' + NewText + '   (добавлено в строку ' +
                IntToStr(LineNo + 1) + ')');
        ObjScheduleRelines(Obj, FObjEditName);
        Exit;
      end;
      if InsAt < 0 then
      begin
        TextChanged;
        Exit;
      end;
      NewLine := LineIndent + RapidQAssignName(Obj, FObjEditName) + EqText +
                 NewText;
      LineStart := SendMessageA(RichEdit1.Handle, EM_LINEINDEX, InsAt, 0);
      if LineStart < 0 then
      begin
        TextChanged;
        Exit;
      end;
      EditorFreeze;
      try
        RichEdit1.SelStart := LineStart;
        RichEdit1.SelLength := 0;
        RichEdit1.SelText := NewLine + #13#10;
      finally
        EditorThaw;
      end;
      LogComp('Инспектор RapidQ: ' + Obj.Name + ' - добавлена строка ' +
              IntToStr(InsAt + 1) + ': ' + Trim(NewLine));
    end;
    // Узлы и номера строк - заново по тексту; выделение вернётся на этот
    // объект и свойство
    ObjScheduleRelines(Obj, FObjEditName);
  finally
    Dec(FObjOwnWrite);
  end;
end;

// ---------------------------------------------------------------------------
//  Конструктор форм RapidQ
//
//  Форма из блоков CREATE открывается тем же TFormDesigner, что и формы
//  Delphi, но своим экземпляром (FRqDesigner): из узлов CREATE строится
//  текст в формате .dfm (RqDsgBuildDfm), компоненты в нём - заглушки
//  TRqShape (RqDesign.pas), которые рисуют себя по RapidQ-классу.
//
//  Значение свойства для показа (RqDsgValue): число или строка в кавычках
//  из блока CREATE; выражение там или свойства в блоке нет - значение из
//  снимка; нет и снимка - значение по умолчанию из описания классов.
//  Место и размер, которые в блоке заданы выражением, конструктор
//  меняет так же, как числа: строка с выражением закомментируется, под ней
//  пишется число (RqReplaceExprLine). Место формы - не трогается.
//
//  Связи:
//    - щелчок по компоненту в конструкторе выделяет его узел в дереве
//      объектов, выбор в дереве - компонент в конструкторе; узел другой
//      формы - конструктор показывает ту форму;
//    - перемещение и изменение размера пишутся в блок CREATE: значение в
//      строке присваивания или новое присваивание в блоке (RqDsgSetProp);
//    - правка в инспекторе и любая правка текста: после разбора форма
//      строится заново, если её текст .dfm изменился (RqDsgSync).
// ---------------------------------------------------------------------------

// Названия вкладок QTABCONTROL ANode через #10, по тексту ALines:
// AddTabs "a", "b" и Tab(n) = "x" в его блоке CREATE (сам блок, не
// вложенные), Имя.AddTabs и Имя.Tab(n) = в остальном тексте - по порядку
// строк. Название-выражение - "?". Нет ни одного - ''.
function RqDsgTabNames(ALines: TStrings; ANode: TDfmNode): string;
var
  Names, Parts: TStringList;
  LineIdx, PartIdx, Depth, WordEnd: Integer;
  Stmt, Head, Rest, Prefix, Tail: string;
  InBlock: Boolean;

  // Аргументы AddTabs: "a", "b" или ("a", "b")
  procedure AddArgs(const AArgs: string);
  var
    Args: string;
    CharIdx, StartAt: Integer;
    InQuote: Boolean;

    procedure TakeArg(AEnd: Integer);
    var
      Arg, ArgText: string;
    begin
      Arg := Trim(Copy(Args, StartAt, AEnd - StartAt));
      if Arg = '' then
        Exit;
      if RapidQUnquote(Arg, ArgText) then
        Names.Add(ArgText)
      else
        Names.Add('?');
    end;

  begin
    Args := Trim(AArgs);
    if (Length(Args) >= 2) and (Args[1] = '(') and
       (Args[Length(Args)] = ')') then
      Args := Copy(Args, 2, Length(Args) - 2);
    InQuote := False;
    StartAt := 1;
    for CharIdx := 1 to Length(Args) do
      if Args[CharIdx] = '"' then
        InQuote := not InQuote
      else if (Args[CharIdx] = ',') and not InQuote then
      begin
        TakeArg(CharIdx);
        StartAt := CharIdx + 1;
      end;
    TakeArg(Length(Args) + 1);
  end;

// Tab(n) = "x": ARest - то, что после Tab
  procedure SetTab(const ARest: string);
  var
    CloseAt, TabNum, Code: Integer;
    After, TabText: string;
  begin
    CloseAt := Pos(')', ARest);
    if (Copy(ARest, 1, 1) <> '(') or (CloseAt = 0) then
      Exit;
    Val(Trim(Copy(ARest, 2, CloseAt - 2)), TabNum, Code);
    if (Code <> 0) or (TabNum < 0) or (TabNum > 255) then
      Exit;
    After := Trim(Copy(ARest, CloseAt + 1, MaxInt));
    if Copy(After, 1, 1) <> '=' then
      Exit;
    if not RapidQUnquote(Trim(Copy(After, 2, MaxInt)), TabText) then
      TabText := '?';
    while Names.Count <= TabNum do
      Names.Add('');
    Names[TabNum] := TabText;
  end;

begin
  Result := '';
  Names := TStringList.Create;
  Parts := TStringList.Create;
  try
    Prefix := UpperCase(ANode.Name) + '.';
    Depth := 0;
    for LineIdx := 0 to ALines.Count - 1 do
    begin
      InBlock := (LineIdx >= ANode.CreateLine) and (LineIdx <= ANode.EndLine);
      if not InBlock and
         (Pos(Prefix, UpperCase(ALines[LineIdx])) = 0) then
        Continue;
      RapidQSplitStatements(ALines[LineIdx], Parts);
      for PartIdx := 0 to Parts.Count - 1 do
      begin
        Stmt := Parts[PartIdx];
        WordEnd := 1;
        while (WordEnd <= Length(Stmt)) and
              (Stmt[WordEnd] in ['A'..'Z', 'a'..'z', '0'..'9', '_', '.']) do
          Inc(WordEnd);
        Head := UpperCase(Copy(Stmt, 1, WordEnd - 1));
        Rest := Trim(Copy(Stmt, WordEnd, MaxInt));
        if Head = 'REM' then
          Break;
        if InBlock then
        begin
          // Глубина: 1 - сам блок, больше - вложенные CREATE
          if Head = 'CREATE' then
          begin
            Inc(Depth);
            Continue;
          end;
          if (Head = 'END') and (RapidQFirstWord(Rest, Tail) = 'CREATE') then
          begin
            Dec(Depth);
            Continue;
          end;
          if Depth <> 1 then
            Continue;
          if Head = 'ADDTABS' then
            AddArgs(Rest)
          else if Head = 'TAB' then
            SetTab(Rest);
        end
        else if Head = Prefix + 'ADDTABS' then
          AddArgs(Rest)
        else if Head = Prefix + 'TAB' then
          SetTab(Rest);
      end;
    end;
    for LineIdx := 0 to Names.Count - 1 do
    begin
      if LineIdx > 0 then
        Result := Result + #10;
      Result := Result + Names[LineIdx];
    end;
  finally
    Parts.Free;
    Names.Free;
  end;
end;

// Узел с именем AName среди узлов инспектора; nil - нет
function TForm1.RqDsgNodeByName(const AName: string): TObject;
var
  NodeIdx: Integer;
begin
  Result := nil;
  if FDfmNodes = nil then
    Exit;
  for NodeIdx := 0 to FDfmNodes.Count - 1 do
    if CompareText(TDfmNode(FDfmNodes[NodeIdx]).Name, AName) = 0 then
    begin
      Result := TDfmNode(FDfmNodes[NodeIdx]);
      Exit;
    end;
end;

// Форма, на которой лежит ANode: ближайший предок (или он сам) класса
// QFORM. nil - узел не на форме.
function TForm1.RqDsgFormOf(AObj: TObject): TObject;
var
  Node: TDfmNode;
begin
  Node := TDfmNode(AObj);
  while (Node <> nil) and not RqDsgIsForm(Node.ClassNm) do
    Node := Node.Parent;
  Result := Node;
end;

// Значение свойства AProp узла ANode для показа. ASource: 0 - не нашлось,
// 1 - из текста, 2 - из снимка, 3 - по умолчанию. ACodeSet - в тексте оно
// задано выражением.
function TForm1.RqDsgValue(AObj: TObject; const AProp: string;
                           var ASource: Integer;
                           var ACodeSet: Boolean): string;
var
  ANode: TDfmNode;
  PropIdx, Num: Integer;
  Raw, Unquoted: string;
  Member: TRqMember;
  Live: TStringList;
  Chain: TList;
begin
  ANode := TDfmNode(AObj);
  Result := '';
  ASource := 0;
  ACodeSet := False;
  Member := RapidQMemberOf(ANode, AProp);
  // Последнее присваивание в блоке - оно и действует
  for PropIdx := ANode.PropN.Count - 1 downto 0 do
    if CompareText(ANode.PropN[PropIdx], AProp) = 0 then
    begin
      Raw := Trim(ANode.PropV[PropIdx]);
      if RapidQUnquote(Raw, Unquoted) then
      begin
        Result := Unquoted;
        ASource := 1;
        Exit;
      end;
      if RqDsgNumber(Member, Raw, Num) then
      begin
        Result := IntToStr(Num);
        ASource := 1;
        Exit;
      end;
      ACodeSet := True;
      Break;
    end;
  Live := RapidQLiveProps(ANode.Name);
  if (Live <> nil) and (Live.IndexOfName(AProp) >= 0) then
  begin
    Result := Live.Values[AProp];
    ASource := 2;
    Exit;
  end;
  Chain := TList.Create;
  try
    RqClassChain(ANode.ClassNm, Chain);
    Result := RqDefaultOf(Chain, AProp, Member);
  finally
    Chain.Free;
  end;
  if Result <> '' then
  begin
    // По умолчанию в описании - "" у строк
    if RapidQUnquote(Result, Unquoted) then
      Result := Unquoted;
    ASource := 3;
  end;
end;

// Значение свойства числом; не нашлось или не число - ADefault
function TForm1.RqDsgNum(AObj: TObject; const AProp: string;
                         ADefault: Integer; var ASource: Integer;
                         var ACodeSet: Boolean): Integer;
var
  Raw: string;
begin
  Raw := RqDsgValue(AObj, AProp, ASource, ACodeSet);
  if (ASource = 0) or
     not RqDsgNumber(RapidQMemberOf(TDfmNode(AObj), AProp), Raw, Result) then
  begin
    Result := ADefault;
    ASource := 0;
  end;
end;

// Файл ресурса AResName по строке "$RESOURCE Имя AS "файл"" в ALines; нет
// такой строки - ''
function RqDsgResourceFile(ALines: TStrings; const AResName: string): string;
var
  LineIdx, QuotePos: Integer;
  Rest: string;
begin
  Result := '';
  if AResName = '' then
    Exit;
  for LineIdx := 0 to ALines.Count - 1 do
  begin
    Rest := Trim(ALines[LineIdx]);
    if CompareText(Copy(Rest, 1, 9), '$RESOURCE') <> 0 then
      Continue;
    Rest := TrimLeft(Copy(Rest, 10, MaxInt));
    if CompareText(Copy(Rest, 1, Length(AResName)), AResName) <> 0 then
      Continue;
    Rest := Copy(Rest, Length(AResName) + 1, MaxInt);
    if (Rest = '') or not (Rest[1] in [' ', #9]) then
      Continue;
    Rest := TrimLeft(Rest);
    if (CompareText(Copy(Rest, 1, 2), 'AS') <> 0) or (Length(Rest) < 3) or
       not (Rest[3] in [' ', #9, '"']) then
      Continue;
    Rest := TrimLeft(Copy(Rest, 3, MaxInt));
    if (Rest = '') or (Rest[1] <> '"') then
      Continue;
    QuotePos := Pos('"', Copy(Rest, 2, MaxInt));
    if QuotePos > 0 then
    begin
      Result := Copy(Rest, 2, QuotePos - 1);
      Exit;
    end;
  end;
end;

// Текст .dfm формы ARoot (узел QFORM). ACodePlaced - строки "имя=буквы":
// какие из Left, Top, Width, Height заданы в блоке выражением.
function TForm1.RqDsgBuildDfm(ARootObj: TObject; ACodePlaced: TStrings): string;
const
  AlignNames: array[0..5] of string = ('alNone', 'alTop', 'alBottom',
  'alLeft', 'alRight', 'alClient');
                                       BorderNames: array[0..5] of string = ('bsNone', 'bsSingle', 'bsSizeable',
  'bsDialog', 'bsToolWindow',
  'bsSizeToolWin');
                                                                             var
                                                                             Output, NonVisual, Seen: TStringList;
                                                                             Target: TStringList;    // куда пишет Put: Output или (меню) NonVisual
                                                                             TextLines: TStringList; // текст файла: вызовы AddTabs вне свойств
                                                                             MainMenuName: string;
                                                                             NonVisCount: Integer;

  // Строка .dfm с отступом
  procedure Put(const AIndent, AText: string);
  begin
    Target.Add(AIndent + AText);
  end;

// Строковое свойство: из текста или снимка (по умолчанию - не пишется)
  procedure PutStr(ANode: TDfmNode; const AIndent, AProp, ADfmProp: string);
  var
    Source: Integer;
    CodeSet: Boolean;
    Value: string;
  begin
    Value := RqDsgValue(ANode, AProp, Source, CodeSet);
    if (Source = 1) or (Source = 2) then
      Put(AIndent, ADfmProp + ' = ' + RqDsgDfmString(Value));
  end;

// Числовое свойство: из текста или снимка
  procedure PutNum(ANode: TDfmNode; const AIndent, AProp, ADfmProp: string);
  var
    Source, Num: Integer;
    CodeSet: Boolean;
  begin
    Num := RqDsgNum(ANode, AProp, 0, Source, CodeSet);
    if (Source = 1) or (Source = 2) then
      Put(AIndent, ADfmProp + ' = ' + IntToStr(Num));
  end;

// Шрифт: имя, размер, цвет - из текста или снимка
  procedure PutFont(ANode: TDfmNode; const AIndent: string);
  begin
    PutStr(ANode, AIndent, 'Font.Name', 'Font.Name');
    PutNum(ANode, AIndent, 'Font.Size', 'Font.Size');
    PutNum(ANode, AIndent, 'Font.Color', 'Font.Color');
  end;

// Место и размер: значение есть всегда (умолчание - ADefW x ADefH);
// заданное выражением - буквой в ACodePlaced
  procedure PutBounds(ANode: TDfmNode; const AIndent: string;
                      ADefLeft, ADefTop, ADefW, ADefH: Integer;
                      AOwnPlace: Boolean);
  const
    BoundNames: array[0..3] of string = ('Left', 'Top', 'Width', 'Height');
    BoundLetters: array[0..3] of Char = ('L', 'T', 'W', 'H');
    ClientNames: array[0..3] of string = ('', '', 'ClientWidth',
    'ClientHeight');
                                          var
                                          BoundIdx, Source, ClientSource, Num: Integer;
                                          CodeSet: Boolean;
                                          Letters: string;
                                          Defaults: array[0..3] of Integer;
  begin
    Defaults[0] := ADefLeft;
    Defaults[1] := ADefTop;
    Defaults[2] := ADefW;
    Defaults[3] := ADefH;
    Letters := '';
    for BoundIdx := 0 to 3 do
    begin
      Num := RqDsgNum(ANode, BoundNames[BoundIdx], Defaults[BoundIdx], Source,
                      CodeSet);
      // Место формы, которого нет ни в тексте, ни в снимке, - своё, а не 0
      // из описания класса
      if AOwnPlace and (BoundIdx < 2) and (Source = 3) then
        Num := Defaults[BoundIdx];
      // Выражение сторону не запирает: тянут - RqDsgSetProp
      // закомментирует строку с выражением и запишет под ней число
      // Ширина и высота 0 - окно не увидеть и не взять мышью. У классов
      // программы поле Width бывает своё (QToolBarEX: 0), а размер окна -
      // в ClientWidth / ClientHeight базового класса. Такой размер
      // конструктор не меняет: в Width записалось бы не то.
      if (BoundIdx >= 2) and (Num <= 0) then
      begin
        Num := RqDsgNum(ANode, ClientNames[BoundIdx], 0, ClientSource,
                        CodeSet);
        if Num <= 0 then
          Num := Defaults[BoundIdx]
        else if Pos(BoundLetters[BoundIdx], Letters) = 0 then
          Letters := Letters + BoundLetters[BoundIdx];
      end;
      Put(AIndent, BoundNames[BoundIdx] + ' = ' + IntToStr(Num));
    end;
    if Letters <> '' then
      ACodePlaced.Add(ANode.Name + '=' + Letters);
  end;

// Компонент годится для .dfm: имя - идентификатор, второго такого нет
  function Usable(ANode: TDfmNode): Boolean;
  begin
    Result := RqDsgNameOk(ANode.Name) and (ANode.ClassNm <> '') and
              (Seen.IndexOf(ANode.Name) < 0);
    if Result then
      Seen.Add(ANode.Name);
  end;

// Пункты меню AMenu - вложенными объектами TMenuItem
  procedure PutMenuItems(AMenu: TDfmNode; const AIndent: string);
  var
    ChildIdx: Integer;
    Child: TDfmNode;
  begin
    for ChildIdx := 0 to AMenu.Children.Count - 1 do
    begin
      Child := TDfmNode(AMenu.Children[ChildIdx]);
      if (RqDsgMenuKind(Child.ClassNm) <> 3) or not Usable(Child) then
        Continue;
      Put(AIndent, 'object ' + Child.Name + ': TMenuItem');
      PutStr(Child, AIndent + '  ', 'Caption', 'Caption');
      PutMenuItems(Child, AIndent + '  ');
      Put(AIndent, 'end');
    end;
  end;

// Невизуальный или меню - в список корня (в .dfm они лежат на форме)
  procedure AddNonVisual(ANode: TDfmNode);
  var
    MenuKind: Integer;
  begin
    if not Usable(ANode) then
      Exit;
    MenuKind := RqDsgMenuKind(ANode.ClassNm);
    case MenuKind of
      1, 2:
      begin
        if MenuKind = 1 then
        begin
          NonVisual.Add('  object ' + ANode.Name + ': TMainMenu');
          if MainMenuName = '' then
            MainMenuName := ANode.Name;
        end
        else
          NonVisual.Add('  object ' + ANode.Name + ': TPopupMenu');
        // Значок меню - в ряд со значками невизуальных
        NonVisual.Add('    Left = ' + IntToStr(8 + NonVisCount * 32));
        NonVisual.Add('    Top = 8');
        Inc(NonVisCount);
        Target := NonVisual;
        try
          PutMenuItems(ANode, '    ');
        finally
          Target := Output;
        end;
        NonVisual.Add('  end');
      end;
      3: ; // пункт меню вне меню - не показывается
    else
      begin
        // Класс RapidQ - именем класса: так его подписывает значок
        NonVisual.Add('  object ' + ANode.Name + ': ' + ANode.ClassNm);
        NonVisual.Add('    Left = ' + IntToStr(8 + NonVisCount * 32));
        NonVisual.Add('    Top = 8');
        Inc(NonVisCount);
        NonVisual.Add('  end');
      end;
    end;
  end;

// Файл картинки кнопки: BMP = "файл" или BMPHandle = Имя и в файле
// $RESOURCE Имя AS "файл". Путь без диска - от папки файла формы. Файла
// нет - ''.
  function PictureFile(ANode: TDfmNode): string;
  var
    PropIdx: Integer;
    Raw, Unquoted: string;
  begin
    Result := '';
    for PropIdx := ANode.PropN.Count - 1 downto 0 do
    begin
      Raw := Trim(ANode.PropV[PropIdx]);
      if CompareText(ANode.PropN[PropIdx], 'BMP') = 0 then
      begin
        if RapidQUnquote(Raw, Unquoted) then
          Result := Unquoted;
        Break;
      end;
      if CompareText(ANode.PropN[PropIdx], 'BMPHandle') = 0 then
      begin
        Result := RqDsgResourceFile(TextLines, Raw);
        Break;
      end;
    end;
    if Result = '' then
      Exit;
    if (ExtractFileDrive(Result) = '') and (Copy(Result, 1, 1) <> '') and
       (Copy(Result, 1, 1) <> '/') then
      Result := ExtractFilePath(FRqDsgFile) + Result;
    if not FileExists(Result) then
      Result := '';
  end;

// Визуальный компонент ANode и его дети
  procedure PutShape(ANode: TDfmNode; const AIndent: string);
  var
    ChildIdx, Source, Num: Integer;
    CodeSet: Boolean;
    Child: TDfmNode;
    Inner, TabNames, BmpFile: string;
    Kind: TRqKind;
  begin
    Inner := AIndent + '  ';
    Put(AIndent, 'object ' + ANode.Name + ': TRqShape');
    Put(Inner, 'RqClass = ' + RqDsgDfmString(ANode.ClassNm));
    Kind := RqDsgKindOf(ANode.ClassNm);
    if Kind in [rkCheck, rkRadio, rkLabel] then
      PutBounds(ANode, Inner, 8, 8, 97, 17, False)
    else if Kind in [rkPanel, rkGroup, rkScrollBox, rkTab, rkMemo] then
      PutBounds(ANode, Inner, 8, 8, 185, 105, False)
    else
      PutBounds(ANode, Inner, 8, 8, 75, 25, False);
    // Align - и по умолчанию класса (QSTATUSBAR - alBottom)
    Num := RqDsgNum(ANode, 'Align', 0, Source, CodeSet);
    if (Source in [1, 2, 3]) and (Num >= 1) and (Num <= 5) then
      Put(Inner, 'Align = ' + AlignNames[Num]);
    PutStr(ANode, Inner, 'Caption', 'Caption');
    PutStr(ANode, Inner, 'Text', 'RqText');
    PutNum(ANode, Inner, 'Color', 'Color');
    PutFont(ANode, Inner);
    Num := RqDsgNum(ANode, 'Checked', 0, Source, CodeSet);
    if (Source in [1, 2]) and (Num <> 0) then
      Put(Inner, 'Checked = True');
    PutNum(ANode, Inner, 'BevelOuter', 'RqBevelOuter');
    PutNum(ANode, Inner, 'BevelInner', 'RqBevelInner');
    PutNum(ANode, Inner, 'BorderStyle', 'RqBorderStyle');
    PutNum(ANode, Inner, 'Alignment', 'RqAlignment');
    // Метка - текст по высоте; кнопки - картинка относительно текста
    if Kind in [rkLabel, rkButton, rkOval] then
      PutNum(ANode, Inner, 'Layout', 'RqLayout');
    if Kind in [rkButton, rkOval] then
    begin
      PutNum(ANode, Inner, 'Spacing', 'RqSpacing');
      PutNum(ANode, Inner, 'NumBMPs', 'RqNumBmps');
      BmpFile := PictureFile(ANode);
      if BmpFile <> '' then
        Put(Inner, 'RqBmpFile = ' + RqDsgDfmString(BmpFile));
    end;
    if Kind = rkTab then
    begin
      TabNames := RqDsgTabNames(TextLines, ANode);
      if TabNames <> '' then
        Put(Inner, 'RqTabs = ' + RqDsgDfmString(TabNames));
      PutNum(ANode, Inner, 'TabIndex', 'RqTabIndex');
      PutNum(ANode, Inner, 'TabHeight', 'RqTabHeight');
      PutNum(ANode, Inner, 'TabWidth', 'RqTabWidth');
      PutNum(ANode, Inner, 'TabInactiveColor', 'RqTabColor');
    end
    else if Kind = rkScrollBar then
    begin
      PutNum(ANode, Inner, 'Kind', 'RqKind');
      PutNum(ANode, Inner, 'Position', 'RqPosition');
      PutNum(ANode, Inner, 'Min', 'RqMin');
      PutNum(ANode, Inner, 'Max', 'RqMax');
      PutNum(ANode, Inner, 'PageSize', 'RqPageSize');
    end;
    Num := RqDsgNum(ANode, 'Enabled', 1, Source, CodeSet);
    if (Source in [1, 2]) and (Num = 0) then
      Put(Inner, 'RqDisabled = True');
    Num := RqDsgNum(ANode, 'Visible', 1, Source, CodeSet);
    if (Source in [1, 2]) and (Num = 0) then
      Put(Inner, 'Visible = False');
    for ChildIdx := 0 to ANode.Children.Count - 1 do
    begin
      Child := TDfmNode(ANode.Children[ChildIdx]);
      if RqDsgIsVisual(Child.ClassNm) and not RqDsgIsForm(Child.ClassNm) then
      begin
        if Usable(Child) then
          PutShape(Child, Inner);
      end
      else if not RqDsgIsForm(Child.ClassNm) then
        AddNonVisual(Child);
    end;
    Put(AIndent, 'end');
  end;

var
  ARoot, Child: TDfmNode;
  ChildIdx, Source, Num, BodyStart: Integer;
  CodeSet: Boolean;
  RootLines: TStringList;
begin
  ARoot := TDfmNode(ARootObj);
  Output := TStringList.Create;
  NonVisual := TStringList.Create;
  Seen := TStringList.Create;
  RootLines := TStringList.Create;
  TextLines := TStringList.Create;
  try
    TextLines.Text := GetEditorTextCR;
    Target := Output;
    MainMenuName := '';
    NonVisCount := 0;
    Seen.Add(ARoot.Name);
    // Сначала дети: так становится известно главное меню формы, а его имя
    // нужно в свойствах корня
    for ChildIdx := 0 to ARoot.Children.Count - 1 do
    begin
      Child := TDfmNode(ARoot.Children[ChildIdx]);
      if RqDsgIsForm(Child.ClassNm) then
        Continue;
      if RqDsgIsVisual(Child.ClassNm) then
      begin
        if Usable(Child) then
          PutShape(Child, '  ');
      end
      else
        AddNonVisual(Child);
    end;
    RootLines.AddStrings(Output);
    Output.Clear;

    Put('', 'object ' + ARoot.Name + ': TForm');
    // Где форма на экране: из текста или снимка; нет - рядом с редактором
    PutBounds(ARoot, '  ', Left + 80, Top + 80, 320, 240, True);
    PutNum(ARoot, '  ', 'ClientWidth', 'ClientWidth');
    PutNum(ARoot, '  ', 'ClientHeight', 'ClientHeight');
    PutStr(ARoot, '  ', 'Caption', 'Caption');
    PutNum(ARoot, '  ', 'Color', 'Color');
    PutFont(ARoot, '  ');
    Num := RqDsgNum(ARoot, 'BorderStyle', 2, Source, CodeSet);
    if (Source in [1, 2]) and (Num >= 0) and (Num <= 5) then
      Put('  ', 'BorderStyle = ' + BorderNames[Num]);
    if MainMenuName <> '' then
      Put('  ', 'Menu = ' + MainMenuName);
    // Место и размер формы не трогаются из кода: их и так задаёт окно
    // конструктора. Буквы корня - не нужны.
    BodyStart := ACodePlaced.IndexOfName(ARoot.Name);
    if BodyStart >= 0 then
      ACodePlaced.Delete(BodyStart);
    Output.AddStrings(RootLines);
    Output.AddStrings(NonVisual);
    Put('', 'end');
    Result := Output.Text;
  finally
    TextLines.Free;
    RootLines.Free;
    Seen.Free;
    NonVisual.Free;
    Output.Free;
  end;
end;

// Класс, которого нет среди классов редактора: в тексте .dfm это
// невизуальный компонент RapidQ (QTIMER), показывается значком
function TForm1.RqDsgMapClass(const AClassName: string): TComponentClass;
begin
  Result := TRqNonVis;
end;

// Построить форму FRqDsgForm заново и показать. AKeepPlace - на том же
// месте экрана, где была.
procedure TForm1.RqDsgLoad(AKeepPlace: Boolean);
var
  Root, Sel: TDfmNode;
  Txt, Err, SelName: string;
  CodePlaced: TStringList;
  PlaceIdx, PosLeft, PosTop: Integer;
  Comp: TComponent;
  HadPlace, LoadOk: Boolean;
  FocusWnd: HWND;
begin
  Root := TDfmNode(RqDsgNodeByName(FRqDsgForm));
  if (Root = nil) or (FRqDesigner = nil) then
    Exit;
  CodePlaced := TStringList.Create;
  try
    Txt := RqDsgBuildDfm(Root, CodePlaced);
    HadPlace := AKeepPlace and (FRqDesigner.Form <> nil);
    PosLeft := 0;
    PosTop := 0;
    if HadPlace then
    begin
      PosLeft := FRqDesigner.Form.Left;
      PosTop := FRqDesigner.Form.Top;
    end;
    SelName := FRqDesigner.SelectedName;
    FocusWnd := Windows.GetFocus;
    // Load сам возвращает прежнее выделение - дерево при этом не трогаем
    FRqDsgSelecting := True;
    try
      LoadOk := FRqDesigner.Load(Txt, Err, True);
    finally
      FRqDsgSelecting := False;
    end;
    if not LoadOk then
    begin
      LogComp('Конструктор RapidQ: форму ' + FRqDsgForm + ' не удалось ' +
      'построить: ' + Err);
              Exit;
    end;
    FRqDsgLastDfm := Txt;
    if HadPlace then
    begin
      FRqDesigner.Form.Left := PosLeft;
      FRqDesigner.Form.Top := PosTop;
    end;
    for PlaceIdx := 0 to CodePlaced.Count - 1 do
    begin
      Comp := FRqDesigner.Form.FindComponent(CodePlaced.Names[PlaceIdx]);
      if Comp <> nil then
        FRqDesigner.MarkCodePlaced(Comp, CodePlaced.ValueFromIndex[PlaceIdx]);
    end;
    FRqDesigner.ShowForm;
    // Выделение - то, что было, или узел, выбранный в дереве
    Sel := TDfmNode(FObjCurNode);
    FRqDsgSelecting := True;
    try
      if (Sel <> nil) and (RqDsgFormOf(Sel) = Root) then
        FRqDesigner.SelectByName(Sel.Name)
      else if SelName <> '' then
        FRqDesigner.SelectByName(SelName);
    finally
      FRqDsgSelecting := False;
    end;
    // Перестроение после правки в инспекторе фокус у инспектора не отнимает
    if AKeepPlace and (FocusWnd <> 0) and IsWindow(FocusWnd) then
      Windows.SetFocus(FocusWnd);
  finally
    CodePlaced.Free;
  end;
end;

// Design Form у файла RapidQ: форма выбранного в дереве узла, нет такой -
// первая форма файла
procedure TForm1.RqDsgOpen;
var
  Root, Node: TDfmNode;
  NodeIdx: Integer;
begin
  if not RapidQComponentsReady(True) then
  begin
    ShowMessage('Нет описания компонентов RapidQ (ComponentAll.data) - ' +
    'форму не из чего построить. Где искали - в логе.');
                Exit;
  end;
  // Узлы - этого файла: инспектор мог показывать другой
  if not FObjRapidQ or (FDfmNodes = nil) or (FDfmNodes.Count = 0) then
  begin
    if FRightPages <> nil then
      FRightPages.ActivePage := FTabObjects;
    RefreshObjectInspector(True);
  end;
  Root := nil;
  if FObjCurNode <> nil then
    Root := TDfmNode(RqDsgFormOf(FObjCurNode));
  if (Root = nil) and (FDfmNodes <> nil) then
    for NodeIdx := 0 to FDfmNodes.Count - 1 do
    begin
      Node := TDfmNode(FDfmNodes[NodeIdx]);
      if RqDsgIsForm(Node.ClassNm) and RqDsgNameOk(Node.Name) then
      begin
        Root := Node;
        Break;
      end;
    end;
  if Root = nil then
  begin
    ShowMessage('В файле нет блока CREATE ... AS QFORM - конструктору ' +
    'нечего показать.');
                Exit;
  end;
  if FRqDesigner = nil then
  begin
    FRqDesigner := TFormDesigner.Create;
    FRqDesigner.OnSelect := RqDsgSelect;
    FRqDesigner.OnChange := RqDsgChange;
    FRqDesigner.OnClose := RqDsgClose;
    FRqDesigner.OnDblClick := RqDsgDblClick;
    FRqDesigner.OnMapClass := RqDsgMapClass;
    FRqDesigner.OnPlace := RqDsgPlace;
    FRqDesigner.OnContext := RqDsgContext;
    FRqDesigner.OnKey := RqDsgKey;
    EnvApplyDesigner(FRqDesigner);   // IDE Options - Designer
  end;
  FRqDsgFile := FCurrentFileName;
  FRqDsgForm := Root.Name;
  RqDsgLoad(False);
  // Палитра - на страницы RapidQ, если открыта другая
  if (FDsgPalette <> nil) and
     ((FDsgPalette.PageIndex < FRqPalPage) or
      (FDsgPalette.PageIndex > FRqPalLast)) then
    FDsgPalette.SetPage(FRqPalPage);
  LogComp('Конструктор RapidQ: форма ' + Root.Name + ' (строка ' +
          IntToStr(Root.CreateLine + 1) + ')');
end;

// После разбора текста (RefreshRapidQInspector): форма конструктора - по
// новым узлам. Текст .dfm тот же - ничего не делается; правка пришла из
// самого конструктора - он её уже показывает.
procedure TForm1.RqDsgSync;
var
  Root: TDfmNode;
  CodePlaced: TStringList;
  Txt: string;
begin
  if (FRqDesigner = nil) or (FRqDesigner.Form = nil) or
     (CompareText(FCurrentFileName, FRqDsgFile) <> 0) then
    Exit;
  Root := TDfmNode(RqDsgNodeByName(FRqDsgForm));
  if Root = nil then
    Exit;
  if FRqDsgOwnWrite then
  begin
    FRqDsgOwnWrite := False;
    CodePlaced := TStringList.Create;
    try
      FRqDsgLastDfm := RqDsgBuildDfm(Root, CodePlaced);
    finally
      CodePlaced.Free;
    end;
    Exit;
  end;
  CodePlaced := TStringList.Create;
  try
    Txt := RqDsgBuildDfm(Root, CodePlaced);
  finally
    CodePlaced.Free;
  end;
  if Txt = FRqDsgLastDfm then
    Exit;
  RqDsgLoad(True);
end;

// Выбрали узел в дереве: компонент - и в конструкторе; узел другой формы -
// конструктор показывает ту форму
procedure TForm1.RqDsgShowNode(AObj: TObject);
var
  ANode, Root: TDfmNode;
begin
  ANode := TDfmNode(AObj);
  if (FRqDesigner = nil) or (FRqDesigner.Form = nil) or FRqDsgSelecting or
     (ANode = nil) or (CompareText(FCurrentFileName, FRqDsgFile) <> 0) then
    Exit;
  Root := TDfmNode(RqDsgFormOf(ANode));
  if Root = nil then
    Exit;
  if CompareText(Root.Name, FRqDsgForm) <> 0 then
  begin
    if not RqDsgNameOk(Root.Name) then
      Exit;
    FRqDsgForm := Root.Name;
    RqDsgLoad(True);
    Exit;
  end;
  FRqDsgSelecting := True;
  try
    FRqDesigner.SelectByName(ANode.Name);
  finally
    FRqDsgSelecting := False;
  end;
end;

procedure TForm1.RqDsgSelect(const AName: string);
begin
  if FRqDsgSelecting then
    Exit;
  FRqDsgSelecting := True;
  try
    ObjSelectAnyName(AName);
  finally
    FRqDsgSelecting := False;
  end;
end;

// Двойной щелчок по компоненту: к его строке CREATE
procedure TForm1.RqDsgDblClick(const AName: string);
var
  Node: TDfmNode;
begin
  Node := TDfmNode(RqDsgNodeByName(AName));
  if (Node <> nil) and (Node.CreateLine >= 0) and
     (CompareText(FCurrentFileName, FRqDsgFile) = 0) then
    GotoLine(Node.CreateLine);
end;

procedure TForm1.RqDsgClose(Sender: TObject);
begin
  PostMessage(Handle, WM_USER + 322, 0, 0);
end;

procedure TForm1.WMRqDsgClosed(var Msg: TMessage);
begin
  FreeAndNil(FRqDesigner);
  FRqDsgLastDfm := '';
end;

// Присваивание с выражением в строке LineNo (текст ACurLine, начало в
// редакторе ALineStart, значение - ACurLine[AValStart..+AValLen]) - на
// значение ANewValue, а прежнее остаётся строкой-комментарием над ней:
//     'Width=DesignPan.ClientWidth-500
//     Width=812
// Комментарий - с тем же отступом, только сам оператор (другие операторы
// строки через ":" и её комментарий остаются в строке с новым значением).
// False - перед значением нет "AProp =".
function TForm1.RqReplaceExprLine(ALineNo, ALineStart: Integer;
                                  const ACurLine: string;
                                  AValStart, AValLen: Integer;
                                  const AProp, ANewValue: string): Boolean;
var
  NamePos, NameStart, IndentEnd: Integer;
  OldStmt, Indent: string;
begin
  Result := False;
  NamePos := AValStart - 1;
  while (NamePos >= 1) and (ACurLine[NamePos] in [' ', #9]) do
    Dec(NamePos);
  if (NamePos < 1) or (ACurLine[NamePos] <> '=') then
    Exit;
  Dec(NamePos);
  while (NamePos >= 1) and (ACurLine[NamePos] in [' ', #9]) do
    Dec(NamePos);
  NameStart := NamePos - Length(AProp) + 1;
  if (NameStart < 1) or
     (CompareText(Copy(ACurLine, NameStart, Length(AProp)), AProp) <> 0) then
    Exit;
  OldStmt := Copy(ACurLine, NameStart, AValStart + AValLen - NameStart);
  IndentEnd := 1;
  while (IndentEnd <= Length(ACurLine)) and
        (ACurLine[IndentEnd] in [' ', #9]) do
    Inc(IndentEnd);
  Indent := Copy(ACurLine, 1, IndentEnd - 1);
  EditorFreeze;
  try
    // Сначала значение (позиции в строке ещё прежние), потом строка над ней
    RichEdit1.SelStart := ALineStart + AValStart - 1;
    RichEdit1.SelLength := AValLen;
    RichEdit1.SelText := ANewValue;
    RichEdit1.SelStart := ALineStart;
    RichEdit1.SelLength := 0;
    RichEdit1.SelText := Indent + '''' + OldStmt + #13#10;
  finally
    EditorThaw;
  end;
  LogComp('RapidQ: ' + AProp + ' - было выражение (строка ' +
          IntToStr(ALineNo + 1) + ' закомментирована), записано ' + ANewValue);
  Result := True;
end;

// Присваивание AProp = AValue в блоке CREATE объекта AName (открытый файл):
// есть присваивание с числом - число заменяется; есть с выражением -
// строка с ним закомментируется, под ней - число (RqReplaceExprLine), если
// значение другое, чем показывал конструктор; AKeepExpr - выражение не
// трогается; нет - добавляется (AOnlyIfExists - не добавляется). Номера
// строк - по разбору текста сейчас: предыдущая запись могла их сдвинуть.
function TForm1.RqDsgSetProp(const AName, AProp, AValue: string;
                             AOnlyIfExists, AKeepExpr: Boolean): Boolean;
var
  Lines: TStringList;
  Nodes, Roots: TList;
  Node: TDfmNode;
  NodeIdx, PropIdx, LineNo, LineStart, LineLen, ValStart, ValLen, Num,
    InsAt, NewNum, ShownNum, Source: Integer;
  CurLine, NewLine, LineIndent, EqText, OldText, NewText: string;
  CodeSet: Boolean;
begin
  Result := False;
  // Перевод _rqfb: место и размер - в исходник RapidQ и сюда
  if FRqFbTab then
  begin
    if not AOnlyIfExists and RqFbAskMode then
      Result := RqFbLinkedSet(AName, AProp, AValue, '', False);
    Exit;
  end;
  Lines := TStringList.Create;
  Nodes := TList.Create;
  Roots := TList.Create;
  try
    Lines.Text := GetEditorTextCR;
    RapidQCreateNodes(Lines, Nodes, Roots);
    Node := nil;
    for NodeIdx := 0 to Nodes.Count - 1 do
      if CompareText(TDfmNode(Nodes[NodeIdx]).Name, AName) = 0 then
      begin
        Node := TDfmNode(Nodes[NodeIdx]);
        Break;
      end;
    if (Node = nil) or (Node.CreateLine < 0) or
       (Node.EndLine < Node.CreateLine) then
      Exit;

    PropIdx := -1;
    for NodeIdx := Node.PropN.Count - 1 downto 0 do
      if CompareText(Node.PropN[NodeIdx], AProp) = 0 then
      begin
        PropIdx := NodeIdx;
        Break;
      end;

    if PropIdx >= 0 then
    begin
      // Заменить число в строке присваивания
      LineNo := Integer(Node.PropN.Objects[PropIdx]);
      LineStart := SendMessageA(RichEdit1.Handle, EM_LINEINDEX, LineNo, 0);
      if LineStart < 0 then
        Exit;
      LineLen := SendMessageA(RichEdit1.Handle, EM_LINELENGTH, LineStart, 0);
      CurLine := ReadLineText(LineNo, LineStart, LineLen);
      if not RapidQFindAssign(CurLine, RapidQAssignName(Node, AProp), ValStart,
                              ValLen) then
        Exit;
      OldText := Trim(Copy(CurLine, ValStart, ValLen));
      if RqDsgNumber(RapidQMemberOf(Node, AProp), OldText, Num) then
        NewText := AValue
      else
      begin
        // Выражение ("DesignPan.ClientWidth-500")
        if AKeepExpr then
          Exit;
        // Значение то же, что показывал конструктор (снимок), - не
        // менялось: форму подвинули, а размер прислан вместе с местом
        if TryStrToInt(AValue, NewNum) then
        begin
          ShownNum := RqDsgNum(Node, AProp, Low(Integer), Source, CodeSet);
          if (Source <> 0) and (ShownNum = NewNum) then
          begin
            Result := True;
            Exit;
          end;
        end;
        Result := RqReplaceExprLine(LineNo, LineStart, CurLine, ValStart,
                                    ValLen, RapidQAssignName(Node, AProp),
                                    AValue);
        Exit;
      end;
      if OldText = NewText then
      begin
        Result := True;
        Exit;
      end;
      EditorFreeze;
      try
        RichEdit1.SelStart := LineStart + ValStart - 1;
        RichEdit1.SelLength := ValLen;
        RichEdit1.SelText := NewText;
      finally
        EditorThaw;
      end;
      Result := True;
      Exit;
    end;
    if AOnlyIfExists then
      Exit;

    if (Node.EndLine = Node.CreateLine) and not Node.IsDim then
    begin
      // Блок в одну строку: перед его END CREATE, через ":"
      LineNo := Node.CreateLine;
      LineStart := SendMessageA(RichEdit1.Handle, EM_LINEINDEX, LineNo, 0);
      if LineStart < 0 then
        Exit;
      LineLen := SendMessageA(RichEdit1.Handle, EM_LINELENGTH, LineStart, 0);
      CurLine := ReadLineText(LineNo, LineStart, LineLen);
      if not RapidQInsertBeforeEnd(CurLine, Node.Name,
                                   AProp + RapidQEqStyle(CurLine) + AValue, NewLine) then
        Exit;
      EditorFreeze;
      try
        RichEdit1.SelStart := LineStart;
        RichEdit1.SelLength := LineLen;
        RichEdit1.SelText := NewLine;
      finally
        EditorThaw;
      end;
      Result := True;
      Exit;
    end;

    InsAt := RapidQInsertPlace(Lines, Node, LineIndent, EqText);
    if InsAt < 0 then
      Exit;
    LineStart := SendMessageA(RichEdit1.Handle, EM_LINEINDEX, InsAt, 0);
    if LineStart < 0 then
      Exit;
    EditorFreeze;
    try
      RichEdit1.SelStart := LineStart;
      RichEdit1.SelLength := 0;
      RichEdit1.SelText := LineIndent + RapidQAssignName(Node, AProp) + EqText +
                           AValue + #13#10;
    finally
      EditorThaw;
    end;
    Result := True;
  finally
    for NodeIdx := 0 to Nodes.Count - 1 do
      TObject(Nodes[NodeIdx]).Free;
    Roots.Free;
    Nodes.Free;
    Lines.Free;
  end;
end;

// Конструктор передвинул или растянул компонент: строки "Имя=значение"
// (с "?" в начале - только если присваивание уже есть) - в блок CREATE
procedure TForm1.RqDsgChange(const AName: string; AProps: TStrings);
var
  PropIdx, EqPos, WinIdx: Integer;
  Prop, Value, Written: string;
  OnlyIfExists: Boolean;
  Node: TDfmNode;
begin
  if CompareText(FCurrentFileName, FRqDsgFile) <> 0 then
  begin
    WinIdx := WindowOfFile(FRqDsgFile);
    if WinIdx < 0 then
    begin
      LogComp('Конструктор RapidQ: файла ' + FRqDsgFile + ' нет среди ' +
      'открытых - изменение не записано');
              Exit;
    end;
    ActivateWindow(WinIdx);
  end;
  Node := TDfmNode(RqDsgNodeByName(AName));
  if (Node = nil) or not RqDsgIsVisual(Node.ClassNm) then
    Exit;
  Written := '';
  Inc(FObjOwnWrite);
  try
    for PropIdx := 0 to AProps.Count - 1 do
    begin
      Prop := AProps[PropIdx];
      OnlyIfExists := Copy(Prop, 1, 1) = '?';
      if OnlyIfExists then
        System.Delete(Prop, 1, 1);
      EqPos := Pos('=', Prop);
      if EqPos = 0 then
        Continue;
      Value := Copy(Prop, EqPos + 1, MaxInt);
      Prop := Copy(Prop, 1, EqPos - 1);
      // Место формы на экране - это место окна конструктора: в текст
      // только туда, где оно уже задано
      if CompareText(AName, FRqDsgForm) = 0 then
        OnlyIfExists := True;
      // Окно конструктора подвинули - выражение места формы
      // ((Screen.Width-Width)\2) остаётся
      if RqDsgSetProp(AName, Prop, Value, OnlyIfExists,
                      (CompareText(AName, FRqDsgForm) = 0) and
                      ((CompareText(Prop, 'Left') = 0) or
                       (CompareText(Prop, 'Top') = 0))) then
        Written := Written + ' ' + Prop + '=' + Value;
    end;
  finally
    Dec(FObjOwnWrite);
  end;
  if Written = '' then
    Exit;
  LogComp('Конструктор RapidQ: ' + AName + ':' + Written);
  FRqDsgOwnWrite := True;
  ObjScheduleRelines(RqDsgNodeByName(AName), '');
end;

// Двойной щелчок по событию объекта RapidQ - к SUB или FUNCTION
// обработчика в открытом файле; нет его там (он в $INCLUDE) - к строке,
// где событие назначено.
procedure TForm1.RapidQEventJump;
var
  Lines: TStringList;
  Handler, LineWord, Rest, SubName: string;
  LineIdx, AssignLine, CharIdx: Integer;
begin
  if FObjEvents.Selected = nil then
    Exit;
  // Событие не назначено - обработчик создаётся, как в Delphi
  if Integer(FObjEvents.Selected.Data) < 0 then
  begin
    RapidQEventCreate(FObjEvents.Selected.Caption);
    Exit;
  end;
  if FObjEvents.Selected.SubItems.Count = 0 then
    Exit;
  Handler := Trim(FObjEvents.Selected.SubItems[0]);
  // FreeBASIC: OnClick = @BtnClick
  if Copy(Handler, 1, 1) = '@' then
    Handler := Trim(Copy(Handler, 2, MaxInt));
  AssignLine := Integer(FObjEvents.Selected.Data);
  if Handler = '' then
    Exit;
  Lines := TStringList.Create;
  try
    Lines.Text := GetEditorTextCR;
    for LineIdx := 0 to Lines.Count - 1 do
    begin
      LineWord := RapidQFirstWord(Trim(Lines[LineIdx]), Rest);
      if (LineWord <> 'SUB') and (LineWord <> 'SUBI') and
         (LineWord <> 'FUNCTION') and (LineWord <> 'FUNCTIONI') then
        Continue;
      CharIdx := 1;
      while (CharIdx <= Length(Rest)) and
            (Rest[CharIdx] in ['A'..'Z', 'a'..'z', '0'..'9', '_', '$']) do
        Inc(CharIdx);
      SubName := Copy(Rest, 1, CharIdx - 1);
      if CompareText(SubName, Handler) = 0 then
      begin
        GotoLine(LineIdx);
        Exit;
      end;
    end;
  finally
    Lines.Free;
  end;
  LogComp('Обработчик ' + Handler + ' в ' + ExtractFileName(FCurrentFileName) +
  ' не найден - переход к строке, где он назначен');
          GotoLine(AssignLine);
end;

// ---------------------------------------------------------------------------
//  Перевод RqToFb в папке _rqfb: связь с исходником RapidQ.
//
//  Файл _rqfb пересоздаётся при каждой сборке FB Smart / FB Compat, поэтому
//  во вкладке он только для чтения. Как с ним работать, решает пользователь
//  при первой попытке правки (RqFbAskMode), выбор - в editor.ini
//  [RqFbMode], ключ - главный файл RapidQ:
//    linked - связь с RapidQ: в инспекторе (и в конструкторе) правятся
//             свойства, которые есть в исходнике RapidQ с тем же значением
//             или которых нет ни там, ни здесь; правка пишется в исходник
//             (RqSetPropInEditor на его вкладке) и сразу повторяется в
//             переводе, чтобы он показывал то же до пересборки. Остальное -
//             только чтение;
//    fb|<файл> - переход на FreeBASIC: папка _rqfb скопирована в
//             <главный>_fb рядом с исходником (RqFbDetach), без #line, и
//             дальше это обычные файлы FreeBASIC. Сам _rqfb остаётся
//             переводом - только для чтения.
//  Где в исходнике строка перевода - по директивам #line (RqFbMapLine).
// ---------------------------------------------------------------------------

function TForm1.RqFbIsGenerated(const AFile: string): Boolean;
var
  IsSmart, IsConsole: Boolean;
begin
  Result := (AFile <> '') and
            (CompareText(ExtractFileName(ExcludeTrailingPathDelimiter(
               ExtractFilePath(AFile))), '_rqfb') = 0) and
            RqFbConvertedInfo(AFile, IsSmart, IsConsole);
end;

// Главный файл RapidQ перевода AFile: файл первой директивы #line
function TForm1.RqFbSourceMain(const AFile: string): string;
var
  Src: TextFile;
  LineText: string;
  LineNo, QuotePos: Integer;
begin
  Result := '';
  if not FileExists(AFile) then
    Exit;
  AssignFile(Src, AFile);
  try
    Reset(Src);
    try
      LineNo := 0;
      while not Eof(Src) and (LineNo < 400) do
      begin
        ReadLn(Src, LineText);
        Inc(LineNo);
        LineText := Trim(LineText);
        if CompareText(Copy(LineText, 1, 6), '#line ') <> 0 then
          Continue;
        QuotePos := Pos('"', LineText);
        if QuotePos = 0 then
          Continue;
        Result := Copy(LineText, QuotePos + 1, MaxInt);
        if Pos('"', Result) > 0 then
          Result := Copy(Result, 1, Pos('"', Result) - 1);
        Break;
      end;
    finally
      CloseFile(Src);
    end;
  except
    Result := '';
  end;
end;

function TForm1.RqFbModeGet(const ASrcMain: string): string;
var
  Ini: TIniFile;
begin
  Result := '';
  if (ASrcMain = '') or not FileExists(SettingsFileName) then
    Exit;
  Ini := TIniFile.Create(SettingsFileName);
  try
    Result := Ini.ReadString('RqFbMode', ASrcMain, '');
  finally
    Ini.Free;
  end;
end;

procedure TForm1.RqFbModeSet(const ASrcMain, AMode: string);
var
  Ini: TIniFile;
begin
  if ASrcMain = '' then
    Exit;
  try
    Ini := TIniFile.Create(SettingsFileName);
    try
      Ini.WriteString('RqFbMode', ASrcMain, AMode);
      Ini.UpdateFile;
    finally
      Ini.Free;
    end;
  except
    on E: Exception do
      LogComp('editor.ini не записан: ' + E.Message);
  end;
end;

// Режим работы с переводом активной вкладки. Не выбран - вопрос. True -
// связь с RapidQ (правка свойств идёт в исходник), False - править здесь
// нельзя (отказ или переход на FreeBASIC - открыта копия)
function TForm1.RqFbAskMode: Boolean;
var
  SrcMain, Mode, FbFile: string;
  Dlg: TForm;
  BtnIdx, Answer: Integer;
  Btn: TButton;
begin
  Result := False;
  SrcMain := RqFbSourceMain(FCurrentFileName);
  Mode := RqFbModeGet(SrcMain);
  if Mode = 'linked' then
  begin
    Result := True;
    Exit;
  end;
  if Copy(Mode, 1, 3) = 'fb|' then
  begin
    FbFile := Copy(Mode, 4, MaxInt);
    if MessageDlg('Проект переведён на FreeBASIC: ' + FbFile +
         #13#10#13#10'Этот файл (_rqfb) - перевод исходника RapidQ, он ' +
         'пересоздаётся при сборке и только для чтения. Открыть файл ' +
         'FreeBASIC?', mtInformation, [mbYes, mbNo], 0) = mrYes then
      if FileExists(FbFile) then
        OpenNamedFile(FbFile);
    Exit;
  end;

  Dlg := CreateMessageDialog(
    'Файл ' + ExtractFileName(FCurrentFileName) + ' - перевод исходника ' +
    'RapidQ ' + ExtractFileName(SrcMain) + ' во FreeBASIC. Сборка FB Smart ' +
    'пересоздаёт его каждый раз, правки в нём пропадут.'#13#10#13#10 +
    'Связь с RapidQ - исходником остаётся RapidQ. Перевод только для ' +
    'чтения; в инспекторе правятся свойства, которые можно перенести в ' +
    'исходник RapidQ: правка пишется туда и сразу показывается здесь.'#13#10#13#10 +
    'Перейти на FreeBASIC - перевод копируется в папку ' +
    ChangeFileExt(ExtractFileName(SrcMain), '') + '_fb рядом с исходником ' +
    'и дальше правится как обычный файл FreeBASIC. Исходник RapidQ ' +
    'остаётся как есть и с ним больше не связан.'#13#10#13#10 +
    'Выбор запоминается для ' + ExtractFileName(SrcMain) +
    ' (editor.ini, раздел [RqFbMode]).',
    mtConfirmation, [mbYes, mbNo, mbCancel]);
  try
    Dlg.Caption := 'Перевод RapidQ -> FreeBASIC';
    Dlg.Width := Dlg.Width + 160;
    for BtnIdx := 0 to Dlg.ComponentCount - 1 do
      if Dlg.Components[BtnIdx] is TButton then
      begin
        Btn := TButton(Dlg.Components[BtnIdx]);
        if Btn.ModalResult = mrYes then
        begin
          Btn.Caption := 'Связь с RapidQ';
          Btn.Width := 140;
          Btn.Left := Dlg.ClientWidth - 3 * 150 - 10;
        end
        else if Btn.ModalResult = mrNo then
        begin
          Btn.Caption := 'Перейти на FreeBASIC';
          Btn.Width := 140;
          Btn.Left := Dlg.ClientWidth - 2 * 150 - 10;
        end
        else if Btn.ModalResult = mrCancel then
        begin
          Btn.Width := 140;
          Btn.Left := Dlg.ClientWidth - 150 - 10;
        end;
      end;
    Answer := Dlg.ShowModal;
  finally
    Dlg.Free;
  end;
  if Answer = mrYes then
  begin
    RqFbModeSet(SrcMain, 'linked');
    LogComp('Перевод ' + ExtractFileName(FCurrentFileName) + ': связь с ' +
            'исходником RapidQ ' + SrcMain);
    Result := True;
  end
  else if Answer = mrNo then
    RqFbDetach;
end;

// Попытка набрать или вставить текст во вкладке перевода
procedure TForm1.RqFbEditAttempt;
var
  Mode: string;
begin
  Mode := RqFbModeGet(RqFbSourceMain(FCurrentFileName));
  if Mode = 'linked' then
  begin
    StatusBar1.Panels[0].Text := 'Перевод RapidQ (_rqfb) - только чтение: ' +
      'код правится в исходнике RapidQ, свойства - в инспекторе';
    MessageBeep(MB_OK);
    Exit;
  end;
  RqFbAskMode;
end;

// Переход на FreeBASIC: _rqfb -> <главный>_fb рядом с исходником. В копиях
// .bas/.bi/.inc/.rc убираются #line (ошибки - по самим файлам FreeBASIC),
// пути в _rqfb - на новую папку, заголовок - "отделено от исходника"
// (метка RqToFb (unIDE) остаётся: по ней сборка добавляет папку RqLcl)
function TForm1.RqFbDetach: Boolean;
var
  SrcMain, OldDir, NewDir, NewMain, Ext, LineText, Stamp: string;
  Files, Lines: TStringList;
  FileIdx, LineIdx: Integer;

  procedure Collect(const ADir, ARel: string);
  var
    Found: TSearchRec;
  begin
    if FindFirst(ADir + '*', faAnyFile, Found) = 0 then
    try
      repeat
        if (Found.Name = '.') or (Found.Name = '..') then
          Continue;
        if (Found.Attr and faDirectory) <> 0 then
          Collect(ADir + Found.Name + '\', ARel + Found.Name + '\')
        else
          Files.Add(ARel + Found.Name);
      until FindNext(Found) <> 0;
    finally
      FindClose(Found);
    end;
  end;

begin
  Result := False;
  SrcMain := RqFbSourceMain(FCurrentFileName);
  OldDir := ExtractFilePath(FCurrentFileName);
  if SrcMain <> '' then
    NewDir := ExtractFilePath(SrcMain) +
              ChangeFileExt(ExtractFileName(SrcMain), '') + '_fb\'
  else
    NewDir := ExtractFilePath(ExcludeTrailingPathDelimiter(OldDir)) +
              ChangeFileExt(ExtractFileName(FCurrentFileName), '') + '_fb\';
  if DirectoryExists(NewDir) and
     (MessageDlg('Папка ' + NewDir + ' уже есть - файлы в ней будут ' +
       'заменены переводом. Продолжить?', mtWarning, [mbYes, mbNo], 0) <>
       mrYes) then
    Exit;
  Stamp := FormatDateTime('yyyy-mm-dd hh:nn', Now);
  Files := TStringList.Create;
  Lines := TStringList.Create;
  try
    Collect(OldDir, '');
    for FileIdx := 0 to Files.Count - 1 do
    begin
      ForceDirectories(ExtractFilePath(NewDir + Files[FileIdx]));
      Ext := LowerCase(ExtractFileExt(Files[FileIdx]));
      if (Ext <> '.bas') and (Ext <> '.bi') and (Ext <> '.inc') and
         (Ext <> '.rc') then
      begin
        CopyFile(PChar(OldDir + Files[FileIdx]),
                 PChar(NewDir + Files[FileIdx]), False);
        Continue;
      end;
      Lines.LoadFromFile(OldDir + Files[FileIdx]);
      for LineIdx := Lines.Count - 1 downto 0 do
      begin
        LineText := Lines[LineIdx];
        if CompareText(Copy(TrimLeft(LineText), 1, 6), '#line ') = 0 then
        begin
          Lines.Delete(LineIdx);
          Continue;
        end;
        if Pos('создаётся заново при каждой сборке', LineText) > 0 then
          LineText := '''' + ' Переведено из RapidQ препроцессором RqToFb ' +
            '(unIDE) из ' + SrcMain + ', отделено ' + Stamp +
            '. Дальше - обычный файл FreeBASIC.';
        // Пути в старую папку перевода - на новую
        Lines[LineIdx] := StringReplace(LineText,
                            ExcludeTrailingPathDelimiter(OldDir),
                            ExcludeTrailingPathDelimiter(NewDir),
                            [rfReplaceAll, rfIgnoreCase]);
      end;
      Lines.SaveToFile(NewDir + Files[FileIdx]);
    end;
  finally
    Lines.Free;
    Files.Free;
  end;
  NewMain := NewDir + ExtractFileName(FCurrentFileName);
  if not FileExists(NewMain) then
  begin
    ShowMessage('Перевод не скопирован: ' + NewMain);
    Exit;
  end;
  RqFbModeSet(SrcMain, 'fb|' + NewMain);
  LogComp('Переход на FreeBASIC: ' + OldDir + ' -> ' + NewDir +
          ' (#line убраны). Главный файл: ' + NewMain);
  OpenNamedFile(NewMain);
  Result := True;
end;

// Строка ALine перевода (от нуля) - файл и строка (от нуля) исходника по
// ближайшей директиве #line выше: "#line N "файл"" - следующая строка это
// строка N+1 файла (от единицы), то есть N от нуля
function TForm1.RqFbMapLine(ALines: TStrings; ALine: Integer;
                            var AFile: string; var ASrcLine: Integer): Boolean;
var
  LineIdx, QuotePos, Code, BaseNum, PrevLine: Integer;
  LineText, NumText: string;
begin
  Result := False;
  AFile := '';
  ASrcLine := -1;
  for LineIdx := ALine - 1 downto 0 do
  begin
    LineText := Trim(ALines[LineIdx]);
    if CompareText(Copy(LineText, 1, 6), '#line ') <> 0 then
      Continue;
    QuotePos := Pos('"', LineText);
    if QuotePos > 0 then
    begin
      NumText := Trim(Copy(LineText, 7, QuotePos - 7));
      AFile := Copy(LineText, QuotePos + 1, MaxInt);
      if Pos('"', AFile) > 0 then
        AFile := Copy(AFile, 1, Pos('"', AFile) - 1);
    end
    else
      NumText := Trim(Copy(LineText, 7, MaxInt));
    Val(NumText, BaseNum, Code);
    if Code <> 0 then
      Exit;
    // Номер без файла - файл прежней директивы выше
    if AFile = '' then
      if not RqFbMapLine(ALines, LineIdx, AFile, PrevLine) or
         (AFile = '') then
        Exit;
    ASrcLine := BaseNum + (ALine - LineIdx - 1);
    Result := True;
    Exit;
  end;
end;

// Свойство AProp объекта AName в тексте активного редактора: есть
// присваивание - значение на AValue (ACheckOld - только если там сейчас
// AOldValue), нет - новая строка в блоке CREATE или за свойствами объекта
// DIM. ACreateLine >= 0 - объект с этой строкой CREATE/DIM (одноимённых
// может быть несколько). Что сделано или причина отказа - в AMsg.
function TForm1.RqSetPropInEditor(const AName: string; ACreateLine: Integer;
                                  const AProp, AValue, AOldValue: string;
                                  ACheckOld: Boolean;
                                  var AMsg: string): Boolean;
var
  Lines: TStringList;
  Nodes, Roots: TList;
  Node: TDfmNode;
  NodeIdx, PropIdx, LineNo, LineStart, LineLen, ValStart, ValLen,
    InsAt: Integer;
  CurLine, NewLine, LineIndent, EqText, OldText: string;
begin
  Result := False;
  AMsg := '';
  Lines := TStringList.Create;
  Nodes := TList.Create;
  Roots := TList.Create;
  try
    Lines.Text := GetEditorTextCR;
    RapidQCreateNodes(Lines, Nodes, Roots);
    Node := nil;
    for NodeIdx := 0 to Nodes.Count - 1 do
      if CompareText(TDfmNode(Nodes[NodeIdx]).Name, AName) = 0 then
        if (Node = nil) or
           (TDfmNode(Nodes[NodeIdx]).CreateLine = ACreateLine) then
          Node := TDfmNode(Nodes[NodeIdx]);
    if (Node = nil) or (Node.CreateLine < 0) then
    begin
      AMsg := 'объект ' + AName + ' не найден';
      Exit;
    end;
    PropIdx := -1;
    for NodeIdx := Node.PropN.Count - 1 downto 0 do
      if CompareText(Node.PropN[NodeIdx], AProp) = 0 then
      begin
        PropIdx := NodeIdx;
        Break;
      end;
    if PropIdx >= 0 then
    begin
      LineNo := Integer(Node.PropN.Objects[PropIdx]);
      LineStart := SendMessageA(RichEdit1.Handle, EM_LINEINDEX, LineNo, 0);
      if LineStart < 0 then
        Exit;
      LineLen := SendMessageA(RichEdit1.Handle, EM_LINELENGTH, LineStart, 0);
      CurLine := ReadLineText(LineNo, LineStart, LineLen);
      if not RapidQFindAssign(CurLine, RapidQAssignName(Node, AProp),
                              ValStart, ValLen) then
      begin
        AMsg := 'строка ' + IntToStr(LineNo + 1) + ' не разобрана';
        Exit;
      end;
      OldText := Trim(Copy(CurLine, ValStart, ValLen));
      if ACheckOld and (CompareText(OldText, Trim(AOldValue)) <> 0) then
      begin
        AMsg := 'там ' + AProp + ' = ' + OldText + ' (строка ' +
                IntToStr(LineNo + 1) + '), а в переводе ' + Trim(AOldValue);
        Exit;
      end;
      if OldText <> AValue then
      begin
        EditorFreeze;
        try
          RichEdit1.SelStart := LineStart + ValStart - 1;
          RichEdit1.SelLength := ValLen;
          RichEdit1.SelText := AValue;
        finally
          EditorThaw;
        end;
      end;
      AMsg := 'строка ' + IntToStr(LineNo + 1);
      Result := True;
      Exit;
    end;
    if ACheckOld then
    begin
      AMsg := 'присваивания ' + AProp + ' там нет';
      Exit;
    end;
    if (Node.EndLine = Node.CreateLine) and not Node.IsDim then
    begin
      LineNo := Node.CreateLine;
      LineStart := SendMessageA(RichEdit1.Handle, EM_LINEINDEX, LineNo, 0);
      if LineStart < 0 then
        Exit;
      LineLen := SendMessageA(RichEdit1.Handle, EM_LINELENGTH, LineStart, 0);
      CurLine := ReadLineText(LineNo, LineStart, LineLen);
      if not RapidQInsertBeforeEnd(CurLine, Node.Name,
                                   AProp + RapidQEqStyle(CurLine) + AValue,
                                   NewLine) then
      begin
        AMsg := 'блок CREATE в строке ' + IntToStr(LineNo + 1) +
                ' не разобран';
        Exit;
      end;
      EditorFreeze;
      try
        RichEdit1.SelStart := LineStart;
        RichEdit1.SelLength := LineLen;
        RichEdit1.SelText := NewLine;
      finally
        EditorThaw;
      end;
      AMsg := 'добавлено в строку ' + IntToStr(LineNo + 1);
      Result := True;
      Exit;
    end;
    InsAt := RapidQInsertPlace(Lines, Node, LineIndent, EqText);
    if InsAt < 0 then
    begin
      AMsg := 'некуда добавить строку';
      Exit;
    end;
    LineStart := SendMessageA(RichEdit1.Handle, EM_LINEINDEX, InsAt, 0);
    if LineStart < 0 then
      Exit;
    EditorFreeze;
    try
      RichEdit1.SelStart := LineStart;
      RichEdit1.SelLength := 0;
      RichEdit1.SelText := LineIndent + RapidQAssignName(Node, AProp) +
                           EqText + AValue + #13#10;
    finally
      EditorThaw;
    end;
    AMsg := 'добавлена строка ' + IntToStr(InsAt + 1);
    Result := True;
  finally
    for NodeIdx := 0 to Nodes.Count - 1 do
      TObject(Nodes[NodeIdx]).Free;
    Roots.Free;
    Nodes.Free;
    Lines.Free;
  end;
end;

// Связь с RapidQ: свойство AProp объекта AName (вкладка перевода активна)
// - в исходник RapidQ, затем то же в перевод. ACheckOld - у свойства уже
// есть значение AOldValue в переводе: в исходнике должно быть то же самое
// (иначе это выражение, которое перевод переписал, - правка отклоняется).
function TForm1.RqFbLinkedSet(const AName, AProp, AValue, AOldValue: string;
                              ACheckOld: Boolean): Boolean;
var
  FbLines: TStringList;
  FbNodes, FbRoots: TList;
  FbWin, SrcWin, NodeIdx, DimLine, SrcLine: Integer;
  SrcFile, Msg, SrcMsg: string;
begin
  Result := False;
  FbWin := FWindowsIndex;
  // Строка объекта в переводе -> файл и строка в исходнике
  DimLine := -1;
  SrcFile := '';
  SrcLine := -1;
  FbLines := TStringList.Create;
  FbNodes := TList.Create;
  FbRoots := TList.Create;
  try
    FbLines.Text := GetEditorTextCR;
    RapidQCreateNodes(FbLines, FbNodes, FbRoots);
    for NodeIdx := 0 to FbNodes.Count - 1 do
      if CompareText(TDfmNode(FbNodes[NodeIdx]).Name, AName) = 0 then
      begin
        DimLine := TDfmNode(FbNodes[NodeIdx]).CreateLine;
        Break;
      end;
    if DimLine >= 0 then
      RqFbMapLine(FbLines, DimLine, SrcFile, SrcLine);
  finally
    for NodeIdx := 0 to FbNodes.Count - 1 do
      TObject(FbNodes[NodeIdx]).Free;
    FbRoots.Free;
    FbNodes.Free;
    FbLines.Free;
  end;
  if (SrcFile = '') or not FileExists(SrcFile) then
  begin
    ShowMessage('Объект ' + AName + ': строка в исходнике RapidQ не найдена ' +
                '(нет директивы #line или файла ' + SrcFile + ') - свойство ' +
                'только для чтения.');
    Exit;
  end;

  // Исходник - во вкладку (если не открыт), правка в нём
  SrcWin := IndexOfWindowByFile(SrcFile);
  if SrcWin < 0 then
  begin
    OpenNamedFile(SrcFile);
    SrcWin := IndexOfWindowByFile(SrcFile);
  end
  else
    ActivateWindow(SrcWin);
  if SrcWin < 0 then
    Exit;
  Inc(FObjOwnWrite);
  try
    Result := RqSetPropInEditor(AName, SrcLine, AProp, AValue, AOldValue,
                                ACheckOld, SrcMsg);
  finally
    Dec(FObjOwnWrite);
  end;
  // Назад к переводу; удалось - то же и в нём
  ActivateWindow(FbWin);
  if not Result then
  begin
    ShowMessage(AName + '.' + AProp + ' в исходнике ' +
                ExtractFileName(SrcFile) + ' не изменён: ' + SrcMsg + '.' +
                #13#10'В переводе это свойство только для чтения.');
    Exit;
  end;
  Inc(FObjOwnWrite);
  RichEdit1.ReadOnly := False;
  try
    if RqSetPropInEditor(AName, -1, AProp, AValue, AOldValue, ACheckOld,
                         Msg) then
      Msg := 'тоже записано (' + Msg + ')'
    else
      Msg := 'не повторено (' + Msg + ') - покажется после сборки';
  finally
    RichEdit1.ReadOnly := FRqFbTab;
    Dec(FObjOwnWrite);
  end;
  LogComp('Инспектор: ' + AName + '.' + AProp + ' = ' + AValue + ' -> ' +
          ExtractFileName(SrcFile) + ' (' + SrcMsg + '), перевод: ' + Msg);
  // Узлы после смены вкладок - новые: выделение вернётся по имени
  ObjScheduleRelines(nil, AProp);
  FObjRefreshName := AName;
end;

// Параметры обработчика события AEvent для FreeBASIC (RqLcl): виды и типы
// - из типа RqEvProc<Событие> в RqLcl\inc\rqlcl.bi ("ByRef As Long, ByVal
// As Long"), имена - из параметров RapidQ ARqParams ("(Key AS WORD, Shift
// AS INTEGER)"). Типа нет - '' (обработчик без параметров).
function TForm1.FbEventParams(const AEvent, ARqParams: string): string;
var
  LclDir, Problem, BiText, Pattern, SigText, NameText: string;
  BiFile: TStringList;
  StartPos, EndPos, ParamIdx: Integer;
  Sig, Names: TStringList;

  procedure SplitList(const AText: string; AOut: TStrings);
  var
    Pos1, Depth: Integer;
    Part: string;
  begin
    AOut.Clear;
    Part := '';
    Depth := 0;
    for Pos1 := 1 to Length(AText) do
    begin
      if AText[Pos1] = '(' then
        Inc(Depth)
      else if AText[Pos1] = ')' then
        Dec(Depth);
      if (AText[Pos1] = ',') and (Depth = 0) then
      begin
        AOut.Add(Trim(Part));
        Part := '';
      end
      else
        Part := Part + AText[Pos1];
    end;
    if Trim(Part) <> '' then
      AOut.Add(Trim(Part));
  end;

begin
  Result := '';
  LclDir := RqLclDir(Problem);
  if (LclDir = '') or not FileExists(LclDir + 'inc\rqlcl.bi') then
    Exit;
  BiFile := TStringList.Create;
  Sig := TStringList.Create;
  Names := TStringList.Create;
  try
    BiFile.LoadFromFile(LclDir + 'inc\rqlcl.bi');
    BiText := BiFile.Text;
    Pattern := 'RQEVPROC' + UpperCase(Copy(AEvent, 3, MaxInt)) + ' AS SUB(';
    StartPos := Pos(Pattern, UpperCase(BiText));
    if StartPos = 0 then
      Exit;
    Inc(StartPos, Length(Pattern));
    EndPos := StartPos;
    while (EndPos <= Length(BiText)) and (BiText[EndPos] <> ')') and
          (BiText[EndPos] <> #13) and (BiText[EndPos] <> #10) do
      Inc(EndPos);
    SigText := Copy(BiText, StartPos, EndPos - StartPos);
    SplitList(SigText, Sig);
    NameText := Trim(ARqParams);
    if (Copy(NameText, 1, 1) = '(') and
       (Copy(NameText, Length(NameText), 1) = ')') then
      NameText := Copy(NameText, 2, Length(NameText) - 2);
    SplitList(NameText, Names);
    for ParamIdx := 0 to Sig.Count - 1 do
    begin
      if ParamIdx > 0 then
        Result := Result + ', ';
      // "ByRef As Long" -> "ByRef Key As Long"
      if (ParamIdx < Names.Count) and (Pos(' ', Names[ParamIdx]) > 0) then
        NameText := Copy(Names[ParamIdx], 1, Pos(' ', Names[ParamIdx]) - 1)
      else
        NameText := 'Param' + IntToStr(ParamIdx + 1);
      StartPos := Pos(' AS ', UpperCase(' ' + Sig[ParamIdx]));
      if StartPos > 0 then
        Result := Result + Trim(Copy(Sig[ParamIdx], 1, StartPos - 1)) + ' ' +
                  NameText + ' ' + Trim(Copy(Sig[ParamIdx], StartPos, MaxInt))
      else
        Result := Result + NameText + ' ' + Sig[ParamIdx];
    end;
  finally
    Names.Free;
    Sig.Free;
    BiFile.Free;
  end;
end;

// Двойной щелчок по неназначенному событию AEvent объекта RapidQ (или
// FreeBASIC - перевода RqLcl) - как в Delphi: обработчик Имя+Событие без
// On (BtnClick) создаётся и назначается, каретка - в его тело.
//   SUB - в конце файла (уже есть такой - только назначается);
//   DECLARE SUB - перед строкой DIM объекта или перед внешним CREATE, в
//     котором он стоит (до первого обращения к имени);
//   назначение - в блоке CREATE "OnClick = BtnClick", у объекта DIM
//     "Btn.OnClick = BtnClick" за строками его свойств.
// FreeBASIC (сборщик по тексту файла): "@BtnClick", Sub/End Sub, параметры
// по типу события в RqLcl (FbEventParams).
procedure TForm1.RapidQEventCreate(const AEvent: string);
var
  Obj, Outer: TDfmNode;
  Lines: TStringList;
  Chain: TList;
  ChainIdx, LineIdx, InsAt, AnchorLine, SubLine, TextEnd, LineStart: Integer;
  RqParams, Handler, ParamText, DeclText, SubText, AssignText, Indent,
    EqText, LineWord, Rest, SubName, AnchorIndent: string;
  IsFb, HasSub, HasDecl: Boolean;
  Event: TRqEvent;

  function IndentOf(const AText: string): string;
  var
    CharIdx: Integer;
  begin
    CharIdx := 1;
    while (CharIdx <= Length(AText)) and (AText[CharIdx] in [' ', #9]) do
      Inc(CharIdx);
    Result := Copy(AText, 1, CharIdx - 1);
  end;

  procedure InsertAt(ALine: Integer; const AText: string);
  begin
    LineStart := SendMessageA(RichEdit1.Handle, EM_LINEINDEX, ALine, 0);
    if LineStart < 0 then
      LineStart := RichEdit1.GetTextLen;
    RichEdit1.SelStart := LineStart;
    RichEdit1.SelLength := 0;
    RichEdit1.SelText := AText;
  end;

begin
  if FObjCurNode = nil then
    Exit;
  if FRqFbTab then
  begin
    ShowMessage('Это перевод RapidQ (_rqfb): обработчик ' + AEvent +
      ' создаётся в исходнике RapidQ - откройте его вкладку и назначьте ' +
      'событие там. Перевод получит его при следующей сборке.');
    Exit;
  end;
  if RichEdit1.ReadOnly then
    Exit;
  Obj := TDfmNode(FObjCurNode);
  if (Obj.Name = '') or (Obj.CreateLine < 0) or (Length(AEvent) < 3) then
    Exit;
  IsFb := CurBuildKind = bkFreeBasic;
  Handler := Obj.Name + Copy(AEvent, 3, MaxInt);

  // Параметры обработчика - по описанию класса
  RqParams := '';
  Chain := TList.Create;
  try
    RqClassChain(Obj.ClassNm, Chain);
    for ChainIdx := 0 to Chain.Count - 1 do
    begin
      Event := TRqClass(Chain[ChainIdx]).EventOf(AEvent);
      if Event <> nil then
      begin
        RqParams := Event.Params;
        Break;
      end;
    end;
  finally
    Chain.Free;
  end;
  if IsFb then
    ParamText := FbEventParams(AEvent, RqParams)
  else if Pos(' AS ', UpperCase(RqParams)) > 0 then
  begin
    ParamText := Trim(RqParams);
    if Copy(ParamText, 1, 1) = '(' then
      ParamText := Copy(ParamText, 2, Length(ParamText) - 2);
  end
  else
    ParamText := '';

  Lines := TStringList.Create;
  try
    Lines.Text := GetEditorTextCR;
    if Obj.IsDim then
    begin
      if not RapidQDimLineOk(Lines, Obj) then
        Exit;
    end
    else if (Obj.CreateLine >= Lines.Count) or
            (Pos('CREATE', UpperCase(Lines[Obj.CreateLine])) = 0) then
      Exit;

    // Есть ли уже SUB и DECLARE с этим именем
    HasSub := False;
    HasDecl := False;
    SubLine := -1;
    for LineIdx := 0 to Lines.Count - 1 do
    begin
      LineWord := RapidQFirstWord(Trim(Lines[LineIdx]), Rest);
      if LineWord = 'DECLARE' then
      begin
        SubName := Rest;
        LineWord := RapidQFirstWord(SubName, Rest);
        SubName := Rest;
        if Pos('(', SubName) > 0 then
          SubName := Copy(SubName, 1, Pos('(', SubName) - 1);
        if (Pos(' ', Trim(SubName)) > 0) then
          SubName := Copy(Trim(SubName), 1, Pos(' ', Trim(SubName)) - 1);
        if ((LineWord = 'SUB') or (LineWord = 'FUNCTION')) and
           (CompareText(Trim(SubName), Handler) = 0) then
          HasDecl := True;
        Continue;
      end;
      if (LineWord = 'SUB') or (LineWord = 'SUBI') then
      begin
        SubName := Rest;
        if Pos('(', SubName) > 0 then
          SubName := Copy(SubName, 1, Pos('(', SubName) - 1);
        if (Pos(' ', Trim(SubName)) > 0) then
          SubName := Copy(Trim(SubName), 1, Pos(' ', Trim(SubName)) - 1);
        if CompareText(Trim(SubName), Handler) = 0 then
        begin
          HasSub := True;
          SubLine := LineIdx;
        end;
      end;
    end;

    // Место назначения
    if Obj.IsDim then
    begin
      InsAt := RapidQInsertPlace(Lines, Obj, Indent, EqText);
      AssignText := Obj.Name + '.' + AEvent;
    end
    else
    begin
      if Obj.EndLine <= Obj.CreateLine then
      begin
        ShowMessage('Блок CREATE ' + Obj.Name + ' в одну строку - назначьте ' +
                    AEvent + ' в нём вручную.');
        Exit;
      end;
      InsAt := RapidQInsertPlace(Lines, Obj, Indent, EqText);
      AssignText := AEvent;
    end;
    if InsAt < 0 then
      Exit;
    if IsFb then
      AssignText := Indent + AssignText + EqText + '@' + Handler
    else
      AssignText := Indent + AssignText + EqText + Handler;

    // DECLARE - перед DIM объекта или перед внешним CREATE
    Outer := Obj;
    if not Obj.IsDim then
      while (Outer.Parent <> nil) and not Outer.Parent.IsDim and
            (Outer.Parent.CreateLine >= 0) and
            (Outer.Parent.CreateLine < Outer.CreateLine) and
            (Outer.Parent.EndLine >= Outer.EndLine) do
        Outer := Outer.Parent;
    AnchorLine := Outer.CreateLine;
    AnchorIndent := IndentOf(Lines[AnchorLine]);
    if IsFb then
    begin
      DeclText := AnchorIndent + 'Declare Sub ' + Handler + '(' + ParamText +
                  ')';
      SubText := 'Sub ' + Handler + '(' + ParamText + ')'#13#10 + '    '#13#10 +
                 'End Sub'#13#10;
    end
    else
    begin
      if ParamText <> '' then
        ParamText := ' (' + ParamText + ')';
      DeclText := AnchorIndent + 'DECLARE SUB ' + Handler + ParamText;
      SubText := 'SUB ' + Handler + ParamText + #13#10 + '    '#13#10 +
                 'END SUB'#13#10;
    end;
    // SUB выше объекта - DECLARE не нужен
    if HasSub and (SubLine < AnchorLine) then
      HasDecl := True;
  finally
    Lines.Free;
  end;

  // Снизу вверх: номера строк выше остаются прежними
  Inc(FObjOwnWrite);
  EditorFreeze;
  try
    if not HasSub then
    begin
      TextEnd := RichEdit1.GetTextLen;
      RichEdit1.SelStart := TextEnd;
      RichEdit1.SelLength := 0;
      if (TextEnd > 0) and (Copy(GetEditorTextCR, TextEnd, 1) <> #13) then
        RichEdit1.SelText := #13#10#13#10 + SubText
      else
        RichEdit1.SelText := #13#10 + SubText;
    end;
    InsertAt(InsAt, AssignText + #13#10);
    if not HasDecl then
      InsertAt(AnchorLine, DeclText + #13#10);
  finally
    EditorThaw;
    Dec(FObjOwnWrite);
  end;
  LogComp('Инспектор: ' + Obj.Name + '.' + AEvent + ' = ' + Handler +
          IfThen(HasSub, ' (обработчик уже был)', ' - обработчик добавлен в ' +
                 'конец файла'));
  ObjScheduleRelines(Obj, '');
  // Каретка - в тело обработчика
  Lines := TStringList.Create;
  try
    Lines.Text := GetEditorTextCR;
    for LineIdx := Lines.Count - 1 downto 0 do
    begin
      LineWord := RapidQFirstWord(Trim(Lines[LineIdx]), Rest);
      if ((LineWord = 'SUB') or (LineWord = 'SUBI')) and
         (CompareText(Copy(Rest, 1, Length(Handler)), Handler) = 0) and
         ((Length(Rest) = Length(Handler)) or
          not (Rest[Length(Handler) + 1] in ['A'..'Z', 'a'..'z', '0'..'9',
                                              '_'])) then
      begin
        if LineIdx + 1 < Lines.Count then
          GotoLine(LineIdx + 1)
        else
          GotoLine(LineIdx);
        Break;
      end;
    end;
  finally
    Lines.Free;
  end;
end;

// Дерево всех компонентов, которые создаёт код открытого модуля: главная
// форма (Self) с тем, что на ней, служебные окна и диалоги
// (Dlg := TForm.Create) со своим содержимым, меню. Строится тем же
// разбором, что ветка runtime в инспекторе (BuildCodeRuntime), но полным:
// без отбора "только то, что лежит на форме". Рядом с именем - номер
// строки создания; щелчок - к ней.
procedure TForm1.RefreshCodeTree;
var
  Lines: TStringList;

  // Имя процедуры, в которой стоит строка ALine: NewProjectClick из
  // "procedure TForm1.NewProjectClick(Sender: TObject);". '' - вне процедур.
  function ProcAt(ALine: Integer): string;
  var
    I, P: Integer;
    T, U: string;
  begin
    Result := '';
    if (ALine < 0) or (ALine >= Lines.Count) then
      Exit;
    for I := ALine downto 0 do
    begin
      T := Lines[I];
      U := UpperCase(T);
      if Copy(U, 1, 10) = 'PROCEDURE ' then
        T := Trim(Copy(T, 11, MaxInt))
      else if Copy(U, 1, 9) = 'FUNCTION ' then
        T := Trim(Copy(T, 10, MaxInt))
      else if (Copy(U, 1, 12) = 'CONSTRUCTOR ') or
              (Copy(U, 1, 11) = 'DESTRUCTOR ') then
        T := Trim(Copy(T, Pos(' ', T) + 1, MaxInt))
      else
        Continue;
      P := Pos('(', T);
      if P = 0 then
        P := Pos(';', T);
      if P = 0 then
        P := Pos(':', T);
      if P > 0 then
        T := Copy(T, 1, P - 1);
      P := LastDelimiter('.', T);
      if P > 0 then
        Delete(T, 1, P);
      Result := Trim(T);
      Exit;
    end;
  end;

// Процедура приписывается там, где она меняется: у окон и диалогов
// (родитель - модуль) и у компонентов, созданных не в той процедуре, что
// их родитель. Внутри одной процедуры не повторяется.
  procedure AddNodes(AParent: TTreeNode; N: TDfmNode; const AParentProc: string);
  var
    I: Integer;
    T: TTreeNode;
    S, Proc: string;
    C: TDfmNode;
  begin
    for I := 0 to N.Children.Count - 1 do
    begin
      C := TDfmNode(N.Children[I]);
      if C.VarName <> '' then
        S := C.VarName + ': ' + C.ClassNm
      else if C.Name <> '' then
        S := C.Name + ': ' + C.ClassNm
      else
        S := C.ClassNm;
      Proc := ProcAt(C.CreateLine);
      if C.CreateLine >= 0 then
        S := S + '   (' + IntToStr(C.CreateLine + 1) + ')';
      if (Proc <> '') and (CompareText(Proc, AParentProc) <> 0) then
        S := S + '   ' + Proc;
      T := FCodeTree.Items.AddChildObject(AParent, S, Pointer(C.CreateLine));
      AddNodes(T, C, Proc);
    end;
  end;

var
  Ext, Txt: string;
  Root, Grp: TDfmNode;
  Top, G: TTreeNode;
  Start, I: Integer;
begin
  if FCodeTree = nil then
    Exit;
  // Файл RapidQ (те же правила, что у вкладки Includes): его объекты
  // CREATE - на вкладке Objects
  if (FCurrentFileName <> '') and IncludesApply then
  begin
    FCodeTree.Items.BeginUpdate;
    try
      FCodeTree.Items.Clear;
      FCodeTree.Items.AddObject(nil, '(RapidQ: объекты CREATE - на вкладке ' +
      'Objects)', Pointer(-1));
    finally
      FCodeTree.Items.EndUpdate;
    end;
    Exit;
  end;
  Start := FDfmNodes.Count;
  Lines := TStringList.Create;
  FCodeTree.Items.BeginUpdate;
  try
    FCodeTree.Items.Clear;
    Ext := LowerCase(ExtractFileExt(FCurrentFileName));
    if (Ext <> '.pas') and (Ext <> '.pp') and (Ext <> '.dpr') and
       (Ext <> '.lpr') and (Ext <> '.inc') then
    begin
      FCodeTree.Items.AddObject(nil, '(не модуль Паскаля)', Pointer(-1));
      Exit;
    end;
    Txt := GetEditorText;
    Lines.Text := Txt;

    // Корень - форма модуля: для кода это Self
    Root := TDfmNode.Create;
    FDfmNodes.Add(Root);
    Root.Name := 'Self';
    Root.ClassNm := '';
    Root.Line := -1;
    Root.CreateLine := -1;
    // Полное дерево: и окна-диалоги, и локальные переменные без родителя
    Grp := BuildCodeRuntime(Root, Txt, FObjFormClass, True, FDfmNodes);

    Top := FCodeTree.Items.AddObject(nil, ExtractFileName(FCurrentFileName) +
    ' (Self)', Pointer(-1));
                                     AddNodes(Top, Root, '');
                                     Top.Expand(False);
                                     if (Grp <> nil) and (Grp <> Root) then
    begin
      G := FCodeTree.Items.AddObject(nil, '(родитель не определён)', Pointer(-1));
      AddNodes(G, Grp, '');
    end;
  finally
    FCodeTree.Items.EndUpdate;
    Lines.Free;
    // Узлы разбора дереву не нужны - в нём только подписи и номера строк.
    // Освобождаем свои, узлы инспектора (до Start) не трогаем.
    for I := FDfmNodes.Count - 1 downto Start do
    begin
      TObject(FDfmNodes[I]).Free;
      FDfmNodes.Delete(I);
    end;
  end;
end;

// Щелчок по узлу дерева Code - к строке создания компонента
procedure TForm1.CodeTreeClick(Sender: TObject);
var
  Pt: TPoint;
  Line: Integer;
begin
  if FCodeTree.Selected = nil then
    Exit;
  GetCursorPos(Pt);
  Pt := FCodeTree.ScreenToClient(Pt);
  if FCodeTree.GetHitTestInfoAt(Pt.X, Pt.Y) *
     [htOnItem, htOnIcon, htOnLabel] = [] then
    Exit;  // щелчок по плюсику
  Line := Integer(FCodeTree.Selected.Data);
  if Line >= 0 then
    GotoLine(Line);
end;

// Живые значения - сами, при переходе на вкладку Objects:
//   - свой проект (редактор правит сам себя) - снимок с живого окна, если
//     его ещё нет. Заново - когда изменился состав формы (ObjSnapTextFor,
//     OwnSnapStale) или по кнопке Show. Снимать его на каждом переходе
//     нельзя: значения в нём всегда чуть другие, и ключ кэша не совпадал
//     бы никогда - каждый переход был бы полным разбором;
//   - чужой проект - пробный запуск, но один раз за сеанс работы с
//     проектом: это сборка и запуск программы, несколько секунд. Обновить
//     снимок потом - кнопкой.
// Если снимок убрали кнопкой (Show .dfm values only), сам он не возвращается,
// пока его снова не включат.
procedure TForm1.ObjAutoSnap;
begin
  if FSnapOff or (FObjFormClass = '') then
    Exit;
  if IsOwnProject then
  begin
    if OwnSnapFor(FObjFormClass) = '' then
      SnapshotOwnFormClick(nil);
  end
  else if (ProbeSnapFor(FObjFormClass) = '') and not FProbeTried then
  begin
    FProbeTried := True;   // не удался - сам не повторяется
    ProbeRun;
  end;
end;

// Снимок формы самого редактора: то, что создано в коде при старте, с
// текущими значениями. Данные .dfm он не заменяет - вливается поверх, см.
// MergeSnapNode. Подробности обхода - в модуле FormSnapshot.
// ---------------------------------------------------------------------------
//  Пробный запуск проекта: настоящие координаты и размеры
//
//  Координаты и размеры, которые программа считает в коде, без запуска не
//  узнать. Поэтому собирается копия проекта (_dsgprobe.dpr рядом с
//  настоящим .dpr) с модулем-зондом DsgProbe. Копия отличается от
//  оригинала тремя местами:
//    - в uses первым стоит DsgProbe;
//    - после последнего Application.CreateForm вызывается DsgProbeDump:
//      снимок всех созданных форм в файл и ExitProcess;
//    - Application.Run не вызывается вовсе.
//  Так выполняются конструкторы форм и их OnCreate (там компоненты и
//  создаются), но не OnShow, не таймеры, не цикл сообщений и не OnDestroy.
//
//  Что в OnCreate делать при пробном запуске не нужно (поиск устройства,
//  долгая загрузка), программист оборачивает в {$IFNDEF DSGPROBE} ...
//  {$ENDIF}: копия собирается с -DDSGPROBE, обычная сборка - без него.
//
//  Exe и .dcu пробной сборки - во временной папке, настоящие не трогаются.
//  Временный .dpr (и копия .cfg) после сборки удаляются.
// ---------------------------------------------------------------------------

type
  TProbeText = class
  public
    Text: string;
  end;

const
  ProbeUnitText =
  'unit DsgProbe;'#13#10 +
  ''#13#10 +
  '// Зонд пробного запуска конструктора форм SyntaxHLClaude. Подключается'#13#10 +
  '// только к временной копии проекта (_dsgprobe.dpr) и в исходники не'#13#10 +
  '// попадает. Снимок всех созданных форм - в файл из переменной'#13#10 +
  '// окружения DSGPROBE_OUT, затем немедленный выход.'#13#10 +
  ''#13#10 +
  'interface'#13#10 +
  ''#13#10 +
  'procedure DsgProbeDump;'#13#10 +
  ''#13#10 +
  'implementation'#13#10 +
  ''#13#10 +
  'uses'#13#10 +
  '  Windows, SysUtils, Classes, Controls, Forms, FormSnapshot;'#13#10 +
  ''#13#10 +
  'procedure DsgProbeDump;'#13#10 +
  'var'#13#10 +
  '  SL: TStringList;'#13#10 +
  '  I, J: Integer;'#13#10 +
  '  Buf: array[0..1023] of Char;'#13#10 +
  'begin'#13#10 +
  '  if Windows.GetEnvironmentVariable(''DSGPROBE_OUT'', Buf, SizeOf(Buf)) > 0 then'#13#10 +
  '  begin'#13#10 +
  '    SL := TStringList.Create;'#13#10 +
  '    try'#13#10 +
  '      for I := 0 to Screen.FormCount - 1 do'#13#10 +
  '      begin'#13#10 +
  '        // Окна контролам: часть раскладки (TUpDown у своего поля)'#13#10 +
  '        // Windows делает только при их создании'#13#10 +
  '        try'#13#10 +
  '          Screen.Forms[I].HandleNeeded;'#13#10 +
  '          for J := 0 to Screen.Forms[I].ComponentCount - 1 do'#13#10 +
  '            if Screen.Forms[I].Components[J] is TWinControl then'#13#10 +
  '            try'#13#10 +
  '              TWinControl(Screen.Forms[I].Components[J]).HandleNeeded;'#13#10 +
