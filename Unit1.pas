      for Index := 0 to AllNames.Count - 1 do
        if MenuIsMainClass(DfmObjectClass(FMenuWizDfm, AllNames[Index])) then
        begin
          Result := True;
          Exit;
        end;
  finally
    AllNames.Free;
  end;
end;

