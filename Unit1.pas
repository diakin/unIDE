procedure TForm1.DbgClearEdits;
var
  EditIdx: Integer;
begin
  if FDbgEdits = nil then
    Exit;
  for EditIdx := 0 to FDbgEdits.Count - 1 do
    TObject(FDbgEdits[EditIdx]).Free;
  FDbgEdits.Clear;
end;

// Строка из .map (по тексту сборки, с 0) - в нынешний номер: правки файла
// за сеанс по порядку
function TForm1.DbgLineNow(const AFileName: string;
                           ABuildLine: Integer): Integer;
var
  EditIdx: Integer;
  LineEdit: TDbgLineEdit;
begin
  Result := ABuildLine;
  if FDbgEdits = nil then
    Exit;
  for EditIdx := 0 to FDbgEdits.Count - 1 do
  begin
    LineEdit := TDbgLineEdit(FDbgEdits[EditIdx]);
    if CompareText(LineEdit.FileName, AFileName) <> 0 then
      Continue;
    if Result < LineEdit.FirstLine then
      // выше правки - на месте
    else if Result > LineEdit.LastLine then
      Result := Result + LineEdit.Delta
    else if (Result = LineEdit.FirstLine) and LineEdit.KeepFirst then
      // начало строки левее правки - на месте
    else if Result = LineEdit.LastLine then
      Result := Result + LineEdit.Delta
    else
      Result := LineEdit.FirstLine;   // строка удалена
  end;
end;

// Обратно: нынешний номер строки - в номер по тексту сборки (для .map).
// -1 - строка вставлена после сборки, кода в exe у неё нет.
function TForm1.DbgLineThen(const AFileName: string;
                            ANowLine: Integer): Integer;
var
  EditIdx, NewLast: Integer;
  LineEdit: TDbgLineEdit;
begin
  Result := ANowLine;
  if FDbgEdits = nil then
    Exit;
  for EditIdx := FDbgEdits.Count - 1 downto 0 do
  begin
    LineEdit := TDbgLineEdit(FDbgEdits[EditIdx]);
    if CompareText(LineEdit.FileName, AFileName) <> 0 then
      Continue;
    NewLast := LineEdit.LastLine + LineEdit.Delta;
    if Result < LineEdit.FirstLine then
      // выше правки - на месте
    else if Result > NewLast then
      Result := Result - LineEdit.Delta
    else if (Result = LineEdit.FirstLine) and LineEdit.KeepFirst then
      // та же строка, правка правее её начала
    else if Result = NewLast then
      Result := LineEdit.LastLine
    else
    begin
      Result := -1;
      Exit;
    end;
  end;
end;

procedure TForm1.DbgClearExec;
begin
  // Программа пошла или снята - подсказки со значением больше нет
  if FDbgHintTimer <> nil then
    FDbgHintTimer.Enabled := False;
  DbgHintHide;
  if FDbgExecFile = '' then
    Exit;
  FDbgExecFile := '';
  FDbgExecLine := -1;
  DbgRepaint;
end;

// F9, Ctrl+F2, F5, Ctrl+F5, F7, F8, F4 - True, если клавиша отладчика и
// она обработана
function TForm1.DbgKey(AKey: Word): Boolean;
var
  CtrlDown: Boolean;
begin
  Result := False;
  if (GetKeyState(VK_SHIFT) < 0) or (GetKeyState(VK_MENU) < 0) then
    Exit;
  CtrlDown := GetKeyState(VK_CONTROL) < 0;
  if (AKey = VK_F9) and not CtrlDown then
  begin
    if (btnCompileRun <> nil) and btnCompileRun.Enabled then
      btnCompileRunClick(btnCompileRun);
    Result := True;
  end
  else if (AKey = VK_F2) and CtrlDown then
  begin
    ProgramResetClick(btnProgReset);
    Result := True;
  end
  else if (AKey = VK_F5) and not CtrlDown and (ActiveControl = RichEdit1) then
  begin
    DbgToggleBreak(CurrentLineIndex);
    Result := True;
  end
  else if (AKey = VK_F5) and CtrlDown and (ActiveControl = RichEdit1) then
  begin
    // Add Watch, как в Delphi: имя под кареткой - в окно Watch
    DbgAddWatch(DbgExprAtCaret);
    Result := True;
  end
  else if (AKey = VK_F7) and not CtrlDown then
  begin
    if DbgCanStep then
      DbgStepInto;
    Result := True;
  end
  else if (AKey = VK_F8) and not CtrlDown then
  begin
    if DbgCanStep then
      DbgStepOver;
    Result := True;
  end
  else if (AKey = VK_F4) and not CtrlDown and (ActiveControl = RichEdit1) then
  begin
    if DbgCanStep then
      DbgRunToCursor;
    Result := True;
  end;
end;

// F3 в редакторе - следующее вхождение, Shift+F3 - предыдущее. Выделенный
// фрагмент (в пределах одной строки) сначала становится образцом поиска:
// он попадает в поле Find и в историю. Без выделения ищется то, что уже
// стоит в поле. Дальше - как по кнопкам Find-> и <-Find, вместе со
// списком совпадений при галке List.
function TForm1.FindKey(AKey: Word): Boolean;
var
  SelTxt: string;
begin
  Result := False;
  if (AKey <> VK_F3) or (GetKeyState(VK_CONTROL) < 0) or
     (GetKeyState(VK_MENU) < 0) or (ActiveControl <> RichEdit1) then
    Exit;
  Result := True;

  if RichEdit1.SelLength > 0 then
  begin
    // Не RichEdit1.SelText: его чтение портит память (см. SelTextA)
    SelTxt := SelTextA(255);
    if (SelTxt <> '') and (Pos(#13, SelTxt) = 0) and (Pos(#10, SelTxt) = 0) then
    begin
      cmbFind.Text := SelTxt;
      // В режиме перехода по строке образец - номер; выделенный текст
      // ищем обычным поиском
      if cmbMode.ItemIndex = 2 then
        cmbMode.ItemIndex := 0;
    end;
  end;

  if cmbFind.Text = '' then
    Exit;
  if GetKeyState(VK_SHIFT) < 0 then
    DoFindPrev(nil)
  else
    DoFindNext(nil);
end;

// Снимок до правки - как у ObjLinesPre, но свой: точки есть в любом файле,
// не только в модуле формы из инспектора
procedure TForm1.DbgLinesPre(const Message: TMessage; AWhole: Boolean);
var
  Sel: TCharRange;
begin
  FDbgPreValid := False;
  // Undo, Redo, замена текста целиком: где правка - неизвестно, номера
  // остаются как были
  // Во время сеанса отладки - любой файл: остановка может прийти в него,
  // и строку из .map надо будет сдвинуть на правки (FDbgEdits)
  // Закладки окна тоже едут с текстом - их метки на полосе (MarksBox)
  if AWhole or not RichEdit1.HandleAllocated or
     (not DbgMarksInCurrent and
      ((FWindowsIndex < 0) or not FWindows[FWindowsIndex].Used or
       (Length(FWindows[FWindowsIndex].Bookmarks) = 0)) and
      ((((FDbgSession = nil) or FDbgSession.Finished) and
        (FRqDbgExe = '')) or (FCurrentFileName = ''))) then
    Exit;
  SendMessageA(RichEdit1.Handle, EM_EXGETSEL, 0, Integer(@Sel));
  FDbgPreMin := Sel.cpMin;
  FDbgPreMax := Sel.cpMax;
  FDbgPreLen := TextLenInternal;
  FDbgPreLines := SendMessageA(RichEdit1.Handle, EM_GETLINECOUNT, 0, 0);
  FDbgPreLineMin := SendMessageA(RichEdit1.Handle, EM_EXLINEFROMCHAR, 0,
                                 Sel.cpMin);
  FDbgPreLineMax := SendMessageA(RichEdit1.Handle, EM_EXLINEFROMCHAR, 0,
                                 Sel.cpMax);
  FDbgPreStartMin := SendMessageA(RichEdit1.Handle, EM_LINEINDEX,
                                  FDbgPreLineMin, 0);
  FDbgPreValid := True;
end;

// Правка сделана: номера строк точек и строки остановки за правкой
// сдвигаются. Правило то же, что у ObjLinesPost.
procedure TForm1.DbgLinesPost;
var
  NewLines, Delta, NewLen, EditStart, FirstLine, LastLine, FirstStart: Integer;
  Removed, MarkIdx, DupIdx: Integer;
  OldLineNo, NewLineNo: Integer;
  BmMoved: Boolean;
  Sel: TCharRange;
  Mark, Other: TBreakMark;
  LineEdit: TDbgLineEdit;

  function MoveLine(ALine: Integer): Integer;
  begin
    if ALine < FirstLine then
      Result := ALine
    else if ALine > LastLine then
      Result := ALine + Delta
    else if (ALine = FirstLine) and (FirstStart < EditStart) then
      Result := ALine             // начало строки левее правки - на месте
    else if ALine = LastLine then
      Result := ALine + Delta     // строка начиналась там, где правка кончилась
    else
      Result := FirstLine;        // строка удалена целиком
  end;

begin
  if not FDbgPreValid then
    Exit;
  FDbgPreValid := False;
  if not RichEdit1.HandleAllocated then
    Exit;
  NewLines := SendMessageA(RichEdit1.Handle, EM_GETLINECOUNT, 0, 0);
  Delta := NewLines - FDbgPreLines;
  if Delta = 0 then
    Exit;
  NewLen := TextLenInternal;
  SendMessageA(RichEdit1.Handle, EM_EXGETSEL, 0, Integer(@Sel));

  if FDbgPreMin < FDbgPreMax then
  begin
    // Было выделение - оно и заменено
    EditStart := FDbgPreMin;
    FirstLine := FDbgPreLineMin;
    FirstStart := FDbgPreStartMin;
    LastLine := FDbgPreLineMax;
  end
  else if NewLen >= FDbgPreLen then
  begin
    // Вставка в точку каретки
    EditStart := FDbgPreMin;
    FirstLine := FDbgPreLineMin;
    FirstStart := FDbgPreStartMin;
    LastLine := FirstLine;
  end
  else
  begin
    // Удаление без выделения: BackSpace - левее каретки, Delete - правее
    Removed := FDbgPreLen - NewLen;
    if Sel.cpMin < FDbgPreMin then
      EditStart := FDbgPreMin - Removed
    else
      EditStart := FDbgPreMin;
    FirstLine := SendMessageA(RichEdit1.Handle, EM_EXLINEFROMCHAR, 0,
                              EditStart);
    FirstStart := SendMessageA(RichEdit1.Handle, EM_LINEINDEX, FirstLine, 0);
    LastLine := FirstLine - Delta;
  end;

  for MarkIdx := 0 to FBreakMarks.Count - 1 do
  begin
    Mark := TBreakMark(FBreakMarks[MarkIdx]);
    if CompareText(Mark.FileName, FCurrentFileName) = 0 then
      Mark.Line := MoveLine(Mark.Line);
  end;

  // Строки слились - две точки на одной, остаётся одна
  for MarkIdx := FBreakMarks.Count - 1 downto 1 do
  begin
    Mark := TBreakMark(FBreakMarks[MarkIdx]);
    for DupIdx := 0 to MarkIdx - 1 do
    begin
      Other := TBreakMark(FBreakMarks[DupIdx]);
      if (Other.Line = Mark.Line) and
         (CompareText(Other.FileName, Mark.FileName) = 0) then
      begin
        DbgMarkOff(Mark);
        FBreakMarks.Delete(MarkIdx);
        Mark.Free;
        Break;
      end;
    end;
  end;

  if (FDbgExecFile <> '') and
     (CompareText(FDbgExecFile, FCurrentFileName) = 0) then
    FDbgExecLine := MoveLine(FDbgExecLine);

  // Закладки окна (номера с 1): строка и позиция едут вместе с текстом,
  // подписи в меню Bookmarks - с новыми номерами
  if (FWindowsIndex >= 0) and FWindows[FWindowsIndex].Used then
  begin
    BmMoved := False;
    for MarkIdx := 0 to High(FWindows[FWindowsIndex].Bookmarks) do
    begin
      OldLineNo := FWindows[FWindowsIndex].Bookmarks[MarkIdx].LineNo;
      NewLineNo := MoveLine(OldLineNo - 1) + 1;
      if NewLineNo <> OldLineNo then
      begin
        FWindows[FWindowsIndex].Bookmarks[MarkIdx].LineNo := NewLineNo;
        FWindows[FWindowsIndex].Bookmarks[MarkIdx].CharPos :=
          SendMessageA(RichEdit1.Handle, EM_LINEINDEX, NewLineNo - 1, 0);
        BmMoved := True;
      end;
    end;
    // Подписи пунктов - на месте, без пересборки меню: это каждая правка
    // с переводом строки выше закладок
    if BmMoved then
    begin
      BmMenuCaptionsUpdate;
      if MarksBox <> nil then
        MarksBox.Invalidate;
    end;
  end;

  // Правка за сеанс - для перевода строк .map в нынешние номера и обратно.
  // RapidQ - с отладочной сборки: номера точек копии - по её тексту.
  if (((FDbgSession <> nil) and not FDbgSession.Finished) or
      (FRqDbgExe <> '')) and (FCurrentFileName <> '') then
  begin
    if FDbgEdits = nil then
      FDbgEdits := TList.Create;
    LineEdit := TDbgLineEdit.Create;
    LineEdit.FileName := FCurrentFileName;
    LineEdit.FirstLine := FirstLine;
    LineEdit.LastLine := LastLine;
    LineEdit.Delta := Delta;
    LineEdit.KeepFirst := FirstStart < EditStart;
    FDbgEdits.Add(LineEdit);
  end;

  if PaintBox1 <> nil then
    PaintBox1.Invalidate;
end;

// Файл с ошибкой по имени из сообщения компилятора.
//
// В сообщении стоит только имя: dcc32 пути не пишет. Ищем там же и в том
// же порядке, в каком искал сам компилятор:
//   1. папка собираемого .dpr;
//   2. папки из -U этой сборки, по порядку;
//   3. папка активного файла - если лога сборки ещё не было.
//
// Порядок важен: одноимённые файлы в разных папках - обычное дело, и
// открыться должен тот, который компилятор и разбирал.
//
// AWhere получает перечень просмотренных мест - его показываем, когда файл
// не нашёлся: так видно, где именно его нет.
function TForm1.ResolveErrorFile(const AName: string;
                                 var AWhere: string): string;
var
  Rest, V: string;
  P: Integer;

  // Кандидат: файл есть - кладём путь в AFull. Иначе место уходит в
  // перечень просмотренных.
  function Probe(const ADir: string; var AFull: string): Boolean;
  var
    Full: string;
  begin
    Result := False;
    if ADir = '' then
      Exit;

    Full := IncludeTrailingPathDelimiter(ADir) + AName;
    if FileExists(Full) then
    begin
      AFull := Full;
      Result := True;
      Exit;
    end;

    if AWhere <> '' then
      AWhere := AWhere + #13#10;
    AWhere := AWhere + ExcludeTrailingPathDelimiter(ADir);
  end;

begin
  Result := '';
  AWhere := '';
  if AName = '' then
    Exit;

  // Путь в имени уже есть - искать нечего
  if ExtractFilePath(AName) <> '' then
  begin
    if FileExists(AName) then
      Result := AName
    else
      AWhere := AName;
    Exit;
  end;

  if Probe(FLastBuildDir, Result) then
    Exit;

  Rest := FLastUnitPath;
  while Rest <> '' do
  begin
    P := Pos(';', Rest);
    if P > 0 then
    begin
      V := Trim(Copy(Rest, 1, P - 1));
      Rest := Copy(Rest, P + 1, Length(Rest));
    end
    else
    begin
      V := Trim(Rest);
      Rest := '';
    end;

    if V = '' then
      Continue;
    if Probe(V, Result) then
      Exit;
  end;

  Probe(ExtractFilePath(FCurrentFileName), Result);
end;

// Двойной щелчок по строке лога: если это сообщение компилятора - открываем
// файл и встаём на нужную строку. Файл ищется рядом с компилируемым: dcc32
// пишет только имя, без пути.
// Лог компиляции - в файл AFile (перезаписывается), строкой в лог - путь
// к нему. Щелчок по этой строке копирует путь (LogEditClick).
// Текст - целиком через Text (WM_GETTEXT) и простым текстом: Lines.SaveToFile
// у TRichEdit без PlainText пишет RTF.
procedure TForm1.SaveCompileLog(const AFile: string);
var
  LogLines: TStringList;
begin
  if (CompLogEdit = nil) or (AFile = '') then
    Exit;
  LogLines := TStringList.Create;
  try
    try
      LogLines.Text := CompLogEdit.Text;
      ForceDirectories(ExtractFilePath(AFile));
      LogLines.SaveToFile(AFile);
    except
      on E: Exception do
      begin
        LogComp('Лог компиляции не сохранён: ' + AFile + ' (' + E.Message +
        ')');
                Exit;
      end;
    end;
  finally
    LogLines.Free;
  end;
  LogComp(LogSavedTag + AFile);
end;

// Окна логов в порядке вкладок и окончания имён их файлов (SaveAllLogs)
const
  LogFileCount = 4;
  LogFileSuffix: array[0..LogFileCount - 1] of string =
    ('_compile.log', '_error.log', '_hilite.log', '_runtime.log');

  // Есть ли в каком-нибудь логе текст - пункт меню Save all logs
function TForm1.AnyLogFilled: Boolean;
var
  LogBoxes: array[0..LogFileCount - 1] of TRichEdit;
  LogIdx: Integer;
begin
  Result := False;
  LogBoxes[0] := CompLogEdit;
  LogBoxes[1] := ErrLogEdit;
  LogBoxes[2] := LogEdit;
  LogBoxes[3] := RuntimeLog;
  for LogIdx := 0 to LogFileCount - 1 do
    if (LogBoxes[LogIdx] <> nil) and LogBoxes[LogIdx].HandleAllocated and
       (GetWindowTextLength(LogBoxes[LogIdx].Handle) > 0) then
    begin
      Result := True;
      Exit;
    end;
end;

// Меню логов - Save all logs: каждый непустой лог (Compilation, Error,
// HiLite, Runtime) - своим файлом рядом с файлом активной вкладки:
// <имя>_compile.log, <имя>_error.log, <имя>_hilite.log, <имя>_runtime.log.
// Нет открытого файла - в папке редактора, unide_*.log. Лог из одних
// пробелов и пустых строк пустым и считается. Файлы перезаписываются.
// Итог - строками "Лог сохранён: путь" в Compilation log (щелчок по
// строке - путь в буфер обмена); пишутся после записи всех файлов, в
// файл Compilation log они не попадают.
procedure TForm1.SaveAllLogs;
var
  LogBoxes: array[0..LogFileCount - 1] of TRichEdit;
  BaseName, LogFile: string;
  LogLines, SavedFiles, FailedFiles: TStringList;
  LogIdx, FileIdx: Integer;
begin
  LogBoxes[0] := CompLogEdit;
  LogBoxes[1] := ErrLogEdit;
  LogBoxes[2] := LogEdit;
  LogBoxes[3] := RuntimeLog;
  if FCurrentFileName <> '' then
    BaseName := ChangeFileExt(FCurrentFileName, '')
  else
    BaseName := ExtractFilePath(Application.ExeName) + 'unide';

  LogLines := TStringList.Create;
  SavedFiles := TStringList.Create;
  FailedFiles := TStringList.Create;
  try
    for LogIdx := 0 to LogFileCount - 1 do
    begin
      if LogBoxes[LogIdx] = nil then
        Continue;
      LogLines.Text := LogBoxes[LogIdx].Text;
      if Trim(LogLines.Text) = '' then
        Continue;
      LogFile := BaseName + LogFileSuffix[LogIdx];
      try
        ForceDirectories(ExtractFilePath(LogFile));
        LogLines.SaveToFile(LogFile);
        SavedFiles.Add(LogFile);
      except
        on ErrInfo: Exception do
          FailedFiles.Add(LogFile + ' (' + ErrInfo.Message + ')');
      end;
    end;

    ShowCompLog;
    if (SavedFiles.Count = 0) and (FailedFiles.Count = 0) then
      LogComp('Save all logs: все логи пустые, сохранять нечего');
    for FileIdx := 0 to SavedFiles.Count - 1 do
      LogComp(LogSavedTag + SavedFiles[FileIdx]);
    for FileIdx := 0 to FailedFiles.Count - 1 do
      LogComp('Лог не сохранён: ' + FailedFiles[FileIdx]);
  finally
    FailedFiles.Free;
    SavedFiles.Free;
    LogLines.Free;
  end;
end;

// Щелчок по строке "Лог сохранён: путь" - путь в буфер обмена
procedure TForm1.LogEditClick(Sender: TObject);
var
  LineIdx, TextStart: Integer;
  LineText, FilePath: string;
  LogBox: TRichEdit;
begin
  if not (Sender is TRichEdit) then
    Exit;
  LogBox := TRichEdit(Sender);
  LineIdx := SendMessageA(LogBox.Handle, EM_LINEFROMCHAR, LogBox.SelStart, 0);
  if (LineIdx < 0) or (LineIdx >= LogBox.Lines.Count) then
    Exit;
  LineText := LogBox.Lines[LineIdx];
  // Время в начале строки - отрезаем, как в LogEditDblClick
  TextStart := Pos('  ', LineText);
  if (TextStart > 0) and (TextStart <= 10) then
    LineText := Copy(LineText, TextStart + 2, Length(LineText));
  if Copy(LineText, 1, Length(LogSavedTag)) <> LogSavedTag then
    Exit;
  FilePath := Trim(Copy(LineText, Length(LogSavedTag) + 1, MaxInt));
  if FilePath = '' then
    Exit;
  Clipboard.AsText := FilePath;
  LogComp('Путь скопирован в буфер обмена: ' + FilePath);
end;

procedure TForm1.LogEditDblClick(Sender: TObject);
var
  LineIdx, Start: Integer;
  S, FName, Full, Where: string;
  ErrLine, K: Integer;
  E: TRichEdit;
  W: TStringList;
begin
  // Строку берём у того окна, по которому щёлкнули: обработчик висит на
  // окне компиляции, но привязка к конкретному полю тут не нужна
  if Sender is TRichEdit then
    E := TRichEdit(Sender)
  else
    E := CompLogEdit;
  if E = nil then
    Exit;

  LineIdx := SendMessageA(E.Handle, EM_LINEFROMCHAR, E.SelStart, 0);
  if (LineIdx < 0) or (LineIdx >= E.Lines.Count) then
    Exit;
  S := E.Lines[LineIdx];

  // В начале строки лога стоит время - отрезаем его
  Start := Pos('  ', S);
  if (Start > 0) and (Start <= 10) then
    S := Copy(S, Start + 2, Length(S));

  if not ParseCompilerLine(S, FName, ErrLine) then
    Exit;

  Full := ResolveErrorFile(FName, Where);
  if Full = '' then
  begin
    LogComp('Файл ' + FName + ' не найден. Искали в:');
    W := TStringList.Create;
    try
      W.Text := Where;
      for K := 0 to W.Count - 1 do
        LogComp('    ' + W[K]);
    finally
      W.Free;
    end;
    Exit;
  end;

  OpenNamedFile(Full);
  GotoLine(ErrLine - 1);
  RichEdit1.SetFocus;
end;

// Отладочная строка в HiLite log, цветом (по умолчанию красным). Как
// AddClrString в RapidQ: Dbg('27578: FileName = ' + FileName);
// Номер строки в начале текста ставится так же, как у сообщений.
procedure TForm1.Dbg(const S: string; AColor: TColor);
begin
  LogTo(LogEdit, S, AColor);
end;

procedure AddClrString(const AddString: string; Clr: TColor; Sender: TRichEdit);
begin
  if (Form1 = nil) or (Sender = nil) then
    Exit;
  Form1.LogTo(Sender, AddString, Clr);
end;

// ---------------------------------------------------------------------------
//  Меню редактора: Debug, Clear, To UpperCase, To LowerCase
// ---------------------------------------------------------------------------

// Язык отладочной строки по схеме файла: 'pas', 'bas' или '' - не умеем.
// Схема, а не расширение: .dpr, .pp, .inc идут по pas.clr (см. SchemeExtFor).
function TForm1.DebugLang: string;
var
  E: string;
begin
  E := LowerCase(ChangeFileExt(ExtractFileName(ActiveSchemaFile), ''));
  if E = 'pas' then
    Result := 'pas'
  else if E = 'bas' then
    Result := 'bas'
  else
    Result := '';
end;

// Выражение под кареткой: имя с точками (Obj.Field), в Basic и с $
function TForm1.ExprAtCaret(ABasic: Boolean): string;
var
  P, LineIdx, LineStart, Col, A, B: Integer;
  S: string;
  Ch: set of Char;
begin
  Result := '';
  Ch := ['A'..'Z', 'a'..'z', '0'..'9', '_', '.'];
  if ABasic then
    Ch := Ch + ['$'];
  P := RichEdit1.SelStart;
  LineIdx := SendMessage(RichEdit1.Handle, EM_LINEFROMCHAR, P, 0);
  if (LineIdx < 0) or (LineIdx >= RichEdit1.Lines.Count) then
    Exit;
  LineStart := SendMessage(RichEdit1.Handle, EM_LINEINDEX, LineIdx, 0);
  S := RichEdit1.Lines[LineIdx];
  Col := P - LineStart + 1;
  if (Col < 1) or (Col > Length(S) + 1) then
    Exit;

  A := Col;
  if (A > Length(S)) or not (S[A] in Ch) then
    Dec(A);
  if (A < 1) or (A > Length(S)) or not (S[A] in Ch) then
    Exit;
  B := A;
  while (A > 1) and (S[A - 1] in Ch) do
    Dec(A);
  while (B < Length(S)) and (S[B + 1] in Ch) do
    Inc(B);
  Result := Copy(S, A, B - A + 1);
  while (Result <> '') and (Result[1] = '.') do
    Delete(Result, 1, 1);
  while (Result <> '') and (Result[Length(Result)] = '.') do
    Delete(Result, Length(Result), 1);
  if (Result <> '') and (Result[1] in ['0'..'9']) then
    Result := ''; // число, не имя
end;

// Что выводить: выделение в одну строку, без него - выражение под кареткой
function TForm1.DebugExpr(const ALang: string): string;
begin
  Result := Trim(SelTextA(200));
  if (Pos(#13, Result) > 0) or (Pos(#10, Result) > 0) then
    Result := '';
  if Result = '' then
    Result := ExprAtCaret(ALang = 'bas');
end;

// Под строкой, где стоит выделенная переменная, - строка вывода её
// значения, с тем же отступом. Номер - строки переменной, как у сообщений.
//   Паскаль: AddClrString('917:Name=' + VarToStr(Name), clRed, Form1.RuntimeLog);
//   RapidQ:  call  AddClrString ("917:Name="+str$(Name), clred, LogEdit)
// Элемент массива - с индексом в подписи: 'A[' + VarToStr(I) + ']='.
// В Паскале VarToStr: значение любого простого типа строкой (модуль
// Variants). Объект, запись или перечисление так не выводятся - строку
// надо поправить руками.
procedure TForm1.DebugLineClick(Sender: TObject);
var
  Lang, Expr, Lab, Val, Ins, Ind, Cur, Low, N, OB, CB: string;
  Sel: TCharRange;
  Line, LS, LL, A, B, K: Integer;
  Basic: Boolean;

  // Апостроф внутри паскалевской строки - двойной
  function Q(const S: string): string;
  begin
    Result := StringReplace(S, '''', '''''', [rfReplaceAll]);
  end;

begin
  Lang := DebugLang;
  if Lang = '' then
    Exit;
  Expr := DebugExpr(Lang);
  if Expr = '' then
    Exit;
  Basic := Lang = 'bas';

  SendMessageA(RichEdit1.Handle, EM_EXGETSEL, 0, Integer(@Sel));
  Line := SendMessageA(RichEdit1.Handle, EM_EXLINEFROMCHAR, 0, Sel.cpMin);
  LS := SendMessageA(RichEdit1.Handle, EM_LINEINDEX, Line, 0);
  if LS < 0 then
    Exit;
  LL := SendMessageA(RichEdit1.Handle, EM_LINELENGTH, LS, 0);
  Cur := ReadLineText(Line, LS, LL);
  K := 1;
  while (K <= Length(Cur)) and (Cur[K] in [' ', #9]) do
    Inc(K);
  Ind := Copy(Cur, 1, K - 1);
  N := IntToStr(Line + 1);

  // Индекс массива: A(i) в Basic, A[I] в Паскале
  if Basic then
  begin
    OB := '(';
    CB := ')';
  end
  else
  begin
    OB := '[';
    CB := ']';
  end;
  A := Pos(OB, Expr);
  B := 0;
  if A > 1 then
    B := PosEx(CB, Expr, A + 1);

  if Basic then
  begin
    // Строковое значение - как есть, иначе через str$ (так в RQdebugger)
    Low := LowerCase(Expr);
    if (Low[Length(Low)] = '$') or (Pos('.text', Low) > 0) or
       (Pos('.cell', Low) > 0) or (Pos('.caption', Low) > 0) or
       (Pos('.line', Low) > 0) or (Pos('directory', Low) > 0) then
      Val := '+('
    else
      Val := '+str$(';
    if B > A then
      Lab := '"' + N + ':' + Copy(Expr, 1, A - 1) + '("+str$(' +
             Copy(Expr, A + 1, B - A - 1) + ')+")' +
             Copy(Expr, B + 1, MaxInt) + '="'
    else
      Lab := '"' + N + ':' + Expr + '="';
    Ins := 'call  AddClrString (' + Lab + Val + Expr + '), clred, LogEdit)';
  end
  else
  begin
    if B > A then
      Lab := '''' + N + ':' + Q(Copy(Expr, 1, A - 1)) + '['' + VarToStr(' +
             Copy(Expr, A + 1, B - A - 1) + ') + '']' +
             Q(Copy(Expr, B + 1, MaxInt)) + '='''
    else
      Lab := '''' + N + ':' + Q(Expr) + '=''';
    Ins := 'AddClrString(' + Lab + ' + VarToStr(' + Expr +
    '), clRed, Form1.RuntimeLog);';
  end;

  // В конец строки переменной - перевод строки и новая строка. Одна
  // замена - один шаг Undo.
  Sel.cpMin := LS + LL;
  Sel.cpMax := Sel.cpMin;
  SendMessageA(RichEdit1.Handle, EM_EXSETSEL, 0, Integer(@Sel));
  SendMessageA(RichEdit1.Handle, EM_REPLACESEL, 1,
               Integer(PChar(#13#10 + Ind + Ins)));
  UpdateStatusBarInfo;
end;

// Весь текст окна. Замена выделения, а не Clear: так её возвращает Undo.
procedure TForm1.ClearAllClick(Sender: TObject);
begin
  if RichEdit1.GetTextLen = 0 then
    Exit;
  if MessageDlg('27765:Удалить весь текст окна? Вернуть можно через Undo.',
                mtConfirmation, [mbYes, mbNo], 0) <> mrYes then
    Exit;
  RichEdit1.SelectAll;
  SendMessageA(RichEdit1.Handle, EM_REPLACESEL, 1, Integer(PChar('')));
  UpdateStatusBarInfo;
end;

// Границы слова под кареткой; False - каретка не на слове
function TForm1.WordRangeAtCaret(var ASel: TCharRange): Boolean;
var
  P, LineIdx, LineStart, Col, A, B: Integer;
  S: string;
const
  Ch = ['A'..'Z', 'a'..'z', '0'..'9', '_', #192..#255, #168, #184];
begin
  Result := False;
  P := RichEdit1.SelStart;
  LineIdx := SendMessage(RichEdit1.Handle, EM_LINEFROMCHAR, P, 0);
  if (LineIdx < 0) or (LineIdx >= RichEdit1.Lines.Count) then
    Exit;
  LineStart := SendMessage(RichEdit1.Handle, EM_LINEINDEX, LineIdx, 0);
  S := RichEdit1.Lines[LineIdx];
  Col := P - LineStart + 1;
  if (Col < 1) or (Col > Length(S) + 1) then
    Exit;
  A := Col;
  if (A > Length(S)) or not (S[A] in Ch) then
    Dec(A);
  if (A < 1) or (A > Length(S)) or not (S[A] in Ch) then
    Exit;
  B := A;
  while (A > 1) and (S[A - 1] in Ch) do
    Dec(A);
  while (B < Length(S)) and (S[B + 1] in Ch) do
    Inc(B);
  ASel.cpMin := LineStart + A - 1;
  ASel.cpMax := LineStart + B;
  Result := True;
end;

// To UpperCase / To LowerCase: выделение, без него - слово под кареткой.
// Замена идёт через ANSI (EM_REPLACESEL окна VCL), поэтому символы вне
// кодовой страницы Windows пропали бы - такое выделение не меняем.
procedure TForm1.CaseConvertClick(Sender: TObject);
var
  Sel: TCharRange;
  S, T: string;
  W: WideString;
  TR: TGetTextRange;
  Got, N: Integer;
  Lost: BOOL;
begin
  SendMessageA(RichEdit1.Handle, EM_EXGETSEL, 0, Integer(@Sel));
  if Sel.cpMax <= Sel.cpMin then
    if not WordRangeAtCaret(Sel) then
      Exit;
  N := Sel.cpMax - Sel.cpMin;

  if MsftEditActive then
  begin
    SetLength(W, N + 1);
    FillChar(W[1], (N + 1) * SizeOf(WideChar), 0);
    TR.chrg := Sel;
    TR.lpstrText := PChar(PWideChar(W));
    Got := SendMessageA(RichEdit1.Handle, EM_GET_TEXTRANGE, 0, Integer(@TR));
    if Got <= 0 then
      Exit;
    Lost := False;
    WideCharToMultiByte(CP_ACP, 0, PWideChar(W), Got, nil, 0, nil, @Lost);
    if Lost then
    begin
      ShowMessage('27837:В выделении есть символы вне кодовой страницы ' +
      'Windows - регистр у такого текста здесь не меняется.');
                  Exit;
    end;
  end;

  S := TextRange(Sel.cpMin, N);
  if Sender = pmuUpper then
    T := AnsiUpperCase(S)
  else
    T := AnsiLowerCase(S);
  if T = S then
    Exit;

  SendMessageA(RichEdit1.Handle, EM_EXSETSEL, 0, Integer(@Sel));
  SendMessageA(RichEdit1.Handle, EM_REPLACESEL, 1, Integer(PChar(T)));
  // Изменённый кусок остаётся выделенным
  SendMessageA(RichEdit1.Handle, EM_EXSETSEL, 0, Integer(@Sel));
  UpdateStatusBarInfo;
end;

procedure TForm1.LogDiag(const S: string);
begin
  if S = FLastDiag then
    Exit;
  FLastDiag := S;
  LogTo(LogEdit, S);
end;

// Дописывание строки в любое из окон лога: время, текст, обрезка старого.
//
// Окно ограничено LogMaxLines строками: при превышении срезается старое.
// Без EM_EXLIMITTEXT у RichEdit предел по умолчанию, 32767 символов; после
// него дописывание молча перестало бы работать.
// Яркость цвета, 0..255
function UiLum(AColor: TColor): Integer;
var
  C: Longint;
begin
  C := ColorToRGB(AColor);
  Result := (GetRValue(C) * 299 + GetGValue(C) * 587 + GetBValue(C) * 114) div 1000;
end;

// Фон лога тёмный (IDE Dark и «Логи: фон» - тёмный)
function TForm1.UiLogIsDark(AEdit: TRichEdit): Boolean;
begin
  Result := FIdeDark and (AEdit <> nil) and (UiLum(AEdit.Color) < 128);
end;

// Цвет строки лога. Строки пишутся тёмно-синим, серым, красным, зелёным -
// под светлый фон. На тёмном фоне тёмный цвет смешивается с белым: оттенок
// тот же, читается. Обычный цвет текста (clNone) - текстом списков.
function TForm1.UiLogColor(AEdit: TRichEdit; AColor: TColor): TColor;
var
  C: Longint;
begin
  Result := AColor;
  if not UiLogIsDark(AEdit) then
    Exit;
  if (AColor = clNone) or (AColor = clWindowText) or (AColor = clBlack) then
  begin
    Result := UiColor('Ide.ListText');
    Exit;
  end;
  if UiLum(AColor) >= 150 then
    Exit;
  C := ColorToRGB(AColor);
  // 45% цвета и 55% белого
  Result := TColor(RGB((GetRValue(C) * 45 + 255 * 55) div 100,
                       (GetGValue(C) * 45 + 255 * 55) div 100,
                       (GetBValue(C) * 45 + 255 * 55) div 100));
end;

procedure TForm1.LogTo(AEdit: TRichEdit; const S: string; AColor: TColor);
const
  // Вывод компилятора у большого проекта - тысячи строк, а командная
  // строка стоит в самом начале: при прежних 500 её срезало первой
  LogMaxLines = 5000;
  LogCutLines = 1000;
  EM_EXLIMITTEXT = WM_USER + 53;
var
  Line, Txt: string;
  Cut, Len, K: Integer;
  H: HWND;
  Fmt: TCharFormat2;
begin
  if (AEdit = nil) or (AEdit.Parent = nil) or
     (csDestroying in ComponentState) then
    Exit;

  // Читая Handle, создаём окно, если его ещё нет. Проверять HandleAllocated
  // нельзя: у спрятанной вкладки окно может быть ещё не создано, и строка
  // пропала бы молча.
  H := AEdit.Handle;

  SendMessageA(H, EM_EXLIMITTEXT, 0, 1024 * 1024);

  if SendMessageA(H, EM_GETLINECOUNT, 0, 0) > LogMaxLines then
  begin
    Cut := SendMessageA(H, EM_LINEINDEX, LogCutLines, 0);
    if Cut > 0 then
    begin
      SendMessageA(H, EM_SETSEL, 0, Cut);
      SendMessageA(H, EM_REPLACESEL, 0, Integer(PChar('')));
    end;
  end;

  // Перевод строки внутри сообщения разорвал бы запись: время осталось бы
  // на своей строке, текст ушёл на следующую. dcc32 так и делает - возврат
  // каретки посреди строки у него обычное дело.
  Txt := S;
  for K := 1 to Length(Txt) do
    if (Txt[K] = #13) or (Txt[K] = #10) then
      Txt[K] := ' ';
  Txt := Trim(Txt);

  Line := FormatDateTime('hh:nn:ss', Now) + '  ' + Txt + #13#10;
  Len := AEdit.GetTextLen;
  SendMessageA(H, EM_SETSEL, Len, Len);

  // Цвет ставится пустому выделению в конце текста: вставленное им и
  // окрасится. Прежние строки не трогаются - в них своё оформление.
  // CFE_AUTOCOLOR возвращает обычный цвет окна, иначе красной осталась бы
  // и следующая строка.
  FillChar(Fmt, SizeOf(Fmt), 0);
  Fmt.cbSize := SizeOf(Fmt);
  Fmt.dwMask := CFM_COLOR;
  if (AColor = clNone) and not UiLogIsDark(AEdit) then
    Fmt.dwEffects := CFE_AUTOCOLOR
  else
    // На тёмном фоне лога - светлее (UiLogColor)
    Fmt.crTextColor := ColorToRGB(UiLogColor(AEdit, AColor));
  SendMessageA(H, EM_SETCHARFORMAT, SCF_SELECTION, Integer(@Fmt));

  SendMessageA(H, EM_REPLACESEL, 0, Integer(PChar(Line)));
  SendMessageA(H, EM_SCROLLCARET, 0, 0);
  // Прокрутка к последней строке. EM_SCROLLCARET привязан к каретке, а она
  // у окна лога без фокуса (фокус в редакторе) - одной его мало. SB_BOTTOM
  // от каретки и фокуса не зависит.
  SendMessageA(H, WM_VSCROLL, SB_BOTTOM, 0);
end;

// Ставит системную каретку с учётом FScrollX. Сдвиг не трогает.
//
// Нужна везде, где контрол мог сам поставить каретку по своей координате
// (прокрутка по вертикали, получение фокуса), и там, где сдвиг поменялся
// без движения каретки (полоса прокрутки).
//
// Позиция берётся от cpMin - так же, как было в EnsureCaretVisibleX. При
// выделении слева направо активный конец - cpMax, и каретка встанет на
// начало выделения.
procedure TForm1.SyncCaretX;
var
  Sel: TCharRange;
  Pt: TPoint;
begin
  // Каретка принадлежит окну с фокусом ввода - иначе ставить нечего
  if not RichEdit1.HandleAllocated or not RichEdit1.Focused then
    Exit;

  SendMessageA(RichEdit1.Handle, EM_EXGETSEL, 0, Integer(@Sel));
  Pt := CaretPoint(Sel.cpMin);

  // Каретку рисуем всегда сами. Системной управляет контрол, и правее своей
  // ширины (EditorFixedWidth) он её прячет - по его мнению, она вне окна.
  // Системная уводится за край: её прячет и HideCaret при получении фокуса,
  // но контрол может создать каретку заново.
  SetCaretPos(-100, -100);
  MoveOwnCaret(Point(Pt.X - FScrollX, Pt.Y), True);
end;

// Прямоугольник каретки инвертируется: второй вызов в той же точке её стирает
procedure TForm1.XorOwnCaret(DC: HDC; const P: TPoint);
const
  SPI_GETCARETWIDTH_ = $2006;
var
  W, H: Integer;
begin
  // Не уже системной, если в Windows она задана толще
  W := 0;
  if not SystemParametersInfo(SPI_GETCARETWIDTH_, 0, @W, 0) or
     (W < OwnCaretWidth) then
    W := OwnCaretWidth;
  H := LineHeight;
  if H <= 0 then
    H := 16;
  PatBlt(DC, P.X, P.Y, W, H, DSTINVERT);
end;

// Своя каретка: стереть на старом месте, запомнить новое, при AOn
// нарисовать и перезапустить мигание.
//
// Что на экране, помнит FOwnCaretDrawn. Отрисовка кадра (PaintDoubleBuffered)
// кладёт каретку в буфер ровно по этому флагу, так что после любой
// перерисовки экран с ним согласован, и следующее инвертирование верно.
procedure TForm1.MoveOwnCaret(const P: TPoint; AOn: Boolean);
var
  DC: HDC;
begin
  if not RichEdit1.HandleAllocated then
    Exit;

  if not AOn and not FOwnCaretOn and not FOwnCaretDrawn then
    Exit;

  DC := GetDC(RichEdit1.Handle);
  try
    if FOwnCaretDrawn then
      XorOwnCaret(DC, FOwnCaretPt);
    FOwnCaretDrawn := False;
    FOwnCaretOn := AOn;
    FOwnCaretPt := P;
    if AOn then
    begin
      XorOwnCaret(DC, P);
      FOwnCaretDrawn := True;
    end;
  finally
    ReleaseDC(RichEdit1.Handle, DC);
  end;

  // Перезапуск: после движения каретка видна полный период
  FOwnCaretTimer.Enabled := False;
  if AOn then
  begin
    FOwnCaretTimer.Interval := GetCaretBlinkTime;
    FOwnCaretTimer.Enabled := True;
  end;
end;

// Стереть свою каретку, не меняя режима: перед прокруткой, которую контрол
// делает сдвигом пикселей, и при потере фокуса
procedure TForm1.HideOwnCaret;
var
  DC: HDC;
begin
  if not FOwnCaretDrawn or not RichEdit1.HandleAllocated then
    Exit;
  DC := GetDC(RichEdit1.Handle);
  try
    XorOwnCaret(DC, FOwnCaretPt);
  finally
    ReleaseDC(RichEdit1.Handle, DC);
  end;
  FOwnCaretDrawn := False;
end;

procedure TForm1.OwnCaretTick(Sender: TObject);
var
  DC: HDC;
begin
  if not FOwnCaretOn or not RichEdit1.HandleAllocated or
     not RichEdit1.Focused then
  begin
    HideOwnCaret;
    FOwnCaretTimer.Enabled := False;
    Exit;
  end;

  DC := GetDC(RichEdit1.Handle);
  try
    XorOwnCaret(DC, FOwnCaretPt);
  finally
    ReleaseDC(RichEdit1.Handle, DC);
  end;
  FOwnCaretDrawn := not FOwnCaretDrawn;
end;

// Позиция бегунка при перетаскивании - полная, 32-битная.
//
// WM_HSCROLL и WM_VSCROLL несут позицию в 16 битах, и VCL кладёт её в

procedure TForm1.VScrollChange(Sender: TObject);
begin
  if FLockScroll then
    Exit;

  ScrollEditTo(FVScroll.Position);
end;

procedure TForm1.HScrollChange(Sender: TObject);
begin
  if FLockScroll then
    Exit;
  SetScrollX(FHScroll.Position);
end;

// Отрисовка редактора одним кадром через теневой буфер.
//
// Без буфера картинка собиралась в два прохода прямо на экране: RichEdit рисовал
// текст СВОИМИ цветами, а следом мы клали подсветку через GetDC. Между проходами
// глаз успевал поймать неподсвеченный текст - это и было моргание, особенно
// заметное при автоскролле и горизонтальной прокрутке, когда контрол
// перерисовывает себя целиком.
//
// Здесь оба прохода идут в память, на экран уходит один BitBlt.
procedure TForm1.PaintDoubleBuffered;
var
  PerfT: Int64;
  PS: TPaintStruct;
  ScreenDC, MemDC: HDC;
  Bmp, OldBmp: HBITMAP;
  Br: HBRUSH;
  R: TRect;
  W, H: Integer;
  HadMarks: Boolean;
  FullDC: HDC;
  TextRc: TRect;
begin
  // Здесь НЕ НАДО вызывать InvalidateRect на всю клиентскую область.
  //
  // Такой вызов тут когда-то стоял: при прокрутке RichEdit сдвигает уже
  // нарисованные пиксели и помечает грязной только открывшуюся полосу, из-за
  // чего на стыке появлялся рваный шов. Расширение области обновления его
  // убирало, но обходилось дорого: вызов делался ВНУТРИ обработки WM_PAINT и
  // добавлял лишний проход перерисовки по всему дереву окон. Соседние контролы
  // - группа поиска и поле пути - начинали мерцать при ресайзе, причём только
  // ПОСЛЕ первой отрисовки редактора: до неё он в перерисовке не участвует,
  // ведь CS_HREDRAW у него снят.
  //
  // Шва при этом нет: HighlightVisibleText рисует всю видимую область в буфер,
  // а BitBlt кладёт его целиком, так что содержимое всегда согласовано.

  PerfT := PerfNow;
  // Метки направляющих у краёв окна (HighlightVisibleText): прокрутка
  // сдвигает готовые точки вместе с ними, а область обновления - только
  // открывшаяся полоса. Были метки в прошлом кадре или есть в этом - кадр
  // уходит на экран целиком, без отсечения по области обновления: старые
  // метки затираются, новые встают у краёв. Тот же один BitBlt, без
  // лишнего прохода перерисовки.
  HadMarks := Length(FGuideMarks) > 0;

  ScreenDC := BeginPaint(RichEdit1.Handle, PS);
  try
    Windows.GetClientRect(RichEdit1.Handle, R);

    // Ширину берём ВИДИМУЮ, а не у контрола: он растянут во весь рабочий
    // стол, и буфер на всю его ширину - это десятки мегабайт на каждый кадр.
    // Правее видимой области всё равно ничего не покажут.
    R.Right := ViewWidth;
    W := R.Right;
    H := R.Bottom;
    if (W <= 0) or (H <= 0) then
      Exit;

    MemDC := CreateCompatibleDC(ScreenDC);
    if MemDC = 0 then
      Exit;
    try
      Bmp := CreateCompatibleBitmap(ScreenDC, W, H);
      if Bmp = 0 then
        Exit;

      OldBmp := SelectObject(MemDC, Bmp);
      try
        // 1. Заливаем фоном редактора. Это ещё и страховка: если WM_PRINTCLIENT
        //    вдруг ничего не нарисует, получим правильный фон, а не чёрный экран.
        Br := CreateSolidBrush(ColorToRGB(RichEdit1.Color));
        try
          Windows.FillRect(MemDC, R, Br);
        finally
          DeleteObject(Br);
        end;

        // 2. Весь текст рисуем сами. Просить об этом RichEdit бесполезно:
        //    WM_PAINT с DC в wParam он игнорирует, WM_PRINTCLIENT в RICHED20
        //    тоже ничего не отдаёт. Данных у нас хватает - строка, таблица
        //    координат и цвета, - поэтому базовый слой кладёт HighlightVisibleText.
        //    Рисуем ВСЮ видимую область. Раньше здесь было отсечение по
        //    PS.rcPaint, и при прокрутке колесом (три строки за раз) запрошенная
        //    полоса переставала совпадать с тем, что реально положено в буфер -
        //    появляющиеся сверху строки выходили битыми. Для рисования прямо на
        //    экране отсечение гасило мерцание, но в буфере не даёт ничего.
        FPaintDC := MemDC;
        try
          HighlightVisibleText;
        finally
          FPaintDC := 0;
        end;

        // Линия правого поля (Editor Options - Margin and gutter)
        EdDrawRightMargin(MemDC, W, H);

        // Своя каретка - в кадр, если по флагу она сейчас на экране
        if FOwnCaretDrawn then
          XorOwnCaret(MemDC, FOwnCaretPt);

        // 3. Кадр на экран. ScreenDC от BeginPaint уже обрезан по области
        //    обновления, лишние пиксели GDI отсечёт сам.
        if HadMarks or (Length(FGuideMarks) > 0) then
        begin
          FullDC := GetDC(RichEdit1.Handle);
          try
            BitBlt(FullDC, 0, 0, W, H, MemDC, 0, 0, SRCCOPY);
          finally
            ReleaseDC(RichEdit1.Handle, FullDC);
          end;
        end
        else
        begin
          BitBlt(ScreenDC, 0, 0, W, H, MemDC, 0, 0, SRCCOPY);
          // Полоса под областью текста RichEdit (FitEditRect ставит её низ
          // на целое число строк, остаток до низа окна - до LineHeight-1
          // пикселей). При прокрутке RichEdit сдвигает и помечает грязной
          // только свою область текста, полоса в область обновления не
          // попадает, и в ней оставалась картинка прежнего кадра. Кладём её
          // из буфера всегда, мимо отсечения по области обновления.
          SendMessageA(RichEdit1.Handle, EM_GETRECT, 0, Integer(@TextRc));
          if (TextRc.Bottom > 0) and (TextRc.Bottom < H) then
          begin
            FullDC := GetDC(RichEdit1.Handle);
            try
              BitBlt(FullDC, 0, TextRc.Bottom, W, H - TextRc.Bottom,
                     MemDC, 0, TextRc.Bottom, SRCCOPY);
            finally
              ReleaseDC(RichEdit1.Handle, FullDC);
            end;
          end;
        end;
      finally
        SelectObject(MemDC, OldBmp);
        DeleteObject(Bmp);
      end;
    finally
      DeleteDC(MemDC);
    end;
  finally
    EndPaint(RichEdit1.Handle, PS);
  end;

  UpdateLineNumbers;

  // Номера рисуем СРАЗУ, вместе с кадром редактора.
  //
  // UpdateLineNumbers только помечает панель грязной, а WM_PAINT система
  // выдаёт, когда в очереди больше ничего нет, и сама выбирает, какому из
  // грязных окон. Пока редактор перерисовывается непрерывно (перетаскивание
  // полосы, колесо), панель могла подолгу ждать своей очереди.
  //
  // Update - это UpdateWindow у Panel1: рисует, только если там есть грязная
  // область, иначе ничего не стоит. Вызов здесь, а не в самой
  // UpdateLineNumbers: её зовут и из EN_SELCHANGE, пока контрол ещё не
  // закончил свою правку, и опрашивать его из отрисовки в этот момент рано.
  if PaintBox1 <> nil then
    PaintBox1.Update;

  UpdateScrollBars; // FMaxVisW к этому моменту уже посчитан отрисовкой
  FPerfPaint := PerfNow - PerfT;
end;

// Предел объёма текста - EditorTextLimit.
//
// Одного вызова в FormShow мало. Предел живёт в окне контрола, а окно
// пересоздаётся (например, при смене ScrollBars), и новое получает предел
// заново от VCL. Проверка дешёвая - одно сообщение, - поэтому она стоит
// перед каждым вводом, см. NewRichEditProc.
procedure TForm1.EnsureTextLimit;
const
  EM_GETLIMITTEXT = WM_USER + 37;
  EM_EXLIMITTEXT = WM_USER + 53;
begin
  if not RichEdit1.HandleAllocated then
    Exit;
  if Cardinal(SendMessageA(RichEdit1.Handle, EM_GETLIMITTEXT, 0, 0)) <
     Cardinal(EditorTextLimit) then
    SendMessageA(RichEdit1.Handle, EM_EXLIMITTEXT, 0, EditorTextLimit);
end;

// Запрет мягкого переноса строк.
//
// WordWrap = False контролу перенос не запрещает: замер показал, что строка
// шире 24575 пикселей разбивается им на несколько строк отображения без
// перевода в тексте (диагностика "перенос МЯГКИЙ"). EM_SETTARGETDEVICE с
// hdc = 0 и шириной 1 - это режим "без переноса"; тем же вызовом его
// включает MFC (CRichEditView, WrapNone).
//
// Установка перестраивает разметку всего текста, поэтому делается один раз
// на окно контрола. Окно пересоздаётся (смена ScrollBars и т.п.), и новое
// режим не помнит - отсюда проверка по FNoWrapHandle.
procedure TForm1.EnsureNoWrap;
const
  EM_SETTARGETDEVICE_ = WM_USER + 72;
begin
  if not RichEdit1.HandleAllocated then
    Exit;
  if FNoWrapHandle = RichEdit1.Handle then
    Exit;
  FNoWrapHandle := RichEdit1.Handle;
  // ДИАГНОСТИКА: ненулевой ответ - контрол режим принял
  LogDiag('EM_SETTARGETDEVICE(0, 1) = ' +
          IntToStr(SendMessageA(RichEdit1.Handle, EM_SETTARGETDEVICE_, 0, 1)) +
  ', окно ' + IntToHex(RichEdit1.Handle, 8));
end;

// Сообщения, после которых текст или его метрика могут стать другими
function IsTextChangeMsg(Msg: Cardinal): Boolean;
begin
  case Msg of
    WM_CHAR, WM_KEYDOWN, WM_PASTE, WM_CUT, WM_CLEAR, WM_UNDO, WM_SETTEXT,
    WM_SETFONT, EM_REPLACESEL, EM_UNDO, EM_REDO, EM_STREAMIN,
    EM_SETCHARFORMAT, EM_SETPARAFORMAT, WM_USER + 97 {EM_SETTEXTEX}:
      Result := True;
  else
    Result := False;
  end;
end;

// Маска уведомлений контрола: нужен EN_SELCHANGE, не нужен EN_REQUESTRESIZE.
//
// VCL при создании окна включает ENM_REQUESTRESIZE - уведомление о размере
// всего содержимого. Замер в пробе (файл 32 МБ): с ним смена ширины стоит
// ~690 мс и весь текст размечается сразу при загрузке, без него - ~5 мс, и
// разметка откладывается до первого запроса. EN_REQUESTRESIZE здесь нигде
// не обрабатывается.
//
// Маска живёт в окне и при его пересоздании возвращается к той, что ставит
// VCL. Проверка - одно сообщение, поэтому стоит там же, где EnsureTextLimit.
procedure TForm1.EnsureEventMask;
const
  EM_GETEVENTMASK_ = WM_USER + 59;
  EM_SETEVENTMASK_ = WM_USER + 69;
  ENM_SELCHANGE_ = $00080000;
  ENM_REQUESTRESIZE_ = $00040000;
var
  Mask, Need: Integer;
begin
  if not RichEdit1.HandleAllocated then
    Exit;
  Mask := SendMessageA(RichEdit1.Handle, EM_GETEVENTMASK_, 0, 0);
  Need := (Mask or ENM_SELCHANGE_) and not ENM_REQUESTRESIZE_;
  if Need <> Mask then
    SendMessageA(RichEdit1.Handle, EM_SETEVENTMASK_, 0, Need);
end;

// Обёртка: считает глубину вложенности.
//
// Снимки до правки (CapturePreEdit, CaptureWidthPre) действуют до конца
// того сообщения, в котором сделаны. Раньше они сбрасывались в конце ЛЮБОГО
// вызова этой процедуры - а контрол, обрабатывая символ, шлёт себе и
// другие сообщения (EN_SELCHANGE и т.п.). Если такое сообщение приходило
// раньше EN_CHANGE, снимок пропадал, и EN_CHANGE его уже не видел: карта не
// сдвигалась, кэш ширин сбрасывался целиком (диагностика "en 0/N").
// Цвет скобки в позиции APos (от нуля) строки каретки - цвет линии
// отступа её уровня; не скобка строки - цвет текста схемы
function TForm1.BracketColorAt(APos: Integer): TColor;
var
  BrIdx: Integer;
begin
  for BrIdx := 0 to High(FLineBrackets) do
    if FLineBrackets[BrIdx].X = APos then
    begin
      Result := FHotTabColors[FLineBrackets[BrIdx].Y mod HotTabLevels];
      Exit;
    end;
  Result := FScheme.FTextFG;
  if Result = clNone then
    Result := RichEdit1.Font.Color;
end;

// Выделение без пробелов и табуляций в конце (после двойного щелчка по
// слову); выделение из одних пробелов не трогается
procedure TForm1.TrimWordSelection;
var
  Sel: TCharRange;
  NewEnd: Integer;
begin
  if not RichEdit1.HandleAllocated then
    Exit;
  SendMessageA(RichEdit1.Handle, EM_EXGETSEL, 0, Integer(@Sel));
  NewEnd := Sel.cpMax;
  while (NewEnd > Sel.cpMin) and (CharAt(NewEnd - 1) in [' ', #9]) do
    Dec(NewEnd);
  if (NewEnd = Sel.cpMax) or (NewEnd = Sel.cpMin) then
    Exit;
  Sel.cpMax := NewEnd;
  SendMessageA(RichEdit1.Handle, EM_EXSETSEL, 0, Integer(@Sel));
end;

procedure TForm1.NewRichEditProc(var Message: TMessage);
var
  MarkIdx: Integer;
  CursorPt: TPoint;
  SerialBefore: Cardinal;
begin
  // Вставка - только текстом (PastePlainText): WM_PASTE от меню Windows и
  // Ctrl+V / Shift+Insert, если их не перехватило меню формы
  if FMsgDepth = 0 then
    if (Message.Msg = WM_PASTE) or
       ((Message.Msg = WM_KEYDOWN) and
        (((Message.WParam = Ord('V')) and (GetKeyState(VK_CONTROL) < 0) and
          (GetKeyState(VK_MENU) >= 0)) or
         ((Message.WParam = VK_INSERT) and (GetKeyState(VK_SHIFT) < 0) and
          (GetKeyState(VK_CONTROL) >= 0)))) then
    begin
      PastePlainText;
      Message.Result := 0;
      Exit;
    end;
  // Code Insight: клавиши списка подстановки и подсказки параметров
  if (FMsgDepth = 0) and CiBeforeMessage(Message) then
    Exit;
  // Метки направляющих у краёв окна: щелчок - начало блока в панель
  // объявления, каретка остаётся на месте; над меткой - курсор-рука
  if (FMsgDepth = 0) and not FGuideBusy and (Length(FGuideMarks) > 0) then
  begin
    if (Message.Msg = WM_LBUTTONDOWN) or (Message.Msg = WM_LBUTTONDBLCLK) then
    begin
      MarkIdx := GuideMarkAt(SmallInt(LoWord(Message.LParam)),
                             SmallInt(HiWord(Message.LParam)));
      if MarkIdx >= 0 then
      begin
        if Message.Msg = WM_LBUTTONDOWN then
        begin
          // GuideMarkClick шлёт окну свои запросы - они вернутся сюда же
          FGuideBusy := True;
          try
            GuideMarkClick(MarkIdx);
          finally
            FGuideBusy := False;
          end;
        end;
        FGuideSkipUp := True;
        Message.Result := 0;
        Exit;
      end;
    end
    else if (Message.Msg = WM_SETCURSOR) and
            (LoWord(Message.LParam) = HTCLIENT) then
    begin
      GetCursorPos(CursorPt);
      Windows.ScreenToClient(RichEdit1.Handle, CursorPt);
      if GuideMarkAt(CursorPt.X, CursorPt.Y) >= 0 then
      begin
        Windows.SetCursor(LoadCursor(0, IDC_HAND));
        Message.Result := 1;
        Exit;
      end;
    end;
  end;
  if (Message.Msg = WM_LBUTTONUP) and FGuideSkipUp then
  begin
    FGuideSkipUp := False;
    Message.Result := 0;
    Exit;
  end;
  if FMsgDepth = 0 then
    FOuterMsg := Message.Msg;
  SerialBefore := FEditSerial;
  Inc(FMsgDepth);
  try
    NewRichEditProcBody(Message);
  finally
    Dec(FMsgDepth);
  end;
  // Сообщение изменило текст - видимая часть рисуется сейчас, до выборки
  // следующего сообщения. Сама по себе перерисовка ждёт пустой очереди:
  // WM_PAINT Windows выдаёт последним, и при автоповторе клавиши экран
  // отставал от текста.
  if (FMsgDepth = 0) and (FEditSerial <> SerialBefore) and
     RichEdit1.HandleAllocated then
  begin
    Windows.UpdateWindow(RichEdit1.Handle);
    if PaintBox1 <> nil then
      PaintBox1.Update;
  end;
  // Двойной щелчок: RichEdit выделяет слово вместе с пробелами за ним -
  // пробелы и табуляции с конца выделения снимаются
  if (Message.Msg = WM_LBUTTONDBLCLK) and (FMsgDepth = 0) then
    TrimWordSelection;
  // Отпустили левую кнопку - каретка уже на месте щелчка: объявление
  // идентификатора под ней - в панель над редактором
  if (Message.Msg = WM_LBUTTONUP) and (FMsgDepth = 0) then
    DeclPanelUpdate;
  // Code Insight: список по набранному, "." и "(" - по задержке
  if FMsgDepth = 0 then
    CiAfterMessage(Message);
end;

procedure TForm1.NewRichEditProcBody(var Message: TMessage);
var
  WheelDelta, WheelLines: Integer;
  QueuedMsg: TMsg;
  PerfT: Int64;
  MouseX, LineW: Integer;
  ClickLine: Integer;
  EditHandled: Boolean;
  ClickBeyond: Boolean;
  EnterCount, EnterIdx: Integer;
  EnterIndent, EnterText: string;
begin
  // Перевод RqToFb (_rqfb): набор, вставка, удаление до редактора не
  // доходят - вместо них вопрос, как работать с переводом (RqFbEditAttempt)
  if FRqFbTab and
     (((Message.Msg = WM_CHAR) and (Message.WParam >= 8) and
       (Message.WParam <> VK_ESCAPE) and (GetKeyState(VK_CONTROL) >= 0)) or
      (Message.Msg = WM_PASTE) or (Message.Msg = WM_CUT) or
      (Message.Msg = WM_CLEAR) or (Message.Msg = WM_UNDO) or
      ((Message.Msg = WM_KEYDOWN) and
       ((Message.WParam = VK_DELETE) or
        ((GetKeyState(VK_CONTROL) < 0) and
         ((Message.WParam = Ord('V')) or (Message.WParam = Ord('X')) or
          (Message.WParam = Ord('Z')) or (Message.WParam = Ord('Y')))) or
        ((GetKeyState(VK_SHIFT) < 0) and (Message.WParam = VK_INSERT))))) then
  begin
    Message.Result := 0;
    RqFbEditAttempt;
    Exit;
  end;

  // Всё, что добавляет текст, - после проверки предела объёма. Стоит до
  // FLockHighlight: массовые правки идут как раз под ним. Ctrl+V контрол
  // разбирает сам внутри WM_KEYDOWN, без WM_PASTE, поэтому WM_KEYDOWN тоже
  // здесь. WM_LBUTTONDOWN - начало перетаскивания текста мышью.
  if (Message.Msg = WM_CHAR) or (Message.Msg = WM_KEYDOWN) or
     (Message.Msg = WM_PASTE) or (Message.Msg = EM_REPLACESEL) or
     (Message.Msg = EM_STREAMIN) or (Message.Msg = WM_SETTEXT) or
     (Message.Msg = WM_LBUTTONDOWN) or
     (Message.Msg = WM_USER + 97) {EM_SETTEXTEX} then
  begin
    EnsureTextLimit;
    EnsureNoWrap;
    EnsureEventMask;
  end;

  // Колесо мыши обрабатываем САМИ, склеивая накопившиеся щелчки.
  //
  // Каждый WM_MOUSEWHEEL вызывает прокрутку и следом полную перерисовку
  // видимой области. Если кадр рисуется дольше, чем приходят щелчки, очередь
  // растёт, и прокрутка продолжается ещё долго после того, как колесо
  // остановилось. Забираем из очереди все накопившиеся сообщения колеса,
  // складываем их дельты и прокручиваем ОДИН раз - на один кадр вместо пяти.
  if Message.Msg = WM_MOUSEWHEEL then
  begin
    WheelDelta := SmallInt(HiWord(Message.WParam));

    while PeekMessage(QueuedMsg, RichEdit1.Handle,
                      WM_MOUSEWHEEL, WM_MOUSEWHEEL, PM_REMOVE) do
      Inc(WheelDelta, SmallInt(HiWord(QueuedMsg.wParam)));

    WheelLines := (WheelDelta div WHEEL_DELTA) * Mouse.WheelScrollLines;
    if WheelLines <> 0 then
      // Знак минус: колесо от себя даёт положительную дельту, а прокручивать
      // при этом надо ВВЕРХ, то есть к меньшим номерам строк
      ScrollEditTo(SendMessageA(RichEdit1.Handle, EM_GETFIRSTVISIBLELINE,
                                0, 0) - WheelLines);

    Message.Result := 0;
    Exit;
  end;

  // Фон не стираем: буфер и так заливается целиком перед отрисовкой.
  // Без этого перед каждым кадром успевал мелькнуть чистый фон контрола.
  if Message.Msg = WM_ERASEBKGND then
  begin
    // В родном режиме фон стирает сам контрол - иначе останется мусор
    if NativePaintMode then
    begin
      OldRichEditProc(Message);
      Exit;
    end;

    Message.Result := 1;
    Exit;
  end;

  // Весь WM_PAINT берём на себя. WParam <> 0 означает, что рисовать просят
  // в чужой DC - такие сообщения пропускаем без изменений.
  if (Message.Msg = WM_PAINT) and (Message.WParam = 0) and not FInPaint then
  begin
    if NativePaintMode then
    begin
      // Рисует сам RichEdit. Номера строк всё равно наши, их обновляем сами
      OldRichEditProc(Message);
      UpdateLineNumbers;
      Exit;
    end;

    FInPaint := True;
    try
      PaintDoubleBuffered;
    finally
      FInPaint := False;
    end;
    Message.Result := 0;
    Exit;
  end;

  if FLockHighlight then
  begin
    // Под блокировкой идут массовые правки, и EN_CHANGE до разбора ниже не
    // доходит - кэш ширины сбрасываем здесь. Но только на сообщения, которые
    // меняют текст: под блокировкой идут и все запросы самой отрисовки, и
    // сброс на каждый из них не давал кэшу сработать ни разу.
    if IsTextChangeMsg(Message.Msg) or
       ((Message.Msg = CN_COMMAND) and
        (TWMCommand(Message).NotifyCode = EN_CHANGE)) then
    begin
      InvalidateWidthCache;
      ObjLinesLocked(Message);
      FDbgPreValid := False;
    end;
    OldRichEditProc(Message);
    Exit;
  end;

  // Всё, что может поменять текст или его метрику: снимок для кэша ширин.
  // Сам кэш поправит ApplyWidthEdit на EN_CHANGE.
  if IsTextChangeMsg(Message.Msg) then
    CaptureWidthPre(Message);

  // Координату мыши поправляем на наш горизонтальный сдвиг.
  //
  // Контрол переводит X в позицию символа по СВОЕЙ разметке, где текст
  // начинается с нуля: своей прокрутки у него нет. А рисуем мы со сдвигом
  // FScrollX. Без поправки клик попадал бы в символ, отстоящий ровно на
  // величину сдвига, и то же было бы при выделении протяжкой.
  //
  // Правим здесь, до всех обработчиков: дальше по коду координаты мыши
  // никто не читает, а контролу нужны именно текстовые.
  ClickLine := -1;
  ClickBeyond := False;

  if (Message.Msg = WM_LBUTTONDOWN) or (Message.Msg = WM_LBUTTONUP) or
     (Message.Msg = WM_LBUTTONDBLCLK) or (Message.Msg = WM_MOUSEMOVE) or
     (Message.Msg = WM_RBUTTONDOWN) or (Message.Msg = WM_RBUTTONUP) then
  begin
    // Координаты в LParam лежат знаковыми словами: X младшим, Y старшим.
    // Прибавляем наш сдвиг - контрол считает от начала текста.
    MouseX := SmallInt(LoWord(Message.LParam)) + FScrollX;
    if MouseX < 0 then
      MouseX := 0;

    // Дальше конца строки контролу не отдаём. Иначе он понимает клик как
    // указание на конец строки ВМЕСТЕ с переводом и ставит каретку в первую
    // позицию следующей - см. LinePixelWidth.
    //
    // Движение БЕЗ нажатой кнопки каретку не ставит, ограничивать его не
    // нужно - а это большая часть всех сообщений мыши.
    if (Message.Msg <> WM_MOUSEMOVE) or
       (Message.WParam and MK_LBUTTON <> 0) then
    begin
      ClickLine := LineAtY(SmallInt(HiWord(Message.LParam)));
      LineW := LinePixelWidth(ClickLine);
      if MouseX >= LineW then
      begin
        ClickBeyond := True;
        if LineW > 0 then
          MouseX := LineW - 1
        else
          MouseX := 0;
      end;
    end;

    Message.LParam := Integer(MakeLong(Word(MouseX), HiWord(Message.LParam)));
  end;

  // Shift+Enter: RichEdit пишет вместо перевода строки символ #11 (VT,
  // мягкий перенос). На экране это новая строка, но для текста её нет:
  // Format text, поиск и сборка видят продолжение предыдущей строки, и
  // отступ после #11 не исправляется. Вместо него - обычный перевод
  // строки, через EM_REPLACESEL (снимок для отмены и EN_CHANGE - как при
  // вводе)
  //
  // Enter (и Shift+Enter): перевод строки и отступ новой строки - на
  // уровне блока (EnterIndentText), тоже через EM_REPLACESEL.
  //
  // Перехват - уже на WM_KEYDOWN, в контрол оно не идёт. Наблюдение
  // пользователя 2026-10-10: при перехвате только WM_CHAR каждое Enter
  // давало пустую строку и под ней строку с отступом - перевод строки
  // вставлялся ещё и помимо WM_CHAR. WM_CHAR #13 этого нажатия к этому
  // моменту уже в очереди (TranslateMessage идёт до DispatchMessage) -
  // убираем его оттуда.
  if (Message.Msg = WM_KEYDOWN) and (Message.WParam = VK_RETURN) and
     (GetKeyState(VK_CONTROL) >= 0) and (GetKeyState(VK_MENU) >= 0) and
     not RichEdit1.ReadOnly then
  begin
    if PeekMessage(QueuedMsg, RichEdit1.Handle, WM_CHAR, WM_CHAR,
                   PM_NOREMOVE) and (QueuedMsg.wParam = 13) then
      PeekMessage(QueuedMsg, RichEdit1.Handle, WM_CHAR, WM_CHAR, PM_REMOVE);
    // Удержанная клавиша: автоповтор, накопившийся в очереди, - одной
    // вставкой. Иначе каждое нажатие - своя правка и свой разбор, очередь
    // растёт быстрее, чем разбирается, а WM_PAINT Windows выдаёт только
    // при пустой очереди. Берутся только нажатия Enter, стоящие в очереди
    // первыми; их WM_CHAR ещё нет - его делает TranslateMessage при выборке.
    EnterCount := 1;
    while PeekMessage(QueuedMsg, RichEdit1.Handle, 0, 0, PM_NOREMOVE) and
          (QueuedMsg.message = WM_KEYDOWN) and
          (QueuedMsg.wParam = VK_RETURN) do
    begin
      PeekMessage(QueuedMsg, RichEdit1.Handle, WM_KEYDOWN, WM_KEYDOWN,
                  PM_REMOVE);
      Inc(EnterCount);
    end;
    // Отступ следующих строк - тот же: каретка после первого Enter стоит
    // за отступом новой строки, и EnterIndentText вернул бы его же
    EnterIndent := EnterIndentText;
    EnterText := '';
    for EnterIdx := 1 to EnterCount do
      EnterText := EnterText + #13 + EnterIndent;
    SendMessage(RichEdit1.Handle, EM_REPLACESEL, 1,
                Integer(PChar(EnterText)));
    // То, что после клавиши делает общий путь ниже (сюда он не доходит)
    EnsureCaretVisibleX;
    UpdateLineNumbers;
    Message.Result := 0;
    Exit;
  end;
  // WM_CHAR #13 без своего WM_KEYDOWN (прислан программой) - так же
  if (Message.Msg = WM_CHAR) and (Message.WParam = 13) and
     (GetKeyState(VK_CONTROL) >= 0) and not RichEdit1.ReadOnly then
  begin
    SendMessage(RichEdit1.Handle, EM_REPLACESEL, 1,
                Integer(PChar(#13 + EnterIndentText)));
    Message.Result := 0;
    Exit;
  end;

  // Снимок ДО того, как сообщение уйдёт в контрол. EN_CHANGE придёт ВНУТРИ
  // обработки этого же сообщения, вложенным вызовом, - там снимок и понадобится.
  if (Message.Msg = WM_CHAR) or (Message.Msg = WM_KEYDOWN) or
     (Message.Msg = WM_PASTE) or (Message.Msg = WM_CUT) or
     (Message.Msg = WM_CLEAR) or (Message.Msg = WM_UNDO) or
     (Message.Msg = EM_REPLACESEL) or (Message.Msg = EM_UNDO) then
  begin
    FPerfOur := PerfNow;
    CapturePreEdit;
    FPerfOur := PerfNow - FPerfOur;
  end;

  // Каретка сдвинулась. Ловим ЗДЕСЬ, а не в WMNotify формы.
  //
  // EN_SELCHANGE контрол шлёт своему РОДИТЕЛЮ, а родителем стала панель
  // FEditHost - до формы уведомление больше не доходит. Зато VCL любое
  // WM_NOTIFY, полученное родителем, пересылает самому контролу как
  // CN_NOTIFY, и здесь оно есть при любом родителе.
  if (Message.Msg = CN_NOTIFY) and (Message.LParam <> 0) and
     (PNMHdr(Message.LParam)^.code = EN_SELCHANGE) then
  begin
    UpdateStatusBarInfo;
    UpdatePairMatch;

    // Щелчок мышью по тексту не вызывает перерисовку редактора - каретка
    // просто переезжает, WM_PAINT не приходит, и панель номеров сама бы
    // не обновилась
    UpdateLineNumbers;

    // Имя компонента под кареткой - выделить его в дереве объектов
    ObjSyncFromCaret;
  end;

  // 1. Изменение текста
  if (Message.Msg = CN_COMMAND) and (TWMCommand(Message).NotifyCode = EN_CHANGE) then
  begin
    if FCachePreValid then
      Inc(FEnChangeIn)
    else
      Inc(FEnChangeOut);
    if FMsgDepth > 1 then
      Inc(FEnNested)
    else
      Inc(FEnTop);

    // Уведомление о правке, которую HandleEditAfterMsg уже учёл?
    // RichEdit 4.1 присылает EN_CHANGE не внутри сообщения с символом, а
    // позже (диагностика "en 0/N"): снимка до правки к этому моменту нет.
    EditHandled := False;
    if not FCachePreValid then
    begin
      // Длина та же, что после последней учтённой правки, - значит, после
      // неё текст не менялся. По одному уведомлению на правку; если их
      // пришло меньше, счётчик сбросит первая правка другой длины.
      if (FPendingEn > 0) and (TextLenInternal = FKnownLen) then
      begin
        EditHandled := True;
        Dec(FPendingEn);
      end
      else
      begin
        FPendingEn := 0;
        LogDiag(Format('EN_CHANGE без снимка, внешнее сообщение $%.4x',
                       [FOuterMsg]));
      end;
    end;

    // Вложенность строк сдвинуть - до ApplyWidthEdit: он гасит снимок.
    // Без этого правка, чьё EN_CHANGE пришло внутри сообщения (вставка
    // EM_REPLACESEL - Enter, Paste), оставляла FLineDepth несдвинутой, и
    // направляющие ниже правки до пересборки карты рисовались по чужим
    // строкам.
    if not EditHandled then
    begin
      ShiftDepthForEdit;
      ApplyWidthEdit; // текст другой - кэш ширин поправить
    end;

    if RichEdit1.Modified then
    begin
      // RichEdit1.Modified := False;
      //      if (FCurrentFileName <> '') and (Pos(' *', Form1.Caption) = 0) then
      if (Pos(' *', Form1.Caption) = 0) then
        Form1.Caption := AppTitle + ' - ' + DisplayName + ' *';

      // Сначала пробуем обойтись сдвигом позиций - он стоит доли
      // микросекунды. Не вышло - заказываем полный разбор по таймеру.
      PerfT := PerfNow;
      if not EditHandled then
        if not TryShiftMap then
        begin
          RescanVisibleMap(FMapEditPos, True);
          ScheduleMapRebuild;
        end;

      // Метим ТОЛЬКО строку с кареткой, и в обоих случаях.
      //
      // Когда сдвиг удался - потому что больше ничего и не изменилось.
      // Когда отказал - потому что карта СЕЙЧАС устарела, и перерисовывать
      // по ней весь экран значит размазать неверную подсветку по строкам,
      // которых правка не касалась. Это и были бегущие артефакты. Полную
      // перерисовку сделает тот, кто пересоберёт карту.
      //
      // Само InvalidateRect отложено до конца обработки сообщения: сейчас
      // контрол ещё не довёл до конца свою внутреннюю правку, и координата
      // строки может не соответствовать тому, что он нарисует.
      FNeedLineInv := True;
      // EN_CHANGE приходит ВНУТРИ обработки клавиши, поэтому прибавляем
      // к уже замеренному снимку, а не перезаписываем
      Inc(FPerfOur, PerfNow - PerfT);
    end;
    // Exit;
  end;

  // Пропускаем сообщение сквозь стандартное окно RichEdit, чтобы Windows
  // успела физически прокрутить текст и изменить внутренние индексы строк!
  // Свою каретку убираем ДО вызова контрола.
  //
  // Контрол на прокрутке сдвигает уже нарисованные пиксели, и каретка,
  // нарисованная инверсией, уезжает вместе с ними: на экране остаётся
  // полоска, а стирание на прежнем месте добавляет ещё одну. Так и
  // появлялись столбики при удержании стрелки.
  //
  // Прокрутить текст может не только сообщение прокрутки, но и клавиша,
  // щелчок мышью или ввод, поэтому список широкий. SyncCaretX после вызова
  // нарисует каретку заново.
  if (Message.Msg = EM_LINESCROLL) or (Message.Msg = WM_VSCROLL) or
     (Message.Msg = WM_HSCROLL) or (Message.Msg = WM_KILLFOCUS) or
     (Message.Msg = WM_KEYDOWN) or (Message.Msg = WM_KEYUP) or
     (Message.Msg = WM_CHAR) or (Message.Msg = WM_PASTE) or
     (Message.Msg = WM_CUT) or (Message.Msg = WM_CLEAR) or
     (Message.Msg = WM_UNDO) or (Message.Msg = EM_UNDO) or
     (Message.Msg = EM_REDO) or (Message.Msg = EM_REPLACESEL) or
     (Message.Msg = EM_SETSEL) or (Message.Msg = EM_EXSETSEL) or
     (Message.Msg = EM_SCROLLCARET) or (Message.Msg = EM_STREAMIN) or
     (Message.Msg = WM_SETTEXT) or (Message.Msg = WM_USER + 97) or
     (Message.Msg = WM_LBUTTONDOWN) or (Message.Msg = WM_LBUTTONUP) or
     (Message.Msg = WM_LBUTTONDBLCLK) or (Message.Msg = WM_RBUTTONDOWN) or
     ((Message.Msg = WM_MOUSEMOVE) and (Message.WParam and MK_LBUTTON <> 0)) then
    HideOwnCaret;

  PerfT := PerfNow;
  OldRichEditProc(Message);

  // Наша работа по EN_CHANGE идёт ВНУТРИ этого вызова - вычитаем её,
  // чтобы в FPerfCtl осталось чистое время самого контрола
  if (Message.Msg = WM_KEYDOWN) or (Message.Msg = WM_CHAR) then
  begin
    FPerfCtl := PerfNow - PerfT - FPerfOur;
    if FPerfCtl < 0 then
      FPerfCtl := 0;
  end;

  // Текст изменился - помечаем грязной строку с кареткой. Именно здесь,
  // после возврата из контрола: к этому моменту он уже перестроил свою
  // разметку и прокрутку, и EM_POSFROMCHAR отдаёт верную координату.
  if FNeedLineInv then
  begin
    FNeedLineInv := False;
    InvalidateCaretLine;
  end;

  // Контрол сам переставил каретку по своей координате, без нашего сдвига:
  // при вертикальной прокрутке (колесо и наша полоса идут через
  // EM_LINESCROLL), при получении фокуса и при смене размера.
  if (Message.Msg = EM_LINESCROLL) or (Message.Msg = WM_VSCROLL) or
     (Message.Msg = WM_SETFOCUS) or (Message.Msg = WM_SIZE) then
  begin
    // Контрол при получении фокуса создал и показал системную каретку -
    // прячем: каретку рисуем мы, см. SyncCaretX
    if Message.Msg = WM_SETFOCUS then
      Windows.HideCaret(RichEdit1.Handle);
    SyncCaretX;
  end;

  // Всё, после чего контрол мог прокрутиться вбок сам. Список ограничен:
  // проверка - ещё одно сообщение контролу, а через эту процедуру проходят
  // и все наши запросы из отрисовки.
  if (Message.Msg = WM_KEYDOWN) or (Message.Msg = WM_CHAR) or
     (Message.Msg = WM_PASTE) or (Message.Msg = WM_CUT) or
     (Message.Msg = WM_UNDO) or (Message.Msg = EM_UNDO) or
     (Message.Msg = EM_REDO) or (Message.Msg = EM_REPLACESEL) or
     (Message.Msg = WM_LBUTTONDOWN) or (Message.Msg = WM_LBUTTONDBLCLK) or
     ((Message.Msg = WM_MOUSEMOVE) and (Message.WParam and MK_LBUTTON <> 0)) or
     (Message.Msg = EM_SETSEL) or (Message.Msg = EM_EXSETSEL) or
     (Message.Msg = EM_SCROLLCARET) or (Message.Msg = WM_HSCROLL) or
     (Message.Msg = WM_SETFOCUS) or (Message.Msg = WM_SIZE) or
     (Message.Msg = WM_SETTEXT) or (Message.Msg = EM_STREAMIN) then
    CheckCtlScrollX;

  // 2. Состояние выделения мышью
  //
  // Полная инвалидация на отпускании кнопки убрана: к этому моменту выделение
  // уже отрисовано, RichEdit сам помечал грязной изменившуюся область на каждом
  // WM_MOUSEMOVE. Лишний кадр давал вспышку неподсвеченного текста.
  if Message.Msg = WM_LBUTTONDOWN then
    FIsMouseSelecting := True;

  if Message.Msg = WM_LBUTTONUP then
    FIsMouseSelecting := False;

  // Клавишу отпустили - можно пересобрать карту, если она заказана.
  //
  // Но только если разбор ДЕШЁВ. Иначе частые одиночные нажатия дают на
  // каждое отпускание по полному разбору: на 32-мегабайтном файле это по
  // полсекунды на клавишу, и программа встаёт. Там правильнее оставить
  // работу таймеру - он сработает, когда правки прекратятся.
  //
  // Порог берём с запасом: тридцать миллисекунд человек за отдельную
  // задержку не считает, даже если бить по клавише часто.
  if (Message.Msg = WM_KEYUP) and (FLastRebuildMs <= 30) then
    FlushMapRebuild;

  // 3. Перемещение каретки клавиатурой.
  //
  // Здесь тоже нет смысла инвалидировать экран руками: если каретка утащила
  // содержимое, контрол прокрутил уже нарисованные пиксели вместе с подсветкой
  // и пометил грязной только открывшуюся полосу. Остаётся лишь обновить номера.
  // Всё, что может сдвинуть каретку. EM_SETSEL и EM_EXSETSEL сюда попадают
  // потому, что RichEdit1.SelStart из нашего кода уходит в контрол именно
  // этими сообщениями и проходит через подменённую процедуру.
  if (Message.Msg = WM_KEYDOWN) or (Message.Msg = WM_KEYUP) or
     (Message.Msg = WM_CHAR) or
     (Message.Msg = WM_LBUTTONDOWN) or (Message.Msg = WM_LBUTTONUP) or
     ((Message.Msg = WM_MOUSEMOVE) and (Message.WParam and MK_LBUTTON <> 0)) or
     (Message.Msg = EM_SETSEL) or (Message.Msg = EM_EXSETSEL) or
     (Message.Msg = EM_SCROLLCARET) then
  begin
    // Указали правее последнего символа - значит хотели в конец строки.
    // Контролу мы отдали координату внутри текста, поэтому доводим сами.
    // При выделении протяжкой не вмешиваемся: там каретка ведёт выделение.
    if ClickBeyond and (ClickLine >= 0) and
       ((Message.Msg = WM_LBUTTONDOWN) or (Message.Msg = WM_LBUTTONDBLCLK)) then
      CaretToLineEnd(ClickLine);

    EnsureCaretVisibleX; // вбок контрол сам не прокрутится, см. метод
    UpdateLineNumbers;
    if PaintBox1 <> nil then
      PaintBox1.Update; // если панель стала грязной - рисуем сразу
  end;

  // Обработка сообщения закончена - снимок больше не действителен. Без этого
  // он пережил бы, скажем, нажатие стрелки и достался бы следующей правке,
  // пришедшей другим путём (SelText из кода замены) - с чужими координатами.
  // Снимок этого сообщения не забран - EN_CHANGE внутри не пришло.
  // Учитываем правку сами, не дожидаясь уведомления.
  if FCachePreValid and (FCacheDepth = FMsgDepth) then
    HandleEditAfterMsg(Message);

  // Каретку убирали перед вызовом контрола, а поставить заново было некому:
  // сообщение не двигало каретку и не меняло текст. Ставим сами.
  if FOwnCaretOn and not FOwnCaretDrawn and (FMsgDepth = 1) and
     RichEdit1.HandleAllocated and RichEdit1.Focused then
    SyncCaretX;

  // Только в конце того сообщения, где снимок сделан, - не во вложенных
  if FMsgDepth <= FPreDepth then
    FPreValid := False;
  if FMsgDepth <= FCacheDepth then
  begin
    FCachePreValid := False;
    FObjPreValid := False;
  end;
end;

procedure TForm1.HighlightVisibleText;
const
  EM_GETSCROLLPOS = WM_USER + 221; // Системный код для Delphi 7
var
  DC: HDC;
  Metrics: TTextMetric;
  CharW: Integer; // средняя ширина символа - ширина маркера отступа
  HotTabBrushes: array[0..HotTabLevels - 1] of HBRUSH;
  // Метки у краёв окна (полоса уходит за край) - полным цветом уровня
  GuideMarkBrushes: array[0..HotTabLevels - 1] of HBRUSH;
  HB: Integer;
  CurrentLineIdx: Integer;
  LineStartCharIdx: Integer;
  LineLen: Integer;
  LineStr: string;
  LinePtr: PChar; // = PChar(LineStr), чтобы не копировать куски строки
  Pt: TPoint;
  LineStartX: Integer;
  TMark: Int64;   // ЗАМЕР: момент последней отметки, см. Lap

  // Выделение мыши читается ОДИН раз на кадр: внутри отрисовки оно не меняется,
  // а раньше EM_EXGETSEL уходил в RichEdit на каждый токен и на каждый символ.
  Sel: TCharRange;
  SelMin, SelMax: Integer;
  // Цвета выделения - роли IDE Editor.SelBG / Editor.SelText (по теме),
  // берутся раз на кадр
  SelBgRgb, SelFgRgb: COLORREF;

  // Переменные для вертикальной синхронизации плавного скроллинга
  FirstCharPos: TPoint;

  // Переменные для обработки смешанных строк (код + комментарий)
  LineCommentPos: Integer;
  TailStart, TailCommentPos, TailBlockPos: Integer;
  TailIsBlock: Boolean;
  CodeLenToParse: Integer;
  BlockStart: Integer;

  // Флаги состояния для строки
  IsBlockComment: Boolean;
  IsMixedBlockComment: Boolean;

  // LineXPos[k] - ширина первых k символов текущей строки в пикселях, с уже
  // раскрытыми табуляциями. Один раз на строку, см. MeasureLineXPos.
  LineXPos: TIntArray;

  // Видимые символы текущей строки: только их DrawRun отдаёт в GDI
  VisFrom, VisTo: Integer;

  // Окно длинной строки. LineStr, LineLen, LineXPos и LineStartCharIdx
  // описывают тогда не всю строку, а кусок с символа WinStart; XOff - X
  // начала куска от начала строки. TabOrigin - X начала САМОЙ строки на
  // экране: от него TabbedTextOut считает табуляции.
  WinStart, WinEnd, XOff, TabOrigin, LineTotalW: Integer;
  InfoIdx, KFrom, KTo, WK: Integer;
  TMarkC: Int64;
  FullStr: string;
  LineCommentBefore: Boolean;
  LineCommentLevel: Integer;
  LineMarked: Boolean; // строка отмечена (LineMark) - см. LineMarkGroup
  LineIsBody: Boolean; // строка - заголовок тела подпрограммы или переход
  MarkIdx: Integer;    // группа отметки строки, -1 - нет
  MarkFG, MarkBG: TColor; // цвета отметки ЭТОЙ строки: LineMark или SubBody
  BcKind: Integer;        // пара маркеров блочного комментария этой строки
  BcEndIdx, CmtEnd, CurPos: Integer; // конец комментария и курсор по строке
  BcFg, BcBg: TColor;
  BcEnd: string;
  MarkBr: HBRUSH;
  DbgKind: Integer;       // точка останова, строка остановки - DbgLineKind

  // ЗАМЕР: время с прошлой отметки - в указанную статью.
  //
  // GdiFlush обязателен. GDI копит вызовы пачкой и выполняет их позже, и без
  // сброса время вывода текста досталось бы не той статье, а то и вовсе
  // BitBlt в конце кадра.
  procedure Lap(var Acc: Int64);
  var
    T: Int64;
  begin
    GdiFlush;
    T := PerfNow;
    Inc(Acc, T - TMark);
    TMark := T;
  end;

// Первый символ строки (1..LineLen), правый край которого правее X;
// LineLen + 1, если такого нет. Двоичный поиск по LineXPos.
  function CharRightOf(X: Integer): Integer;
  var
    Lo, Hi, Mid: Integer;
  begin
    Lo := 1;
    Hi := LineLen + 1;
    while Lo < Hi do
    begin
      Mid := (Lo + Hi) div 2;
      if LineXPos[Mid] > X then
        Hi := Mid
      else
        Lo := Mid + 1;
    end;
    Result := Lo;
  end;

  function GetCommentCustomLevel(const TextStr: string; StartPos: Integer): Integer;
  var
    CheckI: Integer;
  begin
    Result := 0;
    CheckI := StartPos;
    // Бежим вперед от маркера и считаем восклицательные знаки
    while (CheckI <= Length(TextStr)) and (TextStr[CheckI] = '!') and (Result < 5) do
    begin
      Inc(Result);
      Inc(CheckI);
    end;
  end;
// Внутренняя функция проверки: пересекается ли вся строка с диапазоном блочного комментария

// Строка обрабатывается по Сценарию №1 (продолжение блочного комментария)
// ТОЛЬКО если внутри диапазона лежит её ПЕРВЫЙ символ.
// Раньше здесь проверялось простое пересечение отрезков, из-за чего строка
// вида "x := 1; /* коммент" целиком красилась как комментарий, вместе с кодом
// слева от маркера, а ветка смешанного комментария в Сценарии №2 была мертва.
//
// Проверка идёт ДВОИЧНЫМ поиском, через общую InRanges. Раньше здесь был
// перебор ВСЕХ диапазонов, и на каждую видимую строку. Замер до и после
// показал 27 и 23,5 мс на кадр - значит основная стоимость кадра НЕ здесь,
// но перебор всё равно был лишним.
//
// Условие у InRanges ровно то же: StartPos <= Idx < EndPos.
  function CheckLineStartsInBlockComment(LineStart: Integer): Boolean;
  begin
    Result := InRanges(CommentRanges, LineStart);
  end;

// Какой парой маркеров открыт блочный комментарий, накрывающий позицию;
// -1 - позиция вне комментария. Нужно, чтобы закрывающий маркер и цвета
// брались той же пары, которой комментарий начат.
// Блочный комментарий, накрывающий позицию: его пара маркеров и позиция
// последнего символа, обе в координатах текста. False - позиция вне
// комментария.
  function BlockRangeAt(CharIndex: Integer; var AKind: Integer;
                        var AEndPos: Integer): Boolean;
  var
    M: Integer;

    function Covers(AIdx: Integer): Boolean;
    begin
      Result := (AIdx >= 0) and (AIdx <= High(CommentRanges)) and
                (CommentRanges[AIdx].StartPos <= CharIndex) and
                (CommentRanges[AIdx].EndPos > CharIndex);
    end;

  begin
    Result := False;
    AKind := -1;
    AEndPos := -1;
    if Length(CommentRanges) = 0 then
      Exit;

    // FirstRangeFrom отдаёт первый диапазон, начинающийся не раньше
    // позиции. Накрывать её может он сам - если комментарий здесь и
    // начинается, как у хвостового, - либо предыдущий, если позиция
    // внутри. Проверяем оба.
    M := FirstRangeFrom(CommentRanges, CharIndex);
    if M < 0 then
      M := High(CommentRanges);

    if not Covers(M) then
      Dec(M);
    if not Covers(M) then
      Exit;

    AKind := CommentRanges[M].Kind;
    AEndPos := CommentRanges[M].EndPos;
    Result := True;
  end;

// Только пара маркеров; -1 - позиция вне блочного комментария
  function BlockKindAt(CharIndex: Integer): Integer;
  var
    E: Integer;
  begin
    if not BlockRangeAt(CharIndex, Result, E) then
      Result := -1;
  end;

// Внутренняя функция проверки: находится ли символ внутри строкового литерала
  function IsCharInString(CharIndex: Integer): Boolean;
  begin
    Result := InRanges(StringRanges, CharIndex);
  end;

// Внутренняя функция проверки: находится ли символ внутри блочного комментария
  function IsCharInBlockComment(CharIndex: Integer): Boolean;
  begin
    Result := InRanges(CommentRanges, CharIndex);
  end;

// Внутренняя функция проверки: пересекается ли диапазон токена с выделением мыши
// Рисует фрагмент строки [FromPos..ToPos] цветами Fg/Bg, разрезая его по
// границам выделения мыши. Выделение - один непрерывный диапазон, поэтому
// кусков максимум три, и каждый уходит в GDI одним вызовом.
//
// Раньше токен, попавший в выделение, рисовался ПОСИМВОЛЬНО: на каждый символ
// свой TabbedTextOut плюс SendMessage EM_EXGETSEL.
  procedure DrawRun(FromPos, ToPos: Integer; Fg, Bg: TColor);

  // Кусок передаётся в GDI указателем прямо в строку, без Copy
    procedure Piece(P1, P2: Integer; Sel: Boolean);
    begin
      if P2 < P1 then
        Exit;
      if Sel then
      begin
        SetTextColor(DC, SelFgRgb);
        SetBkColor(DC, SelBgRgb);
      end
      else if LineMarked then
      begin
        // Отмеченная строка: фон - отметки; цвет - отметки или свой
        if MarkFG <> clNone then
          SetTextColor(DC, ColorToRGB(MarkFG))
        else
          SetTextColor(DC, Fg);
        SetBkColor(DC, ColorToRGB(MarkBG));
      end
      else
      begin
        SetTextColor(DC, Fg);
        SetBkColor(DC, Bg);
      end;
      TabbedTextOut(DC, LineStartX + LineXPos[P1 - 1], Pt.Y,
                    LinePtr + (P1 - 1), P2 - P1 + 1, 1, TabStopN, TabOrigin);
      Inc(FDrawCalls);
    end;

  var
    SelFrom, SelTo: Integer; // границы выделения в позициях текущей строки
  begin
    if FromPos < 1 then
      FromPos := 1;
    if ToPos > LineLen then
      ToPos := LineLen;
    // Только видимая часть: длинная строка иначе уходила бы в GDI целиком
    if FromPos < VisFrom then
      FromPos := VisFrom;
    if ToPos > VisTo then
      ToPos := VisTo;
    if ToPos < FromPos then
      Exit;
    if (Pt.Y < 0) or (Pt.Y >= RichEdit1.ClientHeight) then
      Exit;

    if SelMax <= SelMin then
    begin
      Piece(FromPos, ToPos, False);
      Exit;
    end;

    SelFrom := SelMin - LineStartCharIdx + 1;
    SelTo := SelMax - LineStartCharIdx; // включительно
    if SelFrom < FromPos then
      SelFrom := FromPos;
    if SelTo > ToPos then
      SelTo := ToPos;

    if SelTo < SelFrom then
    begin
      Piece(FromPos, ToPos, False);
      Exit;
    end;

    Piece(FromPos, SelFrom - 1, False);
    Piece(SelFrom, SelTo, True);
    Piece(SelTo + 1, ToPos, False);
  end;

// Подсветка прогонов символов из заданного набора (операторы)
//
// Прогоны ищутся только в [FromPos..ToPos]: правее идёт комментарий, и
// нарисованное там всё равно закрасит HighlightTrailingComment.
  procedure HighlightTokenSet(const Chars: TSysCharSet; TokenColor: TColor;
                              BgColor: TColor; FromPos, ToPos: Integer);
  var
    TokI, TokStart: Integer;
  begin
    if FromPos < 1 then
      FromPos := 1;
    if ToPos > LineLen then
      ToPos := LineLen;
    TokI := FromPos;
    while TokI <= ToPos do
    begin
      if LineStr[TokI] in Chars then
      begin
        TokStart := TokI;
        while (TokI <= LineLen) and (LineStr[TokI] in Chars) do
          Inc(TokI);

        if not IsCharInString(LineStartCharIdx + TokStart - 1) and
           not IsCharInBlockComment(LineStartCharIdx + TokStart - 1) then
          DrawRun(TokStart, TokI - 1, TokenColor, BgColor);
      end
      else
        Inc(TokI);
    end;
  end;

// Подсветка ключевых слов ВСЕХ групп за один проход - см. RebuildKeywordHash.
// Слова начинаются в [FromPos..ToPos], по той же причине, что у операторов.
  procedure HighlightKeywordsAll(FromPos, ToPos: Integer);
  var
    KwI, KwEnd, G: Integer;
    CompFg, CompBg: TColor;
  begin
    if (Length(FKwSlots) = 0) and (Length(FCompSlots) = 0) then
      Exit;
    if FromPos < 1 then
      FromPos := 1;
    if ToPos > LineLen then
      ToPos := LineLen;

    KwI := FromPos;
    while KwI <= ToPos do
    begin
      if LineStr[KwI] in ['a'..'z', 'A'..'Z', '_'] then
      begin
        KwEnd := KwI;
        while (KwEnd <= LineLen) and
              (LineStr[KwEnd] in ['a'..'z', 'A'..'Z', '0'..'9', '_']) do
          Inc(KwEnd);

        G := KeywordGroupOf(LinePtr + (KwI - 1), KwEnd - KwI);
        if (G >= 0) and
           not IsCharInString(LineStartCharIdx + KwI - 1) and
           not IsCharInBlockComment(LineStartCharIdx + KwI - 1) then
          DrawRun(KwI, KwEnd - 1, FScheme.KeywordGroups[G].FgColor,
                  FScheme.KeywordGroups[G].BgColor)
          // Не ключевое слово - может быть имя компонента формы. Ключевое
          // слово важнее: компонент с именем begin не назовёшь, а если
          // совпало с типом из списка - пусть остаётся цветом типа.
        else if (G < 0) and (Length(FCompSlots) > 0) and
                CompNameAt(LinePtr + (KwI - 1), KwEnd - KwI) and
                not IsCharInString(LineStartCharIdx + KwI - 1) and
                not IsCharInBlockComment(LineStartCharIdx + KwI - 1) then
        begin
          // clNone - значит цвета текста: SetTextColor и SetBkColor его
          // не понимают
          CompFg := FScheme.FCompFG;
          if CompFg = clNone then
            CompFg := RichEdit1.Font.Color;
          CompBg := FScheme.FCompBG;
          if CompBg = clNone then
            CompBg := FScheme.FTextBG;
          DrawRun(KwI, KwEnd - 1, ColorToRGB(CompFg), ColorToRGB(CompBg));
        end;

        KwI := KwEnd;
      end
      else
        Inc(KwI);
    end;
  end;

// Подсветка чисел
// Числа начинаются в [FromPos..ToPos], по той же причине, что у операторов
  procedure HighlightNumbers(TokenColor: TColor; BgColor: TColor;
                             FromPos, ToPos: Integer);
  var
    NumI, NumStart, HexFrom, WordEnd, K: Integer;
    IsNum, WordIsText: Boolean;
  begin
    if FromPos < 1 then
      FromPos := 1;
    if ToPos > LineLen then
      ToPos := LineLen;
    NumI := FromPos;
    while NumI <= ToPos do
    begin
      if LineStr[NumI] in ['a'..'z', 'A'..'Z', '_'] then
      begin
        // Идентификатор проматываем ЦЕЛИКОМ, вместе с цифрами внутри него,
        // иначе BoardPropMnu33 отдаст цифры на подсветку.
        while (NumI <= LineLen) and
              (LineStr[NumI] in ['a'..'z', 'A'..'Z', '0'..'9', '_']) do
          Inc(NumI);
        Continue;
      end;

      IsNum := False;
      WordIsText := False;
      NumStart := NumI;
      HexFrom := NumStart;   // с какого знака слово должно быть hex-цифрами

      // &H1F, &O17, &B1010 - BASIC
      if FScheme.FNumHexAmp and (LineStr[NumI] = '&') and (NumI < LineLen) and
         (LineStr[NumI + 1] in ['h', 'H', 'o', 'O', 'b', 'B']) then
      begin
        Inc(NumI, 2);
        HexFrom := NumI;
        while (NumI <= LineLen) and
              (LineStr[NumI] in ['0'..'9', 'a'..'f', 'A'..'F']) do
          Inc(NumI);
        IsNum := NumI > NumStart + 2; // хотя бы одна цифра после &H
      end
      // 0x1F - стиль C
      else if FScheme.FNumHex0x and (LineStr[NumI] = '0') and (NumI < LineLen) and
              (LineStr[NumI + 1] in ['x', 'X']) then
      begin
        Inc(NumI, 2);
        HexFrom := NumI;
        while (NumI <= LineLen) and
              (LineStr[NumI] in ['0'..'9', 'a'..'f', 'A'..'F']) do
          Inc(NumI);
        IsNum := NumI > NumStart + 2;
      end
      // Обычное десятичное
      else if LineStr[NumI] in ['0'..'9'] then
      begin
        while (NumI <= LineLen) and (LineStr[NumI] in ['0'..'9']) do
          Inc(NumI);

        // Точка засчитывается, только если за ней снова цифра:
        // 3.14 - число, 33.caption - нет.
        if (NumI < LineLen) and (LineStr[NumI] = '.') and
           (LineStr[NumI + 1] in ['0'..'9']) then
        begin
          Inc(NumI);
          while (NumI <= LineLen) and (LineStr[NumI] in ['0'..'9']) do
            Inc(NumI);
        end;

        // Экспонента: 1e5 и 1.5E-3
        // Буква e принимается за экспоненту, только если за ней идёт показатель:
        // цифра или знак с цифрой. Иначе 10end осталось бы числом.
        if FScheme.FNumExp and (NumI <= LineLen) and (LineStr[NumI] in ['e', 'E']) then
        begin
          if (NumI < LineLen) and (LineStr[NumI + 1] in ['0'..'9']) then
          begin
            Inc(NumI, 2);
            while (NumI <= LineLen) and (LineStr[NumI] in ['0'..'9']) do
              Inc(NumI);
          end
          else if (NumI + 2 <= LineLen) and (LineStr[NumI + 1] in ['+', '-']) and
                  (LineStr[NumI + 2] in ['0'..'9']) then
          begin
            Inc(NumI, 3);
            while (NumI <= LineLen) and (LineStr[NumI] in ['0'..'9']) do
              Inc(NumI);
          end;
        end;

        IsNum := True;
      end;

      if IsNum then
      begin
        // Хвостовой суффикс типа: 100L, 3.14f, 10&
        while (NumI <= LineLen) and (LineStr[NumI] in FScheme.FNumSuffix) do
          Inc(NumI);

        // Слово на этом не кончилось - дальше буквы, цифры или '_'. Тогда
        // решаем за всё слово целиком, а не кусками: одни
        // шестнадцатеричные цифры (0000602F, 0000F484 в .map-файле) -
        // число; есть другие буквы или '_' (10end, 2nd) - текст, без
        // подсветки. Раньше число красилось до первой буквы, а остаток
        // слова оставался цветом текста. Слово с буквы (FDA4) сюда не
        // попадает: оно пропущено выше как имя - без префикса ($, 0x, &H)
        // его не отличить от идентификатора.
        if (NumI <= LineLen) and
           (LineStr[NumI] in ['a'..'z', 'A'..'Z', '0'..'9', '_']) then
        begin
          WordEnd := NumI;
          while (WordEnd <= LineLen) and
                (LineStr[WordEnd] in ['a'..'z', 'A'..'Z', '0'..'9', '_']) do
            Inc(WordEnd);
          for K := HexFrom to WordEnd - 1 do
            if not (LineStr[K] in ['0'..'9', 'a'..'f', 'A'..'F']) then
            begin
              IsNum := False;
              WordIsText := True;   // слово пропускаем целиком
              Break;
            end;
          NumI := WordEnd;
        end;
      end;

      if IsNum then
      begin
        if not IsCharInString(LineStartCharIdx + NumStart - 1) and
           not IsCharInBlockComment(LineStartCharIdx + NumStart - 1) then
          DrawRun(NumStart, NumI - 1, TokenColor, BgColor);
      end
      else if not WordIsText then
        NumI := NumStart + 1;
    end;
  end;

  procedure HighlightStrings(FromPos, ToPos: Integer);
  var
    SI, SStart: Integer;
    SFg, SBg: TColor;

    // Каким маркером открыт литерал, накрывающий позицию; -1 - основным
    function StrKindAt(CharIndex: Integer): Integer;
    var
      M: Integer;

      function Covers(AIdx: Integer): Boolean;
      begin
        Result := (AIdx >= 0) and (AIdx <= High(StringRanges)) and
                  (StringRanges[AIdx].StartPos <= CharIndex) and
                  (StringRanges[AIdx].EndPos > CharIndex);
      end;

    begin
      Result := 0;
      if Length(StringRanges) = 0 then
        Exit;
      M := FirstRangeFrom(StringRanges, CharIndex);
      if M < 0 then
        M := High(StringRanges);
      if not Covers(M) then
        Dec(M);
      if Covers(M) then
        Result := StringRanges[M].Kind;
    end;

  begin
    if FromPos < 1 then
      FromPos := 1;
    if ToPos > LineLen then
      ToPos := LineLen;

    SI := FromPos;
    while SI <= ToPos do
    begin
      if IsCharInString(LineStartCharIdx + SI - 1) then
      begin
        SStart := SI;
        while (SI <= ToPos) and IsCharInString(LineStartCharIdx + SI - 1) do
          Inc(SI);
        // Цвета того маркера, которым литерал открыт
        FScheme.StrColors(StrKindAt(LineStartCharIdx + SStart - 1), SFg, SBg);
        DrawRun(SStart, SI - 1, SFg, SBg);
      end
      else
        Inc(SI);
    end;
  end;

// Ищет начало строчного комментария начиная с позиции FromPos (1-базовой).
// Возвращает 0, если не найдено. Кавычки и блочные комментарии пропускаются.
  function FindLineCommentFrom(FromPos: Integer): Integer;
  var
    FI: Integer;
  begin
    Result := 0;
    if FScheme.FLineCommentMarker = '' then
      Exit;
    FI := FromPos;
    if FI < 1 then
      FI := 1;
    while FI <= LineLen - Length(FScheme.FLineCommentMarker) + 1 do
    begin
      if (LineStr[FI] = FScheme.FLineCommentMarker[1]) and
         (Copy(LineStr, FI, Length(FScheme.FLineCommentMarker)) = FScheme.FLineCommentMarker) then
        if not IsCharInString(LineStartCharIdx + FI - 1) and
           not IsCharInBlockComment(LineStartCharIdx + FI - 1) then
        begin
          Result := FI;
          Exit;
        end;
      Inc(FI);
    end;
  end;

// Ищет начало блочного комментария начиная с позиции FromPos (1-базовой).
// Опирается на карту CommentRanges: диапазон должен начинаться именно здесь,
// поэтому маркеры внутри кавычек и внутри других комментариев не мешают.
  function FindBlockStartFrom(FromPos: Integer): Integer;
  var
    Idx, M: Integer;
  begin
    Result := 0;
    if FScheme.FBlockCommentStart = '' then
      Exit;
    if FromPos < 1 then
      FromPos := 1;

    // Раньше здесь был перебор ВСЕХ диапазонов на каждый символ строки.
    // Теперь один двоичный поиск: берём первый диапазон, начинающийся не
    // раньше нужной позиции, и проверяем, попал ли он в эту строку.
    Idx := LineStartCharIdx + FromPos - 1;
    M := FirstRangeFrom(CommentRanges, Idx);
    if M < 0 then
      Exit;

    if CommentRanges[M].StartPos <= LineStartCharIdx + LineLen - 1 then
      Result := CommentRanges[M].StartPos - LineStartCharIdx + 1;
  end;

// Рисует остаток строки начиная с CommentPos как комментарий.
// AsBlock = True - цвета блочного комментария, False - строчного.
// AToPos - последний символ комментария в строке; 0 означает "до конца
// строки". Блочный комментарий может закрыться и посреди строки, и тогда
// хвост за ним - обычный код.
  procedure HighlightTrailingComment(CommentPos: Integer; AsBlock: Boolean;
                                     AKind: Integer; AToPos: Integer);
  var
    CText: string;
    CLevel: Integer;
    Fg, Bg: TColor;
  begin
    if (CommentPos < 1) or (CommentPos > LineLen) then
      Exit;
    if (AToPos <= 0) or (AToPos > LineLen) then
      AToPos := LineLen;
    if AToPos < CommentPos then
      Exit;

    CText := Copy(LineStr, CommentPos, AToPos - CommentPos + 1);
    if AsBlock then
      CLevel := GetCommentCustomLevel(CText, Length(FScheme.BcStartMark(AKind)) + 1)
    else
      CLevel := GetCommentCustomLevel(CText, Length(FScheme.FLineCommentMarker) + 1);

    if (CLevel >= 1) and (CLevel <= 5) then
    begin
      Fg := FScheme.FCustomFG[CLevel];
      Bg := FScheme.FCustomBG[CLevel];
    end
    else if AsBlock then
    begin
      FScheme.BcColors(AKind, Fg, Bg);
    end
    else
    begin
      Fg := FScheme.FLcFG;
      Bg := FScheme.FLcBG;
    end;

    DrawRun(CommentPos, AToPos, Fg, Bg);
  end;

// Группа отметки (LineMark) для обычной строки; -1 - слов отметки нет.
// Идентификаторы по порядку, как у ключевых слов, поэтому побеждает самое
// левое слово; при равенстве - группа, которая выше в файле схемы.
  function LineMarkGroup: Integer;
  var
    MI, MEnd, CmtPos, G, W, P, L, Best: Integer;
    Ident, Pat: string;
  begin
    Result := -1;
    if Length(FScheme.MarkGroups) = 0 then
      Exit;

    CmtPos := FindLineCommentFrom(1);
    if CmtPos <= 0 then
      CmtPos := LineLen + 1;
    Best := MaxInt;

    // ОДНОСЛОВНЫЕ ОБРАЗЦЫ: идентификаторы строки по порядку, поиск в списке.
    // Идут слева направо, поэтому первое попадание - самое левое.
    MI := 1;
    while MI < CmtPos do
    begin
      if LineStr[MI] in ['a'..'z', 'A'..'Z', '_'] then
      begin
        MEnd := MI;
        while (MEnd <= LineLen) and
              (LineStr[MEnd] in ['a'..'z', 'A'..'Z', '0'..'9', '_']) do
          Inc(MEnd);
        Ident := Copy(LineStr, MI, MEnd - MI);
        if not IsCharInString(LineStartCharIdx + MI - 1) and
           not IsCharInBlockComment(LineStartCharIdx + MI - 1) then
          for G := 0 to High(FScheme.MarkGroups) do
            if (FScheme.MarkGroups[G].Words <> nil) and
               (FScheme.MarkGroups[G].Words.IndexOf(Ident) >= 0) then
            begin
              Best := MI;
              Result := G;
              Break;
            end;
        if Best < MaxInt then
          Break;
        MI := MEnd;
      end
      else
        Inc(MI);
    end;

    // ОБРАЗЦЫ С ПРОБЕЛОМ ("end sub", "sub "): по идентификаторам их не
    // найти, ищем подстрокой, без учёта регистра. Граница слова проверяется
    // только у того края, который сам буквенный: у образца 'sub ' правый
    // край - пробел, и следом за ним имя подпрограммы - совпадение.
    // Побеждает всё равно самое левое совпадение, поэтому просмотр идёт
    // только левее уже найденного.
    for G := 0 to High(FScheme.MarkGroups) do
    begin
      if FScheme.MarkGroups[G].Words = nil then
        Continue;
      for W := 0 to FScheme.MarkGroups[G].Words.Count - 1 do
      begin
        Pat := FScheme.MarkGroups[G].Words[W];
        L := Length(Pat);
        if (L = 0) or (Pos(' ', Pat) = 0) then
          Continue;
        for P := 1 to CmtPos - L do
        begin
          if P >= Best then
            Break;
          if (AnsiStrLIComp(PChar(@LineStr[P]), PChar(Pat), L) = 0) and
             (not (Pat[1] in ['a'..'z', 'A'..'Z', '0'..'9', '_']) or
              (P = 1) or
              not (LineStr[P - 1] in ['a'..'z', 'A'..'Z', '0'..'9', '_'])) and
             (not (Pat[L] in ['a'..'z', 'A'..'Z', '0'..'9', '_']) or
              (P + L > LineLen) or
              not (LineStr[P + L] in ['a'..'z', 'A'..'Z', '0'..'9', '_'])) and
             not IsCharInString(LineStartCharIdx + P - 1) and
             not IsCharInBlockComment(LineStartCharIdx + P - 1) then
          begin
            Best := P;
            Result := G;
            Break;
          end;
        end;
      end;
    end;
  end;

// Окно длинной строки целиком внутри строчного комментария, начатого
// левее окна. Цвета - как у HighlightTrailingComment для строчного.
  procedure DrawWholeLineComment(ALevel: Integer);
  begin
    if (ALevel >= 1) and (ALevel <= 5) then
      DrawRun(1, LineLen, FScheme.FCustomFG[ALevel], FScheme.FCustomBG[ALevel])
    else
      DrawRun(1, LineLen, FScheme.FLcFG, FScheme.FLcBG);
  end;

// Пара под кареткой: два отрезка, обычно по одному символу у скобок и по
// целому тегу в разметке. Рисуется поверх текста, как и всё остальное в
// этом слое.
  procedure DrawPairMark;

    procedure DrawOne(AFrom, ATo: Integer);
    var
      F, T: Integer;
      FgColor: TColor;
    begin
      if AFrom < 0 then
        Exit;
      // В координаты строки, от единицы
      F := AFrom - LineStartCharIdx + 1;
      T := ATo - LineStartCharIdx + 1;
      if (T < 1) or (F > LineLen) then
        Exit;
      if F < 1 then
        F := 1;
      if T > LineLen then
        T := LineLen;
      // Цвет текста пары не задан (clNone) - цвет скобки по уровню
      FgColor := FScheme.FPairFG;
      if FgColor = clNone then
        FgColor := BracketColorAt(AFrom);
      DrawRun(F, T, ColorToRGB(FgColor), ColorToRGB(FScheme.FPairBG));
    end;

  begin
    DrawOne(FPairA1, FPairA2);
    DrawOne(FPairB1, FPairB2);
  end;

// Каретка на скобке: все скобки строки - цветами линий отступа по уровню
  procedure DrawLineBrackets;
  var
    BrIdx, F: Integer;
    BgColor: TColor;
  begin
    BgColor := FScheme.FTextBG;
    if BgColor = clNone then
      BgColor := RichEdit1.Color;
    for BrIdx := 0 to High(FLineBrackets) do
    begin
      F := FLineBrackets[BrIdx].X - LineStartCharIdx + 1;
      if (F >= 1) and (F <= LineLen) then
        DrawRun(F, F, ColorToRGB(BracketColorAt(FLineBrackets[BrIdx].X)),
                ColorToRGB(BgColor));
    end;
  end;

// Непечатные символы: точка на месте пробела, двойная стрелка на месте
// табуляции - по всей строке, включая хвостовые пробелы. Рисуется поверх
// уже выведенного текста прозрачным фоном, поэтому подсветка под знаком
// сохраняется, а сам текст не меняется ни на байт.
  procedure DrawWhitespaceMarks;
  var
    WI, WX: Integer;
    Mark: string;
  begin
    SetBkMode(DC, TRANSPARENT);
    SetTextColor(DC, ColorToRGB(WhiteMarkColor));
    try
      for WI := 1 to LineLen do
      begin
        if LineStr[WI] = ' ' then
          Mark := SpaceMarkChar
        else if LineStr[WI] = #9 then
          Mark := TabMarkChar
        else
          Continue;

        WX := LineStartX + LineXPos[WI - 1];
        Windows.TextOutA(DC, WX, Pt.Y, PChar(Mark), 1);
      end;
    finally
      SetBkMode(DC, OPAQUE);
    end;
  end;

// Метка у края окна: полоса уровня ALevel уходит за верхний (ATop) или
// нижний край. Прямоугольник полным цветом уровня (сама полоса -
// бледным), шириной с полосу, но не уже 5 точек, высотой в полстроки.
// Запоминается в FGuideMarks для щелчка.
  procedure AddGuideMark(AX, AW: Integer; ATop: Boolean; ALevel: Integer);
  var
    MarkW, MarkH, MarkY, MarkIdx: Integer;
    MarkBox: TRect;
  begin
    MarkW := AW;
    if MarkW < 5 then
      MarkW := 5;
    MarkH := LineHeight div 2;
    if MarkH < 6 then
      MarkH := 6;
    if ATop then
      MarkY := 0
    else
      MarkY := RichEdit1.ClientHeight - MarkH;
    MarkBox := Rect(AX, MarkY, AX + MarkW, MarkY + MarkH);
    if GuideMarkBrushes[ALevel mod HotTabLevels] <> 0 then
      Windows.FillRect(DC, MarkBox, GuideMarkBrushes[ALevel mod HotTabLevels]);
    MarkIdx := Length(FGuideMarks);
    SetLength(FGuideMarks, MarkIdx + 1);
    FGuideMarks[MarkIdx].Box := MarkBox;
    FGuideMarks[MarkIdx].Line := CurrentLineIdx;
    FGuideMarks[MarkIdx].Level := ALevel;
    FGuideMarks[MarkIdx].AtTop := ATop;
  end;

// Направляющие отступов: слева от текста рисуются полосы, по одной на
// уровень вложенности строки. Рисуется последней, поверх всего остального,
// иначе заливку затрёт комментарий во всю строку.
//
// СКОЛЬКО полос - берётся из FLineDepth: там вложенность по БЛОКАМ
// (begin/end, class, record, try, оператор без begin под then/do/else).
// Поэтому раздел var или type полосы не даёт, хотя отступ там есть, а
// пустая строка внутри блока полосы получает - столбик не рвётся.
// Список пуст (язык без слов блоков) - как раньше, по ведущим пробелам.
//
// ГДЕ полосы - по ведущим пробельным символам самой строки: табуляция это
// уровень, группа из FIndentSize пробелов тоже. Уровням, которым в строке
// места не хватило, колонки досчитываются шагом. Под текст полоса не
// лезет: колонка правее первого непробельного символа пропускается.
  procedure DrawTabGuides;
  const
    MaxBars = 64;
  var
    GI, Level, GX1, GX2, GW, GT, GIdx, GStep, GRun, GStart: Integer;
    BarCount, NCols, C, FirstCol, GCell: Integer;
    Cols: array[0..MaxBars - 1] of Integer; // колонки уровней, от нуля
    GRect: TRect;
  begin
    // Отступов не делаем - и подсвечивать нечего
    if FIndentKind = IndentNone then
      Exit;

    // Шаг и вид символа - из настроек: они описывают, как файл выглядит
    // ПОСЛЕ форматирования. Файл, отбитый иначе, показывается с
    // нарушениями как есть - это и есть признак, что его пора
    // отформатировать.
    GStep := FIndentSize;
    if GStep < 1 then
      GStep := 2;

    // Сколько знакомест занимает один символ отступа: таб на экране шире
    // пробела. Нужно только на ПУСТОЙ строке: там текста нет, координата
    // считается напрямую, а не по LineXPos. Сама колонка везде меряется в
    // символах - с ней сравнивается FirstCol.
    if FIndentKind = IndentTabs then
      GCell := FTabChars
    else
      GCell := 1;
    if GCell < 1 then
      GCell := 1;

    // Колонки уровней по отступу строки. Единица - любой пробельный
    // символ, будь то пробел или табуляция: уровень это GStep таких
    // символов, ровно столько же их ставит и форматировщик. Файл, отбитый
    // не так, даст полосы не по структуре - это принято сознательно.
    NCols := 0;
    GRun := 0;
    GStart := 1;
    GI := 1;
    while (GI <= LineLen) and (LineStr[GI] in [#9, ' ']) do
    begin
      if GRun = 0 then
        GStart := GI;
      Inc(GRun);
      if GRun >= GStep then
      begin
        if NCols < MaxBars then
        begin
          Cols[NCols] := GStart - 1;
          Inc(NCols);
        end;
        GRun := 0;
      end;
      Inc(GI);
    end;
    FirstCol := GI - 1; // колонка первого непробельного символа, от нуля

    // Строка внутри блочного комментария или многострочного литерала:
    // её отступ - часть текста, а не структуры. Свои группы отбрасываем и
    // считаем колонки стандартным шагом, иначе столбик уровня уезжал бы
    // за отступом комментария и рвался.
    if InRanges(CommentRanges, LineStartCharIdx) or
       InRanges(StringRanges, LineStartCharIdx) then
      NCols := 0;

    // Сколько полос: по вложенности строки; сведений нет - по её пробелам
    if (CurrentLineIdx >= 0) and (CurrentLineIdx <= High(FLineDepth)) then
      BarCount := FLineDepth[CurrentLineIdx]
    else
      BarCount := NCols;
    if BarCount > MaxBars then
      BarCount := MaxBars;

    // Полосы идут от левого края строки: первый уровень в первой группе
    // отступа, второй во второй и так далее. Групп может оказаться больше,
    // чем уровней - у строки продолжения с ручным выравниванием или в
    // файле, отбитом не по настройке; лишние просто не используются.
    for Level := 0 to BarCount - 1 do
    begin
      if Level < NCols then
        C := Cols[Level]
      else if NCols > 0 then
        C := Cols[NCols - 1] + (Level - NCols + 1) * GStep
      else
        C := Level * GStep;

      // Правее текста полосу не ставим: строка с отступом меньше своей
      // вложенности получит столько полос, сколько влезло в отступ
      // Строка из одних пробелов (отступ, поставленный Enter) - как
      // пустая: полосы по вложенности, без разрыва
      if (FirstCol < LineLen) and (C >= FirstCol) then
        Break;

      GIdx := LineStartCharIdx + C;
      // Под выделением полосу не рисуем, иначе затрём подсветку выделения
      if (SelMax > SelMin) and (GIdx >= SelMin) and (GIdx < SelMax) then
        Continue;

      // Маркер в начале уровня. Его ширина не привязана к символу: это
      // просто FHotTabBarWidth пикселей, но не больше ширины символа.
      // Значение <= 0 означает "во всю ширину символа".
      GW := FHotTabBarWidth;
      if (GW <= 0) or (GW > CharW) then
        GW := CharW;

      if (LineLen > 0) and (C <= LineLen) then
        GX1 := LineStartX + LineXPos[C]
      else
        // Пустая строка: ширина символа отступа своя у таба и у пробела
        GX1 := LineStartX + C * GCell * CharW;
      GX2 := GX1 + GW;
      if GX2 > GX1 then
      begin
        GRect := Rect(GX1, Pt.Y, GX2, Pt.Y + LineHeight);
        // Цвет по уровню вложенности, с зацикливанием после пятого
        Windows.FillRect(DC, GRect, HotTabBrushes[Level mod HotTabLevels]);

        // Полоса продолжается за верхним или нижним краем окна - метка у
        // края (щелчок по ней - начало блока в панели объявления)
        if (CurrentLineIdx = FirstVisibleLine) and (CurrentLineIdx > 0) and
           (CurrentLineIdx - 1 <= High(FLineDepth)) and
           (FLineDepth[CurrentLineIdx - 1] > Level) then
          AddGuideMark(GX1, GW, True, Level);
        if (CurrentLineIdx = LastVisibleLine) and
           (CurrentLineIdx + 1 <= High(FLineDepth)) and
           (FLineDepth[CurrentLineIdx + 1] > Level) then
          AddGuideMark(GX1, GW, False, Level);

        // Последняя строка раздела объявлений: засечка вправо по низу
        // строки, полоса и засечка вместе - уголок. Толщина - как у полосы,
        // но не больше двух пикселей: полоса бывает во всю ширину символа.
        if (CurrentLineIdx >= 0) and (CurrentLineIdx <= High(FLineTick)) and
           (FLineTick[CurrentLineIdx] = Level + 1) then
        begin
          GT := GW;
          if GT > 2 then
            GT := 2;
          GRect := Rect(GX1, Pt.Y + LineHeight - GT, GX1 + CharW,
                        Pt.Y + LineHeight);
          Windows.FillRect(DC, GRect, HotTabBrushes[Level mod HotTabLevels]);
        end;
      end;
    end;
  end;

// Полный разбор кодовой части строки в диапазоне [FromPos..ToPos].
// Числа, операторы и ключевые слова сами пропускают символы внутри строк
// и блочных комментариев, поэтому им хватает карт диапазонов.
  procedure HighlightCodeRange(FromPos, ToPos: Integer);
  var
    OpI: Integer;
  begin
    // Операторы ПЕРЕД числами: в &H1F и 3.14 символы & и . обычно входят
    // в набор операторов, и число должно перекрыть их, а не наоборот.
    // Групп операторов может быть несколько - рисуем по порядку, поэтому
    // символ из двух групп останется цветом той, что ниже в файле схемы.
    for OpI := 0 to High(FScheme.OpGroups) do
      HighlightTokenSet(FScheme.OpGroups[OpI].Chars, FScheme.OpGroups[OpI].FgColor,
                        FScheme.OpGroups[OpI].BgColor, FromPos, ToPos);
    HighlightNumbers(FScheme.FDgFG, FScheme.FDgBG, FromPos, ToPos);
    Lap(FPerfTok);
    HighlightKeywordsAll(FromPos, ToPos);
    Lap(FPerfKw);
    HighlightStrings(FromPos, ToPos);
  end;

begin
  if FLockHighlight then
    Exit;
  // Выключенная подсветка больше не повод выйти сразу: основной текст рисуем
  // тоже мы, и без него окно останется пустым. Ниже пропускается только разбор
  // на токены.

  // Подсветку могли включить обратно после того, как карту перестали
  // поддерживать. Восстанавливаем здесь, а не в обработчике галки: так
  // не важно, кто и откуда её переключил.
  if FUseSyntaxHighlight and FMapStale then
    RebuildCommentRangeMap;
  // Карта после правки разобрана только до прежнего низа экрана, а экран
  // прокрутили ниже - доразобрать видимое (полная пересборка ещё впереди)
  if FUseSyntaxHighlight and (FMapPartialEnd > 0) then
    RescanVisibleMap(FMapPartialEnd, False);
  if FUseSyntaxHighlight then
    EnsureKeywordHash;

  FPerfXPos := 0;
  FPerfBase := 0;
  FPerfKw := 0;
  FPerfTok := 0;
  FDrawCalls := 0;
  FInfoBuilds := 0;
  FCmtCalls := 0;
  FPerfCmt := 0;

  FLockHighlight := True;
  // Идёт буферизованная отрисовка - пишем в буфер, иначе прямо на экран
  if FPaintDC <> 0 then
    DC := FPaintDC
  else
    DC := GetDC(RichEdit1.Handle);
  try
    SelectObject(DC, RichEdit1.Font.Handle);
    SetBkMode(DC, OPAQUE);

    // TabStopN выставляет ApplyTabStops по FTabChars - здесь не трогаем
    if TabStopN <= 0 then
      TabStopN := 48;
    if GetTextMetrics(DC, Metrics) then
    begin
      LineHeight := Metrics.tmHeight + Metrics.tmExternalLeading;
      CharW := Metrics.tmAveCharWidth;
    end
    else
    begin
      LineHeight := 16; // метрики недоступны - берём безопасные значения
      CharW := 8;
    end;
    if CharW < 1 then
      CharW := 1;

    // Кисти направляющих создаём ОДИН раз на кадр, а не на каждую строку
    for HB := 0 to HotTabLevels - 1 do
      if FUseHotTab then
      begin
        HotTabBrushes[HB] := CreateSolidBrush(ColorToRGB(PaleColor(FHotTabColors[HB])));
        GuideMarkBrushes[HB] := CreateSolidBrush(ColorToRGB(FHotTabColors[HB]));
      end
    else
    begin
      HotTabBrushes[HB] := 0;
      GuideMarkBrushes[HB] := 0;
    end;
    // Метки краёв - заново на каждый кадр
    SetLength(FGuideMarks, 0);

    UpdateVisibleBounds;

    // Отметки Format text - снять, если номера строк уже не те
    FmtSuspectCheck;

    // Копим заново на каждый кадр: видимые строки сменились
    FMaxVisW := 0;

    SendMessageA(RichEdit1.Handle, EM_EXGETSEL, 0, Integer(@Sel));
    SelMin := Sel.cpMin;
    SelMax := Sel.cpMax;
    SelBgRgb := ColorToRGB(UiColor('Editor.SelBG'));
    SelFgRgb := ColorToRGB(UiColor('Editor.SelText'));

    LineStartCharIdx := SendMessageA(RichEdit1.Handle, EM_LINEINDEX, FirstVisibleLine, 0);
    SendMessageA(RichEdit1.Handle, EM_POSFROMCHAR, Integer(@FirstCharPos), LineStartCharIdx);
    if LineStartCharIdx <> -1 then
      YOffset := FirstCharPos.Y
    else
      YOffset := 0;

    // ГЛАВНЫЙ ПОСТРОЧНЫЙ ЦИКЛ ПО ВИДИМОЙ ОБЛАСТИ
    GdiFlush;
    TMark := PerfNow;
    for CurrentLineIdx := FirstVisibleLine to LastVisibleLine do
    begin
      Lap(FPerfTok); // хвост разбора предыдущей строки
      LineStartCharIdx := SendMessageA(RichEdit1.Handle, EM_LINEINDEX, CurrentLineIdx, 0);
      LineLen := SendMessageA(RichEdit1.Handle, EM_LINELENGTH, LineStartCharIdx, 0);

      // Сдвиг НАШ: своей прокрутки у контрола при такой ширине не бывает
      Pt.X := -FScrollX;
      Pt.Y := ((CurrentLineIdx - FirstVisibleLine) * LineHeight) + YOffset;

      // Пустая строка: рисовать в ней нечего, кроме направляющих полос -
      // без них столбик уровня рвался бы на каждом пропуске между
      // операторами
      if LineLen <= 0 then
      begin
        LineStartX := Pt.X;
        if FUseHotTab then
          DrawTabGuides;
        Continue;
      end;

      LineStartX := Pt.X;
      TabOrigin := Pt.X;
      WinStart := 1;
      XOff := 0;
      LineCommentBefore := False;
      LineCommentLevel := 0;
      // Заголовки тел из списка подпрограмм отмечены всегда - по ним видно,
      // где начинается подпрограмма; так же отмечена строка, на которую
      // перешли из списка. Им - пара SubBody; объявления в interface
      // ловятся ниже по словам LineMark и остаются его цветом.
      LineIsBody := (CurrentLineIdx = FFoundLine) or
                    IsSubBeginLine(CurrentLineIdx);
      LineMarked := LineIsBody;
      MarkIdx := -1; // группу ищем ниже, когда строка не заголовок тела

      if LineLen >= LongLineMin then
      begin
        // ДЛИННАЯ СТРОКА: сведения из кэша, читается только видимый кусок
        InfoIdx := GetLineInfo(DC, CurrentLineIdx, LineStartCharIdx,
                               LineLen, FullStr);
        LineTotalW := FLineInfo[InfoIdx].CTotalW;

        // Строчный комментарий, начатый левее окна, в окне не найти -
        // ищем его по всей строке, один раз на версию карт
        FullStr := '';
        if FUseSyntaxHighlight and
           not (FLineInfo[InfoIdx].CCommentKnown and
                (FLineInfo[InfoIdx].CMapVer = FMapVer)) then
        begin
          Inc(FCmtCalls);
          TMarkC := PerfNow;
          ComputeLineComment(InfoIdx);
          Inc(FPerfCmt, PerfNow - TMarkC);
        end;
        if not LineMarked and FUseSyntaxHighlight and
           (Length(FScheme.MarkGroups) > 0) then
        begin
          if not (FLineInfo[InfoIdx].CMarkKnown and
                  (FLineInfo[InfoIdx].CMarkMapVer = FMapVer)) then
            ComputeLineMark(InfoIdx);
          MarkIdx := FLineInfo[InfoIdx].CMarkGroup;
          LineMarked := MarkIdx >= 0;
        end;
        LineStr := '';

        // Окно: блок левее видимой области и блок правее - с запасом, чтобы
        // слово, разрезанное краем окна, не попало на экран
        KFrom := BlockAtX(InfoIdx, FScrollX) - 1;
        if KFrom < 0 then
          KFrom := 0;
        KTo := BlockAtX(InfoIdx, FScrollX + ViewWidth) + 1;
        if KTo > High(FLineInfo[InfoIdx].CSegIdx) - 1 then
          KTo := High(FLineInfo[InfoIdx].CSegIdx) - 1;
        WinStart := FLineInfo[InfoIdx].CSegIdx[KFrom] + 1;
        WinEnd := FLineInfo[InfoIdx].CSegIdx[KTo + 1];

        // Ширина самой длинной видимой строки - на ней держится диапазон
        // горизонтальной полосы, см. UpdateScrollBars
        if LineTotalW > FMaxVisW then
          FMaxVisW := LineTotalW;

        if WinEnd < WinStart then
          Continue; // прокручено правее конца строки

        LineStr := TextRange(LineStartCharIdx + WinStart - 1,
                             WinEnd - WinStart + 1);
        WK := Pos(#0, LineStr);
        if WK > 0 then
          SetLength(LineStr, WK - 1);
        LineLen := Length(LineStr);
        if LineLen <= 0 then
          Continue;

        // Таблица окна: от его начала, табуляции - от начала строки
        XOff := FLineInfo[InfoIdx].CSegX[KFrom];
        SetLength(LineXPos, LineLen + 1);
        LineXPos[0] := 0;
        MeasureRun(DC, PChar(Pointer(LineStr)), LineLen, XOff,
                   PBigIntArr(@LineXPos[1]));
        for WK := 1 to LineLen do
          Dec(LineXPos[WK], XOff);

        LineCommentBefore := FUseSyntaxHighlight and
          (FLineInfo[InfoIdx].CLineComment > 0) and
          (FLineInfo[InfoIdx].CLineComment < WinStart);
        LineCommentLevel := FLineInfo[InfoIdx].CCommentLevel;

        // Дальше всё работает с окном как с отдельной строкой
        LineStartCharIdx := LineStartCharIdx + WinStart - 1;
        LineStartX := TabOrigin + XOff;
      end
      else
      begin
        LineStr := ReadLineText(CurrentLineIdx, LineStartCharIdx, LineLen);
        // Строка обрезана на первом #0, а разбор идёт до LineLen
        if Length(LineStr) < LineLen then
          LineLen := Length(LineStr);
        if LineLen <= 0 then
          Continue;

        // Отметка строки - по словам в самой строке
        if not LineMarked and FUseSyntaxHighlight then
        begin
          MarkIdx := LineMarkGroup;
          LineMarked := MarkIdx >= 0;
        end;

        // Таблица координат для всей строки
        LineXPos := MeasureLineXPos(DC, LineStr, LineLen);
        LineTotalW := LineXPos[LineLen];
        if LineTotalW > FMaxVisW then
          FMaxVisW := LineTotalW;
      end;
      LinePtr := PChar(LineStr);

      // Видимая часть строки (окна), с запасом в символ с каждой стороны - на
      // выступающие за ячейку глифы
      VisFrom := CharRightOf(FScrollX - XOff) - 1;
      if VisFrom < 1 then
        VisFrom := 1;
      VisTo := CharRightOf(FScrollX - XOff + ViewWidth) + 1;
      if VisTo > LineLen then
        VisTo := LineLen;
      Lap(FPerfXPos);

      // БАЗОВЫЙ СЛОЙ: вся строка обычными цветами редактора. DrawRun сам разрежет
      // её по границам выделения, поэтому выделение работает и на тех словах,
      // которые подсветка не трогает.
      // Цвета отметки ЭТОЙ строки. Заголовок тела подпрограммы - пара
      // SubBody; раздела в схеме нет - цвета первой группы LineMark, как
      // было до появления SubBody. Остальные отмеченные строки - цвета
      // своей группы.
      MarkFG := clNone;
      MarkBG := clYellow;
      if LineIsBody then
      begin
        if FScheme.FSubBodyHasColors then
        begin
          MarkFG := FScheme.FSubBodyFG;
          MarkBG := FScheme.FSubBodyBG;
        end
        else if Length(FScheme.MarkGroups) > 0 then
        begin
          MarkFG := FScheme.MarkGroups[0].FgColor;
          MarkBG := FScheme.MarkGroups[0].BgColor;
        end;
      end
      else if (MarkIdx >= 0) and (MarkIdx <= High(FScheme.MarkGroups)) then
      begin
        MarkFG := FScheme.MarkGroups[MarkIdx].FgColor;
        MarkBG := FScheme.MarkGroups[MarkIdx].BgColor;
      end;

      // Format text: строка, код которой кончается точкой (FFmtSusLine)
      if (Length(FFmtSusLine) > 0) and FmtSuspectAt(CurrentLineIdx) then
      begin
        LineMarked := True;
        MarkBG := UiColor('Format.SuspectBG');
        MarkFG := UiColor('Format.SuspectText');
      end;

      // Точка останова и строка остановки - поверх отметок, своими цветами
      DbgKind := DbgLineKind(CurrentLineIdx);
      if DbgKind > 0 then
      begin
        LineMarked := True;
        case DbgKind of
          1:
          begin
            MarkBG := UiColor('Debug.BreakBG');
            MarkFG := UiColor('Debug.BreakText');
          end;
          2:
          begin
            MarkBG := UiColor('Debug.NoCodeBG');
            MarkFG := UiColor('Debug.BreakText');
          end;
        else
          MarkBG := UiColor('Debug.ExecBG');
          MarkFG := UiColor('Debug.ExecText');
        end;
      end;

      // Отмеченная строка - фон на всю ширину, до и после текста
      if LineMarked then
      begin
        MarkBr := CreateSolidBrush(ColorToRGB(MarkBG));
        Windows.FillRect(DC, Rect(0, Pt.Y, ViewWidth, Pt.Y + LineHeight),
                         MarkBr);
        DeleteObject(MarkBr);
      end;

      DrawRun(1, LineLen, RichEdit1.Font.Color, FScheme.FTextBG);
      Lap(FPerfBase);

      // Подсветка может быть отключена в настройках - тогда остаёмся на
      // базовом слое, но направляющие отступов рисуем в любом случае.
      if FUseSyntaxHighlight then
      begin
        if LineCommentBefore then
          DrawWholeLineComment(LineCommentLevel)
        else
        begin
          IsBlockComment := CheckLineStartsInBlockComment(LineStartCharIdx);

          // =================================================================
          // СЦЕНАРИЙ №1: строка НАЧИНАЕТСЯ внутри блочного комментария
          // =================================================================
          if IsBlockComment then
          begin
            // Пара маркеров, которой открыт этот комментарий: её закрывающий
            // маркер и её цвета
            BcKind := BlockKindAt(LineStartCharIdx);
            FScheme.BcColors(BcKind, BcFg, BcBg);
            BcEnd := FScheme.BcEndMark(BcKind);

            if BcEnd = '' then
              LineCommentPos := 0
            else
              LineCommentPos := Pos(BcEnd, LineStr);

            if LineCommentPos = 0 then
              // Закрытия в этой строке нет - вся строка комментарий
              DrawRun(1, LineLen, BcFg, BcBg)
            else
            begin
              // Комментарий закрылся: голова до маркера включительно
              CodeLenToParse := LineCommentPos + Length(BcEnd) - 1;
              DrawRun(1, CodeLenToParse, BcFg, BcBg);

              // Хвост за маркером - обычный код, в котором может начаться
              // ещё один комментарий, строчный или блочный
              TailStart := CodeLenToParse + 1;
              TailIsBlock := False;
              TailCommentPos := FindLineCommentFrom(TailStart);
              TailBlockPos := FindBlockStartFrom(TailStart);

              if (TailBlockPos > 0) and
                 ((TailCommentPos = 0) or (TailBlockPos < TailCommentPos)) then
              begin
                TailCommentPos := TailBlockPos;
                TailIsBlock := True;
              end;

              if TailCommentPos > 0 then
              begin
                HighlightCodeRange(TailStart, TailCommentPos - 1);
                HighlightTrailingComment(TailCommentPos, TailIsBlock,
                                         BlockKindAt(LineStartCharIdx + TailCommentPos - 1), 0);
              end
              else
                HighlightCodeRange(TailStart, LineLen);
            end;
          end;

          // ====// СЦЕНАРИЙ №2: Строка НАЧИНАЕТСЯ как обычный код
          if not IsBlockComment then
          begin
            // Идём по строке слева направо: код до ближайшего комментария,
            // сам комментарий, потом снова код. Блочный комментарий может
            // закрыться в этой же строке, и тогда за ним опять код - в
            // '#incl/*  */ude "file"' комментарием должна быть только
            // середина. Строчный комментарий идёт до конца строки и цикл
            // обрывает.
            CurPos := 1;
            while CurPos <= LineLen do
            begin
              IsMixedBlockComment := False;
              LineCommentPos := FindLineCommentFrom(CurPos);
              BlockStart := FindBlockStartFrom(CurPos);

              if (BlockStart > 0) and
                 ((LineCommentPos = 0) or (BlockStart < LineCommentPos)) then
              begin
                LineCommentPos := BlockStart;
                IsMixedBlockComment := True;
              end;

              // Комментариев дальше нет - остаток строки это код
              if LineCommentPos = 0 then
              begin
                HighlightCodeRange(CurPos, LineLen);
                Break;
              end;

              if LineCommentPos > CurPos then
                HighlightCodeRange(CurPos, LineCommentPos - 1);

              // Строчный - до конца строки
              if not IsMixedBlockComment then
              begin
                HighlightTrailingComment(LineCommentPos, False, -1, 0);
                Break;
              end;

              // Блочный: где он кончается по карте
              if not BlockRangeAt(LineStartCharIdx + LineCommentPos - 1,
                                  BcKind, BcEndIdx) then
              begin
                HighlightTrailingComment(LineCommentPos, True, -1, 0);
                Break;
              end;

              // BcEndIdx - позиция ЗА комментарием, отсюда без +1
              CmtEnd := BcEndIdx - LineStartCharIdx;
              if CmtEnd >= LineLen then
              begin
                // Кончается за пределами строки - дальше рисовать нечего
                HighlightTrailingComment(LineCommentPos, True, BcKind, 0);
                Break;
              end;

              HighlightTrailingComment(LineCommentPos, True, BcKind, CmtEnd);
              CurPos := CmtEnd + 1;
            end;
          end;

        end; // if not LineCommentBefore
      end; // if FUseSyntaxHighlight

      // Скобки строки каретки - цветами уровней, пара под кареткой - поверх
      // них своей подложкой; всё поверх текста, но под направляющими
      if Length(FLineBrackets) > 0 then
        DrawLineBrackets;
      if FPairA1 >= 0 then
        DrawPairMark;

      // Непечатные символы - поверх текста, по всему видимому окну строки
      if FShowSpaces then
        DrawWhitespaceMarks;

      // Направляющие отступов - последним слоем. Отступ стоит в начале
      // строки, и в окне, начатом не с неё, его нет.
      if FUseHotTab and (WinStart = 1) then
        DrawTabGuides;
    end;
    Lap(FPerfTok);
  finally
    for HB := 0 to HotTabLevels - 1 do
    begin
      if HotTabBrushes[HB] <> 0 then
        DeleteObject(HotTabBrushes[HB]);
      if GuideMarkBrushes[HB] <> 0 then
        DeleteObject(GuideMarkBrushes[HB]);
    end;
    if FPaintDC = 0 then
      ReleaseDC(RichEdit1.Handle, DC);
    FLockHighlight := False;
  end;
end;

procedure TForm1.FormShow(Sender: TObject);
var
  DC: HDC;
  Metrics: TTextMetric;
  I: Integer;
begin
  // Конец запуска - сообщением: оно придёт, когда FormShow закончится (и
  // если в нём что-то упадёт - окно всё равно станет видимым)
  if StartupActive then
  begin
    StartupStage('Показ окна: редактор');
    PostMessage(Handle, WM_USER + 330, 0, 0);
  end;
  // Снимаем ограничение на объём текста - см. EnsureTextLimit
  EnsureTextLimit;
  EnsureNoWrap;
  EnsureEventMask;

  if MsftEditActive then
    LogDiag('RichEdit 4.1 (msftedit.dll, RICHEDIT50W)')
  else
    LogDiag('RichEdit 3.0 (riched20.dll): msftedit.dll не загружена');

  // Итог проверки путей editor.ini (CheckIniPaths в FormCreate)
  if FIniPathLog <> nil then
  begin
    for I := 0 to FIniPathLog.Count - 1 do
      LogDiag(FIniPathLog[I]);
    FreeAndNil(FIniPathLog);
  end;

  DC := GetDC(RichEdit1.Handle);
  try
    SelectObject(DC, RichEdit1.Font.Handle);
    // Автоматически узнаем параметры выбранного шрифта у Windows
    if GetTextMetrics(DC, Metrics) then
    begin
      LineHeight := Metrics.tmHeight + Metrics.tmExternalLeading;
    end
    else
    begin
      LineHeight := 16;
    end;
  finally
    // ИСПРАВЛЕНИЕ: Гарантированно освобождаем контекст устройства, предотвращая краш интерфейса!
    ReleaseDC(RichEdit1.Handle, DC);
  end;

  // Настройки читаем ДО ApplyTabStops: она опирается на FTabChars
  StartupStage('Настройки');
  LoadSettings;
  // IDE Options - Preferences, Designer, Environment Variables
  EnvInit;
  RebuildReopenMenu; // список недавних файлов уже прочитан

  // Проекты, которых нет по записанному пути, - поиск по копиям разделов
  // и по переехавшему дереву папок. Здесь, а не при проверке путей в
  // FormCreate: поиску нужны горячие папки, они читаются в LoadSettings.
  StartupStage('Проверка путей проектов');
  RelocateMissingProjects;

  // Шаг табуляции RichEdit приводим к выбранной ширине
  ApplyTabStops;

  // Демонстрационный стартовый текст
  SetEditorText('// Однострочный комментарий /* begin ' + #13#10 + '/* Много''строчн''ый блок кода, /* // begin   ' + #13#10 + '   который теперь идеально' + #13#10 + '   переносится на новые строки! */' + #13#10 + 'procedure Init;' + #13#10 + 'begin' + #13#10 + '  mov eax, 1 // Коммент/* арий ''до конца'' строки' + #13#10 + '  push eax' + #13#10 + 'end;  exit cstriing=' + '''qw//erty /*5434*/5''');

  // Строим карту для стартового текста
  RebuildCommentRangeMap;
  RichEditLinesCount := SendMessageA(RichEdit1.Handle, EM_GETLINECOUNT, 0, 0);
  UpdateVisibleBounds;

  // У класса окна RichEdit выставлен CS_HREDRAW, но не CS_VREDRAW. Поэтому смена
  // ВЫСОТЫ инвалидирует только новую полосу, а смена ШИРИНЫ - всю клиентскую
  // область, и так на каждый пиксель протяжки рамки. Отсюда мерцание только при
  // горизонтальном ресайзе. Перенос строк выключен (WordWrap = False), значит
  // разметка от ширины не зависит и полная перерисовка не нужна.
  SetClassLong(RichEdit1.Handle, GCL_STYLE,
               GetClassLong(RichEdit1.Handle, GCL_STYLE) and not CS_HREDRAW);

  // Сабклассинг RichEdit
  OldRichEditProc := RichEdit1.WindowProc;
  RichEdit1.WindowProc := NewRichEditProc;

  // Динамически подключаем событие изменений
  RichEdit1.OnChange := RichEdit1Change;

  // Ширину редактора задаём ЗДЕСЬ, а не в дизайнере.
  //
  // Смысл в том, чтобы она не менялась вместе с окном: именно смена ШИРИНЫ
  // запускает у RichEdit работу, растущую с размером документа, - замер на
  // голом контроле дал 32 мс на 600 КБ и 335 мс на 32 МБ. Пока ширина
  // постоянна, этой работы нет, а лишнее обрезает форма.
  //
  // Не ширина рабочего стола: строка шире стола заставляла контрол
  // прокручиваться самого - см. EditorFixedWidth.
  RichEdit1.Width := EditorFixedWidth;

  // Родные полосы убираем совсем: они всё равно за краем формы, а так
  // контрол не будет резервировать под них место у своей правой границы.
  //
  // ДО установки маски событий: смена ScrollBars пересоздаёт оконный хэндл,
  // а вместе с ним теряется всё, что выставлено сообщениями напрямую.
  RichEdit1.ScrollBars := ssNone;

  // Маска уведомлений: EN_SELCHANGE нужен, EN_REQUESTRESIZE - нет.
  // См. EnsureEventMask.
  EnsureEventMask;

  // Обновляем и перерисовываем
  RichEdit1.Invalidate;

  // Сбрасываем флаг модификации стартового текста
  RichEdit1.Modified := False;
  StartupStage('Схема подсветки');
  LoadCustomClrSchema('.pas');

  LayoutScrollBars;
  UpdateScrollBars;

  // Свои полосы прокрутки у списков и деревьев правой панели, затем цвета
  // IDE (Light / Dark) - когда все элементы окна построены (FormCreate).
  //
  // ДО загрузки проекта: тема и шрифты меняют размеры полос окна, и окно
  // перестраивается. С коротким демонстрационным текстом в редакторе это
  // дёшево; с текстом проекта (Unit1.pas, 2,2 МБ) одно выравнивание
  // занимало ~250 мс (startup.log, «Тема и шрифты: выравнивание окна»).
  UiWrapListScrolls;

  // Фильтр SubList - поле в шапке колонки Name (SubFilterPlace). Поверх
  // списка, поэтому после его обёртки полосами прокрутки.
  if (lvSubList <> nil) and (FSubFilter = nil) then
  begin
    FSubFilter := TUiEdit.Create(Self);
    FSubFilter.Parent := lvSubList.Parent;
    FSubFilter.AutoSize := False;
    FSubFilter.Font.Name := 'Tahoma';
    FSubFilter.Font.Height := -12;
    FSubFilter.ShowHint := True;
    FSubFilter.Hint := 'Фильтр: часть имени. Esc - очистить, Enter - перейти';
    FSubFilter.OnChange := SubFilterChange;
    FSubFilter.OnKeyDown := SubFilterKeyDown;
  end;
  // Тема и шрифты меняют размеры полос окна: строка меню вместо системного
  // меню, её высота, высота вкладок. Каждая такая смена перестраивала
  // окно, и редактор с большим текстом менял размер несколько раз (по
  // startup.log - сотни мс на Unit1.pas). Выравнивание окна - один раз,
  // после шрифтов.
  DisableAlign;
  try
    StartupStage('Тема IDE: заморозка окон');
    UiApply;

    // SubList: Name растягивается по ширине, Begin и End - у правого края.
    // OnResize у TControl защищённый, отсюда TUiCtl
    if lvSubList <> nil then
    begin
      TUiCtl(lvSubList).OnResize := SubListResize;
      SubListFitColumns;
      SubFilterPlace;
    end;

    // Шрифты групп IDE: умолчания - как сейчас у элементов, выбранные - из
    // editor.ini (IDE Options - IDE colors and Fonts)
    StartupStage('Шрифты IDE');
    UiFontsInit;
    StartupStage('Тема и шрифты: выравнивание окна');
  finally
    EnableAlign;
  end;
  // Колонки SubList и поле фильтра - по размерам после выравнивания
  if lvSubList <> nil then
  begin
    SubListFitColumns;
    SubFilterPlace;
  end;

  // Последний проект поднимаем В САМОМ КОНЦЕ: LoadProject вызывает
  // CloseAllWindows, и демонстрационный текст вместе со схемой .pas будет
  // заменён на файлы проекта. Делать это раньше бессмысленно - всё затёрлось бы.
  if ProjectExists(FStartupProject) then
  begin
    StartupStage('Проект ' + FStartupProject);
    LoadProject(FStartupProject);
  end;

  // Правая панель была свёрнута при выходе
  // Ряды вкладок палитры - когда окно уже показано и страницы добавлены
  if FDsgPalette <> nil then
    FDsgPalette.CheckTabRows;

  if FRightStartCollapsed then
  begin
    FRightStartCollapsed := False;
    RightPanelCollapse(True);
  end;
end;

// Свои полосы (UiScroll, TUiListScroll) поверх полос списков и
// деревьев правой панели: SubList, Includes, Code, Objects, свойства и
// события инспектора
procedure TForm1.UiWrapListScrolls;

  procedure Wrap(ACtl: TWinControl);
  var
    LS: TUiListScroll;
  begin
    if (ACtl = nil) or (ACtl.Parent = nil) then
      Exit;
    LS := UiScrollFind(ACtl);
    if LS = nil then
      LS := TUiListScroll.Attach(ACtl);
    FUiListScrolls.Add(LS);
  end;

begin
  if FUiListScrolls <> nil then
    Exit;                   // уже
  FUiListScrolls := TList.Create;
  Wrap(lvSubList);
  Wrap(FIncTree);
  Wrap(FCodeTree);
  Wrap(FObjTree);
  Wrap(FObjProps);
  Wrap(FObjEvents);
end;

// Число знакомест под номер строки при ALineCount строках - не меньше
// GutterMinDigits
function TForm1.GutterDigitsFor(ALineCount: Integer): Integer;
begin
  Result := Length(IntToStr(ALineCount));
  if Result < GutterMinDigits then
    Result := GutterMinDigits;
end;

// Фон полосы меток (закладки, точки останова), когда цвет
// Gutter.MarksBG не задан (clDefault): чуть светлее фона редактора в
// тёмной теме, чуть темнее - в светлой; полоса видна отдельно от текста
function TForm1.MarksAutoColor: TColor;
var
  BaseRgb: Longint;
  RedPart, GreenPart, BluePart: Integer;
  Dark: Boolean;

  function Shift(APart: Integer): Integer;
  begin
    if Dark then
      Result := APart + (255 - APart) * 12 div 100
    else
      Result := APart - APart * 8 div 100;
  end;

begin
  BaseRgb := ColorToRGB(RichEdit1.Color);
  RedPart := GetRValue(BaseRgb);
  GreenPart := GetGValue(BaseRgb);
  BluePart := GetBValue(BaseRgb);
  Dark := (RedPart * 299 + GreenPart * 587 + BluePart * 114) div 1000 < 128;
  Result := RGB(Shift(RedPart), Shift(GreenPart), Shift(BluePart));
end;

// Ширина панели номеров под номер последней строки (не меньше
// GutterMinDigits цифр); справа от полосы меток - отступ текста
// (FEdIns.TextIndent), цветом фона редактора (Panel1.Color).
//
// Считается по шрифту панели и ЖИРНОМУ начертанию: так пишется номер строки
// с кареткой, а жирные цифры шире. Берётся самая широкая цифра - в
// пропорциональном шрифте они бывают разными.
//
// Отступы те же, что в PaintBox1Paint: текст рисуется в [4 .. Width - 5].
//
// Panel1 стоит с Align = alLeft рядом с контейнером редактора, поэтому при
// её изменении меняется ширина контейнера, а не RichEdit1.
procedure TForm1.UpdateGutterWidth;
var
  Bmp: TBitmap;
  C: Char;
  DigitW, W, NewW: Integer;
  BmH, BmW, DotD, MarksW: Integer;
  LineCount: Integer;
begin
  if (PaintBox1 = nil) or (Panel1 = nil) then
    Exit;

  Bmp := TBitmap.Create;
  try
    Bmp.Canvas.Font.Assign(PaintBox1.Font);
    Bmp.Canvas.Font.Style := [fsBold];
    DigitW := 0;
    for C := '0' to '9' do
    begin
      W := Bmp.Canvas.TextWidth(C);
      if W > DigitW then
        DigitW := W;
    end;
    // Полоса меток справа от номеров - под квадратик закладки и кружок
    MarksLayout(Bmp.Canvas, BmH, BmW, DotD, MarksW);
  finally
    Bmp.Free;
  end;

  LineCount := 1;
  if RichEdit1.HandleAllocated then
    LineCount := SendMessageA(RichEdit1.Handle, EM_GETLINECOUNT, 0, 0);
  FGutterDigits := GutterDigitsFor(LineCount);
  NewW := 4 + DigitW * FGutterDigits + 9;
  // Полоса меток - своей ширины (alLeft за номерами); за ней - отступ
  // текста, там видна сама Panel1 цветом фона редактора
  if MarksBox <> nil then
    MarksBox.Width := MarksW;
  // Editor Options - Gutter width: вся полоса, номера - что останется
  // после меток
  if FEdIns.GutterWidth > 0 then
  begin
    NewW := FEdIns.GutterWidth - MarksW;
    if NewW < 8 then
      NewW := 8;
  end;
  // Номера выключены - в полосе одни метки
  if not FEdIns.ShowLineNumbers then
  begin
    if Panel1.Width <> MarksW + FEdIns.TextIndent then
      Panel1.Width := MarksW + FEdIns.TextIndent;
    Exit;
  end;
  if (PaintBox1.Width <> NewW) or
     (Panel1.Width <> NewW + MarksW + FEdIns.TextIndent) then
  begin
    PaintBox1.Width := NewW;
    Panel1.Width := NewW + MarksW + FEdIns.TextIndent;
  end;
end;

procedure TForm1.PaintBox1Paint(Sender: TObject);
var
  I: Integer;
  CurrentY: Integer;
  LineNumStr: string;
  R: TRect;
  FirstCharPos: TPoint;
  LineStartCharIdx: Integer;
  CaretLine: Integer;
  DbgKind: Integer;     // точка останова, строка остановки - DbgLineKind
begin
  // 1. Заливаем фон панели номеров строк
  PaintBox1.Canvas.Brush.Color := FGutterBG;
  PaintBox1.Canvas.FillRect(PaintBox1.ClientRect);

  // Настраиваем шрифт холста панели
  PaintBox1.Canvas.Font.Assign(PaintBox1.Font);
  PaintBox1.Canvas.Font.Color := FGutterFG;
  PaintBox1.Canvas.Brush.Style := bsClear;

  // 2. Рисуем вертикальную разделительную линию справа
  PaintBox1.Canvas.Pen.Color := $00929291;
  PaintBox1.Canvas.MoveTo(PaintBox1.Width - 1, 0);
  PaintBox1.Canvas.LineTo(PaintBox1.Width - 1, PaintBox1.Height);

  // Перед проходом убедимся, что видимые границы актуальны
  UpdateVisibleBounds;

  // КРИТИЧЕСКИЙ ШАГ ДЛЯ ПЛАВНОСТИ:
  // Узнаем точную попиксельную координату Y для самого первого видимого символа в RichEdit.
  // Windows возвращает её с учетом полускролла (например, -4 пикселя, если строка уезжает вверх).
  LineStartCharIdx := SendMessageA(RichEdit1.Handle, EM_LINEINDEX, FirstVisibleLine, 0);
  if LineStartCharIdx <> -1 then
  begin
    SendMessageA(RichEdit1.Handle, EM_POSFROMCHAR, Integer(@FirstCharPos), LineStartCharIdx);
    YOffset := FirstCharPos.Y; // Записываем точный пиксельный сдвиг
  end
  else
    YOffset := 0;

  // Номер строки, в которой стоит каретка - её подсветим отдельно
  CaretLine := CurrentLineIndex;

  // 3. ЦИКЛ ОТРИСОВКИ НОМЕРОВ СТРОК
  for I := FirstVisibleLine to LastVisibleLine do
  begin
    // Магия жесткой синхронности: высчитываем Y на основе динамического YOffset
    CurrentY := ((I - FirstVisibleLine) * LineHeight) + YOffset;
    //{
    // Если строка полностью ушла выше видимой области PaintBox, пропускаем её
    if CurrentY + LineHeight < 0 then
      Continue;

    // Если ушли ниже экрана, прекращаем рисовать оставшиеся
    if CurrentY > PaintBox1.Height then
      Break;
    //}
    LineNumStr := IntToStr(I + 1);

    // Конструируем прямоугольник ячейки для текста
    R.Left := 0;
    R.Top := CurrentY;
    R.Right := PaintBox1.Width - 1;
    R.Bottom := CurrentY + LineHeight;

    // Строка с кареткой: заливаем ячейку и пишем номер жирным
    if I = CaretLine then
    begin
      PaintBox1.Canvas.Brush.Style := bsSolid;
      // Цвет - из цветов IDE (IDE Light / IDE Dark)
      PaintBox1.Canvas.Brush.Color := UiColor('Gutter.CurBG');
      PaintBox1.Canvas.FillRect(R);
      PaintBox1.Canvas.Brush.Style := bsClear;
      PaintBox1.Canvas.Font.Style := [fsBold];
      // Текст - из цветов IDE; clDefault - цветом цифр полосы
      if UiColor('Gutter.CurText') = clDefault then
        PaintBox1.Canvas.Font.Color := FGutterFG
      else
        PaintBox1.Canvas.Font.Color := UiColor('Gutter.CurText');
    end
    else
    begin
      PaintBox1.Canvas.Font.Style := [];
      PaintBox1.Canvas.Font.Color := FGutterFG;
    end;

    // Точка останова и строка остановки: ячейка своим цветом
    DbgKind := DbgLineKind(I);
    if DbgKind > 0 then
    begin
      PaintBox1.Canvas.Brush.Style := bsSolid;
      case DbgKind of
        1: PaintBox1.Canvas.Brush.Color := UiColor('Debug.BreakBG');
        2: PaintBox1.Canvas.Brush.Color := UiColor('Debug.NoCodeBG');
      else
        PaintBox1.Canvas.Brush.Color := UiColor('Debug.ExecBG');
      end;
      PaintBox1.Canvas.FillRect(R);
      PaintBox1.Canvas.Brush.Style := bsClear;
      PaintBox1.Canvas.Font.Style := [fsBold];
      if DbgKind = 3 then
        PaintBox1.Canvas.Font.Color := UiColor('Debug.ExecText')
      else
        PaintBox1.Canvas.Font.Color := UiColor('Debug.BreakText');
    end;

    R.Left := 4;
    R.Right := PaintBox1.Width - 5;

    // Выравниваем номера строк строго по ПРАВОМУ краю
    DrawTextA(PaintBox1.Canvas.Handle, PChar(LineNumStr), Length(LineNumStr), R, DT_RIGHT or DT_SINGLELINE or DT_VCENTER);
  end;

  // Полоса меток рядом - по тем же строкам: прокрутка и правка, после
  // которых перерисована полоса номеров, двигают и метки.
  //
  // Рисуется сразу, а НЕ через MarksBox.Invalidate. Panel1 буферизована
  // (DoubleBuffered, см. FormCreate): VCL рисует её целиком в память, со
  // всеми PaintBox, - и PaintBox1Paint вызывается при каждой перерисовке
  // панели. Invalidate отсюда снова помечал панель к перерисовке, та снова
  // вызывала PaintBox1Paint - перерисовка шла по кругу без остановки.
  if MarksBox <> nil then
    MarksBoxPaint(MarksBox);
end;



// Путь к файлу умолчаний цветовых схем: schemes\•default•.clr.
// Его разделы - основа для любой схемы: LoadCustomClrSchema читает сначала
// его, потом схему расширения поверх. Ключевые слова из него не берутся -
// они свои у каждого языка.
function TForm1.DefaultSchemaFile: string;
begin
  Result := ExtractFilePath(Application.ExeName) + 'schemes\' +
            #149 + 'default' + #149 + '.clr';
end;

// Отдельная схема подсветки для файла AFile - та же, что выбрал бы
// редактор (•default•.clr, схема расширения, выбранная тема), но своим
// объектом: схема редактора остаётся как есть. Для окон с просмотром
// текста (недостающие файлы). Освобождает вызвавший; nil - не прочиталась.
function TForm1.SchemeCopyFor(const AFile: string): TClrScheme;
var
  ClrPath: string;
begin
  Result := TClrScheme.Create;
  try
    Result.FTheme := FScheme.FTheme;
    Result.ResetSchemaState(FIniFontColor, FIniBGColor);
    if FileExists(DefaultSchemaFile) then
    begin
      Result.ParseClrFile(DefaultSchemaFile);
      Result.ClearKeywordGroups; // ключевые слова - свои у каждого языка
    end;
    ClrPath := ExtractFilePath(Application.ExeName) + 'schemes\' +
               SchemeKeyFor(AFile, ExtractFileExt(AFile)) + '.clr';
    if FileExists(ClrPath) then
      Result.ParseClrFile(ClrPath);
    Result.ApplyTheme;
  except
    FreeAndNil(Result);
  end;
end;












// ---------------------------------------------------------------------------
//  Схема по расширению, с соответствиями
//
//  Схема ищется как schemes\<расширение>.clr. Если своей нет, расширение
//  может пользоваться чужой: .pp и .lpr - схемой Паскаля, .lfm - схемой
//  форм Delphi. Своя схема всегда важнее соответствия - положите pp.clr, и
//  .pp будет подсвечиваться им.
//
//  Соответствия - встроенные плюс schemes\alias.ini, раздел [Alias],
//  строки вида pp=pas. Файл важнее встроенных: так их можно переназначить,
//  не пересобирая программу.
//
//  .inc - include и у Паскаля, и у RapidQ. В проекте типа RapidQ Basic он
//  идёт по bas.clr, в остальных случаях - по pas.clr (встроенное inc=pas).
//  Проект без записанного типа - RapidQ (ProjectTypeOf), как и при сборке.
//  Своя inc.clr и строка inc= в alias.ini важнее типа проекта.
//
//  Копии схем не годятся: правка в окне настроек попала бы только в одну.
// ---------------------------------------------------------------------------

const
  // Встроенные соответствия. Паскаль: Delphi, Free Pascal, Lazarus
  SchemeBuiltin: array[0..11] of string = (
  'dpr=pas', 'dpk=pas', 'pp=pas', 'p=pas', 'lpr=pas', 'inc=pas',
  'lfm=dfm',                         // форма Lazarus - текст того же вида
  'lpi=xml', 'lps=xml', 'lpk=xml',   // проект, сеанс и пакет Lazarus - XML
  'fpd=xml',
  'toml=ini');                       // Cargo.toml - те же [разделы]

function TForm1.SchemeExtFor(const AExt: string): string;
var
  E, Dir, V: string;
  I: Integer;
  Ini: TIniFile;
begin
  E := LowerCase(AExt);
  if (E <> '') and (E[1] = '.') then
    Delete(E, 1, 1);
  Result := E;
  if E = '' then
    Exit;

  Dir := ExtractFilePath(Application.ExeName) + 'schemes\';
  // Своя схема - важнее любых соответствий
  if FileExists(Dir + E + '.clr') then
    Exit;

  V := '';
  if FileExists(Dir + 'alias.ini') then
  begin
    Ini := TIniFile.Create(Dir + 'alias.ini');
    try
      V := LowerCase(Trim(Ini.ReadString('Alias', E, '')));
    finally
      Ini.Free;
    end;
  end;

  // .inc в проекте RapidQ Basic - схема Basic
  if (V = '') and (E = 'inc') and (FCurrentProject <> '') and
     FileExists(Dir + 'bas.clr') and
     (CompareText(ProjectTypeOf(FCurrentProject), 'RapidQ Basic') = 0) then
    V := 'bas';

  if V = '' then
    for I := Low(SchemeBuiltin) to High(SchemeBuiltin) do
      if Copy(SchemeBuiltin[I], 1, Length(E) + 1) = E + '=' then
      begin
        V := Copy(SchemeBuiltin[I], Length(E) + 2, MaxInt);
        Break;
      end;

  if (V <> '') and FileExists(Dir + V + '.clr') then
    Result := V;
end;

procedure TForm1.SchemeAliasRows(ARows: TStrings);
var
  Dir, ExtName, Where: string;
  Rows, IniKeys: TStringList;
  ItemIdx, SepPos: Integer;
  Ini: TIniFile;
begin
  ARows.Clear;
  Dir := ExtractFilePath(Application.ExeName) + 'schemes\';
  Rows := TStringList.Create;
  IniKeys := TStringList.Create;
  try
    Rows.Sorted := True;
    Rows.Duplicates := dupIgnore;
    if FileExists(Dir + 'alias.ini') then
    begin
      Ini := TIniFile.Create(Dir + 'alias.ini');
      try
        Ini.ReadSection('Alias', IniKeys);
        for ItemIdx := 0 to IniKeys.Count - 1 do
        begin
          ExtName := LowerCase(Trim(IniKeys[ItemIdx]));
          if ExtName <> '' then
            Rows.Add(ExtName + '=' +
                     LowerCase(Trim(Ini.ReadString('Alias', IniKeys[ItemIdx],
                                                   ''))) + #9 + 'alias.ini');
        end;
      finally
        Ini.Free;
      end;
    end;
    for ItemIdx := Low(SchemeBuiltin) to High(SchemeBuiltin) do
    begin
      SepPos := Pos('=', SchemeBuiltin[ItemIdx]);
      ExtName := Copy(SchemeBuiltin[ItemIdx], 1, SepPos - 1);
      if Rows.IndexOfName(ExtName) >= 0 then
        Continue;   // переназначено в alias.ini
      Where := 'встроенное';
      if ExtName = 'inc' then
        Where := Where + '; в проекте RapidQ Basic - bas';
      Rows.Add(SchemeBuiltin[ItemIdx] + #9 + Where);
    end;
    // Расширения со своей схемой ext.clr - тоже в списке
    SchemeNames(IniKeys);
    for ItemIdx := 0 to IniKeys.Count - 1 do
      if Rows.IndexOfName(IniKeys[ItemIdx]) < 0 then
        Rows.Add(IniKeys[ItemIdx] + '=' + IniKeys[ItemIdx] + #9 +
                 'своя схема ' + IniKeys[ItemIdx] + '.clr');
    // Своя схема ext.clr важнее любого соответствия. Строки меняются на
    // месте - у сортированного списка это запрещено, порядок уже есть
    Rows.Sorted := False;
    for ItemIdx := 0 to Rows.Count - 1 do
    begin
      ExtName := Rows.Names[ItemIdx];
      if FileExists(Dir + ExtName + '.clr') and
         (Pos(#9'своя схема', Rows[ItemIdx]) = 0) then
        Rows[ItemIdx] := Rows[ItemIdx] + ' (не действует: есть своя ' +
                         ExtName + '.clr)';
    end;
    ARows.Assign(Rows);
  finally
    IniKeys.Free;
    Rows.Free;
  end;
end;

function TForm1.SchemeAliasSet(const AExt, AScheme: string): Boolean;
var
  Dir, ExtName: string;
  Ini: TIniFile;
begin
  Result := False;
  ExtName := LowerCase(Trim(AExt));
  if (ExtName <> '') and (ExtName[1] = '.') then
    Delete(ExtName, 1, 1);
  if ExtName = '' then
    Exit;
  Dir := ExtractFilePath(Application.ExeName) + 'schemes\';
  try
    ForceDirectories(Dir);
    Ini := TIniFile.Create(Dir + 'alias.ini');
    try
      if Trim(AScheme) = '' then
        Ini.DeleteKey('Alias', ExtName)
      else
        Ini.WriteString('Alias', ExtName, LowerCase(Trim(AScheme)));
      Ini.UpdateFile;
    finally
      Ini.Free;
    end;
    Result := True;
  except
    on E: Exception do
      LogComp('File Types: alias.ini не записан - ' + E.Message);
  end;
  // Схема активной вкладки - по новому соответствию; другие вкладки
  // возьмут свою при переходе на них (ActivateWindow)
  ReloadActiveClrSchema;
end;

procedure TForm1.SchemeNames(AList: TStrings);
var
  Dir, SchemeName: string;
  SR: TSearchRec;
  Names: TStringList;
begin
  Dir := ExtractFilePath(Application.ExeName) + 'schemes\';
  Names := TStringList.Create;
  try
    Names.Sorted := True;
    Names.Duplicates := dupIgnore;
    if FindFirst(Dir + '*.clr', faAnyFile, SR) = 0 then
    try
      repeat
        SchemeName := LowerCase(ChangeFileExt(SR.Name, ''));
        if (SR.Attr and faDirectory = 0) and
           (CompareText(Dir + SR.Name, DefaultSchemaFile) <> 0) then
          Names.Add(SchemeName);
      until FindNext(SR) <> 0;
    finally
      FindClose(SR);
    end;
    AList.Assign(Names);
  finally
    Names.Free;
  end;
end;

// Файл активного окна ('' - нет окна)
function TForm1.ActiveWindowFile: string;
begin
  Result := FCurrentFileName;
  if (FWindowsIndex >= 0) and (FWindowsIndex < WindowsItemCount) and
     FWindows[FWindowsIndex].Used then
    Result := FWindows[FWindowsIndex].FileName;
end;

// Схема, выбранная для файла в меню Подсветка ('' - не выбрана)
function TForm1.FileSchemeOf(const AFile: string): string;
var
  Ini: TIniFile;
  Keys: TStringList;
  KeyIdx: Integer;
begin
  Result := '';
  if (AFile = '') or IsUntitledName(AFile) then
    Exit;
  if FFileSchemes = nil then
  begin
    FFileSchemes := TStringList.Create;
    if FileExists(SettingsFileName) then
    begin
      Keys := TStringList.Create;
      Ini := TIniFile.Create(SettingsFileName);
      try
        Ini.ReadSection('FileSchemes', Keys);
        for KeyIdx := 0 to Keys.Count - 1 do
          FFileSchemes.Values[LowerCase(Keys[KeyIdx])] :=
            LowerCase(Trim(Ini.ReadString('FileSchemes', Keys[KeyIdx], '')));
      finally
        Ini.Free;
        Keys.Free;
      end;
    end;
  end;
  Result := FFileSchemes.Values[LowerCase(ExpandFileName(AFile))];
end;

// Запомнить схему для файла (editor.ini [FileSchemes]); '' - убрать,
// файл снова подсвечивается по расширению
procedure TForm1.FileSchemeSet(const AFile, AScheme: string);
var
  Ini: TIniFile;
  FileKey: string;
begin
  if (AFile = '') or IsUntitledName(AFile) then
    Exit;
  FileSchemeOf(AFile);   // список прочитан
  FileKey := LowerCase(ExpandFileName(AFile));
  if AScheme = '' then
  begin
    if FFileSchemes.IndexOfName(FileKey) >= 0 then
      FFileSchemes.Delete(FFileSchemes.IndexOfName(FileKey));
  end
  else
    FFileSchemes.Values[FileKey] := LowerCase(AScheme);
  try
    Ini := TIniFile.Create(SettingsFileName);
    try
      if AScheme = '' then
        Ini.DeleteKey('FileSchemes', FileKey)
      else
        Ini.WriteString('FileSchemes', FileKey, LowerCase(AScheme));
      Ini.UpdateFile;
    finally
      Ini.Free;
    end;
  except
    on E: Exception do
      LogComp('Подсветка: editor.ini не записан - ' + E.Message);
  end;
end;

// .inc бывает и у Паскаля, и у RapidQ: по тексту первых 64 КБ.
// 'bas' / 'pas', '' - не понять. Запоминается до изменения файла.
function TForm1.IncGuessScheme(const AFile: string): string;
const
  ReadMax = 65536;
var
  Stream: TFileStream;
  Buf: string;
  Lines: TStringList;
  LineIdx, BasScore, PasScore, Age: Integer;
  LineText, FileKey, Cached: string;

  function Starts(const APrefix: string): Boolean;
  begin
    Result := Copy(LineText, 1, Length(APrefix)) = APrefix;
  end;

begin
  Result := '';
  if (AFile = '') or not FileExists(AFile) then
    Exit;
  FileKey := LowerCase(ExpandFileName(AFile));
  Age := FileAge(AFile);
  if FIncGuess = nil then
    FIncGuess := TStringList.Create;
  Cached := FIncGuess.Values[FileKey];
  if (Cached <> '') and (Copy(Cached, 1, Pos('|', Cached) - 1) = IntToStr(Age)) then
  begin
    Result := Copy(Cached, Pos('|', Cached) + 1, MaxInt);
    Exit;
  end;

  BasScore := 0;
  PasScore := 0;
  Lines := TStringList.Create;
  try
    try
      Stream := TFileStream.Create(AFile, fmOpenRead or fmShareDenyNone);
      try
        if Stream.Size > ReadMax then
          SetLength(Buf, ReadMax)
        else
          SetLength(Buf, Stream.Size);
        if Length(Buf) > 0 then
          Stream.ReadBuffer(Buf[1], Length(Buf));
      finally
        Stream.Free;
      end;
    except
      Exit;
    end;
    Lines.Text := Buf;
    for LineIdx := 0 to Lines.Count - 1 do
    begin
      LineText := LowerCase(Trim(Lines[LineIdx]));
      if LineText = '' then
        Continue;
      // Basic: комментарий ', REM, концы блоков, DECLARE, директивы $
      if Starts('''') or Starts('rem ') or Starts('end sub') or
         Starts('end function') or Starts('end type') or Starts('end with') or
         Starts('end select') or Starts('end create') or
         Starts('declare sub') or Starts('declare function') or
         Starts('$include') or Starts('$define') or Starts('$ifdef') or
         Starts('$ifndef') or Starts('$typecheck') or Starts('$apptype') or
         Starts('$resource') or Starts('dim ') or Starts('subi ') or
         Starts('functioni ') or Starts('wend') or Starts('next') then
        Inc(BasScore)
      // Паскаль: {$...}, begin / end;, :=, procedure, разделы модуля
      else if Starts('{$') or (LineText = 'begin') or Starts('end;') or
              Starts('end.') or Starts('procedure ') or Starts('unit ') or
              (LineText = 'interface') or (LineText = 'implementation') or
              Starts('//') or Starts('(*') or Starts('uses ') or
              (Pos(':=', LineText) > 0) then
        Inc(PasScore);
    end;
  finally
    Lines.Free;
  end;
  if BasScore > PasScore then
    Result := 'bas'
  else if PasScore > BasScore then
    Result := 'pas';
  FIncGuess.Values[FileKey] := IntToStr(Age) + '|' + Result;
end;

function TForm1.SchemeKeyFor(const AFile, AExt: string): string;
var
  Dir, ExtName, Chosen, Guess: string;
  Ini: TIniFile;
  HasAlias: Boolean;
begin
  Dir := ExtractFilePath(Application.ExeName) + 'schemes\';
  // Выбрано для этого файла
  Chosen := FileSchemeOf(AFile);
  if (Chosen <> '') and FileExists(Dir + Chosen + '.clr') then
  begin
    Result := Chosen;
    Exit;
  end;
  // .inc без своей inc.clr и без inc= в alias.ini - по тексту
  ExtName := LowerCase(AExt);
  if (ExtName <> '') and (ExtName[1] = '.') then
    Delete(ExtName, 1, 1);
  if (ExtName = 'inc') and not FileExists(Dir + 'inc.clr') then
  begin
    HasAlias := False;
    if FileExists(Dir + 'alias.ini') then
    begin
      Ini := TIniFile.Create(Dir + 'alias.ini');
      try
        HasAlias := Trim(Ini.ReadString('Alias', 'inc', '')) <> '';
      finally
        Ini.Free;
      end;
    end;
    if not HasAlias then
    begin
      Guess := IncGuessScheme(AFile);
      if (Guess <> '') and FileExists(Dir + Guess + '.clr') then
      begin
        Result := Guess;
        Exit;
      end;
    end;
  end;
  Result := SchemeExtFor(AExt);
end;

// Подменю Подсветка: Авто и схемы schemes\*.clr; галочка - у той, что
// сейчас у активного окна. Строится при каждом открытии.
procedure TForm1.HighlightMenuFill(Sender: TObject);
var
  Parent, Item: TMenuItem;
  WinFile, Chosen, Current, AutoKey: string;
  NameIdx: Integer;
begin
  if not (Sender is TMenuItem) then
    Exit;
  Parent := TMenuItem(Sender);
  Parent.Clear;
  if FHlNames = nil then
    FHlNames := TStringList.Create;
  SchemeNames(FHlNames);
  WinFile := ActiveWindowFile;
  Chosen := FileSchemeOf(WinFile);
  Current := SchemeKeyFor(WinFile, WindowExt(WinFile));
  // Что было бы без выбора - подписью у Авто
  if Chosen <> '' then
  begin
    FFileSchemes.Values[LowerCase(ExpandFileName(WinFile))] := '';
    AutoKey := SchemeKeyFor(WinFile, WindowExt(WinFile));
    FFileSchemes.Values[LowerCase(ExpandFileName(WinFile))] := Chosen;
  end
  else
    AutoKey := Current;

  Item := TMenuItem.Create(Parent);
  Item.Caption := 'Авто (по расширению): ' + AutoKey;
  Item.Tag := -1;
  Item.RadioItem := True;
  Item.Checked := Chosen = '';
  Item.Enabled := (WinFile <> '') and not IsUntitledName(WinFile);
  Item.OnClick := HighlightItemClick;
  Parent.Add(Item);
  Parent.Add(NewLine);
  for NameIdx := 0 to FHlNames.Count - 1 do
  begin
    Item := TMenuItem.Create(Parent);
    Item.Caption := FHlNames[NameIdx];
    Item.Tag := NameIdx;
    Item.RadioItem := True;
    Item.Checked := (Chosen <> '') and (FHlNames[NameIdx] = Current);
    Item.Enabled := (WinFile <> '') and not IsUntitledName(WinFile);
    Item.OnClick := HighlightItemClick;
    Parent.Add(Item);
  end;
end;

procedure TForm1.HighlightItemClick(Sender: TObject);
var
  WinFile, SchemeName: string;
begin
  if not (Sender is TMenuItem) then
    Exit;
  WinFile := ActiveWindowFile;
  if (WinFile = '') or IsUntitledName(WinFile) then
    Exit;
  SchemeName := '';
  if (TMenuItem(Sender).Tag >= 0) and (FHlNames <> nil) and
     (TMenuItem(Sender).Tag < FHlNames.Count) then
    SchemeName := FHlNames[TMenuItem(Sender).Tag];
  FileSchemeSet(WinFile, SchemeName);
  ReloadActiveClrSchema;
  if SchemeName = '' then
    LogComp('Подсветка ' + ExtractFileName(WinFile) + ': по расширению (' +
            SchemeKeyFor(WinFile, WindowExt(WinFile)) + ')')
  else
    LogComp('Подсветка ' + ExtractFileName(WinFile) + ': ' + SchemeName);
end;

// ---------------------------------------------------------------------------
//  Шрифты IDE по группам (IDE Options - IDE colors and Fonts). Умолчание
//  группы - шрифт её элемента при запуске (из .dfm, у меню - системный
//  шрифт меню). Выбранные - editor.ini [IdeFonts], Ключ=Имя|высота|стиль.
//  Шрифт редактора - не здесь, а в схеме подсветки (Color Scheme).
// ---------------------------------------------------------------------------

const
  // Размер шрифта групп - в этих пределах (пункты): мельче не прочесть,
  // крупнее - не помещаются строка меню, вкладки и панели
  UiFontMinSize = 8;
  UiFontMaxSize = 14;
  UiFontKeyList: array[0..5] of string = (
    'Font.Windows', 'Font.Menu', 'Font.Tabs', 'Font.Lists', 'Font.Logs',
    'Font.Status');

function UiFontSpec(AFont: TFont): string;
var
  StyleText: string;
begin
  StyleText := '';
  if fsBold in AFont.Style then
    StyleText := StyleText + 'B';
  if fsItalic in AFont.Style then
    StyleText := StyleText + 'I';
  if fsUnderline in AFont.Style then
    StyleText := StyleText + 'U';
  if fsStrikeOut in AFont.Style then
    StyleText := StyleText + 'S';
  Result := AFont.Name + '|' + IntToStr(AFont.Height) + '|' + StyleText;
end;

// Имя, высота и стиль из строки - в AFont (цвет и кодировка не трогаются)
procedure UiFontFromSpec(const ASpec: string; AFont: TFont);
var
  Parts: TStringList;
  FontHeight: Integer;
  NewStyle: TFontStyles;
begin
  Parts := TStringList.Create;
  try
    Parts.Delimiter := '|';
    Parts.QuoteChar := #0;
    Parts.DelimitedText := StringReplace(ASpec, ' ', #1, [rfReplaceAll]);
    if Parts.Count < 2 then
      Exit;
    if Trim(Parts[0]) <> '' then
      AFont.Name := StringReplace(Parts[0], #1, ' ', [rfReplaceAll]);
    FontHeight := StrToIntDef(Parts[1], 0);
    if FontHeight <> 0 then
      AFont.Height := FontHeight;
    NewStyle := [];
    if Parts.Count > 2 then
    begin
      if Pos('B', Parts[2]) > 0 then
        Include(NewStyle, fsBold);
      if Pos('I', Parts[2]) > 0 then
        Include(NewStyle, fsItalic);
      if Pos('U', Parts[2]) > 0 then
        Include(NewStyle, fsUnderline);
      if Pos('S', Parts[2]) > 0 then
        Include(NewStyle, fsStrikeOut);
    end;
    AFont.Style := NewStyle;
  finally
    Parts.Free;
  end;
end;

// Высота строки текста шрифтом AFont
function UiFontLineHeight(AFont: TFont): Integer;
var
  MeasureBmp: TBitmap;
begin
  MeasureBmp := TBitmap.Create;
  try
    MeasureBmp.Canvas.Font.Assign(AFont);
    Result := MeasureBmp.Canvas.TextHeight('Wg');
  finally
    MeasureBmp.Free;
  end;
end;

procedure TForm1.UiFontLimits(var AMinSize, AMaxSize: Integer);
begin
  AMinSize := UiFontMinSize;
  AMaxSize := UiFontMaxSize;
end;

procedure TForm1.UiFontKeys(AList: TStrings);
var
  KeyIdx: Integer;
begin
  AList.Clear;
  for KeyIdx := Low(UiFontKeyList) to High(UiFontKeyList) do
    AList.Add(UiFontKeyList[KeyIdx]);
end;

function TForm1.UiFontCaption(const AKey: string): string;
begin
  if AKey = 'Font.Windows' then
    Result := 'Шрифт: окна и панели (подписи, кнопки, поля, диалоги)'
  else if AKey = 'Font.Menu' then
    Result := 'Шрифт: меню'
  else if AKey = 'Font.Tabs' then
    Result := 'Шрифт: вкладки файлов'
  else if AKey = 'Font.Lists' then
    Result := 'Шрифт: правая панель (списки, деревья, инспектор)'
  else if AKey = 'Font.Logs' then
    Result := 'Шрифт: логи'
  else if AKey = 'Font.Status' then
    Result := 'Шрифт: строка состояния'
  else
    Result := AKey;
end;

procedure TForm1.UiFontGet(const AKey: string; AFont: TFont);
begin
  if (FUiFontDefs <> nil) and (FUiFontDefs.Values[AKey] <> '') then
    UiFontFromSpec(FUiFontDefs.Values[AKey], AFont);
  if (FUiFonts <> nil) and (FUiFonts.Values[AKey] <> '') then
  begin
    UiFontFromSpec(FUiFonts.Values[AKey], AFont);
    // Выбранный шрифт (и вписанный в editor.ini руками) - в пределах
    if AFont.Size < UiFontMinSize then
      AFont.Size := UiFontMinSize
    else if AFont.Size > UiFontMaxSize then
      AFont.Size := UiFontMaxSize;
  end;
end;

// Подпись шрифта для таблицы: Tahoma, 10, жирный курсив
function TForm1.UiFontText(const AKey: string): string;
var
  TmpFont: TFont;
begin
  TmpFont := TFont.Create;
  try
    UiFontGet(AKey, TmpFont);
    Result := TmpFont.Name + ', ' + IntToStr(TmpFont.Size);
    if fsBold in TmpFont.Style then
      Result := Result + ', жирный';
    if fsItalic in TmpFont.Style then
      Result := Result + ', курсив';
    if fsUnderline in TmpFont.Style then
      Result := Result + ', подчёркнутый';
    if fsStrikeOut in TmpFont.Style then
      Result := Result + ', зачёркнутый';
    if (FUiFonts = nil) or (FUiFonts.Values[AKey] = '') then
      Result := Result + '  (умолчание)';
  finally
    TmpFont.Free;
  end;
end;

procedure TForm1.UiFontSet(const AKey: string; AFont: TFont);
var
  Ini: TIniFile;
begin
  if AFont.Size < UiFontMinSize then
    AFont.Size := UiFontMinSize
  else if AFont.Size > UiFontMaxSize then
    AFont.Size := UiFontMaxSize;
  if FUiFonts = nil then
    FUiFonts := TStringList.Create;
  FUiFonts.Values[AKey] := UiFontSpec(AFont);
  try
    Ini := TIniFile.Create(SettingsFileName);
    try
      Ini.WriteString('IdeFonts', AKey, FUiFonts.Values[AKey]);
      Ini.UpdateFile;
    finally
      Ini.Free;
    end;
  except
    on E: Exception do
      LogComp('Шрифты IDE: editor.ini не записан - ' + E.Message);
  end;
  UiFontsApply;
end;

procedure TForm1.UiFontsReset;
var
  Ini: TIniFile;
begin
  if FUiFonts <> nil then
    FUiFonts.Clear;
  try
    Ini := TIniFile.Create(SettingsFileName);
    try
      Ini.EraseSection('IdeFonts');
      Ini.UpdateFile;
    finally
      Ini.Free;
    end;
  except
    on E: Exception do
      LogComp('Шрифты IDE: editor.ini не записан - ' + E.Message);
  end;
  UiFontsApply;
end;

// При запуске: умолчания - шрифты элементов из .dfm, выбранные - из
// editor.ini; выбранные сразу применяются
procedure TForm1.UiFontsInit;
var
  Ini: TIniFile;
  KeyIdx: Integer;
  Spec: string;
begin
  if FUiFontDefs <> nil then
    Exit;     // уже (FormShow бывает не один раз)
  FUiFontDefs := TStringList.Create;
  FUiFonts := TStringList.Create;
  FUiFontDefs.Values['Font.Windows'] := UiFontSpec(Font);
  FUiFontDefs.Values['Font.Menu'] := UiFontSpec(Screen.MenuFont);
  if FTabs <> nil then
    FUiFontDefs.Values['Font.Tabs'] := UiFontSpec(FTabs.Font);
  if lvSubList <> nil then
    FUiFontDefs.Values['Font.Lists'] := UiFontSpec(lvSubList.Font);
  if CompLogEdit <> nil then
    FUiFontDefs.Values['Font.Logs'] := UiFontSpec(CompLogEdit.Font);
  if StatusBar1 <> nil then
    FUiFontDefs.Values['Font.Status'] := UiFontSpec(StatusBar1.Font);
  if FileExists(SettingsFileName) then
  begin
    Ini := TIniFile.Create(SettingsFileName);
    try
      for KeyIdx := Low(UiFontKeyList) to High(UiFontKeyList) do
      begin
        Spec := Trim(Ini.ReadString('IdeFonts', UiFontKeyList[KeyIdx], ''));
        if Spec <> '' then
          FUiFonts.Values[UiFontKeyList[KeyIdx]] := Spec;
      end;
    finally
      Ini.Free;
    end;
  end;
  if FUiFonts.Count > 0 then
    UiFontsApply;
end;

procedure TForm1.UiFontsApply;
var
  NewFont: TFont;
  OldLineH, NewLineH, LogIdx: Integer;
  LogEdits: array[0..3] of TRichEdit;
  CharFmt: TCharFormat;

  // Имя, высота и стиль NewFont - в ATarget, цвет у ATarget свой
  procedure Face(ATarget: TFont);
  begin
    ATarget.Name := NewFont.Name;
    ATarget.Height := NewFont.Height;
    ATarget.Style := NewFont.Style;
  end;

  procedure Load(const AKey: string);
  begin
    NewFont.Name := 'Tahoma';
    NewFont.Height := -11;
    NewFont.Style := [];
    UiFontGet(AKey, NewFont);
  end;

var
  FormIdx: Integer;
begin
  if FUiFontDefs = nil then
    Exit;
  // Окна и панели - первыми: у главного окна группы ниже (вкладки, списки,
  // логи, строка состояния) затем ставят свои шрифты поверх
  for FormIdx := 0 to Screen.FormCount - 1 do
    UiFormFontApply(Screen.Forms[FormIdx]);
  NewFont := TFont.Create;
  try
    // Меню: окна пунктов берут Screen.MenuFont при каждом открытии, строка
    // меню - здесь
    Load('Font.Menu');
    Face(Screen.MenuFont);
    if FMenuBar <> nil then
    begin
      FMenuBar.Font := Screen.MenuFont;
      FMenuBar.Height := Screen.MenuFont.Size + 16;
    end;

    // Вкладки файлов: высота полосы - на разницу высоты строки
    Load('Font.Tabs');
    if FTabs <> nil then
    begin
      OldLineH := UiFontLineHeight(FTabs.Font);
      Face(FTabs.Font);
      NewLineH := UiFontLineHeight(FTabs.Font);
      if FTabsBaseHeight > 0 then
        FTabsBaseHeight := FTabsBaseHeight + NewLineH - OldLineH;
      UpdateTabsHeight;
      FTabs.Invalidate;
    end;

    Load('Font.Lists');
    if lvSubList <> nil then
      Face(lvSubList.Font);
    if FObjTree <> nil then
      Face(FObjTree.Font);
    if FIncTree <> nil then
      Face(FIncTree.Font);
    if FCodeTree <> nil then
      Face(FCodeTree.Font);
    if FObjProps <> nil then
      Face(FObjProps.Font);
    if FObjEvents <> nil then
      Face(FObjEvents.Font);
    SubListFitColumns;
    SubFilterPlace;

    // Логи: шрифт по умолчанию и уже написанный текст (цвета строк
    // остаются - меняются только имя и размер)
    Load('Font.Logs');
    LogEdits[0] := CompLogEdit;
    LogEdits[1] := ErrLogEdit;
    LogEdits[2] := LogEdit;
    LogEdits[3] := RuntimeLog;
    for LogIdx := Low(LogEdits) to High(LogEdits) do
    begin
      if LogEdits[LogIdx] = nil then
        Continue;
      Face(LogEdits[LogIdx].Font);
      if LogEdits[LogIdx].HandleAllocated then
      begin
        FillChar(CharFmt, SizeOf(CharFmt), 0);
        CharFmt.cbSize := SizeOf(CharFmt);
        CharFmt.dwMask := CFM_FACE or CFM_SIZE;
        CharFmt.yHeight := NewFont.Size * 20;
        StrPLCopy(CharFmt.szFaceName, NewFont.Name,
                  SizeOf(CharFmt.szFaceName) - 1);
        SendMessage(LogEdits[LogIdx].Handle, EM_SETCHARFORMAT, SCF_ALL,
                    Integer(@CharFmt));
      end;
    end;

    Load('Font.Status');
    if StatusBar1 <> nil then
      Face(StatusBar1.Font);
    if FStatus2 <> nil then
      Face(FStatus2.Font);
    StatusPanelsFit;
  finally
    NewFont.Free;
  end;
end;

// Шрифт "окна и панели" (Font.Windows) - окну AForm. Меняются само окно и
// элементы с его шрифтом: наследующие (ParentFont) - сами, остальные - если
// их шрифт совпадает со шрифтом окна (имя, высота, стиль). Свой шрифт
// элемента (редактор, моноширинные поля, жирные заголовки) не трогается.
// Окно конструктора форм - не IDE, его не трогаем. Зовётся при смене
// шрифта для всех окон и при активации окна (UiActiveFormChange) - так
// шрифт получают и окна, созданные позже.
procedure TForm1.UiFormFontApply(AForm: TCustomForm);
var
  NewFont: TFont;
  OldName: string;
  OldHeight: Integer;
  OldStyle: TFontStyles;

  procedure Walk(ACtl: TControl);
  var
    ChildIdx: Integer;
    CtlFont: TFont;
  begin
    if (ACtl = RichEdit1) or (ACtl = PaintBox1) or (ACtl = MarksBox) then
      Exit;
    if not TUiCtl(ACtl).ParentFont then
    begin
      CtlFont := TUiCtl(ACtl).Font;
      if (CompareText(CtlFont.Name, OldName) = 0) and
         (CtlFont.Height = OldHeight) and (CtlFont.Style = OldStyle) then
      begin
        CtlFont.Name := NewFont.Name;
        CtlFont.Height := NewFont.Height;
        CtlFont.Style := NewFont.Style;
      end;
    end;
    if ACtl is TWinControl then
      for ChildIdx := 0 to TWinControl(ACtl).ControlCount - 1 do
        Walk(TWinControl(ACtl).Controls[ChildIdx]);
  end;

var
  ChildIdx: Integer;
begin
  if (AForm = nil) or (FUiFontDefs = nil) then
    Exit;
  if (FDesigner <> nil) and (AForm = FDesigner.Form) then
    Exit;
  // Шрифт не выбран: у прочих окон остаётся свой из .dfm; главному окну -
  // умолчание (после "Вернуть умолчания")
  if (AForm <> Self) and
     ((FUiFonts = nil) or (FUiFonts.Values['Font.Windows'] = '')) then
    Exit;
  NewFont := TFont.Create;
  try
    NewFont.Assign(TUiCtl(AForm).Font);
    UiFontGet('Font.Windows', NewFont);
    OldName := TUiCtl(AForm).Font.Name;
    OldHeight := TUiCtl(AForm).Font.Height;
    OldStyle := TUiCtl(AForm).Font.Style;
    if (CompareText(NewFont.Name, OldName) = 0) and
       (NewFont.Height = OldHeight) and (NewFont.Style = OldStyle) then
      Exit;
    // Сначала элементы (сравнение - с прежним шрифтом окна), потом окно
    for ChildIdx := 0 to AForm.ControlCount - 1 do
      Walk(AForm.Controls[ChildIdx]);
    TUiCtl(AForm).Font.Name := NewFont.Name;
    TUiCtl(AForm).Font.Height := NewFont.Height;
    TUiCtl(AForm).Font.Style := NewFont.Style;
  finally
    NewFont.Free;
  end;
end;

// Ширины панелей строк состояния - по самой длинной надписи, которая может
// там оказаться, шрифтом самой строки; высота - по шрифту. Замер идёт на
// временном TBitmap, чтобы не трогать канву самого контрола.
procedure TForm1.StatusPanelsFit;
var
  SampleBmp: TBitmap;
  LineH: Integer;
begin
  SampleBmp := TBitmap.Create;
  try
    if (FStatus2 <> nil) and (FStatus2.Panels.Count > 2) then
    begin
      SampleBmp.Canvas.Font.Assign(FStatus2.Font);
      FStatus2.Panels[1].Width :=
        SampleBmp.Canvas.TextWidth('999 999 999 б') + 16;
      FStatus2.Panels[2].Width :=
        SampleBmp.Canvas.TextWidth('99.99.9999 99:99') + 16;
      LineH := SampleBmp.Canvas.TextHeight('Wg') + 8;
      if LineH > FStatus2.Height then
        FStatus2.Height := LineH;
      Status2Resize(nil);
    end;
    if (StatusBar1 <> nil) and (StatusBar1.Panels.Count > 6) then
    begin
      SampleBmp.Canvas.Font.Assign(StatusBar1.Font);
      StatusBar1.Panels[0].Width := SampleBmp.Canvas.TextWidth('Строк: 9999999') + 16;
      StatusBar1.Panels[1].Width := SampleBmp.Canvas.TextWidth('Стр: 9999999') + 16;
      StatusBar1.Panels[2].Width :=
        SampleBmp.Canvas.TextWidth('Поз в строке: 99999/99999') + 16;
      StatusBar1.Panels[3].Width :=
        SampleBmp.Canvas.TextWidth('Поз.: 99999999/99999999') + 16;
      StatusBar1.Panels[4].Width := SampleBmp.Canvas.TextWidth('ASCII: 255 (''W'')') + 16;
      StatusBar1.Panels[5].Width := SampleBmp.Canvas.TextWidth('UTF-8 BOM') + 16;
      StatusBar1.Panels[6].Width :=
        SampleBmp.Canvas.TextWidth('999.9 / 999.9 / 999.9 | карта 9999.9' +
      ' | стр 99.9 фон 99.9 кс 99.9 ток 99.9 вызовов 99999') + 16;
      LineH := SampleBmp.Canvas.TextHeight('Wg') + 8;
      if LineH > StatusBar1.Height then
        StatusBar1.Height := LineH;
    end;
  finally
    SampleBmp.Free;
  end;
end;

// Файл формы для модуля: .dfm (Delphi), иначе .lfm (Lazarus). '' - нет.
function TForm1.FormFileFor(const AUnit: string): string;
begin
  Result := ChangeFileExt(AUnit, '.dfm');
  if FileExists(Result) then
    Exit;
  Result := ChangeFileExt(AUnit, '.lfm');
  if FileExists(Result) then
    Exit;
  Result := '';
end;

// Модуль для файла формы: .pas, иначе .pp (Free Pascal). '' - нет.
function TForm1.UnitFileFor(const AForm: string): string;
begin
  Result := ChangeFileExt(AForm, '.pas');
  if FileExists(Result) then
    Exit;
  Result := ChangeFileExt(AForm, '.pp');
  if FileExists(Result) then
    Exit;
  Result := '';
end;

// Расширения Паскаля: модули, программы, пакеты, вставки
function TForm1.IsPascalExt(const AExt: string): Boolean;
var
  E: string;
begin
  E := LowerCase(AExt);
  Result := (E = '.pas') or (E = '.pp') or (E = '.p') or (E = '.dpr') or
            (E = '.lpr') or (E = '.dpk') or (E = '.inc');
end;

// Расширения файлов формы: Delphi и Lazarus
function TForm1.IsFormExt(const AExt: string): Boolean;
var
  E: string;
begin
  E := LowerCase(AExt);
  Result := (E = '.dfm') or (E = '.lfm');
end;

// Схема для расширения Ext: встроенные умолчания, поверх - •default•.clr
// (без ключевых слов), поверх - schemes\<ext>.clr.
// ---------------------------------------------------------------------------
//  Схема подсветки живёт в FScheme (модуль ClrScheme): сброс, разбор и
//  запись .clr - там. Здесь - то, что после них нужно редактору: цвет
//  шрифта, высота строки и шаг табуляции, карты окон, перерисовка.
// ---------------------------------------------------------------------------

// Цвет текста редактора - в RichEdit1.Font.Color, БЕЗ передачи контролу.
//
// Текст рисуем мы (PaintDoubleBuffered, родная отрисовка выключена -
// NativePaintMode), цвет по умолчанию берём из RichEdit1.Font.Color. Сам
// контрол на смену шрифта (CM_FONTCHANGED) переписывает оформление всего
// текста: на Unit1.pas это около 0,5 с на каждое присваивание, а при
// смене темы их было несколько подряд. Его собственный цвет на экране не
// виден, поэтому уведомление на время присваивания снимается.
procedure TForm1.SetEditorFontColor(AColor: TColor);
var
  SavedOnChange: TNotifyEvent;
begin
  if RichEdit1.Font.Color = AColor then
    Exit;
  SavedOnChange := RichEdit1.Font.OnChange;
  RichEdit1.Font.OnChange := nil;
  try
    RichEdit1.Font.Color := AColor;
  finally
    RichEdit1.Font.OnChange := SavedOnChange;
  end;
end;

// Схема - к встроенным умолчаниям; цвет текста и фон - из editor.ini
procedure TForm1.ResetSchemaState;
begin
  FScheme.ResetSchemaState(FIniFontColor, FIniBGColor);
  SetEditorFontColor(FScheme.FTextFG);
  RichEdit1.Color := FIniBGColor;
end;

// Разбор .clr. Раздел Text задаёт цвет текста: он ставится шрифту
// редактора, и под шрифт пересчитываются высота строки и шаг табуляции -
// как раньше при разборе этого раздела.
procedure TForm1.ParseClrFile(const APath: string);
var
  Metrics: TTextMetric;
begin
  FScheme.ParseClrFile(APath);
  if FScheme.FLoadError <> '' then
    ShowMessage('30547:' + FScheme.FLoadError);
  if FScheme.FSchemaHasText then
  begin
    SetEditorFontColor(FScheme.FTextFG);
    with TControlCanvas.Create do
    try
      Control := RichEdit1;
      SelectObject(Handle, RichEdit1.Font.Handle);
      if GetTextMetrics(Handle, Metrics) then
      begin
        LineHeight := Metrics.tmHeight + Metrics.tmExternalLeading;
        ApplyTabStops; // сам пересчитает шаг под новый шрифт
      end;
    finally
      Free;
    end;
  end;
end;

// Запись схемы в .clr и всё, что после неё нужно редактору
procedure TForm1.SaveClrSchemaTo(const APath: string);
var
  StartTick, TWrite: Cardinal;
begin
  StartTick := GetTickCount;
  // Цвет текста схемы - тот, что сейчас у шрифта редактора: его меняет и
  // окно настроек
  FScheme.FTextFG := RichEdit1.Font.Color;
  FScheme.SaveClrSchemaTo(APath);
  TWrite := GetTickCount - StartTick;

  // Карты других окон здесь НЕ сбрасываются: в каждой записана подпись
  // схемы, по которой она построена (MapSchemeSig - маркеры, даты .clr), и
  // ActivateWindow сверяет её с нынешней. Окна с этой схемой разберутся
  // заново при переходе на них, окна других языков - нет. Раньше
  // сбрасывались все, и каждая большая вкладка потом разбиралась по ~0,8 с.

  // ОБЯЗАТЕЛЬНО пересобираем карту комментариев и строковых литералов.
  // Цвета применяются сразу, а МАРКЕРЫ (FLineCommentMarker, FStringMarker,
  // FBlockCommentStart/End) участвуют только в разборе текста, который
  // делает RebuildCommentRangeMap. Без пересборки карта остаётся
  // построенной по старым маркерам.
  RebuildCommentRangeMap;

  // Заставляем редактор мгновенно перерисоваться в новых цветах
  RichEdit1.Invalidate;
  if PaintBox1 <> nil then
    PaintBox1.Invalidate;
  Dbg(Format('Save схемы %s - %d мс: запись %d, карта активной вкладки %d',
             [ExtractFileName(APath), GetTickCount - StartTick, TWrite,
             GetTickCount - StartTick - TWrite]), clNavy);
end;

procedure TForm1.LoadCustomClrSchema(const Ext: string; const AFile: string);
var
  WasModified: Boolean; // схема тоже меняет шрифт - см. ApplyEditorLook
  ClrPath: string;
  DefSections: TStringList; // разделы •default•.clr, в порядке того файла
  I: Integer;
begin
  // Секция Text взводит Modified точно так же, как ручная смена шрифта, -
  // запоминаем флаг и вернём его в самом конце
  WasModified := RichEdit1.Modified;

  // Маркеры комментариев и шрифт могут стать другими - сведения о длинных
  // строках недействительны
  InvalidateWidthCache;
  Inc(FMapVer);

  // Находим путь к файлу схемы (например, schemes\pas.clr). Своей схемы
  // у расширения нет - по соответствию: .pp -> pas, .lfm -> dfm
  ClrPath := ExtractFilePath(Application.ExeName) + 'schemes\' +
             SchemeKeyFor(AFile, Ext) + '.clr';

  ResetSchemaState;

  DefSections := TStringList.Create;
  try
    if FileExists(DefaultSchemaFile) then
    begin
      ParseClrFile(DefaultSchemaFile);
      DefSections.Assign(FScheme.FFileSections);
      FScheme.ClearKeywordGroups; // ключевые слова - свои у каждого языка
    end;

    ParseClrFile(ClrPath);

    // Порядок строк таблицы задаёт схема расширения; разделы, которых в ней
    // нет, а в •default•.clr есть, встают за ними. Группы ключевых слов из
    // умолчаний не переносим - их только что убрал ClearKeywordGroups.
    FScheme.SchemaSections.Assign(FScheme.FFileSections);
    for I := 0 to DefSections.Count - 1 do
      if not IsKeywordSection(DefSections[I]) and
         (FScheme.SchemaSections.IndexOf(DefSections[I]) < 0) then
        FScheme.SchemaSections.Add(DefSections[I]);
    FScheme.EnsureSchemaSection('PairMark');
  finally
    DefSections.Free;
  end;

  // Цвета выбранной темы - поверх прочитанного
  ApplySchemeTheme;

  // Маркеры прочитаны из файла - пересобираем набор опасных символов
  FScheme.BuildMarkerChars;

  // Перестраиваем глобальную карту многострочных комментариев и обновляем экран
  RebuildCommentRangeMap;
  RichEdit1.Invalidate;

  // Разбор схемы мог переписать шрифт - текст от этого изменённым не стал
  RichEdit1.Modified := WasModified;
end;

// Одна схема из файла, без •default•.clr под ней, - для правки в окне
// настроек (Edit Default). Редактор сразу показывает её цвета.
procedure TForm1.LoadSchemaFileForEdit(const APath: string);
var
  WasModified: Boolean;
begin
  WasModified := RichEdit1.Modified;
  InvalidateWidthCache;
  Inc(FMapVer);
  ResetSchemaState;
  ParseClrFile(APath);
  ApplySchemeTheme;
  // Схема одна, без умолчаний под ней - порядок разделов её собственный
  FScheme.SchemaSections.Assign(FScheme.FFileSections);
  FScheme.EnsureSchemaSection('PairMark');
  FScheme.BuildMarkerChars;
  RefreshMapIfMarkersChanged;
  RichEdit1.Invalidate;
  if PaintBox1 <> nil then
    PaintBox1.Invalidate;
  RichEdit1.Modified := WasModified;
end;


function TForm1.SaveCurrentFile: Boolean;
var
  Ext: string;
begin
  Result := False;

  // Если файл новый (у него еще нет имени на диске). Условное имя
  // проверяется тоже - на случай, если оно всё-таки попало сюда.
  if IsUntitledName(FCurrentFileName) then
  begin
    FCurrentFileName := '';

    // Расширение по умолчанию - то, с которым файл создан (File > New)
    Ext := '';
    if (FWindowsIndex >= 0) and FWindows[FWindowsIndex].Used then
      Ext := WindowExt(FWindows[FWindowsIndex].FileName);
    if Ext = '' then
      Ext := '.txt';

    // Фильтр уже задан в FormCreate, здесь его не перетираем
    SaveDialog1.DefaultExt := Copy(Ext, 2, MaxInt);
    SaveDialog1.InitialDir := SuggestDir;
    SaveDialog1.FileName := '';

    if SaveDialog1.Execute then
      // Скетч Arduino - в папку своего имени; '' - отмена
      FCurrentFileName := SketchSavePath(SaveDialog1.FileName)
    else
      Exit; // Пользователь нажал "Отмена" в диалоге выбора пути
    if FCurrentFileName = '' then
      Exit;
  end;

  // Файл на диске успели изменить снаружи - спросить до записи поверх.
  // Конфликты после слияния или версия с диска, открытая рядом, - не
  // пишем: сначала разобраться.
  // (Save As под другим именем - не тот файл, не проверяем)
  if (FWindowsIndex >= 0) and FWindows[FWindowsIndex].Used and
     (CompareText(FWindows[FWindowsIndex].FileName, FCurrentFileName) = 0) and
     not CheckDiskChanges(FWindowsIndex) then
    Exit;
  if FCurrentFileName = '' then
    Exit;   // окно сменилось на копию с диска

  // Запись файла на диск
  try
    SaveTextFile(FCurrentFileName, GetEditorText);

    // Сбрасываем флаг изменений — теперь текст считается сохраненным
    RichEdit1.Modified := False;

    // Держим запись окна в согласии с тем, что легло на диск
    if (FWindowsIndex >= 0) and FWindows[FWindowsIndex].Used then
    begin
      FWindows[FWindowsIndex].FileName := FCurrentFileName;
      FWindows[FWindowsIndex].Text := GetEditorText;
      FWindows[FWindowsIndex].Modified := False;
      RebuildWindowsMenu;
    end;
    UpdatePathBar;            // после Save As имя файла могло измениться
    UpdateTabCaption(FWindowsIndex);

    // Обновляем заголовок (убираем звездочку изменения)
    Form1.Caption := AppTitle + ' - ' + ExtractFileName(FCurrentFileName);
    StatusBar1.Panels[0].Text := 'Сохранено';
    Result := True;
  except
    on E: Exception do
      ShowMessage('30738:Не удалось сохранить файл: ' + E.Message);
  end;
end;

procedure TForm1.FormCloseQuery(Sender: TObject; var CanClose: Boolean);
begin
  // Идёт Find In Files: сначала остановить его (FifRun закроет окно, когда
  // выйдет из цикла), иначе форма разрушилась бы под циклом поиска
  if FFifRunning then
  begin
    FFifAbort := True;
    FFifCloseAfter := True;
    CanClose := False;
    Exit;
  end;
  // Сначала текст активного окна, потом сам проект, потом цветовая схема:
  // отказ на любом вопросе отменяет выход, и следующие задавать незачем.
  // Autosave Editor files - файлы с именем сохраняются без вопроса.
  AutoSaveEditorFiles;
  CanClose := ConfirmSaveCurrent;
  if CanClose then
    CanClose := ConfirmSaveOthers;   // правки конструктора в других вкладках
  if CanClose then
    CanClose := ConfirmSaveProject;
  if CanClose then
    CanClose := ConfirmSaveSchema;

  // Уходим - запоминаем активную вкладку. После обоих вопросов: если проект
  // сохранили целиком, индекс там уже верный, и повторная запись безвредна.
  if CanClose then
    SaveActiveTabToProject;
  // Разбор текста окон - на диск: при следующем запуске не строить заново
  if CanClose then
    SaveAllMapCaches;
  // Выход отменён - перезапуска после Tidy editor.ini тоже не будет
  if not CanClose then
    FTidyRestart := False;
  // Пробная сборка редактора запустилась и закрывается - она становится
  // рабочей. Здесь, а не в FormDestroy: главная форма разрушается
  // последней, и исключение при разрушении другой формы (Form3 и прочих)
  // обрывало выход раньше - переименования не было.
  if CanClose and OwnIsTrial and FStartupDone and not FPromoted then
    FPromoted := OwnPromoteTrial;
end;

// Отступ новой строки по Enter: пробелы и табуляции в начале строки с
// кареткой (не дальше каретки); строка пустая - как у ближайшей непустой
// выше. Строка до каретки кончается словом, открывающим блок, - ещё один
// уровень (FIndentKind, FIndentSize): Паскаль - begin, try, repeat,
// record, then, do, else, of, except, finally, var, const, type; Basic -
// THEN, ELSE, DO, заголовки SUB, FUNCTION, TYPE, CREATE, WITH, FOR, WHILE,
// SELECT CASE, CASE; C-подобные - "{" в конце.
function TForm1.EnterIndentText: string;
var
  Sel: TCharRange;
  LineNo, LineStart, LineLen, CharIdx, SpaceAt: Integer;
  LineText, Before, LastWord, FirstWord, Ext, Unit_: string;
  OpensBlock: Boolean;
begin
  Result := '';
  if not RichEdit1.HandleAllocated then
    Exit;
  SendMessageA(RichEdit1.Handle, EM_EXGETSEL, 0, Integer(@Sel));
  LineNo := SendMessageA(RichEdit1.Handle, EM_EXLINEFROMCHAR, 0, Sel.cpMin);
  LineStart := SendMessageA(RichEdit1.Handle, EM_LINEINDEX, LineNo, 0);
  if LineStart < 0 then
    Exit;
  LineLen := SendMessageA(RichEdit1.Handle, EM_LINELENGTH, LineStart, 0);
  LineText := TextRange(LineStart, LineLen);
  Before := Copy(LineText, 1, Sel.cpMin - LineStart);

  // До каретки только отступ: он и остаётся. Совсем пусто (каретка в
  // начале строки) и строка пустая - отступ ближайшей непустой строки
  // выше, с её словом, открывающим блок
  if Trim(Before) = '' then
  begin
    if (Before <> '') or (Trim(LineText) <> '') then
    begin
      Result := Before;
      Exit;
    end;
    CharIdx := LineNo - 1;
    while CharIdx >= 0 do
    begin
      LineStart := SendMessageA(RichEdit1.Handle, EM_LINEINDEX, CharIdx, 0);
      LineLen := SendMessageA(RichEdit1.Handle, EM_LINELENGTH, LineStart, 0);
      LineText := TextRange(LineStart, LineLen);
      if Trim(LineText) <> '' then
        Break;
      Dec(CharIdx);
    end;
    if CharIdx < 0 then
      Exit;
    Before := LineText;
  end;

  CharIdx := 1;
  while (CharIdx <= Length(Before)) and (Before[CharIdx] in [' ', #9]) do
    Inc(CharIdx);
  Result := Copy(Before, 1, CharIdx - 1);

  // Последнее и первое слово текста до каретки (без комментария //)
  Before := Trim(Before);
  SpaceAt := Pos('//', Before);
  if SpaceAt > 0 then
    Before := TrimRight(Copy(Before, 1, SpaceAt - 1));
  if Before = '' then
    Exit;
  LastWord := Before;
  SpaceAt := Length(LastWord);
  while (SpaceAt > 0) and not (LastWord[SpaceAt] in [' ', #9, ';', ')', '(']) do
    Dec(SpaceAt);
  LastWord := LowerCase(Copy(LastWord, SpaceAt + 1, MaxInt));
  FirstWord := Before;
  SpaceAt := 1;
  while (SpaceAt <= Length(FirstWord)) and not (FirstWord[SpaceAt] in [' ', #9, '(']) do
    Inc(SpaceAt);
  FirstWord := LowerCase(Copy(FirstWord, 1, SpaceAt - 1));

  Ext := '';
  if (FWindowsIndex >= 0) and FWindows[FWindowsIndex].Used then
    Ext := LowerCase(ExtractFileExt(FWindows[FWindowsIndex].FileName));
  if Ext = '' then
    Ext := LowerCase(ExtractFileExt(FCurrentFileName));
  if Copy(Ext, Length(Ext), 1) = ')' then
    Delete(Ext, Length(Ext), 1);   // '(без имени.pas)'

  OpensBlock := False;
  if (Ext = '.pas') or (Ext = '.pp') or (Ext = '.dpr') or (Ext = '.lpr') or
     (Ext = '.dpk') or ((Ext = '.inc') and (CurBuildKind = bkDelphi)) then
    OpensBlock := (LastWord = 'begin') or (LastWord = 'try') or
                  (LastWord = 'repeat') or (LastWord = 'record') or
                  (LastWord = 'then') or (LastWord = 'do') or
                  (LastWord = 'else') or (LastWord = 'of') or
                  (LastWord = 'except') or (LastWord = 'finally') or
                  (LastWord = 'var') or (LastWord = 'const') or
                  (LastWord = 'type')
  else if (Ext = '.bas') or (Ext = '.rqb') or (Ext = '.rq') or (Ext = '.bi') or
          (Ext = '.inc') then
    OpensBlock := (LastWord = 'then') or (LastWord = 'else') or
                  (LastWord = 'do') or (FirstWord = 'sub') or
                  (FirstWord = 'function') or (FirstWord = 'subi') or
                  (FirstWord = 'functioni') or (FirstWord = 'type') or
                  (FirstWord = 'create') or (FirstWord = 'with') or
                  (FirstWord = 'for') or (FirstWord = 'while') or
                  (FirstWord = 'select') or (FirstWord = 'case') or
                  (FirstWord = 'event') or (FirstWord = 'constructor')
  else
    OpensBlock := Copy(Before, Length(Before), 1) = '{';

  if OpensBlock and (FIndentKind <> IndentNone) and (FIndentSize > 0) then
  begin
    if FIndentKind = IndentTabs then
      Unit_ := StringOfChar(#9, FIndentSize)
    else
      Unit_ := StringOfChar(' ', FIndentSize);
    Result := Result + Unit_;
  end;
end;

// Вставка в редактор - только текстом: текст буфера обмена (CF_TEXT;
// Windows сам делает его из CF_UNICODETEXT) заменой выделения
// (EM_REPLACESEL - через неё идут снимок для отмены и учёт правки).
// Наблюдение пользователя 2026-10-10: текст, скопированный из этого же
// редактора, через WM_PASTE (PasteFromClipboard) в него не вставлялся, а
// в лог (там вставка EM_PASTESPECIAL CF_UNICODETEXT) - вставлялся; текст
// из лога в редактор - тоже. WM_PASTE предпочитает формат буфера самого
// RichEdit (RTF и др.) - почему он не вставился, не выяснено.
procedure TForm1.PastePlainText;
var
  PasteText: string;
begin
  if not RichEdit1.HandleAllocated or RichEdit1.ReadOnly then
    Exit;
  if not Clipboard.HasFormat(CF_TEXT) then
    Exit;
  PasteText := Clipboard.AsText;
  if PasteText = '' then
    Exit;
  SendMessage(RichEdit1.Handle, EM_REPLACESEL, 1, Integer(PChar(PasteText)));
  SendMessageA(RichEdit1.Handle, EM_SCROLLCARET, 0, 0);
end;

procedure TForm1.EditClickEvent(Sender: TObject);
begin
  if RichEdit1 = nil then
    Exit;
  {
  // ИСПРАВЛЕНИЕ: Теперь метод корректно обрабатывает И элементы меню, И кнопки тулбара
  // через сквозную логику else if (быстро и без лишних холостых проверок)
  if (Sender = mUndo) or (Sender = btnUndo) then
    RichEdit1.Undo
  else if Sender = mRedo then
    RichEdit1.Perform(EM_REDO, 0, 0)
  else if (Sender = mCut) or (Sender = btnCut) then
    RichEdit1.CutToClipboard
  else if (Sender = mCopy) or (Sender = btnCopy) then
    RichEdit1.CopyToClipboard
  else if (Sender = mPaste) or (Sender = btnPaste) then
    RichEdit1.PasteFromClipboard
  else if Sender = mSelectAll then
    RichEdit1.SelectAll
  else if Sender = mDelete then
    RichEdit1.ClearSelection;

    //}

  // Расширяем условия, добавляя проверку на элементы PopupMenu через оператор OR
  if (Sender = mUndo) or (Sender = btnUndo) or (Sender = pmuUndo) then
    RichEdit1.Undo
  else if (Sender = mRedo) or (Sender = pmuRedo) then
    RichEdit1.Perform(EM_REDO, 0, 0)
  else if (Sender = mCut) or (Sender = btnCut) or (Sender = pmuCut) then
    RichEdit1.CutToClipboard
  else if (Sender = mCopy) or (Sender = btnCopy) or (Sender = pmuCopy) then
    RichEdit1.CopyToClipboard
  else if (Sender = mPaste) or (Sender = btnPaste) or (Sender = pmuPaste) then
    PastePlainText
  else if (Sender = mSelectAll) or (Sender = pmuSelectAll) then
    RichEdit1.SelectAll
  else if (Sender = mDelete) or (Sender = pmuDelete) then
  begin
    // ИСПРАВЛЕНИЕ: Если текст выделен — удаляем выделение
    if RichEdit1.SelLength > 0 then
      RichEdit1.ClearSelection
    else
    begin
      // Если выделения нет, имитируем нативное нажатие Del (удаляем 1 символ справа)
      // Проверяем, что курсор не в самом конце текста
      if RichEdit1.SelStart < RichEdit1.GetTextLen then
      begin
        RichEdit1.SelLength := 1; // Выделяем один символ справа от каретки
        RichEdit1.SelText := '';  // Стираем его
      end;
    end;
  end;
  // ИСПРАВЛЕНИЕ: При любом редактировании статус-бар сразу обновляет данные
  UpdateStatusBarInfo;
end;

procedure TForm1.ToolbarButtonClickEvent(Sender: TObject);
begin
  if Sender = btnOpen then
    N2Click(mOpen); // Вызываем стандартное открытие файла
  if Sender = btnSave then
    N3Click(mSave); // Вызываем наше универсальное сохранение
  if Sender = btnSavePrj then
    SaveProjectClick(Sender);
  if Sender = btnUndo then
    RichEdit1.Undo;
  if Sender = btnCut then
    RichEdit1.CutToClipboard;
  if Sender = btnCopy then
    RichEdit1.CopyToClipboard;
  if Sender = btnPaste then
    PastePlainText;

  // После действий возвращаем фокус в редактор, чтобы пользователь мог сразу писать код
  RichEdit1.SetFocus;
end;


// Обработчик клика по меню Options — открывает форму настроек цветов
// Обработчик клика по меню Options - открывает форму настроек цветов
procedure TForm1.mOptionsClick(Sender: TObject);
var
  StartTick, StageTick, TPrepare: Cardinal;
  FirstTime: Boolean;
begin
  StartTick := GetTickCount;
  FirstTime := (Form2 = nil) or not Form2.IsBuilt;
  StageTick := GetTickCount;
  PrepareOptionsForm;
  TPrepare := GetTickCount - StageTick;
  Form2.Show;
  // Время открытия окна настроек - в HiLite log. Первый раз окно ещё и
  // заполняется (InitOptions: строки путей, страница Compilers, таблицы),
  // поэтому дольше.
  if FirstTime then
    Dbg(Format('Options: открытие %d мс (построение и заполнение %d, ' +
    'показ %d) - первое', [GetTickCount - StartTick, TPrepare,
               GetTickCount - StartTick - TPrepare]), clNavy)
  else
    Dbg(Format('Options: открытие %d мс (заполнение %d, показ %d)',
               [GetTickCount - StartTick, TPrepare,
               GetTickCount - StartTick - TPrepare]), clNavy);
end;

