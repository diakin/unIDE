// Маркер на вкладке должен следить за флагом изменений. Перерисовываем панель
// только в момент СМЕНЫ состояния, а не на каждое нажатие клавиши.
//
// Что показано сейчас, берётся с самой вкладки, а не из запомненного
// FTabsModShown: сохранение (и другие места, где Modified сбрасывается)
// снимало звёздочку, не трогая FTabsModShown. Он оставался True, и на
// следующей правке Modified = FTabsModShown - звёздочка не появлялась.
procedure TForm1.RefreshTabsModified;
var
  TabIdx: Integer;
  StarShown: Boolean;
begin
  if FTabs = nil then
    Exit;
  TabIdx := TabIndexOfWindow(FWindowsIndex);
  if (TabIdx < 0) or (TabIdx >= FTabs.Tabs.Count) then
    Exit;
  StarShown := Copy(FTabs.Tabs[TabIdx], 1, 2) = '* ';
  FTabsModShown := RichEdit1.Modified;
  if RichEdit1.Modified = StarShown then
    Exit;
  UpdateTabCaption(FWindowsIndex); // звёздочка появляется или исчезает
end;

procedure TForm1.RichEdit1Change(Sender: TObject);
var
  LineCountNow: Integer;
begin
  Inc(FEditSerial);
  // Карта перестраивается исключительно тогда, когда пользователь редактирует текст
  // 1. Текст изменился — полностью перестраиваем карту /* и */ с помощью PosEx

  // Число строк - одним сообщением. Lines.Count у TRichEditStrings шлёт то
  // же EM_GETLINECOUNT, потом ещё EM_LINEINDEX и EM_LINELENGTH, и вычитает
  // единицу, когда последняя строка пуста: другая величина, чем в гуттере
  // и в UpdateVisibleBounds.
  LineCountNow := SendMessageA(RichEdit1.Handle, EM_GETLINECOUNT, 0, 0);
  if RichEditLinesCount <> LineCountNow then
  begin
    RichEditLinesCount := LineCountNow;
    // Тот же заказ, что и в NewRichEditProc. Два вызова подряд не удваивают
    // работу: таймер один, и сработает он один раз.
    ScheduleMapRebuild;
  end;

  // 2. Сразу же пересчитываем FirstChar и LastChar для текущего кадра
  UpdateVisibleBounds;
  // RichEdit1.Invalidate;
  // UpdateStatusBarInfo; // Обновляем статус-бар при изменении текста

  // 3. Заставляем RichEdit мгновенно перерисоваться по новым координатам
  // RichEdit1.Invalidate;
  RefreshTabsModified;
end;

