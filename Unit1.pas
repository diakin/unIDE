// Вернуть все цвета IDE к умолчаниям (файл при этом не трогаем - его
// перезапишет SaveUiSchema, когда об этом попросят)
procedure TForm1.UiResetDefaults;
var
  L: TStringList;
begin
  // Только цвета текущего режима: умолчания впишутся заново в пустой список.
  // Своя тема - тёмные умолчания.
  L := nil;
  if FIdeMode = IdeModeCustom then
    L := UiCustomSet(FIdeCustom)
  else if FIdeMode = IdeModeDark then
  begin
    if FUiDark <> nil then
      FUiDark.Clear;
  end
  else if FUiLight <> nil then
    FUiLight.Clear;
  if FUiColors <> nil then
    FUiColors.Clear;
  LoadUiDefaults;
  if L <> nil then
  begin
    L.Assign(FUiDarkDef);
    UiFillColors;
  end;
end;
// Диагностика фона списков (Ide.ListBG): что делает с ним UiApply. В лог -
// каждое новое сообщение по элементу один раз.
var
  UiBgSeen: TStringList = nil;

procedure UiBgNote(C: TControl; const S: string);
var
  Key, Nm: string;
begin
  if Form1 = nil then
    Exit;
  if UiBgSeen = nil then
    UiBgSeen := TStringList.Create;
  Key := IntToHex(Integer(C), 8) + ' ' + S;
  if UiBgSeen.IndexOf(Key) >= 0 then
    Exit;
  UiBgSeen.Add(Key);
  Nm := '';
  if C <> nil then
  begin
    Nm := C.Name + ':' + C.ClassName;
    if C.Parent <> nil then
      Nm := Nm + ' в ' + C.Parent.Name + ':' + C.Parent.ClassName;
    Nm := Nm + ' - ';
  end;
  Form1.Dbg('2639: фон: ' + Nm + S, clNavy);
end;

// Тема своих элементов (UiTheme): Light или Dark по режиму IDE, цвета
// ролей темы - из ролей IDE (IDE.clr). Роли IDE, которых в теме нет
// (вкладки, дерево объектов, панель объявления), остаются в Unit1.
procedure TForm1.UiPushTheme;
const
  // Роль темы = роль IDE
  Map: array[0..31, 0..1] of string = (
    ('Window.BG', 'Ide.WindowBG'), ('Window.Text', 'Ide.WindowText'),
    ('List.BG', 'Ide.ListBG'), ('List.Text', 'Ide.ListText'),
    ('Edit.BG', 'Ide.EditBG'), ('Edit.Text', 'Ide.EditText'),
    ('Button.BG', 'Button.BG'), ('Button.HotBG', 'Button.HotBG'),
    ('Button.DownBG', 'Button.DownBG'), ('Button.Text', 'Button.Text'),
    ('Button.Border', 'Button.Border'),
    ('Group.Text', 'Group.Text'), ('Group.Border', 'Group.Border'),
    ('Scroll.Track', 'Scroll.Track'), ('Scroll.Thumb', 'Scroll.Thumb'),
    ('Scroll.ThumbHot', 'Scroll.ThumbHot'), ('Scroll.Arrow', 'Scroll.Arrow'),
    ('Grid.Lines', 'Grid.Lines'),
  // Рамка в фокусе - цветом активной вкладки, подпись выключенного -
  // цветом крестика неактивной вкладки
    ('Focus', 'Tabs.ActiveBG'), ('OffText', 'Tabs.CloseOff'),
  // Ярлычки вкладок (TUiPageControl, TUiTabControl) - цветами вкладок
  // редактора; под мышью - как у кнопок
    ('Tab.BG', 'Tabs.InactiveBG'), ('Tab.ActiveBG', 'Tabs.ActiveBG'),
    ('Tab.HotBG', 'Button.HotBG'), ('Tab.Text', 'Tabs.Text'),
    ('Tab.Border', 'Tabs.Border'),
  // Своё меню - своими ролями IDE
    ('Menu.BG', 'Menu.BG'), ('Menu.Text', 'Menu.Text'),
    ('Menu.HotBG', 'Menu.HotBG'), ('Menu.HotText', 'Menu.HotText'),
    ('Menu.Border', 'Menu.Border'),
  // Выделение кнопки-значка - своей ролью IDE
    ('IconButton.HotBG', 'IconButton.HotBG'),
    ('IconButton.BG', 'IconButton.BG'));
var
  I: Integer;
begin
  case FIdeMode of
    IdeModeDark: UiThemeSetKind(utDark, False);
    IdeModeCustom: UiThemeSetKind(utCustom, False);
  else
    UiThemeSetKind(utLight, False);
  end;
  for I := Low(Map) to High(Map) do
    UiThemeSetColor(Map[I, 0], UiColor(Map[I, 1]));
  UiThemeChanged;
end;

// Перерисовать то, что зависит от цветов IDE
// Перекраска - без показа по ходу (UiFreezeForms): окна рисуются один раз,
// когда цвета стоят у всех элементов - и у формы, и у списков. Отсюда её
// вызывают и смена режима IDE, и правка цветов IDE в окне настроек.
procedure TForm1.UiApply;
begin
  UiFreezeForms(True);
  try
    UiApplyNow;
  finally
    if StartupActive then
      StartupStage('Тема IDE: разморозка окон');
    UiFreezeForms(False);
  end;
end;

procedure TForm1.UiApplyNow;
var
  I: Integer;
  StartTick, FormsTick, ThemeTick: Cardinal;
  GlyphsBefore: Integer;
begin
  StartTick := GetTickCount;
  GlyphsBefore := FUiGlyphBuilt;
  FormsTick := 0;
  ThemeTick := 0;
  UiBgNote(nil, 'UiApply, Ide.ListBG = ' + ColorToString(UiColor('Ide.ListBG')) +
  ', режим ' + IntToStr(Ord(FIdeDark)));
           if FTabs <> nil then
           FTabs.Invalidate;
  // Маркеры выделения в конструкторе форм
           DsgCaretColor := UiColor('Dsg.Caret');
           DsgGroupColor := UiColor('Dsg.GroupMark');
           if FDesigner <> nil then
           FDesigner.RepaintCarets;

  // Порядок: сначала формы и всё, что на них (UiApplyForm - от формы вниз
  // по дереву), потом свои элементы темы - списки, деревья, кнопки, рамки
  // (UiPushTheme), и только потом перерисовка списков инспектора. Так
  // список свойств получает новые цвета последним, на уже перекрашенной
  // форме.

  // Элементы всех окон программы - кроме формы в конструкторе: её красит
  // DsgRetheme в конце
           FormsTick := GetTickCount;
           for I := 0 to Screen.FormCount - 1 do
           begin
             // Запуск: каждое окно - этапом в startup.log
             if StartupActive then
               StartupStage('Тема IDE: окно ' + Screen.Forms[I].Name + ' (' +
                 Screen.Forms[I].ClassName + ', компонентов ' +
                 IntToStr(Screen.Forms[I].ComponentCount) + ')');
             UiApplyForm(Screen.Forms[I]);
           end;
           FormsTick := GetTickCount - FormsTick;

  // Свои элементы (кнопки, рамки, полосы прокрутки, списки) - по теме
  // UiTheme: режим IDE и цвета ролей из IDE.clr. Тема рассылает смену
  // сама: все элементы перерисовываются.
           if StartupActive then
           begin
             StartupStage('Тема IDE: элементы темы (UiPushTheme)');
             UiThemeProfileStart;
           end;
           ThemeTick := GetTickCount;
           UiPushTheme;
           ThemeTick := GetTickCount - ThemeTick;
           // Запуск: какие классы элементов заняли рассылку - в тот же этап
           if StartupActive then
             StartupStageNote(': ' + UiThemeProfileReport(8));

  // Номер текущей строки на полосе номеров, текст свойств инспектора
           if StartupActive then
             StartupStage('Тема IDE: инспектор, подсказки, конструктор');
           if PaintBox1 <> nil then
           PaintBox1.Invalidate;
           DeclPanelShow;
           if FObjTree <> nil then
           FObjTree.Invalidate;
           if FObjProps <> nil then
           FObjProps.Invalidate;

  // Цвета ролей, которые теперь стоят у элементов. По ним при следующей
  // смене цвета UiPaintControl узнаёт свой цвет у каждого элемента.
  // Запоминаются только здесь, после прохода по всем окнам: если писать их
  // по ходу (как было в SetBg/SetFg), первый же перекрашенный элемент
  // затирал прежний цвет роли, и остальные с прежним цветом считались
  // чужими и не перекрашивались (HiLite log: «цвет clOlive не свой»).
           if FUiApplied = nil then
           FUiApplied := TStringList.Create;
           FUiApplied.Clear;
           if FUiColors <> nil then
           for I := 0 to FUiColors.Count - 1 do
           FUiApplied.Add(FUiColors.Names[I] + '=' +
                          ColorToString(UiColor(FUiColors.Names[I])));

  // Всплывающие подсказки VCL (Hint у кнопок, полей, строки пути): фон -
  // Application.HintColor, текст - шрифтом Screen.HintFont. Действует со
  // следующей показанной подсказки.
           if FUiLight <> nil then
  begin
    Application.HintColor := UiColor('Hint.BG');
    Screen.HintFont.Color := UiColor('Hint.Text');
  end;

  // Своя форма в конструкторе - в цветах темы и в живом виде: после смены
  // режима IDE перекрашивается на месте, без перестройки (DsgRetheme)
  if (FDesigner <> nil) and (FDesigner.Form <> nil) and IsOwnProject and
     (OwnLiveForm(FObjFormClass) <> nil) then
    DsgRetheme;
  Dbg('3091: тема: UiApply ' + IntToStr(GetTickCount - StartTick) +
  ' мс (окна ' + IntToStr(FormsTick) + ', элементы темы ' +
      IntToStr(ThemeTick) + '; тёмных значков построено ' +
      IntToStr(FUiGlyphBuilt - GlyphsBefore) + ')', clGray);
end;


// ---------------------------------------------------------------------------
//  Значки кнопок в IDE Dark
//
//  Значки нарисованы под светлый фон. В IDE Dark у каждого значка кнопки
//  (тулбар, ряд Delphi, палитра компонентов) яркость каждой точки
//  переворачивается, оттенок и насыщенность остаются: тёмное становится
//  светлым, белое - чёрным, синее остаётся синим. Прозрачный цвет (левый
//  нижний пиксель, как у TSpeedButton) не трогается.
//  Исходный значок хранит TUiGlyph - компонент, которым владеет сама кнопка;
//  в IDE Light он возвращается. Если код поставил кнопке новый значок, он и
//  становится исходным.
// ---------------------------------------------------------------------------

procedure UiRGBToHLS(R, G, B: Byte; var H, L, S: Double);
var
  Rf, Gf, Bf, Mx, Mn, D: Double;
begin
  Rf := R / 255; Gf := G / 255; Bf := B / 255;
  Mx := Rf;
  if Gf > Mx then Mx := Gf;
  if Bf > Mx then Mx := Bf;
  Mn := Rf;
  if Gf < Mn then Mn := Gf;
  if Bf < Mn then Mn := Bf;
  L := (Mx + Mn) / 2;
  if Mx = Mn then
  begin
    H := 0; S := 0; Exit;
  end;
  D := Mx - Mn;
  if L <= 0.5 then S := D / (Mx + Mn) else S := D / (2 - Mx - Mn);
  if Mx = Rf then H := (Gf - Bf) / D
  else if Mx = Gf then H := 2 + (Bf - Rf) / D
  else H := 4 + (Rf - Gf) / D;
  H := H / 6;
  if H < 0 then H := H + 1;
end;

function UiHueToRGB(M1, M2, H: Double): Double;
begin
  if H < 0 then H := H + 1;
  if H > 1 then H := H - 1;
  if H < 1 / 6 then Result := M1 + (M2 - M1) * H * 6
  else if H < 0.5 then Result := M2
  else if H < 2 / 3 then Result := M1 + (M2 - M1) * (2 / 3 - H) * 6
  else Result := M1;
end;

procedure UiHLSToRGB(H, L, S: Double; var R, G, B: Byte);
var
  M1, M2: Double;
begin
  if S = 0 then
  begin
    R := Round(L * 255); G := R; B := R; Exit;
  end;
  if L <= 0.5 then M2 := L * (1 + S) else M2 := L + S - L * S;
  M1 := 2 * L - M2;
  R := Round(UiHueToRGB(M1, M2, H + 1 / 3) * 255);
  G := Round(UiHueToRGB(M1, M2, H) * 255);
  B := Round(UiHueToRGB(M1, M2, H - 1 / 3) * 255);
end;

// Перевернуть яркость каждой точки, кроме прозрачного цвета
procedure UiInvertLightness(Bmp: TBitmap; ATransparent: TColor);
type
  TRGBLine = array[0..32767] of TRGBTriple;
  PRGBLine = ^TRGBLine;
var
  X, Y: Integer;
  P: PRGBLine;
  T: Longint;
  H, L, S: Double;
  R, G, B: Byte;
begin
  Bmp.PixelFormat := pf24bit;
  T := ColorToRGB(ATransparent);
  for Y := 0 to Bmp.Height - 1 do
  begin
    P := Bmp.ScanLine[Y];
    for X := 0 to Bmp.Width - 1 do
    begin
      if (P[X].rgbtRed = GetRValue(T)) and (P[X].rgbtGreen = GetGValue(T)) and
         (P[X].rgbtBlue = GetBValue(T)) then
        Continue;
      UiRGBToHLS(P[X].rgbtRed, P[X].rgbtGreen, P[X].rgbtBlue, H, L, S);
      UiHLSToRGB(H, 1 - L, S, R, G, B);
      P[X].rgbtRed := R;
      P[X].rgbtGreen := G;
      P[X].rgbtBlue := B;
    end;
  end;
end;

// Значок палитры компонентов для тёмного фона - плоский, одним цветом.
// Значки Delphi нарисованы 16 цветами под светлый фон, с объёмом: рамки
// из серой тени и белого блика. Переворот яркости делал из чёрных линий
// белые рамки, а тёмно-синий - ярко-сиреневым.
// Каждая точка становится либо цвета значка (AColor), либо прозрачной:
//   1. Тёмные точки (чёрные линии, серые тени, синие и другие насыщенные
//      детали) - цвет значка. Светлые (белая заливка, серебристые кнопки,
//      блики) - прозрачные.
//   2. Кроме светлой точки на внешнем краю: она касается прозрачного фона
//      и не касается тёмной линии. Это правая и нижняя сторона вдавленной
//      рамки (поле ввода, флажок) - у них блик снаружи, и без этого рамка
//      осталась бы без двух сторон. Белая половина рамки TGroupBox
//      прилегает к серой линии - она убирается, рамка остаётся в одну
//      линию. Угол такой рамки касается тёмной линии одной стороной, но по
//      диагонали тёмных точек у него нет (у белой линии TGroupBox - есть) -
//      он тоже цвета значка, иначе в углах были бы дырки.
//   3. Рамки в одну линию. У вдавленной рамки сверху и слева две линии
//      (серая и чёрная), у кнопки снизу и справа - чёрная и серая тень.
//      Внешняя линия - та, что касается прозрачного фона (Ring). Точка
//      сразу за ней внутрь убирается, если там полоса ровно в две точки
//      (дальше внутрь - не цвет значка) и такая полоса тянется вдоль края
//      не меньше чем на ThinRun точек. Сплошные фигуры (стрелка, буква A,
//      метка своих) и короткие детали не трогаются.
procedure UiPaletteRecolor(Bmp: TBitmap; ATransparent, AColor: TColor);
type
  TRGBLine = array[0..32767] of TRGBTriple;
  PRGBLine = ^TRGBLine;
const
  KindKey = 0;     // прозрачная
  KindInk = 1;     // тёмная - цвет значка
  KindLight = 2;   // светлая
  ThinRun = 4;
  // Четыре соседа по сторонам, затем четыре по диагонали
  StepX: array[0..7] of Integer = (1, -1, 0, 0, 1, 1, -1, -1);
  StepY: array[0..7] of Integer = (0, 0, 1, -1, 1, -1, 1, -1);
var
  PosX, PosY, StepIdx, NearX, NearY, BmpW, BmpH, RunLen, RunStep: Integer;
  SideSign, TanX, TanY: Integer;
  Line: PRGBLine;
  KeyRGB, InkRGB, SrcRGB: Longint;
  Hue, Light, Sat: Double;
  Kinds: array of Byte;
  Ink, Ring, Keep: array of Boolean;
  NearKey: Boolean;
  InkSide, InkDiag: Integer;

  function KindAt(AX, AY: Integer): Byte;
  begin
    if (AX < 0) or (AY < 0) or (AX >= BmpW) or (AY >= BmpH) then
      Result := KindKey
    else
      Result := Kinds[AY * BmpW + AX];
  end;

  function InkAt(AX, AY: Integer): Boolean;
  begin
    Result := (AX >= 0) and (AY >= 0) and (AX < BmpW) and (AY < BmpH) and
              Ink[AY * BmpW + AX];
  end;

  function RingAt(AX, AY: Integer): Boolean;
  begin
    Result := (AX >= 0) and (AY >= 0) and (AX < BmpW) and (AY < BmpH) and
              Ring[AY * BmpW + AX];
  end;

// Точка (AX, AY) - вторая линия полосы в две точки: снаружи (в сторону
// ADX, ADY) - внешняя линия, внутри - не цвет значка
  function InnerAt(AX, AY, ADX, ADY: Integer): Boolean;
  begin
    Result := InkAt(AX, AY) and not RingAt(AX, AY) and
              RingAt(AX + ADX, AY + ADY) and not InkAt(AX - ADX, AY - ADY);
  end;

begin
  Bmp.PixelFormat := pf24bit;
  BmpW := Bmp.Width;
  BmpH := Bmp.Height;
  if (BmpW = 0) or (BmpH = 0) then
    Exit;
  KeyRGB := ColorToRGB(ATransparent);
  InkRGB := ColorToRGB(AColor);
  SetLength(Kinds, BmpW * BmpH);
  SetLength(Ink, BmpW * BmpH);
  SetLength(Ring, BmpW * BmpH);
  SetLength(Keep, BmpW * BmpH);

  // Какая точка: прозрачная, тёмная, светлая
  for PosY := 0 to BmpH - 1 do
  begin
    Line := Bmp.ScanLine[PosY];
    for PosX := 0 to BmpW - 1 do
    begin
      SrcRGB := RGB(Line[PosX].rgbtRed, Line[PosX].rgbtGreen,
                    Line[PosX].rgbtBlue);
      if SrcRGB = KeyRGB then
        Kinds[PosY * BmpW + PosX] := KindKey
      else
      begin
        UiRGBToHLS(Line[PosX].rgbtRed, Line[PosX].rgbtGreen,
                   Line[PosX].rgbtBlue, Hue, Light, Sat);
        if Light <= 0.55 then
          Kinds[PosY * BmpW + PosX] := KindInk
        else
          Kinds[PosY * BmpW + PosX] := KindLight;
      end;
    end;
  end;

  // Шаги 1 и 2: какие точки цвета значка
  for PosY := 0 to BmpH - 1 do
    for PosX := 0 to BmpW - 1 do
    case Kinds[PosY * BmpW + PosX] of
      KindKey:
        Ink[PosY * BmpW + PosX] := False;
      KindInk:
        Ink[PosY * BmpW + PosX] := True;
    else
    begin
      NearKey := False;
      InkSide := 0;
      InkDiag := 0;
      for StepIdx := 0 to 7 do
      begin
        NearX := PosX + StepX[StepIdx];
        NearY := PosY + StepY[StepIdx];
        case KindAt(NearX, NearY) of
          KindKey:
            if StepIdx < 4 then
            NearKey := True;
          KindInk:
            if StepIdx < 4 then
            Inc(InkSide)
          else
            Inc(InkDiag);
        end;
      end;
      Ink[PosY * BmpW + PosX] := NearKey and
        ((InkSide = 0) or ((InkSide = 1) and (InkDiag = 0)));
    end;
    end;

  // Внешняя линия: цвет значка, касается прозрачного фона исходного значка
  for PosY := 0 to BmpH - 1 do
    for PosX := 0 to BmpW - 1 do
    begin
      Ring[PosY * BmpW + PosX] := False;
      if not Ink[PosY * BmpW + PosX] then
        Continue;
      for StepIdx := 0 to 3 do
        if KindAt(PosX + StepX[StepIdx], PosY + StepY[StepIdx]) = KindKey then
          Ring[PosY * BmpW + PosX] := True;
    end;

  // Шаг 3: вторая линия рамки убирается
  for PosY := 0 to BmpH - 1 do
    for PosX := 0 to BmpW - 1 do
    begin
      Keep[PosY * BmpW + PosX] := Ink[PosY * BmpW + PosX];
      if not Ink[PosY * BmpW + PosX] or Ring[PosY * BmpW + PosX] then
        Continue;
      for StepIdx := 0 to 3 do
      begin
        if not InnerAt(PosX, PosY, StepX[StepIdx], StepY[StepIdx]) then
          Continue;
        // Длина полосы вдоль края - в обе стороны
        TanX := StepY[StepIdx];
        TanY := StepX[StepIdx];
        RunLen := 1;
        for SideSign := 0 to 1 do
        begin
          RunStep := 1;
          while InnerAt(PosX + TanX * RunStep * (1 - 2 * SideSign),
                        PosY + TanY * RunStep * (1 - 2 * SideSign),
                        StepX[StepIdx], StepY[StepIdx]) do
          begin
            Inc(RunLen);
            Inc(RunStep);
          end;
        end;
        if RunLen >= ThinRun then
        begin
          Keep[PosY * BmpW + PosX] := False;
          Break;
        end;
      end;
    end;

  // Запись
  for PosY := 0 to BmpH - 1 do
  begin
    Line := Bmp.ScanLine[PosY];
    for PosX := 0 to BmpW - 1 do
    begin
      if Kinds[PosY * BmpW + PosX] = KindKey then
        Continue;
      if Keep[PosY * BmpW + PosX] then
        SrcRGB := InkRGB
      else
        SrcRGB := KeyRGB;
      Line[PosX].rgbtRed := GetRValue(SrcRGB);
      Line[PosX].rgbtGreen := GetGValue(SrcRGB);
      Line[PosX].rgbtBlue := GetBValue(SrcRGB);
    end;
  end;
end;

type
  // Значки кнопки для тёмного фона: исходный и перевёрнутый, и какой из них
  // поставлен сейчас. Ставится при первом перевороте, принадлежит самой
  // кнопке. Какой значок у кнопки, решает IsDark - что поставили мы, а не
  // сверка рисунка: контрольная сумма значка, прочитанная у кнопки позже,
  // с поставленным не совпадала (HiLite log: у разных значков одного
  // размера - одна и та же сумма).
  TUiGlyph = class(TComponent)
  public
    Orig: TBitmap;       // исходный значок
    Dark: TBitmap;       // с перевёрнутой яркостью; пустой - ещё не строили
    IsDark: Boolean;     // у кнопки сейчас Dark
    // По какому цвету построен Dark (у значков палитры - Palette.Icon);
    // цвета сменились - Dark строится заново
    DarkSig: string;
    constructor Create(AOwner: TComponent); override;
    destructor Destroy; override;
  end;

constructor TUiGlyph.Create(AOwner: TComponent);
begin
  inherited Create(AOwner);
  Orig := TBitmap.Create;
  Dark := TBitmap.Create;
end;

destructor TUiGlyph.Destroy;
begin
  Dark.Free;
  Orig.Free;
  inherited;
end;

// Значок кнопки со значком: TSpeedButton или TUiIconButton (у обеих Glyph,
// прозрачный цвет - левый нижний пиксель, при двух значках рядом второй -
// для недоступной). nil - у контрола значка нет.
function BtnGlyph(ABtn: TControl): TBitmap;
begin
  if ABtn is TSpeedButton then
    Result := TSpeedButton(ABtn).Glyph
  else if ABtn is TUiIconButton then
    Result := TUiIconButton(ABtn).Glyph
  else
    Result := nil;
end;

// Поставить значок: число значков в картинке кнопка определит по ширине
procedure SetBtnGlyph(ABtn: TControl; AGlyph: TBitmap);
begin
  if ABtn is TSpeedButton then
    TSpeedButton(ABtn).Glyph := AGlyph
  else if ABtn is TUiIconButton then
    TUiIconButton(ABtn).Glyph := AGlyph;
end;

// Диагностика значков: что UiApplyGlyph делает с каждым значком. В лог -
// каждое новое сообщение по кнопке один раз.
var
  UiGlyphSeen: TStringList = nil;

procedure UiGlyphNote(ABtn: TControl; const AWhat: string);
var
  Key, Who: string;
  Owner: TWinControl;
begin
  if Form1 = nil then
    Exit;
  // Кнопки палитры (их сотни) в лог не пишем - итог даёт замер UiApply
  // (3091)
  Owner := ABtn.Parent;
  while Owner <> nil do
  begin
    if Owner is TDsgPalette then
      Exit;
    Owner := Owner.Parent;
  end;
  if UiGlyphSeen = nil then
    UiGlyphSeen := TStringList.Create;
  Key := IntToHex(Integer(ABtn), 8) + ' ' + AWhat;
  if UiGlyphSeen.IndexOf(Key) >= 0 then
    Exit;
  UiGlyphSeen.Add(Key);
  Who := ABtn.Name;
  if Who = '' then
    Who := '"' + ABtn.Hint + '"';
  if ABtn.Parent <> nil then
    Who := Who + ' в ' + ABtn.Parent.Name + ':' + ABtn.Parent.ClassName;
  Form1.Dbg('3089: значок: ' + Who + ' - ' + AWhat, clNavy);
end;

// Кнопка палитры компонентов (TDsgPalette где-то среди родителей)
function UiIsPaletteBtn(ABtn: TControl): Boolean;
var
  Owner: TWinControl;
begin
  Result := False;
  Owner := ABtn.Parent;
  while Owner <> nil do
  begin
    if Owner is TDsgPalette then
    begin
      Result := True;
      Exit;
    end;
    Owner := Owner.Parent;
  end;
end;

// Кнопка палитры со своим компонентом (TUi*): у кнопок палитры в Tag -
// класс компонента (TDsgPalette.PlaceButton), у стрелки - 0
function UiIsPaletteCustom(ABtn: TControl): Boolean;
begin
  Result := (ABtn.Tag <> 0) and
            (CompareText(Copy(TClass(ABtn.Tag).ClassName, 1, 3), 'TUi') = 0);
end;

procedure TForm1.UiApplyGlyph(ABtn: TControl);
var
  Mark: TUiGlyph;
  Index: Integer;
  DarkBack, ForPalette: Boolean;
  Sig: string;
  IconColor, PalBack: TColor;
begin
  if (BtnGlyph(ABtn) = nil) or BtnGlyph(ABtn).Empty then
    Exit;
  Mark := nil;
  for Index := 0 to ABtn.ComponentCount - 1 do
    if ABtn.Components[Index] is TUiGlyph then
      Mark := TUiGlyph(ABtn.Components[Index]);
  DarkBack := UiDarkBack;

  if Mark = nil then
  begin
    if not DarkBack then
      Exit;                 // фон светлый, значок не трогали - как есть
    // Первый переворот: исходный значок - в метку
    Mark := TUiGlyph.Create(ABtn);
    Mark.Orig.Assign(BtnGlyph(ABtn));
    Mark.IsDark := False;
    UiGlyphNote(ABtn, 'метка создана');
  end;

  // Значки палитры перекрашиваются цветом Palette.Icon, свои компоненты -
  // Palette.IconCustom. Сглаженные края (значок TUiTheme, метка своих)
  // смешаны с фоном палитры. Цвет и фон - подпись тёмного значка.
  ForPalette := DarkBack and UiIsPaletteBtn(ABtn);
  Sig := '';
  IconColor := clNone;
  PalBack := clNone;
  if ForPalette then
  begin
    if UiIsPaletteCustom(ABtn) then
      IconColor := UiColor('Palette.IconCustom')
    else
      IconColor := UiColor('Palette.Icon');
    if ABtn.Parent is TScrollBox then
      PalBack := TScrollBox(ABtn.Parent).Color
    else
      PalBack := UiColor('Ide.WindowBG');
    Sig := IntToHex(IconColor, 8) + IntToHex(ColorToRGB(PalBack), 8);
  end;
  // Цвета сменились - тёмный значок строится и ставится заново
  if DarkBack and Mark.IsDark and (Mark.DarkSig <> Sig) then
    Mark.IsDark := False;

  if DarkBack = Mark.IsDark then
    Exit;                   // у кнопки уже нужный значок

  if DarkBack then
  begin
    if Mark.Dark.Empty or (Mark.DarkSig <> Sig) then
    begin
      Mark.Dark.Assign(Mark.Orig);
      if ForPalette then
      begin
        // Из исходного значка кнопки (без метки) - палитра знает его; не
        // знает - перекраска того, что стоит
        if (FDsgPalette = nil) or
           not FDsgPalette.RenderGlyph(ABtn, True, IconColor, IconColor,
                                       PalBack, UiPaletteRecolor,
                                       Mark.Dark) then
          UiPaletteRecolor(Mark.Dark,
                           Mark.Dark.Canvas.Pixels[0, Mark.Dark.Height - 1],
                           IconColor);
      end
      else
        UiInvertLightness(Mark.Dark,
                          Mark.Dark.Canvas.Pixels[0, Mark.Dark.Height - 1]);
      Mark.DarkSig := Sig;
      Inc(FUiGlyphBuilt);
    end;
    SetBtnGlyph(ABtn, Mark.Dark);
    UiGlyphNote(ABtn, 'тёмный фон: поставлен тёмный значок');
  end
  else
  begin
    SetBtnGlyph(ABtn, Mark.Orig);
    UiGlyphNote(ABtn, 'светлый фон: поставлен исходный');
  end;
  Mark.IsDark := DarkBack;
end;

// Код поставил кнопке новый значок после переворота: метка с прежними
// значками больше не нужна - следующий UiApplyGlyph начнёт с нового
procedure TForm1.UiGlyphReset(ABtn: TControl);
var
  Index: Integer;
begin
  if ABtn = nil then
    Exit;
  for Index := ABtn.ComponentCount - 1 downto 0 do
    if ABtn.Components[Index] is TUiGlyph then
      ABtn.Components[Index].Free;
  UiApplyGlyph(ABtn);
end;

// ---------------------------------------------------------------------------
//  Значки кнопок тулбара и ряда Delphi
//
//  Две ленты в toolbar_icons.res (делает icons\make_icons.py):
//  BMP_ICONS_LIGHT и BMP_ICONS_DARK. В ленте ToolIconSize * число значков
//  по ширине и две строки по высоте: верхняя - обычный значок, нижняя - он
//  же для недоступной кнопки. Ленты 32-битные, с альфа-каналом (цвета
//  умножены на альфу) - их рисует TUiIconButton через AlphaBlend.
//  Значки - набор Lazarus general_purpose (Roland Hahn, CC0), 24x24 как
//  есть (icons\png); дискеты - из их SVG с чёрным корпусом (icons\svg). В
//  тёмной ленте корпус дискеты серый, серые значки недоступных - светлее.
//  Порядок в ленте - константы Icon* ниже (список ICONS в make_icons.py
//  должен быть в том же порядке).
//  Тёмный значок кладётся в TUiGlyph.Dark кнопки заранее: UiApplyGlyph
//  ставит его, а не строит переворотом яркости.
// ---------------------------------------------------------------------------

const
  ToolIconSize = 24;   // сторона значка в ленте, пикселей
  // Номера значков в лентах - порядок ICONS в icons\make_icons.py
  IconOpen      = 0;
  IconSave      = 1;
  IconUndo      = 2;
  IconCut       = 3;
  IconCopy      = 4;
  IconPaste     = 5;
  IconSavePrj   = 6;
  IconRun       = 7;
  IconViewUnit  = 8;
  IconViewForm  = 9;
  IconNewForm   = 10;
  IconPause     = 11;
  IconReset     = 12;
  IconTraceInto = 13;
  IconStepOver  = 14;
  IconArdVerify = 15;   // Arduino: Verify
  IconArdUpload = 16;   // Arduino: Upload

  // Лента из ресурсов программы. Нет ресурса - лента остаётся пустой, и
  // кнопки останутся без значков, но программа запустится.
procedure LoadToolStrip(const AResName: string; AStrip: TBitmap);
begin
  AStrip.Width := 0;
  AStrip.Height := 0;
  if FindResource(HInstance, PChar(AResName), RT_BITMAP) = 0 then
    Exit;
  try
    AStrip.LoadFromResourceName(HInstance, AResName);
  except
    AStrip.Width := 0;
    AStrip.Height := 0;
  end;
end;

// Значок номер AIconIdx из ленты: обычный и для недоступной кнопки рядом,
// ширина 2 * ToolIconSize - как ждёт TSpeedButton при NumGlyphs = 2.
// 32-битная лента (значки с альфа-каналом) копируется построчно: через
// Canvas альфа не сохраняется.
function CutToolIcon(AStrip: TBitmap; AIconIdx: Integer;
                     AGlyph: TBitmap): Boolean;
type
  TQuadRow = array[0..32767] of TRGBQuad;
  PQuadRow = ^TQuadRow;
var
  SrcLeft, RowIdx: Integer;
  SrcRow, DstRow: PQuadRow;
begin
  Result := False;
  if (AStrip = nil) or AStrip.Empty or (AIconIdx < 0) or
     ((AIconIdx + 1) * ToolIconSize > AStrip.Width) or
     (AStrip.Height < ToolIconSize * 2) then
    Exit;
  SrcLeft := AIconIdx * ToolIconSize;
  if AStrip.PixelFormat = pf32bit then
  begin
    AGlyph.PixelFormat := pf32bit;
    AGlyph.Width := ToolIconSize * 2;
    AGlyph.Height := ToolIconSize;
    for RowIdx := 0 to ToolIconSize - 1 do
    begin
      DstRow := AGlyph.ScanLine[RowIdx];
      SrcRow := AStrip.ScanLine[RowIdx];
      Move(SrcRow^[SrcLeft], DstRow^[0], ToolIconSize * SizeOf(TRGBQuad));
      SrcRow := AStrip.ScanLine[RowIdx + ToolIconSize];
      Move(SrcRow^[SrcLeft], DstRow^[ToolIconSize],
           ToolIconSize * SizeOf(TRGBQuad));
    end;
    Result := True;
    Exit;
  end;
  AGlyph.PixelFormat := pf24bit;
  AGlyph.Width := ToolIconSize * 2;
  AGlyph.Height := ToolIconSize;
  AGlyph.Canvas.CopyMode := cmSrcCopy;
  AGlyph.Canvas.CopyRect(Rect(0, 0, ToolIconSize, ToolIconSize),
                         AStrip.Canvas,
                         Rect(SrcLeft, 0, SrcLeft + ToolIconSize, ToolIconSize));
  AGlyph.Canvas.CopyRect(Rect(ToolIconSize, 0, ToolIconSize * 2, ToolIconSize),
                         AStrip.Canvas,
                         Rect(SrcLeft, ToolIconSize, SrcLeft + ToolIconSize, ToolIconSize * 2));
  Result := True;
end;

procedure TForm1.SetToolIcon(ABtn: TControl; AIconIdx: Integer;
                             ALightStrip, ADarkStrip: TBitmap);
var
  Mark: TUiGlyph;
  Index: Integer;
begin
  if ABtn = nil then
    Exit;
  // Прежние значки кнопки (исходный и перевёрнутый) больше не нужны
  for Index := ABtn.ComponentCount - 1 downto 0 do
    if ABtn.Components[Index] is TUiGlyph then
      ABtn.Components[Index].Free;

  Mark := TUiGlyph.Create(ABtn);
  if not CutToolIcon(ALightStrip, AIconIdx, Mark.Orig) then
  begin
    Mark.Free;
    // Лента короче, чем ждёт кнопка - лучше сказать об этом прямо
    ABtn.Hint := Format('В ленте значков нет номера %d', [AIconIdx]);
    Exit;
  end;
  // Нет тёмной ленты - Dark пустой, и UiApplyGlyph построит его сам
  // переворотом яркости, как у остальных кнопок
  if not CutToolIcon(ADarkStrip, AIconIdx, Mark.Dark) then
    Mark.Dark.Assign(nil);
  Mark.IsDark := False;
  SetBtnGlyph(ABtn, Mark.Orig);   // два значка рядом - NumGlyphs = 2
  UiApplyGlyph(ABtn);   // в IDE Dark - сразу тёмный
end;

procedure TForm1.UiApplyForm(AForm: TCustomForm);
begin
  if AForm = nil then
    Exit;
  if (FDesigner <> nil) and (AForm = FDesigner.Form) then
    Exit;
  UiPaintTree(AForm);
end;

procedure TForm1.UiPaintTree(C: TControl);
var
  I: Integer;
begin
  UiPaintControl(C);
  if C is TWinControl then
    for I := 0 to TWinControl(C).ControlCount - 1 do
      UiPaintTree(TWinControl(C).Controls[I]);
end;

type
  // Доступ к защищённым Color и Font у TControl, FixedColor у таблицы
  TUiCtl = class(TControl);
  TUiGrid = class(TCustomGrid);
  // ParentBackground у элемента
  TUiWin = class(TWinControl);
  // Метка на элементе: ParentBackground ему выключили для IDE Dark. По ней
  // в IDE Light его возвращают - только тем, кому выключали. Принадлежит
  // самому элементу.
  TUiBgMark = class(TComponent);

  // Фон темы Windows у элемента (ParentBackground): в IDE Dark - выключен,
  // элемент рисует свой цвет (роль); в IDE Light - возвращён тем, у кого был.
  // Лист TPageControl, рамка с подписью, флажок, панель с ParentBackground
  // рисуют фон вкладки из темы - белый, и цвет роли на них не виден.
procedure UiSetParentBg(AC: TWinControl; ADark: Boolean);
var
  K: Integer;
  M: TComponent;
begin
  M := nil;
  for K := 0 to AC.ComponentCount - 1 do
    if AC.Components[K] is TUiBgMark then
    begin
      M := AC.Components[K];
      Break;
    end;
  if ADark then
  begin
    if TUiWin(AC).ParentBackground then
    begin
      TUiWin(AC).ParentBackground := False;
      if M = nil then
        TUiBgMark.Create(AC);
    end;
  end
  else if M <> nil then
  begin
    TUiWin(AC).ParentBackground := True;
    M.Free;
  end;
end;

// Цвет роли элементу. Меняется только цвет, который стоит по умолчанию
// (системный: clBtnFace, clWindow, clWindowText), цвет роли в другом
// режиме или поставленный нами раньше. Свой цвет, который элементу задал код
// (жёлтое поле темы, салатовая подсветка), остаётся.
procedure TForm1.UiPaintControl(C: TControl);
var
  LS: TUiListScroll;
begin
  if (C = nil) or (FUiLight = nil) or (FUiDark = nil) then
    Exit;

  // Редактор и то, что красится цветами редактора или само
  if (C = RichEdit1) or (C = Panel1) or (C = FTabs) or (C = FDeclPanel) or
     (C = FBusyPanel) or ((C = FSubLabel) and (FSubLabel <> nil)) then
    Exit;
  // Просмотр по формату: цвета свои (страница, белый лист RTF), полосы
  // прокрутки - свои у браузера и RichEdit
  if FmtIsViewControl(C) then
    Exit;

  // Значок кнопки - под светлый фон; в IDE Dark - тёмный значок (свой, из
  // ленты, или с перевёрнутой яркостью). TUiIconButton фон и выделение
  // рисует сама - по родителю и теме.
  if (C is TSpeedButton) or (C is TUiIconButton) then
  begin
    UiApplyGlyph(TControl(C));
    Exit;
  end;

  // Главное окно: цвет в .dfm свой - в IDE Light возвращается он
  if C = Self then
  begin
    UiSetParentBgFor(C);
    if FIdeDark then
      Color := UiColor('Ide.WindowBG')
    else
      Color := FFormLightColor;
    Exit;
  end;

  UiPaintColors(C);

  // Линии сетки таблицы - свои, своим цветом
  if C is TListView then
    UiListGrid(TListView(C));

  // Свои полосы прокрутки поверх полос Windows: у списков, деревьев,
  // таблиц, логов и полей, прокручиваемых панелей. Один раз на элемент;
  // цвета - при каждом проходе. Пока полос у элемента нет, наши скрыты.
  if ((C is TCustomTreeView) or (C is TCustomListView) or
      (C is TCustomListBox) or (C is TCustomGrid) or
      (C is TCustomMemo) or (C is TScrollBox)) and
     (TWinControl(C).Parent <> nil) then
  begin
    // Цвета полос - по теме (UiTheme)
    LS := UiScrollFind(TWinControl(C));
    if LS = nil then
      LS := TUiListScroll.Attach(TWinControl(C));
  end;
end;

// Фон темы Windows (ParentBackground) у оконного элемента, кроме самих
// окон: в IDE Dark выключен, в IDE Light возвращается тем, у кого его
// выключили (UiSetParentBg)
procedure TForm1.UiSetParentBgFor(C: TControl);
begin
  if (C is TWinControl) and not (C is TCustomForm) then
    UiSetParentBg(TWinControl(C), FIdeDark);
end;

// Цвета роли элементу: фон, текст, шапка таблицы - по классу. Общее для
// окон программы (UiPaintControl) и формы в конструкторе (DsgThemeLook).
// Меняется только цвет, который стоит по умолчанию (системный: clBtnFace,
// clWindow, clWindowText), цвет роли в другом режиме или поставленный нами
// раньше. Свой цвет, который элементу задал код или .dfm (жёлтое поле
// темы, салатовая подсветка), остаётся.
// Системные цвета, которые тема IDE считает «цветом по умолчанию» и
// заменяет цветом роли (UiPaintColors). Любой другой цвет - свой цвет
// элемента, тема его не трогает. Тот же список - в ObjCodeProps: разница
// снимка и .dfm по такому цвету - от темы, а не от кода.
const
  UiThemeBgSys: array[0..2] of TColor = (clBtnFace, clWindow, TColor($00F0F0F0));
  UiThemeFgSys: array[0..2] of TColor = (clWindowText, clBtnText, clBlack);

  // Значение цвета из .dfm (clBtnFace, $00F0F0F0, 15790320) - одно из ASys
function UiThemeSysColor(const AValue: string;
                         const ASys: array of TColor): Boolean;
var
  ColorVal: Longint;
  SysIdx: Integer;
begin
  Result := False;
  if not IdentToColor(Trim(AValue), ColorVal) and
     not TryStrToInt(Trim(AValue), ColorVal) then
    Exit;
  for SysIdx := Low(ASys) to High(ASys) do
    if TColor(ColorVal) = ASys[SysIdx] then
    begin
      Result := True;
      Exit;
    end;
end;

procedure TForm1.UiPaintColors(C: TControl);
var
  BgKey, FgKey: string;
  Cur: TColor;

  function IsOurs(AColor: TColor; const AKey: string;
                  const ASys: array of TColor): Boolean;
  var
    K: Integer;
  begin
    Result := True;
    for K := Low(ASys) to High(ASys) do
      if AColor = ASys[K] then
        Exit;
    if (ColorToString(AColor) = FUiLight.Values[AKey]) or
       (ColorToString(AColor) = FUiDark.Values[AKey]) or
       (ColorToString(AColor) = FUiApplied.Values[AKey]) then
      Exit;
    Result := False;
  end;

  procedure SetBg(const AKey: string; const ASys: array of TColor);
  var
    NewC: TColor;
  begin
    Cur := TUiCtl(C).Color;
    if not IsOurs(Cur, AKey, ASys) then
    begin
      if AKey = 'Ide.ListBG' then
        UiBgNote(C, 'цвет ' + ColorToString(Cur) + ' не свой, не меняется ' +
        '(светлый ' + FUiLight.Values[AKey] + ', тёмный ' +
                 FUiDark.Values[AKey] + ', прежний ' +
                 FUiApplied.Values[AKey] + ')');
      Exit;
    end;
    NewC := UiColor(AKey);
    if AKey = 'Ide.ListBG' then
      UiBgNote(C, ColorToString(Cur) + ' -> ' + ColorToString(NewC));
    if Cur <> NewC then
      TUiCtl(C).Color := NewC;
  end;

  procedure SetFg(const AKey: string);
  var
    NewC: TColor;
  begin
    Cur := TUiCtl(C).Font.Color;
    if not IsOurs(Cur, AKey, UiThemeFgSys) then
      Exit;
    NewC := UiColor(AKey);
    if Cur <> NewC then
      TUiCtl(C).Font.Color := NewC;
  end;

begin
  if (C = nil) or (FUiLight = nil) or (FUiDark = nil) then
    Exit;
  if FUiApplied = nil then
    FUiApplied := TStringList.Create;

  UiSetParentBgFor(C);

  BgKey := '';
  FgKey := '';
  if C is TCustomRichEdit then
    BgKey := 'Ide.LogBG'
  else if (C is TCustomTreeView) or (C is TCustomListView) or
          (C is TCustomListBox) or (C is TCustomGrid) then
  begin
    BgKey := 'Ide.ListBG';
    FgKey := 'Ide.ListText';
  end
  else if (C is TCustomEdit) or (C is TCustomComboBox) then
  begin
    BgKey := 'Ide.EditBG';
    FgKey := 'Ide.EditText';
  end
  else if (C is TCustomForm) or (C is TCustomPanel) or
          (C is TCustomGroupBox) or (C is TTabSheet) or
          (C is TScrollingWinControl) or (C is TSplitter) or
          (C is TCustomLabel) or (C is TCustomCheckBox) or
          (C is TRadioButton) then
  begin
    BgKey := 'Ide.WindowBG';
    FgKey := 'Ide.WindowText';
  end;

  if BgKey <> '' then
    SetBg(BgKey, UiThemeBgSys);
  if FgKey <> '' then
    SetFg(FgKey);

  // Шапка и первая колонка таблицы - цветом окна
  if C is TCustomGrid then
  begin
    Cur := TUiGrid(C).FixedColor;
    if IsOurs(Cur, 'Ide.WindowBG', [clBtnFace, TColor($00F0F0F0)]) then
      TUiGrid(C).FixedColor := UiColor('Ide.WindowBG');
  end;
end;

// Имя таблицы для журнала: своё или имя родителя
function UiCtlName(C: TControl): string;
begin
  Result := C.Name;
  if (Result = '') and (C.Parent <> nil) then
    Result := C.ClassName + ' в ' + C.Parent.Name + ':' + C.Parent.ClassName
  else if Result = '' then
    Result := C.ClassName;
end;

type
  // Метка на таблице (TListView), сетку которой рисуем сами; Color - цвет,
  // которым она нарисована. Перехватывает NM_CUSTOMDRAW таблицы (CN_NOTIFY
  // через WindowProc) и сама просит у Windows стадию "после строки": события
  // VCL OnAdvancedCustomDraw* стадию cdPostPaint не получали (HiLite log:
  // приходила только стадия 0).
  TUiGridMark = class(TComponent)
  public
    Color: TColor;
    LV: TListView;
    OldProc: TWndMethod;
    procedure WndProc(var Msg: TMessage);
    procedure DrawLines(DC: HDC; AItem, ASub: Integer; ACell: Boolean);
  end;

  // NMLVCUSTOMDRAW (commctrl.h) - свои имена, чтобы не подключать CommCtrl
  PUiLVCustomDraw = ^TUiLVCustomDraw;
  TUiLVCustomDraw = record
    Hdr: TNMHdr;
    DrawStage: DWORD;
    DC: HDC;
    Rc: TRect;
    ItemSpec: DWORD;
    ItemState: UINT;
    ItemlParam: LPARAM;
    ClrText: COLORREF;
    ClrTextBk: COLORREF;
    SubItem: Integer;
  end;

const
  UiNM_CUSTOMDRAW        = -12;
  UiCDDS_PREPAINT        = $00000001;
  UiCDDS_SUBITEM         = $00020000;
  UiCDDS_ITEMPREPAINT    = $00010001;
  UiCDDS_ITEMPOSTPAINT   = $00010002;
  UiCDRF_DODEFAULT       = $00000000;
  UiCDRF_SKIPDEFAULT     = $00000004;
  UiCDRF_NOTIFYPOSTPAINT = $00000010;
  UiCDRF_NOTIFYITEMDRAW  = $00000020;
  UiLVM_GETITEMRECT      = $1000 + 14;
  UiLVM_GETSUBITEMRECT   = $1000 + 56;
  UiLVIR_BOUNDS          = 0;

procedure TUiGridMark.WndProc(var Msg: TMessage);
var
  CD: PUiLVCustomDraw;
  Stage: DWORD;
begin
  if (Msg.Msg <> CN_NOTIFY) or
     (TWMNotify(Msg).NMHdr^.code <> UiNM_CUSTOMDRAW) then
  begin
    OldProc(Msg);
    Exit;
  end;
  CD := PUiLVCustomDraw(TWMNotify(Msg).NMHdr);
  Stage := CD^.DrawStage;
  if (Stage and not DWORD(UiCDDS_SUBITEM)) = UiCDDS_ITEMPOSTPAINT then
  begin
    // Стадию "после" запросили мы, VCL её не ждёт - ему не отдаём
    DrawLines(CD^.DC, Integer(CD^.ItemSpec), CD^.SubItem,
              Stage and UiCDDS_SUBITEM <> 0);
    // Таблица свойств: вторая половина ячейки значения (хэндл Parent)
    if Form1 <> nil then
      Form1.ObjPropsPostPaint(LV, CD^.DC, Integer(CD^.ItemSpec));
    Msg.Result := UiCDRF_DODEFAULT;
  end
  else
  begin
    OldProc(Msg);
    if Msg.Result and UiCDRF_SKIPDEFAULT = 0 then
    begin
      if Stage = UiCDDS_PREPAINT then
        Msg.Result := Msg.Result or UiCDRF_NOTIFYITEMDRAW
      else if (Stage and not DWORD(UiCDDS_SUBITEM)) = UiCDDS_ITEMPREPAINT then
        Msg.Result := Msg.Result or UiCDRF_NOTIFYPOSTPAINT;
    end;
  end;
  // В лог - каждое новое сочетание стадии и ответа по таблице, один раз
  if Form1 <> nil then
    Form1.UiGridNote(LV, 'NM_CUSTOMDRAW, стадия $' + IntToHex(Stage, 8) +
    ', ответ $' + IntToHex(Msg.Result, 8));
end;

// ACell: ячейка ASub - линии снизу и справа от неё; иначе строка целиком -
// снизу и на границах колонок. Ячейка 0 - первая колонка: её прямоугольник -
// от начала строки на ширину колонки.
procedure TUiGridMark.DrawLines(DC: HDC; AItem, ASub: Integer; ACell: Boolean);
var
  R: TRect;
  X, I: Integer;
  Pen, OldPen: HPEN;
begin
  FillChar(R, SizeOf(R), 0);
  R.Left := UiLVIR_BOUNDS;
  if ACell and (ASub > 0) then
  begin
    R.Top := ASub;
    if SendMessage(LV.Handle, UiLVM_GETSUBITEMRECT, AItem, Integer(@R)) = 0 then
    begin
      if Form1 <> nil then
        Form1.UiGridNote(LV, 'линии: LVM_GETSUBITEMRECT вернул 0');
      Exit;
    end;
  end
  else if SendMessage(LV.Handle, UiLVM_GETITEMRECT, AItem, Integer(@R)) = 0 then
  begin
    if Form1 <> nil then
      Form1.UiGridNote(LV, 'линии: LVM_GETITEMRECT вернул 0');
    Exit;
  end;
  Pen := CreatePen(PS_SOLID, 1, ColorToRGB(Color));
  OldPen := SelectObject(DC, Pen);
  try
    if ACell then
    begin
      if (ASub <= 0) and (LV.Columns.Count > 0) then
        R.Right := R.Left + LV.Columns[0].Width;
      MoveToEx(DC, R.Left, R.Bottom - 1, nil);
      Windows.LineTo(DC, R.Right, R.Bottom - 1);
      MoveToEx(DC, R.Right - 1, R.Top, nil);
      Windows.LineTo(DC, R.Right - 1, R.Bottom);
    end
    else
    begin
      MoveToEx(DC, R.Left, R.Bottom - 1, nil);
      Windows.LineTo(DC, R.Right, R.Bottom - 1);
      X := R.Left;
      for I := 0 to LV.Columns.Count - 1 do
      begin
        Inc(X, LV.Columns[I].Width);
        MoveToEx(DC, X - 1, R.Top, nil);
        Windows.LineTo(DC, X - 1, R.Bottom);
      end;
    end;
  finally
    SelectObject(DC, OldPen);
    DeleteObject(Pen);
  end;
  if Form1 <> nil then
    if ACell then
      Form1.UiGridNote(LV, 'линии нарисованы (ячейка)')
    else
      Form1.UiGridNote(LV, 'линии нарисованы (строка)');
end;

// Таблица с линиями сетки (GridLines): их рисует Windows цветом системы, на
// тёмном фоне они слишком яркие и цвет им не задать. Сетка Windows
// выключается, линии рисует TUiGridMark после строки/ячейки цветом
// Grid.Lines. Один раз на таблицу; метка - TUiGridMark, её владелец -
// таблица.
procedure TForm1.UiListGrid(ALV: TListView);
var
  K: Integer;
  M: TUiGridMark;
begin
  M := nil;
  for K := 0 to ALV.ComponentCount - 1 do
    if ALV.Components[K] is TUiGridMark then
      M := TUiGridMark(ALV.Components[K]);
  if M = nil then
  begin
    // Сетку таблица не хочет или рисует строки сама - не трогаем (круг
    // таблиц тот же, что был с событиями OnAdvancedCustomDraw*)
    if not ALV.GridLines or Assigned(ALV.OnAdvancedCustomDrawItem) or
       Assigned(ALV.OnAdvancedCustomDrawSubItem) then
      Exit;
    M := TUiGridMark.Create(ALV);
    M.Color := clNone;
    M.LV := ALV;
    M.OldProc := ALV.WindowProc;
    ALV.WindowProc := M.WndProc;
    ALV.GridLines := False;
    Dbg('3187: сетка: таблица ' + UiCtlName(ALV) + ' - сетка Windows ' +
    'выключена, перехват NM_CUSTOMDRAW назначен', clNavy);
  end;
  // Перерисовать - только если цвет линий сменился
  if M.Color <> UiColor('Grid.Lines') then
  begin
    M.Color := UiColor('Grid.Lines');
    ALV.Invalidate;
  end;
end;

// Запись в лог о событии отрисовки таблицы - по одному разу на таблицу и
// текст события
procedure TForm1.UiGridNote(Sender: TCustomListView; const AWhat: string);
var
  Key: string;
begin
  if FUiGridSeen = nil then
  begin
    FUiGridSeen := TStringList.Create;
    // Зовётся на каждой ячейке (NM_CUSTOMDRAW) - поиск двоичный
    FUiGridSeen.Sorted := True;
  end;
  Key := IntToHex(Integer(Sender), 8) + ' ' + AWhat;
  if FUiGridSeen.IndexOf(Key) >= 0 then
    Exit;
  FUiGridSeen.Add(Key);
  Dbg('3210: сетка: ' + UiCtlName(Sender) + ' - ' + AWhat, clNavy);
end;

// Окно стало активным (диалог, окно, созданное позже) - цвета IDE ему
procedure TForm1.UiActiveFormChange(Sender: TObject);
begin
  if FIdeDark or (FUiApplied <> nil) then
    UiApplyForm(Screen.ActiveForm);
  // Шрифт окон и панелей - и окнам, созданным после его выбора
  UiFormFontApply(Screen.ActiveForm);
end;

// Все видимые окна программы (и форма конструктора): AFreeze = True -
// перестают рисоваться (WM_SETREDRAW), False - рисуются снова, сразу
// целиком, со всеми вложенными окнами и рамками. Вызовы вкладываются
// (ApplyIdeMode вокруг UiApply): окна оживают на последнем False.
procedure TForm1.UiFreezeForms(AFreeze: Boolean);
var
  I: Integer;
  F: TCustomForm;
begin
  if AFreeze then
  begin
    Inc(FUiFreeze);
    if FUiFreeze > 1 then
      Exit;
    // Список свойств инспектора на время перекраски спрятан: он рисуется
    // дольше всего остального (строка за строкой, с линиями сетки), и при
    // общей перерисовке его фон менялся первым, а остальное окно - после.
    // Показывается, когда всё остальное уже нарисовано.
    FUiRightHidden := (FObjProps <> nil) and FObjProps.Visible;
    if FUiRightHidden then
      FObjProps.Visible := False;
  end
  else
  begin
    if FUiFreeze > 0 then
      Dec(FUiFreeze);
    if FUiFreeze > 0 then
      Exit;
  end;
  for I := 0 to Screen.FormCount - 1 do
  begin
    F := Screen.Forms[I];
    if not F.Visible or not F.HandleAllocated then
      Continue;
    if AFreeze then
      SendMessage(F.Handle, WM_SETREDRAW, 0, 0)
    else
    begin
      SendMessage(F.Handle, WM_SETREDRAW, 1, 0);
      // При запуске главное окно ещё прозрачное, и его целиком рисует
      // WMStartupFinish - здесь только помечаем к перерисовке
      if StartupActive then
        RedrawWindow(F.Handle, nil, 0, RDW_ERASE or RDW_FRAME or
                     RDW_INVALIDATE or RDW_ALLCHILDREN)
      else
        RedrawWindow(F.Handle, nil, 0, RDW_ERASE or RDW_FRAME or
                     RDW_INVALIDATE or RDW_ALLCHILDREN or RDW_UPDATENOW);
    end;
  end;
  // Список свойств - последним, когда окно уже в новых цветах
  if not AFreeze and FUiRightHidden then
  begin
    FUiRightHidden := False;
    FObjProps.Visible := True;
    FObjProps.Update;
  end;
end;

procedure TForm1.ApplyIdeMode(AMode: Integer; const ACustom: string);
var
  StartTick, StageTick, TFill, TApply: Cardinal;
begin
  StartTick := GetTickCount;
  if (AMode = IdeModeCustom) and (UiCustomSet(ACustom) = nil) then
    AMode := IdeModeDark;       // такой своей темы нет
  FIdeMode := AMode;
  if AMode = IdeModeCustom then
    FIdeCustom := ACustom
  else
    FIdeCustom := '';
  FIdeDark := FIdeMode <> IdeModeLight;
  // Перекраска - без показа по ходу: окна не рисуются, пока тема не
  // поставлена всем элементам, затем каждое окно рисуется один раз целиком.
  // Иначе элементы меняли цвет по очереди, по мере прохода, и окно моргало.
  UiFreezeForms(True);
  try
    StageTick := GetTickCount;
    UiFillColors;
    TFill := GetTickCount - StageTick;
    StageTick := GetTickCount;
    UiApply;
    TApply := GetTickCount - StageTick;
  finally
    UiFreezeForms(False);
  end;
  RichEdit1.Invalidate;
  if PaintBox1 <> nil then
    PaintBox1.Invalidate;
  // Время по частям - чтобы было видно, что ускорять
  case FIdeMode of
    IdeModeDark: Dbg(Format('IDE Dark - %d мс: цвета %d, перекраска окон %d',
                            [GetTickCount - StartTick, TFill, TApply]), clNavy);
    IdeModeCustom: Dbg(Format('IDE Custom: %s - %d мс: цвета %d, ' +
    'перекраска окон %d',
                              [FIdeCustom, GetTickCount - StartTick, TFill, TApply]),
                       clNavy);
  else
    Dbg(Format('IDE Light - %d мс: цвета %d, перекраска окон %d',
               [GetTickCount - StartTick, TFill, TApply]), clNavy);
  end;
end;
procedure TForm1.SaveUiSchema;
var
  SL, L: TStringList;
  I, J: Integer;
  Key, Val: string;
begin
  if (FUiLight = nil) or (FUiDark = nil) or (FUiDarkDef = nil) then
    Exit;
  SL := TStringList.Create;
  try
    SL.Add('; Цвета IDE. Ключ=цвет - IDE Light, Ключ@IdeDark=цвет - IDE Dark,');
    SL.Add('; Ключ@Ide:Имя=цвет - своя тема IDE с этим именем');
    for I := 0 to FUiLight.Count - 1 do
      SL.Add(FUiLight[I]);
    // Тёмные - только отличные от умолчания: так новые умолчания программы
    // доходят и до тех, кто их не менял
    for I := 0 to FUiDark.Count - 1 do
    begin
      Key := FUiDark.Names[I];
      Val := Copy(FUiDark[I], Length(Key) + 2, MaxInt);
      if Val <> FUiDarkDef.Values[Key] then
        SL.Add(Key + '@IdeDark=' + Val);
    end;
    // Свои темы - все цвета, под своим именем
    if FUiCustom <> nil then
      for J := 0 to FUiCustom.Count - 1 do
      begin
        L := TStringList(FUiCustom.Objects[J]);
        for I := 0 to L.Count - 1 do
        begin
          Key := L.Names[I];
          Val := Copy(L[I], Length(Key) + 2, MaxInt);
          SL.Add(Key + '@Ide:' + FUiCustom[J] + '=' + Val);
        end;
      end;
    if FUiExtra <> nil then
      for I := 0 to FUiExtra.Count - 1 do
        SL.Add(FUiExtra[I]);
    SL.SaveToFile(UiSchemaFileName);
  except
    // не записалось - не беда, останутся умолчания
  end;
  SL.Free;
end;
// ---------------------------------------------------------------------------
//  Темы
//
//  Тема - набор цветов под одним именем ([Themes] Current в editor.ini, список
//  тем - там же, его ведёт окно настроек). Цвета без @ - основная тема
//  (BaseThemeName); для другой темы рядом лежат цвета с @Тема:
//    схемы подсветки *.clr  - строки Раздел@Тема (ClrScheme);
//    цвета самой IDE, IDE.clr - не по теме, а по режиму IDE Light / IDE
//                             Dark: Ключ=цвет и Ключ@IdeDark=цвет;
//    editor.ini, [Editor]   - FontColor@Тема, BGColor@Тема, GutterFG@Тема,
//                             GutterBG@Тема.
//  Чего у темы нет - берётся основное. Правка под темой пишется в её @-цвета,
//  основные цвета при этом не меняются.
// ---------------------------------------------------------------------------

// Выбранная тема - при запуске, до чтения цветов IDE и схем
procedure TForm1.ReadThemeSetting;
var
  Ini: TIniFile;
  S: string;
begin
  FThemeName := BaseThemeName;
  if FileExists(SettingsFileName) then
  begin
    Ini := TIniFile.Create(SettingsFileName);
    try
      FThemeName := Trim(Ini.ReadString('Themes', 'Current', BaseThemeName));
      // Режим IDE - цвета самой IDE, отдельно от темы редактора: Light,
      // Dark или Custom со своей темой ([Themes] IdeCustom). Есть ли такая
      // своя тема, проверит LoadUiSchema.
      S := Trim(Ini.ReadString('Themes', 'Mode', 'Light'));
      if CompareText(S, 'Dark') = 0 then
        FIdeMode := IdeModeDark
      else if CompareText(S, 'Custom') = 0 then
        FIdeMode := IdeModeCustom
      else
        FIdeMode := IdeModeLight;
      FIdeCustom := Trim(Ini.ReadString('Themes', 'IdeCustom', ''));
      FIdeDark := FIdeMode <> IdeModeLight;
    finally
      Ini.Free;
    end;
  end;
  if FThemeName = '' then
    FThemeName := BaseThemeName;
  FScheme.FTheme := ThemeKey(FThemeName);
end;

// Значение editor.ini с учётом темы: Ключ@Тема, если он есть, иначе Ключ
function TForm1.ThemeIniRead(Ini: TCustomIniFile; const ASect, AKey,
                             ADef: string): string;
begin
  Result := Ini.ReadString(ASect, AKey, ADef);
  if FScheme.FTheme <> '' then
    Result := Ini.ReadString(ASect, AKey + '@' + FScheme.FTheme, Result);
end;

// Запись с учётом темы: основная тема - в Ключ; другая - в Ключ@Тема, если
// значение отличается от основного или такой ключ уже есть. Основной ключ
// под другой темой не трогаем.
procedure TForm1.ThemeIniWrite(Ini: TCustomIniFile; const ASect, AKey,
                               AVal: string);
var
  TK: string;
begin
  if FScheme.FTheme = '' then
    Ini.WriteString(ASect, AKey, AVal)
  else
  begin
    TK := AKey + '@' + FScheme.FTheme;
    if Ini.ValueExists(ASect, TK) or
       (AVal <> Ini.ReadString(ASect, AKey, '')) then
      Ini.WriteString(ASect, TK, AVal);
  end;
end;

// Цвета редактора из editor.ini: текст, фон пустого места, полоса номеров.
// Перекрываются разделом Text схемы; здесь - для схемы без этого раздела и
// для файла без схемы.
procedure TForm1.ReadThemeColors(Ini: TIniFile);
begin
  FIniFontColor := StringToColor(ThemeIniRead(Ini, 'Editor', 'FontColor',
                                              ColorToString(FIniFontColor)));
  FIniBGColor := StringToColor(ThemeIniRead(Ini, 'Editor', 'BGColor',
                                            ColorToString(FIniBGColor)));
  SetEditorFontColor(FIniFontColor);
  RichEdit1.Color := FIniBGColor;
  FScheme.FTextBG := FIniBGColor;
  // Зазор между номерами строк и текстом - цветом пустого места редактора
  if Panel1 <> nil then
    Panel1.Color := FIniBGColor;
  FGutterFG := StringToColor(ThemeIniRead(Ini, 'Editor', 'GutterFG',
                                          ColorToString(FGutterFG)));
  FGutterBG := StringToColor(ThemeIniRead(Ini, 'Editor', 'GutterBG',
                                          ColorToString(FGutterBG)));
  // Нашлись ли в editor.ini цвета выбранной темы - в HiLite log
  if FScheme.FTheme <> '' then
    if Ini.ValueExists('Editor', 'BGColor@' + FScheme.FTheme) then
      Dbg('3305: editor.ini: тема ' + FScheme.FTheme + ', фон ' +
          ColorToString(FIniBGColor) + ', текст ' + ColorToString(FIniFontColor),
          clNavy)
    else
      Dbg('3309: editor.ini: тема ' + FScheme.FTheme + ' - ключа BGColor@' +
          FScheme.FTheme + ' в [Editor] нет, цвета основные', clNavy);
end;

// Цвета выбранной темы - поверх только что прочитанной схемы. Раздел Text
// задаёт и цвет шрифта редактора.
procedure TForm1.ApplySchemeTheme;
var
  N: Integer;
begin
  N := FScheme.ApplyTheme;
  if FScheme.FSchemaHasText then
    SetEditorFontColor(FScheme.FTextFG);
  // Какая тема и сколько её цветов нашлось в схеме - в HiLite log
  if FScheme.FTheme = '' then
    Dbg('3324: схема: основная тема (' + BaseThemeName + ')', clNavy)
  else
    Dbg('3326: схема: тема ' + FScheme.FTheme + ', разделов с её цветами ' +
        IntToStr(N) + ' из ' + IntToStr(FScheme.FThemeColors.Count) +
    ' строк тем в файлах', clNavy);
end;

procedure TForm1.ApplyTheme(const AName: string);
var
  Ini: TIniFile;
  WasMod, RedrawOff: Boolean;
  OldCursor: TCursor;
  StartTick, StageTick, TColors, TMaps, TSchema, TDesigner: Cardinal;
  OldMarkers: string;
begin
  FThemeName := Trim(AName);
  if FThemeName = '' then
    FThemeName := BaseThemeName;
  FScheme.FTheme := ThemeKey(FThemeName);

  // Часы - один раз на всю смену, а не по кускам: снимок формы для
  // конструктора (TakeOwnSnap) ставил и снимал свои, курсор мигал.
  // Редактор на это время не перерисовывается (WM_SETREDRAW): цвета
  // шрифта, фона и схемы меняются по очереди, и каждая перерисовка
  // показывала промежуточную смесь - экран моргал.
  OldCursor := Screen.Cursor;
  Screen.Cursor := crHourGlass;
  RedrawOff := RichEdit1.HandleAllocated;
  if RedrawOff then
    SendMessage(RichEdit1.Handle, WM_SETREDRAW, 0, 0);
  StartTick := GetTickCount;
  TDesigner := 0;
  try
    // Цвета редактора из editor.ini. Смена цвета шрифта взводит Modified -
    // текст от этого изменённым не стал.
    StageTick := GetTickCount;
    WasMod := RichEdit1.Modified;
    if FileExists(SettingsFileName) then
    begin
      Ini := TIniFile.Create(SettingsFileName);
      try
        ReadThemeColors(Ini);
      finally
        Ini.Free;
      end;
    end;
    RichEdit1.Modified := WasMod;
    TColors := GetTickCount - StageTick;

    // Схема активной вкладки - с цветами темы; остальные вкладки возьмут
    // её при переходе на них
    StageTick := GetTickCount;
    OldMarkers := FScheme.MarkersSig;
    ReloadActiveClrSchema;
    TSchema := GetTickCount - StageTick;
    // Карты других вкладок зависят только от маркеров комментариев и
    // строк. Тема меняет цвета - карты годятся; иначе каждая вкладка
    // разбиралась бы заново при переходе на неё.
    StageTick := GetTickCount;
    if FScheme.MarkersSig <> OldMarkers then
      InvalidateAllWindowMaps;
    TMaps := GetTickCount - StageTick;
  finally
    if RedrawOff then
    begin
      SendMessage(RichEdit1.Handle, WM_SETREDRAW, 1, 0);
      InvalidateRect(RichEdit1.Handle, nil, True);
    end;
    if PaintBox1 <> nil then
      PaintBox1.Invalidate;
  end;

  try
    // Своя форма в конструкторе в живом виде: у редактора на ней
    // (RichEdit1 и то, что красится цветами редактора) - новые цвета, по
    // свежему снимку. Как после смены режима IDE (ApplyIdeMode): на месте,
    // без перестройки.
    StageTick := GetTickCount;
    if (FDesigner <> nil) and (FDesigner.Form <> nil) and IsOwnProject and
       (OwnLiveForm(FObjFormClass) <> nil) then
      DsgRetheme;
    TDesigner := GetTickCount - StageTick;
  finally
    Screen.Cursor := OldCursor;
  end;

  // Сколько заняла каждая часть - чтобы было видно, что ускорять
  Dbg(Format('3361: тема %s - %d мс: цвета редактора %d, карты вкладок %d, ' +
  'схема %d, конструктор %d',
             [FThemeName, GetTickCount - StartTick, TColors, TMaps, TSchema,
             TDesigner]), clNavy);
  // Текст второй панели - цветами новой темы
  SplitRefresh(-1);
end;

procedure TForm1.LoadSettings;
var
  Ini: TIniFile;
  K: Integer;
  S: string;
  WasMod: Boolean;
begin
  if not FileExists(SettingsFileName) then
    Exit; // первый запуск - остаёмся на значениях из FormCreate

  Ini := TIniFile.Create(SettingsFileName);
  try
    FUseHotTab          := Ini.ReadBool('Editor', 'HotTabHighlight', FUseHotTab);
    FUseSyntaxHighlight := Ini.ReadBool('Editor', 'SyntaxHighlight', FUseSyntaxHighlight);
    RestoreFormBounds(Ini);
    FTabChars           := Ini.ReadInteger('Editor', 'TabChars', FTabChars);
    FShowSpaces         := Ini.ReadBool('Editor', 'ShowSpaces', FShowSpaces);
    FIndentKind         := Ini.ReadInteger('Editor', 'IndentKind', FIndentKind);
    if (FIndentKind < IndentSpaces) or (FIndentKind > IndentNone) then
      FIndentKind := IndentSpaces;
    FIndentSize         := Ini.ReadInteger('Editor', 'IndentSize', FIndentSize);
    if FIndentSize < 1 then
      FIndentSize := 2;
    // Ширина правой панели. Значение из файла проверяем: в editor.ini от
    // прежних сборок мог остаться 0, и панель была бы не видна.
    FRightPanelWidth    := Ini.ReadInteger('Editor', 'RightPanelWidth',
                                           FRightPanelWidth);
    if FRightPanelWidth < RightPanelMinWidth then
      FRightPanelWidth := RightPanelDefWidth;
    if (FRightPanel <> nil) and
       (FRightPanelWidth < ClientWidth - RightPanelMinLeft) then
      FRightPanel.Width := FRightPanelWidth;
    FRightStartCollapsed := Ini.ReadBool('Editor', 'RightPanelCollapsed',
                                         False);
    FHotTabBarWidth     := Ini.ReadInteger('Editor', 'HotTabBarWidth', FHotTabBarWidth);
    FHotTabPale         := Ini.ReadInteger('Editor', 'HotTabPale', FHotTabPale);
    FStartupProject     := Ini.ReadString('Editor', 'LastProject', '');

    // Шрифт редактора ОБЩИЙ для всех языков и живёт здесь, а не в .clr:
    // одна и та же гарнитура для .pas и .bas - это свойство рабочего места,
    // а не цветовой схемы. В схеме остались только цвета.
    //
    // Modified запоминаем по той же причине, что и в ApplyEditorLook:
    // присваивание шрифта переписывает форматирование всего текста.
    WasMod := RichEdit1.Modified;
    RichEdit1.Font.Name := Ini.ReadString('Editor', 'FontName',
                                          RichEdit1.Font.Name);
    RichEdit1.Font.Size := Ini.ReadInteger('Editor', 'FontSize',
                                           RichEdit1.Font.Size);

    // Базовые цвета: текст и фон редактора. Перекрываются разделом Text
    // схемы; здесь - для схемы без этого раздела и для файла без схемы.
    // Цвета текста, фона и полосы номеров - с учётом темы (ReadThemeColors)
    ReadThemeColors(Ini);
    RichEdit1.Modified := WasMod;

    // Список недавних файлов
    if FRecentFiles <> nil then
    begin
      FRecentFiles.Clear;
      for K := 1 to 9 do
      begin
        S := Ini.ReadString('Recent', 'File' + IntToStr(K), '');
        if S <> '' then
          FRecentFiles.Add(S);
      end;
    end;

    // Горячие папки. Значение ключа - признак галочки и путь через пробел:
    //     Dir1=1 D:\_F\balan
    if FHotFolders <> nil then
    begin
      FHotFolders.Clear;
      K := 1;
      while True do
      begin
        S := Trim(Ini.ReadString('HotFolders', 'Dir' + IntToStr(K), ''));
        if S = '' then
          Break;

        if Copy(S, 1, 2) = '1 ' then
          FHotFolders.AddObject(Copy(S, 3, Length(S)), Self)
        else if Copy(S, 1, 2) = '0 ' then
          FHotFolders.AddObject(Copy(S, 3, Length(S)), nil)
        else
          // Строка без признака - считаем папку отмеченной
          FHotFolders.AddObject(S, Self);

        Inc(K);
      end;
    end;

    if FTabChars < 1 then
      FTabChars := 4;
  finally
    Ini.Free;
  end;
end;

// РАЗМЕР И ПОЛОЖЕНИЕ ГЛАВНОГО ОКНА.
//
// Пишется не Left/Top/Width/Height формы, а rcNormalPosition из
// GetWindowPlacement: у развёрнутого окна свойства формы дают размер во
// весь экран, и при следующем запуске восстанавливать было бы нечего -
// окно навсегда осталось бы «развёрнутым» по своим же координатам.
procedure TForm1.SaveFormBounds(Ini: TCustomIniFile);
var
  WP: TWindowPlacement;
begin
  if not HandleAllocated then
    Exit;

  FillChar(WP, SizeOf(WP), 0);
  WP.Length := SizeOf(WP);
  if not GetWindowPlacement(Handle, @WP) then
    Exit;

  // Свёрнутое окно как положение не запоминаем: восстанавливать программу
  // свёрнутой неудобно, а размер в rcNormalPosition и так верный
  Ini.WriteInteger('MainForm', 'Left', WP.rcNormalPosition.Left);
  Ini.WriteInteger('MainForm', 'Top', WP.rcNormalPosition.Top);
  Ini.WriteInteger('MainForm', 'Width',
                   WP.rcNormalPosition.Right - WP.rcNormalPosition.Left);
  Ini.WriteInteger('MainForm', 'Height',
                   WP.rcNormalPosition.Bottom - WP.rcNormalPosition.Top);
  Ini.WriteBool('MainForm', 'Maximized', WindowState = wsMaximized);
end;

// Обратно. Окно, целиком уехавшее за пределы рабочего стола, не
// восстанавливаем: монитор могли отключить или сменить разрешение, и
// программа запустилась бы там, где её не видно.
procedure TForm1.RestoreFormBounds(Ini: TIniFile);
var
  L, T, W, H: Integer;
  R, Desk, Tmp: TRect;
begin
  W := Ini.ReadInteger('MainForm', 'Width', 0);
  H := Ini.ReadInteger('MainForm', 'Height', 0);
  if (W < 200) or (H < 150) then
    Exit; // записи нет или она бессмысленная - оставляем как есть

  L := Ini.ReadInteger('MainForm', 'Left', Left);
  T := Ini.ReadInteger('MainForm', 'Top', Top);

  R := Rect(L, T, L + W, T + H);
  Desk := Rect(Screen.DesktopLeft, Screen.DesktopTop,
               Screen.DesktopLeft + Screen.DesktopWidth,
               Screen.DesktopTop + Screen.DesktopHeight);
  if not IntersectRect(Tmp, R, Desk) then
    Exit;

  // Заголовок должен остаться доступным мышью
  if T < Screen.DesktopTop then
    T := Screen.DesktopTop;

  //  Position := poDesigned; // иначе VCL сам сдвинет окно при показе
  SetBounds(L, T, W, H);

  if Ini.ReadBool('MainForm', 'Maximized', False) then
    WindowState := wsMaximized;
end;

// editor.ini - одной записью (TBufIniFile): через TIniFile каждый ключ
// переписывал весь файл, а ключей здесь десятки
procedure TForm1.SaveSettings;
var
  Ini: TBufIniFile;
  K: Integer;
begin
  try
    Ini := TBufIniFile.Create(SettingsFileName);
    try
      SaveFormBounds(Ini);
      Ini.WriteBool('Editor', 'HotTabHighlight', FUseHotTab);
      Ini.WriteBool('Editor', 'SyntaxHighlight', FUseSyntaxHighlight);
      Ini.WriteInteger('Editor', 'TabChars', FTabChars);
      Ini.WriteBool('Editor', 'ShowSpaces', FShowSpaces);
      Ini.WriteInteger('Editor', 'IndentKind', FIndentKind);
      Ini.WriteInteger('Editor', 'IndentSize', FIndentSize);
      Ini.WriteInteger('Editor', 'HotTabBarWidth', FHotTabBarWidth);
      Ini.WriteInteger('Editor', 'HotTabPale', FHotTabPale);

      // Шрифт редактора - один на все языки, см. LoadSettings
      Ini.WriteString('Editor', 'FontName', RichEdit1.Font.Name);
      Ini.WriteInteger('Editor', 'FontSize', RichEdit1.Font.Size);
      // Цвета - в ключи выбранной темы (ThemeIniWrite)
      ThemeIniWrite(Ini, 'Editor', 'FontColor', ColorToString(FIniFontColor));
      ThemeIniWrite(Ini, 'Editor', 'BGColor', ColorToString(FIniBGColor));
      ThemeIniWrite(Ini, 'Editor', 'GutterFG', ColorToString(FGutterFG));
      // Ноль в файл не пишем: с ним панель при следующем запуске исчезнет
      if FRightCollapsed then
      begin
        // Свёрнута: ширина - та, к которой вернёт кнопка []
        if FRightPanelWidth >= RightPanelMinWidth then
          Ini.WriteInteger('Editor', 'RightPanelWidth', FRightPanelWidth);
      end
      else if (FRightPanel <> nil) and
         (FRightPanel.Width >= RightPanelMinWidth) then
        Ini.WriteInteger('Editor', 'RightPanelWidth', FRightPanel.Width);
      Ini.WriteBool('Editor', 'RightPanelCollapsed', FRightCollapsed);
      ThemeIniWrite(Ini, 'Editor', 'GutterBG', ColorToString(FGutterBG));

      // Имя проекта пишем на каждое сохранение настроек, поэтому при
      // следующем запуске поднимется тот, что был открыт последним
      Ini.WriteString('Editor', 'LastProject', FCurrentProject);

      Ini.EraseSection('Recent');
      if FRecentFiles <> nil then
        for K := 0 to FRecentFiles.Count - 1 do
          Ini.WriteString('Recent', 'File' + IntToStr(K + 1), FRecentFiles[K]);

      Ini.EraseSection('HotFolders');
      if FHotFolders <> nil then
        for K := 0 to FHotFolders.Count - 1 do
          if FHotFolders.Objects[K] <> nil then
            Ini.WriteString('HotFolders', 'Dir' + IntToStr(K + 1),
            '1 ' + FHotFolders[K])
          else
            Ini.WriteString('HotFolders', 'Dir' + IntToStr(K + 1),
            '0 ' + FHotFolders[K]);
    finally
      Ini.Free;
    end;
  except
    // Папка может быть доступна только на чтение (Program Files, флешка).
    // Настройки не критичны, поэтому молча остаёмся без сохранения.
  end;
end;



// Подмешивает к цвету C фон редактора в пропорции FHotTabPale процентов.
// 0 - исходный насыщенный цвет, 100 - полное слияние с фоном.
function TForm1.PaleColor(C: TColor): TColor;
var
  Src, Dst: Longint;
  R1, G1, B1, R2, G2, B2, P: Integer;
begin
  P := FHotTabPale;
  if P < 0 then
    P := 0;
  if P > 100 then
    P := 100;

  if P = 0 then
  begin
    Result := C;
    Exit;
  end;

  Src := ColorToRGB(C);
  Dst := ColorToRGB(FScheme.FTextBG); // направляющие лежат на подложке текста

  if P = 100 then
  begin
    Result := TColor(Dst);
    Exit;
  end;

  // Формат $00BBGGRR, поэтому каналы достаём сдвигами, а не через RGB()
  R1 := Src and $FF;          R2 := Dst and $FF;
  G1 := (Src shr 8) and $FF;  G2 := (Dst shr 8) and $FF;
  B1 := (Src shr 16) and $FF; B2 := (Dst shr 16) and $FF;

  R1 := R1 + (R2 - R1) * P div 100;
  G1 := G1 + (G2 - G1) * P div 100;
  B1 := B1 + (B2 - B1) * P div 100;

  Result := TColor(R1 or (G1 shl 8) or (B1 shl 16));
end;

// ---------------------------------------------------------------------------
//  Поддержка UTF-8
//
//  Delphi 7 и окно RichEdit (ANSI со стороны VCL) работают с однобайтовыми
//  строками, а весь конвейер
//  подсветки байтовый: LineStr[I] - это AnsiChar, смещения EM_* считаются в
//  байтах, вывод идёт через TabbedTextOutA. Поэтому UTF-8 поддерживается
//  ПРОЗРАЧНО: при открытии файл переводится в ANSI, при сохранении - обратно.
//  Сам редактор об этом ничего не знает и работает как раньше.
//
//  Цена решения: символы, которых нет в системной кодировке Windows, при
//  переводе теряются. Для кода на кириллице и латинице это не проблема.
// ---------------------------------------------------------------------------

// Проверяет, укладываются ли байты строки в структуру UTF-8. Нужна для файлов
// без BOM: чистый ASCII проверку проходит, но UTF-8 в нём и не отличить от ANSI.
function TForm1.LooksLikeUtf8(const S: string): Boolean;
var
  I, Len, Extra, K: Integer;
  B: Byte;
  HasMulti: Boolean;
begin
  Result := False;
  HasMulti := False;
  Len := Length(S);
  I := 1;

  while I <= Len do
  begin
    B := Byte(S[I]);

    if B < $80 then
      Inc(I)
    else
    begin
      // Длину последовательности определяем по старшим битам ведущего байта
      if (B and $E0) = $C0 then
        Extra := 1
      else if (B and $F0) = $E0 then
        Extra := 2
      else if (B and $F8) = $F0 then
        Extra := 3
      else
        Exit; // одиночный байт $80..$BF или $F8..$FF - это не UTF-8

      if I + Extra > Len then
        Exit;

      // Все хвостовые байты обязаны быть вида 10xxxxxx
      for K := 1 to Extra do
        if (Byte(S[I + K]) and $C0) <> $80 then
          Exit;

      HasMulti := True;
      Inc(I, Extra + 1);
    end;
  end;

  // Многобайтовых последовательностей не было - это просто ASCII, и считать
  // такой файл UTF-8 незачем, пусть остаётся ANSI.
  Result := HasMulti;
end;

// UTF-8 -> ANSI своим разбором, без Utf8ToAnsi.
//
// Utf8ToAnsi из Delphi 7 не понимает четырёхбайтовых последовательностей
// (символы за пределами U+FFFF - эмодзи и т.п.) и на них возвращает пустую
// строку. LoadTextFile тогда показывал файл сырыми байтами, как ANSI.
//
// Здесь символ за U+FFFF становится суррогатной парой UTF-16, дальше вся
// строка переводится в ANSI одним WideCharToMultiByte - как и раньше:
// символ, которого нет в кодовой странице, становится '?' или похожим.
// Структуру байтов заранее проверил LooksLikeUtf8; оборванная или
// недопустимая последовательность всё равно даёт '?', а не отказ.
function Utf8ToAnsiFull(const S: string): string;
var
  W: WideString;
  P: PWideChar;
  I, J, Len, Extra, K, N: Integer;
  B: Byte;
  CP: Cardinal;
begin
  Result := '';
  Len := Length(S);
  if Len = 0 then
    Exit;

  // Символов UTF-16 не больше, чем байтов: пара занимает 4 байта
  SetLength(W, Len);
  P := PWideChar(W);
  I := 1;
  J := 0;

  while I <= Len do
  begin
    B := Byte(S[I]);
    if B < $80 then
    begin
      CP := B;
      Extra := 0;
    end
    else if (B and $E0) = $C0 then
    begin
      CP := B and $1F;
      Extra := 1;
    end
    else if (B and $F0) = $E0 then
    begin
      CP := B and $0F;
      Extra := 2;
    end
    else if (B and $F8) = $F0 then
    begin
      CP := B and $07;
      Extra := 3;
    end
    else
    begin
      CP := Ord('?');
      Extra := 0;
    end;

    if I + Extra > Len then
    begin
      // Последовательность оборвана концом файла
      CP := Ord('?');
      Extra := Len - I;
    end
    else
      for K := 1 to Extra do
      begin
        if (Byte(S[I + K]) and $C0) <> $80 then
        begin
          // Хвост не того вида - ведущий байт считаем одиночным
          CP := Ord('?');
          Extra := 0;
          Break;
        end;
        CP := (CP shl 6) or (Byte(S[I + K]) and $3F);
      end;
    Inc(I, Extra + 1);

    if CP > $10FFFF then
      CP := Ord('?');

    if CP > $FFFF then
    begin
      Dec(CP, $10000);
      P[J] := WideChar(Word($D800 or (CP shr 10)));
      Inc(J);
      P[J] := WideChar(Word($DC00 or (CP and $3FF)));
      Inc(J);
    end
    else
    begin
      P[J] := WideChar(Word(CP));
      Inc(J);
    end;
  end;

  if J = 0 then
    Exit;

  N := WideCharToMultiByte(CP_ACP, 0, P, J, nil, 0, nil, nil);
  if N <= 0 then
    Exit;
  SetLength(Result, N);
  WideCharToMultiByte(CP_ACP, 0, P, J, PChar(Result), N, nil, nil);
end;

// Вид формы по её байтам:
//   0 - текст (object ...);
//   1 - двоичная, сразу с подписи TPF0 (так пишет Delphi);
//   2 - двоичная с заголовком ресурса Windows перед TPF0: FF 0A 00, имя
//       (строка с нулём в конце или FF и номер), флаги - 2 байта, размер -
//       4 байта. Так .dfm пишут некоторые старые версии и утилиты.
function DfmBinaryKind(const ARaw: string): Integer;
var
  P: Integer;
begin
  Result := 0;
  if Copy(ARaw, 1, 4) = 'TPF0' then
  begin
    Result := 1;
    Exit;
  end;
  if (Length(ARaw) < 12) or (ARaw[1] <> #$FF) or (ARaw[2] <> #$0A) or
     (ARaw[3] <> #0) then
    Exit;
  P := 4;
  if ARaw[P] = #$FF then
    Inc(P, 3)                    // имя - номер
  else
  begin
    while (P <= Length(ARaw)) and (ARaw[P] <> #0) do
      Inc(P);
    Inc(P);                      // имя - строка с нулём
  end;
  Inc(P, 2 + 4);                 // флаги и размер
  if Copy(ARaw, P, 4) = 'TPF0' then
    Result := 2;
end;

// Читает файл как есть и возвращает текст уже в ANSI, попутно запоминая,
// в какой кодировке он лежал на диске.
//
// Двоичная форма (.dfm, .lfm) отдаётся сразу текстом: во вкладке её можно
// читать и править, конструктор и инспектор работают с текстом. При
// сохранении во вкладке уже текст - он и запишется; Delphi 7 читает
// текстовые формы так же, как двоичные.
// Файл в окно: прочитать и запомнить, каким он был на диске - время и
// текст (общий предок для слияния при изменении снаружи)
function TForm1.LoadTextFile(const FileName: string): string;
begin
  Result := ReadTextFileDecoded(FileName);
  NoteDisk(FileName, Result);
end;

// Прочитать файл с определением кодировки (UTF-8, BOM, двоичная форма),
// ничего не запоминая. Кодировку пишет в FFileIsUtf8 / FFileHasBom.
function TForm1.ReadTextFileDecoded(const FileName: string): string;
var
  Stream: TFileStream;
  Raw: string;
  Size: Integer;
begin
  FFileIsUtf8 := False;
  FFileHasBom := False;

  // fmShareDenyNone: файл, который другая программа держит открытым на
  // запись (сборка пишет свой лог), тоже читается; с fmShareDenyWrite
  // открытие в этом случае не удаётся
  Stream := TFileStream.Create(FileName, fmOpenRead or fmShareDenyNone);
  try
    Size := Stream.Size;
    SetLength(Raw, Size);
    if Size > 0 then
      Stream.ReadBuffer(Raw[1], Size);
  finally
    Stream.Free;
  end;

  if IsFormExt(ExtractFileExt(FileName)) and (DfmBinaryKind(Raw) <> 0) then
  begin
    Result := DfmToText(Raw);
    if Result <> '' then
    begin
      LogDiag('Форма ' + ExtractFileName(FileName) + ' на диске двоичная - ' +
      'показана текстом; при сохранении запишется текстом');
              Exit;
    end;
    // Перевести не удалось - показываем как есть
    Result := Raw;
    Exit;
  end;

  // BOM UTF-8: EF BB BF
  if (Length(Raw) >= 3) and (Byte(Raw[1]) = $EF) and
     (Byte(Raw[2]) = $BB) and (Byte(Raw[3]) = $BF) then
  begin
    FFileIsUtf8 := True;
    FFileHasBom := True;
    Delete(Raw, 1, 3);
  end
  else if LooksLikeUtf8(Raw) then
    FFileIsUtf8 := True;

  if FFileIsUtf8 then
    Result := Utf8ToAnsiFull(Raw)
  else
    Result := Raw;

  // Пустая строка при непустом файле - перевод не удался; в этом случае
  // честнее показать исходные байты, чем пустое окно.
  if (Result = '') and (Raw <> '') then
  begin
    Result := Raw;
    FFileIsUtf8 := False;
    FFileHasBom := False;
  end;
end;

// Условное имя нового, ещё не сохранённого файла: '(без имени.txt)'.
// Пустое имя - тоже без пути на диске.
// Заголовок главного окна с временем сборки exe: по нему видно, какая
// версия программы запущена. Время - последней записи файла (FileAge):
// dcc32 переписывает exe на месте, и время создания файла у Windows при
// этом остаётся прежним, с первой сборки.
var
  GAppTitle: string = '';

function AppTitle: string;
var
  Age: Integer;
begin
  if GAppTitle = '' then
  begin
    GAppTitle := 'Редактор кода';
    Age := FileAge(Application.ExeName);
    // Полный путь запущенного exe: рабочий SyntaxHLClaude.exe или пробный
    // SyntaxHLClaude_new.exe - по заголовку видно, что именно запущено
    // Из какой версии исходников собран (ветка, коммит, незакоммиченные
    // изменения) - файл <exe>.build.txt, его пишет сборка (GitInfo)
    if Age <> -1 then
    begin
      GAppTitle := GAppTitle + ' [сборка ' +
        FormatDateTime('dd.mm.yyyy hh:nn', FileDateToDateTime(Age)) + ', ';
      if GitBuildInfoShort(Application.ExeName) <> '' then
        GAppTitle := GAppTitle + GitBuildInfoShort(Application.ExeName) + ', ';
      GAppTitle := GAppTitle + Application.ExeName + ']';
    end
    else
      GAppTitle := GAppTitle + ' [' + Application.ExeName + ']';
  end;
  Result := GAppTitle;
end;

function IsUntitledName(const S: string): Boolean;
begin
  Result := (S = '') or (Pos('(без имени', S) = 1);
end;

// Расширение по имени из записи окна. У условного имени оно стоит перед
// закрывающей скобкой, и ExtractFileExt вернул бы '.txt)'.
function WindowExt(const S: string): string;
begin
  if S = '' then
    Result := ''
  else if IsUntitledName(S) then
  begin
    if S[Length(S)] = ')' then
      Result := ExtractFileExt(Copy(S, 1, Length(S) - 1))
    else
      Result := ExtractFileExt(S);
  end
  else
    Result := ExtractFileExt(S);
end;

// Имя для заголовка окна: путь к файлу, а у нового файла - условное имя
function TForm1.DisplayName: string;
begin
  if FCurrentFileName <> '' then
    Result := ExtractFileName(FCurrentFileName)
  else if (FWindowsIndex >= 0) and FWindows[FWindowsIndex].Used then
    Result := FWindows[FWindowsIndex].FileName
  else
    Result := '';
end;

// Пишет текст в той кодировке, в которой файл был открыт.
procedure TForm1.SaveTextFile(const FileName, Text: string);
var
  Stream: TFileStream;
  Raw: string;
  Bom: array[0..2] of Byte;
begin
  if FFileIsUtf8 then
    Raw := AnsiToUtf8(Text)
  else
    Raw := Text;

  Stream := TFileStream.Create(FileName, fmCreate);
  try
    if FFileIsUtf8 and FFileHasBom then
    begin
      Bom[0] := $EF; Bom[1] := $BB; Bom[2] := $BF;
      Stream.WriteBuffer(Bom, 3);
    end;
    if Raw <> '' then
      Stream.WriteBuffer(Raw[1], Length(Raw));
  finally
    Stream.Free;
  end;
  // Записали сами - это не изменение снаружи
  NoteDisk(FileName, Text);
end;

// ---------------------------------------------------------------------------
//  Файлы, изменённые снаружи
//
//  При возврате в программу (Application.OnActivate) у каждого открытого
//  окна время файла на диске сверяется с тем, что было при последнем чтении
//  или записи здесь. Если время другое, файл читается и сравнивается с
//  текстом окна: совпадает (сохранили тем же текстом, git вернул прежнее) -
//  ничего не спрашиваем. Отличается - вопрос, перечитать ли; если в окне
//  есть несохранённые правки, об этом сказано в вопросе. Ответ "нет" -
//  больше не спрашиваем, пока файл не изменится ещё раз.
//  Проверка - через PostMessage: не внутри самой активации, диалог в ней
//  снова её вызывает.
// ---------------------------------------------------------------------------

procedure TForm1.AppActivate(Sender: TObject);
begin
  if not FDiskCheckBusy then
    PostMessage(Handle, WM_USER + 315, 0, 0);
end;

procedure TForm1.WMCheckDisk(var Msg: TMessage);
begin
  CheckDiskChanges(-1);
end;

// Раз в две секунды, пока программа активна и открыто главное окно (не
// диалог и не конструктор): файл могли поменять, не уводя фокус - скачали
// новую версию, сборка записала. Время файла - дешёвая проверка, файл
// читается, только если время изменилось.
procedure TForm1.DiskTimerTick(Sender: TObject);
begin
  // Окно модулей и форм - и когда активно оно само, а не главное
  if not FDiskCheckBusy and (FBusyDepth = 0) and Application.Active then
    ModListCheckDpr;
  if FDiskCheckBusy or (FBusyDepth > 0) or not Application.Active or
     (Screen.ActiveForm <> Self) then
    Exit;
  CheckDiskChanges(-1);
end;

// Вопрос по одному файлу. Ответ: 1 - перечитать, 2 - слить, 3 - открыть
// версию с диска в новой вкладке, 4 - оставить текст окна. ASame - то же
// для остальных изменённых файлов.
function TForm1.AskDiskChange(W: Integer; IsMod, CanMerge, Many: Boolean;
                              var ASame: Boolean): Integer;
var
  Dlg: TDlgAskDisk;
  S: string;
begin
  Result := 4;
  ASame := False;
  S := 'Файл изменён на диске другой программой:'#13#10 +
       FWindows[W].FileName;
  if IsMod then
    S := S + #13#10#13#10'В окне есть несохранённые изменения. "Перечитать" ' +
    'их отбросит; "Слить" перенесёт в текст с диска.'
  else
    S := S + #13#10#13#10'В окне изменений нет.';

  // Окно описано в DlgAskDisk.dfm; здесь - только то, что зависит от файла
  Dlg := TDlgAskDisk.Create(Self);
  try
    Dlg.lblInfo.Caption := S;
    Dlg.chkSame.Visible := Many;
    Dlg.btnMerge.Enabled := CanMerge;
    // По умолчанию - то, что ничего не теряет
    if IsMod then
    begin
      if CanMerge then
        Dlg.btnMerge.Default := True
      else
        Dlg.btnNewTab.Default := True;
    end
    else
      Dlg.btnReload.Default := True;

    case Dlg.ShowModal of
      mrYes:   Result := 1;
      mrAll:   Result := 2;
      mrRetry: Result := 3;
    else
      Result := 4;
    end;
    ASame := Many and Dlg.chkSame.Checked;
  finally
    Dlg.Free;
  end;
end;

// Проверка файлов открытых окон: изменилось ли время файла на диске.
// Окно без правок перечитывается сразу, без вопроса. С правками - файл
// читается и сравнивается с окном; отличается - вопрос (перечитать, слить,
// в новую вкладку, оставить). AOnly - только это окно (перед записью),
// -1 - все.
// False - после ответа продолжать запись или сборку не стоит: слияние
// оставило конфликты или версия с диска открыта рядом для сравнения.
function TForm1.CheckDiskChanges(AOnly: Integer): Boolean;
var
  I, K, W, Act, Choice, Cf: Integer;
  FN, Key, MemTxt, BaseTxt, Merged: string;
  Changed, Disk: TStringList;
  SavedUtf8, SavedBom, IsMod, Same, CanMerge, ReadOk: Boolean;
  Obj: TObject;
begin
  Result := True;
  if FDiskCheckBusy or (FDiskAges = nil) then
    Exit;
  FDiskCheckBusy := True;
  Changed := TStringList.Create;   // Objects - номер окна
  Disk := TStringList.Create;      // текст файла на диске, по порядку Changed
  try
    for I := 0 to WindowsItemCount - 1 do
    begin
      if (AOnly >= 0) and (I <> AOnly) then
        Continue;
      if not FWindows[I].Used or FWindows[I].Broken then
        Continue;
      FN := FWindows[I].FileName;
      if IsUntitledName(FN) or not FileExists(FN) then
        Continue;
      Key := AnsiUpperCase(ExpandFileName(FN));
      K := FDiskAges.IndexOfName(Key);
      if K < 0 then
        Continue;   // файл читали не здесь - сравнивать не с чем
      if FDiskAges.ValueFromIndex[K] = IntToStr(FileAge(FN)) then
        Continue;

      // Правок в окне нет - файл просто загружается заново, без вопроса:
      // читать его всё равно пришлось бы, а терять нечего
      if I = FWindowsIndex then
        IsMod := RichEdit1.Modified
      else
        IsMod := FWindows[I].Modified;
      if not IsMod then
      begin
        if I = FWindowsIndex then
          FWindows[I].CursorPos := RichEdit1.SelStart; // каретка - на месте
        if ReloadWindowFromDisk(I, False) then
          LogComp(ExtractFileName(FN) + ': изменён на диске - перечитан в ' +
          'окно (правок в окне не было)');
                  Continue;
      end;

      // В окне есть правки. Кодировку чтение пишет в поля активного
      // окна - возвращаем
      SavedUtf8 := FFileIsUtf8;
      SavedBom := FFileHasBom;
      ReadOk := True;
      try
        Merged := ReadTextFileDecoded(FN);
      except
        ReadOk := False;
      end;
      FFileIsUtf8 := SavedUtf8;
      FFileHasBom := SavedBom;
      // Не открылся (занят) - сравнивать не с чем; время не запомнено,
      // следующая проверка попробует снова
      if not ReadOk then
        Continue;

      if I = FWindowsIndex then
        MemTxt := GetEditorText
      else
        MemTxt := FWindows[I].Text;
      if SameNoEols(Merged, MemTxt) then
        NoteDisk(FN, Merged)        // то же самое - запомнить и молчать
      else
      begin
        Changed.AddObject(FN, TObject(I));
        Disk.Add(Merged);
      end;
    end;

    Same := False;
    Choice := 4;
    for K := 0 to Changed.Count - 1 do
    begin
      W := Integer(Changed.Objects[K]);
      FN := Changed[K];
      if not FWindows[W].Used then
        Continue;
      if W = FWindowsIndex then
        IsMod := RichEdit1.Modified
      else
        IsMod := FWindows[W].Modified;

      BaseTxt := '';
      I := FDiskAges.IndexOfName(AnsiUpperCase(ExpandFileName(FN)));
      Obj := nil;
      if I >= 0 then
        Obj := FDiskAges.Objects[I];
      CanMerge := IsMod and (Obj is TDiskBase);
      if CanMerge then
        BaseTxt := TDiskBase(Obj).Text;

      if not Same then
        Choice := AskDiskChange(W, IsMod, CanMerge, Changed.Count - K > 1,
                                Same);
      Act := Choice;
      // "Так же для остальных": слить можно не везде - там перечитать,
      // только если в окне нет правок, иначе оставить
      if Same and (Act = 2) and not CanMerge then
        if IsMod then
          Act := 4
        else
          Act := 1;
      if Same and (Act = 1) and IsMod then
        Act := 4;

      case Act of
        1:
          ReloadWindowFromDisk(W, False);
        2:
        begin
          if W = FWindowsIndex then
            MemTxt := GetEditorText
          else
            MemTxt := FWindows[W].Text;
          Merged := Merge3(BaseTxt, MemTxt, Disk[K], Cf);
          if W = FWindowsIndex then
            StoreCurrentWindow;
          FWindows[W].Text := Merged;
          FWindows[W].Modified := True;
          FWindows[W].MapValid := False;
          SetLength(FWindows[W].CommentRanges, 0);
          SetLength(FWindows[W].StringRanges, 0);
          if FWindows[W].CursorPos > Length(Merged) then
            FWindows[W].CursorPos := 0;
          // Теперь предок - версия с диска: она в окне учтена
          NoteDisk(FN, Disk[K]);
          if W = FWindowsIndex then
            ActivateWindow(W)
          else
            UpdateTabCaption(W);
          RebuildWindowsMenu;
          if Cf > 0 then
          begin
            Result := False;
            LogComp(ExtractFileName(FN) + ': слито с версией на диске, ' +
            'конфликтов ' + IntToStr(Cf) + ' - строки <<<<<<< ' +
            '======= >>>>>>> в тексте окна');
                    ShowMessage('4261:' + ExtractFileName(FN) + ': слито, ' +
            'конфликтов - ' + IntToStr(Cf) + '.'#13#10 +
            'Они отмечены в тексте строками <<<<<<<, ======= ' +
            'и >>>>>>>. Файл не сохранён.');
          end;
        end;
        3:
        begin
          // Версия с диска - в свободное окно без имени: сохранить её
          // случайно поверх файла нельзя, Save спросит имя
          I := FindFreeWindow;
          if I < 0 then
            ShowMessage(Format('4273:Открыто максимальное число файлов ' +
            '(%d).', [WindowsItemCount]))
          else
          begin
            StoreCurrentWindow;
            FWindows[I].Used := True;
            FWindows[I].FileName := '(без имени: ' + ExtractFileName(FN) +
            ' с диска' + ExtractFileExt(FN) + ')';
            FWindows[I].IncOwner := '';
            FWindows[I].Text := Disk[K];
            FWindows[I].CursorPos := 0;
            FWindows[I].Modified := False;
            FWindows[I].IsUtf8 := False;
            FWindows[I].HasBom := False;
            FWindows[I].Broken := False;
            FWindows[I].MapValid := False;
            NoteDisk(FN, Disk[K]);
            ActivateWindow(I);
            FCurrentFileName := '';
          end;
          Result := False;
        end;
      else
        // Оставить окно: больше не спрашивать, пока файл не изменится
        NoteDisk(FN, Disk[K]);
      end;
    end;
  finally
    Disk.Free;
    Changed.Free;
    FDiskCheckBusy := False;
  end;
end;

// Ini-файл записал сам редактор (TBufIniFile): открытое окно этого файла
// без правок перечитывается молча - проверка диска не примет запись за
// изменение другой программой. Окно с правками не трогается: там вопрос
// проверки диска нужен.
procedure TForm1.IniOwnWritten(const AFile: string);
var
  WinIdx: Integer;
  IsMod: Boolean;
begin
  // Запуск ещё идёт или окно закрывается - перечитывать нечего
  if not FStartupDone or (csDestroying in ComponentState) then
    Exit;
  WinIdx := IndexOfWindowByFile(AFile);
  if (WinIdx < 0) or not FWindows[WinIdx].Used or FWindows[WinIdx].Broken then
    Exit;
  if WinIdx = FWindowsIndex then
    IsMod := RichEdit1.Modified
  else
    IsMod := FWindows[WinIdx].Modified;
  if IsMod then
    Exit;
  if WinIdx = FWindowsIndex then
    FWindows[WinIdx].CursorPos := RichEdit1.SelStart;
  ReloadWindowFromDisk(WinIdx, False);
end;

procedure TForm1.NoteDisk(const AFile, AText: string);
var
  Key: string;
  I: Integer;
begin
  if FDiskAges = nil then
    FDiskAges := TStringList.Create;
  Key := AnsiUpperCase(ExpandFileName(AFile));
  I := FDiskAges.IndexOfName(Key);
  if I < 0 then
    I := FDiskAges.AddObject(Key + '=', TDiskBase.Create);
  FDiskAges.ValueFromIndex[I] := IntToStr(FileAge(AFile));
  if not (FDiskAges.Objects[I] is TDiskBase) then
    FDiskAges.Objects[I] := TDiskBase.Create;
  TDiskBase(FDiskAges.Objects[I]).Text := AText;
end;


// ---------------------------------------------------------------------------
//  Меню File
//
//  В DFM лежат только Open, Save и Exit. Остальные пункты и оба подменю
//  строятся здесь: так порядок, разделители и горячие клавиши задаются в одном
//  месте, а не растаскиваются между дизайнером и кодом.
// ---------------------------------------------------------------------------

// Общий помощник: создаёт пункт и цепляет его к родителю
function MakeItem(AOwner: TComponent; AParent: TMenuItem;
                  const ACaption: string; AHandler: TNotifyEvent; AShortCut: TShortCut): TMenuItem;
begin
  Result := TMenuItem.Create(AOwner);
  Result.Caption := ACaption;
  Result.OnClick := AHandler;
  Result.ShortCut := AShortCut;
  AParent.Add(Result);
end;

procedure TForm1.BuildFileMenu;
begin
  RebuildReopenMenu;

  mSave.Caption := 'SaveFile';
  mSave.ShortCut := ShortCut(Ord('S'), [ssCtrl]);
end;

// Перестраивает подменю Reopen по списку недавних файлов
procedure TForm1.RebuildReopenMenu;
var
  I: Integer;
  It: TMenuItem;
begin
  if mReopen = nil then
    Exit;

  // Пункты подменю создаются динамически, поэтому Clear здесь безопасен
  mReopen.Clear;

  if (FRecentFiles = nil) or (FRecentFiles.Count = 0) then
  begin
    It := MakeItem(Self, mReopen, '(empty)', nil, 0);
    It.Enabled := False;
    Exit;
  end;

  for I := 0 to FRecentFiles.Count - 1 do
  begin
    It := MakeItem(Self, mReopen,
                   Format('&%d  %s', [I + 1, FRecentFiles[I]]), ReopenItemClick, 0);
    It.Tag := I;
  end;

  MakeItem(Self, mReopen, '-', nil, 0);
  MakeItem(Self, mReopen, '&Clear list', ReopenClearClick, 0);
end;

// Кладёт файл в начало списка недавних, убирая дубликат и лишний хвост
procedure TForm1.AddToRecent(const FileName: string);
var
  I: Integer;
begin
  if (FRecentFiles = nil) or (FileName = '') then
    Exit;

  for I := FRecentFiles.Count - 1 downto 0 do
    if CompareText(FRecentFiles[I], FileName) = 0 then
      FRecentFiles.Delete(I);

  FRecentFiles.Insert(0, FileName);
  while FRecentFiles.Count > 9 do
    FRecentFiles.Delete(FRecentFiles.Count - 1);

  RebuildReopenMenu;
  SaveSettings;
end;

// Папка - скетч Arduino: в ней <имя папки>.ino (или .pde)
function IsSketchFolder(const ADir: string): Boolean;
var
  Dir, Folder: string;
begin
  Result := False;
  if ADir = '' then
    Exit;
  Dir := IncludeTrailingPathDelimiter(ADir);
  Folder := ExtractFileName(ExcludeTrailingPathDelimiter(ADir));
  Result := (Folder <> '') and (FileExists(Dir + Folder + '.ino') or
                                FileExists(Dir + Folder + '.pde'));
end;

// Главный файл скетча Arduino: .ino или .pde
function IsSketchExt(const AFile: string): Boolean;
var
  Ext: string;
begin
  Ext := LowerCase(ExtractFileExt(AFile));
  Result := (Ext = '.ino') or (Ext = '.pde');
end;

// Где должен лежать скетч AFile: в папке своего имени,
// <папка>\<имя>\<имя>.ino. Уже лежит в ней - сам AFile.
function SketchHomePath(const AFile: string): string;
var
  Dir, Folder, BaseName: string;
begin
  Dir := ExtractFilePath(AFile);
  Folder := ExtractFileName(ExcludeTrailingPathDelimiter(Dir));
  BaseName := ChangeFileExt(ExtractFileName(AFile), '');
  if CompareText(Folder, BaseName) = 0 then
    Result := AFile
  else
    Result := Dir + BaseName + '\' + ExtractFileName(AFile);
end;

// .ino / .pde лежит не в папке своего имени и не дополнительным файлом
// другого скетча (в папке нет <имя папки>.ino) - arduino-cli такой файл
// скетчем не примет
function SketchMisplaced(const AFile: string): Boolean;
begin
  Result := IsSketchExt(AFile) and
            (CompareText(SketchHomePath(AFile), AFile) <> 0) and
            not IsSketchFolder(ExtractFilePath(AFile));
end;

// Открывает файл по готовому пути. Общая часть для Open... и Reopen.
procedure TForm1.OpenNamedFile(const FileName: string);
var
  Idx: Integer;
  FN, NewFN: string;
begin
  // Путь мог прийти из .prj или из списка недавних и указывать на прежнее
  // расположение папки - пробуем найти файл рядом с программой. Прямые
  // косые (D:/папка/файл.inc из сообщения компилятора) - обратными: иначе
  // имя на вкладке - весь путь, а тот же файл открылся бы второй раз
  FN := ResolveFileName(StringReplace(FileName, '/', '\', [rfReplaceAll]));

  if not FileExists(FN) then
  begin
    ShowMessage('4465:Файл не найден:'#13#10 + FileName);
    if FRecentFiles <> nil then
    begin
      if FRecentFiles.IndexOf(FileName) >= 0 then
        FRecentFiles.Delete(FRecentFiles.IndexOf(FileName));
      RebuildReopenMenu;
      SaveSettings;
    end;
    Exit;
  end;

  // Скетч Arduino не в папке своего имени - предложить перенос, как
  // Arduino IDE. Пока идёт запуск - без вопроса (окно вопроса ушло бы под
  // заставку); при сборке вопрос будет
  if FStartupDone and SketchMisplaced(FN) and AskMoveSketchHome(FN) then
  begin
    NewFN := MoveSketchHome(FN);
    if NewFN <> '' then
      FN := NewFN;
  end;

  // Сохранить не спрашиваем: текущее окно остаётся открытым, его текст и
  // признак изменений хранятся в своём слоте (StoreCurrentWindow). Вопрос -
  // только когда окно закрывается, при смене проекта и при выходе.

  // Уже открытый файл не загружаем заново - просто переключаемся на него.
  // Он и так активен - переключать нечего: ActivateWindow на свою же
  // вкладку заново залил бы в редактор текст из записи окна (а она
  // обновляется только при уходе с вкладки) и перестроил инспектор.
  // Сравнение - IndexOfWindowByFile (полный путь, короткое имя 8.3), а не
  // строк: тот же файл мог быть открыт другой записью пути
  Idx := IndexOfWindowByFile(FN);
  if Idx >= 0 then
  begin
    if Idx <> FWindowsIndex then
      ActivateWindow(Idx);
    Exit;
  end;

  Idx := FindFreeWindow;
  if Idx < 0 then
  begin
    ShowMessage(Format('4496:Открыто максимальное число файлов (%d).' + #13#10 +
    'Закройте одно из окон.', [WindowsItemCount]));
                       Exit;
  end;


  // Текущее окно сохраняем ДО того, как заливать в редактор новый текст
  StoreCurrentWindow;

  FWindows[Idx].Used := True;
  FWindows[Idx].FileName := FN;
  FWindows[Idx].IncOwner := '';
  FWindows[Idx].Text := LoadTextFile(FN); // тут же определится кодировка
  FWindows[Idx].CursorPos := 0;
  FWindows[Idx].Modified := False;
  FWindows[Idx].IsUtf8 := FFileIsUtf8;
  FWindows[Idx].HasBom := FFileHasBom;
  FWindows[Idx].Broken := False;
  FWindows[Idx].WorkMs := 0;

  // Последний загруженный файл и становится текущим
  ActivateWindow(Idx);
  AddToRecent(FN);
end;

// New -> тип файла. Чистим редактор и переключаем цветовую схему под расширение.
procedure TForm1.NewFileClick(Sender: TObject);
var
  Ext: string;
  Idx: Integer;
begin
  // Новый файл - в свободном слоте, текущее окно остаётся: не спрашиваем

  Ext := '.txt';
  if Sender is TMenuItem then
    Ext := TMenuItem(Sender).Hint;

  Idx := FindFreeWindow;
  if Idx < 0 then
  begin
    ShowMessage(Format('4534:Открыто максимальное число файлов (%d).', [WindowsItemCount]));
    Exit;
  end;

  StoreCurrentWindow;

  FWindows[Idx].Used := True;
  FWindows[Idx].FileName := '(без имени' + Ext + ')';
  FWindows[Idx].IncOwner := '';
  FWindows[Idx].Text := '';
  FWindows[Idx].CursorPos := 0;
  FWindows[Idx].Modified := False;
  FWindows[Idx].IsUtf8 := False;
  FWindows[Idx].HasBom := False;
  FWindows[Idx].Broken := False;
  FWindows[Idx].WorkMs := 0;

  ActivateWindow(Idx);
  // У нового файла нет пути на диске, поэтому FCurrentFileName пустой:
  // Save спросит имя через диалог.
  FCurrentFileName := '';
end;

procedure TForm1.ReopenItemClick(Sender: TObject);
var
  Idx: Integer;
begin
  if not (Sender is TMenuItem) then
    Exit;
  Idx := TMenuItem(Sender).Tag;
  if (FRecentFiles = nil) or (Idx < 0) or (Idx >= FRecentFiles.Count) then
    Exit;

  // Спрашивать про сохранение больше не нужно: текущий файл не закрывается,
  // он остаётся в своём окне вместе со всеми правками.
  OpenNamedFile(FRecentFiles[Idx]);
end;

procedure TForm1.ReopenClearClick(Sender: TObject);
begin
  if FRecentFiles <> nil then
    FRecentFiles.Clear;
  RebuildReopenMenu;
  SaveSettings;
end;

// Save As...: всегда спрашивает новое имя, в отличие от Save
procedure TForm1.SaveAsClick(Sender: TObject);
var
  Old, NewName: string;
begin
  // Диалог должен открыться в папке САМОГО файла. Для этого мало положить
  // в FileName одно имя: без InitialDir Windows уводит диалог в текущий
  // каталог процесса.
  SaveDialog1.InitialDir := SuggestDir;
  if not IsUntitledName(FCurrentFileName) then
    SaveDialog1.FileName := FCurrentFileName
  else
    SaveDialog1.FileName := '';

  if not SaveDialog1.Execute then
    Exit;

  // Скетч Arduino - в папку своего имени
  NewName := SketchSavePath(SaveDialog1.FileName);
  if NewName = '' then
    Exit;

  Old := FCurrentFileName;
  FCurrentFileName := NewName;
  if not SaveCurrentFile then
  begin
    FCurrentFileName := Old; // сохранение сорвалось - имя не меняем
    Exit;
  end;

  // Схема зависит от расширения, а оно могло измениться
  LoadCustomClrSchema(ExtractFileExt(FCurrentFileName), FCurrentFileName);
  RebuildCommentRangeMap;
  RichEdit1.Invalidate;
  AddToRecent(FCurrentFileName);
end;

procedure TForm1.NotImplementedClick(Sender: TObject);
begin
  ShowMessage('4612:Этот пункт пока не реализован.');
end;


// ---------------------------------------------------------------------------
//  Массив текстовых окон
//
//  Все открытые файлы держатся в памяти целиком, в FWindows. Редактор в любой
//  момент показывает ровно одно окно - то, на которое указывает FWindowsIndex.
//  При переключении текст из RichEdit возвращается в свой слот, а из нового
//  слота подставляется в редактор.
// ---------------------------------------------------------------------------

// Первый свободный слот или -1, если массив заполнен
function TForm1.FindFreeWindow: Integer;
var
  I: Integer;
begin
  Result := -1;
  for I := 0 to WindowsItemCount - 1 do
    if not FWindows[I].Used then
    begin
      Result := I;
      Exit;
    end;
end;

function TForm1.WindowsInUse: Integer;
var
  I: Integer;
begin
  Result := 0;
  for I := 0 to WindowsItemCount - 1 do
    if FWindows[I].Used then
      Inc(Result);
end;

// Возвращает содержимое редактора в текущий слот. Вызывается перед любым
// переключением, иначе правки потерялись бы.
// ---------------------------------------------------------------------------
//  Кэш разбора текста для отрисовки: карта комментариев и строк, список
//  подпрограмм, уровни строк, имена компонентов.
//
//  В памяти - в записи окна: StoreCurrentWindow кладёт, ActivateWindow
//  берёт. Пока текст окна не менялся, при переключении вкладок заново
//  ничего не разбирается. MapValid относится ко всему набору; каждое место,
//  где меняется текст окна, его снимает. Имена компонентов модуля зависят
//  ещё и от соседнего .dfm - они сверяются по его пути и дате (CompDfmKey)
//  и при расхождении строятся заново.
//
//  На диске - dsgcache\<файл>_<crc пути>.mapcache. При выходе пишутся
//  окна, чей разбор в этом сеансе строился заново (MapSaved = False); при
//  первом показе окна файл читается. Ключ - контрольная сумма и длина
//  текста и подпись схемы (маркеры, даты файлов схемы, есть ли цвета
//  компонентов) и версия разбора MapCacheSign: что-то из этого другое -
//  файл не подходит, и разбор идёт как обычно. Файл испорчен или не
//  читается - так же.
//
//  Дата exe в ключ не входит: каждая сборка давала бы новую дату, и после
//  каждой пересборки большой файл разбирался заново (~1 с на Unit1.pas).
//  Взамен - номер в MapCacheSign: ИЗМЕНИЛСЯ РАЗБОР (RebuildCommentRangeMap,
//  подпрограммы, глубина строк, имена компонентов) или формат файла кэша -
//  увеличить номер, иначе старые карты будут считаться верными.
// ---------------------------------------------------------------------------

const
  MapCacheSign = 'SHLMAP2';

procedure MapWriteInt(S: TStream; V: Integer);
begin
  S.WriteBuffer(V, SizeOf(V));
end;

function MapReadInt(S: TStream): Integer;
begin
  S.ReadBuffer(Result, SizeOf(Result));
end;

// Длина, потом символы. Длина больше остатка файла - файл испорчен.
procedure MapWriteStr(S: TStream; const V: string);
begin
  MapWriteInt(S, Length(V));
  if V <> '' then
    S.WriteBuffer(V[1], Length(V));
end;

function MapReadStr(S: TStream): string;
var
  L: Integer;
begin
  L := MapReadInt(S);
  if (L < 0) or (L > S.Size - S.Position) then
    raise EReadError.Create('mapcache: длина строки');
  SetLength(Result, L);
  if L > 0 then
    S.ReadBuffer(Result[1], L);
end;

// Число элементов, потом сами элементы одним куском
procedure MapWriteRanges(S: TStream; const A: TCommentRangeArray);
begin
  MapWriteInt(S, Length(A));
  if Length(A) > 0 then
    S.WriteBuffer(A[0], Length(A) * SizeOf(TCommentRange));
end;

procedure MapReadRanges(S: TStream; var A: TCommentRangeArray);
var
  N: Integer;
begin
  N := MapReadInt(S);
  if (N < 0) or (Int64(N) * SizeOf(TCommentRange) > S.Size - S.Position) then
    raise EReadError.Create('mapcache: число диапазонов');
  SetLength(A, N);
  if N > 0 then
    S.ReadBuffer(A[0], N * SizeOf(TCommentRange));
end;

procedure MapWriteInts(S: TStream; const A: TIntArray);
begin
  MapWriteInt(S, Length(A));
  if Length(A) > 0 then
    S.WriteBuffer(A[0], Length(A) * SizeOf(Integer));
end;

procedure MapReadInts(S: TStream; var A: TIntArray);
var
  N: Integer;
begin
  N := MapReadInt(S);
  if (N < 0) or (Int64(N) * SizeOf(Integer) > S.Size - S.Position) then
    raise EReadError.Create('mapcache: число чисел');
  SetLength(A, N);
  if N > 0 then
    S.ReadBuffer(A[0], N * SizeOf(Integer));
end;

// Ключ файла кэша: текст окна и подпись схемы
function MapCacheKey(const AText, ASchemeSig: string): string;
begin
  Result := 'text ' + IntToHex(Crc32Of(AText), 8) + ':' +
            IntToStr(Length(AText)) + ' | ' + ASchemeSig;
end;

// Разбор текущего окна (глобальные карты и списки) - в запись окна Index.
// Copy даёт независимые массивы: без него запись держала бы ссылку на те
// же данные, которые RebuildCommentRangeMap переиспользует для следующего
// окна.
procedure TForm1.StoreWindowParse(Index: Integer);
var
  Key: string;
begin
  FWindows[Index].CommentRanges := Copy(CommentRanges, 0, Length(CommentRanges));
  FWindows[Index].StringRanges := Copy(StringRanges, 0, Length(StringRanges));
  FWindows[Index].Subs := Copy(FSubs, 0, Length(FSubs));
  FWindows[Index].LineDepth := Copy(FLineDepth, 0, Length(FLineDepth));
  FWindows[Index].CompSlots := Copy(FCompSlots, 0, Length(FCompSlots));
  FWindows[Index].CompWords := Copy(FCompWords, 0, Length(FCompWords));
  FWindows[Index].CompMask := FCompMask;
  // Имена строились по .dfm с ключом FCompDfmKey (последний прочитанный).
  // Он от этого же модуля и .dfm с тех пор не менялся - запоминаем; иначе
  // пусто, и при возврате имена построятся заново.
  Key := CompDfmKeyFor(FWindows[Index].FileName);
  if (Key <> '') and (Key = FCompDfmKey) then
    FWindows[Index].CompDfmKey := Key
  else
    FWindows[Index].CompDfmKey := '';
  FWindows[Index].MapSchemeSig := MapSchemeSig(FWindows[Index].FileName);
end;

// Разбор из записи окна Index - в глобальные карты и списки. Таблицу
// подпрограмм FillSubListView во время переключения только помечает, её
// заполнит вторая половина переключения. Соседний .dfm с тех пор
// изменился - имена компонентов строятся заново.
procedure TForm1.RestoreWindowParse(Index: Integer);
begin
  FMapPartialEnd := 0; // карта окна полная
  CommentRanges := Copy(FWindows[Index].CommentRanges, 0,
                        Length(FWindows[Index].CommentRanges));
  StringRanges := Copy(FWindows[Index].StringRanges, 0,
                       Length(FWindows[Index].StringRanges));
  FSubs := Copy(FWindows[Index].Subs, 0, Length(FWindows[Index].Subs));
  FillSubListView;
  FLineDepth := Copy(FWindows[Index].LineDepth, 0,
                     Length(FWindows[Index].LineDepth));
  if FWindows[Index].CompDfmKey = CompDfmKeyFor(FWindows[Index].FileName) then
  begin
    FCompSlots := Copy(FWindows[Index].CompSlots, 0,
                       Length(FWindows[Index].CompSlots));
    FCompWords := Copy(FWindows[Index].CompWords, 0,
                       Length(FWindows[Index].CompWords));
    FCompMask := FWindows[Index].CompMask;
  end
  else
  begin
    RebuildCompNames(GetEditorTextCR);
    if FScheme.FCompHasColors then
      FMapRebuilt := True;   // имена другие - на диске уже не они
  end;
end;

// Соседний .dfm модуля - путь и дата, как ключ в RebuildCompNames. '' - у
// файла нет формы или это не модуль Паскаля (у .dfm имена из своего текста).
function TForm1.CompDfmKeyFor(const AFile: string): string;
var
  Dfm: string;
begin
  Result := '';
  if not IsPascalExt(LowerCase(ExtractFileExt(AFile))) then
    Exit;
  Dfm := FormFileFor(AFile);
  if Dfm <> '' then
    Result := Dfm + '|' + IntToStr(FileAge(Dfm));
end;

// Подпись загруженной схемы для расширения AExt: маркеры, даты файла
// схемы и •default•.clr, есть ли в схеме цвета компонентов. Даты exe нет -
// см. MapCacheSign
function TForm1.MapSchemeSig(const AFile: string): string;
var
  SchemeKey: string;
begin
  SchemeKey := SchemeKeyFor(AFile, WindowExt(AFile));
  Result := FScheme.MarkersSig + ' | clr ' + SchemeKey + ' ' +
    IntToStr(FileAge(ExtractFilePath(Application.ExeName) + 'schemes\' +
                     SchemeKey + '.clr')) + ' ' +
    IntToStr(FileAge(DefaultSchemaFile)) + ' | comp ' +
    IntToStr(Ord(FScheme.FCompHasColors));
end;

function TForm1.MapCacheFileFor(const AFile: string): string;
begin
  Result := ExtractFilePath(Application.ExeName) + 'dsgcache\' +
            ExtractFileName(AFile) + '_' +
            IntToHex(Crc32Of(AnsiLowerCase(AFile)), 8) + '.mapcache';
end;

// Разбор окна Index с диска - в запись окна. Схема этого окна уже
// загружена (ActivateWindow). True - файл подошёл по ключу и прочитан.
function TForm1.LoadMapCache(Index: Integer): Boolean;
var
  FS: TFileStream;
  FN, Sig, DfmKey: string;
  CR, SR: TCommentRangeArray;
  Subs: TSubInfoArray;
  Depth, Slots: TIntArray;
  Words: TStrArray;
  Mask, N, I: Integer;
begin
  Result := False;
  if not FUseSyntaxHighlight or IsUntitledName(FWindows[Index].FileName) then
    Exit;
  FN := MapCacheFileFor(FWindows[Index].FileName);
  if not FileExists(FN) then
    Exit;
  Sig := MapSchemeSig(FWindows[Index].FileName);
  try
    FS := TFileStream.Create(FN, fmOpenRead or fmShareDenyWrite);
    try
      if MapReadStr(FS) <> MapCacheSign then
        Exit;
      if MapReadStr(FS) <> MapCacheKey(FWindows[Index].Text, Sig) then
        Exit;
      MapReadRanges(FS, CR);
      MapReadRanges(FS, SR);
      N := MapReadInt(FS);
      if (N < 0) or (N > FS.Size - FS.Position) then
        Exit;
      SetLength(Subs, N);
      for I := 0 to N - 1 do
      begin
        Subs[I].Name := MapReadStr(FS);
        Subs[I].BeginLine := MapReadInt(FS);
        Subs[I].EndLine := MapReadInt(FS);
      end;
      MapReadInts(FS, Depth);
      DfmKey := MapReadStr(FS);
      Mask := MapReadInt(FS);
      MapReadInts(FS, Slots);
      N := MapReadInt(FS);
      if (N < 0) or (N > FS.Size - FS.Position) then
        Exit;
      SetLength(Words, N);
      for I := 0 to N - 1 do
        Words[I] := MapReadStr(FS);
    finally
      FS.Free;
    end;
  except
    Exit;   // файл испорчен или занят - разбор как обычно
  end;

  FWindows[Index].CommentRanges := CR;
  FWindows[Index].StringRanges := SR;
  FWindows[Index].Subs := Subs;
  FWindows[Index].LineDepth := Depth;
  FWindows[Index].CompSlots := Slots;
  FWindows[Index].CompWords := Words;
  FWindows[Index].CompMask := Mask;
  FWindows[Index].CompDfmKey := DfmKey;
  FWindows[Index].MapSchemeSig := Sig;
  FWindows[Index].MapValid := True;
  FWindows[Index].MapSaved := True;
  Result := True;
end;

// Разбор окна Index - на диск, если в этом сеансе он строился заново.
// Кэш - только ускорение: не записался - в следующий раз будет разбор.
procedure TForm1.SaveMapCache(Index: Integer);
var
  FS: TFileStream;
  FN: string;
  I: Integer;
begin
  if not FWindows[Index].Used or not FWindows[Index].MapValid or
     FWindows[Index].MapSaved or (FWindows[Index].MapSchemeSig = '') or
     IsUntitledName(FWindows[Index].FileName) then
    Exit;
  FN := MapCacheFileFor(FWindows[Index].FileName);
  if not ForceDirectories(ExtractFilePath(FN)) then
    Exit;
  try
    FS := TFileStream.Create(FN, fmCreate);
    try
      MapWriteStr(FS, MapCacheSign);
      MapWriteStr(FS, MapCacheKey(FWindows[Index].Text,
                                  FWindows[Index].MapSchemeSig));
      MapWriteRanges(FS, FWindows[Index].CommentRanges);
      MapWriteRanges(FS, FWindows[Index].StringRanges);
      MapWriteInt(FS, Length(FWindows[Index].Subs));
      for I := 0 to High(FWindows[Index].Subs) do
      begin
        MapWriteStr(FS, FWindows[Index].Subs[I].Name);
        MapWriteInt(FS, FWindows[Index].Subs[I].BeginLine);
        MapWriteInt(FS, FWindows[Index].Subs[I].EndLine);
      end;
      MapWriteInts(FS, FWindows[Index].LineDepth);
      MapWriteStr(FS, FWindows[Index].CompDfmKey);
      MapWriteInt(FS, FWindows[Index].CompMask);
      MapWriteInts(FS, FWindows[Index].CompSlots);
      MapWriteInt(FS, Length(FWindows[Index].CompWords));
      for I := 0 to High(FWindows[Index].CompWords) do
        MapWriteStr(FS, FWindows[Index].CompWords[I]);
    finally
      FS.Free;
    end;
    FWindows[Index].MapSaved := True;
  except
    // Недописанный файл не оставляем
    DeleteFile(FN);
  end;
end;

// При выходе: текущее окно - в запись, потом все окна на диск
procedure TForm1.SaveAllMapCaches;
var
  I: Integer;
begin
  StoreCurrentWindow;
  for I := 0 to WindowsItemCount - 1 do
    SaveMapCache(I);
end;

procedure TForm1.StoreCurrentWindow;
var
  Sel: TCharRange;
begin
  // Карта уходит в кэш окна - она обязана быть актуальной, см. FlushMapRebuild
  FlushMapRebuild;

  if (FWindowsIndex < 0) or (FWindowsIndex > WindowsItemCount - 1) then
    Exit;
  if not FWindows[FWindowsIndex].Used then
    Exit;

  FWindows[FWindowsIndex].Text := GetEditorText;
  FWindows[FWindowsIndex].Modified := RichEdit1.Modified;
  FWindows[FWindowsIndex].IsUtf8 := FFileIsUtf8;
  FWindows[FWindowsIndex].HasBom := FFileHasBom;

  // Забираем карты и остальной разбор с собой
  StoreWindowParse(FWindowsIndex);
  // При выключенной подсветке в кэш легла бы ПУСТАЯ карта, и при возврате
  // на вкладку её приняли бы за готовую
  FWindows[FWindowsIndex].MapValid := FUseSyntaxHighlight;
  // Разбор строился заново - на диске уже не он
  if FMapRebuilt then
    FWindows[FWindowsIndex].MapSaved := False;

  if RichEdit1.HandleAllocated then
  begin
    SendMessageA(RichEdit1.Handle, EM_EXGETSEL, 0, Integer(@Sel));
    FWindows[FWindowsIndex].CursorPos := Sel.cpMin;
  end;
end;

// Показывает окно Index в редакторе
procedure TForm1.ActivateWindow(Index: Integer);
var
  // Замер по этапам (мс) - строкой в HiLite log после отрисовки: уход с
  // прежней вкладки, схема, заливка текста, карта, табуляция, обновление
  // окна (меню, вкладки, строка пути), отрисовка
  T0, TA, TLeave, TSchema, TText, TMap, TTabStops, TUi, TPaint: Cardinal;
  MapFlushed: Boolean;
  Stages, MapFrom, TabWhole: string;
  StartupTab: string;   // имя и размер вкладки - для этапов startup.log
begin
  CiHideAll;   // список и подсказки Code Insight - от прежней вкладки
  TabWhole := '';
  if (Index < 0) or (Index > WindowsItemCount - 1) then
    Exit;
  if not FWindows[Index].Used then
    Exit;
  T0 := GetTickCount;
  // Заказ пересборки карты прежней вкладки ещё висит - StoreCurrentWindow
  // выполнит его сейчас (FlushMapRebuild)
  MapFlushed := (Index <> FWindowsIndex) and (FMapTimer <> nil) and
                FMapTimer.Enabled;

  if Index <> FWindowsIndex then
  begin
    // Панель объявления относится к прежнему файлу - очистить
    FDeclMode := 0;
    DeclPanelShow;
    // Окно настроек открыто и в редакторе показаны несохранённые цвета
    // схемы - спросить, записать ли их в схему ПРЕЖНЕЙ вкладки, пока она
    // ещё активна (SaveActiveClrSchema пишет в схему активной вкладки)
    if (Form2 <> nil) and Form2.Visible then
      Form2.BeforeTabSwitch;
    // Во второй панели эта же вкладка, а последние правки ещё не дошли до
    // неё (SplitTimerTick ждёт паузы) - обновить, пока текст в редакторе
    if (FSplit <> nil) and (FSplitWin = FWindowsIndex) and
       (FEditSerial <> FSplitSerial) then
      SplitRefresh(-1);
    StoreCurrentWindow;
  end;
  TLeave := GetTickCount - T0;

  FWindowsIndex := Index;
  // У нового файла пути на диске нет - FCurrentFileName пустой, и Save
  // спросит имя. Условное имя '(без имени...)' путём не является: раньше
  // оно попадало сюда при возврате на вкладку, и Save писал файл с таким
  // именем в текущий каталог без всякого диалога.
  if IsUntitledName(FWindows[Index].FileName) then
    FCurrentFileName := ''
  else
    FCurrentFileName := FWindows[Index].FileName;
  FFileIsUtf8 := FWindows[Index].IsUtf8;
  FFileHasBom := FWindows[Index].HasBom;

  // Схема зависит от расширения, поэтому переключаем её до заливки текста.
  // Пересборку карты внутри неё подавляем: текст в редакторе пока чужой.
  //
  // Сам чужой текст перед этим убираем. Схема ставит шрифт и шаг
  // табуляции (ApplyEditorLook, ApplyTabStops), а RichEdit применяет их ко
  // всему тексту, который в нём лежит: на большом файле это больше
  // секунды. Замер: схема 1420-1436 мс при переходе с Unit1.pas на
  // Unit1.dfm, 219-234 мс - с Unit2.pas, 0-78 мс - с небольших файлов. На
  // пустом редакторе - почти ничего; новый текст ниже заливается уже с
  // новым шрифтом, табуляция - тоже до заливки, на пустом тексте.
  // Запуск: части показа вкладки - этапами в startup.log
  if StartupActive then
  begin
    StartupTab := ExtractFileName(FWindows[Index].FileName) + ' (' +
      IntToStr(Length(FWindows[Index].Text) div 1024) + ' КБ)';
    StartupStage('Вкладка ' + StartupTab + ': схема');
  end;
  TA := GetTickCount;
  Inc(FObjOwnWrite);
  FLockHighlight := True;
  try
    SetEditorText('');
  finally
    FLockHighlight := False;
    Dec(FObjOwnWrite);
  end;
  FSuppressMapRebuild := True;
  try
    LoadCustomClrSchema(WindowExt(FWindows[Index].FileName),
                        FWindows[Index].FileName);
  finally
    FSuppressMapRebuild := False;
  end;
  TSchema := GetTickCount - TA;

  // До заливки: перестройка разметки при включении режима стоит тем больше,
  // чем больше текста уже в контроле
  EnsureNoWrap;
  EnsureEventMask; // до заливки: с ENM_REQUESTRESIZE текст размечается сразу

  // Шаг табуляции - до заливки, на пустом тексте: так это почти даром, а
  // залитый текст перенимает оформление абзаца (проверка после заливки -
  // TabStopsInPlace). После заливки EM_SETPARAFORMAT на весь Unit1.pas
  // стоил ~90 мс.
  TA := GetTickCount;
  ApplyTabStops;
  TTabStops := GetTickCount - TA;

  // Заливка текста вкладки - не правка: номера строк узлов инспектора
  // относятся к этому же тексту
  if StartupActive then
    StartupStage('Вкладка ' + StartupTab + ': текст в редактор');
  TA := GetTickCount;
  Inc(FObjOwnWrite);
  FLockHighlight := True;
  try
    SetEditorText(FWindows[Index].Text);
  finally
    FLockHighlight := False;
    Dec(FObjOwnWrite);
  end;
  FObjLoadLen := TextLenInternal;
  FObjLoadPending := True;

  RichEdit1.Modified := FWindows[Index].Modified;
  RichEdit1.SelStart := FWindows[Index].CursorPos;
  RichEdit1.SelLength := 0;
  TText := GetTickCount - TA;

  // Разбор текста для отрисовки (карта, список подпрограмм, уровни строк,
  // имена компонентов) - из записи окна, если текст с тех пор не менялся;
  // иначе из файла кэша на диске; иначе строится заново (см. «Кэш разбора
  // текста»). Таблицу подпрограмм в правой панели FillSubListView на это
  // время не заполняет (FTabSwitching), её заполнит WMTabSwitched.
  if StartupActive then
    StartupStage('Вкладка ' + StartupTab + ': карта');
  TA := GetTickCount;
  FTabSwitching := True;
  FMapRebuilt := False;
  try
    // Карта в памяти годится, если построена по той же схеме: после
    // сохранения схемы (SaveClrSchemaTo) подпись другая - разбор заново
    if FWindows[Index].MapValid and
       ((FWindows[Index].MapSchemeSig = '') or
        (FWindows[Index].MapSchemeSig =
         MapSchemeSig(FWindows[Index].FileName))) then
    begin
      MapFrom := 'из памяти';
      RestoreWindowParse(Index);
    end
    else if LoadMapCache(Index) then
    begin
      MapFrom := 'с диска';
      RestoreWindowParse(Index);
    end
    else
    begin
      MapFrom := 'разбор';
      RebuildCommentRangeMap;
      StoreWindowParse(Index);
      FWindows[Index].MapValid := True;
      FWindows[Index].MapSaved := False;
    end;
    // Заливка текста сменила число строк, и RichEdit1Change заказал
    // пересборку карты (ScheduleMapRebuild). Разбор выше - по этому же
    // тексту, заказ лишний: он пересобрал бы всё ещё раз по таймеру, уже
    // после показа.
    if FMapTimer <> nil then
      FMapTimer.Enabled := False;
  finally
    FTabSwitching := False;
  end;
  Inc(FMapVer);
  // Карта вкладки - под маркеры её схемы, загруженной выше
  FMapMarkersSig := FScheme.MarkersSig;
  TMap := GetTickCount - TA;
  if StartupActive then
  begin
    StartupStageNote(' (' + MapFrom + ')');
    StartupStage('Вкладка ' + StartupTab + ': табуляция, окно');
  end;

  // Шаг табуляции поставлен до заливки, на пустом тексте (см. выше), и
  // новый текст его перенял - на весь текст не ставим. Не перенял -
  // ставим как раньше.
  TA := GetTickCount;
  if TabStopsInPlace then
  begin
    ApplyTabStopsEx(False);
    TabWhole := 'перенята';
  end
  else
  begin
    ApplyTabStops;
    TabWhole := 'на весь текст';
  end;
  TTabStops := TTabStops + (GetTickCount - TA);
  TA := GetTickCount;

  Caption := AppTitle + ' - ' + DisplayName;
  RichEdit1.Invalidate;
  UpdateLineNumbers;
  UpdateStatusBarInfo;
  RebuildWindowsMenu;
  BmValidateWindow(Index); // номера строк закладок - по нынешнему тексту
  RebuildBookmarksMenu; // закладки свои у каждого окна
  UpdatePathBar;
  EnsureTab(Index);     // вкладка появляется при первом показе окна

  // Присваивание Lines.Text выше само взвело Modified, и RichEdit1Change успел
  // поставить звёздочку на подпись. Флаг мы уже вернули в исходное состояние -
  // осталось переписать подпись, иначе на вкладке остаётся ложная звёздочка.
  FTabsModShown := RichEdit1.Modified;
  UpdateTabCaption(Index);

  // Отметка найденной строки - от прежней вкладки
  FFoundLine := -1;

  // Includes или Headers - по языку файла
  UpdateRightPanelCaptions;
  TUi := GetTickCount - TA;

  // Текст новой вкладки - на экран сейчас, с подсветкой: её рисует
  // отрисовка редактора. Разборы для правой панели (таблица подпрограмм,
  // инспектор, дерево кода) - после показа, сообщением WMTabSwitched: иначе
  // до их конца на экране оставался бы текст прежней вкладки. Отрисовку
  // вызываем сами: WM_PAINT в очереди идёт после отправленных сообщений,
  // и вторая половина началась бы раньше неё.
  if StartupActive then
    StartupStage('Вкладка ' + StartupTab + ': отрисовка');
  TA := GetTickCount;
  RichEdit1.Update;
  if PaintBox1 <> nil then
    PaintBox1.Update;
  if FTabs <> nil then
    FTabs.Update;
  TPaint := GetTickCount - TA;
  FTabShowMs := GetTickCount - T0;
  Inc(FTabSwitchGen);
  PostMessage(Handle, WM_USER + 319, Index, FTabSwitchGen);

  Stages := 'уход ' + IntToStr(TLeave);
  if MapFlushed then
    Stages := Stages + ' (из них пересборка карты прежней вкладки)';
  Dbg('5364: вкладка ' + ExtractFileName(FWindows[Index].FileName) +
  ': показ ' + IntToStr(FTabShowMs) + ' мс (' + Stages + ', схема ' +
      IntToStr(TSchema) + ', текст ' + IntToStr(TText) + ', карта ' +
      IntToStr(TMap) + ' ' + MapFrom + ', табуляция ' + IntToStr(TTabStops) + ' ' + TabWhole + ', окно ' +
      IntToStr(TUi) + ', отрисовка ' + IntToStr(TPaint) + ')', clGray);

  // Перевод RqToFb (_rqfb) - только для чтения: его пересоздаёт сборка
  FRqFbTab := RqFbIsGenerated(FWindows[Index].FileName);
  RichEdit1.ReadOnly := FRqFbTab;
  if FRqFbTab then
    StatusBar1.Panels[0].Text := 'Перевод RapidQ (_rqfb) - только чтение';

  // Вкладка в виде "по формату" - просмотр поверх редактора; у
  // остальных вкладок просмотр убирается
  FmtApplyTab;

  // Таблица окна настроек - под схему новой вкладки. Иначе OK записал бы
  // таблицу прежней схемы в схему этой вкладки.
  if (Form2 <> nil) and Form2.Visible then
    Form2.AfterTabSwitch;
end;

// Создаёт постоянные пункты подменю Windows. Верхние четыре - управление
// списком; пока это заглушки, поведение допишем позже.
procedure TForm1.BuildWindowsMenu;
begin
  mWinFindDisabled.Hint :=
  'Искать потерянные файлы рядом с программой и в горячих папках';

  // Подписи здесь - это пути к файлам, ускорители в них только мешают
mWindows.AutoHotkeys := maManual;
  mWinDeleteDisabled.OnClick := RemoveMissingClick;

  RebuildWindowsMenu;
end;

// Красный крестик 16x16 для потерянных файлов. Рисуем сами - тащить ради
// двух линий картинку в ресурсы незачем.
procedure TForm1.MakeBrokenGlyph;
begin
  FBrokenGlyph := TBitmap.Create;
  FBrokenGlyph.Width := 16;
  FBrokenGlyph.Height := 16;

  with FBrokenGlyph.Canvas do
  begin
    // Фон под цвет меню: прозрачности у картинки пункта нет
    Brush.Color := clBtnFace;
    FillRect(Rect(0, 0, 16, 16));
    Pen.Color := clRed;
    Pen.Width := 2;
    MoveTo(4, 4);  LineTo(12, 12);
    MoveTo(12, 4); LineTo(4, 12);
  end;
end;

// Перестраивает список файлов под постоянными пунктами
procedure TForm1.RebuildWindowsMenu;
var
  I, N: Integer;
  It: TMenuItem;
begin
  if (mWindows = nil) or (mWinSep = nil) then
    Exit;

  // Удаляем только пункты списка: постоянные идут до разделителя,
  // поэтому считаем от его позиции и вниз
  while mWindows.Count > mWinSep.MenuIndex + 1 do
    mWindows.Items[mWindows.Count - 1].Free;

  N := 0;
  for I := 0 to WindowsItemCount - 1 do
    if FWindows[I].Used then
    begin
      Inc(N);
      It := TMenuItem.Create(Self);
      It.Caption := Format('%d %s', [N, FWindows[I].FileName]);
      It.Tag := I; // индекс слота, а не номер в списке
      It.OnClick := WindowsItemClick;
      It.RadioItem := True;
      It.Checked := (I = FWindowsIndex);

      // Потерянный файл НЕ гасим: по серому пункту не кликнуть, а сказать
      // о пропаже надо. Вместо этого красный крестик и сообщение по клику.
      if FWindows[I].Broken then
      begin
        if FBrokenGlyph <> nil then
          It.Bitmap.Assign(FBrokenGlyph);
        It.Hint := 'Файл не найден: ' + FWindows[I].FileName;
      end;

      mWindows.Add(It);
    end;

  if N = 0 then
  begin
    It := TMenuItem.Create(Self);
    It.Caption := '(no files)';
    It.Enabled := False;
    mWindows.Add(It);
  end;

  if mWinClose <> nil then
    mWinClose.Caption := Format('%d: Close Window %d',
                                [RichEdit1.GetTextLen, FWindowsIndex + 1]);
end;

// Помечает кэш карт недействительным у всех окон. Нужно после правки
// цветовой схемы: маркеры комментариев и строк могли измениться, и старые
// карты описывают текст уже по другим правилам.
procedure TForm1.InvalidateAllWindowMaps;
var
  I: Integer;
begin
  for I := 0 to WindowsItemCount - 1 do
  begin
    FWindows[I].MapValid := False;
    SetLength(FWindows[I].CommentRanges, 0);
    SetLength(FWindows[I].StringRanges, 0);
  end;
end;

procedure TForm1.WindowsItemClick(Sender: TObject);
var
  W: Integer;
begin
  if not (Sender is TMenuItem) then
    Exit;

  // Файла нет на диске - переключаться некуда. Вместо сухого сообщения сразу
  // запускаем поиск, а если и он ни с чем - открываем список папок.
  W := TMenuItem(Sender).Tag;
  if (W >= 0) and (W <= WindowsItemCount - 1) and
     FWindows[W].Used and FWindows[W].Broken then
  begin
    // Молчаливая попытка: файл мог вернуться на место сам, да и обход папки
    // над программой делается здесь же
    if RelocateBrokenWindows = 0 then
    begin
      ShowMessage('4961:Файл не найден:'#13#10 + FWindows[W].FileName + #13#10#13#10 +
      'Рядом с программой и в папке' + #13#10 + ParentOfExeDir + #13#10 +
      'его тоже нет. Сейчас откроется список папок для поиска.');

                  ShowHotFolders(ParentOfExeDir);
                  RelocateBrokenWindows;
    end;

    // Нашёлся именно он - открываем, раз уж по нему и кликали
    if FWindows[W].Used and not FWindows[W].Broken then
      ActivateWindow(W)
    else
      ShowMessage('4973:Этот файл найти не удалось.');

    Exit;
  end;

  if TMenuItem(Sender).Tag = FWindowsIndex then
    Exit; // уже в этом окне
  // Переключение окна ничего не закрывает - сохранить не спрашиваем
  ActivateWindow(TMenuItem(Sender).Tag);
end;


// ---------------------------------------------------------------------------
//  Проекты
//
//  Проект - это список открытых окон плюс настройки. Хранится так:
//      projects\<Имя>\<Имя>.prj
//  Файл в формате ini, разделы [Editor], [Compiler], [Windows], [Bookmarks].
//  Имя папки и есть имя проекта - оно же попадает в меню Projects.
// ---------------------------------------------------------------------------

// Срезает хвостовой комментарий после ';'.
//
// WinAPI-функции работы с ini игнорируют только строки, которые НАЧИНАЮТСЯ
// с ';', а комментарий после значения возвращается как его часть. В рабочих
// .prj комментариев нет, но для ЧИСЛОВЫХ полей обрезка безвредна и страхует
// от правки файла вручную.
//
// К путям её применять НЕЛЬЗЯ: точка с запятой в имени файла в Windows
// допустима, и такой путь оказался бы обрезан.
function StripIniComment(const S: string): string;
var
  P: Integer;
begin
  Result := S;
  P := Pos(';', Result);
  if P > 0 then
    Result := Copy(Result, 1, P - 1);
  Result := Trim(Result);
end;

// ---------------------------------------------------------------------------
//  Поиск по картам комментариев и строк
//
//  Диапазоны в CommentRanges и StringRanges идут по возрастанию StartPos -
//  RebuildCommentRangeMap строит их одним проходом слева направо. Значит можно
//  искать двоично вместо перебора.
//
//  Это не микрооптимизация: проверки вызываются на КАЖДЫЙ токен каждой видимой
//  строки, а FindBlockStartFrom раньше перебирал весь массив на каждый символ.
//  На файле с тысячей комментариев это миллионы итераций на один кадр, отчего
//  прокрутка и отставала от колеса мыши.
// ---------------------------------------------------------------------------

// Попадает ли символ внутрь какого-нибудь диапазона
function InRanges(const Arr: TCommentRangeArray; CharIndex: Integer): Boolean;
var
  Lo, Hi, Mid: Integer;
begin
  Result := False;
  Lo := 0;
  Hi := High(Arr);
  while Lo <= Hi do
  begin
    Mid := (Lo + Hi) div 2;
    if CharIndex < Arr[Mid].StartPos then
      Hi := Mid - 1
    else if CharIndex >= Arr[Mid].EndPos then
      Lo := Mid + 1
    else
    begin
      Result := True;
      Exit;
    end;
  end;
end;

// Индекс первого диапазона, начинающегося не раньше CharIndex, или -1
function FirstRangeFrom(const Arr: TCommentRangeArray; CharIndex: Integer): Integer;
var
  Lo, Hi, Mid: Integer;
begin
  Result := -1;
  Lo := 0;
  Hi := High(Arr);
  while Lo <= Hi do
  begin
    Mid := (Lo + Hi) div 2;
    if Arr[Mid].StartPos >= CharIndex then
    begin
      Result := Mid;
      Hi := Mid - 1;
    end
    else
      Lo := Mid + 1;
  end;
end;

// Ведущее число значения или 0, если его там нет
function LeadingNumber(const S: string): Integer;
var
  P: Integer;
  Tmp: string;
begin
  Tmp := Trim(S);
  P := Pos(' ', Tmp);
  if P > 1 then
    Result := StrToIntDef(Copy(Tmp, 1, P - 1), 0)
  else
    Result := StrToIntDef(Tmp, 0);
end;

// "1 C:\bas\file.bas" -> "C:\bas\file.bas".
// Номер в начале значения - это порядковый номер пункта в меню Windows.
// Отрезаем только число в начале и только если за ним пробельный знак: в
// пути вполне могут быть пробелы, как в "RQ IDE". Пробельный - не только
// пробел: в старых .prj после номера встречается неразрывный пробел #160.
function StripLeadingNumber(const S: string): string;
var
  P: Integer;
begin
  Result := Trim(S);
  P := 1;
  while (P <= Length(Result)) and (Result[P] in ['0'..'9']) do
    Inc(P);
  if (P > 1) and (P <= Length(Result)) and
     (Result[P] in [#1..#32, #160]) then
    Result := Trim(Copy(Result, P + 1, Length(Result)));
  // Trim не снимает #160 - на случай нескольких разделителей подряд
  while (Result <> '') and (Result[1] = #160) do
    Delete(Result, 1, 1);
end;

// --- Пути в разделе проекта ---------------------------------------------
//
// Проект - раздел [Project.<имя>] editor.ini (PrjStore), а editor.ini у
// каждого компьютера свой: пути окон и вкладок пишутся полными. В прежних
// описаниях .prj они бывают относительными - от папки .prj; их переводит в
// полные перенос (ImportPrjFile). Читаются оба вида.

// Путь - полный: относительный считается от папки APrjFile (файл .prj или
// папка проекта с \ в конце)
function PrjPathFromStore(const APrjFile, APath: string): string;
begin
  Result := Trim(APath);
  if (Result = '') or (APrjFile = '') then
    Exit;
  if (ExtractFileDrive(Result) <> '') or (Result[1] = '') then
    Exit;
  Result := ExpandFileName(ExtractFilePath(ExpandFileName(APrjFile)) + Result);
end;

// ---------------------------------------------------------------------------
//  Скетч Arduino - в папке своего имени
//
//  arduino-cli собирает папку, в которой главный файл называется как папка:
//  SketchBook\BalA-190-1\BalA-190-1.ino. Поэтому, как в Arduino IDE:
//  - сохранение .ino из диалога (Save, Save As) кладёт файл в папку его
//    имени внутри выбранной, папку создаёт (SketchSavePath);
//  - открытие .ino, лежащего не так, и сборка такого скетча предлагают
//    перенести его в папку своего имени (AskMoveSketchHome, MoveSketchHome).
//  Дополнительные .ino в папке скетча (вкладки скетча) не трогаются.
// ---------------------------------------------------------------------------

// Путь записи скетча, выбранного в диалоге сохранения под именем AFile.
// Выбрана папка другого скетча - вопрос: отдельный скетч или
// дополнительный файл этого. '' - отмена.
function TForm1.SketchSavePath(const AFile: string): string;
var
  Home, Dir, Folder: string;
begin
  Result := AFile;
  if not IsSketchExt(AFile) then
    Exit;
  Home := SketchHomePath(AFile);
  if CompareText(Home, AFile) = 0 then
    Exit;
  Dir := ExtractFilePath(AFile);
  if IsSketchFolder(Dir) then
  begin
    Folder := ExtractFileName(ExcludeTrailingPathDelimiter(Dir));
    case MessageDlg('Папка ' + Folder + ' - скетч ' + Folder + '.'#13#10#13#10 +
                    'Да - сохранить отдельным скетчем:'#13#10 + Home +
                    #13#10#13#10'Нет - сохранить дополнительным файлом ' +
                    'скетча ' + Folder + ':'#13#10 + AFile,
                    mtConfirmation, [mbYes, mbNo, mbCancel], 0) of
      mrYes:
        ;
      mrNo:
        Exit;
    else
      begin
        Result := '';
        Exit;
      end;
    end;
  end;
  if FileExists(Home) and
     (MessageDlg('Файл уже есть:'#13#10 + Home + #13#10#13#10'Заменить его?',
                 mtConfirmation, [mbYes, mbNo], 0) <> mrYes) then
  begin
    Result := '';
    Exit;
  end;
  if not ForceDirectories(ExtractFilePath(Home)) then
  begin
    ShowMessage('Не удалось создать папку скетча:'#13#10 +
                ExtractFilePath(Home));
    Result := '';
    Exit;
  end;
  Result := Home;
  LogComp('Скетч сохраняется в папку своего имени: ' + Home);
end;

// Вопрос перед переносом скетча AFile в папку своего имени
function TForm1.AskMoveSketchHome(const AFile: string): Boolean;
begin
  Result := MessageDlg('Скетч Arduino лежит не в папке своего имени - ' +
                       'arduino-cli его не соберёт:'#13#10 + AFile +
                       #13#10#13#10'Создать папку ' +
                       ChangeFileExt(ExtractFileName(AFile), '') +
                       ' и перенести файл туда?'#13#10 +
                       SketchHomePath(AFile),
                       mtConfirmation, [mbYes, mbNo], 0) = mrYes;
end;

// Запись окна AWinIdx в разделе проекта (Windows win<N>, вкладки Tabs) -
// с пути AOldFile на ANewFile. Остальной раздел проекта не меняется.
procedure TForm1.ProjectRepointWindow(AWinIdx: Integer;
                                      const AOldFile, ANewFile: string);
var
  Ini: TProjectIni;
  PrjDir, Raw, NewRaw: string;
  TabIdx, TabCount: Integer;

  // "<номер> <путь>" с путём AOldFile -> тот же номер и ANewFile;
  // '' - запись о другом файле
  function RepointValue(const AValue: string): string;
  var
    Stored, NumText: string;
    DigitEnd: Integer;
  begin
    Result := '';
    Stored := PrjPathFromStore(PrjDir, StripLeadingNumber(AValue));
    if CompareText(ExpandFileName(Stored), ExpandFileName(AOldFile)) <> 0 then
      Exit;
    DigitEnd := 0;
    while (DigitEnd < Length(AValue)) and
          (AValue[DigitEnd + 1] in ['0'..'9']) do
      Inc(DigitEnd);
    NumText := Copy(AValue, 1, DigitEnd);
    if NumText = '' then
      Result := ANewFile
    else
      Result := NumText + ' ' + ANewFile;
  end;

begin
  if (FCurrentProject = '') or not ProjectExists(FCurrentProject) then
    Exit;
  PrjDir := ProjectDir(FCurrentProject);
  Ini := TProjectIni.Create(SettingsFileName, FCurrentProject);
  try
    Raw := Trim(Ini.ReadString('Windows', 'win' + IntToStr(AWinIdx), ''));
    if Raw <> '' then
    begin
      NewRaw := RepointValue(Raw);
      if NewRaw <> '' then
        Ini.WriteString('Windows', 'win' + IntToStr(AWinIdx), NewRaw);
    end;
    TabCount := StrToIntDef(StripIniComment(
                  Ini.ReadString('Tabs', 'TabCount', '0')), 0);
    for TabIdx := 0 to TabCount - 1 do
    begin
      Raw := Trim(Ini.ReadString('Tabs', IntToStr(TabIdx), ''));
      if Raw = '' then
        Continue;
      NewRaw := RepointValue(Raw);
      if NewRaw <> '' then
        Ini.WriteString('Tabs', IntToStr(TabIdx), NewRaw);
    end;
  finally
    Ini.Free;     // записывает раздел, если он изменился
  end;
end;

// Переносит скетч AFile в папку своего имени (SketchHomePath) и переводит
// на новый путь окно с ним, запись окна в проекте, список недавних и
// отметку для проверки изменений на диске. Результат - новый путь, '' -
// не перенесён (причина - сообщением).
function TForm1.MoveSketchHome(const AFile: string): string;
var
  Home, OldKey, NewKey: string;
  WinIdx, AgeIdx, RecentIdx: Integer;
  PrjWasSaved: Boolean;
begin
  Result := '';
  Home := SketchHomePath(AFile);
  if CompareText(Home, AFile) = 0 then
  begin
    Result := AFile;
    Exit;
  end;
  if FileExists(Home) then
  begin
    ShowMessage('Файл не перенесён: в папке скетча уже есть'#13#10 + Home);
    Exit;
  end;
  if not ForceDirectories(ExtractFilePath(Home)) then
  begin
    ShowMessage('Не удалось создать папку скетча:'#13#10 +
                ExtractFilePath(Home));
    Exit;
  end;

  // Окно ищем до переноса: после него старого файла на диске нет
  WinIdx := IndexOfWindowByFile(AFile);
  PrjWasSaved := (FCurrentProject <> '') and
                 (ProjectSignature = FProjectSig);

  if not MoveFile(PChar(AFile), PChar(Home)) then
  begin
    ShowMessage('Не удалось перенести'#13#10 + AFile + #13#10'в'#13#10 +
                Home + #13#10#13#10 + SysErrorMessage(GetLastError));
    Exit;
  end;
  Result := Home;
  LogComp('Скетч перенесён в папку своего имени: ' + AFile + ' -> ' + Home);

  // Отметка проверки диска - под новым ключом. Время записи файла
  // MoveFile не меняет, текст с диска тот же
  if FDiskAges <> nil then
  begin
    OldKey := AnsiUpperCase(ExpandFileName(AFile));
    NewKey := AnsiUpperCase(ExpandFileName(Home));
    AgeIdx := FDiskAges.IndexOfName(OldKey);
    if AgeIdx >= 0 then
      FDiskAges[AgeIdx] := NewKey + '=' + FDiskAges.ValueFromIndex[AgeIdx];
  end;

  if WinIdx >= 0 then
  begin
    FWindows[WinIdx].FileName := Home;
    if WinIdx = FWindowsIndex then
      FCurrentFileName := Home;
    ProjectRepointWindow(WinIdx, AFile, Home);
    // Проект был сохранён - после правки его записи он и остаётся
    // сохранённым, вопроса при выходе не будет
    if PrjWasSaved then
      FProjectSig := ProjectSignature;
  end;

  if FRecentFiles <> nil then
  begin
    for RecentIdx := 0 to FRecentFiles.Count - 1 do
      if CompareText(FRecentFiles[RecentIdx], AFile) = 0 then
        FRecentFiles[RecentIdx] := Home;
    RebuildReopenMenu;
    SaveSettings;
  end;

  if WinIdx >= 0 then
  begin
    RefreshAllTabCaptions;
    RebuildWindowsMenu;
    if WinIdx = FWindowsIndex then
    begin
      UpdatePathBar;
      Form1.Caption := AppTitle + ' - ' + ExtractFileName(Home);
      UpdateBuildBar;
    end;
  end;
end;

// Цель сборки в разделе проекта ([Project.<имя>] Target): файл в папке
// проекта - от неё, с \ в начале (\BalKom1A.dpr), иначе - полный путь
function PrjTargetToStore(const ADir, APath: string): string;
var
  Dir: string;
begin
  Result := APath;
  if (ADir = '') or (APath = '') then
    Exit;
  Dir := IncludeTrailingPathDelimiter(ADir);
  if AnsiStartsText(Dir, APath) then
    Result := '\' + Copy(APath, Length(Dir) + 1, MaxInt);
end;

function PrjTargetFromStore(const ADir, AValue: string): string;
begin
  Result := Trim(AValue);
  if (Result = '') or (ADir = '') then
    Exit;
  if (Result[1] = '\') and (Copy(Result, 1, 2) <> '\\') then
    Result := IncludeTrailingPathDelimiter(ADir) + Copy(Result, 2, MaxInt)
  else
    Result := PrjPathFromStore(IncludeTrailingPathDelimiter(ADir), Result);
end;


function TForm1.ProjectsDir: string;
begin
  Result := ExtractFilePath(Application.ExeName) + 'projects\';
end;

// --- Проверка путей в editor.ini ------------------------------------------
//
// Значение - путь, если начинается с буквы диска (C:\) или с \\ (сеть).
// Список через ";" (LibPath, BrowsePath) - несколько путей.

function IniIsPath(const S: string): Boolean;
var
  T: string;
begin
  T := Trim(S);
  Result := ((Length(T) >= 3) and (UpCase(T[1]) in ['A'..'Z']) and
             (T[2] = ':') and (T[3] = '\')) or (Copy(T, 1, 2) = '\\');
end;

// Сколько путей значения есть на диске, и сколько путей в нём всего
procedure IniPathCount(const AValue: string; var AExist, ATotal: Integer);
var
  S, P: string;
  I: Integer;
begin
  AExist := 0;
  ATotal := 0;
  S := AValue + ';';
  repeat
    I := Pos(';', S);
    P := Trim(Copy(S, 1, I - 1));
    Delete(S, 1, I);
    if IniIsPath(P) then
    begin
      Inc(ATotal);
      if DirectoryExists(P) or FileExists(P) then
        Inc(AExist);
    end;
  until S = '';
end;

// Значение из строки "Имя=значение"
function IniValueOf(const ALine: string): string;
begin
  Result := Copy(ALine, Pos('=', ALine) + 1, MaxInt);
end;

// Раздел - сохранённая копия другого: имя кончается на Old и номер
// (ProjectsOld1, Compiler.Delphi.Delphi 7Old2)
function IniIsOldSection(const AName: string): Boolean;
var
  I: Integer;
begin
  Result := False;
  I := Length(AName);
  while (I > 0) and (AName[I] in ['0'..'9']) do
    Dec(I);
  if I = Length(AName) then
    Exit; // нет номера
  Result := (I > 3) and (CompareText(Copy(AName, I - 2, 3), 'Old') = 0);
end;

// Раздел без данных: ключей нет или у всех пустые значения
function IniSectionEmpty(AValues: TStrings): Boolean;
var
  Index: Integer;
begin
  Result := True;
  for Index := 0 to AValues.Count - 1 do
    if Trim(IniValueOf(AValues[Index])) <> '' then
    begin
      Result := False;
      Exit;
    end;
end;

// editor.ini при сборке самого редактора: ASrc - из папки .dpr, ADst -
// рядом с собранным exe, его правила запущенная копия.
//
// Настройки запущенной копии не затираются. Из ASrc:
//   - раздел, которого в ADst нет, - копируется целиком;
//   - раздел есть - дописываются ключи, которых в ADst нет и значение
//     которых не путь (новые параметры). Копии [<Раздел>Old<N>] больше не
//     создаются: они копились годами; разобрать прежние - Tidy editor.ini
//     (IniTidy);
//   - копии [<Раздел>Old<N>] из ASrc и разделы без данных не переносятся.
// Возвращает число изменений в ADst.
function TForm1.MergeOwnSettings(const ASrc, ADst: string): Integer;
var
  SrcIni, DstIni: TMemIniFile;
  SrcSects, SrcValues: TStringList;
  SectIdx, KeyIdx, PathExist, PathTotal: Integer;
  Sect, KeyName, Value: string;
begin
  Result := 0;
  SrcIni := TMemIniFile.Create(ASrc);
  DstIni := TMemIniFile.Create(ADst);
  SrcSects := TStringList.Create;
  SrcValues := TStringList.Create;
  try
    SrcIni.ReadSections(SrcSects);
    for SectIdx := 0 to SrcSects.Count - 1 do
    begin
      Sect := SrcSects[SectIdx];
      // Папка программы и проекты - свои у каждого editor.ini (PrjStore):
      // из editor.ini папки .dpr не переносятся
      if (CompareText(Sect, IniPathSection) = 0) or
         (CompareText(Copy(Sect, 1, 8), 'Projects') = 0) or
         (CompareText(Copy(Sect, 1, Length(ProjectSectionPrefix)),
                      ProjectSectionPrefix) = 0) or
         IniIsOldSection(Sect) then
        Continue;
      SrcIni.ReadSectionValues(Sect, SrcValues);
      if IniSectionEmpty(SrcValues) then
        Continue;

      // Раздела в ADst нет - целиком
      if not DstIni.SectionExists(Sect) then
      begin
        for KeyIdx := 0 to SrcValues.Count - 1 do
          DstIni.WriteString(Sect, SrcValues.Names[KeyIdx],
                             IniValueOf(SrcValues[KeyIdx]));
        Inc(Result);
        LogComp('editor.ini рядом с exe: добавлен раздел [' + Sect + ']');
        Continue;
      end;

      // Новые параметры (не пути) - в тот же раздел
      for KeyIdx := 0 to SrcValues.Count - 1 do
      begin
        KeyName := SrcValues.Names[KeyIdx];
        Value := IniValueOf(SrcValues[KeyIdx]);
        if (KeyName = '') or DstIni.ValueExists(Sect, KeyName) or
           (Trim(Value) = '') then
          Continue;
        IniPathCount(Value, PathExist, PathTotal);
        if PathTotal > 0 then
          Continue;
        DstIni.WriteString(Sect, KeyName, Value);
        Inc(Result);
        LogComp('editor.ini рядом с exe: [' + Sect + '] добавлен ключ ' +
                KeyName);
      end;
    end;

    if Result > 0 then
      DstIni.UpdateFile;
  finally
    SrcValues.Free;
    SrcSects.Free;
    DstIni.Free;
    SrcIni.Free;
  end;
end;

// Раз за запуск, до чтения настроек. Для каждого раздела editor.ini, у
// которого остались копии [<Раздел>Old<N>] (их делали прежние версии;
// новые копии не создаются, разобрать прежние - Tidy editor.ini):
//   1. Значение-путь, которого нет на диске (из списка через ";" - хотя бы
//      один путь), заменяется значением из копии, где путей на диске
//      больше; копии - от новых к старым.
//   2. Ключи, которых в разделе нет, а в копии они есть и все их пути
//      на диске, дописываются в раздел.
// Пустые копии (все значения пустые) удаляются. Что сделано - в
// FIniPathLog, в HiLite log при старте окна.
// TMemIniFile, а не TIniFile: TIniFile.ReadString режет на длине 2047
// знаков, BrowsePath и длиннее.
procedure TForm1.CheckIniPaths;
var
  Ini: TMemIniFile;
  Sects, Cur, Olds, Keys: TStringList;
  SectIdx, OldIdx, KeyIdx, SortIdx, OldNum, PathExist, PathTotal, BestExist,
  OldExist, OldTotal: Integer;
  Sect, Key, Value, OldValue, Best, BestFrom: string;
  Changed: Boolean;
begin
  if not FileExists(SettingsFileName) then
    Exit;
  Changed := False;
  Ini := TMemIniFile.Create(SettingsFileName);
  Sects := TStringList.Create;
  Cur := TStringList.Create;
  Olds := TStringList.Create;
  Keys := TStringList.Create;
  try
    Ini.ReadSections(Sects);
    for SectIdx := 0 to Sects.Count - 1 do
    begin
      Sect := Sects[SectIdx];
      if IniIsOldSection(Sect) then
      begin
        // Копия без единого значения - удаляется
        Ini.ReadSectionValues(Sect, Cur);
        if IniSectionEmpty(Cur) then
        begin
          Ini.EraseSection(Sect);
          Changed := True;
          FIniPathLog.Add('editor.ini [' + Sect + ']: пустая копия удалена');
        end;
        Continue;
      end;
      Ini.ReadSectionValues(Sect, Cur);

      // копии этого раздела, от новых к старым
      Olds.Clear;
      for OldIdx := 0 to Sects.Count - 1 do
        if (CompareText(Copy(Sects[OldIdx], 1, Length(Sect) + 3),
                        Sect + 'Old') = 0) and
           (Length(Sects[OldIdx]) > Length(Sect) + 3) then
        begin
          OldNum := StrToIntDef(Copy(Sects[OldIdx], Length(Sect) + 4,
                                     MaxInt), 0);
          if OldNum > 0 then
            Olds.AddObject(Sects[OldIdx], TObject(OldNum));
        end;
      if Olds.Count = 0 then
        Continue;
      for OldIdx := 0 to Olds.Count - 1 do
        for SortIdx := 0 to Olds.Count - 2 - OldIdx do
          if Integer(Olds.Objects[SortIdx]) <
             Integer(Olds.Objects[SortIdx + 1]) then
            Olds.Exchange(SortIdx, SortIdx + 1);

      // 1. пути, которых нет, - из копии, где их на диске больше
      for KeyIdx := 0 to Cur.Count - 1 do
      begin
        Key := Cur.Names[KeyIdx];
        Value := IniValueOf(Cur[KeyIdx]);
        IniPathCount(Value, PathExist, PathTotal);
        if (PathTotal = 0) or (PathExist = PathTotal) then
          Continue;
        BestExist := PathExist;
        Best := '';
        BestFrom := '';
        for OldIdx := 0 to Olds.Count - 1 do
        begin
          OldValue := Ini.ReadString(Olds[OldIdx], Key, '');
          if OldValue = '' then
            Continue;
          IniPathCount(OldValue, OldExist, OldTotal);
          if OldExist > BestExist then
          begin
            BestExist := OldExist;
            Best := OldValue;
            BestFrom := Olds[OldIdx];
          end;
        end;
        if Best <> '' then
        begin
          Ini.WriteString(Sect, Key, Best);
          Changed := True;
          FIniPathLog.Add('editor.ini [' + Sect + '] ' + Key +
          ': путь восстановлен из [' + BestFrom + ']');
        end;
      end;

      // 2. ключи, которых в разделе нет, а в копии они есть и на диске
      for OldIdx := 0 to Olds.Count - 1 do
      begin
        Ini.ReadSection(Olds[OldIdx], Keys);
        for KeyIdx := 0 to Keys.Count - 1 do
        begin
          Key := Keys[KeyIdx];
          if Ini.ValueExists(Sect, Key) then
            Continue;
          OldValue := Ini.ReadString(Olds[OldIdx], Key, '');
          IniPathCount(OldValue, OldExist, OldTotal);
          if (OldTotal > 0) and (OldExist = OldTotal) then
          begin
            Ini.WriteString(Sect, Key, OldValue);
            Changed := True;
            FIniPathLog.Add('editor.ini [' + Sect + '] ' + Key +
            ': дописан из [' + Olds[OldIdx] + ']');
          end;
        end;
      end;
    end;

    if Changed then
      Ini.UpdateFile;
  finally
    Keys.Free;
    Olds.Free;
    Cur.Free;
    Sects.Free;
    Ini.Free;
  end;
end;

// Проекты, чей .prj не найден по пути из [Projects]. Кандидаты - текущий
// путь и пути из всех копий раздела ([ProjectsOld1], [ProjectsOld2] ...):
//   1. путь из копии, по которому файл есть, - берётся как есть;
//   2. иначе для каждого кандидата - поиск переехавшего файла тем же
//      RelocateFile, что и для файлов проекта: рядом с программой, в папке
//      выше неё, в отмеченных горячих папках. Папка найденного .prj должна
//      называться так же, как прежняя, - чужой одноимённый не подхватится.
// Найденное записывается в [Projects], и меню проектов строится заново.
// В HiLite log - что откуда взято.
procedure TForm1.RelocateMissingProjects;
var
  Index: Integer;
  Dir: string;
begin
  // Проекты лежат в editor.ini своего компьютера (SelectEditorIni) - их
  // папки искать по копиям не нужно; ненайденные - строкой в журнал
  if FProjectReg = nil then
    LoadProjectReg;
  for Index := 0 to FProjectReg.Count - 1 do
  begin
    Dir := FProjectReg.ValueFromIndex[Index];
    if (FProjectReg.Names[Index] <> '') and (Dir <> '') and
       not DirectoryExists(Dir) then
      LogDiag('Проект ' + FProjectReg.Names[Index] + ': папки ' + Dir +
      ' нет на диске');
  end;
end;

// Описание .prj (прежний формат проекта, он же у RQdebugger) - в раздел
// [Project.<имя>] editor.ini: [Project] - ключи как есть, остальные разделы
// - с приставкой "<раздел>_" (TProjectIni). Пути окон и вкладок - полными
// (в .prj они бывают от его папки), цель сборки - от папки проекта
// (\Имя.dpr). AFolder - папка проекта: на входе папка .prj; у старой
// раскладки (projects\Имя.prj) - папка цели сборки. [Editor] и заглушки
// C:\ в [Compiler] не переносятся. False - .prj не прочитан.
function TForm1.ImportPrjFile(const APrjFile, AName: string;
                              var AFolder: string): Boolean;
var
  PrjIni: TIniFile;
  Prj: TProjectIni;
  Sects, Values: TStringList;
  SectIdx, ValIdx, SpaceAt: Integer;
  Sect, Key, Val, Target: string;
  PathValue: Boolean;
begin
  Result := False;
  if not FileExists(APrjFile) then
    Exit;
  PrjIni := TIniFile.Create(APrjFile);
  Sects := TStringList.Create;
  Values := TStringList.Create;
  Prj := TProjectIni.Create(SettingsFileName, AName);
  try
    Target := PrjPathFromStore(APrjFile,
                               StripIniComment(PrjIni.ReadString('Project', 'Target', '')));
    if (Target <> '') and
       SamePathText(AFolder, ProjectsDir) then
      AFolder := ExtractFilePath(Target);
    AFolder := IncludeTrailingPathDelimiter(AFolder);

    Prj.Clear;
    PrjIni.ReadSections(Sects);
    for SectIdx := 0 to Sects.Count - 1 do
    begin
      Sect := Sects[SectIdx];
      if CompareText(Sect, 'Editor') = 0 then
        Continue;
      PrjIni.ReadSectionValues(Sect, Values);
      for ValIdx := 0 to Values.Count - 1 do
      begin
        Key := Values.Names[ValIdx];
        if Key = '' then
          Continue;
        Val := Values.ValueFromIndex[ValIdx];
        if (CompareText(Sect, 'Compiler') = 0) and
           ((Trim(Val) = 'C:\') or (CompareText(Key, 'DelphiPath') = 0)) then
          Continue;
        if (CompareText(Sect, 'Project') = 0) and
           (CompareText(Key, 'Target') = 0) then
          Val := PrjTargetToStore(AFolder, Target)
        else if (CompareText(Sect, 'Windows') = 0) and
                (CompareText(Copy(Key, 1, 8), 'incowner') = 0) then
          Val := PrjPathFromStore(APrjFile, Val)
        else
        begin
          // "<номер> <путь>": winN в [Windows], номера в [Tabs]
          PathValue := ((CompareText(Sect, 'Windows') = 0) and
                        (CompareText(Copy(Key, 1, 3), 'win') = 0)) or
                       ((CompareText(Sect, 'Tabs') = 0) and
                        (StrToIntDef(Key, -1) >= 0));
          SpaceAt := Pos(' ', Trim(Val));
          if PathValue and (SpaceAt > 1) and
             (StrToIntDef(Copy(Trim(Val), 1, SpaceAt - 1), -1) >= 0) then
            Val := Copy(Trim(Val), 1, SpaceAt) +
                   PrjPathFromStore(APrjFile,
                                    Copy(Trim(Val), SpaceAt + 1, MaxInt));
        end;
        Prj.WriteString(Sect, Key, Val);
      end;
    end;
    Result := True;
  finally
    Prj.Free;
    Values.Free;
    Sects.Free;
    PrjIni.Free;
  end;
end;

// Проекты прежнего вида: в [Projects] значение - путь к .prj. Описание
// переносится в editor.ini (ImportPrjFile), значение становится папкой
// проекта. Сами .prj остаются на диске нетронутыми. Проект, у которого
// раздел уже есть, повторно не переносится. Что сделано - в ANotes.
procedure TForm1.MigratePrjProjects(ANotes: TStrings);
var
  Ini: TIniFile;
  Reg, Moved: TStringList;
  RegIdx: Integer;
  PrjName, PrjFile, Folder: string;
  Prj: TProjectIni;
  HasSection: Boolean;
begin
  if not FileExists(SettingsFileName) then
    Exit;
  Reg := TStringList.Create;
  Moved := TStringList.Create;
  try
    Ini := TIniFile.Create(SettingsFileName);
    try
      Ini.ReadSectionValues('Projects', Reg);
    finally
      Ini.Free;
    end;

    // Разделы проектов пишет TProjectIni (текстом файла), [Projects] -
    // после, одним заходом
    for RegIdx := 0 to Reg.Count - 1 do
    begin
      PrjName := Reg.Names[RegIdx];
      PrjFile := StripIniComment(Reg.ValueFromIndex[RegIdx]);
      if (PrjName = '') or
         (CompareText(ExtractFileExt(PrjFile), '.prj') <> 0) then
        Continue;
      Folder := ExtractFilePath(PrjFile);
      Prj := TProjectIni.Create(SettingsFileName, PrjName);
      try
        HasSection := Prj.Exists;
      finally
        Prj.Free;
      end;
      if HasSection then
        ANotes.Add('Проект ' + PrjName + ': раздел уже есть в editor.ini, ' +
                   PrjFile + ' не переносится')
      else if ImportPrjFile(PrjFile, PrjName, Folder) then
        ANotes.Add('Проект ' + PrjName + ': описание ' + PrjFile +
        ' перенесено в editor.ini, папка проекта ' + Folder)
      else
        ANotes.Add('Проект ' + PrjName + ': описания ' + PrjFile + ' нет - ' +
        'в списке остаётся папка ' + Folder);
                   Moved.Values[PrjName] := Folder;
    end;

    if Moved.Count > 0 then
    begin
      Ini := TIniFile.Create(SettingsFileName);
      try
        for RegIdx := 0 to Moved.Count - 1 do
          Ini.WriteString('Projects', Moved.Names[RegIdx],
                          Moved.ValueFromIndex[RegIdx]);
      finally
        Ini.Free;
      end;
    end;
  finally
    Moved.Free;
    Reg.Free;
  end;
  // [Projects] записан через TIniFile - разделы проектов читаются заново
  IniCacheReset;
end;

// Реестр проектов из editor.ini, [Projects]: имя проекта - ключ, папка
// проекта - значение. Сам проект - раздел [Project.<имя>] (PrjStore).
procedure TForm1.LoadProjectReg;
var
  Ini: TIniFile;
  SL: TStringList;
  I: Integer;
begin
  if FProjectReg = nil then
    FProjectReg := TStringList.Create;
  FProjectReg.Clear;

  if not FileExists(SettingsFileName) then
    Exit;

  Ini := TIniFile.Create(SettingsFileName);
  SL := TStringList.Create;
  try
    Ini.ReadSectionValues('Projects', SL);
    for I := 0 to SL.Count - 1 do
      if (SL.Names[I] <> '') and
         (StripIniComment(SL.ValueFromIndex[I]) <> '') then
        FProjectReg.Values[SL.Names[I]] :=
          IncludeTrailingPathDelimiter(StripIniComment(SL.ValueFromIndex[I]));
  finally
    SL.Free;
    Ini.Free;
  end;
end;

procedure TForm1.SaveProjectReg;
var
  Ini: TIniFile;
  I: Integer;
begin
  if FProjectReg = nil then
    Exit;

  Ini := TIniFile.Create(SettingsFileName);
  try
    Ini.EraseSection('Projects');
    for I := 0 to FProjectReg.Count - 1 do
      if FProjectReg.Names[I] <> '' then
        Ini.WriteString('Projects', FProjectReg.Names[I],
                        FProjectReg.ValueFromIndex[I]);
  finally
    Ini.Free;
  end;
end;

procedure TForm1.RegisterProject(const AName, APath: string);
begin
  if (Trim(AName) = '') or (Trim(APath) = '') then
    Exit;
  if FProjectReg = nil then
    LoadProjectReg;
  FProjectReg.Values[AName] := APath;
  SaveProjectReg;
end;

// Проект, который собирается и запускается (сборка, Run, отладчик, New
// Form) - текущий. Что именно собирать, решает файл активной вкладки
// (CurBuildKind, DelphiTargetDpr, RapidQTargetBas).
function TForm1.BuildProject: string;
begin
  Result := FCurrentProject;
end;

// Папка проекта из реестра ([Projects]), с \ в конце; нет проекта - пусто
function TForm1.ProjectDir(const AName: string): string;
begin
  Result := '';
  if AName = '' then
    Exit;
  if FProjectReg = nil then
    LoadProjectReg;
  Result := FProjectReg.Values[AName];
  if Result <> '' then
    Result := IncludeTrailingPathDelimiter(Result);
end;

// Проект есть в списке проектов
function TForm1.ProjectExists(const AName: string): Boolean;
begin
  Result := False;
  if AName = '' then
    Exit;
  if FProjectReg = nil then
    LoadProjectReg;
  Result := FProjectReg.IndexOfName(AName) >= 0;
end;

// Тип проекта из его раздела. Пусто - проект сделан до появления типов,
// это набор файлов RapidQ.
function TForm1.ProjectTypeOf(const AName: string): string;
var
  Prj: TProjectIni;
  TypeText: string;
begin
  Result := 'RapidQ Basic';
  if not ProjectExists(AName) then
    Exit;
  Prj := TProjectIni.Create(SettingsFileName, AName);
  try
    TypeText := StripIniComment(Prj.ReadString('Project', 'Type', ''));
    if TypeText <> '' then
      Result := TypeText;
  finally
    Prj.Free;
  end;
end;

// Освобождает все слоты окон
procedure TForm1.CloseAllWindows;
var
  I: Integer;
begin
  for I := 0 to WindowsItemCount - 1 do
  begin
    FWindows[I].Used := False;
    FWindows[I].FileName := '';
    FWindows[I].IncOwner := '';
    FWindows[I].Text := '';
    FWindows[I].CursorPos := 0;
    FWindows[I].Modified := False;
    FWindows[I].Broken := False;
    FWindows[I].FmtShown := False;
    FWindows[I].MapValid := False;
    SetLength(FWindows[I].CommentRanges, 0);
    SetLength(FWindows[I].StringRanges, 0);
    SetLength(FWindows[I].Bookmarks, 0);
    BmHistDropWindow(I);
  end;
  // Просмотр мог остаться на экране - вкладок больше нет
  FmtApplyTab;
  SplitWindowClosed(-1);

  FWindowsIndex := -1;
  FCurrentFileName := '';

  // Вкладки ссылаются на слоты, которых больше нет
  if FTabs <> nil then
  begin
    FLockTabs := True;
    try
      FTabs.Tabs.Clear;
    finally
      FLockTabs := False;
    end;
  end;
  SetLength(FTabWin, 0);

  FLockHighlight := True;
  try
    RichEdit1.Lines.Clear;
  finally
    FLockHighlight := False;
  end;
  RichEdit1.Modified := False;
end;

// Постоянные пункты подменю Projects
procedure TForm1.BuildProjectsMenu;
begin
  mProject.Caption := 'Projects';
  LoadProjectReg;

  // Пункты списка строятся из имён папок, и подставлять в них ускорители
  // не нужно - иначе в подписях появляются лишние амперсанды
  mProject.AutoHotkeys := maManual;

  RebuildProjectsMenu;
end;

// Delete wrong projects names: из реестра убираются записи, чьей папки
// нет на диске, вместе с разделом проекта. Файлы не трогаются - удалять с
// диска должен Delete Project, а не уборка списка.
procedure TForm1.DeleteWrongProjectsClick(Sender: TObject);
var
  I, N: Integer;
  Nm, Path: string;
begin
  if FProjectReg = nil then
    LoadProjectReg;

  N := 0;
  for I := FProjectReg.Count - 1 downto 0 do
  begin
    Nm := FProjectReg.Names[I];
    Path := FProjectReg.ValueFromIndex[I];
    if (Nm = '') or not DirectoryExists(Path) then
    begin
      if Nm <> '' then
      begin
        LogRaw('Убран из списка: ' + Nm + '  ' + #149 + '  ' + Path);
        IniReplaceSection(SettingsFileName, ProjectSectionPrefix + Nm, nil);
      end;
      FProjectReg.Delete(I);
      Inc(N);
    end;
  end;

  SaveProjectReg;
  RebuildProjectsMenu;
  LogRaw(Format('Delete wrong projects names: убрано записей %d', [N]));
end;

// Tidy editor.ini (Project - Manage Projects): окно DlgTidyIni.
//   - Scan (TidyScanClick): в выбранной папке и подпапках ищутся
//     editor*.ini и *.prj; проекты, которых в editor.ini нет, - в список;
//     Add to editor.ini (TidyAddClick) переносит отмеченные.
//   - Tidy and restart: разбор editor.ini и перезапуск (TidyRun).
// Папка поиска запоминается в editor.ini, [Tidy] ScanDir.
procedure TForm1.TidyIniClick(Sender: TObject);
var
  Dlg: TDlgTidyIni;
  Ini: TIniFile;
  Start: string;
  Res: Integer;
begin
  if FProjectReg = nil then
    LoadProjectReg;
  Ini := TIniFile.Create(SettingsFileName);
  try
    Start := Trim(Ini.ReadString('Tidy', 'ScanDir', ''));
  finally
    Ini.Free;
  end;
  if (Start = '') or not DirectoryExists(Start) then
    Start := ExtractFilePath(Application.ExeName);
  if Length(Start) > 3 then
    Start := ExcludeTrailingPathDelimiter(Start);

  Res := mrNone;
  Dlg := TDlgTidyIni.Create(Self);
  FTidyDlg := Dlg;
  FTidyFound := TList.Create;
  try
    Dlg.lstDirs.OnChange := TidyDirChange;
    Dlg.btnScan.OnClick := TidyScanClick;
    Dlg.btnMark.OnClick := TidyMarkClick;
    Dlg.btnUnmark.OnClick := TidyMarkClick;
    Dlg.btnAdd.OnClick := TidyAddClick;
    Dlg.btnAdd.Enabled := False;
    Dlg.OnCloseQuery := TidyDlgCloseQuery;
    try
      Dlg.lstDirs.Directory := Start;
      // Диск - по папке, после неё: смена диска не сбросит папку
      Dlg.cmbDrive.Drive := Dlg.lstDirs.Drive;
    except
      // папка недоступна - список остаётся там, где встал сам
    end;
    TidyDirChange(nil);
    Res := Dlg.ShowModal;
  finally
    TidyClearFound;
    FreeAndNil(FTidyFound);
    FTidyDlg := nil;
    Dlg.Free;
  end;
  if Res = mrOk then
    TidyRun;
end;

procedure TForm1.TidyClearFound;
var
  ItemIdx: Integer;
begin
  if FTidyFound = nil then
    Exit;
  for ItemIdx := 0 to FTidyFound.Count - 1 do
    TTidyFound(FTidyFound[ItemIdx]).Free;
  FTidyFound.Clear;
end;

// Папку выбрали в дереве - путь в поле; поле можно и править руками
procedure TForm1.TidyDirChange(Sender: TObject);
begin
  if FTidyDlg <> nil then
    FTidyDlg.edPath.Text := FTidyDlg.lstDirs.Directory;
end;

// Пока идёт поиск, окно не закрывается: поиск работает внутри его
// обработчика
procedure TForm1.TidyDlgCloseQuery(Sender: TObject; var CanClose: Boolean);
begin
  CanClose := not FTidyScanning;
end;

// Scan - поиск проектов (TidyScanProjects); во время поиска та же кнопка -
// Stop. Сравнение идёт с файлом editor.ini, поэтому список проектов
// сначала записывается
procedure TForm1.TidyScanClick(Sender: TObject);
var
  Notes: TStringList;
  Ini: TIniFile;
  Root, Line: string;
  ItemIdx: Integer;
  OldMode: UINT;
begin
  if FTidyDlg = nil then
    Exit;
  if FTidyScanning then
  begin
    FTidyStop := True;
    Exit;
  end;
  Root := Trim(FTidyDlg.edPath.Text);
  if (Root = '') or not DirectoryExists(Root) then
  begin
    ShowMessage('Папки нет: ' + Root);
    Exit;
  end;
  Ini := TIniFile.Create(SettingsFileName);
  try
    Ini.WriteString('Tidy', 'ScanDir', Root);
  finally
    Ini.Free;
  end;
  SaveProjectReg;

  TidyClearFound;
  FTidyDlg.lstFound.Items.Clear;
  FTidyDlg.btnScan.Caption := 'Stop';
  FTidyDlg.btnAdd.Enabled := False;
  FTidyDlg.btnTidy.Enabled := False;
  FTidyDlg.btnClose.Enabled := False;
  FTidyStop := False;
  FTidyTick := 0;
  FTidyScanning := True;
  Notes := TStringList.Create;
  try
    // диск или флешка, которых нет, - без системного окна об ошибке
    OldMode := SetErrorMode(SEM_FAILCRITICALERRORS);
    Screen.Cursor := crAppStart;
    try
      TidyScanProjects(Root, SettingsFileName, FTidyFound, Notes,
                       TidyScanStep);
    finally
      Screen.Cursor := crDefault;
      SetErrorMode(OldMode);
      FTidyScanning := False;
      FTidyDlg.btnScan.Caption := 'Scan';
      FTidyDlg.btnTidy.Enabled := True;
      FTidyDlg.btnClose.Enabled := True;
    end;

    for ItemIdx := 0 to FTidyFound.Count - 1 do
      with TTidyFound(FTidyFound[ItemIdx]) do
      begin
        FTidyDlg.lstFound.Items.Add(Name + '   ' + #149 + '   ' + Folder +
        '   (' + Source + ')');
                                    FTidyDlg.lstFound.Checked[ItemIdx] := True;
      end;
    FTidyDlg.btnAdd.Enabled := FTidyFound.Count > 0;
    Line := '';
    for ItemIdx := 0 to Notes.Count - 1 do
      Line := Line + Notes[ItemIdx] + '. ';
    FTidyDlg.lblScan.Caption := Line;
    LogRaw('Tidy editor.ini, поиск в ' + Root + ':');
    for ItemIdx := 0 to Notes.Count - 1 do
      LogRaw('  ' + Notes[ItemIdx]);
  finally
    Notes.Free;
  end;
end;

// Ход поиска: папка - в строку под списком, не чаще раза в 150 мс;
// заодно обрабатываются нажатия (Stop)
procedure TForm1.TidyScanStep(const AFolder: string; var AStop: Boolean);
begin
  if (FTidyDlg <> nil) and (GetTickCount - FTidyTick > 150) then
  begin
    FTidyTick := GetTickCount;
    FTidyDlg.lblScan.Caption := 'Поиск: ' + AFolder;
    Application.ProcessMessages;
  end;
  AStop := FTidyStop or (FTidyDlg = nil);
end;

procedure TForm1.TidyMarkClick(Sender: TObject);
var
  ItemIdx: Integer;
begin
  if FTidyDlg = nil then
    Exit;
  for ItemIdx := 0 to FTidyDlg.lstFound.Items.Count - 1 do
    FTidyDlg.lstFound.Checked[ItemIdx] := TUiButton(Sender).Tag = 1;
end;

// Add to editor.ini: отмеченные проекты - раздел [Project.<имя>] и запись
// в [Projects]; из списка они убираются
procedure TForm1.TidyAddClick(Sender: TObject);
var
  ItemIdx, Added: Integer;
  Item: TTidyFound;
  Lst: TCheckListBox;
begin
  if (FTidyDlg = nil) or (FTidyFound = nil) then
    Exit;
  if FProjectReg = nil then
    LoadProjectReg;
  Lst := FTidyDlg.lstFound;
  Added := 0;
  LogRaw('Tidy editor.ini, добавление проектов:');
  for ItemIdx := 0 to Lst.Items.Count - 1 do
  begin
    if not Lst.Checked[ItemIdx] then
      Continue;
    Item := TTidyFound(FTidyFound[ItemIdx]);
    // имя заняли после поиска - не трогаем чужой раздел
    if FProjectReg.IndexOfName(Item.Name) >= 0 then
    begin
      LogRaw('  ' + Item.Name + ': такое имя уже есть, не добавлен');
      Continue;
    end;
    IniReplaceSection(SettingsFileName, ProjectSectionPrefix + Item.Name,
                      Item.Body);
    FProjectReg.Values[Item.Name] := Item.Folder;
    LogRaw('  ' + Item.Name + '  ' + #149 + '  ' + Item.Folder + '  (из ' +
           Item.Source + ')');
    Inc(Added);
  end;
  SaveProjectReg;
  RebuildProjectsMenu;

  // добавленные - из списка (с конца: номера строк не сдвигаются)
  for ItemIdx := Lst.Items.Count - 1 downto 0 do
  begin
    Item := TTidyFound(FTidyFound[ItemIdx]);
    if Lst.Checked[ItemIdx] and
       (CompareText(FProjectReg.Values[Item.Name], Item.Folder) = 0) then
    begin
      Item.Free;
      FTidyFound.Delete(ItemIdx);
      Lst.Items.Delete(ItemIdx);
    end;
  end;
  FTidyDlg.btnAdd.Enabled := Lst.Items.Count > 0;
  FTidyDlg.lblScan.Caption := 'Добавлено в editor.ini проектов: ' +
                              IntToStr(Added);
  LogRaw('  добавлено: ' + IntToStr(Added));
end;

// Tidy and restart. Проект и изменённые файлы сохраняются (проект - без
// вопроса; файлы и схема - те же вопросы, что при выходе), настройки
// пишутся в editor.ini, editor.ini разбирается на editorNew.ini (этот
// компьютер), editorN.ini (другие компьютеры) и editorOLD.ini (записи с
// ненайденными путями), см. IniTidy. Затем программа закрывается и
// запускает себя заново (TidyRestart); новый экземпляр ждёт, пока прежний
// закроется, и ставит editorNew.ini на место editor.ini
// (TidySwapAtStart). Прежний editor.ini остаётся как editor_prev.ini.
procedure TForm1.TidyRun;
var
  Notes: TStringList;
  NoteIdx: Integer;
  OldMode: UINT;
  Done, CanGo: Boolean;
begin
  // Проект - без вопроса; изменённые файлы и схема - те же вопросы, что
  // при выходе. Отказ - команда отменяется
  if FCurrentProject <> '' then
    SaveProjectTo(FCurrentProject);
  CanGo := True;
  FormCloseQuery(Self, CanGo);
  if not CanGo then
  begin
    LogRaw('Tidy editor.ini: отменено');
    Exit;
  end;
  SaveSettings;

  Done := False;
  Notes := TStringList.Create;
  try
    // диск или флешка, которых нет, - без системного окна об ошибке
    OldMode := SetErrorMode(SEM_FAILCRITICALERRORS);
    Screen.Cursor := crHourGlass;
    try
      Done := TidyEditorIni(SettingsFileName, Notes);
    finally
      Screen.Cursor := crDefault;
      SetErrorMode(OldMode);
    end;
    LogRaw('Tidy editor.ini:');
    for NoteIdx := 0 to Notes.Count - 1 do
      LogRaw('  ' + Notes[NoteIdx]);
  finally
    Notes.Free;
  end;
  if not Done then
  begin
    ShowMessage(TidyNewName + ' не записан, причина - в журнале. editor.ini ' +
    'не изменён.');
                Exit;
  end;
  FTidyRestart := True;
  Close;
end;

// Перезапуск после Tidy editor.ini - в конце FormDestroy, когда настройки
// уже записаны. Новому экземпляру передаётся номер этого процесса: он
// ждёт его выхода и только потом меняет editor.ini. Не запустился -
// editorNew.ini ставится сразу, unIDE запускается вручную.
procedure TForm1.TidyRestart;
var
  Notes: TStringList;
  Params: string;
begin
  Params := '/tidyswap:' + IntToStr(GetCurrentProcessId);
  if ShellExecute(0, 'open', PChar(FRestartExe), PChar(Params),
                  PChar(ExtractFilePath(FRestartExe)), SW_SHOWNORMAL) > 32 then
    Exit;
  Notes := TStringList.Create;
  try
    TidyApplyNew(ExtractFilePath(FRestartExe), Notes);
    MessageBox(0, PChar('Не удалось запустить ' + FRestartExe + #13#10 +
                        Notes.Text + 'Запустите unIDE вручную.'), 'unIDE',
               MB_OK or MB_ICONWARNING);
  finally
    Notes.Free;
  end;
end;

// Запуск после Tidy editor.ini: в командной строке /tidyswap:<номер
// процесса прежнего экземпляра>. Он при выходе ещё пишет editor.ini -
// ждём, пока закроется (до 30 секунд), затем editor.ini ->
// editor_prev.ini, editorNew.ini -> editor.ini (TidyApplyNew). Не
// дождались - файлы не трогаются, запись в журнал. До SelectEditorIni:
// editor.ini ещё никто не читал.
procedure TForm1.TidySwapAtStart;
var
  ParamIdx, OldPid: Integer;
  Param: string;
  OldProc: THandle;
begin
  for ParamIdx := 1 to ParamCount do
  begin
    Param := ParamStr(ParamIdx);
    if CompareText(Copy(Param, 1, 10), '/tidyswap:') <> 0 then
      Continue;
    OldPid := StrToIntDef(Copy(Param, 11, MaxInt), 0);
    if OldPid <> 0 then
    begin
      OldProc := OpenProcess(SYNCHRONIZE, False, OldPid);
      if OldProc <> 0 then
      try
        if WaitForSingleObject(OldProc, 30000) <> WAIT_OBJECT_0 then
        begin
          FIniPathLog.Add('Tidy editor.ini: прежний экземпляр unIDE не ' +
          'закрылся за 30 секунд - editor.ini не заменён, ' +
                          TidyNewName + ' остаётся рядом');
          Exit;
        end;
      finally
        CloseHandle(OldProc);
      end;
    end;
    TidyApplyNew(ExtractFilePath(Application.ExeName), FIniPathLog);
    Exit;
  end;
end;

// Раздел настроек компилятора для типа проекта. У типа может быть
// несколько инструментов - две версии Delphi, разные компиляторы C++, - и
// у каждого свои пути. Какой брать: сначала ключ Toolchain текущего
// проекта, потом Default этого типа, иначе безымянный раздел типа.
function TForm1.CompilerSection(const AType: string): string;
var
  Ini: TIniFile;
  Prj: TProjectIni;
  Tool: string;
begin
  Result := 'Compiler.' + AType;
  Tool := '';

  if ProjectExists(FCurrentProject) then
  begin
    Prj := TProjectIni.Create(SettingsFileName, FCurrentProject);
    try
      Tool := StripIniComment(Prj.ReadString('Project', 'Toolchain', ''));
    finally
      Prj.Free;
    end;
  end;

  if (Tool = '') and FileExists(SettingsFileName) then
  begin
    Ini := TIniFile.Create(SettingsFileName);
    try
      Tool := StripIniComment(Ini.ReadString('Compiler.' + AType,
      'Default', ''));
    finally
      Ini.Free;
    end;
  end;

  if Tool <> '' then
    Result := Result + '.' + Tool;
end;

// Цель сборки проекта: Target в разделе [Project.<имя>]
function TForm1.ProjectTargetOf(const AName: string): string;
var
  Prj: TProjectIni;
begin
  Result := '';
  if not ProjectExists(AName) then
    Exit;

  Prj := TProjectIni.Create(SettingsFileName, AName);
  try
    Result := StripIniComment(Prj.ReadString('Project', 'Target', ''));
  finally
    Prj.Free;
  end;

  // \Имя.dpr или относительный путь - от папки проекта
  Result := PrjTargetFromStore(ProjectDir(AName), Result);
end;

// Цель сборки проекта, которая есть на диске. Записанная может указывать
// в папку, которой уже нет, - тогда она ищется по порядку:
//   1. файл с тем же именем в папке проекта;
//   2. .dpr среди открытых окон: сначала из папки проекта, иначе - если
//      такой открыт ровно один;
//   3. <имя проекта>.dpr в папке проекта;
//   4. единственный .dpr в папке проекта.
// Ничего не пишет; не нашлось - пустая строка.
function TForm1.ProjectTargetFind(const AName: string): string;
var
  Stored, PrjDir, Candidate, OnlyOpen: string;
  WinIdx, OpenCount: Integer;
  FoundRec: TSearchRec;
begin
  Result := '';
  if AName = '' then
    Exit;
  Stored := ProjectTargetOf(AName);
  if (Stored <> '') and FileExists(Stored) then
  begin
    Result := Stored;
    Exit;
  end;
  PrjDir := ProjectDir(AName);

  // 1. То же имя - в папке проекта
  if Stored <> '' then
  begin
    Candidate := PrjDir + ExtractFileName(Stored);
    if FileExists(Candidate) then
    begin
      Result := Candidate;
      Exit;
    end;
  end;

  // 2. Открытый .dpr
  OnlyOpen := '';
  OpenCount := 0;
  for WinIdx := 0 to WindowsItemCount - 1 do
    if FWindows[WinIdx].Used and
       (CompareText(ExtractFileExt(FWindows[WinIdx].FileName), '.dpr') = 0) and
       FileExists(FWindows[WinIdx].FileName) then
    begin
      if CompareText(ExtractFilePath(FWindows[WinIdx].FileName), PrjDir) = 0 then
      begin
        Result := FWindows[WinIdx].FileName;
        Exit;
      end;
      Inc(OpenCount);
      OnlyOpen := FWindows[WinIdx].FileName;
    end;
  if OpenCount = 1 then
  begin
    Result := OnlyOpen;
    Exit;
  end;

  // 3. По имени проекта
  Candidate := PrjDir + AName + '.dpr';
  if FileExists(Candidate) then
  begin
    Result := Candidate;
    Exit;
  end;

  // 4. Единственный .dpr в папке описания
  if FindFirst(PrjDir + '*.dpr', faAnyFile and not faDirectory, FoundRec) = 0 then
  begin
    try
      Candidate := PrjDir + FoundRec.Name;
      if FindNext(FoundRec) <> 0 then
        Result := Candidate;
    finally
      FindClose(FoundRec);
    end;
  end;
end;

procedure TForm1.SetProjectTarget(const AName, ATarget: string);
var
  Prj: TProjectIni;
begin
  if not ProjectExists(AName) then
    Exit;
  Prj := TProjectIni.Create(SettingsFileName, AName);
  try
    Prj.WriteString('Project', 'Target',
                    PrjTargetToStore(ProjectDir(AName), ATarget));
  finally
    Prj.Free;
  end;
end;

// ADD TO PROJECT: текущий файл добавляется в проект.
//
// Лежит в чужой папке - копируется в папку проекта: так проект остаётся
// переносимым. Для Delphi имя модуля вписывается в uses файла .dpr, перед
// его закрывающей точкой с запятой; если рядом есть одноимённый .dfm,
// дописывается и комментарий с именем формы - без него среда Delphi не
// свяжет модуль с формой.
procedure TForm1.AddToProjectClick(Sender: TObject);
var
  PrjDir, Src, Dst, Target, Nm, Line: string;
  SL: TStringList;
  I, UsesEnd: Integer;
begin
  if FCurrentProject = '' then
  begin
    ShowMessage('5731:Проект не выбран.');
    Exit;
  end;
  if FCurrentFileName = '' then
  begin
    ShowMessage('5736:Текущий файл не сохранён на диск.');
    Exit;
  end;

  if RichEdit1.Modified then
    if not SaveCurrentFile then
      Exit;

  PrjDir := ProjectDir(FCurrentProject);
  Src := FCurrentFileName;
  Dst := Src;

  // Файл из чужой папки переносим к проекту
  if CompareText(ExtractFilePath(Src), PrjDir) <> 0 then
  begin
    Dst := PrjDir + ExtractFileName(Src);
    if FileExists(Dst) then
    begin
      ShowMessage('5754:В папке проекта уже есть файл ' + ExtractFileName(Src));
      Exit;
    end;
    if not CopyFile(PChar(Src), PChar(Dst), True) then
    begin
      ShowMessage('5759:Не удалось скопировать файл в папку проекта.');
      Exit;
    end;
    LogRaw('Скопирован в проект: ' + Dst);
    OpenNamedFile(Dst); // дальше правим уже копию
  end;

  // Список модулей ведёт сам проект языка. Для Delphi это .dpr
  if CompareText(ProjectTypeOf(FCurrentProject), 'Delphi') <> 0 then
  begin
    LogRaw('Файл в папке проекта: ' + Dst);
    Exit;
  end;

  Target := ProjectTargetOf(FCurrentProject);
  if (Target = '') or not FileExists(Target) then
  begin
    LogRaw('Add to project: цель сборки не задана, файл .dpr не найден');
    Exit;
  end;

  if CompareText(ExtractFileExt(Dst), '.pas') <> 0 then
  begin
    LogRaw('В uses проекта вписываются только модули .pas');
    Exit;
  end;

  Nm := ChangeFileExt(ExtractFileName(Dst), '');
  SL := TStringList.Create;
  try
    SL.LoadFromFile(Target);

    // Уже вписан?
    for I := 0 to SL.Count - 1 do
      if Pos(LowerCase(Nm) + ' in ', LowerCase(SL[I])) > 0 then
      begin
        LogRaw('Модуль уже есть в проекте: ' + Nm);
        Exit;
      end;

    // Конец списка uses - строка, кончающаяся точкой с запятой, после
    // строки uses
    UsesEnd := -1;
    for I := 0 to SL.Count - 1 do
      if CompareText(Trim(SL[I]), 'uses') = 0 then
      begin
        UsesEnd := I;
        while (UsesEnd < SL.Count) and
              ((Trim(SL[UsesEnd]) = '') or
               (Copy(TrimRight(SL[UsesEnd]),
                     Length(TrimRight(SL[UsesEnd])), 1) <> ';')) do
          Inc(UsesEnd);
        Break;
      end;

    if (UsesEnd < 0) or (UsesEnd >= SL.Count) then
    begin
      LogRaw('Add to project: в ' + ExtractFileName(Target) +
      ' не найден список uses');
             Exit;
    end;

    // Последнюю строку списка переводим с точки с запятой на запятую,
    // а новую дописываем за ней
    Line := TrimRight(SL[UsesEnd]);
    SetLength(Line, Length(Line) - 1);
    SL[UsesEnd] := Line + ',';

    Line := '  ' + Nm + ' in ''' + ExtractFileName(Dst) + '''';
    if FileExists(ChangeFileExt(Dst, '.dfm')) then
      Line := Line + ' {Form' + Copy(Nm, 5, Length(Nm)) + '}';
    SL.Insert(UsesEnd + 1, Line + ';');

    SL.SaveToFile(Target);
    LogRaw('Добавлен в ' + ExtractFileName(Target) + ': ' + Nm);
  finally
    SL.Free;
  end;
end;

// Scan projects folder: старые проекты лежали в projects\ одним списком.
// Пробегаем её и заносим найденное в реестр - так прежние проекты попадают
// в меню наравне с новыми, у которых описание лежит в своей папке.
// Описания .prj из [Projects] (имя = путь к .prj) - в editor.ini
// (MigratePrjProjects), что сделано - в лог; список проектов - заново
procedure TForm1.ImportPrjAndLog;
var
  Notes: TStringList;
  NoteIdx: Integer;
begin
  Notes := TStringList.Create;
  try
    MigratePrjProjects(Notes);
    for NoteIdx := 0 to Notes.Count - 1 do
      LogRaw(Notes[NoteIdx]);
  finally
    Notes.Free;
  end;
  LoadProjectReg;
  RebuildProjectsMenu;
end;

// Scan projects folder: описания .prj в папке projects (projects\Имя.prj и
// projects\Имя\Имя.prj) переносятся в editor.ini. Проекты, которые уже
// есть в списке, не трогаются.
procedure TForm1.ScanProjectsFolderClick(Sender: TObject);
var
  SR: TSearchRec;
  N: Integer;
  Sub: string;
  Ini: TIniFile;

  procedure AddPrj(const AName, AFile: string);
  begin
    if ProjectExists(AName) then
      Exit;
    Ini.WriteString('Projects', AName, AFile);
    Inc(N);
  end;

begin
  if FProjectReg = nil then
    LoadProjectReg;

  N := 0;
  Ini := TIniFile.Create(SettingsFileName);
  try
    // Старая раскладка: описания прямо в projects
    if FindFirst(ProjectsDir + '*.prj', faAnyFile, SR) = 0 then
    try
      repeat
        if (SR.Attr and faDirectory) = 0 then
          AddPrj(ChangeFileExt(SR.Name, ''), ProjectsDir + SR.Name);
      until FindNext(SR) <> 0;
    finally
      FindClose(SR);
    end;

    // У каждого проекта своя папка, projects\Имя\Имя.prj
    if FindFirst(ProjectsDir + '*.*', faDirectory, SR) = 0 then
    try
      repeat
        if ((SR.Attr and faDirectory) = 0) or (SR.Name = '.') or
           (SR.Name = '..') then
          Continue;
        Sub := ProjectsDir + SR.Name + '\' + SR.Name + '.prj';
        if FileExists(Sub) then
          AddPrj(SR.Name, Sub);
      until FindNext(SR) <> 0;
    finally
      FindClose(SR);
    end;
  finally
    Ini.Free;
  end;

  ImportPrjAndLog;
  LogRaw(Format('Scan projects folder: перенесено описаний %d', [N]));
end;

// Open Project: описание .prj где угодно на диске - в список проектов,
// переносится в editor.ini (ImportPrjAndLog)
procedure TForm1.OpenProjectClick(Sender: TObject);
var
  Dlg: TOpenDialog;
  Nm, PrjFile: string;
  Ini: TIniFile;
begin
  Dlg := TOpenDialog.Create(Self);
  try
    Dlg.Title := 'Open Project';
    Dlg.Filter := 'Project (*.prj)|*.prj';
    Dlg.InitialDir := ProjectsDir;
    if not Dlg.Execute then
      Exit;
    PrjFile := Dlg.FileName;
    Nm := ChangeFileExt(ExtractFileName(PrjFile), '');
  finally
    Dlg.Free;
  end;

  if ProjectExists(Nm) then
    LogRaw('Open Project: проект ' + Nm + ' уже есть в списке - открыт он, ' +
    'описание .prj не переносится')
  else
  begin
    Ini := TIniFile.Create(SettingsFileName);
    try
      Ini.WriteString('Projects', Nm, PrjFile);
    finally
      Ini.Free;
    end;
    ImportPrjAndLog;
  end;
  LoadProject(Nm);
end;

// Reopen Project: перечитать текущий с диска, отбросив несохранённое
procedure TForm1.ReopenProjectClick(Sender: TObject);
begin
  if FCurrentProject = '' then
  begin
    LogRaw('Reopen Project: проект не выбран');
    Exit;
  end;
  LoadProject(FCurrentProject);
end;

// PROJECT PROPERTIES: имя, папка и тип текущего проекта - в том же окне,
// что New Project (DlgNewPrj), только заполненном. Файлы проекта не
// создаются, не копируются и не переносятся - меняется только его раздел
// [Project.<имя>] в editor.ini и запись в [Projects]:
//   - имя: раздел и запись - под новым именем;
//   - папка: проект перенесли в другую папку (сами файлы) - пути раздела,
//     начинающиеся со старой папки (цель сборки, окна, вкладки), переводятся
//     на новую. Главного файла там нет - вопрос, записывать ли всё равно;
//   - тип: Type=. Главный файл, который новому типу не подходит, ищется
//     в папке проекта заново (PickExistingMain).
// Перед правкой - вопросы о несохранённом (ConfirmSaveAll,
// ConfirmSaveProject), после - проект загружается заново.
//
// У проекта Delphi есть ещё вкладка Project options - страницы окна
// Project Options среды Delphi 7 (DlgNewPrj, DelphiOpts). Её настройки
// записываются в .dof, .dpr и .res главного файла проекта сразу после OK,
// независимо от имени, папки и типа.
procedure TForm1.ProjectPropsClick(Sender: TObject);
var
  Dlg: TDlgNewPrj;
  Prj: TProjectIni;
  Keys, OptLog: TStringList;
  OldName, OldDir, OldType, OldTarget: string;
  NewName, NewDir, NewType, NewTarget, Dir, Val, SectName: string;
  IncSysDir, IncUserDir, IncMode, IncOwnDir, IncOwnList: string;
  K, SectIdx, KeyIdx, FoundAt, LogIdx: Integer;
  DirChanged, OptionsChanged: Boolean;
begin
  if FCurrentProject = '' then
  begin
    ShowMessage('7307:Проект не открыт.');
    Exit;
  end;
  OldName := FCurrentProject;
  if not ProjectExists(OldName) then
  begin
    ShowMessage('7314:Проекта нет в списке проектов: ' + OldName);
    Exit;
  end;

  // Несохранённые тексты и состав окон - до правки: после неё проект
  // загружается заново
  if not ConfirmSaveAll then
    Exit;
  if not ConfirmSaveProject then
    Exit;

  OldDir := ProjectDir(OldName);
  OldType := ProjectTypeOf(OldName);
  OldTarget := ProjectTargetOf(OldName);

  Dlg := TDlgNewPrj.Create(Self);
  try
    // То же окно, что New Project: галка "на базе существующего" здесь
    // не нужна - проект уже есть. Подсказка папки по имени не
    // подключается: папка проекта от его имени не зависит.
    Dlg.Caption := 'Project Properties';
    Dlg.chkBase.Visible := False;
    Dlg.edName.Text := OldName;
    Dlg.edDir.Text := OldDir;
    K := Dlg.cbType.Items.IndexOf(OldType);
    if K < 0 then
      K := Dlg.cbType.Items.Add(OldType);
    Dlg.cbType.ItemIndex := K;
    // Папка inc (проект RapidQ): виды из настроек компилятора, выбор и
    // своя папка проекта
    RapidQIncSettings(OldName, IncSysDir, IncUserDir, IncMode, IncOwnDir);
    Prj := TProjectIni.Create(SettingsFileName, OldName);
    try
      IncOwnList := Prj.ReadString('Project', 'IncPaths', '');
    finally
      Prj.Free;
    end;
    Dlg.SetRqInc(IncSysDir, IncUserDir, IncMode, IncOwnDir, IncOwnList);

    // Проект Delphi с главным .dpr - вкладка Project options
    if (CompareText(OldType, 'Delphi') = 0) and
       (CompareText(ExtractFileExt(OldTarget), '.dpr') = 0) and
       FileExists(OldTarget) then
      Dlg.LoadDelphiOptions(OldTarget)
    else if CompareText(OldType, 'Delphi') = 0 then
      LogRaw('Project Properties: вкладки Project options нет - не задан ' +
      'главный .dpr проекта (Target). Откройте .dpr и соберите ' +
      'проект - он запомнится как цель.');

      // Кнопка "..." закрывает окно с mrRetry (как в New Project): папка
      // выбирается, и окно показывается снова
    repeat
      if Dlg.ShowModal = mrRetry then
      begin
        Dir := Dlg.edDir.Text;
        if PickFolderDialog('Папка проекта', Dir, Dir) then
          Dlg.edDir.Text := IncludeTrailingPathDelimiter(Dir);
        Continue;
      end
      else if Dlg.ModalResult <> mrOk then
        Exit;
      Break;
    until False;

    NewName := Trim(Dlg.edName.Text);
    NewDir := Trim(Dlg.edDir.Text);
    NewType := Dlg.cbType.Text;

    // Папка inc - в раздел проекта сразу (переименование раздела ниже
    // переносит и её)
    if CompareText(NewType, 'RapidQ Basic') = 0 then
    begin
      Prj := TProjectIni.Create(SettingsFileName, OldName);
      try
        Prj.WriteString('Project', 'IncMode', Dlg.RqIncMode);
        Prj.WriteString('Project', 'IncPath', Dlg.RqIncOwnDir);
        Prj.WriteString('Project', 'IncPaths', Dlg.RqIncOwnList);
      finally
        Prj.Free;
      end;
    end;

    if (NewName = '') or (NewDir = '') then
    begin
      ShowMessage('7370:Нужно указать имя и папку проекта.');
      Exit;
    end;
    if (Pos('\', NewName) > 0) or (Pos('/', NewName) > 0) or
       (Pos(':', NewName) > 0) or (Pos('*', NewName) > 0) or
       (Pos('?', NewName) > 0) or (Pos('"', NewName) > 0) or
       (Pos('<', NewName) > 0) or (Pos('>', NewName) > 0) or
       (Pos('|', NewName) > 0) then
    begin
      ShowMessage('7379:В имени проекта нельзя использовать символы ' +
      '\ / : * ? " < > |');
                  Exit;
    end;

    NewDir := IncludeTrailingPathDelimiter(NewDir);
    if not DirectoryExists(NewDir) then
    begin
      ShowMessage('7387:Папка не найдена:'#13#10 + NewDir);
      Exit;
    end;

    if FProjectReg = nil then
      LoadProjectReg;
    if (CompareText(NewName, OldName) <> 0) and
       (FProjectReg.IndexOfName(NewName) >= 0) then
    begin
      ShowMessage('7396:Проект с именем ' + NewName + ' уже есть в списке.');
      Exit;
    end;

    DirChanged := CompareText(NewDir, OldDir) <> 0;

    // Project options - в .dof, .dpr, .res
    OptionsChanged := False;
    if Dlg.DelphiDpr <> '' then
    begin
      OptLog := TStringList.Create;
      try
        Dlg.SaveDelphiOptions(OptLog, OptionsChanged);
        for LogIdx := 0 to OptLog.Count - 1 do
          LogRaw('Project options: ' + OptLog[LogIdx]);
      finally
        OptLog.Free;
      end;
    end;

    // Имя, папка и тип не поменялись - писать в editor.ini нечего. Если
    // .dpr переписан (Title, формы), открытые вкладки перечитываются.
    if (NewName = OldName) and not DirChanged and
       (CompareText(NewType, OldType) = 0) then
    begin
      if OptionsChanged then
        LoadProject(OldName);
      Exit;
    end;

    // Главный файл: в новой папке, если в неё перенесли проект; другой,
    // если прежний новому типу не подходит
    NewTarget := OldTarget;
    if DirChanged and (OldTarget <> '') and
       AnsiStartsText(OldDir, OldTarget) then
      NewTarget := NewDir + Copy(OldTarget, Length(OldDir) + 1, MaxInt);
    if (CompareText(NewType, OldType) <> 0) and
       (MainMasksFor(NewType) <> '') and
       ((NewTarget = '') or not MatchesProjectType(NewTarget, NewType)) then
    begin
      if NewTarget <> '' then
        Dir := ExtractFilePath(NewTarget)
      else
        Dir := NewDir;
      // Не нашёлся или выбор отменён - сообщение уже было
      if not PickExistingMain(Dir, NewType, NewTarget) then
        Exit;
    end;
    if (NewTarget <> '') and not FileExists(NewTarget) then
      if MessageDlg('7436:Главного файла проекта нет:'#13#10 + NewTarget +
                    #13#10#13#10'Записать свойства всё равно?',
                    mtConfirmation, [mbYes, mbNo], 0) <> mrYes then
        Exit;

  finally
    Dlg.Free;
  end;

  // Раздел и запись в списке - под новым именем
  if CompareText(NewName, OldName) <> 0 then
  begin
    IniRenameSection(SettingsFileName, ProjectSectionPrefix + OldName,
                     ProjectSectionPrefix + NewName);
    UnregisterProject(OldName);
  end;
  RegisterProject(NewName, NewDir);

  Prj := TProjectIni.Create(SettingsFileName, NewName);
  Keys := TStringList.Create;
  try
    // Окна и вкладки: значение - "<номер> <путь>", старая папка ищется
    // внутри значения
    if DirChanged then
      for SectIdx := 0 to 1 do
      begin
        if SectIdx = 0 then
          SectName := 'Windows'
        else
          SectName := 'Tabs';
        Prj.ReadSection(SectName, Keys);
        for KeyIdx := 0 to Keys.Count - 1 do
        begin
          Val := Prj.ReadString(SectName, Keys[KeyIdx], '');
          FoundAt := Pos(AnsiUpperCase(OldDir), AnsiUpperCase(Val));
          if FoundAt > 0 then
            Prj.WriteString(SectName, Keys[KeyIdx],
                            Copy(Val, 1, FoundAt - 1) + NewDir +
                            Copy(Val, FoundAt + Length(OldDir), MaxInt));
        end;
      end;
    Prj.WriteString('Project', 'Type', NewType);
    FUtilsPrjDone := False; // тип сменился - меню Utils заново
    if NewTarget <> '' then
      Prj.WriteString('Project', 'Target', PrjTargetToStore(NewDir, NewTarget));
  finally
    Keys.Free;
    Prj.Free;
  end;
  LogRaw('Project Properties: ' + NewName + '  ' + #149 + '  ' + NewType +
  '  ' + #149 + '  ' + NewDir);

  // Тот же проект под новым именем: имя меняем до загрузки, иначе
  // LoadProject сочтёт его другим проектом и сбросит снимки форм и
  // конструктор (ProjectSwitchReset)
         FCurrentProject := NewName;
         RebuildProjectsMenu;
         LoadProject(NewName);
  // Папка inc могла смениться - список в рамке Project
  UpdateBuildBar;
end;

// NEW PROJECT: имя, папка, тип.
//
// Окно собирается здесь же, а не лежит отдельной формой: полей три, и
// отдельный модуль ради них заводить незачем.
//
// Для Delphi кладётся заготовка из трёх файлов - .dpr, Unit1.pas и
// Unit1.dfm с пустой формой, как делает сама среда. Для прочих типов
// создаётся только папка и описание: что класть внутрь, зависит от
// компилятора, и пустой файл там мешал бы.
// Пустой файл ресурсов. Любой .res начинается с записи-пустышки: нулевой
// размер данных, заголовок 32 байта, тип и имя 0xFFFF/0x0000. Одной этой
// записи достаточно, чтобы файл был правильным и пустым - значок и версия
// лягут в него потом, когда будет чем их класть.
function TForm1.WriteEmptyRes(const AFileName: string): Boolean;
const
  NullRes: array[0..31] of Byte = (
    $00, $00, $00, $00,   // размер данных
    $20, $00, $00, $00,   // размер заголовка
    $FF, $FF, $00, $00,   // тип
    $FF, $FF, $00, $00,   // имя
    $00, $00, $00, $00,   // версия данных
    $00, $00,             // флаги памяти
    $00, $00,             // язык
    $00, $00, $00, $00,   // версия
    $00, $00, $00, $00);  // признаки
var
  F: TFileStream;
begin
  Result := False;
  try
    F := TFileStream.Create(AFileName, fmCreate);
    try
      F.WriteBuffer(NullRes, SizeOf(NullRes));
    finally
      F.Free;
    end;
    Result := True;
  except
    // Причина не важна: занят, нет прав, нет места - сообщение об этом
    // выводит вызывающая сторона
  end;
end;

procedure TForm1.NewProjectClick(Sender: TObject);
var
  Dlg: TDlgNewPrj;
  edName, edDir: TUiEdit;
  cbType: TUiComboBox;
  chkBase: TUiCheckBox;
  Dir, Nm, Tp, TargetFile: string;
  IncSysDir, IncUserDir, IncMode, IncOwnDir, IncOwnList: string;
  OnBase: Boolean;
  Existing: Boolean;  // в папке уже лежит проект - своих файлов не пишем
  Prj: TProjectIni;
  ExMain: string;     // его главный файл, '' - не найден
  SL: TStringList;
  DelphiKind: Integer; // FNewDelphiKind этого вызова

  // Есть ли в папке хоть один .pas. Расширение сверяется ещё раз: маска
  // *.pas по коротким именам находит и file.pas~ (FILE~1.PAS).
  function DirHasPas(const ADir: string): Boolean;
  var
    SR: TSearchRec;
  begin
    Result := False;
    if FindFirst(ADir + '*.pas', faAnyFile, SR) = 0 then
    try
      repeat
        if ((SR.Attr and faDirectory) = 0) and
           (CompareText(ExtractFileExt(SR.Name), '.pas') = 0) then
        begin
          Result := True;
          Exit;
        end;
      until FindNext(SR) <> 0;
    finally
      FindClose(SR);
    end;
  end;

begin
  // Несохранённый текст во всех окнах - новый проект их закроет
  // Пункт File - New - Pascal: тип Delphi и вид заготовки. Флаг
  // сбрасывается сразу - ни один выход ниже не оставит его следующему вызову.
  DelphiKind := FNewDelphiKind;
  FNewDelphiKind := 0;

  if not ConfirmSaveAll then
    Exit;

  // Окно описано в DlgNewPrj.dfm; здесь - подсказка папки, обработчики и
  // тип по умолчанию
  Dlg := TDlgNewPrj.Create(Self);
  SL := TStringList.Create;
  try
    edName := Dlg.edName;
    edDir := Dlg.edDir;
    chkBase := Dlg.chkBase;
    cbType := Dlg.cbType;

    // Папка предлагается по имени проекта: <projects>\<Имя>. Пока путь
    // совпадает с подсказкой, он идёт за именем; как только его правят
    // руками, подсказка больше не навязывается - это проверяет
    // NewPrjDirChange.
    FNewPrjBase := IncludeTrailingPathDelimiter(ProjectsDir);
    FNewPrjName := edName;
    FNewPrjDir := edDir;
    FNewPrjAutoDir := True;
    edDir.Text := FNewPrjBase;
    edName.OnChange := NewPrjNameChange;
    edDir.OnChange := NewPrjDirChange;

    // Готовый проект - папка с главным файлом (.dpr, .lpr, .ino ...). Создавать
    // исходники не нужно, нужна только запись о проекте, поэтому путь
    // берётся как есть, без подпапки по имени. Тип - из списка ниже.
    chkBase.OnClick := NewPrjOnBaseClick;
    FNewPrjOnBase := chkBase;
    FNewPrjMain := '';

    cbType.ItemIndex := 0;
    FNewPrjType := cbType;
    // Папка inc нового проекта RapidQ - по умолчанию системные (новые)
    RapidQIncSettings('', IncSysDir, IncUserDir, IncMode, IncOwnDir);
    Dlg.SetRqInc(IncSysDir, IncUserDir, 'sys', '', '');
    if DelphiKind > 0 then
    begin
      if cbType.Items.IndexOf('Delphi') >= 0 then
        cbType.ItemIndex := cbType.Items.IndexOf('Delphi');
      case DelphiKind of
        2: Dlg.Caption := 'New Project - DLL';
        3: Dlg.Caption := 'New Project - Console Application';
      else
        Dlg.Caption := 'New Project - Application';
      end;
      Dlg.cbTypeChange(cbType);
    end;

    // Кнопка выбора папки закрывает окно с mrRetry, папка выбирается
    // системным диалогом, и окно открывается заново с новым путём
    repeat
      if Dlg.ShowModal = mrRetry then
      begin
        Dir := edDir.Text;
        if BrowseFolderDialog('Папка проекта', Dir) then
        begin
          // Выбранная папка становится той, внутри которой предлагается
          // папка проекта. Если путь до этого правили руками, берём
          // выбранное как есть - подсказка там уже отключена.
          if FNewPrjAutoDir then
          begin
            FNewPrjBase := IncludeTrailingPathDelimiter(Dir);
            edDir.Text := FNewPrjBase + Trim(edName.Text);
          end
          else
            edDir.Text := Dir;
        end;
        Continue;
      end
      else if Dlg.ModalResult <> mrOk then
        Exit;
      Break;
    until False;

    Nm := Trim(edName.Text);
    Dir := Trim(edDir.Text);
    Tp := cbType.Text;
    OnBase := chkBase.Checked;
    IncMode := Dlg.RqIncMode;
    IncOwnDir := Dlg.RqIncOwnDir;
    IncOwnList := Dlg.RqIncOwnList;

    if (Nm = '') or (Dir = '') then
    begin
      ShowMessage('6146:Нужно указать имя и папку проекта.');
      Exit;
    end;

    // Имя проекта идёт в имя файла описания, поэтому символы,
    // недопустимые в именах файлов, отсекаем сразу
    if (Pos('\', Nm) > 0) or (Pos('/', Nm) > 0) or (Pos(':', Nm) > 0) or
       (Pos('*', Nm) > 0) or (Pos('?', Nm) > 0) or (Pos('"', Nm) > 0) or
       (Pos('<', Nm) > 0) or (Pos('>', Nm) > 0) or (Pos('|', Nm) > 0) then
    begin
      ShowMessage('6156:В имени проекта нельзя использовать символы ' +
      '\ / : * ? " < > |');
                  Exit;
    end;

    Dir := IncludeTrailingPathDelimiter(Dir);

    if OnBase then
    begin
      // Папку не создаём: проект уже лежит в ней
      if not DirectoryExists(Dir) then
      begin
        ShowMessage('6168:Папка не найдена:'#13#10 + Dir);
        Exit;
      end;

      // Путь могли поправить руками, а тип - сменить после выбора папки,
      // поэтому главный файл берём по тому, что в полях сейчас
      if (FNewPrjMain = '') or not FileExists(FNewPrjMain) or
         (CompareText(ExtractFilePath(FNewPrjMain), Dir) <> 0) or
         not MatchesProjectType(FNewPrjMain, Tp) then
      begin
        if not PickExistingMain(Dir, Tp, FNewPrjMain) then
          Exit;
        // Главный файл другой - и имя по нему
        Nm := NewPrjNameFor(Dir, Tp, FNewPrjMain);
      end;
    end
    else if not DirectoryExists(Dir) then
      if not ForceDirectories(Dir) then
      begin
        ShowMessage('6183:Не удалось создать папку ' + Dir);
        Exit;
      end;

    // Папка с готовым проектом: главный файл этого типа (.dpr, .lpr,
    // *.go ...) или, для Delphi и Lazarus, хотя бы один .pas. Заготовки
    // в неё не пишутся вовсе, ни один файл не перезаписывается. Target -
    // найденный главный файл. Открытых окон нет. Проверка только для
    // типов, у которых есть заготовка: остальным писать и так нечего.
    Existing := False;
    ExMain := '';
    if not OnBase and
       ((CompareText(Tp, 'Delphi') = 0) or (CompareText(Tp, 'Lazarus') = 0) or
        (CompareText(Tp, 'Go') = 0) or (CompareText(Tp, 'Python') = 0) or
        (CompareText(Tp, 'Rust') = 0)) then
    begin
      Existing := MainFilesIn(Dir, Tp, SL) > 0;
      if Existing then
      begin
        // Несколько главных файлов и выбор отменён - проект не создаём
        if not PickExistingMain(Dir, Tp, ExMain) then
          Exit;
      end
      else if ((CompareText(Tp, 'Delphi') = 0) or
               (CompareText(Tp, 'Lazarus') = 0)) and DirHasPas(Dir) then
        Existing := True;
      if Existing then
        if ExMain <> '' then
          LogDiag('New Project: в ' + Dir + ' уже есть проект, главный ' +
          'файл ' + ExtractFileName(ExMain) + ' - заготовка не ' +
          'создаётся')
        else
          LogDiag('New Project: в ' + Dir + ' есть .pas без файла проекта ' +
          '- заготовка не создаётся, Target пустой');
    end;

    // Проект с этим именем уже есть в списке (editor.ini, [Projects])
    if ProjectExists(Nm) then
      if MessageDlg('6221:Проект ' + Nm + ' уже есть в списке проектов (' +
                    ProjectDir(Nm) + '). Открыть его?',
                    mtConfirmation, [mbYes, mbNo], 0) <> mrYes then
        Exit
      else
      begin
        LoadProject(Nm);
        Exit;
      end;

    // ЗАГОТОВКА ДЛЯ DELPHI: проект, модуль и пустая форма. Готовому
    // проекту она не нужна - его файлы уже на месте.
    // Библиотека и консольная программа - только .dpr (и .res у библиотеки),
    // тем же текстом, что у Delphi 7
    if (CompareText(Tp, 'Delphi') = 0) and not OnBase and not Existing and
       (DelphiKind = 2) then
    begin
      SL.Clear;
      SL.Add('library ' + Nm + ';');
      SL.Add('');
      SL.Add('{ Important note about DLL memory management: ShareMem must be the');
      SL.Add('  first unit in your library''s USES clause AND your project''s (select');
      SL.Add('  Project-View Source) USES clause if your DLL exports any procedures or');
      SL.Add('  functions that pass strings as parameters or function results. This');
      SL.Add('  applies to all strings passed to and from your DLL--even those that');
      SL.Add('  are nested in records and classes. ShareMem is the interface unit to');
      SL.Add('  the BORLNDMM.DLL shared memory manager, which must be deployed along');
      SL.Add('  with your DLL. To avoid using BORLNDMM.DLL, pass string information');
      SL.Add('  using PChar or ShortString parameters. }');
      SL.Add('');
      SL.Add('uses');
      SL.Add('  SysUtils,');
      SL.Add('  Classes;');
      SL.Add('');
      SL.Add('{$R *.res}');
      SL.Add('');
      SL.Add('begin');
      SL.Add('end.');
      SL.SaveToFile(Dir + Nm + '.dpr');
      if not WriteEmptyRes(Dir + Nm + '.res') then
        ShowMessage('6302:Не удалось создать ' + Nm + '.res');
    end
    else if (CompareText(Tp, 'Delphi') = 0) and not OnBase and not Existing and
            (DelphiKind = 3) then
    begin
      SL.Clear;
      SL.Add('program ' + Nm + ';');
      SL.Add('');
      SL.Add('{$APPTYPE CONSOLE}');
      SL.Add('');
      SL.Add('uses');
      SL.Add('  SysUtils;');
      SL.Add('');
      SL.Add('begin');
      SL.Add('  { TODO -oUser -cConsole Main : Insert code here }');
      SL.Add('end.');
      SL.SaveToFile(Dir + Nm + '.dpr');
    end
    else if (CompareText(Tp, 'Delphi') = 0) and not OnBase and not Existing then
    begin
      SL.Clear;
      SL.Add('program ' + Nm + ';');
      SL.Add('');
      SL.Add('uses');
      SL.Add('  Forms,');
      SL.Add('  Unit1 in ''Unit1.pas'' {Form1};');
      SL.Add('');
      SL.Add('{$R *.res}');
      SL.Add('');
      SL.Add('begin');
      SL.Add('  Application.Initialize;');
      SL.Add('  Application.CreateForm(TForm1, Form1);');
      SL.Add('  Application.Run;');
      SL.Add('end.');
      SL.SaveToFile(Dir + Nm + '.dpr');

      SL.Clear;
      SL.Add('unit Unit1;');
      SL.Add('');
      SL.Add('interface');
      SL.Add('');
      SL.Add('uses');
      SL.Add('  Windows, Messages, SysUtils, Variants, Classes, Graphics,');
      SL.Add('  Controls, Forms, Dialogs;');
      SL.Add('');
      SL.Add('type');
      SL.Add('  TForm1 = class(TForm)');
      SL.Add('  private');
      SL.Add('    { Private declarations }');
      SL.Add('  public');
      SL.Add('    { Public declarations }');
      SL.Add('  end;');
      SL.Add('');
      SL.Add('var');
      SL.Add('  Form1: TForm1;');
      SL.Add('');
      SL.Add('implementation');
      SL.Add('');
      SL.Add('{$R *.dfm}');
      SL.Add('');
      SL.Add('end.');
      SL.SaveToFile(Dir + 'Unit1.pas');

      // Пустая форма в текстовом виде - среда Delphi такую и создаёт
      SL.Clear;
      SL.Add('object Form1: TForm1');
      SL.Add('  Left = 200');
      SL.Add('  Top = 120');
      SL.Add('  Width = 640');
      SL.Add('  Height = 480');
      SL.Add('  Caption = ''Form1''');
      SL.Add('  Color = clBtnFace');
      SL.Add('  Font.Charset = DEFAULT_CHARSET');
      SL.Add('  Font.Color = clWindowText');
      SL.Add('  Font.Height = -11');
      SL.Add('  Font.Name = ''MS Sans Serif''');
      SL.Add('  Font.Style = []');
      SL.Add('  OldCreateOrder = False');
      SL.Add('  PixelsPerInch = 96');
      SL.Add('  TextHeight = 13');
      SL.Add('end');
      SL.SaveToFile(Dir + 'Unit1.dfm');

      // Файл ресурсов проекта. В .dpr стоит {$R *.res}, и без него dcc32
      // останавливается на "File not found" ещё до разбора кода.
      if not WriteEmptyRes(Dir + Nm + '.res') then
        ShowMessage('6302:Не удалось создать ' + Nm + '.res');
    end;

    // ЗАГОТОВКА ДЛЯ LAZARUS: программа .lpr, модуль с формой .pas/.lfm и
    // описание проекта .lpi - без него Lazarus проект не откроет, а lazbuild
    // не соберёт. Имена модуля и формы - в нижнем регистре, как их создаёт
    // сам Lazarus.
    if (CompareText(Tp, 'Lazarus') = 0) and not OnBase and not Existing then
    begin
      SL.Clear;
      SL.Add('program ' + Nm + ';');
      SL.Add('');
      SL.Add('{$mode objfpc}{$H+}');
      SL.Add('');
      SL.Add('uses');
      SL.Add('  {$IFDEF UNIX}');
      SL.Add('  cthreads,');
      SL.Add('  {$ENDIF}');
      // Текст заготовки - латиницей: Lazarus читает исходники как UTF-8,
      // а TStringList пишет в кодировке Windows
      SL.Add('  Interfaces, // this includes the LCL widgetset');
      SL.Add('  Forms, Unit1;');
      SL.Add('');
      SL.Add('{$R *.res}');
      SL.Add('');
      SL.Add('begin');
      SL.Add('  RequireDerivedFormResource := True;');
      SL.Add('  Application.Scaled := True;');
      SL.Add('  Application.Initialize;');
      SL.Add('  Application.CreateForm(TForm1, Form1);');
      SL.Add('  Application.Run;');
      SL.Add('end.');
      SL.SaveToFile(Dir + Nm + '.lpr');

      SL.Clear;
      SL.Add('unit Unit1;');
      SL.Add('');
      SL.Add('{$mode objfpc}{$H+}');
      SL.Add('');
      SL.Add('interface');
      SL.Add('');
      SL.Add('uses');
      SL.Add('  Classes, SysUtils, Forms, Controls, Graphics, Dialogs;');
      SL.Add('');
      SL.Add('type');
      SL.Add('  TForm1 = class(TForm)');
      SL.Add('  private');
      SL.Add('');
      SL.Add('  public');
      SL.Add('');
      SL.Add('  end;');
      SL.Add('');
      SL.Add('var');
      SL.Add('  Form1: TForm1;');
      SL.Add('');
      SL.Add('implementation');
      SL.Add('');
      SL.Add('{$R *.lfm}');
      SL.Add('');
      SL.Add('end.');
      SL.SaveToFile(Dir + 'unit1.pas');

      SL.Clear;
      SL.Add('object Form1: TForm1');
      SL.Add('  Left = 200');
      SL.Add('  Height = 240');
      SL.Add('  Top = 120');
      SL.Add('  Width = 320');
      SL.Add('  Caption = ''Form1''');
      SL.Add('end');
      SL.SaveToFile(Dir + 'unit1.lfm');

      // Описание проекта: без него Lazarus не откроет проект, а lazbuild
      // не соберёт. Минимальный набор - то, что Lazarus пишет сам для
      // нового приложения.
      SL.Clear;
      SL.Add('<?xml version="1.0" encoding="UTF-8"?>');
      SL.Add('<CONFIG>');
      SL.Add('  <ProjectOptions>');
      SL.Add('    <Version Value="12"/>');
      SL.Add('    <General>');
      SL.Add('      <SessionStorage Value="InProjectDir"/>');
      SL.Add('      <Title Value="' + Nm + '"/>');
      SL.Add('      <Scaled Value="True"/>');
      SL.Add('      <ResourceType Value="res"/>');
      SL.Add('      <UseXPManifest Value="True"/>');
      SL.Add('    </General>');
      SL.Add('    <BuildModes>');
      SL.Add('      <Item Name="Default" Default="True"/>');
      SL.Add('    </BuildModes>');
      SL.Add('    <PublishOptions>');
      SL.Add('      <Version Value="2"/>');
      SL.Add('    </PublishOptions>');
      SL.Add('    <RunParams>');
      SL.Add('      <FormatVersion Value="2"/>');
      SL.Add('    </RunParams>');
      SL.Add('    <RequiredPackages>');
      SL.Add('      <Item>');
      SL.Add('        <PackageName Value="LCL"/>');
      SL.Add('      </Item>');
      SL.Add('    </RequiredPackages>');
      SL.Add('    <Units>');
      SL.Add('      <Unit>');
      SL.Add('        <Filename Value="' + Nm + '.lpr"/>');
      SL.Add('        <IsPartOfProject Value="True"/>');
      SL.Add('      </Unit>');
      SL.Add('      <Unit>');
      SL.Add('        <Filename Value="unit1.pas"/>');
      SL.Add('        <IsPartOfProject Value="True"/>');
      SL.Add('        <ComponentName Value="Form1"/>');
      SL.Add('        <HasResources Value="True"/>');
      SL.Add('        <ResourceBaseClass Value="Form"/>');
      SL.Add('        <UnitName Value="Unit1"/>');
      SL.Add('      </Unit>');
      SL.Add('    </Units>');
      SL.Add('  </ProjectOptions>');
      SL.Add('  <CompilerOptions>');
      SL.Add('    <Version Value="11"/>');
      SL.Add('    <Target>');
      SL.Add('      <Filename Value="' + Nm + '"/>');
      SL.Add('    </Target>');
      SL.Add('    <SearchPaths>');
      SL.Add('      <IncludeFiles Value="$(ProjOutDir)"/>');
      SL.Add('      <UnitOutputDirectory Value="lib\$(TargetCPU)-$(TargetOS)"/>');
      SL.Add('    </SearchPaths>');
      SL.Add('    <Linking>');
      SL.Add('      <Options>');
      SL.Add('        <Win32>');
      SL.Add('          <GraphicApplication Value="True"/>');
      SL.Add('        </Win32>');
      SL.Add('      </Options>');
      SL.Add('    </Linking>');
      SL.Add('  </CompilerOptions>');
      SL.Add('</CONFIG>');
      SL.SaveToFile(Dir + Nm + '.lpi');

      // Файл ресурсов: Lazarus при сборке перепишет его своим (значок,
      // манифест), но {$R *.res} должен находить файл и до первой сборки
      if not WriteEmptyRes(Dir + Nm + '.res') then
        ShowMessage('6441:Не удалось создать ' + Nm + '.res');
    end;

    // ЗАГОТОВКИ ДЛЯ GO, PYTHON И RUST: точка входа и, где язык её требует,
    // описание модуля или пакета - то, что создают go mod init и cargo new.
    // Текст латиницей: исходники этих языков читаются как UTF-8.
    if not OnBase and not Existing then
    begin
      if CompareText(Tp, 'Go') = 0 then
      begin
        SL.Clear;
        SL.Add('module ' + LowerCase(Nm));
        SL.Add('');
        SL.Add('go 1.21');
        SL.SaveToFile(Dir + 'go.mod');

        SL.Clear;
        SL.Add('package main');
        SL.Add('');
        SL.Add('import "fmt"');
        SL.Add('');
        SL.Add('func main() {');
        SL.Add(#9'fmt.Println("Hello, world!")');
        SL.Add('}');
        SL.SaveToFile(Dir + 'main.go');
      end
      else if CompareText(Tp, 'Python') = 0 then
      begin
        SL.Clear;
        SL.Add('def main():');
        SL.Add('    print("Hello, world!")');
        SL.Add('');
        SL.Add('');
        SL.Add('if __name__ == "__main__":');
        SL.Add('    main()');
        SL.SaveToFile(Dir + 'main.py');
      end
      else if CompareText(Tp, 'Rust') = 0 then
      begin
        // Имя пакета cargo - строчными, без пробелов
        SL.Clear;
        SL.Add('[package]');
        SL.Add('name = "' + LowerCase(StringReplace(Nm, ' ', '_',
                                                    [rfReplaceAll])) + '"');
        SL.Add('version = "0.1.0"');
        SL.Add('edition = "2021"');
        SL.Add('');
        SL.Add('[dependencies]');
        SL.SaveToFile(Dir + 'Cargo.toml');

        ForceDirectories(Dir + 'src');
        SL.Clear;
        SL.Add('fn main() {');
        SL.Add('    println!("Hello, world!");');
        SL.Add('}');
        SL.SaveToFile(Dir + 'src\main.rs');
      end;
    end;

    // Проект: запись в [Projects] (имя = папка) и раздел [Project.<имя>] -
    // тип и цель сборки
    TargetFile := '';
    if OnBase then
      TargetFile := FNewPrjMain
    else if Existing then
      TargetFile := ExMain
    else if CompareText(Tp, 'Delphi') = 0 then
      TargetFile := Dir + Nm + '.dpr'
    else if CompareText(Tp, 'Lazarus') = 0 then
      TargetFile := Dir + Nm + '.lpr'
    else if CompareText(Tp, 'Go') = 0 then
      TargetFile := Dir + 'main.go'
    else if CompareText(Tp, 'Python') = 0 then
      TargetFile := Dir + 'main.py'
    else if CompareText(Tp, 'Rust') = 0 then
      TargetFile := Dir + 'src\main.rs';

    RegisterProject(Nm, Dir);
    Prj := TProjectIni.Create(SettingsFileName, Nm);
    try
      Prj.WriteString('Project', 'Type', Tp);
      FUtilsPrjDone := False; // тип сменился - меню Utils заново
      if TargetFile <> '' then
        Prj.WriteString('Project', 'Target', PrjTargetToStore(Dir, TargetFile));
      if CompareText(Tp, 'RapidQ Basic') = 0 then
      begin
        Prj.WriteString('Project', 'IncMode', IncMode);
        Prj.WriteString('Project', 'IncPath', IncOwnDir);
        Prj.WriteString('Project', 'IncPaths', IncOwnList);
      end;
    finally
      Prj.Free;
    end;
    RebuildProjectsMenu;
    LoadProject(Nm);

    // Сразу открываем главный файл, чтобы проект не выглядел пустым:
    // у готового проекта это его главный файл, у нового - заготовка модуля
    // Готовый проект в папке (Existing) - ничего не открываем, список окон
    // пустой: файлы там чужие, а не заготовка.
    if OnBase then
      OpenNamedFile(FNewPrjMain)
    else if Existing then
      // список окон остаётся пустым
    else if (CompareText(Tp, 'Delphi') = 0) and
            FileExists(Dir + 'Unit1.pas') then
      OpenNamedFile(Dir + 'Unit1.pas')
    else if (CompareText(Tp, 'Delphi') = 0) and
            FileExists(Dir + Nm + '.dpr') then
      // DLL и консольная программа - без модуля, весь код в .dpr
      OpenNamedFile(Dir + Nm + '.dpr')
    else if (CompareText(Tp, 'Lazarus') = 0) and
            FileExists(Dir + 'unit1.pas') then
      OpenNamedFile(Dir + 'unit1.pas')
    else if (CompareText(Tp, 'Go') = 0) and FileExists(Dir + 'main.go') then
      OpenNamedFile(Dir + 'main.go')
    else if (CompareText(Tp, 'Python') = 0) and FileExists(Dir + 'main.py') then
      OpenNamedFile(Dir + 'main.py')
    else if (CompareText(Tp, 'Rust') = 0) and
            FileExists(Dir + 'src\main.rs') then
      OpenNamedFile(Dir + 'src\main.rs');

    // Список окон и вкладок пишем в описание сразу. Иначе открытый файл
    // живёт только до закрытия среды: в .prj разделов [Windows] и [Tabs]
    // ещё нет, и при следующем открытии проект будет пустым.
    SaveProjectTo(Nm);
  finally
    FNewPrjName := nil;   // окно сейчас исчезнет, ссылки на его поля тоже
    FNewPrjDir := nil;
    FNewPrjType := nil;
    FNewPrjOnBase := nil;
    SL.Free;
    Dlg.Free;
  end;
end;

// Имя проекта поменялось - ведём за ним папку: <база>\<Имя>.
//
// У готового проекта папка своя и имени проекта в ней нет, поэтому там
// подсказка не работает вовсе.
procedure TForm1.NewPrjNameChange(Sender: TObject);
begin
  if (FNewPrjName = nil) or (FNewPrjDir = nil) or not FNewPrjAutoDir then
    Exit;
  if (FNewPrjOnBase <> nil) and FNewPrjOnBase.Checked then
    Exit;
  FNewPrjDir.Text := FNewPrjBase + Trim(FNewPrjName.Text);
end;

// ---------------------------------------------------------------------------
//  Выбор папки: своё окно вместо системного "Обзор папок"
//
//  Системное окно не расширить: в нём нет ни поля для пути, ни списка
//  файлов. Здесь стандартные контролы Delphi из FileCtrl, связанные между
//  собой: диск -> папки -> файлы. Поле пути внизу работает в обе стороны:
//  выбрали папку в дереве - путь в поле; ввели существующий путь - дерево
//  переходит туда.
// ---------------------------------------------------------------------------

function TForm1.PickFolderDialog(const ACaption, AStart: string;
                                 var ADir: string): Boolean;
var
  Dummy: string;
begin
  Result := PickProjectDialog(ACaption, AStart, '', ADir, Dummy);
end;

// То же окно для готового проекта. AMask - маски главного файла типа
// (MainMasksFor): список файлов показывает только их, и выбранный в нём
// файл возвращается в AFile (двойной щелчок по нему - то же, что OK).
// Ничего не выбрано или AMask пустая - AFile = ''.
function TForm1.PickProjectDialog(const ACaption, AStart, AMask: string;
                                  var ADir, AFile: string): Boolean;
var
  Dlg: TDlgPickFolder;
  Start: string;
begin
  Result := False;
  AFile := '';

  Start := ExcludeTrailingPathDelimiter(Trim(AStart));
  if (Start = '') or not DirectoryExists(Start) then
    Start := ExcludeTrailingPathDelimiter(ProjectsDir);
  if not DirectoryExists(Start) then
    Start := ExtractFilePath(Application.ExeName);

  // Окно описано в DlgPickFolder.dfm, там же связка диск - папки - файлы.
  // Здесь - заголовок, обработчики и стартовая папка.
  Dlg := TDlgPickFolder.Create(Self);
  try
    Dlg.Caption := ACaption;

    FPickEdit := Dlg.edPath;
    FPickDir := Dlg.lstDirs;
    FPickDrive := Dlg.cmbDrive;
    FPickFiles := Dlg.lstFiles;
    FPickEdit.OnChange := PickEditChange;
    FPickDir.OnChange := PickDirChange;
    Dlg.btnOk.OnClick := PickOkClick;
    if AMask <> '' then
    begin
      // Маски вида src\main.rs список файлов не понимает - для них
      // показываем всё, а главный файл найдёт PickExistingMain
      if Pos('\', AMask) = 0 then
        FPickFiles.Mask := AMask;
      FPickFiles.OnDblClick := PickFileDblClick;
    end;

    FPickLock := False;
    try
      FPickDir.Directory := Start;
      // Диск - по папке. Порядок важен: папка уже на этом диске, и смена
      // диска в списке её не сбросит на текущую папку диска
      FPickDrive.Drive := FPickDir.Drive;
    except
      // Папка недоступна - остаёмся там, где список встал сам
    end;
    PickDirChange(nil);

    if Dlg.ShowModal = mrOk then
    begin
      ADir := IncludeTrailingPathDelimiter(Trim(FPickEdit.Text));
      Result := True;
      // Файл берётся, только если его выбрали в списке этой же папки
      if (AMask <> '') and (FPickFiles.ItemIndex >= 0) and
         (CompareText(IncludeTrailingPathDelimiter(FPickFiles.Directory),
                      ADir) = 0) then
        AFile := ADir + FPickFiles.Items[FPickFiles.ItemIndex];
    end;
  finally
    FPickEdit := nil;
    FPickDir := nil;
    FPickDrive := nil;
    FPickFiles := nil;
    Dlg.Free;
  end;
end;

// Папку выбрали в дереве - путь в поле. Флаг не даёт полю, в свою очередь,
// перевести дерево: иначе они гоняли бы значение друг другу.
procedure TForm1.PickDirChange(Sender: TObject);
begin
  // Папка сменилась - выбор файла снимаем: главный файл выбирают щелчком,
  // а не берут первым в списке
  if FPickFiles <> nil then
    FPickFiles.ItemIndex := -1;
  if (FPickDir = nil) or (FPickEdit = nil) or FPickLock then
    Exit;
  FPickLock := True;
  try
    FPickEdit.Text := FPickDir.Directory;
  finally
    FPickLock := False;
  end;
end;

// Путь ввели руками - дерево идёт за ним, но только когда такая папка есть:
// пока путь набирается, промежуточные значения вроде C:\Prog пропускаем
procedure TForm1.PickEditChange(Sender: TObject);
var
  S: string;
begin
  if (FPickDir = nil) or (FPickEdit = nil) or FPickLock then
    Exit;

  S := ExcludeTrailingPathDelimiter(Trim(FPickEdit.Text));
  if (S = '') or not DirectoryExists(S) then
    Exit;
  if CompareText(S, ExcludeTrailingPathDelimiter(FPickDir.Directory)) = 0 then
    Exit;

  FPickLock := True;
  try
    try
      FPickDir.Directory := S;
      // Путь мог уйти на другой диск - список дисков за ним, после папки
      if FPickDrive <> nil then
        FPickDrive.Drive := FPickDir.Drive;
      if FPickFiles <> nil then
        FPickFiles.ItemIndex := -1;
    except
      // Нет доступа - дерево остаётся где было
    end;
  finally
    FPickLock := False;
  end;
end;

// OK закрывает окно только с существующей папкой в поле
procedure TForm1.PickOkClick(Sender: TObject);
var
  S: string;
begin
  if FPickEdit = nil then
    Exit;
  S := ExcludeTrailingPathDelimiter(Trim(FPickEdit.Text));
  if (S = '') or not DirectoryExists(S) then
  begin
    ShowMessage('6769:Такой папки нет:'#13#10 + S);
    Exit;
  end;
  (TUiButton(Sender).Owner as TForm).ModalResult := mrOk;
end;

// Двойной щелчок по главному файлу в списке - выбор этого файла, как OK
procedure TForm1.PickFileDblClick(Sender: TObject);
begin
  if (FPickFiles = nil) or (FPickFiles.ItemIndex < 0) then
    Exit;
  if FPickFiles.Owner is TForm then
    TForm(FPickFiles.Owner).ModalResult := mrOk;
end;

// Главный файл проекта по типу - маски через точку с запятой. Пусто - у
// типа нет файла, по которому готовый проект можно узнать.
function TForm1.MainMasksFor(const AType: string): string;
begin
  if CompareText(AType, 'Delphi') = 0 then
    Result := '*.dpr'
  else if CompareText(AType, 'Lazarus') = 0 then
    Result := '*.lpr'
  else if (CompareText(AType, 'RapidQ Basic') = 0) or
          (CompareText(AType, 'FreeBASIC') = 0) then
    Result := '*.bas'
  else if CompareText(AType, 'Visual Basic') = 0 then
    Result := '*.vbp'
  else if CompareText(AType, 'Arduino') = 0 then
    Result := '*.ino'
  else if CompareText(AType, 'C project') = 0 then
    Result := '*.c'
  else if CompareText(AType, 'CPP project') = 0 then
    Result := '*.cpp'
  else if CompareText(AType, 'Go') = 0 then
    Result := '*.go'
  else if CompareText(AType, 'Python') = 0 then
    Result := '*.py'
    // У Rust исходники в src, а в корне - Cargo.toml
  else if CompareText(AType, 'Rust') = 0 then
    Result := 'src\main.rs;src\lib.rs;*.rs'
  else if CompareText(AType, 'WebSite') = 0 then
    Result := '*.html;*.htm'
  else
    Result := '';
end;

// Файл подходит типу проекта - по расширению из его масок
function TForm1.MatchesProjectType(const AFile, AType: string): Boolean;
var
  Masks, M, Ext: string;
  P: Integer;
begin
  Result := False;
  Ext := LowerCase(ExtractFileExt(AFile));
  Masks := MainMasksFor(AType);
  while Masks <> '' do
  begin
    P := Pos(';', Masks);
    if P > 0 then
    begin
      M := Copy(Masks, 1, P - 1);
      Masks := Copy(Masks, P + 1, MaxInt);
    end
    else
    begin
      M := Masks;
      Masks := '';
    end;
    if LowerCase(ExtractFileExt(M)) = Ext then
    begin
      Result := True;
      Exit;
    end;
  end;
end;

// Главные файлы проекта этого типа в папке - имена без пути
function TForm1.MainFilesIn(const ADir, AType: string; AList: TStrings): Integer;
var
  SR: TSearchRec;
  Masks, M: string;
  P: Integer;
begin
  AList.Clear;
  Masks := MainMasksFor(AType);
  while Masks <> '' do
  begin
    P := Pos(';', Masks);
    if P > 0 then
    begin
      M := Copy(Masks, 1, P - 1);
      Masks := Copy(Masks, P + 1, MaxInt);
    end
    else
    begin
      M := Masks;
      Masks := '';
    end;

    // Маска с подпапкой (src\main.rs): FindFirst вернёт одно имя файла,
    // подпапку дописываем сами - иначе путь потеряется
    if FindFirst(IncludeTrailingPathDelimiter(ADir) + M,
                 faAnyFile and not faDirectory, SR) = 0 then
    try
      repeat
        if ((SR.Attr and faDirectory) = 0) and
           (AList.IndexOf(ExtractFilePath(M) + SR.Name) < 0) then
          AList.Add(ExtractFilePath(M) + SR.Name);
      until FindNext(SR) <> 0;
    finally
      FindClose(SR);
    end;
  end;
  Result := AList.Count;
end;

// Главный файл готового проекта. Один - он. Несколько - сначала тот, что
// назван по папке (так устроен скетч Arduino, так обычно и у Delphi), у
// сайта - index.html; иначе список на выбор.
function TForm1.PickExistingMain(const ADir, AType: string;
                                 var AFile: string): Boolean;
var
  L: TStringList;
  Nm, Folder: string;
  I: Integer;
begin
  Result := False;
  AFile := '';

  if MainMasksFor(AType) = '' then
  begin
    ShowMessage('6892:Для типа ' + AType + ' готовый проект по папке не определить.');
    Exit;
  end;

  L := TStringList.Create;
  try
    if MainFilesIn(ADir, AType, L) = 0 then
    begin
      ShowMessage('6900:В папке нет файла проекта ' + AType + ' (' +
                  MainMasksFor(AType) + '):'#13#10 + ADir);
      Exit;
    end;

    Nm := '';
    if L.Count = 1 then
      Nm := L[0]
    else
    begin
      Folder := ExtractFileName(ExcludeTrailingPathDelimiter(ADir));
      for I := 0 to L.Count - 1 do
        if CompareText(ChangeFileExt(L[I], ''), Folder) = 0 then
        begin
          Nm := L[I];
          Break;
        end;
      // Точка входа по соглашению языка: main.go, main.py, src\main.rs
      if Nm = '' then
        for I := 0 to L.Count - 1 do
          if (CompareText(ChangeFileExt(ExtractFileName(L[I]), ''), 'main') = 0) or
             (CompareText(ChangeFileExt(ExtractFileName(L[I]), ''), '__main__') = 0) then
          begin
            Nm := L[I];
            Break;
          end;
      if (Nm = '') and (CompareText(AType, 'WebSite') = 0) then
        for I := 0 to L.Count - 1 do
          if CompareText(ChangeFileExt(L[I], ''), 'index') = 0 then
          begin
            Nm := L[I];
            Break;
          end;
      if Nm = '' then
        Nm := ChooseFromList('Проект ' + AType,
        'В папке несколько подходящих файлов:', L);
    end;

    if Nm = '' then
      Exit;
    AFile := IncludeTrailingPathDelimiter(ADir) + Nm;
    Result := True;
  finally
    L.Free;
  end;
end;

// Галка "На базе существующего проекта": выбираем папку, находим в ней
// главный файл проекта выбранного типа и берём путь как есть. Тип берётся
// из списка и не запирается: поменяли тип - главный файл будет найден
// заново при нажатии OK.
procedure TForm1.NewPrjOnBaseClick(Sender: TObject);
var
  Dir, Main, Tp: string;
begin
  if (FNewPrjOnBase = nil) or (FNewPrjDir = nil) or (FNewPrjName = nil) then
    Exit;

  if not FNewPrjOnBase.Checked then
  begin
    // Вернулись к обычному созданию: папка снова предлагается по имени
    FNewPrjMain := '';
    FNewPrjAutoDir := True;
    FNewPrjDir.Text := FNewPrjBase + Trim(FNewPrjName.Text);
    Exit;
  end;

  Tp := '';
  if FNewPrjType <> nil then
    Tp := FNewPrjType.Text;

  // Старт - папка из поля. Пока подсказка по имени включена, в поле
  // <выбранная папка>\<Имя>, а такой подпапки обычно нет - тогда берём
  // саму выбранную папку
  Dir := Trim(FNewPrjDir.Text);
  if (Dir = '') or not DirectoryExists(Dir) then
    Dir := FNewPrjBase;
  if not PickProjectDialog('Папка существующего проекта', Dir,
                           MainMasksFor(Tp), Dir, Main) then
  begin
    // Снятие галки поднимет этот же обработчик и вернёт остальное
    FNewPrjOnBase.Checked := False;
    Exit;
  end;

  // Файл не выбран в списке - ищем по папке (один, по имени папки или
  // список на выбор)
  if (Main = '') or not MatchesProjectType(Main, Tp) then
    if not PickExistingMain(Dir, Tp, Main) then
    begin
      FNewPrjOnBase.Checked := False;
      Exit;
    end;

  FNewPrjMain := Main;
  FNewPrjAutoDir := False;
  FNewPrjDir.Text := IncludeTrailingPathDelimiter(Dir);
  FNewPrjName.Text := NewPrjNameFor(Dir, Tp, Main);
end;

// Имя готового проекта - по главному файлу (Balanset4A.dpr -> Balanset4A).
// У сайта главный файл - index.html, у Rust - main.rs: имя по папке.
function TForm1.NewPrjNameFor(const ADir, AType, AMain: string): string;
begin
  if (CompareText(AType, 'WebSite') = 0) or (CompareText(AType, 'Rust') = 0) then
    Result := ExtractFileName(ExcludeTrailingPathDelimiter(ADir))
  else
    Result := ChangeFileExt(ExtractFileName(AMain), '');
end;

// ---------------------------------------------------------------------------
//  Сборщик активной вкладки: Delphi, RapidQ, FreeBASIC или Arduino. Решает
//  файл вкладки, а не открытый проект (CurBuildKind):
//    - описание проекта (.prj) - тип этого проекта;
//    - .pas, .dpr, .dfm, .dpk - Delphi; .ino, .pde - Arduino; .rqb, .rq -
//      RapidQ;
//    - .bas - по тексту (BasDialectOf); признаков нет - по типу проекта,
//      если он RapidQ или FreeBASIC, иначе RapidQ;
//    - .inc, .bi - по главному файлу (IncOwner); без него .bi - FreeBASIC,
//      .inc - Delphi, если в папке есть .dpr, иначе по типу проекта;
//    - .h, .c, .cpp, .hpp - Arduino, если папка - скетч (<папка>.ino),
//      иначе по типу проекта;
//    - остальное - по типу проекта.
//  Почему выбран - в FBuildReason, это пишется в лог сборки.
// ---------------------------------------------------------------------------

function BuildKindName(AKind: Integer): string;
begin
  case AKind of
    bkDelphi: Result := 'Delphi';
    bkRapidQ: Result := 'RapidQ';
    bkFreeBasic: Result := 'FreeBASIC';
    bkArduino: Result := 'Arduino';
  else
    Result := '(не определён)';
  end;
end;

// Диалект Basic по тексту. RapidQ: директивы с $ в начале строки
// ($INCLUDE, $TYPECHECK, $APPTYPE...), объявления с классами RapidQ
// (AS QFORM, CREATE ... AS Q...). FreeBASIC: директивы с # (#include,
// #define, #lang, #if...). Строки-комментарии (' и REM) не в счёт: в них
// у FreeBASIC бывает '$include из QBasic. Решает перевес; поровну или
// признаков нет - bkNone.
function BasDialectOfText(const AText: string): Integer;
var
  Lines: TStringList;
  LineIdx, RqScore, FbScore: Integer;
  LowLine: string;
begin
  RqScore := 0;
  FbScore := 0;
  Lines := TStringList.Create;
  try
    Lines.Text := AText;
    for LineIdx := 0 to Lines.Count - 1 do
    begin
      LowLine := LowerCase(TrimLeft(Lines[LineIdx]));
      if Length(LowLine) < 2 then
        Continue;
      if (LowLine[1] = '''') or (Copy(LowLine, 1, 4) = 'rem ') then
        Continue;
      if (LowLine[1] = '$') and (LowLine[2] in ['a'..'z']) then
        Inc(RqScore)
      else if (LowLine[1] = '#') and (LowLine[2] in ['a'..'z']) then
        Inc(FbScore)
      else if (Pos(' as qform', LowLine) > 0) or
              ((Copy(LowLine, 1, 7) = 'create ') and
               (Pos(' as q', LowLine) > 0)) then
        Inc(RqScore);
    end;
  finally
    Lines.Free;
  end;
  if RqScore > FbScore then
    Result := bkRapidQ
  else if FbScore > RqScore then
    Result := bkFreeBasic
  else
    Result := bkNone;
end;

// ---------------------------------------------------------------------------
//  FreeBASIC: общие функции для сборки (CompileFreeBasic), вкладки Includes
//  и разбора сообщений fbc
// ---------------------------------------------------------------------------

// Вид результата - имя для списка, editor.ini и лога
function FbOutName(AOutKind: Integer): string;
begin
  case AOutKind of
    fbOutGui: Result := 'GUI';
    fbOutDll: Result := 'DLL';
  else
    Result := 'Console';
  end;
end;

// Папки самого компилятора: inc и lib рядом с fbc (lib\win32 или
// lib\win64 - по разрядности, если такая подпапка есть). fbc ищет в них
// сам, без ключей; здесь они нужны для лога и вкладки Includes.
procedure FbDefaultDirs(const AFbcExe: string; ABits: Integer;
                        var AIncDir, ALibDir: string);
var
  BaseDir, SubDir: string;
begin
  AIncDir := '';
  ALibDir := '';
  if AFbcExe = '' then
    Exit;
  BaseDir := ExtractFilePath(AFbcExe);
  if DirectoryExists(BaseDir + 'inc') then
    AIncDir := BaseDir + 'inc';
  if ABits = 64 then
    SubDir := 'win64'
  else
    SubDir := 'win32';
  if DirectoryExists(BaseDir + 'lib\' + SubDir) then
    ALibDir := BaseDir + 'lib\' + SubDir
  else if DirectoryExists(BaseDir + 'lib') then
    ALibDir := BaseDir + 'lib';
end;

// Исходник FreeBASIC, который может быть главным файлом
function IsFbSource(const AFile: string): Boolean;
begin
  Result := LowerCase(ExtractFileExt(AFile)) = '.bas';
end;

// Имя файла из строки #include "файл" или #include once "файл";
// не #include - пусто. Косые - обратные.
function FbIncludeName(const ALine: string): string;
const
  IncTag = '#include';
  OnceTag = 'once';
var
  Txt: string;
  NameEnd: Integer;
begin
  Result := '';
  Txt := TrimLeft(ALine);
  if LowerCase(Copy(Txt, 1, Length(IncTag))) <> IncTag then
    Exit;
  Txt := TrimLeft(Copy(Txt, Length(IncTag) + 1, MaxInt));
  if LowerCase(Copy(Txt, 1, Length(OnceTag))) = OnceTag then
    Txt := TrimLeft(Copy(Txt, Length(OnceTag) + 1, MaxInt));
  if (Txt = '') or (Txt[1] <> '"') then
    Exit;
  NameEnd := 2;
  while (NameEnd <= Length(Txt)) and (Txt[NameEnd] <> '"') do
    Inc(NameEnd);
  if NameEnd > Length(Txt) then
    Exit;
  Result := Trim(Copy(Txt, 2, NameEnd - 2));
  Result := StringReplace(Result, '/', '\', [rfReplaceAll]);
end;

// Где лежит файл из #include. Порядок, как у fbc: путь полный - как есть;
// папка подключающего файла; папка главного файла; папки AIncDirs (через
// точку с запятой). '' - не найден.
function FbResolveInclude(const AName, AFromDir, AMainDir,
                          AIncDirs: string): string;
var
  Dirs: TStringList;
  DirIdx: Integer;
  Candidate: string;
begin
  Result := '';
  if AName = '' then
    Exit;
  if (ExtractFileDrive(AName) <> '') or (Copy(AName, 1, 2) = '\\') then
  begin
    if FileExists(AName) then
      Result := AName;
    Exit;
  end;
  Dirs := TStringList.Create;
  try
    if AFromDir <> '' then
      Dirs.Add(AFromDir);
    if AMainDir <> '' then
      Dirs.Add(AMainDir);
    Dirs.Text := Dirs.Text + StringReplace(AIncDirs, ';', #13#10,
                                           [rfReplaceAll]);
    for DirIdx := 0 to Dirs.Count - 1 do
    begin
      if Trim(Dirs[DirIdx]) = '' then
        Continue;
      Candidate := IncludeTrailingPathDelimiter(Trim(Dirs[DirIdx])) + AName;
      if FileExists(Candidate) then
      begin
        Result := ExpandFileName(Candidate);
        Exit;
      end;
    end;
  finally
    Dirs.Free;
  end;
end;

// Подключает ли AMain файл AFile через #include - сам или во вложенных
// #include (файлы ищутся от папки подключающего). Сравниваются полные пути.
function FbIncludes(const AMain, AFile: string): Boolean;
const
  MaxDepth = 20;
var
  Visited: TStringList;
  Target: string;

  function Scan(const AFrom: string; ALevel: Integer): Boolean;
  var
    Source: TStringList;
    LineIdx: Integer;
    IncName, Full: string;
  begin
    Result := False;
    if ALevel > MaxDepth then
      Exit;
    Source := TStringList.Create;
    try
      try
        Source.LoadFromFile(AFrom);
      except
        Exit;
      end;
      for LineIdx := 0 to Source.Count - 1 do
      begin
        IncName := FbIncludeName(Source[LineIdx]);
        if IncName = '' then
          Continue;
        Full := FbResolveInclude(IncName, ExtractFilePath(AFrom),
                                 ExtractFilePath(AMain), '');
        if Full = '' then
          Continue;
        if CompareText(ExpandFileName(Full), Target) = 0 then
        begin
          Result := True;
          Exit;
        end;
        if Visited.IndexOf(UpperCase(Full)) >= 0 then
          Continue;
        Visited.Add(UpperCase(Full));
        if Scan(Full, ALevel + 1) then
        begin
          Result := True;
          Exit;
        end;
      end;
    finally
      Source.Free;
    end;
  end;

begin
  Result := False;
  if (AMain = '') or (AFile = '') or not FileExists(AMain) then
    Exit;
  Target := ExpandFileName(AFile);
  Visited := TStringList.Create;
  try
    Visited.Add(UpperCase(ExpandFileName(AMain)));
    Result := Scan(AMain, 0);
  finally
    Visited.Free;
  end;
end;

// Строка сообщения fbc о месте в исходнике:
//   C:\путь\файл.bas(12) error 41: Variable not declared, x in 'x = 1'
//   C:\путь\файл.bi(7) warning 4(1): Suspicious pointer assignment
// Ищется ") error N" или ") warning N" - путь может сам содержать скобки
// (Program Files (x86)), поэтому номер строки берётся у скобки перед ними.
// AIsError - ошибка, а не предупреждение.
function FbParseErrorLine(const S: string; var AFile: string;
                          var ALine: Integer; var AIsError: Boolean): Boolean;
var
  LowText, Tail: string;
  ClosePos, OpenPos, TagLen: Integer;
begin
  Result := False;
  AFile := '';
  ALine := 0;
  AIsError := False;
  LowText := LowerCase(S);
  ClosePos := Pos(') error ', LowText);
  if ClosePos > 0 then
  begin
    AIsError := True;
    TagLen := Length(') error ');
  end
  else
  begin
    ClosePos := Pos(') warning ', LowText);
    TagLen := Length(') warning ');
  end;
  if ClosePos < 3 then
    Exit;
  Tail := Copy(S, ClosePos + TagLen, 1);
  if (Tail = '') or not (Tail[1] in ['0'..'9']) then
    Exit;
  OpenPos := ClosePos - 1;
  while (OpenPos > 0) and (S[OpenPos] in ['0'..'9']) do
    Dec(OpenPos);
  if (OpenPos < 2) or (S[OpenPos] <> '(') or (OpenPos = ClosePos - 1) then
    Exit;
  ALine := StrToIntDef(Copy(S, OpenPos + 1, ClosePos - OpenPos - 1), 0);
  AFile := Trim(Copy(S, 1, OpenPos - 1));
  Result := (AFile <> '') and (ALine > 0);
end;

// Ошибка fbc или его компоновщика - для красного цвета и окна ошибок
function FbIsErrorLine(const S: string): Boolean;
var
  ErrFile, LowText: string;
  ErrLine: Integer;
  IsError: Boolean;
begin
  Result := FbParseErrorLine(S, ErrFile, ErrLine, IsError) and IsError;
  if Result then
    Exit;
  LowText := LowerCase(TrimLeft(S));
  Result := (Copy(LowText, 1, 14) = 'linking failed') or
            (Copy(LowText, 1, 17) = 'assembling failed') or
            (Copy(LowText, 1, 18) = 'compiling c failed') or
            (Copy(LowText, 1, 19) = 'compiling rc failed') or
            (Pos('ld.exe: cannot find', LowText) > 0) or
            (Pos('undefined reference to', LowText) > 0);
end;

// Файлы .dpr в папке - полными путями, по имени. Маска *.dpr находит и
// x.dpr1 (его короткое имя X~1.DPR), поэтому расширение проверяется ещё
// раз. Возвращает их число.
function DelphiDprList(const ADir: string; AList: TStringList): Integer;
var
  SR: TSearchRec;
  Dir: string;
begin
  AList.Clear;
  Result := 0;
  if ADir = '' then
    Exit;
  Dir := IncludeTrailingPathDelimiter(ADir);
  if FindFirst(Dir + '*.dpr', faAnyFile and not faDirectory, SR) = 0 then
  try
    repeat
      if CompareText(ExtractFileExt(SR.Name), '.dpr') = 0 then
        AList.Add(Dir + SR.Name);
    until FindNext(SR) <> 0;
  finally
    FindClose(SR);
  end;
  AList.Sort;
  Result := AList.Count;
end;

// Тип проекта -> сборщик. Lazarus, Go и прочие, которых здесь не собрать,
// и пустое имя - bkNone. Проект без типа - RapidQ (ProjectTypeOf).
function TForm1.ProjectBuildKind(const APrj: string): Integer;
var
  PrjType: string;
begin
  Result := bkNone;
  if APrj = '' then
    Exit;
  PrjType := ProjectTypeOf(APrj);
  if CompareText(PrjType, 'Delphi') = 0 then
    Result := bkDelphi
  else if CompareText(PrjType, 'RapidQ Basic') = 0 then
    Result := bkRapidQ
  else if CompareText(PrjType, 'FreeBASIC') = 0 then
    Result := bkFreeBasic
  else if CompareText(PrjType, 'Arduino') = 0 then
    Result := bkArduino;
end;

// Диалект .bas по файлу на диске (BasDialectOfText по первым 64 КБ).
// Запоминается по пути и времени файла: после записи считается заново.
function TForm1.BasDialectOf(const AFile: string): Integer;
const
  HeadBytes = 65536;
var
  Key, Head: string;
  Idx, HeadLen: Integer;
  Stream: TFileStream;
begin
  Result := bkNone;
  if (AFile = '') or not FileExists(AFile) then
    Exit;
  Key := LowerCase(ExpandFileName(AFile)) + '|' + IntToStr(FileAge(AFile));
  if FBasDialects = nil then
  begin
    FBasDialects := TStringList.Create;
    FBasDialects.Sorted := True;
  end;
  Idx := FBasDialects.IndexOf(Key);
  if Idx >= 0 then
  begin
    Result := Integer(FBasDialects.Objects[Idx]) - 10;
    Exit;
  end;
  Head := '';
  try
    Stream := TFileStream.Create(AFile, fmOpenRead or fmShareDenyNone);
    try
      if Stream.Size > HeadBytes then
        HeadLen := HeadBytes
      else
        HeadLen := Integer(Stream.Size);
      SetLength(Head, HeadLen);
      if HeadLen > 0 then
        Stream.ReadBuffer(Head[1], HeadLen);
    finally
      Stream.Free;
    end;
  except
    Exit;   // файл занят или пропал - диалект не известен
  end;
  Result := BasDialectOfText(Head);
  FBasDialects.AddObject(Key, TObject(Result + 10));
end;

function TForm1.CurBuildKind: Integer;
var
  FileNm, Ext, Owner, PrjName, PrjNote: string;
  Dprs: TStringList;
  PrjKind: Integer;
begin
  // Выбран вручную в переключателе - он
  Result := ManualBuildKind(FCurrentFileName);
  if Result <> bkNone then
  begin
    FBuildReason := 'выбрано вручную';
    Exit;
  end;

  FileNm := FCurrentFileName;
  Ext := LowerCase(ExtractFileExt(FileNm));
  PrjName := BuildProject;
  PrjKind := ProjectBuildKind(PrjName);
  if PrjName <> '' then
    PrjNote := 'тип проекта ' + PrjName
  else
    PrjNote := 'проекта нет';
  Result := bkNone;
  FBuildReason := '';

  if Ext = '.prj' then
  begin
    Result := PrjKind;
    FBuildReason := PrjNote;
  end
  else if (Ext = '.pas') or (Ext = '.dpr') or (Ext = '.dfm') or
          (Ext = '.dpk') then
  begin
    Result := bkDelphi;
    FBuildReason := 'по расширению ' + Ext;
  end
  else if (Ext = '.ino') or (Ext = '.pde') then
  begin
    Result := bkArduino;
    FBuildReason := 'по расширению ' + Ext;
  end
  else if (Ext = '.rqb') or (Ext = '.rq') then
  begin
    Result := bkRapidQ;
    FBuildReason := 'по расширению ' + Ext;
  end
  else if Ext = '.bas' then
  begin
    // .bas, подключённый в главный файл (вкладка из Includes), - по
    // главному: у подключаемого .bas FreeBASIC #-директив часто нет
    Result := bkNone;
    Owner := CurIncOwner;
    if Owner <> '' then
    begin
      Result := BasDialectOf(Owner);
      if Result <> bkNone then
        FBuildReason := 'подключён в ' + ExtractFileName(Owner);
    end;
    if Result = bkNone then
    begin
      Result := BasDialectOf(FileNm);
      if Result <> bkNone then
        FBuildReason := 'по тексту файла'
      else if (PrjKind = bkRapidQ) or (PrjKind = bkFreeBasic) then
      begin
        Result := PrjKind;
        FBuildReason := 'признаков в тексте нет, ' + PrjNote;
      end
      else
      begin
        Result := bkRapidQ;
        FBuildReason := 'признаков в тексте нет, по умолчанию';
      end;
    end;
  end
  else if (Ext = '.inc') or (Ext = '.bi') then
  begin
    Owner := CurIncOwner;
    if Owner <> '' then
    begin
      Result := BasDialectOf(Owner);
      if Result = bkNone then
        Result := bkRapidQ;
      FBuildReason := 'подключён в ' + ExtractFileName(Owner);
    end
    else if Ext = '.bi' then
    begin
      Result := bkFreeBasic;
      FBuildReason := 'по расширению .bi';
    end
    else
    begin
      Dprs := TStringList.Create;
      try
        if DelphiDprList(ExtractFilePath(FileNm), Dprs) > 0 then
        begin
          Result := bkDelphi;
          FBuildReason := 'в папке есть .dpr';
        end;
      finally
        Dprs.Free;
      end;
      if Result = bkNone then
      begin
        Result := PrjKind;
        FBuildReason := PrjNote;
      end;
    end;
  end
  else if (Ext = '.h') or (Ext = '.c') or (Ext = '.cpp') or
          (Ext = '.hpp') then
  begin
    if IsSketchFolder(ExtractFilePath(FileNm)) then
    begin
      Result := bkArduino;
      FBuildReason := 'папка скетча';
    end
    else
    begin
      Result := PrjKind;
      FBuildReason := PrjNote;
    end;
  end
  else
  begin
    Result := PrjKind;
    FBuildReason := PrjNote;
  end;
end;

// .dpr папки ADir - цель сборки Delphi. Один - он. Ни одного - цель
// проекта Delphi (модуль из общей папки), иначе пусто. Несколько: AAsk -
// список на выбор, остальные переименовываются в .dpr1, .dpr2... (в папке
// остаётся один .dpr, вопрос больше не встаёт); без AAsk (Run, отладчик -
// молча) - цель проекта, если она среди них, иначе пусто.
function TForm1.DelphiDprInFolder(const ADir: string; AAsk: Boolean): string;
var
  Dprs, Names: TStringList;
  BuildPrj, Stored, Chosen: string;
  DprIdx: Integer;
begin
  Result := '';
  BuildPrj := BuildProject;
  Stored := '';
  if ProjectBuildKind(BuildPrj) = bkDelphi then
    Stored := ProjectTargetFind(BuildPrj);
  if Stored <> '' then
    Stored := ExpandFileName(Stored);
  Dprs := TStringList.Create;
  try
    DelphiDprList(ADir, Dprs);
    if Dprs.Count = 0 then
    begin
      if (Stored <> '') and FileExists(Stored) then
      begin
        Result := Stored;
        if AAsk then
          LogComp('В папке вкладки нет .dpr - собирается цель проекта ' +
                  BuildPrj + ': ' + Stored);
      end
      else if AAsk then
        LogComp('Компиляция: в папке ' + ADir + ' нет .dpr');
      Exit;
    end;
    if Dprs.Count = 1 then
    begin
      Result := Dprs[0];
      Exit;
    end;

    if not AAsk then
    begin
      for DprIdx := 0 to Dprs.Count - 1 do
        if CompareText(Dprs[DprIdx], Stored) = 0 then
          Result := Dprs[DprIdx];
      Exit;
    end;

    // Несколько - выбор из списка; цель проекта первой, она и выделена
    Names := TStringList.Create;
    try
      for DprIdx := 0 to Dprs.Count - 1 do
        if CompareText(Dprs[DprIdx], Stored) = 0 then
          Names.Insert(0, ExtractFileName(Dprs[DprIdx]))
        else
          Names.Add(ExtractFileName(Dprs[DprIdx]));
      Chosen := ChooseFromList('Сборка Delphi',
      'В папке несколько .dpr. Остальные будут переименованы в .dpr1, ' +
      '.dpr2...', Names);
    finally
      Names.Free;
    end;
    if Chosen = '' then
    begin
      LogComp('Компиляция отменена: .dpr не выбран');
      Exit;
    end;
    Result := IncludeTrailingPathDelimiter(ADir) + Chosen;
    DelphiRenameOtherDprs(Dprs, Result);
    // Цель проекта переименована - целью становится выбранный
    if (Stored <> '') and not FileExists(Stored) then
    begin
      SetProjectTarget(BuildPrj, Result);
      LogComp('Цель сборки проекта: ' + Result);
    end;
  finally
    Dprs.Free;
  end;
end;

// Все .dpr из ADprs, кроме AKeep, - в .dpr1, .dpr2... (номер - первый
// свободный). Открытые во вкладках - под новым именем. .dof, .res и .cfg
// не трогаются.
procedure TForm1.DelphiRenameOtherDprs(ADprs: TStrings; const AKeep: string);
var
  DprIdx, Num, WinIdx: Integer;
  OldName, NewName: string;
  Changed: Boolean;
begin
  Num := 1;
  Changed := False;
  for DprIdx := 0 to ADprs.Count - 1 do
  begin
    OldName := ADprs[DprIdx];
    if CompareText(OldName, AKeep) = 0 then
      Continue;
    repeat
      NewName := OldName + IntToStr(Num);   // X.dpr -> X.dpr1
      Inc(Num);
    until not FileExists(NewName);
    if not RenameFile(OldName, NewName) then
    begin
      LogComp('Не удалось переименовать ' + OldName + ': ' +
              SysErrorMessage(GetLastError));
      Continue;
    end;
    LogComp('Переименован: ' + ExtractFileName(OldName) + ' -> ' +
            ExtractFileName(NewName));
    WinIdx := WindowOfFile(OldName);
    if WinIdx >= 0 then
    begin
      FWindows[WinIdx].FileName := NewName;
      if WinIdx = FWindowsIndex then
        FCurrentFileName := NewName;
      Changed := True;
    end;
  end;
  if Changed then
    RefreshAllTabCaptions;
end;

// Сборщик, выбранный для файла вручную (cmbBuildKind); bkNone - не
// выбирался. Список читается из editor.ini один раз.
function TForm1.ManualBuildKind(const AFile: string): Integer;
var
  Ini: TIniFile;
  KindName: string;
  KindIdx: Integer;
begin
  Result := bkNone;
  if AFile = '' then
    Exit;
  if FBuildKindManual = nil then
  begin
    FBuildKindManual := TStringList.Create;
    if FileExists(SettingsFileName) then
    begin
      Ini := TIniFile.Create(SettingsFileName);
      try
        Ini.ReadSectionValues('BuildKind', FBuildKindManual);
      finally
        Ini.Free;
      end;
    end;
  end;
  if FBuildKindManual.Count = 0 then
    Exit;
  KindName := FBuildKindManual.Values[LowerCase(ExpandFileName(AFile))];
  if KindName = '' then
    Exit;
  for KindIdx := bkDelphi to bkArduino do
    if CompareText(BuildKindName(KindIdx), KindName) = 0 then
    begin
      Result := KindIdx;
      Exit;
    end;
end;

// Запомнить выбор для файла; bkNone - забыть (снова по файлу). В
// editor.ini - только файлы на диске, у несохранённого - до закрытия.
procedure TForm1.SetManualBuildKind(const AFile: string; AKind: Integer);
var
  Ini: TIniFile;
  Key: string;
  KeyIdx: Integer;
begin
  if AFile = '' then
    Exit;
  ManualBuildKind(AFile);   // список прочитан
  Key := LowerCase(ExpandFileName(AFile));
  KeyIdx := FBuildKindManual.IndexOfName(Key);
  if AKind = bkNone then
  begin
    if KeyIdx >= 0 then
      FBuildKindManual.Delete(KeyIdx);
  end
  else
    FBuildKindManual.Values[Key] := BuildKindName(AKind);
  if not FileExists(AFile) then
    Exit;
  Ini := TIniFile.Create(SettingsFileName);
  try
    if AKind = bkNone then
      Ini.DeleteKey('BuildKind', Key)
    else
      Ini.WriteString('BuildKind', Key, BuildKindName(AKind));
  finally
    Ini.Free;
  end;
end;

// Что соберёт сборщик AKind для активной вкладки - без вопросов и записи
// цели. Пусто - не найдено.
function TForm1.BuildTargetOf(AKind: Integer): string;
var
  Ext, Dir, Folder: string;
begin
  Result := '';
  if FCurrentFileName = '' then
    Exit;
  Ext := LowerCase(ExtractFileExt(FCurrentFileName));
  case AKind of
    bkDelphi:
      Result := DelphiTargetDpr;
    bkRapidQ:
      Result := RapidQTargetBas(False);
    bkFreeBasic:
      Result := FbTargetBas(False);
    bkArduino:
    begin
      // arduino-cli собирает папку скетча: <папка>\<папка>.ino
      Dir := ExtractFilePath(FCurrentFileName);
      Folder := ExtractFileName(ExcludeTrailingPathDelimiter(Dir));
      if FileExists(Dir + Folder + '.ino') then
        Result := Dir + Folder + '.ino'
      else if FileExists(Dir + Folder + '.pde') then
        Result := Dir + Folder + '.pde'
      else if (Ext = '.ino') or (Ext = '.pde') then
        Result := FCurrentFileName;
    end;
  end;
end;

// Переключатель сборщика и подпись цели в рамке Project: пункт - сборщик
// активной вкладки (CurBuildKind), подпись - что он соберёт
// (BuildTargetOf), подсказки - почему выбран и полный путь цели
procedure TForm1.UpdateBuildBar;
var
  Kind, OutKind, Bits, RqComp, IncLeft: Integer;
  RqViaFb: Boolean;
  Target, Why, Fqbn, BoardName, BoardText, PortText, ManualMark: string;
begin
  if (cmbBuildKind = nil) or (lblBuildTarget = nil) then
    Exit;
  Kind := CurBuildKind;
  // Сборщик выбран вручную - это видно в подписи, а не только в подсказке
  ManualMark := '';
  if ManualBuildKind(FCurrentFileName) <> bkNone then
    ManualMark := 'вручную, ';
  FBuildBarBusy := True;
  try
    if Kind = bkNone then
      cmbBuildKind.ItemIndex := -1
    else
      cmbBuildKind.ItemIndex := Kind;
  finally
    FBuildBarBusy := False;
  end;
  cmbBuildKind.Enabled := FCurrentFileName <> '';

  if Kind = bkNone then
    Why := 'не определён (' + FBuildReason + ')'
  else
    Why := BuildKindName(Kind) + ' - ' + FBuildReason;
  cmbBuildKind.Hint := 'Чем собирается вкладка: ' + Why + #13#10 +
  'Выбор в списке запоминается для этого файла; Auto - снова по файлу';

Target := '';
  if Kind <> bkNone then
    Target := BuildTargetOf(Kind);
  if Kind = bkNone then
    lblBuildTarget.Caption := ''
  else if Target = '' then
    lblBuildTarget.Caption := '» ' + ManualMark + 'цель не найдена'
  else
    lblBuildTarget.Caption := '» ' + ManualMark + ExtractFileName(Target);
  lblBuildTarget.Hint := Target;

  // Arduino: список плат на USB; у скетча ещё порт в подписи, плата и
  // порт в подсказке
  if Kind = bkArduino then
  begin
    if (FArdHw <> nil) and not FArdHwScanned then
    begin
      FArdHw.Scan(ArdCurSettings);
      FArdHwScanned := True;
    end;
    if FArdHw <> nil then
      ArdAutoPort;
    ArdFillPortCombo;
  end;
  if (Kind = bkArduino) and (Target <> '') then
  begin
    ArdReadBoard(Fqbn, BoardName);
    if Fqbn = '' then
      BoardText := 'не выбрана (меню Arduino - Board)'
    else
      BoardText := BoardName + ' (' + Fqbn + ')';
    if FArdPort = '' then
      PortText := 'не выбран (меню Arduino - Port)'
    else if (FArdPorts <> nil) and (FArdPorts.IndexOf(FArdPort) < 0) then
      PortText := FArdPort + ' - отключён'
    else
      PortText := FArdPort;
    if FArdPort <> '' then
      lblBuildTarget.Caption := lblBuildTarget.Caption + '  ' + FArdPort;
    lblBuildTarget.Hint := Target + #13#10 + 'Плата: ' + BoardText +
                           #13#10 + 'Порт: ' + PortText;
    // Подписи над списками в режиме Arduino нет (файл - на вкладке, порт -
    // в списке плат на USB): скетч, плата и порт - в подсказке списка
    if cmbArdPort <> nil then
      cmbArdPort.Hint := lblBuildTarget.Hint + #13#10 +
      'Выбор платы на USB ставит её порт и FQBN';
  end;
  lblBuildTarget.Visible := Kind <> bkArduino;

  // FreeBASIC: вид результата и разрядность главного файла
  if (Kind = bkFreeBasic) and (cmbFbKind <> nil) and (cmbFbBits <> nil) then
  begin
    FbBuildOf(Target, OutKind, Bits);
    FBuildBarBusy := True;
    try
      cmbFbKind.ItemIndex := OutKind;
      if Bits = 64 then
        cmbFbBits.ItemIndex := 1
      else
        cmbFbBits.ItemIndex := 0;
    finally
      FBuildBarBusy := False;
    end;
    cmbFbKind.Enabled := Target <> '';
    cmbFbBits.Enabled := Target <> '';
    if Target <> '' then
    begin
      lblBuildTarget.Hint := Target + #13#10 + 'Результат: ' +
                             FbOutFileOf(Target) + ' (' + FbOutName(OutKind) +
      ', ' + IntToStr(Bits) + ' бит)';
cmbFbKind.Hint := 'Вид результата для ' + ExtractFileName(Target) +
      ': GUI (-s gui), Console (-s console), DLL (-dll). Запоминается ' +
      'для главного файла';
    cmbFbBits.Hint := 'Разрядность для ' + ExtractFileName(Target) +
      ': 32 - fbc32.exe, 64 - fbc64.exe (IDE Options - Compilers - ' +
      'FreeBASIC)';
    end;
  end;

  // RapidQ: rc.exe или FreeBASIC через перевод (и тогда - разрядность)
  RqViaFb := False;
  if (Kind = bkRapidQ) and (cmbRqComp <> nil) then
  begin
    RqComp := RqCompOf(Target);
    RqViaFb := RqComp <> rqcRc;
    FBuildBarBusy := True;
    try
      cmbRqComp.ItemIndex := RqComp;
      if RqViaFb and (cmbFbBits <> nil) then
      begin
        FbBuildOf(Target, OutKind, Bits);
        if Bits = 64 then
          cmbFbBits.ItemIndex := 1
        else
          cmbFbBits.ItemIndex := 0;
      end;
    finally
      FBuildBarBusy := False;
    end;
    cmbRqComp.Enabled := Target <> '';
    cmbRqComp.Hint := 'Чем собирать ' + ExtractFileName(Target) + ': rc.exe ' +
    'RapidQ или FreeBASIC через перевод RqToFb. FB Smart - программа не ' +
    'падает там, где можно продолжить, ошибки с файлом и строкой; ' +
    'FB Compat - как RapidQ. Запоминается для главного файла; строка ' +
    '''$RQFB SMART или ''$RQFB COMPAT в исходнике выбирает режим сама';
  if RqViaFb and (cmbFbBits <> nil) then
    begin
      cmbFbBits.Enabled := Target <> '';
      cmbFbBits.Hint := 'Разрядность для ' + ExtractFileName(Target) +
      ': 32 - fbc32.exe, 64 - fbc64.exe (IDE Options - Compilers - ' +
      'FreeBASIC)';
    end;
  end;
  if cmbRqComp <> nil then
    cmbRqComp.Visible := Kind = bkRapidQ;
  if cmbFbKind <> nil then
    cmbFbKind.Visible := Kind = bkFreeBasic;
  if cmbFbBits <> nil then
  begin
    cmbFbBits.Visible := (Kind = bkFreeBasic) or RqViaFb;
    if RqViaFb and (cmbRqComp <> nil) then
      cmbFbBits.Left := cmbRqComp.Left + cmbRqComp.Width + 4
    else if cmbFbKind <> nil then
      cmbFbBits.Left := cmbFbKind.Left + cmbFbKind.Width + 4;
  end;
  // RapidQ: папка inc проекта - верхней строкой, за подписью цели, до
  // правого края рамки; подпись - до списка
  if (cmbRqInc <> nil) and (FRqIncItems <> nil) then
  begin
    cmbRqInc.Visible := Kind = bkRapidQ;
    if Kind = bkRapidQ then
    begin
      FillRqIncCombo;
      // Canvas у подписи (TGraphicControl) закрыт - ширина текста по
      // холсту списка с шрифтом подписи
      cmbRqInc.Canvas.Font := lblBuildTarget.Font;
      IncLeft := lblBuildTarget.Left +
                 cmbRqInc.Canvas.TextWidth(lblBuildTarget.Caption) + 12;
      if IncLeft > cmbRqInc.Parent.ClientWidth - 8 - 100 then
        IncLeft := cmbRqInc.Parent.ClientWidth - 8 - 100;
      if IncLeft < lblBuildTarget.Left + 60 then
        IncLeft := lblBuildTarget.Left + 60;
      cmbRqInc.SetBounds(IncLeft, 2,
                         cmbRqInc.Parent.ClientWidth - IncLeft - 8,
                         cmbRqInc.Height);
      lblBuildTarget.Width := IncLeft - lblBuildTarget.Left - 4;
    end
    else
      lblBuildTarget.Width := lblBuildTarget.Parent.ClientWidth -
                              lblBuildTarget.Left - 8;
  end;
  // Галка строгой проверки - только у сборки rc.exe (у FreeBASIC проверка
  // и так идёт переводом)
  if chkRqStrict <> nil then
  begin
    chkRqStrict.Visible := (Kind = bkRapidQ) and not RqViaFb;
    if chkRqStrict.Visible then
    begin
      FBuildBarBusy := True;
      try
        chkRqStrict.Checked := RqStrictOf(Target);
        if chkRqInfo <> nil then
          chkRqInfo.Checked := RqStrictInfoOf(Target);
      finally
        FBuildBarBusy := False;
      end;
      chkRqStrict.Enabled := Target <> '';
      if cmbRqComp <> nil then
        chkRqStrict.Left := cmbRqComp.Left + cmbRqComp.Width + 6;
      chkRqStrict.Hint := 'Строгая проверка исходника';
      if Target <> '' then
        chkRqStrict.Hint := chkRqStrict.Hint + ' ' + ExtractFileName(Target) +
          ' перед rc.exe: перевод RqToFb в режиме FB Smart, без сборки ' +
          'fbc. Нашлись ошибки - окно с вариантами исправления (или ' +
          'только лог, если стоит Info only). Запоминается для главного ' +
          'файла';
    end;
    if chkRqInfo <> nil then
    begin
      chkRqInfo.Visible := chkRqStrict.Visible;
      chkRqInfo.Left := chkRqStrict.Left + chkRqStrict.Width + 4;
      chkRqInfo.Enabled := chkRqStrict.Enabled and chkRqStrict.Checked;
    end;
  end;
end;

// Пункты списка папки inc в рамке Project: Include UnIde, Include User и
// свои папки проекта (IncPaths, IncPath) - как в Project Properties;
// выбран тот, что у проекта сейчас (RapidQIncSettings). Без проекта выбора
// нет: папка - Include UnIde, хранить выбор негде.
procedure TForm1.FillRqIncCombo;
var
  SysDir, UserDir, Mode, OwnDir, OwnList, Rest, OneDir: string;
  Prj: TProjectIni;
  SepPos, SelIdx, WidthIdx, MaxWidth: Integer;

  function DirText(const ADir: string): string;
  begin
    if ADir = '' then
      Result := '(не задана в IDE Options)'
    else
      Result := ADir;
  end;

  procedure AddOwn(const ADir: string);
  begin
    if (ADir = '') or (FRqIncItems.IndexOf('own|' + ADir) >= 0) then
      Exit;
    cmbRqInc.Items.Add(ADir);
    FRqIncItems.Add('own|' + ADir);
  end;

begin
  RapidQIncSettings(FCurrentProject, SysDir, UserDir, Mode, OwnDir);
  OwnList := '';
  if (FCurrentProject <> '') and FileExists(SettingsFileName) then
  begin
    Prj := TProjectIni.Create(SettingsFileName, FCurrentProject);
    try
      OwnList := Prj.ReadString('Project', 'IncPaths', '');
    finally
      Prj.Free;
    end;
  end;
  FBuildBarBusy := True;
  try
    cmbRqInc.Items.Clear;
    FRqIncItems.Clear;
    cmbRqInc.Items.Add('Include UnIde - ' + DirText(SysDir));
    FRqIncItems.Add('sys');
    cmbRqInc.Items.Add('Include User - ' + DirText(UserDir));
    FRqIncItems.Add('user');
    Rest := OwnList;
    while Rest <> '' do
    begin
      SepPos := Pos('|', Rest);
      if SepPos = 0 then
        SepPos := Length(Rest) + 1;
      OneDir := Trim(Copy(Rest, 1, SepPos - 1));
      Delete(Rest, 1, SepPos);
      AddOwn(OneDir);
    end;
    AddOwn(OwnDir);
    if Mode = 'own' then
      SelIdx := FRqIncItems.IndexOf('own|' + OwnDir)
    else if Mode = 'user' then
      SelIdx := 1
    else
      SelIdx := 0;
    cmbRqInc.ItemIndex := SelIdx;
  finally
    FBuildBarBusy := False;
  end;
  // Список шире самого поля: пути видны целиком
  MaxWidth := 0;
  cmbRqInc.Canvas.Font := cmbRqInc.Font;
  for WidthIdx := 0 to cmbRqInc.Items.Count - 1 do
    if cmbRqInc.Canvas.TextWidth(cmbRqInc.Items[WidthIdx]) > MaxWidth then
      MaxWidth := cmbRqInc.Canvas.TextWidth(cmbRqInc.Items[WidthIdx]);
  SendMessage(cmbRqInc.Handle, CB_SETDROPPEDWIDTH, MaxWidth + 24, 0);
  cmbRqInc.Enabled := FCurrentProject <> '';
  if FCurrentProject = '' then
    cmbRqInc.Hint := 'Папка inc (-I для rc.exe): ' + DirText(SysDir) +
      #13#10'Файл без проекта - Include UnIde. Выбор папки хранится в ' +
      'проекте (Project Properties)'
  else
    cmbRqInc.Hint := 'Папка inc проекта ' + FCurrentProject +
      ' (-I для rc.exe): ' + DirText(RapidQIncDir) + #13#10 +
      'Include UnIde, Include User - IDE Options - Compilers - RapidQ ' +
      'Basic; свои папки - Project Properties. Выбор запоминается в проекте';
end;

// Папка inc выбрана в рамке Project - в настройки проекта, как в Project
// Properties (IncMode; своя папка - IncPath)
procedure TForm1.cmbRqIncChange(Sender: TObject);
var
  Prj: TProjectIni;
  Item: string;
begin
  if FBuildBarBusy or (cmbRqInc = nil) or (FCurrentProject = '') or
     (cmbRqInc.ItemIndex < 0) or (cmbRqInc.ItemIndex >= FRqIncItems.Count) then
    Exit;
  Item := FRqIncItems[cmbRqInc.ItemIndex];
  Prj := TProjectIni.Create(SettingsFileName, FCurrentProject);
  try
    if Copy(Item, 1, 4) = 'own|' then
    begin
      Prj.WriteString('Project', 'IncMode', 'own');
      Prj.WriteString('Project', 'IncPath', Copy(Item, 5, MaxInt));
    end
    else
      Prj.WriteString('Project', 'IncMode', Item);
  finally
    Prj.Free;
  end;
  Dbg('RapidQ: папка inc проекта ' + FCurrentProject + ' - ' +
      RapidQIncDir, clGray);
  UpdateBuildBar;
  if not cmbRqInc.DroppedDown and RichEdit1.CanFocus then
    RichEdit1.SetFocus;
end;

// Галка "FB smart" для главного файла AMain (editor.ini [RapidQ.Strict],
// ключ - путь в нижнем регистре, значение 1; info - с галкой "Info only")
function TForm1.RqStrictOf(const AMain: string): Boolean;
var
  Ini: TIniFile;
begin
  if FRqStrict = nil then
  begin
    FRqStrict := TStringList.Create;
    if FileExists(SettingsFileName) then
    begin
      Ini := TIniFile.Create(SettingsFileName);
      try
        Ini.ReadSectionValues('RapidQ.Strict', FRqStrict);
      finally
        Ini.Free;
      end;
    end;
  end;
  Result := (AMain <> '') and
            ((Trim(FRqStrict.Values[LowerCase(ExpandFileName(AMain))]) = '1') or
             (Trim(FRqStrict.Values[LowerCase(ExpandFileName(AMain))]) = 'info'));
end;

function TForm1.RqStrictInfoOf(const AMain: string): Boolean;
begin
  Result := RqStrictOf(AMain) and
            (Trim(FRqStrict.Values[LowerCase(ExpandFileName(AMain))]) = 'info');
end;

procedure TForm1.SetRqStrict(const AMain: string; AOn, AInfo: Boolean);
var
  Ini: TIniFile;
  Key, Value: string;
begin
  if AMain = '' then
    Exit;
  RqStrictOf(AMain);   // список прочитан
  Key := LowerCase(ExpandFileName(AMain));
  Ini := TIniFile.Create(SettingsFileName);
  try
    if AOn then
    begin
      if AInfo then
        Value := 'info'
      else
        Value := '1';
      FRqStrict.Values[Key] := Value;
      Ini.WriteString('RapidQ.Strict', Key, Value);
    end
    else
    begin
      if FRqStrict.IndexOfName(Key) >= 0 then
        FRqStrict.Delete(FRqStrict.IndexOfName(Key));
      Ini.DeleteKey('RapidQ.Strict', Key);
    end;
  finally
    Ini.Free;
  end;
end;

procedure TForm1.chkRqStrictClick(Sender: TObject);
var
  MainBas: string;
begin
  if FBuildBarBusy or (chkRqStrict = nil) then
    Exit;
  MainBas := RapidQTargetBas(False);
  if MainBas = '' then
  begin
    UpdateBuildBar;
    Exit;
  end;
  SetRqStrict(MainBas, chkRqStrict.Checked,
              (chkRqInfo <> nil) and chkRqInfo.Checked);
  if chkRqInfo <> nil then
    chkRqInfo.Enabled := chkRqStrict.Checked;
  if not chkRqStrict.Checked then
    Dbg('RapidQ ' + ExtractFileName(MainBas) + ': без строгой проверки',
        clGray)
  else if (chkRqInfo <> nil) and chkRqInfo.Checked then
    Dbg('RapidQ ' + ExtractFileName(MainBas) + ': перед rc.exe - строгая ' +
        'проверка FB Smart, ошибки только в лог (editor.ini [RapidQ.Strict])',
        clGray)
  else
    Dbg('RapidQ ' + ExtractFileName(MainBas) + ': перед rc.exe - строгая ' +
        'проверка FB Smart, при ошибках - окно исправления (editor.ini ' +
        '[RapidQ.Strict])', clGray);
end;

// Окно строгой проверки: файл ошибки - в редактор, на строку ALine (с 1)
procedure TForm1.StrictOpenLine(const AFile: string; ALine: Integer);
begin
  OpenNamedFile(AFile);
  if ALine > 0 then
    GotoLine(ALine - 1);
end;

// Окно строгой проверки: правка строки через редактор - её можно отменить
// там же. Строка ALine (с 1) должна быть AOld, иначе (текст уже другой)
// правки нет; AInsert - ANew вставляется перед строкой ALine. После правки
// файл сохраняется: окно читает его с диска и считает строки по нему.
function TForm1.StrictEditLine(const AFile: string; ALine: Integer;
                               const AOld, ANew: string;
                               AInsert: Boolean): Boolean;
var
  LineStart, LineLen: Integer;
begin
  Result := False;
  if ALine < 1 then
    Exit;
  OpenNamedFile(AFile);
  if CompareText(ExpandFileName(FCurrentFileName), ExpandFileName(AFile)) <> 0 then
    Exit;
  LineStart := SendMessageA(RichEdit1.Handle, EM_LINEINDEX, ALine - 1, 0);
  if LineStart < 0 then
    Exit;
  LineLen := SendMessageA(RichEdit1.Handle, EM_LINELENGTH, LineStart, 0);
  if not AInsert and (ReadLineText(ALine - 1, LineStart, LineLen) <> AOld) then
    Exit;
  EditorFreeze;
  try
    RichEdit1.SelStart := LineStart;
    if AInsert then
    begin
      RichEdit1.SelLength := 0;
      RichEdit1.SelText := ANew + #13#10;
    end
    else
    begin
      RichEdit1.SelLength := LineLen;
      RichEdit1.SelText := ANew;
    end;
  finally
    EditorThaw;
  end;
  GotoLine(ALine - 1);
  LogComp('Строгая проверка: ' + ExtractFileName(AFile) + ', строка ' +
          IntToStr(ALine) + ' -> ' + Trim(ANew));
  Result := SaveCurrentFile;
end;

// Ход строгой проверки - в панель занятости над редактором
function TForm1.RqStrictProgress(APass: Integer; const AFile: string;
                                 ALinesDone, ALinesTotal: Integer): Boolean;
begin
  Result := not CompAbortWanted;
  if not Result or (GetTickCount - FRqFbProgTick < 100) then
    Exit;
  FRqFbProgTick := GetTickCount;
  BusyStage(Format('Строгая проверка: проход %d из 2, %s, строк %d',
                   [APass, ExtractFileName(AFile), ALinesDone]));
  BusyTick;
  Application.ProcessMessages;
  Result := not CompAbortWanted;
end;

// Строгая проверка перед rc.exe (галка "FB smart"): перевод RqToFb в
// режиме Smart - те же проверки, что у сборки FB Smart, без fbc. RapidQ
// сам такие места пропускает: метки у него общие для всей программы, имена
// без DIM разрешены при $TypeCheck off. Переведённые файлы - в _rqfb рядом
// с программой, как у сборки FreeBASIC. False - нашлись ошибки (или
// прервано), rc.exe не запускать.
function TForm1.RqStrictCheck(const ABas, AIncDir: string): Boolean;
var
  Options: TRqFbOptions;
  ConvResult: TRqFbResult;
  ConvMessages, Roots, LibDirs: TStringList;
  CountMessages, Skipped: TStringList;   // без пропущенных (галка в окне)
  MsgIdx, ProgErrors, Suspects, LibSuspects, Limits, SkipCount: Integer;
  StartTick: Cardinal;
  Passed, Aborted, Clean: Boolean;
  SysDir, UserDir, Mode, OwnDir: string;
  Item: TStrictError;
begin
  // Окно строгой проверки немодальное: пока оно открыто, вторая сборка его
  // не открывает - окно поднимается наверх
  if StrictFixDialogActive then
  begin
    LogComp('Окно строгой проверки уже открыто: сборка продолжится после ' +
            'него');
    Result := False;
    Exit;
  end;
  Result := True;
  if not RqStrictOf(ABas) then
    Exit;
  LogComp('--- Строгая проверка (FB Smart): ' + ExtractFileName(ABas));
  Options.Mode := rfmSmart;
  Options.IncDirs := AIncDir;
  Options.OutDir := ExtractFilePath(ABas) + '_rqfb';
  Passed := False;
  Aborted := True;
  Clean := False;
  FRqFbProgTick := 0;
  ConvMessages := TStringList.Create;
  LibDirs := TStringList.Create;
  CountMessages := TStringList.Create;
  Skipped := TStringList.Create;
  try
  BusyBegin('Строгая проверка ' + ExtractFileName(ABas));
  try
    StartTick := GetTickCount;
    Passed := RqToFbConvertEx(ABas, Options, ConvMessages, ConvResult,
                              RqStrictProgress);
    // Ограничения перевода (RETURN с меткой, CALLFUNC ...) - не ошибки
    // программы: в лог пометкой, без "Error"
    for MsgIdx := 0 to ConvMessages.Count - 1 do
    begin
      Item := StrictParseMessage(ConvMessages[MsgIdx]);
      if (Item <> nil) and (Item.Kind = skLimit) then
        LogComp(StringReplace(ConvMessages[MsgIdx], ') Error: ',
                ') Info: ограничение перевода в FreeBASIC, для rc.exe не ' +
                'важно: ', []))
      else
        LogComp(ConvMessages[MsgIdx]);
      Item.Free;
    end;
    LogSuspects(ConvMessages, ConvResult.SuspectCount);
    // Папки Include - чужие библиотеки: подозрения в их файлах окно не
    // открывают (в окне - под галкой)
    RapidQIncSettings(FCurrentProject, SysDir, UserDir, Mode, OwnDir);
    LibDirs.Add(AIncDir);
    LibDirs.Add(SysDir);
    LibDirs.Add(UserDir);
    // Записи, у которых в окне снята галка, - не считаются и окно не
    // открывают (в окне они - под галкой "Пропущенные")
    StrictLoadSkipped(SettingsFileName, ABas, Skipped);
    CountMessages.Assign(ConvMessages);
    SkipCount := StrictDropSkipped(CountMessages, Skipped);
    if SkipCount > 0 then
      LogComp(Format('Строгая проверка: пропущено по выбору %d (в окне ' +
                     'строгой проверки снята галка)', [SkipCount]));
    StrictCount(CountMessages, LibDirs, ProgErrors, Suspects, LibSuspects,
                Limits);
    Aborted := not Passed and (ConvResult.ErrorCount = 0);
    // Что rc.exe пропустит, а программа из-за этого может работать не так
    Clean := not Aborted and (ProgErrors = 0) and (Suspects = 0);
    if Aborted then
      LogComp('Строгая проверка прервана - rc.exe не запускался')
    else if Clean then
      LogComp(Format('--- Строгая проверка: ошибок программы и подозрений ' +
                     'в её файлах нет; подозрений в файлах папок Include %d, ' +
                     'ограничений перевода %d (для rc.exe не важны), %d мс',
                     [LibSuspects, Limits, GetTickCount - StartTick]))
    else
    begin
      LogComp(Format('--- Строгая проверка: ошибок программы %d, подозрений ' +
                     '%d (и в файлах папок Include %d), ограничений перевода ' +
                     '%d (для rc.exe не важны). Двойной щелчок по строке ' +
                     'открывает исходник',
                     [ProgErrors, Suspects, LibSuspects, Limits]));
      if RqStrictInfoOf(ABas) then
        LogComp('Строгая проверка: Info only - rc.exe собирает дальше');
    end;
  finally
    if Clean then
      BusyEnd('', True)
    else
      BusyEnd('Строгая проверка: есть замечания', False);
  end;
    if Aborted then
    begin
      Result := False;
      Exit;
    end;
    if Clean then
      Exit;
    if (ErrLogEdit <> nil) and (ErrLogEdit.Lines.Count > 0) then
      ShowErrLog;
    // Info only - ошибки только в лог
    if RqStrictInfoOf(ABas) then
      Exit;
    // Окно: причина каждой ошибки и что можно сделать
    Roots := TStringList.Create;
    try
      Roots.Add(AIncDir);
      if CompareText(SysDir, AIncDir) <> 0 then
        Roots.Add(SysDir);
      if (UserDir <> '') and (CompareText(UserDir, AIncDir) <> 0) then
        Roots.Add(UserDir);
      Roots.Add(ExcludeTrailingPathDelimiter(ExtractFilePath(ABas)));
      Roots.Add(ExtractFileDir(ExcludeTrailingPathDelimiter(
                ExtractFilePath(ABas))));
      if StrictFixDialog(Self, ConvMessages, Roots, LibDirs, ABas, AIncDir,
                         StrictOpenLine, StrictEditLine,
                         SettingsFileName, SearchDirsDialog) = mrIgnore then
        LogComp('Строгая проверка: rc.exe собирает (выбрано в окне)')
      else
      begin
        LogComp('Строгая проверка: rc.exe не запускался. Исправленное ' +
                'проверится при следующей сборке');
        Result := False;
      end;
    finally
      Roots.Free;
    end;
  finally
    Skipped.Free;
    CountMessages.Free;
    LibDirs.Free;
    ConvMessages.Free;
  end;
end;

// Чем собирать программу RapidQ - выбрано в рамке Project: запоминается
// для главного файла (editor.ini [RapidQ.Build])
procedure TForm1.cmbRqCompChange(Sender: TObject);
var
  MainBas: string;
  RqComp: Integer;
begin
  if FBuildBarBusy or (cmbRqComp = nil) then
    Exit;
  MainBas := RapidQTargetBas(False);
  if MainBas = '' then
  begin
    UpdateBuildBar;
    Exit;
  end;
  RqComp := cmbRqComp.ItemIndex;
  if (RqComp < rqcRc) or (RqComp > rqcFbCompat) then
    RqComp := rqcRc;
  SetRqComp(MainBas, RqComp);
  Dbg('RapidQ ' + ExtractFileName(MainBas) + ': ' + cmbRqComp.Text +
  ' (editor.ini [RapidQ.Build])', clGray);
      UpdateBuildBar;
      if not cmbRqComp.DroppedDown and RichEdit1.CanFocus then
      RichEdit1.SetFocus;
end;

// Вид результата или разрядность FreeBASIC выбраны в рамке Project:
// запоминаются для главного файла (editor.ini [FreeBASIC.Build])
procedure TForm1.cmbFbBuildChange(Sender: TObject);
var
  MainBas: string;
  OutKind, Bits: Integer;
begin
  if FBuildBarBusy or (cmbFbKind = nil) or (cmbFbBits = nil) then
    Exit;
  // RapidQ через FreeBASIC: только разрядность, вид - по $APPTYPE
  if CurBuildKind = bkRapidQ then
    MainBas := RapidQTargetBas(False)
  else
    MainBas := FbTargetBas(False);
  if MainBas = '' then
  begin
    UpdateBuildBar;
    Exit;
  end;
  if CurBuildKind = bkRapidQ then
    FbBuildOf(MainBas, OutKind, Bits)
  else
    OutKind := cmbFbKind.ItemIndex;
  if (OutKind < fbOutGui) or (OutKind > fbOutDll) then
    OutKind := fbOutConsole;
  if cmbFbBits.ItemIndex = 1 then
    Bits := 64
  else
    Bits := 32;
  SetFbBuild(MainBas, OutKind, Bits);
  Dbg('FreeBASIC ' + ExtractFileName(MainBas) + ': ' + FbOutName(OutKind) +
  ', ' + IntToStr(Bits) + ' бит (editor.ini [FreeBASIC.Build])', clGray);
      FRunExeKey := '';   // у DLL запускать нечего, exe другой
      UpdateBuildBar;
  // Фокус - в редактор, как у переключателя сборщика: иначе колесо мыши и
  // буквы меняли бы пункт и записывали это как выбор
      if (Sender is TUiComboBox) and not TUiComboBox(Sender).DroppedDown and
      RichEdit1.CanFocus then
      RichEdit1.SetFocus;
end;

// Выбор в переключателе: сборщик для файла вкладки, Auto - снова по файлу.
// Режим среды (кнопки, вкладки) и exe для Run - заново.
procedure TForm1.cmbBuildKindChange(Sender: TObject);
var
  NewKind: Integer;
begin
  if FBuildBarBusy then
    Exit;
  if FCurrentFileName = '' then
  begin
    UpdateBuildBar;
    Exit;
  end;
  NewKind := cmbBuildKind.ItemIndex;
  if (NewKind < bkDelphi) or (NewKind > bkArduino) then
    NewKind := bkNone;
  SetManualBuildKind(FCurrentFileName, NewKind);
  // Запись в editor.ini [BuildKind] - строкой в лог: по ней видно, когда
  // и для какого файла выбор сделан
  if NewKind = bkNone then
    Dbg('Сборщик для ' + ExtractFileName(FCurrentFileName) +
    ': Auto - снова по файлу', clGray)
  else
    Dbg('Сборщик для ' + ExtractFileName(FCurrentFileName) +
    ' выбран вручную: ' + BuildKindName(NewKind) +
    ' (editor.ini [BuildKind])', clGray);
        FLangModeKey := '';
        FRunExeKey := '';
        ApplyLangMode;
  // Фокус - обратно в редактор. Список выбора с фокусом меняет пункт от
  // колеса мыши и от букв на клавиатуре (F - FreeBASIC), и такая смена
  // тоже записалась бы как выбор для файла. Пока список раскрыт - не
  // трогать: по нему ходят стрелками.
        if not cmbBuildKind.DroppedDown and RichEdit1.CanFocus then
        RichEdit1.SetFocus;
end;

// Выбор одной строки из списка. Пустая строка - отказались.
function TForm1.ChooseFromList(const ACaption, APrompt: string;
                               AItems: TStrings): string;
var
  Dlg: TDlgChooseList;
begin
  Result := '';

  // Окно описано в DlgChooseList.dfm; здесь - заголовок, подпись и пункты
  Dlg := TDlgChooseList.Create(Self);
  try
    Dlg.Caption := ACaption;
    Dlg.lblPrompt.Caption := APrompt;
    Dlg.lstItems.Items.Assign(AItems);
    Dlg.lstItems.ItemIndex := 0;

    if (Dlg.ShowModal = mrOk) and (Dlg.lstItems.ItemIndex >= 0) then
      Result := Dlg.lstItems.Items[Dlg.lstItems.ItemIndex];
  finally
    Dlg.Free;
  end;
end;

// Путь поменялся. Подсказку оставляем включённой, только если новое значение
// и есть подсказка: значит, его поставили мы сами из NewPrjNameChange. Любая
// правка руками её выключает - дальше имя проекта путь не трогает.
procedure TForm1.NewPrjDirChange(Sender: TObject);
begin
  if (FNewPrjName = nil) or (FNewPrjDir = nil) then
    Exit;

  if (FNewPrjOnBase <> nil) and FNewPrjOnBase.Checked then
  begin
    FNewPrjAutoDir := False;
    Exit;
  end;
  FNewPrjAutoDir :=
    FNewPrjDir.Text = FNewPrjBase + Trim(FNewPrjName.Text);
end;

// Список проектов строится по реестру: файл описания лежит в папке своего
// проекта, и обходом одной папки его не найти. Подпись - имя и тип через
// разделитель.
procedure TForm1.RebuildProjectsMenu;
var
  It: TMenuItem;
  I: Integer;
  Nm: string;
begin
  if (mProject = nil) or (mPrjSep = nil) then
    Exit;

  while mProject.Count > mPrjSep.MenuIndex + 1 do
    mProject.Items[mProject.Count - 1].Free;

  // Подсказка показывает ТЕКУЩУЮ папку, а она меняется вместе с проектом
  if mPrjFolder <> nil then
    if FCurrentProject = '' then
      mPrjFolder.Hint := ProjectsDir
    else
      mPrjFolder.Hint := ProjectDir(FCurrentProject);

  if FProjectReg = nil then
    LoadProjectReg;

  for I := 0 to FProjectReg.Count - 1 do
  begin
    Nm := FProjectReg.Names[I];
    if Nm = '' then
      Continue;

    It := TMenuItem.Create(Self);
    It.Caption := Nm + '  ' + #149 + '  ' + ProjectTypeOf(Nm);
    // В Hint - папка проекта (её показывает строка состояния); имя -
    // начало Caption, до " • " (ProjectItemClick)
    It.Hint := FProjectReg.ValueFromIndex[I];
    It.OnClick := ProjectItemClick;
    It.RadioItem := True;
    It.Checked := CompareText(Nm, FCurrentProject) = 0;
    mProject.Add(It);
  end;

  if FProjectReg.Count = 0 then
  begin
    It := TMenuItem.Create(Self);
    It.Caption := '(no projects)';
    It.Enabled := False;
    mProject.Add(It);
  end;

  // Имя проекта показывается и в рамке Compiler
  UpdateCompilerCaption;
end;

// ---------------------------------------------------------------------------
//  Горячие папки
//
//  Искать потерянный файл по всем дискам бессмысленно: на это уйдут минуты,
//  а найдётся, скорее всего, не тот файл. Поэтому пользователь сам отмечает
//  несколько папок, в которых стоит искать, - слева дерево дисков, справа
//  список отмеченного. Список живёт в editor.ini и переживает перезапуск.
// ---------------------------------------------------------------------------

// Полный путь узла: собираем его, поднимаясь по родителям. Подпись корневого
// узла - это 'C:', поэтому склейка через '\' сразу даёт правильный путь.
function TForm1.HfNodePath(Node: TTreeNode): string;
begin
  Result := '';
  while Node <> nil do
  begin
    if Result = '' then
      Result := Node.Text
    else
      Result := Node.Text + '\' + Result;
    Node := Node.Parent;
  end;

  if Result <> '' then
    Result := IncludeTrailingPathDelimiter(Result);
end;

// Подпапки узла. Каждому потомку добавляем пустую заглушку - только ради
// плюсика: реальное содержимое читается при раскрытии, иначе обход всего
// диска встал бы намертво на первом же показе дерева.
procedure TForm1.HfFillNode(Node: TTreeNode);
var
  SR: TSearchRec;
  Base: string;
  Child: TTreeNode;
begin
  FHfTree.Items.BeginUpdate;
  try
    Node.DeleteChildren;
    Base := HfNodePath(Node);

    if FindFirst(Base + '*.*', faDirectory, SR) = 0 then
    try
      repeat
        if ((SR.Attr and faDirectory) = 0) or
           (SR.Name = '.') or (SR.Name = '..') then
          Continue;

        Child := FHfTree.Items.AddChild(Node, SR.Name);
        FHfTree.Items.AddChild(Child, '');
      until FindNext(SR) <> 0;
    finally
      FindClose(SR);
    end;
  finally
    FHfTree.Items.EndUpdate;
  end;
end;

// Корни дерева - логические диски. Сетевые и сменные тоже берём: флешка
// с исходниками ровно тот случай, ради которого всё и затевалось.
procedure TForm1.HfFillDrives;
var
  C: Char;
  Root: string;
  DT: UINT;
  Node: TTreeNode;
begin
  FHfTree.Items.BeginUpdate;
  try
    FHfTree.Items.Clear;
    for C := 'A' to 'Z' do
    begin
      Root := C + ':\';
      DT := GetDriveType(PChar(Root));
      if (DT = DRIVE_FIXED) or (DT = DRIVE_REMOVABLE) or
         (DT = DRIVE_REMOTE) or (DT = DRIVE_RAMDISK) then
      begin
        Node := FHfTree.Items.AddChild(nil, C + ':');
        FHfTree.Items.AddChild(Node, ''); // заглушка под плюсик
      end;
    end;
  finally
    FHfTree.Items.EndUpdate;
  end;
end;

procedure TForm1.HfTreeExpanding(Sender: TObject; Node: TTreeNode;
                                 var AllowExpansion: Boolean);
begin
  AllowExpansion := True;
  // Заглушка - признак того, что папка ещё не читалась
  if (Node.Count = 1) and (Node.Item[0].Text = '') then
    HfFillNode(Node);
end;

procedure TForm1.HfTreeChange(Sender: TObject; Node: TTreeNode);
begin
  // Дерево идёт за набранным путём - набранное не трогаем
  if FHfPathTyping then
    Exit;
  if Node <> nil then
    HfPathSet(HfNodePath(Node));
end;

// Путь над деревом ставит программа (выбор в дереве, щелчок в списке):
// дерево за ним не идёт, проверяется только, есть ли папка
procedure TForm1.HfPathSet(const APath: string);
begin
  if FHfPath = nil then
    Exit;
  FHfPathSetting := True;
  try
    FHfPath.Text := APath;
  finally
    FHfPathSetting := False;
  end;
  HfPathState;
end;

// Папки из строки пути нет на диске - путь красным, правее кнопок -
// "Папка не существует"; есть (или строка пуста) - обычным цветом, надпись
// убирается
procedure TForm1.HfPathState;
var
  DirPath: string;
begin
  if FHfPath = nil then
    Exit;
  DirPath := Trim(FHfPath.Text);
  if (DirPath <> '') and not DirectoryExists(DirPath) then
  begin
    FHfPath.Font.Color := $3C3CFF; // ярко-красный: виден и на тёмном фоне
    HfNote('Папка не существует', True);
  end
  else
  begin
    FHfPath.Font.Color := UiThemeColorFor(FHfPath, 'Edit.Text');
    if FHfNoteMissing then
      HfNote('');
  end;
end;

// Строку пути правят руками: папка есть - дерево раскрывается до неё
procedure TForm1.HfPathChange(Sender: TObject);
var
  DirPath: string;
begin
  if (FHfPath = nil) or FHfPathSetting then
    Exit;
  HfPathState;
  DirPath := Trim(FHfPath.Text);
  if (DirPath = '') or not DirectoryExists(DirPath) then
    Exit;
  FHfPathTyping := True;
  try
    HfSelectPath(ExcludeTrailingPathDelimiter(DirPath));
  finally
    FHfPathTyping := False;
  end;
end;

// Пояснение правее кнопки "Удалить из списка". AMissing - "Папка не
// существует", красным; остальное - цветом текста поля
procedure TForm1.HfNote(const AText: string; AMissing: Boolean);
begin
  if FHfNote = nil then
    Exit;
  FHfNote.Caption := AText;
  FHfNote.Hint := AText;
  FHfNoteMissing := AMissing;
  if AMissing then
    FHfNote.Font.Color := $3C3CFF
  else if FHfPath <> nil then
    FHfNote.Font.Color := UiThemeColorFor(FHfPath, 'Edit.Text');
end;

procedure TForm1.HfTreeDblClick(Sender: TObject);
begin
  HfAddClick(Sender); // двойной клик по папке - то же, что кнопка
end;

procedure TForm1.HfAddClick(Sender: TObject);
var
  S: string;
  I, K: Integer;
begin
  if (FHfTree = nil) or (FHfTree.Selected = nil) then
    Exit;
  // В строке пути - папка, которой нет: в дереве выделена другая, её не
  // добавляем (строка уже красная, надпись "Папка не существует")
  if (FHfPath <> nil) and (Trim(FHfPath.Text) <> '') and
     not DirectoryExists(Trim(FHfPath.Text)) then
  begin
    HfPathState;
    Exit;
  end;

  S := HfNodePath(FHfTree.Selected);
  if S = '' then
    Exit;

  // Повторно ту же папку не добавляем
  for I := 0 to FHfList.Items.Count - 1 do
    if CompareText(FHfList.Items[I], S) = 0 then
    begin
      FHfList.ItemIndex := I;
      Exit;
    end;

  I := FHfList.Items.Add(S);
  FHfList.ItemIndex := I;
  if FHfSearchMode then
  begin
    FHfList.Checked[I] := True; // только что добавили - значит она и нужна
    HfSearchFixNested(I);
  end
  else
  begin
    // Внутри отмеченной - без галки, а та отмеченная - красным; иначе
    // галка (только что добавили - она и нужна), а с вложенных в неё
    // галки снимаются
    K := HfNestedChecked(I);
    if K >= 0 then
      HfNestedRefused(I, K)
    else
    begin
      FHfList.Checked[I] := True;
      HfUncheckInner(I);
    end;
  end;
  HfSaveList;
end;

procedure TForm1.HfDelClick(Sender: TObject);
var
  I: Integer;
begin
  if (FHfList = nil) or (FHfList.ItemIndex < 0) then
    Exit;

  I := FHfList.ItemIndex;
  // Папки поиска: стандартные не удаляются
  if FHfSearchMode and (I < FHfFixedCount) then
  begin
    HfNote('Стандартную папку удалить нельзя - снимите галку, ' +
           'и она не будет искаться');
    Exit;
  end;
  FHfList.Items.Delete(I);

  if I > FHfList.Items.Count - 1 then
    I := FHfList.Items.Count - 1;
  FHfList.ItemIndex := I;
  HfSaveList;
end;

// Открывает список горячих папок (Directory Tree).
//
// APreselect - папка, которую надо показать сразу: она добавляется в список
// справа с уже поставленной галочкой и раскрывается в дереве слева. Так после
// неудачного поиска пользователю не приходится искать её руками.
procedure TForm1.ShowHotFolders(const APreselect: string);
var
  Dummy: string;
begin
  HotFoldersDialog(APreselect, '', False, Dummy);
end;

// Окно Directory Tree. APick = False - список горячих папок (ShowHotFolders).
// APick = True - выбор папок (Find In Files на диске, кнопка "..."):
// APreselect раскрывается в дереве (из списка через ";" - первая), но в
// список не добавляется; OK возвращает в ADir все отмеченные в списке
// папки через ";", а если отмеченных нет - папку из строки над деревом
// (выбранную в дереве или щелчком в списке). Список горячих папок по OK
// записывается в обоих случаях. ACaption - заголовок окна ('' - из .dfm).
// ACheckedOnly (с APick) - только отмеченные в списке: строка пути не
// подставляется, ни одной отметки - ADir пустая, и это не ошибка (папки
// поиска окна недостающих файлов: снятая галка - папка не ищется).
function TForm1.HotFoldersDialog(const APreselect, ACaption: string;
                                 APick: Boolean; var ADir: string;
                                 ACheckedOnly: Boolean): Boolean;
var
  Dlg: TDlgHotFolders;
  I, K: Integer;
  Picked: string;
begin
  Result := False;
  // Окно описано в DlgHotFolders.dfm; здесь - обработчики, заполнение и
  // сохранение списка
  Dlg := TDlgHotFolders.Create(Self);
  try
    if ACaption <> '' then
      Dlg.Caption := ACaption;
    FHfPath := Dlg.edPath;
    FHfNote := Dlg.lblNote;
    FHfNote.Caption := '';
    FHfNoteMissing := False;
    FHfPath.OnChange := HfPathChange;
    FHfTree := Dlg.tvFolders;
    FHfList := Dlg.lstFolders;
    Dlg.btnAdd.OnClick := HfAddClick;
    Dlg.btnDel.OnClick := HfDelClick;
    FHfTree.OnExpanding := HfTreeExpanding;
    FHfTree.OnChange := HfTreeChange;
    FHfTree.OnDblClick := HfTreeDblClick;
    FHfList.OnClick := HfListClick;
    HfListPrepare;
    FHfList.OnClickCheck := HfListCheck;

    HfFillDrives;

    // Переносим сохранённый список в диалог вместе с галочками: список
    // проекта (выбор папок Find In Files), а пока у проекта своего списка
    // нет - общий список горячих папок
    if not HfProjectLoad and (FHotFolders <> nil) then
      for I := 0 to FHotFolders.Count - 1 do
      begin
        FHfList.Items.Add(FHotFolders[I]);
        FHfList.Checked[I] := FHotFolders.Objects[I] <> nil;
      end;

    if APick then
    begin
      // Выбор папок: стартовая - только в дереве и в строке пути
      Picked := Trim(APreselect);
      if Pos(';', Picked) > 0 then
        Picked := Trim(Copy(Picked, 1, Pos(';', Picked) - 1));
      if Picked <> '' then
      begin
        HfSelectPath(Picked);
        HfPathSet(IncludeTrailingPathDelimiter(Picked));
      end;
    end
    // Подсказанная папка: в списке она должна быть отмечена, а в дереве -
    // раскрыта, чтобы сразу было видно, о каком месте речь
    else if APreselect <> '' then
    begin
      I := -1;
      for K := 0 to FHfList.Items.Count - 1 do
        if CompareText(FHfList.Items[K], APreselect) = 0 then
        begin
          I := K;
          Break;
        end;

      if I < 0 then
        I := FHfList.Items.Add(APreselect);

      FHfList.Checked[I] := True;
      FHfList.ItemIndex := I;
      HfSelectPath(APreselect);
    end;

    if Dlg.ShowModal <> mrOk then
      Exit;

    // Выбор папок: отмеченные в списке, иначе - из строки пути
    Picked := '';
    if APick then
      for I := 0 to FHfList.Items.Count - 1 do
        if FHfList.Checked[I] and DirectoryExists(FHfList.Items[I]) then
        begin
          if Picked <> '' then
            Picked := Picked + ';';
          Picked := Picked + ExcludeTrailingPathDelimiter(FHfList.Items[I]);
        end;
    if (Picked = '') and not (APick and ACheckedOnly) then
      Picked := Trim(FHfPath.Text);
    if APick and not ACheckedOnly and (Picked = '') then
    begin
      ShowMessage('Папка не выбрана: отметьте папки в списке или выберите ' +
      'папку в дереве');
                  Exit;
    end;
    ADir := Picked;
    Result := True;
    HfSaveList;
  finally
    // Ссылки на контролы уничтожаемой формы держать нельзя
    FHfTree := nil;
    FHfList := nil;
    FHfPath := nil;
    FHfNote := nil;
    Dlg.Free;
  end;
end;

// Список горячих папок - в FHotFolders и сразу в editor.ini, [HotFolders]
// (Dir1=1 <папка>, 1 - галка). Вызывается на каждое изменение списка
// (добавить, удалить, галка), поэтому список сохраняется и при Отмене.
// Objects хранит только признак галочки - Self или nil.
procedure TForm1.HfSaveList;
var
  Ini: TBufIniFile;
  Prj: TProjectIni;
  ItemIdx: Integer;
begin
  // Папки поиска окна утилиты - не горячие папки
  if (FHfList = nil) or FHfSearchMode then
    Exit;
  // Выбор папок Find In Files при открытом проекте - в раздел проекта
  // ([Project.<имя>], ключи FifFolders_Count, FifFolders_Dir1=1 <папка>);
  // общий список горячих папок не меняется
  if FHfProject <> '' then
  begin
    if not ProjectExists(FHfProject) then
      Exit;
    try
      Prj := TProjectIni.Create(SettingsFileName, FHfProject);
      try
        Prj.EraseSection('FifFolders');
        Prj.WriteInteger('FifFolders', 'Count', FHfList.Items.Count);
        for ItemIdx := 0 to FHfList.Items.Count - 1 do
          if FHfList.Checked[ItemIdx] then
            Prj.WriteString('FifFolders', 'Dir' + IntToStr(ItemIdx + 1),
                            '1 ' + FHfList.Items[ItemIdx])
          else
            Prj.WriteString('FifFolders', 'Dir' + IntToStr(ItemIdx + 1),
                            '0 ' + FHfList.Items[ItemIdx]);
      finally
        Prj.Free;
      end;
    except
      // папка программы только для чтения - список не сохраняется
    end;
    Exit;
  end;
  if FHotFolders = nil then
    FHotFolders := TStringList.Create;
  FHotFolders.Clear;
  for ItemIdx := 0 to FHfList.Items.Count - 1 do
    if FHfList.Checked[ItemIdx] then
      FHotFolders.AddObject(FHfList.Items[ItemIdx], Self)
    else
      FHotFolders.AddObject(FHfList.Items[ItemIdx], nil);
  try
    Ini := TBufIniFile.Create(SettingsFileName);
    try
      Ini.EraseSection('HotFolders');
      for ItemIdx := 0 to FHotFolders.Count - 1 do
        if FHotFolders.Objects[ItemIdx] <> nil then
          Ini.WriteString('HotFolders', 'Dir' + IntToStr(ItemIdx + 1),
          '1 ' + FHotFolders[ItemIdx])
        else
          Ini.WriteString('HotFolders', 'Dir' + IntToStr(ItemIdx + 1),
          '0 ' + FHotFolders[ItemIdx]);
    finally
      Ini.Free;
    end;
  except
    // папка программы только для чтения - список остаётся в памяти
  end;
end;

procedure TForm1.HfListCheck(Sender: TObject);
var
  ItemIdx, OtherIdx: Integer;
begin
  if FHfList = nil then
    Exit;
  ItemIdx := FHfList.ItemIndex;
  if FHfSearchMode then
    HfSearchFixNested(ItemIdx)
  // Галку вложенной в отмеченную не ставим: сначала надо снять галку на
  // папке верхнего уровня, она - красным. Галка на папке верхнего уровня
  // снимает галки вложенных в неё
  else if (ItemIdx >= 0) and FHfList.Checked[ItemIdx] then
  begin
    OtherIdx := HfNestedChecked(ItemIdx);
    if OtherIdx >= 0 then
    begin
      FHfList.Checked[ItemIdx] := False;
      HfNestedRefused(ItemIdx, OtherIdx);
    end
    else
      HfUncheckInner(ItemIdx);
  end;
  HfSaveList;
end;

// Отмеченная папка списка, внутри которой лежит папка строки AIdx (папка
// верхнего уровня); -1 - такой нет
function TForm1.HfNestedChecked(AIdx: Integer): Integer;
var
  ItemIdx: Integer;
begin
  Result := -1;
  if (FHfList = nil) or (AIdx < 0) or (AIdx > FHfList.Items.Count - 1) then
    Exit;
  for ItemIdx := 0 to FHfList.Items.Count - 1 do
    if (ItemIdx <> AIdx) and FHfList.Checked[ItemIdx] and
       SearchDirInside(FHfList.Items[AIdx], FHfList.Items[ItemIdx]) then
    begin
      Result := ItemIdx;
      Exit;
    end;
end;

// Галка на строке AIdx не поставлена из-за отмеченной папки верхнего
// уровня AOther: та - красным (прежняя красная - обычным), пояснение - в
// строке пути
procedure TForm1.HfNestedRefused(AIdx, AOther: Integer);
begin
  if FHfList = nil then
    Exit;
  FHfRedDir := FHfList.Items[AOther];
  FHfList.Invalidate;
  HfNote('Галка не поставлена: папка внутри отмеченной ' +
         FHfList.Items[AOther] + ' - снимите галку на ней');
end;

// Отмечена папка строки AIdx: галки вложенных в неё папок снимаются (их
// подпапки и так обходятся), пояснение - в строке пути
procedure TForm1.HfUncheckInner(AIdx: Integer);
var
  ItemIdx, Count: Integer;
begin
  if (FHfList = nil) or (AIdx < 0) or (AIdx > FHfList.Items.Count - 1) then
    Exit;
  Count := 0;
  for ItemIdx := 0 to FHfList.Items.Count - 1 do
    if (ItemIdx <> AIdx) and FHfList.Checked[ItemIdx] and
       SearchDirInside(FHfList.Items[ItemIdx], FHfList.Items[AIdx]) then
    begin
      FHfList.Checked[ItemIdx] := False;
      Inc(Count);
    end;
  if Count > 0 then
    HfNote('Сняты галки вложенных папок (' + IntToStr(Count) +
           '): они внутри ' + FHfList.Items[AIdx]);
end;

// Список папок окна: строки рисуются сами (HfListDrawItem - красная
// папка). У TCheckListBox в стиле lbStandard OnDrawItem не вызывается,
// поэтому стиль - lbOwnerDrawFixed, высота строки - по шрифту
procedure TForm1.HfListPrepare;
begin
  FHfRedDir := '';
  if FHfList = nil then
    Exit;
  FHfList.Style := lbOwnerDrawFixed;
  FHfList.Canvas.Font := FHfList.Font;
  FHfList.ItemHeight := FHfList.Canvas.TextHeight('Wg') + 2;
  FHfList.OnDrawItem := HfListDrawItem;
end;

// Список папок проекта FHfProject - в FHfList. False - проекта нет или у
// него своего списка ещё нет (тогда берётся общий список горячих папок)
function TForm1.HfProjectLoad: Boolean;
var
  Prj: TProjectIni;
  Count, KeyIdx, ItemIdx: Integer;
  Line: string;
begin
  Result := False;
  if (FHfList = nil) or (FHfProject = '') or
     not ProjectExists(FHfProject) then
    Exit;
  Prj := TProjectIni.Create(SettingsFileName, FHfProject);
  try
    if not Prj.ValueExists('FifFolders', 'Count') then
      Exit;
    Result := True;
    Count := Prj.ReadInteger('FifFolders', 'Count', 0);
    for KeyIdx := 1 to Count do
    begin
      Line := Trim(Prj.ReadString('FifFolders', 'Dir' + IntToStr(KeyIdx), ''));
      if Line = '' then
        Continue;
      if (Copy(Line, 1, 2) = '1 ') or (Copy(Line, 1, 2) = '0 ') then
      begin
        ItemIdx := FHfList.Items.Add(Copy(Line, 3, MaxInt));
        FHfList.Checked[ItemIdx] := Line[1] = '1';
      end
      else
      begin
        ItemIdx := FHfList.Items.Add(Line);
        FHfList.Checked[ItemIdx] := True;
      end;
    end;
  finally
    Prj.Free;
  end;
end;

// Строка списка папок: как у TCheckListBox по умолчанию, папка FHfRedDir -
// красным шрифтом. Галку рисует сам TCheckListBox, Rect - правее неё
procedure TForm1.HfListDrawItem(Control: TWinControl; Index: Integer;
                                Rect: TRect; State: TOwnerDrawState);
var
  Lst: TCheckListBox;
  TextRect: TRect;
begin
  Lst := TCheckListBox(Control);
  Lst.Canvas.FillRect(Rect);
  if (Index < 0) or (Index > Lst.Items.Count - 1) then
    Exit;
  if (FHfRedDir <> '') and (CompareText(Lst.Items[Index], FHfRedDir) = 0) then
    Lst.Canvas.Font.Color := $3C3CFF; // ярко-красный: виден и на тёмном фоне
  TextRect := Rect;
  Inc(TextRect.Left, 2);
  DrawText(Lst.Canvas.Handle, PChar(Lst.Items[Index]), -1, TextRect,
           DT_SINGLELINE or DT_VCENTER or DT_NOPREFIX);
end;

// Щелчок по папке в списке - она в строке пути (её вернёт выбор папки) и
// выделяется в дереве слева. Папки нет на диске - путь красным и надпись
// "Папка не существует" (HfPathState), без окна сообщения
procedure TForm1.HfListClick(Sender: TObject);
var
  DirPath: string;
begin
  if (FHfList = nil) or (FHfList.ItemIndex < 0) then
    Exit;
  DirPath := FHfList.Items[FHfList.ItemIndex];
  // Выделение в дереве меняет строку пути (HfTreeChange) - она ставится
  // после, как записана в списке
  if DirectoryExists(DirPath) then
    HfSelectPath(ExcludeTrailingPathDelimiter(DirPath));
