// Новый пункт: перед выбранным (Insert) или первым в его подменю (Create
// Submenu). Подпись New Item - править в инспекторе.
procedure TForm1.DsgMenuItemInsert(ASubmenu: Boolean);
var
  Target, NewName, OldDfm, NewDfm, PasFile, OldPas, NewPas: string;
  Number: Integer;
begin
  Target := DsgMenuItemName;
  if Target = '' then
    Exit;
  if FObjEditing then
    ObjApplyEdit;
  OldDfm := DsgGetText;
  PasFile := UnitFileFor(FDsgDfm);
  OldPas := '';
  if PasFile <> '' then
    OldPas := DsgFileText(PasFile);
  FMenuWizDfm := OldDfm;
  FMenuWizPas := OldPas;
  try
    Number := 1;
    repeat
      NewName := 'NewItem' + IntToStr(Number);
      Inc(Number);
    until DsgMenuNameFree(NewName);
  finally
    FMenuWizDfm := '';
    FMenuWizPas := '';
  end;

  if ASubmenu then
    NewDfm := DfmInsertObjectFirst(OldDfm, Target,
                                   MenuItemDfm(NewName, 'New Item'))
  else
    NewDfm := MenuDfmInsertBefore(OldDfm, Target,
                                  MenuItemDfm(NewName, 'New Item'));
  if NewDfm = OldDfm then
    Exit;
  NewPas := '';
  if OldPas <> '' then
    NewPas := PasAddField(OldPas, DfmRootClass(OldDfm), NewName, 'TMenuItem');
  DsgApply(OldDfm, NewDfm, PasFile, OldPas, NewPas, '');
  DsgSelect(NewName);
end;

// Выбранный пункт и всё его подменю - из формы, их поля - из .pas
procedure TForm1.DsgMenuItemDelete;
var
  Target, OldDfm, NewDfm, PasFile, OldPas, NewPas: string;
  Names: TStringList;
begin
  Target := DsgMenuItemName;
  if Target = '' then
    Exit;
  if FObjEditing then
    ObjApplyEdit;
  OldDfm := DsgGetText;
  Names := TStringList.Create;
  try
    if not DfmObjectNames(OldDfm, Target, Names) then
      Exit;
    NewDfm := DfmDeleteObject(OldDfm, Target);
    if NewDfm = OldDfm then
      Exit;
    NewDfm := DfmRemoveRefs(NewDfm, Names);
    PasFile := UnitFileFor(FDsgDfm);
    OldPas := '';
    NewPas := '';
    if PasFile <> '' then
    begin
      OldPas := DsgFileText(PasFile);
      if OldPas <> '' then
        NewPas := PasRemoveFields(OldPas, DfmRootClass(OldDfm), Names);
    end;
    DsgApply(OldDfm, NewDfm, PasFile, OldPas, NewPas, '');
  finally
    Names.Free;
  end;
end;

// Общий конец правок конструктора: шаг отката, запись во вкладки,
// перестройка инспектора и формы, выделение ASelect
procedure TForm1.DsgApply(const OldDfm, NewDfm, PasFile, OldPas, NewPas,
                          ASelect: string);
var
  TickStart, TickText, TickInsp: Cardinal;
  WasDeferred: Boolean;
begin
  // Таблица свойств - после правки, когда она стихнет (ObjPropsTimerTick)
  WasDeferred := FObjDeferProps;
  FObjDeferProps := True;
  try
    TickStart := GetTickCount;
    if (NewPas <> '') and (NewPas <> OldPas) then
      DsgPushUndo(OldDfm, OldPas)
    else
      DsgPushUndo(OldDfm, '');
    DsgSetText(NewDfm);
    if (NewPas <> '') and (NewPas <> OldPas) and (PasFile <> '') then
      DsgSetFileText(PasFile, NewPas);
    TickText := GetTickCount;

    FDsgSelecting := True;
    try
      FObjDfmKey := '';
      RefreshObjectInspector(False);
    finally
      FDsgSelecting := False;
    end;
    TickInsp := GetTickCount;
    DsgReload;
    Dbg('21991: конструктор, правка: тексты вкладок ' +
        IntToStr(TickText - TickStart) + ' мс, инспектор ' +
        IntToStr(TickInsp - TickText) + ' мс, форма ' +
        IntToStr(GetTickCount - TickInsp) + ' мс', clNavy);
    if (FDesigner <> nil) and (ASelect <> '') then
    begin
      FDesigner.SelectByName(ASelect);
      DsgSelect(ASelect);
    end;
  finally
    FObjDeferProps := WasDeferred;
  end;
end;

