// ФОРМАТИРОВАНИЕ ОТСТУПАМИ - меню Format text.
//
// Меняются ТОЛЬКО ведущие и хвостовые пробелы строк, сам текст строки не
// трогается. Глубина блоков считается тем же счётчиком, что и конец
// подпрограмм в RebuildSubListBlocks: слова SubOpen поднимают, слова SubEnd
// опускают. Остальное задают разделы схемы:
//   FmtOutdent - строка, начатая таким словом, пишется на уровень левее
//                (end, until, finally, except, private, public);
//   FmtSection - var, type, const, label: то, что под ними, правее;
//   FmtClass   - class, object, interface: открывают блок, но только когда
//                на строке есть '=' и она не кончается точкой с запятой,
//                иначе 'class function TForm1.Foo;' и слово interface в
//                шапке модуля считались бы открытием блока;
//   FmtHang    - then, do, else: под таким словом идёт оператор без begin,
//                и он уходит на уровень правее; строка, начатая этим
//                словом, наоборот, возвращается на уровень влево;
//   FmtStmtEnd - слова, на которых оператор закончен (нужно, чтобы отличить
//                перенос строки от нового оператора);
//
// Чем писать отступ - табами или пробелами, и сколько пробелов в уровне,
// берётся из настроек редактора (Editor Options), а не из схемы: это выбор
// пользователя, а не свойство языка. Ведущие пробельные символы строки
// отбрасываются целиком и пишутся заново, поэтому "табы в пробелы" и
// обратно - это одна и та же операция: переключить настройку и нажать
// Format text.
//
// Отдельно учитывается, ЧЕМ открыт блок: объявительный (class, record в
// разделе type) или кодовый (begin, try). Внутри объявительного слово
// procedure - это объявление метода, а не начало тела, и на стек
// подпрограмм оно не идёт.
//
// Строка продолжения (предыдущая строка оператор не закончила либо осталась
// незакрытая круглая скобка) сохраняет СВОЙ сдвиг относительно первой
// строки оператора: так не рушится выравнивание перенесённых параметров.
//
// Строки внутри блочного комментария и многострочного литерала остаются как
// есть. Откат - Edit / Отменить массовую замену: текст до форматирования
// кладётся в тот же FReplaceBackup, что и у массовой замены.
// Отступы текстового .dfm (.lfm, .xfm, .fmx) - как их пишет Delphi: по два
// пробела на уровень. object, inherited, inline и item открывают уровень,
// end закрывает (end> - ещё и коллекцию < >). Значение в ( ), < >, { } -
// на уровень глубже свойства; продолжение значения (строка кончается "="
// или "+") - тоже. Строки - в ALines (по одной на строку ASrc, как цикл
// FormatIndentText), результат - число строк с новым отступом.
function TForm1.FormatDfmLines(const ASrc: string;
                               ALines: TStringList): Integer;
var
  // Открытые конструкции: O - объект, I - item, "(", "<", "{"
  Stack: string;
  LineStart, CharIdx: Integer;
  Raw: string;
  ContNext: Boolean;

  function TopKind: Char;
  begin
    if Stack = '' then
      Result := #0
    else
      Result := Stack[Length(Stack)];
  end;

  procedure PopKind;
  begin
    if Stack <> '' then
      SetLength(Stack, Length(Stack) - 1);
  end;

  procedure DoLine;
  var
    Depth, Pos_: Integer;
    Trimmed, Code, FirstWord, NewLine: string;
    InQuote: Boolean;
  begin
    Trimmed := Trim(Raw);
    if Trimmed = '' then
    begin
      ALines.Add('');
      if Raw <> '' then
        Inc(Result);
      Exit;
    end;

    // Код без строковых литералов ('' внутри - два переключения)
    Code := '';
    InQuote := False;
    for Pos_ := 1 to Length(Trimmed) do
      if Trimmed[Pos_] = '''' then
        InQuote := not InQuote
      else if not InQuote then
        Code := Code + Trimmed[Pos_];

    Pos_ := 1;
    while (Pos_ <= Length(Code)) and
          (Code[Pos_] in ['A'..'Z', 'a'..'z', '0'..'9', '_']) do
      Inc(Pos_);
    FirstWord := LowerCase(Copy(Code, 1, Pos_ - 1));

    if (FirstWord = 'end') and (TopKind in ['O', 'I']) then
      Depth := Length(Stack) - 1
    else
    begin
      Depth := Length(Stack);
      if ContNext then
        Inc(Depth);
    end;
    if Depth < 0 then
      Depth := 0;

    // Пробелы в конце строки не трогаем
    NewLine := StringOfChar(' ', Depth * 2) + TrimLeft(Raw);
    ALines.Add(NewLine);
    if NewLine <> Raw then
      Inc(Result);

    if (FirstWord = 'object') or (FirstWord = 'inherited') or
       (FirstWord = 'inline') then
      Stack := Stack + 'O'
    else if LowerCase(Code) = 'item' then
      Stack := Stack + 'I'
    else if (FirstWord = 'end') and (TopKind in ['O', 'I']) then
    begin
      PopKind;
      for Pos_ := 4 to Length(Code) do
        if (Code[Pos_] = '>') and (TopKind = '<') then
          PopKind;
    end
    else
      for Pos_ := 1 to Length(Code) do
      case Code[Pos_] of
        '(', '{', '<':
        Stack := Stack + Code[Pos_];
        ')':
        if TopKind = '(' then
          PopKind;
        '}':
        if TopKind = '{' then
          PopKind;
        '>':
        if TopKind = '<' then
          PopKind;
      end;

    // Последний символ - по строке целиком: у "Caption = 'x'" код без
    // литерала кончается "=", но значение уже есть
    ContNext := not (TopKind in ['(', '{', '<']) and
                (Trimmed[Length(Trimmed)] in ['=', '+']);
  end;

begin
  Result := 0;
  Stack := '';
  ContNext := False;
  LineStart := 1;
  CharIdx := 1;
  while CharIdx <= Length(ASrc) + 1 do
  begin
    if (CharIdx > Length(ASrc)) or (ASrc[CharIdx] = #13) or
       (ASrc[CharIdx] = #10) then
    begin
      Raw := Copy(ASrc, LineStart, CharIdx - LineStart);
      DoLine;
      if (CharIdx < Length(ASrc)) and (ASrc[CharIdx] = #13) and
         (ASrc[CharIdx + 1] = #10) then
        Inc(CharIdx);
      LineStart := CharIdx + 1;
    end;
    Inc(CharIdx);
  end;
end;

// ---------------------------------------------------------------------------
//  RapidQ: дерево объектов в отступах (Format text). Объекты, объявленные
//  DIM ... AS Qxxx и привязанные к родителю "Имя.Parent = Родитель", стоят
//  ступенькой: строка DIM ребёнка - на уровень правее строки DIM родителя,
//  строки свойств объекта (Имя.Свойство = ...) - на уровень правее его DIM.
//  Линии отступа (направляющие) тогда сами показывают, где чьи дети.
//    DIM Panel AS QPANEL: Panel.Parent = Form
//        Panel.Top = 3
//        DIM Lbl AS QLABEL: Lbl.Parent = Panel
//            Lbl.Caption = "..."
//  Глубина объекта - число предков, объявленных в этом же файле; родитель
//  из другого файла глубины не добавляет. Объект без родителя и без детей
//  в файле не трогается. Комментарий-строка берёт уровень следующей строки
//  кода. Результат - добавка уровня к отступу для каждой строки ASrc
//  (строки - как в FormatIndentText: CR, LF или CR LF).
// ---------------------------------------------------------------------------
function TForm1.RqParentLevels(const ASrc: string): TIntArray;
const
  NameChars = ['A'..'Z', 'a'..'z', '0'..'9', '_'];
  MaxDepth = 32;
var
  Lines: TStringList;       // код строк без комментариев
  Parents: TStringList;     // ИМЯ=РОДИТЕЛЬ
  Declared: TStringList;    // объявленные DIM ... AS, с сортировкой
  HasKids: TStringList;     // объекты, у которых в файле есть дети
  LineIdx, CharIdx, LineStart, StmtIdx, Pending, PendIdx: Integer;
  Code, Group, ObjName, Kind: string;
  Stmts: TStringList;
  Extra: Integer;

  // Код строки [AFrom..ATo] до первого символа комментария (карта
  // CommentRanges): комментарий RapidQ идёт до конца строки
  function LineCode(AFrom, ATo: Integer): string;
  var
    Pos1: Integer;
  begin
    Pos1 := AFrom;
    while (Pos1 <= ATo) and not InRanges(CommentRanges, Pos1 - 1) do
      Inc(Pos1);
    Result := Copy(ASrc, AFrom, Pos1 - AFrom);
  end;

  // Операторы строки через ":" (двоеточие в кавычках - не разделитель)
  procedure SplitStmts(const ACode: string; AOut: TStrings);
  var
    Pos1: Integer;
    InStr: Boolean;
    Part: string;
  begin
    AOut.Clear;
    Part := '';
    InStr := False;
    for Pos1 := 1 to Length(ACode) do
    begin
      if ACode[Pos1] = '"' then
        InStr := not InStr;
      if (ACode[Pos1] = ':') and not InStr then
      begin
        AOut.Add(Trim(Part));
        Part := '';
      end
      else
        Part := Part + ACode[Pos1];
    end;
    AOut.Add(Trim(Part));
  end;

  // Слово с позиции APos (после пробелов); APos - за ним
  function NextWord(const AText: string; var APos: Integer): string;
  var
    StartPos: Integer;
  begin
    while (APos <= Length(AText)) and (AText[APos] in [' ', #9]) do
      Inc(APos);
    StartPos := APos;
    while (APos <= Length(AText)) and (AText[APos] in NameChars) do
      Inc(APos);
    Result := UpperCase(Copy(AText, StartPos, APos - StartPos));
  end;

  // "DIM [SHARED] Имя AS Тип" - имя объекта, иначе ''
  function DimName(const AStmt: string): string;
  var
    Pos1: Integer;
    Word1: string;
  begin
    Result := '';
    Pos1 := 1;
    if NextWord(AStmt, Pos1) <> 'DIM' then
      Exit;
    Word1 := NextWord(AStmt, Pos1);
    if Word1 = 'SHARED' then
      Word1 := NextWord(AStmt, Pos1);
    if (Word1 = '') or (NextWord(AStmt, Pos1) <> 'AS') then
      Exit;
    if NextWord(AStmt, Pos1) = '' then
      Exit;
    Result := Word1;
  end;

  // "Имя.Что-то ..." - имя объекта (до первой точки), иначе ''; AProp -
  // слово после точки
  function DotName(const AStmt: string; var AProp: string): string;
  var
    Pos1: Integer;
  begin
    Result := '';
    AProp := '';
    Pos1 := 1;
    Result := NextWord(AStmt, Pos1);
    if (Result = '') or (Pos1 > Length(AStmt)) or (AStmt[Pos1] <> '.') then
    begin
      Result := '';
      Exit;
    end;
    Inc(Pos1);
    AProp := NextWord(AStmt, Pos1);
  end;

  // "Имя.Parent = Родитель" - в Parents
  procedure NoteParent(const AStmt: string);
  var
    Pos1: Integer;
    Child, Prop, Parent: string;
  begin
    Child := DotName(AStmt, Prop);
    if (Child = '') or (Prop <> 'PARENT') then
      Exit;
    Pos1 := Pos('=', AStmt);
    if Pos1 = 0 then
      Exit;
    Inc(Pos1);
    Parent := NextWord(AStmt, Pos1);
    if (Parent <> '') and (Parents.IndexOfName(Child) < 0) then
      Parents.Add(Child + '=' + Parent);
  end;

  function Depth(const AName: string): Integer;
  var
    Cur: string;
    Steps: Integer;
  begin
    Result := 0;
    Cur := AName;
    Steps := 0;
    while Steps < MaxDepth do
    begin
      Cur := Parents.Values[Cur];
      if (Cur = '') or (Declared.IndexOf(Cur) < 0) then
        Break;
      Inc(Result);
      Inc(Steps);
    end;
  end;

  // Объект в дереве файла: есть объявленный родитель или дети
  function InTree(const AName: string): Boolean;
  begin
    Result := (Declared.IndexOf(AName) >= 0) and
              ((Depth(AName) > 0) or (HasKids.IndexOf(AName) >= 0));
  end;

begin
  Lines := TStringList.Create;
  Parents := TStringList.Create;
  Declared := TStringList.Create;
  HasKids := TStringList.Create;
  Stmts := TStringList.Create;
  try
    Declared.Sorted := True;
    Declared.Duplicates := dupIgnore;
    HasKids.Sorted := True;
    HasKids.Duplicates := dupIgnore;

    // Строки - так же, как их делит FormatIndentText
    LineStart := 1;
    CharIdx := 1;
    while CharIdx <= Length(ASrc) + 1 do
    begin
      if (CharIdx > Length(ASrc)) or (ASrc[CharIdx] = #13) or
         (ASrc[CharIdx] = #10) then
      begin
        Lines.Add(Trim(LineCode(LineStart, CharIdx - 1)));
        if (CharIdx < Length(ASrc)) and (ASrc[CharIdx] = #13) and
           (ASrc[CharIdx + 1] = #10) then
          Inc(CharIdx);
        LineStart := CharIdx + 1;
      end;
      Inc(CharIdx);
    end;

    // Проход 1: объявления и родители
    for LineIdx := 0 to Lines.Count - 1 do
    begin
      if Lines[LineIdx] = '' then
        Continue;
      SplitStmts(Lines[LineIdx], Stmts);
      for StmtIdx := 0 to Stmts.Count - 1 do
      begin
        ObjName := DimName(Stmts[StmtIdx]);
        if ObjName <> '' then
          Declared.Add(ObjName);
        NoteParent(Stmts[StmtIdx]);
      end;
    end;
    for StmtIdx := 0 to Parents.Count - 1 do
      if Declared.IndexOf(Parents.Names[StmtIdx]) >= 0 then
        HasKids.Add(Parents.ValueFromIndex[StmtIdx]);

    // Проход 2: уровни строк
    SetLength(Result, Lines.Count);
    Group := '';
    Pending := 0;
    for LineIdx := 0 to Lines.Count - 1 do
    begin
      Result[LineIdx] := 0;
      Code := Lines[LineIdx];
      if Code = '' then
      begin
        Inc(Pending);   // пустая или комментарий - по следующей строке
        Continue;
      end;
      Extra := 0;
      SplitStmts(Code, Stmts);
      ObjName := DimName(Stmts[0]);
      if (ObjName <> '') and InTree(ObjName) then
      begin
        Extra := Depth(ObjName);
        Group := ObjName;
      end
      else
      begin
        ObjName := DotName(Stmts[0], Kind);
        if (Group <> '') and (ObjName = Group) then
          Extra := Depth(Group) + 1
        else
          Group := '';
      end;
      Result[LineIdx] := Extra;
      // Комментарии над строкой - с ней (пустые строки отступа не имеют)
      for PendIdx := LineIdx - Pending to LineIdx - 1 do
        Result[PendIdx] := Extra;
      Pending := 0;
    end;
  finally
    Stmts.Free;
    HasKids.Free;
    Declared.Free;
    Parents.Free;
    Lines.Free;
  end;
end;

procedure TForm1.FormatIndentText;
var
  // RapidQ: добавка уровня строки за родителя объекта (RqParentLevels)
  ParentLevels: TIntArray;
  Src, Res, Raw, Body, Pad: string;
  SL: TStringList;
  I, Len, LineStart, K, Unop, Base, Step: Integer;
  // Колонки выравнивания незакрытых скобок, в координатах нового текста:
  // первый символ после "(". Вершина - самая внутренняя скобка.
  ParenCols: array of Integer;
  PC: Integer;
  NewIndent, StmtOld, StmtNew, CaretLine, Changed: Integer;
  Cont, PrevInside: Boolean;
  B: TBlockState;
  L: TLineScan;
  PrevCode: string;
  OrigText, Expanded: string;
  ExpandCount, VtCount: Integer;
  // Строки, код которых кончается точкой: номер строки и её новый текст
  SusLines: array of Integer;
  SusTexts: array of string;
  SusNote, SusPlace: string;
  // Текстовый .dfm (.lfm, .xfm, .fmx): отступы - FormatDfmLines
  IsDfm: Boolean;

  // Код строки кончается точкой: "Output." - имя после точки не дописано,
  // и компилятор прочтёт это вместе со следующей строкой. Не считаются:
  // "end." в конце модуля, ".." (диапазон, перенесённый на другую строку),
  // число с точкой.
  function EndsWithDot(const ACode: string): Boolean;
  var
    EndPos: Integer;
    PrevW: string;
  begin
    Result := False;
    EndPos := Length(ACode);
    while (EndPos >= 1) and (ACode[EndPos] in [' ', #9]) do
      Dec(EndPos);
    if (EndPos < 2) or (ACode[EndPos] <> '.') then
      Exit;
    if ACode[EndPos - 1] = '.' then
      Exit;
    PrevW := LastToken(Copy(ACode, 1, EndPos - 1));
    if PrevW = '' then
      Exit;
    if PrevW[1] in ['0'..'9'] then
      Exit;
    if SameText(PrevW, 'end') or
       ((FScheme.FSubEndWords <> nil) and
        (FScheme.FSubEndWords.IndexOf(PrevW) >= 0)) then
      Exit;
    Result := True;
  end;

// Закончен ли оператор строкой S
  function EndsStatement(const S: string): Boolean;
  var
    LastW: string;
  begin
    Result := True;
    if S = '' then
      Exit;

    // В режиме тегов оператор - это тег: закончен, если закрыта угловая
    // скобка. Тег, растянутый на несколько строк, считается переносом.
    if FScheme.FSubTags then
    begin
      Result := S[Length(S)] = '>';
      Exit;
    end;

    if S[Length(S)] = ';' then
      Exit;

    LastW := LastToken(S);
    if LastW = '' then
    begin
      Result := False;
      Exit;
    end;

    Result := (FScheme.FSubOpenWords.IndexOf(LastW) >= 0) or
              (FScheme.FSubEndWords.IndexOf(LastW) >= 0) or
              (FScheme.FFmtOutdent.IndexOf(LastW) >= 0) or
              (FScheme.FFmtSection.IndexOf(LastW) >= 0) or
              (FScheme.FFmtHang.IndexOf(LastW) >= 0) or
              (FScheme.FFmtStmtEnd.IndexOf(LastW) >= 0);
  end;

begin
  Raw := '';
  if (FWindowsIndex >= 0) and FWindows[FWindowsIndex].Used then
    Raw := LowerCase(ExtractFileExt(FWindows[FWindowsIndex].FileName));
  if Raw = '' then
    Raw := LowerCase(ExtractFileExt(FCurrentFileName));
  if Copy(Raw, Length(Raw), 1) = ')' then
    Delete(Raw, Length(Raw), 1);   // '(без имени.dfm)'
  IsDfm := (Raw = '.dfm') or (Raw = '.lfm') or (Raw = '.xfm') or
           (Raw = '.fmx');

  if not IsDfm and not FScheme.FSubTags and
     ((FScheme.FSubOpenWords = nil) or (FScheme.FSubOpenWords.Count = 0)) and
     ((FScheme.FSubOpenFirst = nil) or (FScheme.FSubOpenFirst.Count = 0)) then
  begin
    ShowMessage('30975:Слова блоков для этого языка в схеме не заданы ' +
    '(разделы SubOpen, SubOpenFirst, SubStyle) - ' +
    'форматировать нечем.');
                Exit;
  end;

  CaretLine := SendMessageA(RichEdit1.Handle, EM_LINEFROMCHAR,
                            RichEdit1.SelStart, 0);

  // RapidQ: однострочные "CREATE ... : ... : END CREATE" - сначала по
  // строке на оператор, отступы им расставит форматирование ниже
  OrigText := '';
  ExpandCount := 0;
  if (FCurrentFileName <> '') and IncludesApply then
  begin
    Expanded := RapidQExpandCreateLines(GetEditorTextCR, ExpandCount,
                                        CaretLine);
    if ExpandCount > 0 then
    begin
      OrigText := GetEditorText;
      FLockHighlight := True;
      try
        SetEditorText(StringReplace(Expanded, #13, #13#10, [rfReplaceAll]));
      finally
        FLockHighlight := False;
      end;
      FMapStale := True;
    end;
  end;

  // Мягкие переносы #11 (вставлял Shift+Enter) - обычными переводами
  // строки: иначе текст после #11 считается той же строкой, и его отступ
  // не трогается
  VtCount := 0;
  Expanded := GetEditorText;
  for K := 1 to Length(Expanded) do
    if Expanded[K] = #11 then
      Inc(VtCount);
  if VtCount > 0 then
  begin
    if OrigText = '' then
      OrigText := Expanded;
    FLockHighlight := True;
    try
      SetEditorText(StringReplace(Expanded, #11, #13#10, [rfReplaceAll]));
    finally
      FLockHighlight := False;
    end;
    FMapStale := True;
  end;

  // Карта комментариев и литералов должна быть по текущему тексту: по ней
  // отсекаются слова внутри строк и комментариев
  if FMapStale then
    RebuildCommentRangeMap;

  Step := FIndentSize;
  if Step < 1 then
    Step := 2;

  // Текст с одиночными CR: позиции в нём совпадают с картами
  Src := GetEditorTextCR;
  Len := Length(Src);
  if Len = 0 then
    Exit;

  // RapidQ: дети объектов - ступенькой под родителями
  SetLength(ParentLevels, 0);
  if not IsDfm and (FCurrentFileName <> '') and IncludesApply and
     (CurBuildKind = bkRapidQ) then
    ParentLevels := RqParentLevels(Src);

  SL := TStringList.Create;
  try
    BlockInit(B);
    B.BeforeScope := (FScheme.FSubScope <> '') and (SubScopeStart(Src) > 1);
    PrevCode := '';
    StmtOld := 0;
    StmtNew := 0;
    Changed := 0;
    PrevInside := False;
    LineStart := 1;
    SetLength(SusLines, 0);
    SetLength(SusTexts, 0);

    // .dfm - своим разбором, цикл ниже не выполняется
    if IsDfm then
    begin
      Changed := FormatDfmLines(Src, SL);
      I := Len + 2;
    end
    else
      I := 1;
    while I <= Len + 1 do
    begin
      if (I > Len) or (Src[I] = #13) or (Src[I] = #10) then
      begin
        Raw := Copy(Src, LineStart, I - LineStart);
        ScanLine(Src, LineStart, I - 1, B, L);

        if L.Empty then
        begin
          SL.Add('');
          if Raw <> '' then
            Inc(Changed);
        end
        else if L.Inside then
        begin
          // БЛОЧНЫЙ КОММЕНТАРИЙ (и многострочный литерал) двигается
          // целиком: первая его строка встаёт по уровню блока, остальные
          // сохраняют свой сдвиг относительно неё. Так внутреннее
          // выравнивание не рушится, а комментарий у левого края
          // перестаёт разрывать столбик направляющих.
          Body := Copy(Src, L.FirstPos, L.LastPos - L.FirstPos + 1);

          if PrevInside then
            NewIndent := StmtNew + (L.Indent - StmtOld)
          else
          begin
            Unop := 0;
            for K := 0 to B.Top do
              if not B.Opened[K] then
                Inc(Unop);

            Base := B.Depth + Unop + B.Hang;
            if (B.Top >= 0) and not B.Opened[B.Top] then
              Dec(Base);
            if B.InSection then
              Inc(Base);
            if Base < 0 then
              Base := 0;

            NewIndent := Base * Step;
            StmtOld := L.Indent;
            StmtNew := NewIndent;
          end;
          if NewIndent < 0 then
            NewIndent := 0;

          case FIndentKind of
            IndentTabs:
              Pad := StringOfChar(#9, NewIndent);
            IndentNone:
              Pad := '';
          else
            Pad := StringOfChar(' ', NewIndent);
          end;

          SL.Add(Pad + Body);
          if Raw <> Pad + Body then
            Inc(Changed);
        end
        else
        begin
          Body := Copy(Src, L.FirstPos, L.LastPos - L.FirstPos + 1);

          // Строка, начатая словом блока или переноса (begin, else, then),
          // продолжением не считается никогда. Иначе цепочка
          // if ... then <оператор без ;> else ... разъезжалась вправо: else
          // сохранял чужой сдвиг, свой уровень не возвращал, а хвостовое
          // then добавляло ещё один.
          // Язык с явным знаком переноса (Бейсик): продолжение - только
          // строка, кончившаяся этим знаком. Иначе по незаконченному
          // оператору, как в Паскале и C.
          if FScheme.FFmtContinue.Count > 0 then
            Cont := FScheme.FFmtContinue.IndexOf(LastToken(PrevCode)) >= 0
          else
            Cont := (B.Paren > 0) or not EndsStatement(PrevCode);

          Cont := Cont and (L.Code <> '') and (PrevCode <> '') and
                  not L.IsHeader and not L.IsOutdent and not L.IsSect and
                  not L.IsOpen and not L.IsHang;

          BlockBeforeLine(L, B);

          // Скобок, открытых выше, не осталось - и колонок выравнивания
          if B.Paren <= 0 then
            SetLength(ParenCols, 0);

          if Cont and (B.Paren > 0) and (Length(ParenCols) > 0) and
             (FIndentKind <> IndentTabs) and (FIndentKind <> IndentNone) then
            // Перенос внутри скобки - под первый символ после неё: под
            // первый параметр. Табами колонку не выставить, там остаётся
            // прежнее правило.
            NewIndent := ParenCols[High(ParenCols)]
          else if Cont then
          begin
            // Свой сдвиг относительно первой строки оператора
            NewIndent := StmtNew + (L.Indent - StmtOld);
            if NewIndent < 0 then
              NewIndent := 0;
          end
          else
          begin
            Unop := 0;
            for K := 0 to B.Top do
              if not B.Opened[K] then
                Inc(Unop);

            Base := B.Depth + Unop;
            // Своя объявительная часть уровня не добавляет: var и begin
            // процедуры стоят вровень с её заголовком
            if not L.IsHeader and (B.Top >= 0) and not B.Opened[B.Top] then
              Dec(Base);

            Inc(Base, B.Hang);
            if B.InSection and not L.IsHeader then
              Inc(Base);
            if L.IsOutdent then
              Dec(Base);
            // RapidQ: объект под родителем, свойства - под объектом
            if SL.Count < Length(ParentLevels) then
              Inc(Base, ParentLevels[SL.Count]);

            // В режиме тегов уровень задаёт стек, а не счётчик: у
            // закрывающего тега это уровень его парного
            if FScheme.FSubTags then
              if not TagCloseLevel(Src, L, B, Base) then
                Base := B.Depth;

            if Base < 0 then
              Base := 0;

            NewIndent := Base * Step;
            if L.Code <> '' then
            begin
              StmtOld := L.Indent;
              StmtNew := NewIndent;
            end;
          end;

          // Отступ по настройке. NewIndent считается в уровнях, умноженных
          // на шаг; табов и "без отступа" это касается по-своему.
          case FIndentKind of
            IndentTabs:
            // Уровень - Step табуляций, как в пробельном режиме Step
            // пробелов. NewIndent уже посчитан как уровни на Step.
              Pad := StringOfChar(#9, NewIndent);
            IndentNone:
              Pad := '';
          else
            Pad := StringOfChar(' ', NewIndent);
          end;

          SL.Add(Pad + Body);
          if Raw <> Pad + Body then
            Inc(Changed);

          // Язык без знака переноса (Паскаль, C): строка не должна
          // кончаться точкой
          if (FScheme.FFmtContinue.Count = 0) and not FScheme.FSubTags and
             EndsWithDot(L.Code) then
          begin
            SetLength(SusLines, Length(SusLines) + 1);
            SetLength(SusTexts, Length(SusTexts) + 1);
            SusLines[High(SusLines)] := SL.Count - 1;
            SusTexts[High(SusTexts)] := Pad + Body;
          end;

          // Скобки строки: открытая - колонка первого непробельного символа
          // после неё (при пробельном отступе колонка = отступ + позиция в
          // коде); скобка в конце строки - на шаг правее начала оператора.
          // Закрытая снимает свою колонку. Строки в кавычках пропускаем.
          if L.Code <> '' then
          begin
            K := 1;
            while K <= Length(L.Code) do
            begin
              if L.Code[K] = '''' then
              begin
                Inc(K);
                while (K <= Length(L.Code)) and (L.Code[K] <> '''') do
                  Inc(K);
              end
              else if L.Code[K] = '(' then
              begin
                PC := K + 1;
                while (PC <= Length(L.Code)) and (L.Code[PC] in [' ', #9]) do
                  Inc(PC);
                SetLength(ParenCols, Length(ParenCols) + 1);
                if PC <= Length(L.Code) then
                  ParenCols[High(ParenCols)] := NewIndent + PC - 1
                else
                  ParenCols[High(ParenCols)] := StmtNew + Step;
              end
              else if (L.Code[K] = ')') and (Length(ParenCols) > 0) then
                SetLength(ParenCols, Length(ParenCols) - 1);
              Inc(K);
            end;
          end;

          if L.IsHeader then
            BlockPushHeader(-1, B);
          BlockAfterLine(Src, L, B);

          if L.Code <> '' then
            PrevCode := L.Code;
        end;

        // Пустая строка комментарий не прерывает: якорь сдвига остаётся
        if not L.Empty then
          PrevInside := L.Inside;

        // Перевод строки: CR, LF или CRLF
        if (I < Len) and (Src[I] = #13) and (Src[I + 1] = #10) then
          Inc(I);
        LineStart := I + 1;
      end;
      Inc(I);
    end;

    // Строки с точкой в конце - в Compilation log и в окно ошибок, строкой
    // "файл(строка) ...": двойной щелчок переходит к ней. В редакторе -
    // фоном Format.SuspectBG (FFmtSusLine). Номера строк после
    // форматирования те же: строк оно не добавляет и не убирает.
    FmtSuspectClear;
    SusNote := '';
    if Length(SusLines) > 0 then
    begin
      // Поля и локальные массивы - разные типы, присвоить целиком нельзя
      SetLength(FFmtSusLine, Length(SusLines));
      SetLength(FFmtSusText, Length(SusTexts));
      FFmtSusFile := FCurrentFileName;
      // Текст уже тот, что будет после форматирования, по числу строк:
      // развёртка CREATE и замена #11 сделаны выше, а форматирование
      // строк не добавляет
      FFmtSusLines := SendMessageA(RichEdit1.Handle, EM_GETLINECOUNT, 0, 0);
      for K := 0 to High(SusLines) do
      begin
        FFmtSusLine[K] := SusLines[K];
        FFmtSusText[K] := SusTexts[K];
        if FCurrentFileName <> '' then
          SusPlace := ReleaseLogPlace(FCurrentFileName, SusLines[K] + 1)
        else
          SusPlace := 'Строка ' + IntToStr(SusLines[K] + 1);
        SusPlace := SusPlace + ' Format text: строка кончается точкой, ' +
        'следующая строка считается её продолжением: ' +
        Trim(SusTexts[K]);
        if CompLogEdit <> nil then
          LogTo(CompLogEdit, SusPlace, clRed)
        else
          LogTo(LogEdit, SusPlace, clRed);
        LogErr(SusPlace);
      end;
      SusNote := Format(' Строк, которые кончаются точкой: %d - отмечены ' +
      'красным, список в Compilation log.', [Length(SusLines)]);
    end;

    if (Changed = 0) and (ExpandCount = 0) and (VtCount = 0) then
    begin
      StatusBar1.SimpleText := 'Format text: отступы уже расставлены.' +
        SusNote;
      StatusBar1.SimplePanel := True;
      if SusNote <> '' then
      begin
        RichEdit1.Invalidate;
        if PaintBox1 <> nil then
          PaintBox1.Invalidate;
      end;
      Exit;
    end;

    // Текст до форматирования - в ту же копию, что и у массовой замены;
    // были развёрнуты блоки CREATE - текст до развёртки
    if OrigText <> '' then
      FReplaceBackup := OrigText
    else
      FReplaceBackup := GetEditorText;
    FReplaceBackupWin := FWindowsIndex;
    SetLength(FReplBackups, 0);

    Res := SL.Text;
    // TStringList.Text дописывает перевод строки в конце - убираем его,
    // если в исходном тексте его не было
    if (Src[Len] <> #13) and (Src[Len] <> #10) and
       (Length(Res) >= 2) and (Copy(Res, Length(Res) - 1, 2) = #13#10) then
      SetLength(Res, Length(Res) - 2);

    FLockHighlight := True;
    try
      SetEditorText(Res);
    finally
      FLockHighlight := False;
    end;

    RichEdit1.Modified := True;

    // Каретка - на ту же строку, в её начало
    K := SendMessageA(RichEdit1.Handle, EM_LINEINDEX, CaretLine, 0);
    if K < 0 then
      K := 0;
    RichEdit1.SelStart := K;
    RichEdit1.SelLength := 0;

    // Текст сменился целиком - карта и списки строятся заново, один раз
    RebuildCommentRangeMap;
    RichEditLinesCount := SendMessageA(RichEdit1.Handle, EM_GETLINECOUNT, 0, 0);
    UpdateVisibleBounds;
    RichEdit1.Invalidate;
    if PaintBox1 <> nil then
      PaintBox1.Invalidate;
    RefreshTabsModified;

    // Текст приведён к настройкам - подсказка в окне настроек больше не нужна
    if (Form2 <> nil) and Form2.IsBuilt then
      Form2.HideIndentHint;

    if ExpandCount > 0 then
      StatusBar1.SimpleText :=
        Format('Format text: развёрнуто блоков CREATE в одну строку %d, ' +
      'строк с новым отступом %d. Откат - Edit, Отменить массовую замену.',
               [ExpandCount, Changed])
    else if VtCount > 0 then
      StatusBar1.SimpleText :=
        Format('Format text: мягких переносов (#11) заменено на перевод ' +
      'строки %d, строк с новым отступом %d. Откат - Edit, Отменить ' +
      'массовую замену.', [VtCount, Changed])
    else
      StatusBar1.SimpleText :=
        Format('Format text: строк изменено %d. Откат - Edit, Отменить массовую замену.',
               [Changed]);
    StatusBar1.SimpleText := StatusBar1.SimpleText + SusNote;
    StatusBar1.SimplePanel := True;
  finally
    SL.Free;
  end;
end;

