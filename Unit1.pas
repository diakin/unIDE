procedure TForm1.mArdMonitorClick(Sender: TObject);
begin
  if FArdPorts <> nil then
  begin
    FArdPorts.Refresh;
    if FArdHw.BoardCount = 0 then
      FArdHw.Scan(ArdCurSettings);
    ArdAutoPort;
  end;
  if FArdPort = '' then
