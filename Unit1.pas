  // Редактор открыт на собственном проекте - его форму можно снять с живого
  // окна, без пробного запуска
  // Ответ запоминается на проект и дату его .prj: без этого каждый вызов
  // читал .prj с диска (ProjectTargetOf), а зовут его и при отрисовке.
function TForm1.IsOwnProject: Boolean;
var
  Dpr: string;
  PrjAge: Integer;
begin
  Result := False;
  if FCurrentProject = '' then
    Exit;
  // Проект - раздел editor.ini: ответ верен, пока файл не менялся
  PrjAge := FileAge(SettingsFileName);
  if (PrjAge <> -1) and (PrjAge = FOwnPrjAge) and
     (FCurrentProject = FOwnPrjName) then
  begin
    Result := FOwnPrjResult;
    Exit;
  end;
  Dpr := ProjectTargetOf(FCurrentProject);
  Result := (Dpr <> '') and
            (CompareText(ChangeFileExt(ExtractFileName(Dpr), ''),
                         OwnExeBase) = 0);
  FOwnPrjName := FCurrentProject;
  FOwnPrjAge := PrjAge;
  FOwnPrjResult := Result;
end;

function TForm1.ProbeSnapFor(const AClass: string): string;
var
  I: Integer;
begin
  Result := '';
  if (FProbeSnaps = nil) or (AClass = '') then
    Exit;
  I := FProbeSnaps.IndexOf(AClass);
  if I >= 0 then
    Result := TProbeText(FProbeSnaps.Objects[I]).Text;
end;

procedure TForm1.ProbeClear;
var
  I: Integer;
begin
  if FProbeSnaps = nil then
    Exit;
  for I := 0 to FProbeSnaps.Count - 1 do
    FProbeSnaps.Objects[I].Free;
  FProbeSnaps.Clear;
end;

// ---------------------------------------------------------------------------
//  Кэш разбора формы: dsgcache\<форма>_<crc пути>.objcache
//
//  Ключ - контрольные суммы и длины текста формы, текста модуля и снимка,
//  плюс дата exe. Совпал - дерево читается из файла, разбора нет. Запись -
//  после полного разбора и после каждой правки из инспектора
//  (ObjCacheSaveCurrent). Формат файла и чтение - в ObjParse
//  (DfmCacheWrite, DfmCacheRead).
// ---------------------------------------------------------------------------

function TForm1.ObjSnapTextFor(const AClass: string): string;
begin
  // Открыта другая форма своего проекта, а снимок - от прежней: он
  // устарел, снимаем эту. У чужого проекта снимки всех форм уже есть
  // после пробного запуска.
  if not FSnapOff and IsOwnProject then
    if OwnSnapFor(AClass) = '' then
    begin
      // Снимок этой формы уже снимали и отложили при переходе на другую -
      // берём его; нет - снимаем
      if not OwnSnapRestore(AClass) then
        TakeOwnSnap(AClass);
      FObjSource.Cursor := crHandPoint;
      if FObjSnapBtn <> nil then
        FObjSnapBtn.Caption := SnapCapHide;
    end
  else if OwnSnapStale(AClass) then
  begin
    // Состав формы другой (построились контролы, добавились пункты) -
    // старый снимок её уже не описывает
    Dbg('17516: снимок ' + AClass + ': состав формы изменился - снят заново' +
        OwnCensusDiff(AClass), clNavy);
    TakeOwnSnap(AClass);
  end;
  // Снимок пробного запуска прошлого сеанса - из dsgcache
  ProbeCacheLoad;
  Result := OwnSnapFor(AClass);
  if Result = '' then
    Result := ProbeSnapFor(AClass);
  // Снимок скрыт кнопкой: он хранится, но поверх .dfm не ложится
  if FSnapOff then
    Result := '';
end;

function TForm1.ObjCacheFileFor(const ADfm: string): string;
begin
  Result := ExtractFilePath(Application.ExeName) + 'dsgcache\' +
            ChangeFileExt(ExtractFileName(ADfm), '') + '_' +
            IntToHex(Crc32Of(AnsiLowerCase(ADfm)), 8) + '.objcache';
end;

function TForm1.ObjCacheKey(const ADfmText, AUnitFile, AUnitSrc,
                            ASnapKey: string): string;
begin
  Result := 'dfm ' + IntToHex(Crc32Of(ADfmText), 8) + ':' +
            IntToStr(Length(ADfmText)) +
  ' | unit ' + AnsiLowerCase(AUnitFile) + ' ' +
  IntToHex(Crc32Of(AUnitSrc), 8) + ':' + IntToStr(Length(AUnitSrc)) +
  ' | snap ' + ASnapKey +
  ' | exe ' + IntToStr(FileAge(Application.ExeName));
end;

procedure TForm1.ObjCacheWrite(const AFile, AKey: string);
begin
  DfmCacheWrite(AFile, AKey, FObjDfmFile, FObjRoots);
end;

// Кэш дерева - на диск через 1,5 с после последней правки в конструкторе,
// а не на каждую (запись - около 50 мс). Кэш нужен при следующем открытии
// формы; промежуточные состояния серии правок на диске не нужны.
procedure TForm1.ObjCacheWriteLater;
begin
  if (FObjRoots = nil) or (FObjRoots.Count = 0) or (FObjTreeKey = '') then
    Exit;
  FObjCacheDueKey := FObjTreeKey;
  FObjCacheDueRoot := FObjRoots[0];
  if FObjCacheTimer = nil then
  begin
    FObjCacheTimer := TTimer.Create(Self);
    FObjCacheTimer.Enabled := False;
    FObjCacheTimer.Interval := 1500;
    FObjCacheTimer.OnTimer := ObjCacheTimerTick;
  end;
  FObjCacheTimer.Enabled := False;
  FObjCacheTimer.Enabled := True;
end;

procedure TForm1.ObjCacheTimerTick(Sender: TObject);
begin
  FObjCacheTimer.Enabled := False;
  // Дерево с заказа перестроили (другой ключ, другие узлы) или правили из
  // инспектора (номера строк под сомнением) - писать нечего: новое дерево
  // своё запишет само
  if (FObjCacheDueKey <> '') and (FObjCacheDueKey = FObjTreeKey) and
     not FObjLinesUnsure and (FObjCacheFile <> '') and
     (FObjRoots <> nil) and (FObjRoots.Count > 0) and
     (FObjRoots[0] = FObjCacheDueRoot) then
    ObjCacheWrite(FObjCacheFile, FObjTreeKey);
  FObjCacheDueKey := '';
end;

// Дерево из файла кэша - в FDfmNodes, корни - в ARoots. False - файла нет,
// ключ другой или файл испорчен; тогда созданное здесь убирается.
function TForm1.ObjCacheRead(const AFile, AKey: string; ARoots: TList): Boolean;
begin
  Result := DfmCacheRead(AFile, AKey, FDfmNodes, ARoots);
end;

// Кэш по узлам в памяти - после правки из инспектора: текст и узлы только
// что приведены в согласие. Номера строк под сомнением - не пишем.
procedure TForm1.ObjCacheSaveCurrent;
var
  DfmText, UnitFile, UnitSrc: string;
begin
  if (FObjCacheFile = '') or FObjLinesUnsure or (FObjDfmFile = '') or
     (FObjRoots = nil) or (FObjRoots.Count = 0) then
    Exit;
  DfmText := DfmToText(UnitTextOf(FObjDfmFile));
  UnitFile := ObjFormUnit;
  UnitSrc := '';
  if UnitFile <> '' then
    UnitSrc := UnitTextOf(UnitFile);
  // Этот же ключ - теперь у дерева в памяти: тексты ему отвечают
  FObjTreeKey := ObjCacheKey(DfmText, UnitFile, UnitSrc, FObjCacheSnapKey);
  ObjCacheWrite(FObjCacheFile, FObjTreeKey);
end;

// ---------------------------------------------------------------------------
//  Снимок пробного запуска между сеансами:
//  dsgcache\probe_<проект>_<crc пути .dpr>.txt - тот же текст, что
//  probe.txt, и строка //DSGPROBE-TIME с временем запуска.
// ---------------------------------------------------------------------------

function TForm1.ProbeCacheFile: string;
var
  Dpr: string;
begin
  Result := '';
  if FCurrentProject = '' then
    Exit;
  Dpr := ProjectTargetOf(FCurrentProject);
  if Dpr = '' then
    Exit;
  Result := ExtractFilePath(Application.ExeName) + 'dsgcache\probe_' +
            ChangeFileExt(ExtractFileName(Dpr), '') + '_' +
            IntToHex(Crc32Of(AnsiLowerCase(Dpr)), 8) + '.txt';
end;

procedure TForm1.ProbeCacheSave;
var
  F, S: string;
  I: Integer;
begin
  F := ProbeCacheFile;
  if (F = '') or (FProbeSnaps = nil) or (FProbeSnaps.Count = 0) then
    Exit;
  S := '//DSGPROBE-TIME ' + IntToStr(DateTimeToFileDate(FProbeTime)) + #13#10;
  for I := 0 to FProbeSnaps.Count - 1 do
    S := S + '//DSGPROBE ' + FProbeSnaps[I] + #13#10 +
         TProbeText(FProbeSnaps.Objects[I]).Text;
  try
    ForceDirectories(ExtractFilePath(F));
    with TFileStream.Create(F, fmCreate) do
    try
      if S <> '' then
        WriteBuffer(S[1], Length(S));
    finally
      Free;
    end;
    FProbeCacheTried := F;
  except
    // не записался - после перезапуска понадобится новый пробный запуск
  end;
end;

// Снимков пробного запуска в памяти нет - взять сохранённые для проекта.
// Для каждого файла - один раз за сеанс.
procedure TForm1.ProbeCacheLoad;
var
  F: string;
  SL: TStringList;
  I, T: Integer;
  PT: TProbeText;
begin
  if (FProbeSnaps <> nil) and (FProbeSnaps.Count > 0) then
    Exit;
  F := ProbeCacheFile;
  if (F = '') or (CompareText(F, FProbeCacheTried) = 0) then
    Exit;
  FProbeCacheTried := F;
  if not FileExists(F) then
    Exit;
  if FProbeSnaps = nil then
    FProbeSnaps := TStringList.Create;
  SL := TStringList.Create;
  try
    SL.LoadFromFile(F);
    PT := nil;
    for I := 0 to SL.Count - 1 do
      if Copy(SL[I], 1, 16) = '//DSGPROBE-TIME ' then
      begin
        T := StrToIntDef(Trim(Copy(SL[I], 17, MaxInt)), 0);
        if T > 0 then
        try
          FProbeTime := FileDateToDateTime(T);
        except
        end;
      end
    else if Copy(SL[I], 1, 11) = '//DSGPROBE ' then
    begin
      PT := TProbeText.Create;
      FProbeSnaps.AddObject(Trim(Copy(SL[I], 12, MaxInt)), PT);
    end
    else if PT <> nil then
      PT.Text := PT.Text + SL[I] + #13#10;
  finally
    SL.Free;
  end;
  if FProbeSnaps.Count > 0 then
  begin
    Inc(FObjSnapGen);
    if not FSnapOff then
    begin
      FObjSource.Cursor := crHandPoint;
      if FObjSnapBtn <> nil then
        FObjSnapBtn.Caption := SnapCapHide;
    end;
  end;
end;

// Копия .dpr с зондом: _dsgprobe.dpr рядом с настоящим. '' - не вышло.
function TForm1.MakeProbeDpr(const ADpr: string): string;
var
  SL: TStringList;
  I, Uses_, LastCreate: Integer;
  T, TL, Cfg: string;
begin
  Result := '';
  SL := TStringList.Create;
  try
    SL.LoadFromFile(ADpr);
    Uses_ := -1;
    LastCreate := -1;
    for I := 0 to SL.Count - 1 do
    begin
      T := Trim(SL[I]);
      TL := LowerCase(T);
      if Copy(TL, 1, 8) = 'program ' then
        SL[I] := 'program _dsgprobe;'
      else if (Uses_ < 0) and ((TL = 'uses') or (Copy(TL, 1, 5) = 'uses ')) then
        Uses_ := I
      else if Pos('application.createform(', TL) > 0 then
        LastCreate := I
      else if (Pos('{$r *.res}', TL) > 0) then
        // ресурс проекта называется по настоящему .dpr, не по копии
        SL[I] := StringReplace(SL[I], '*.res',
                               ChangeFileExt(ExtractFileName(ADpr), '.res'),
                               [rfIgnoreCase]);
    end;
    if (Uses_ < 0) or (LastCreate < 0) then
    begin
      LogComp('Пробный запуск: в ' + ExtractFileName(ADpr) + ' не найдены ' +
      'uses или Application.CreateForm');
              Exit;
    end;

    // Выход сразу после создания форм, Application.Run не выполняется
    SL.Insert(LastCreate + 1, '  DsgProbeDump;');
    // Зонд - первым в uses
    if Trim(LowerCase(SL[Uses_])) = 'uses' then
      SL.Insert(Uses_ + 1, '  DsgProbe,')
    else
      SL[Uses_] := StringReplace(SL[Uses_], 'uses ', 'uses DsgProbe, ',
                                 [rfIgnoreCase]);

    Result := ExtractFilePath(ADpr) + '_dsgprobe.dpr';
    SL.SaveToFile(Result);

    // Настройки проекта для dcc32 (-D, -$ и прочее) - и копии
    Cfg := ChangeFileExt(ADpr, '.cfg');
    if FileExists(Cfg) then
      CopyFile(PChar(Cfg), PChar(ChangeFileExt(Result, '.cfg')), False);
  finally
    SL.Free;
  end;
end;

procedure TForm1.ProbeRun;
var
  Src, Exe, OutF, Cur, Cls: string;
  Ok: Boolean;
  SI: TStartupInfo;
  PI: TProcessInformation;
  W, Code: DWORD;
  SL, Log: TStringList;
  I: Integer;
  PT: TProbeText;
  T0: TDateTime;
  Tk: Cardinal;
  Done: Boolean;

  // Шаг пробного запуска: в лог компиляции и в dsgprobe\probe.log
  procedure Step(const S: string);
  begin
    LogComp('Пробный запуск: ' + S);
    Log.Add(FormatDateTime('hh:nn:ss.zzz', Now) + '  ' + S);
  end;

  function FileInfo(const AFile: string): string;
  var
    F: TSearchRec;
  begin
    if FindFirst(AFile, faAnyFile, F) = 0 then
    begin
      Result := IntToStr(F.Size) + ' байт, ' +
                FormatDateTime('dd.mm.yyyy hh:nn:ss', FileDateToDateTime(F.Time));
      FindClose(F);
    end
    else
      Result := 'нет файла';
  end;

begin
  if FBusyDepth > 0 then
    Exit;   // уже идёт сборка или пробный запуск
  Log := TStringList.Create;
  BusyBegin('Снимок: сборка копии проекта');
  Done := False;
  // Папка пробного запуска - рядом с редактором, не во временной: после
  // запуска в ней можно посмотреть, что произошло (probe.log, копия .dpr,
  // снимок probe.txt, собранный exe)
  FProbeDir := ExtractFilePath(Application.ExeName) + 'dsgprobe\';
  try
    Step('начало, проект ' + FCurrentProject + ', форма ' + FObjFormClass);
    ForceDirectories(FProbeDir);
    Step('папка ' + FProbeDir);

    // Зонду нужен исходник FormSnapshot.pas. Он вшит в редактор ресурсом
    // (formsnapshot_src.rc): рядом с exe его класть не нужно, и в релизе
    // его нет
    Src := FProbeDir + 'FormSnapshot.pas';
    if not SaveSnapshotSource(Src) then
    begin
      Step('FormSnapshot.pas из ресурса не записан: ' + Src);
      ShowMessage('18362:Для пробного запуска нужен исходник FormSnapshot.pas, ' +
      'он вшит в редактор ресурсом FORMSNAPSHOT_PAS. В этой ' +
      'сборке его нет или записать его не удалось:'#13#10 + Src);
                  Exit;
    end;
    Step('FormSnapshot.pas записан из ресурса');
    SL := TStringList.Create;
    try
      SL.Text := ProbeUnitText;
      SL.SaveToFile(FProbeDir + 'DsgProbe.pas');
    finally
      SL.Free;
    end;
    Step('DsgProbe.pas записан');

    // Сборка копии
    Exe := FProbeDir + '_dsgprobe.exe';
    DeleteFile(Exe);      // чтобы не взять старый exe, если сборка сорвётся
    Screen.Cursor := crHourGlass;
    FProbeActive := True;
    FProbeDprFile := '';
    T0 := Now;
    try
      Ok := CompileDelphi;
    finally
      FProbeActive := False;
      Screen.Cursor := crDefault;
      if FProbeDprFile <> '' then
      begin
        // Копию .dpr - в папку зонда, для разбора; из папки проекта - прочь
        CopyFile(PChar(FProbeDprFile), PChar(FProbeDir + '_dsgprobe.dpr'), False);
        DeleteFile(FProbeDprFile);
        DeleteFile(ChangeFileExt(FProbeDprFile, '.cfg'));
      end;
    end;
    if FProbeDprFile = '' then
    begin
      Step('копия .dpr не создана - сборка не начиналась (см. сообщения ' +
      'выше: не Delphi-проект, нет .dpr, отказ сохранить файл)');
           Exit;
    end;
    Step('копия .dpr: ' + FProbeDir + '_dsgprobe.dpr');
    if not Ok then
    begin
      Step('копия проекта не собралась - ошибки в Error log');
      Exit;
    end;
    Step('собран: ' + Exe + ' (' + FileInfo(Exe) + ')');
    if not FileExists(Exe) then
    begin
      Step('exe после сборки не найден - проверьте ключ -E в строке dcc32 ' +
      'выше');
           Exit;
    end;

    // Запуск до конца создания форм
    OutF := FProbeDir + 'probe.txt';
    DeleteFile(OutF);
    Cur := ExtractFilePath(FProbeDprFile);
    SetEnvironmentVariable('DSGPROBE_OUT', PChar(OutF));
    FillChar(SI, SizeOf(SI), 0);
    SI.cb := SizeOf(SI);
    Step('запуск, текущая папка ' + Cur);
    if not CreateProcess(nil, PChar('"' + Exe + '"'), nil, nil, False, 0, nil,
                         PChar(Cur), SI, PI) then
    begin
      SetEnvironmentVariable('DSGPROBE_OUT', nil);
      Step('не запустился, код ' + IntToStr(GetLastError));
      Exit;
    end;
    SetEnvironmentVariable('DSGPROBE_OUT', nil);
    Screen.Cursor := crHourGlass;
    BusyStage('Снимок: запуск программы');
    try
      // Ждём по 100 мс, чтобы окно и индикатор жили; всего - 15 с
      Tk := GetTickCount;
      repeat
        W := WaitForSingleObject(PI.hProcess, 100);
        BusyTick;
        Application.ProcessMessages;
      until (W <> WAIT_TIMEOUT) or (GetTickCount - Tk >= 15000);
      if W = WAIT_TIMEOUT then
      begin
        TerminateProcess(PI.hProcess, 1);
        Step('за 15 с программа не дошла до конца создания форм и ' +
        'остановлена. Долгое в OnCreate оберните в {$IFNDEF DSGPROBE} ' +
        '... {$ENDIF}');
      end
      else
      begin
        Code := 0;
        GetExitCodeProcess(PI.hProcess, Code);
        Step('программа завершилась за ' +
             FormatFloat('0.0', (Now - T0) * 86400) + ' с от начала сборки, ' +
        'код выхода ' + IntToStr(Code) +
        ' (0 - дошла до снимка, иное - упала раньше)');
      end;
    finally
      CloseHandle(PI.hThread);
      CloseHandle(PI.hProcess);
      Screen.Cursor := crDefault;
    end;

    Step('снимок: ' + OutF + ' (' + FileInfo(OutF) + ')');
    if not FileExists(OutF) then
      Exit;
    BusyStage('Снимок: разбор');

    // Снимки по формам: строки //DSGPROBE <класс> разделяют их
    if FProbeSnaps = nil then
      FProbeSnaps := TStringList.Create;
    ProbeClear;
    SL := TStringList.Create;
    try
      SL.LoadFromFile(OutF);
      PT := nil;
      for I := 0 to SL.Count - 1 do
        if Copy(SL[I], 1, 11) = '//DSGPROBE ' then
        begin
          Cls := Trim(Copy(SL[I], 12, MaxInt));
          PT := TProbeText.Create;
          FProbeSnaps.AddObject(Cls, PT);
        end
      else if Copy(SL[I], 1, 16) = '//DSGPROBE-ERROR' then
        Step(SL[I])
      else if PT <> nil then
        PT.Text := PT.Text + SL[I] + #13#10;
    finally
      SL.Free;
    end;
    FProbeTime := Now;
    ProbeCacheSave;   // после перезапуска редактора снимок вернётся сам
    for I := 0 to FProbeSnaps.Count - 1 do
      Step('форма ' + FProbeSnaps[I] + ': ' +
           IntToStr(Length(TProbeText(FProbeSnaps.Objects[I]).Text)) + ' знаков');
    if FProbeSnaps.IndexOf(FObjFormClass) < 0 then
      Step('снимка формы ' + FObjFormClass + ' среди них нет - она не ' +
      'создаётся в .dpr (Application.CreateForm)');

           Inc(FObjSnapGen);   // ключ разбора сменился - дерево соберётся заново
           FRightPages.ActivePage := FTabObjects;
           RefreshObjectInspector(True);
           if FObjSnapBtn <> nil then
           FObjSnapBtn.Caption := SnapCapHide;
           Step('готово');
           Done := True;
  finally
    try
      Log.SaveToFile(FProbeDir + 'probe.log');
    except
    end;
    Log.Free;
    if Done then
      BusyEnd('Снимок: готово', True)
    else
      BusyEnd('Снимок не получен - см. Compilation log', False);
  end;
end;

// Окна всем оконным контролам формы, в порядке создания: так поле уже
// есть, когда TUpDown к нему привязывается. Форма не показывается.
procedure ProbeCreateHandles(AForm: TCustomForm);
var
  I: Integer;
begin
  try
    AForm.HandleNeeded;
  except
  end;
  for I := 0 to AForm.ComponentCount - 1 do
    if AForm.Components[I] is TWinControl then
    try
      TWinControl(AForm.Components[I]).HandleNeeded;
    except
      // контрол без родителя окна не получит - пропускаем
    end;
end;

type
  // Снимок своей формы, отложенный при переходе на другую (FOwnSnapStash)
  TOwnSnapEntry = class
    SnapText: string;
    SnapPrint: string;
    SnapTime: TDateTime;
  end;

  // Указатель строк модуля, отложенный при переходе на другой
  // (FObjSetStash)
  TObjSetterEntry = class
  public
    SetLines: TStringList;
    SetAlias: TStringList;
    constructor Create;
    destructor Destroy; override;
  end;

constructor TObjSetterEntry.Create;
begin
  inherited Create;
  SetLines := TStringList.Create;
  SetLines.Sorted := True;
  SetLines.Duplicates := dupIgnore;
  SetAlias := TStringList.Create;
end;

destructor TObjSetterEntry.Destroy;
begin
  SetLines.Free;
  SetAlias.Free;
  inherited Destroy;
end;

const
  // Сколько отложенных списков и указателей держать: форм в проекте
  // обычно единицы
  ObjStashMax = 8;

  // Нынешний снимок - в отложенные, под классом его формы
procedure TForm1.OwnSnapStashCurrent;
var
  ClassNm: string;
  StashIdx: Integer;
  Entry: TOwnSnapEntry;
begin
  if FObjSnapText = '' then
    Exit;
  ClassNm := DfmRootClass(FObjSnapText);
  if ClassNm = '' then
    Exit;
  if FOwnSnapStash = nil then
    FOwnSnapStash := TStringList.Create;
  StashIdx := FOwnSnapStash.IndexOf(ClassNm);
  if StashIdx >= 0 then
    Entry := TOwnSnapEntry(FOwnSnapStash.Objects[StashIdx])
  else
  begin
    Entry := TOwnSnapEntry.Create;
    FOwnSnapStash.AddObject(ClassNm, Entry);
  end;
  Entry.SnapText := FObjSnapText;
  Entry.SnapPrint := FObjSnapPrint;
  Entry.SnapTime := FObjSnapTime;
end;

// Отложенный снимок формы AClass - снова нынешний, если состав живой формы
// с тех пор тот же (OwnFormPrint). Нынешний при этом откладывается.
function TForm1.OwnSnapRestore(const AClass: string): Boolean;
var
  StashIdx: Integer;
  Entry: TOwnSnapEntry;
  LiveForm: TCustomForm;
begin
  Result := False;
  if (FOwnSnapStash = nil) or (AClass = '') then
    Exit;
  StashIdx := FOwnSnapStash.IndexOf(AClass);
  if StashIdx < 0 then
    Exit;
  Entry := TOwnSnapEntry(FOwnSnapStash.Objects[StashIdx]);
  LiveForm := OwnLiveForm(AClass);
  if (LiveForm = nil) or (OwnFormPrint(LiveForm) <> Entry.SnapPrint) then
  begin
    // Состав другой - отложенный снимок уже не годится
    Entry.Free;
    FOwnSnapStash.Delete(StashIdx);
    Exit;
  end;
  OwnSnapStashCurrent;
  // Отложенный мог сдвинуться: OwnSnapStashCurrent добавляет в конец
  StashIdx := FOwnSnapStash.IndexOf(AClass);
  Entry := TOwnSnapEntry(FOwnSnapStash.Objects[StashIdx]);
  FObjSnapText := Entry.SnapText;
  FObjSnapPrint := Entry.SnapPrint;
  FObjSnapTime := Entry.SnapTime;
  Entry.Free;
  FOwnSnapStash.Delete(StashIdx);
  Result := True;
end;

procedure TForm1.OwnSnapStashClear;
var
  StashIdx: Integer;
begin
  if FOwnSnapStash = nil then
    Exit;
  for StashIdx := 0 to FOwnSnapStash.Count - 1 do
    FOwnSnapStash.Objects[StashIdx].Free;
  FOwnSnapStash.Clear;
end;

// Свой снимок (с живого окна редактора), если он той же формы, что AClass
// Класс корня снимка считается один раз на строку снимка: DfmRootClass
// делит весь текст на строки, а снимок - сотни килобайт. Ссылка на строку
// хранится (FOwnSnapClassText), поэтому её адрес не достанется другой.
function TForm1.OwnSnapFor(const AClass: string): string;
begin
  Result := '';
  if (FObjSnapText = '') or (AClass = '') then
    Exit;
  if Pointer(FObjSnapText) <> Pointer(FOwnSnapClassText) then
  begin
    FOwnSnapClassText := FObjSnapText;
    FOwnSnapClassName := DfmRootClass(FObjSnapText);
  end;
  if CompareText(FOwnSnapClassName, AClass) = 0 then
    Result := FObjSnapText;
end;

// Снимок своей формы класса AClass - в FObjSnapText, без перестройки
// инспектора (её делает тот, кто вызвал). Снимается форма того класса,
// что открыта: Unit2.dfm - окно настроек (Form2), а не главное окно. Она
// создана при запуске, даже если окно сейчас не открыто.
procedure TForm1.TakeOwnSnap(const AClass: string);
var
  F: TCustomForm;
  OldCursor: TCursor;
begin
  F := OwnLiveForm(AClass);
  // Окно настроек заполняется данными при первом открытии (InitOptions):
  // строки путей Arduino, страница Compilers, таблицы. Не открывалось -
  // снимок показал бы пустые элементы из .dfm. Заполняем, как перед
  // показом, но окно не открываем. Уже заполненное не трогаем: в открытом
  // окне могут быть несохранённые правки.
  if (F <> nil) and (F = Form2) and not Form2.IsBuilt then
    PrepareOptionsForm;
  // Формы этого класса в работающем редакторе нет (не создаётся при
  // запуске) - снимать нечего; чужую форму не снимаем
  if F = nil then
    Exit;
  // Снимок другой формы не теряется - откладывается (OwnSnapRestore)
  if (FObjSnapText <> '') and
     (CompareText(DfmRootClass(FObjSnapText), AClass) <> 0) then
    OwnSnapStashCurrent;
  // Во второй половине переключения вкладки часы не ставим: ход там виден
  // панелью в строке состояния (WMTabSwitched), а курсор мигал бы на
  // каждом переключении
  // Прежний курсор возвращается, а не сбрасывается в обычный: снимок
  // бывает частью долгой работы (смена темы, ApplyTheme), у которой свои
  // часы, - сброс посреди неё давал мигание курсора
  OldCursor := Screen.Cursor;
  if not FTabWork then
    Screen.Cursor := crHourGlass;
  try
    // Часть раскладки делает сама Windows, когда у контролов появляются
    // окна: TUpDown с Associate встаёт вплотную к своему полю только
    // тогда. У формы, которую ещё ни разу не показывали, окон нет, и
    // снимок показал бы UpDown в углу. Поэтому окна создаются заранее -
    // форма при этом не показывается.
    ProbeCreateHandles(F);
    FObjSnapText := FormSnapshotText(F);
    FObjSnapPrint := OwnFormPrint(F);
    if FOwnSnapCensus = nil then
      FOwnSnapCensus := TStringList.Create;
    OwnFormCensus(F, FOwnSnapCensus);
  finally
    if not FTabWork then
      Screen.Cursor := OldCursor;
  end;
  FObjSnapTime := Now;
end;

// Живая форма класса AClass в работающем редакторе; nil - такой нет
function TForm1.OwnLiveForm(const AClass: string): TCustomForm;
var
  I: Integer;
begin
  Result := nil;
  for I := 0 to Screen.FormCount - 1 do
    if CompareText(Screen.Forms[I].ClassName, AClass) = 0 then
    begin
      Result := Screen.Forms[I];
      Exit;
    end;
end;

// Отпечаток состава формы: сколько у неё компонентов и сколько контролов во
// всём дереве Parent. Значения свойств в него не входят - они меняются
// постоянно, а из-за них снимок пришлось бы снимать и разбирать форму
// заново на каждом переходе. Меняется отпечаток, когда меняется состав:
// окно настроек построило свои контролы при первом открытии (InitOptions),
// в меню Reopen стало больше пунктов.
function TForm1.OwnFormPrint(F: TCustomForm): string;

  function CountCtl(W: TWinControl): Integer;
  var
    I: Integer;
  begin
    Result := W.ControlCount;
    for I := 0 to W.ControlCount - 1 do
      if W.Controls[I] is TWinControl then
        Inc(Result, CountCtl(TWinControl(W.Controls[I])));
  end;

var
  CompIdx, CompCnt: Integer;
begin
  Result := '';
  if F = nil then
    Exit;
  // Таймеры не считаются: редактор заводит свои по ходу работы (отложенная
  // запись, подсказки, второй вид конструктора), и каждый такой таймер
  // заставлял снимать форму заново - с пересверкой живого вида и столбца
  // «Строка кода» (полсекунды на первый Cut)
  CompCnt := 0;
  for CompIdx := 0 to F.ComponentCount - 1 do
    if not (F.Components[CompIdx] is TTimer) then
      Inc(CompCnt);
  Result := IntToStr(CompCnt) + '/' + IntToStr(CountCtl(F));
end;

// Состав живой формы для сверки (что появилось или пропало с прошлого
// снимка): компоненты формы - "класс имя", контролы чужих владельцев в
// дереве Parent - "ctl класс имя @родитель". Сортированный, с повторами.
procedure TForm1.OwnFormCensus(F: TCustomForm; AList: TStringList);

  procedure WalkControls(AParent: TWinControl);
  var
    CtlIdx: Integer;
    Ctl: TControl;
  begin
    for CtlIdx := 0 to AParent.ControlCount - 1 do
    begin
      Ctl := AParent.Controls[CtlIdx];
      if Ctl.Owner <> F then
        AList.Add('ctl ' + Ctl.ClassName + ' ' + Ctl.Name + ' @' +
                  AParent.Name);
      if Ctl is TWinControl then
        WalkControls(TWinControl(Ctl));
    end;
  end;

var
  CompIdx: Integer;
begin
  AList.Clear;
  AList.Sorted := True;
  AList.Duplicates := dupAccept;
  if F = nil then
    Exit;
  for CompIdx := 0 to F.ComponentCount - 1 do
    if not (F.Components[CompIdx] is TTimer) then   // как в OwnFormPrint
      AList.Add(F.Components[CompIdx].ClassName + ' ' +
                F.Components[CompIdx].Name);
  WalkControls(F);
end;

// Что в составе живой формы AClass появилось (+) и пропало (-) с прошлого
// снимка - для строки 17516. Первые несколько, остальное - числом.
function TForm1.OwnCensusDiff(const AClass: string): string;
const
  CensusShowMax = 8;
var
  NowList: TStringList;
  OldIdx, NowIdx, Shown, Hidden, Cmp: Integer;

  procedure Note(const ASign, AItem: string);
  begin
    if Shown < CensusShowMax then
    begin
      Result := Result + '; ' + ASign + AItem;
      Inc(Shown);
    end
    else
      Inc(Hidden);
  end;

begin
  Result := '';
  if FOwnSnapCensus = nil then
    Exit;
  NowList := TStringList.Create;
  try
    OwnFormCensus(OwnLiveForm(AClass), NowList);
    Shown := 0;
    Hidden := 0;
    // Оба списка сортированы и с повторами (безымянные одного класса):
    // слияние, чтобы лишний второй "TMenuItem " тоже был виден
    OldIdx := 0;
    NowIdx := 0;
    while (OldIdx < FOwnSnapCensus.Count) or (NowIdx < NowList.Count) do
    begin
      if OldIdx >= FOwnSnapCensus.Count then
        Cmp := 1
      else if NowIdx >= NowList.Count then
        Cmp := -1
      else
        Cmp := AnsiCompareText(FOwnSnapCensus[OldIdx], NowList[NowIdx]);
      if Cmp = 0 then
      begin
        Inc(OldIdx);
        Inc(NowIdx);
      end
      else if Cmp < 0 then
      begin
        Note('-', FOwnSnapCensus[OldIdx]);
        Inc(OldIdx);
      end
      else
      begin
        Note('+', NowList[NowIdx]);
        Inc(NowIdx);
      end;
    end;
    if Hidden > 0 then
      Result := Result + '; ещё ' + IntToStr(Hidden);
    Result := Result + ' (было ' + IntToStr(FOwnSnapCensus.Count) +
    ', стало ' + IntToStr(NowList.Count) + ')';
  finally
    NowList.Free;
  end;
end;

// Свой снимок формы AClass есть, но состав живой формы с тех пор другой
function TForm1.OwnSnapStale(const AClass: string): Boolean;
var
  F: TCustomForm;
begin
  Result := False;
  if OwnSnapFor(AClass) = '' then
    Exit;
  F := OwnLiveForm(AClass);
  Result := (F <> nil) and (OwnFormPrint(F) <> FObjSnapPrint);
end;

procedure TForm1.SnapshotOwnFormClick(Sender: TObject);
begin
  if FObjTree = nil then
    Exit;
  TakeOwnSnap(FObjFormClass);
  Inc(FObjSnapGen);   // ключ разбора сменился - дерево соберётся заново

  // Программная смена вкладки OnChange не поднимает - собираем сами
  FRightPages.ActivePage := FTabObjects;
  RefreshObjectInspector(True);
  FObjSource.Cursor := crHandPoint;
  if FObjSnapBtn <> nil then
    FObjSnapBtn.Caption := SnapCapHide;
end;

// Щелчок по подписи внизу инспектора - убрать снимок, остаётся .dfm
// Сброс снимков при смене проекта: свой снимок редактора и снимки
// пробного запуска относятся к прежнему проекту. Кнопка - снова
// SnapCapShow.
procedure TForm1.SnapReset;
begin
  FProbeTried := False;   // новый проект - пробный запуск снова сам
  FSnapOff := False;
  if (FObjSnapText <> '') or ((FProbeSnaps <> nil) and (FProbeSnaps.Count > 0)) then
    ObjSourceClick(nil);
  if FObjSnapBtn <> nil then
    FObjSnapBtn.Caption := SnapCapShow;
end;

procedure TForm1.ObjSourceClick(Sender: TObject);
var
  F: string;
begin
  // Файл RapidQ: снимок убирается совсем
  if FObjRapidQ then
  begin
    if RapidQHasSnapshot then
    begin
      RapidQProbeClear;
      RefreshObjectInspector(True);
    end;
    Exit;
  end;
  if (FObjSnapText = '') and ((FProbeSnaps = nil) or (FProbeSnaps.Count = 0)) then
    Exit;
  ProbeClear;
  // Снимки убраны совсем - и сохранённый для следующего сеанса
  F := ProbeCacheFile;
  if F <> '' then
    DeleteFile(F);
  FProbeCacheTried := F;
  FObjSnapText := '';
  OwnSnapStashClear;
  Inc(FObjSnapGen);
  FObjSource.Cursor := crDefault;
  RefreshObjectInspector(True);
  if FObjSnapBtn <> nil then
    FObjSnapBtn.Caption := SnapCapShow;
end;

// Кнопка над деревом: снимка нет - сделать, есть - убрать.
// Форма самого редактора снимается с живого окна. Форма чужого проекта -
// пробным запуском: сборка копии проекта, запуск до конца создания форм,
// значения - в файл.
//
// Hide снимок только скрывает: снимки пробного запуска остаются в памяти,
// и Show показывает их снова без новой сборки и запуска. Новый пробный
// запуск - Ctrl+щелчок по Show, или когда снимка этой формы нет. Совсем
// убрать снимки - щелчок по подписи внизу инспектора (ObjSourceClick).
procedure TForm1.ObjSnapBtnClick(Sender: TObject);
var
  Has: Boolean;
begin
  // Файл RapidQ - свой снимок (RapidQProbeRun). Снимок есть и показан -
  // скрыть; есть и скрыт - показать (Ctrl+щелчок - снять заново); нет -
  // снять.
  if FObjRapidQ then
  begin
    // Текст менялся после снимка - снять заново, а не показывать прежний
    if RapidQSnapStale then
    begin
      FRqSnapOff := False;
      RapidQProbeRun;
      Exit;
    end;
    if RapidQHasSnapshot and not FRqSnapOff then
      FRqSnapOff := True
    else if RapidQHasSnapshot and (GetKeyState(VK_CONTROL) >= 0) then
      FRqSnapOff := False
    else
    begin
      FRqSnapOff := False;
      RapidQProbeRun;
      Exit;
    end;
    RefreshObjectInspector(True);
    Exit;
  end;
  Has := (OwnSnapFor(FObjFormClass) <> '') or
         (ProbeSnapFor(FObjFormClass) <> '');

  if Has and not FSnapOff then
  begin
    // Hide: убрать с дерева и из конструктора, снимки не трогать
    FSnapOff := True;      // убрали руками - при переходах сам не вернётся
    Inc(FObjSnapGen);      // ключ разбора сменился - дерево соберётся заново
    FObjSource.Cursor := crDefault;
    RefreshObjectInspector(True);
    if FObjSnapBtn <> nil then
      FObjSnapBtn.Caption := SnapCapShow;
    Exit;
  end;

  FSnapOff := False;
  if IsOwnProject then
    // Своя форма снимается с живого окна - быстро, значения свежие
    SnapshotOwnFormClick(Sender)
  else if Has and (GetKeyState(VK_CONTROL) >= 0) then
  begin
    // Снимок пробного запуска уже есть - показать его
    Inc(FObjSnapGen);
    FRightPages.ActivePage := FTabObjects;
    RefreshObjectInspector(True);
    FObjSource.Cursor := crHandPoint;
    if FObjSnapBtn <> nil then
      FObjSnapBtn.Caption := SnapCapHide;
  end
  else
    ProbeRun;
end;

// ---------------------------------------------------------------------------
//  Правка значений в инспекторе
//
//  Двойной щелчок, Enter или F2 по свойству - поверх значения появляется
//  поле ввода. Enter записывает, Esc отменяет, уход из поля - тоже запись.
//  Меняется ровно одна строка .dfm: "Имя = значение".
//
//  Куда пишется - туда, где сейчас живёт текст формы:
//    .dfm - активная вкладка     -> строка в редакторе, обычной правкой;
//    .dfm открыт в другой вкладке -> текст той вкладки, она помечается;
//    .dfm нигде не открыт         -> файл на диске.
//  Иначе открытая вкладка и файл разошлись бы, и следующее сохранение
//  затёрло бы одно другим.
//
//  Правка закрыта: у снимка и ссылок (файла у них нет), у многострочных
//  значений, у двоичного .dfm и у событий - имя обработчика без правки
//  кода менять бессмысленно.
// ---------------------------------------------------------------------------


// Окно, в котором открыт файл. -1 - нигде.
function TForm1.WindowOfFile(const AFile: string): Integer;
var
  I: Integer;
begin
  Result := -1;
  if AFile = '' then
    Exit;
  for I := 0 to WindowsItemCount - 1 do
    if FWindows[I].Used and (CompareText(FWindows[I].FileName, AFile) = 0) then
    begin
      Result := I;
      Exit;
    end;
end;

// ---------------------------------------------------------------------------
//  RTTI классов VCL для инспектора: полный список свойств, умолчания,
//  типы для редакторов и проверки значений
//
//  Работает только для классов, которые есть в самом редакторе: RTTI -
//  свойство скомпилированного кода. Для сторонних компонентов (TComPort,
//  TRichView) класса нет - там остаётся то, что записано в .dfm, и ввод
//  текстом без проверки.
// ---------------------------------------------------------------------------

// Регистрация классов палитры, которые конструктор и инспектор
// создают настоящими. Список - в DsgClasses.pas.
procedure TForm1.RegisterVclClasses;
begin
  RegisterDesignClasses;
end;

// Класс по имени из .dfm. Корень формы (TForm0, TForm1) - класс проекта,
// которого в редакторе нет: для него берём TForm, свойства у них общие.
function TForm1.RttiClassFor(ANode: TObject): TClass;
var
  N: TDfmNode;
begin
  Result := nil;
  // Классы RapidQ (QForm, QRichEdit) - не классы VCL
  if FObjRapidQ then
    Exit;
  N := TDfmNode(ANode);
  if (N = nil) or (N.ClassNm = '') then
    Exit;
  Result := GetClass(N.ClassNm);
  if (Result = nil) and (N.Parent = nil) then
    Result := TForm;
end;

// Тип свойства по пути "Font.Style": спуск по вложенным объектам. nil -
// такого свойства у класса нет. AWritable - у свойства есть запись: только
// такие можно добавить в .dfm.
function TForm1.PropTypeFor(AClass: TClass; const APath: string;
                            var AWritable: Boolean): Pointer;
var
  Rest, Part: string;
  P: Integer;
  PI: PPropInfo;
  C: TClass;
begin
  Result := nil;
  AWritable := False;
  C := AClass;
  Rest := APath;
  while (C <> nil) and (Rest <> '') do
  begin
    P := Pos('.', Rest);
    if P > 0 then
    begin
      Part := Copy(Rest, 1, P - 1);
      Rest := Copy(Rest, P + 1, MaxInt);
    end
    else
    begin
      Part := Rest;
      Rest := '';
    end;

    PI := GetPropInfo(C, Part);
    if PI = nil then
      Exit;
    if Rest = '' then
    begin
      Result := PI^.PropType^;
      AWritable := PI^.SetProc <> nil;
      Exit;
    end;
    // Середина пути - только вложенный объект (Font, Constraints)
    if PI^.PropType^^.Kind <> tkClass then
      Exit;
    C := GetTypeData(PI^.PropType^)^.ClassType;
  end;
end;

// Значения по умолчанию класса: строки "Имя=значение", как их записал бы
// .dfm. Пустой экземпляр записывается FormSnapshot - так получаются
// настоящие умолчания (clBtnFace у панели), а не нули из RTTI. Разбор
// один раз на класс.
function TForm1.DefaultsFor(AClass: TClass): TStringList;
var
  I, P: Integer;
  Inst: TComponent;
  Txt, L, Nm, V: string;
  SL: TStringList;
begin
  I := FRttiDefaults.IndexOf(AClass.ClassName);
  if I >= 0 then
  begin
    Result := TStringList(FRttiDefaults.Objects[I]);
    Exit;
  end;

  Result := TStringList.Create;
  FRttiDefaults.AddObject(AClass.ClassName, Result);
  if not AClass.InheritsFrom(TComponent) then
    Exit;

  SL := TStringList.Create;
  try
    try
      Inst := TComponentClass(AClass).Create(nil);
      try
        Txt := FormSnapshotText(Inst);
      finally
        Inst.Free;
      end;
    except
      Txt := ''; // класс без родителя не создаётся - умолчаний не будет
    end;

    SL.Text := Txt;
    for I := 0 to SL.Count - 1 do
    begin
      L := SL[I];
      // Свойства самого объекта - ровно два пробела отступа; четыре и больше -
      // продолжение многострочного значения
      if (Length(L) < 3) or (Copy(L, 1, 2) <> '  ') or (L[3] = ' ') then
        Continue;
      P := Pos(' = ', L);
      if P <= 0 then
        Continue;
      Nm := Trim(Copy(L, 1, P - 1));
      V := Copy(L, P + 3, MaxInt);
      if (V = '') or (V = '(') then
        Continue;
      Result.Add(Nm + '=' + V);
    end;
  finally
    SL.Free;
  end;
end;

// Пункт списка цветов инспектора: вернуть свойству цвет темы. Так же
// подписано в таблице свойство, чей цвет перекрашивает тема
// (ObjMarkSchemeItem).
const
  ObjThemeItem = 'Theme color';

  // Какой цвет поставить свойству AProp компонента класса AClass, чтобы его
  // перекрашивала тема IDE. Тема (UiPaintControl) меняет только системные
  // цвета - clBtnFace, clWindow, clWindowText - и цвета своих ролей. Любой
  // другой цвет, заданный в .dfm или кодом (clAqua, clYellow), она считает
  // выбранным намеренно и оставляет. Поэтому «вернуть цвет темы» - значит
  // поставить системный цвет той роли, по которой тема красит этот класс:
  //   Color      - clWindow у полей, списков, деревьев, таблиц и логов,
  //                clBtnFace у панелей, рамок, листов, меток, флажков, форм;
  //   Font.Color - clWindowText (у логов текст тема не трогает);
  //   FixedColor - clBtnFace (шапка таблицы).
  // '' - этот класс или это свойство тема не красит.
function TForm1.ObjThemeColorFor(AClass: TClass; const AProp: string): string;
var
  IsEditLike, IsWindowLike: Boolean;
begin
  Result := '';
  if AClass = nil then
    Exit;
  IsEditLike := AClass.InheritsFrom(TCustomEdit) or
                AClass.InheritsFrom(TCustomComboBox) or
                AClass.InheritsFrom(TCustomListBox) or
                AClass.InheritsFrom(TCustomTreeView) or
                AClass.InheritsFrom(TCustomListView) or
                AClass.InheritsFrom(TCustomGrid);
  IsWindowLike := AClass.InheritsFrom(TCustomForm) or
                  AClass.InheritsFrom(TCustomPanel) or
                  AClass.InheritsFrom(TCustomGroupBox) or
                  AClass.InheritsFrom(TTabSheet) or
                  AClass.InheritsFrom(TScrollingWinControl) or
                  AClass.InheritsFrom(TSplitter) or
                  AClass.InheritsFrom(TCustomLabel) or
                  AClass.InheritsFrom(TCustomCheckBox) or
                  AClass.InheritsFrom(TRadioButton);
  if CompareText(AProp, 'Color') = 0 then
  begin
    if IsEditLike then
      Result := 'clWindow'
    else if IsWindowLike then
      Result := 'clBtnFace';
  end
  else if CompareText(AProp, 'Font.Color') = 0 then
  begin
    if (IsEditLike or IsWindowLike) and
       not AClass.InheritsFrom(TCustomRichEdit) then
      Result := 'clWindowText';
  end
  else if CompareText(AProp, 'FixedColor') = 0 then
  begin
    if AClass.InheritsFrom(TCustomGrid) then
      Result := 'clBtnFace';
  end;
end;

// Сборщик имён для GetColorValues / GetCursorValues
procedure TForm1.ObjAddValue(const S: string);
begin
  if FObjCombo <> nil then
    FObjCombo.Items.Add(S);
end;

// Подходит ли значение типу свойства. Тип неизвестен - подходит всё: для
// сторонних компонентов проверить нечем.
function TForm1.ValidatePropValue(ATypeInfo: Pointer; const ARaw: string;
                                  var AMsg: string): Boolean;
var
  TI, CT: PTypeInfo;
  TD: PTypeData;
  S, El, Allowed: string;
  P, V, Code: Integer;
  F: Extended;

  function EnumNames(T: PTypeInfo): string;
  var
    K: Integer;
    D: PTypeData;
  begin
    Result := '';
    D := GetTypeData(T);
    for K := D^.MinValue to D^.MaxValue do
    begin
      if Result <> '' then
        Result := Result + ', ';
      Result := Result + GetEnumName(T, K);
    end;
  end;

begin
  Result := True;
  AMsg := '';
  TI := PTypeInfo(ATypeInfo);
  if TI = nil then
    Exit;

  case TI^.Kind of
    tkEnumeration:
      if GetEnumValue(TI, ARaw) < 0 then
    begin
      Result := False;
      AMsg := 'Допустимо: ' + EnumNames(TI);
    end;

    tkSet:
    begin
      CT := GetTypeData(TI)^.CompType^;
      S := Trim(ARaw);
      if (Length(S) < 2) or (S[1] <> '[') or (S[Length(S)] <> ']') then
      begin
        Result := False;
        AMsg := 'Набор пишется в квадратных скобках: [a, b]. ' +
        'Допустимо: ' + EnumNames(CT);
Exit;
      end;
      S := Copy(S, 2, Length(S) - 2);
      while S <> '' do
      begin
        P := Pos(',', S);
        if P > 0 then
        begin
          El := Trim(Copy(S, 1, P - 1));
          S := Copy(S, P + 1, MaxInt);
        end
        else
        begin
          El := Trim(S);
          S := '';
        end;
        if (El <> '') and (GetEnumValue(CT, El) < 0) then
        begin
          Result := False;
          AMsg := 'Нет такого элемента: ' + El + '. Допустимо: ' +
                  EnumNames(CT);
          Exit;
        end;
      end;
    end;

    tkInteger:
    begin
      if (TI^.Name = 'TColor') and IdentToColor(ARaw, V) then
        Exit;
      if (TI^.Name = 'TCursor') and IdentToCursor(ARaw, V) then
        Exit;
      if (TI^.Name = 'TFontCharset') and IdentToCharset(ARaw, V) then
        Exit;
      Val(ARaw, V, Code);
      if Code <> 0 then
      begin
        Result := False;
        if TI^.Name = 'TColor' then
          AMsg := 'Нужно имя цвета (clRed) или число ($00RRGGBB)'
        else if TI^.Name = 'TCursor' then
          AMsg := 'Нужно имя курсора (crDefault) или число'
        else
        begin
          TD := GetTypeData(TI);
          AMsg := Format('Нужно целое число от %d до %d',
                         [TD^.MinValue, TD^.MaxValue]);
        end;
      end;
    end;

    tkInt64:
    begin
      Val(ARaw, F, Code);   // без дробной части проверит Val по Int64 ниже
      if (Code <> 0) or (Pos('.', ARaw) > 0) then
      begin
        Result := False;
        AMsg := 'Нужно целое число';
      end;
    end;

    tkFloat:
    begin
      // В .dfm дробная часть всегда через точку, Val её и ждёт
      Val(ARaw, F, Code);
      if Code <> 0 then
      begin
        Result := False;
        AMsg := 'Нужно число, дробная часть через точку: 1.5';
      end;
    end;
  end;

  if not Result then
  begin
    Allowed := AMsg;
    AMsg := 'Значение "' + ARaw + '" не подходит свойству типа ' +
            string(TI^.Name) + '.'#13#10#13#10 + Allowed;
  end;
end;

// Свойство, значение которого при работе задаёт код (ObjCodeProps), -
// цветом ObjProps.CodeText: правка в .dfm при запуске будет перекрыта.
// Свойство, которого нет в .dfm (Data < 0), - приглушённым цветом: видно,
// что значение по умолчанию, а не записанное. Оба цвета - свои строки в
// цветах IDE (ObjProps.DfmText, ObjProps.DefaultText): на тёмном фоне
// системные clWindowText и clGray не читаются.
// Цвет текста строки таблицы свойств. Что значение задаёт код, видно по
// колонке «Строка кода»: ObjPropsCodeColumn заполняет её ровно у таких
// свойств (номер строки или '?'). Раньше здесь звался ObjIsCodeProp, а
// он на каждой ячейке читал .prj (IsOwnProject), искал живую форму и
// разбирал заголовок снимка - перерисовка таблицы шла 120-430 мс.
function TForm1.ObjPropsItemColor(Item: TListItem): TColor;
begin
  if (Item.SubItems.Count >= 2) and (Item.SubItems[1] <> '') then
    Result := UiColor('ObjProps.CodeText')
  else if Integer(Item.Data) < 0 then
    Result := UiColor('ObjProps.DefaultText')
  else
    Result := UiColor('ObjProps.DfmText');
end;

procedure TForm1.ObjPropsDrawItem(Sender: TCustomListView; Item: TListItem;
                                  State: TCustomDrawState;
                                  var DefaultDraw: Boolean);
begin
  // Значение задаёт код - своим цветом (ObjProps.CodeText)
  Sender.Canvas.Font.Color := ObjPropsItemColor(Item);
end;

procedure TForm1.ObjPropsDrawSubItem(Sender: TCustomListView; Item: TListItem;
                                     SubItem: Integer; State: TCustomDrawState;
                                     var DefaultDraw: Boolean);
begin
  Sender.Canvas.Font.Color := ObjPropsItemColor(Item);
end;

// Ячейка значения из двух половин: у строки таблицы свойств RapidQ с
// SubItems[3] (Parent - хэндл родителя из снимка) слева текст ячейки, как
// его нарисовала таблица, справа, за чертой, - SubItems[3]. Рисуется после
// строки (TUiGridMark, стадия "после"); фон правой половины - цвет точки
// у правого края ячейки, каким его уже залила таблица (и у выделенной
// строки).
procedure TForm1.ObjPropsPostPaint(ALV: TCustomListView; ADC: HDC;
                                   AItem: Integer);
const
  LVM_GETSUBITEMRECT = $1000 + 56;
  LVIR_BOUNDS = 0;
var
  Item: TListItem;
  CellRect, HalfRect, TextRect: TRect;
  HalfLeft: Integer;
  BackColor: COLORREF;
  CellBrush: HBRUSH;
  LinePen, OldPen: HPEN;
  OldFont: HFONT;
  ExtraText: string;
begin
  if (ALV <> FObjProps) or (AItem < 0) or
     (AItem >= FObjProps.Items.Count) then
    Exit;
  Item := FObjProps.Items[AItem];
  if (Item.SubItems.Count < 4) or (Item.SubItems[3] = '') then
    Exit;
  ExtraText := Item.SubItems[3];
  FillChar(CellRect, SizeOf(CellRect), 0);
  CellRect.Top := 1;               // колонка значения
  CellRect.Left := LVIR_BOUNDS;
  if SendMessage(FObjProps.Handle, LVM_GETSUBITEMRECT, AItem,
                 Integer(@CellRect)) = 0 then
    Exit;
  HalfLeft := (CellRect.Left + CellRect.Right) div 2;
  if CellRect.Right - HalfLeft < 24 then
    Exit;
  // Без линий сетки снизу и справа - их уже нарисовали
  HalfRect := Rect(HalfLeft, CellRect.Top, CellRect.Right - 1,
                   CellRect.Bottom - 1);
  BackColor := GetPixel(ADC, CellRect.Right - 3, CellRect.Top + 2);
  if BackColor = CLR_INVALID then
    BackColor := ColorToRGB(FObjProps.Color);
  CellBrush := CreateSolidBrush(BackColor);
  try
    FillRect(ADC, HalfRect, CellBrush);
  finally
    DeleteObject(CellBrush);
  end;
  LinePen := CreatePen(PS_SOLID, 1, ColorToRGB(UiColor('Grid.Lines')));
  OldPen := SelectObject(ADC, LinePen);
  try
    MoveToEx(ADC, HalfLeft, CellRect.Top, nil);
    Windows.LineTo(ADC, HalfLeft, CellRect.Bottom - 1);
  finally
    SelectObject(ADC, OldPen);
    DeleteObject(LinePen);
  end;
  TextRect := HalfRect;
  TextRect.Left := HalfLeft + 4;
  OldFont := SelectObject(ADC, FObjProps.Font.Handle);
  try
    SetBkMode(ADC, TRANSPARENT);
    SetTextColor(ADC, ColorToRGB(UiColor('ObjProps.DefaultText')));
    DrawText(ADC, PChar(ExtraText), Length(ExtraText), TextRect,
             DT_LEFT or DT_VCENTER or DT_SINGLELINE or DT_END_ELLIPSIS or
             DT_NOPREFIX);
  finally
    SelectObject(ADC, OldFont);
  end;
end;

// Data строки Parent, которой нет среди свойств узла (ObjParentRow):
// отрицательное, но не номер в FObjMissing - правка такой строки не
// начинается
const
  ObjParentRowData = -$7FFFFFF0;

procedure TForm1.ObjBeginEdit;
const
  LVM_GETSUBITEMRECT = $1000 + 56;
  LVIR_BOUNDS = 0;
var
  It: TListItem;
  Idx, K, H: Integer;
  Raw, Why, S, El: string;
  R: TRect;
  Cls: TClass;
  TI, CT: PTypeInfo;
  TD: PTypeData;
  W: Boolean;
  N: TDfmNode;
begin
  It := FObjProps.Selected;
  if (It = nil) or (FObjCurNode = nil) then
    Exit;
  N := TDfmNode(FObjCurNode);
  Idx := Integer(It.Data);

  // Строка Parent (ObjParentRow) не правится - переход к родителю
  if not FObjRapidQ and (Idx = ObjParentRowData) then
  begin
    ObjGotoParent;
    Exit;
  end;

  // Объект RapidQ - своя правка: значение в блоке CREATE
  if FObjRapidQ then
  begin
    RapidQBeginEdit(It);
    Exit;
  end;

  // Компонент создан в коде - свойство правится в .pas: та же таблица и те
  // же редакторы, а запись идёт строкой присваивания
  FObjEditCode := N.FromCode;
  FObjEditLine := -1;
  if FObjEditCode then
  begin
    if RttiClassFor(N) = nil then
    begin
      // Класс редактору неизвестен - выбирать значение не из чего,
      // остаётся переход к строке
      if (Idx >= 0) and (Idx < N.PropN.Count) and
         (Integer(N.PropN.Objects[Idx]) >= 0) then
        JumpToUnitLine(Integer(N.PropN.Objects[Idx]))
      else
        ShowMessage('18532:Класс ' + N.ClassNm + ' редактору неизвестен - ' +
        'значение можно поправить только в коде.');
                    Exit;
    end;
    if N.CreateLine < 0 then
    begin
      ShowMessage('18538:Строка создания этого компонента в коде не найдена - ' +
      'непонятно, куда писать свойство.');
                  Exit;
    end;
  end;

  // Элемент массива компонентов - правка в editor.ini и сразу на живой
  // компонент (ObjApplyArrayEdit). editor.ini читает только сам редактор,
  // поэтому так правятся элементы только его собственных форм.
  FObjEditArray := not FObjEditCode and N.IsSnap and
                   ObjArrayOf(N.Name, FObjEditArrName, FObjEditArrIdx);
  if FObjEditArray and not IsOwnProject then
  begin
    ShowMessage('18634:' + FObjEditArrName + '[' + IntToStr(FObjEditArrIdx) +
    '] - элемент массива компонентов. Такие поправки пишутся в ' +
    'editor.ini, а его читает только сам редактор. У другого ' +
    'проекта значение правится в его коде.');
                Exit;
  end;
  // Свойство, которым управляет код, не правится: переход к строке, где
  // код его задаёт
  if FObjEditArray then
  begin
    S := '';
    if Idx >= 0 then
    begin
      if Idx < N.PropN.Count then
        S := N.PropN[Idx];
    end
    else if (FObjMissing <> nil) and (-Idx - 1 < FObjMissing.Count) then
      S := FObjMissing.Names[-Idx - 1];
    if ObjArrayCodeProp(FObjEditArrName, FObjEditArrIdx, S, K) then
    begin
      if K >= 0 then
        JumpToUnitLine(K)
      else
        ShowMessage('18657:' + S + ' у ' + FObjEditArrName + '[' +
                    IntToStr(FObjEditArrIdx) + '] задаёт код - в ' +
        'инспекторе не правится.');
                    Exit;
    end;
  end;

  Why := '';
  if FObjEditArray then
    Why := ''   // файл формы не нужен - запись в editor.ini
  else if (N.Name = '') and (N.Parent <> nil) and not FObjEditCode then
    Why := 'У объекта в .dfm нет имени. Пока имя не проставлено, найти его ' +
    'в тексте нельзя - правка ушла бы в чужой объект.'
  else if N.IsSnap or N.IsLink then
    Why := 'Это компонент из снимка живой формы - файла у него нет.'
  else if not FObjEditCode then
  begin
    if FObjDfmFile = '' then
      Why := 'Форма не взята из файла.'
    else if FObjDfmBinary then
      Why := 'Файл формы двоичный. Сохраните форму в Delphi как текст ' +
      '(правый щелчок по форме - Text DFM) и повторите.'
    else if (Idx >= 0) and (Idx < N.PropRaw.Count) and
            (N.PropRaw.Objects[Idx] <> nil) then
      Why := 'Значение занимает несколько строк .dfm - одной строкой его ' +
      'не заменить. Правьте его в тексте .dfm.';
  end;
  if Why <> '' then
  begin
    ShowMessage('18564:Это свойство здесь не правится.'#13#10#13#10 + Why);
    Exit;
  end;

  // Свойство есть в .dfm - правим его строку. Нет (серое, из RTTI) -
  // значение по умолчанию, и при записи строка добавится.
  if Idx >= 0 then
  begin
    if Idx >= N.PropN.Count then
      Exit;
    FObjEditInsert := False;
    FObjEditName := N.PropN[Idx];
    Raw := N.PropRaw[Idx];
    if FObjEditCode then
      FObjEditLine := Integer(N.PropN.Objects[Idx]); // -1 - только в снимке
  end
  else
  begin
    K := -Idx - 1;
    if (FObjMissing = nil) or (K >= FObjMissing.Count) then
      Exit;
    FObjEditInsert := True;
    FObjEditName := FObjMissing.Names[K];
    Raw := Copy(FObjMissing[K], Length(FObjEditName) + 2, MaxInt);
  end;
  FObjEditIdx := Idx;
  FObjEditOld := Raw;
  FObjEditGroup := not FObjEditCode and (FDesigner <> nil) and
                   (FDesigner.GroupCount > 1) and
                   (CompareText(FObjDfmFile, FDsgDfm) = 0);

  // Значение задаёт код - сказать об этом, но править дать: в .dfm оно
  // запишется, а при работе код поставит своё
  if not FObjEditCode and not FObjEditArray and
     ObjIsCodeProp(N, FObjEditName) then
  begin
    S := ObjCodeSetterOf(N.Name, FObjEditName);
    if S = '' then
      S := 'значение при работе отличается от записанного в .dfm, но ' +
      'строку, где код его ставит, в модуле формы не нашёл';
ShowMessage('18729:' + FObjEditName + ' у ' + N.Name + ' задаёт код: ' + S +
      '.'#13#10#13#10'Значение запишется в .dfm, но при работе ' +
      'программы код поставит своё.');
  end;

  // Тип свойства - для выбора редактора и проверки. Неизвестный класс -
  // тип nil: простой ввод текстом.
  TI := nil;
  Cls := RttiClassFor(N);
  if Cls <> nil then
    TI := PTypeInfo(PropTypeFor(Cls, FObjEditName, W));
  FObjEditType := TI;

  R.Top := 1;               // колонка значения
  R.Left := LVIR_BOUNDS;
  SendMessage(FObjProps.Handle, LVM_GETSUBITEMRECT, It.Index, Integer(@R));

  FObjEditIsStr := False;
  FObjThemeColor := '';
  FObjActive := nil;

  if (TI <> nil) and (TI^.Kind = tkEnumeration) then
  begin
    // Перечисление и Boolean - только значения из списка
    FObjComboColors := False;
    FObjCombo.Style := csDropDownList;
    FObjCombo.Items.Clear;
    TD := GetTypeData(TI);
    for K := TD^.MinValue to TD^.MaxValue do
      FObjCombo.Items.Add(GetEnumName(TI, K));
    FObjCombo.ItemIndex := FObjCombo.Items.IndexOf(Raw);
    FObjActive := FObjCombo;
  end
  else if (TI <> nil) and (TI^.Kind = tkInteger) and
          ((TI^.Name = 'TColor') or (TI^.Name = 'TCursor')) then
  begin
    // Цвет и курсор - имена из списка или число руками
    FObjComboColors := TI^.Name = 'TColor';
    FObjColorRq := False;
    FObjCombo.Style := csDropDown;
    FObjCombo.Items.Clear;
    if TI^.Name = 'TColor' then
    begin
      // Первым - как вернуть цвет, который перекрашивает тема IDE
      FObjThemeColor := ObjThemeColorFor(Cls, FObjEditName);
      if FObjThemeColor <> '' then
        FObjCombo.Items.Add(ObjThemeItem);
      GetColorValues(ObjAddValue);
    end
    else
      GetCursorValues(ObjAddValue);
    FObjCombo.Text := Raw;
    FObjActive := FObjCombo;
  end
  else if (TI <> nil) and (TI^.Kind = tkSet) then
  begin
    // Набор - галки по элементам
    FObjSetList.Items.Clear;
    CT := GetTypeData(TI)^.CompType^;
    TD := GetTypeData(CT);
    for K := TD^.MinValue to TD^.MaxValue do
      FObjSetList.Items.Add(GetEnumName(CT, K));
    S := Trim(Raw);
    if (S <> '') and (S[1] = '[') then
      Delete(S, 1, 1);
    if (S <> '') and (S[Length(S)] = ']') then
      Delete(S, Length(S), 1);
    while S <> '' do
    begin
      K := Pos(',', S);
      if K > 0 then
      begin
        El := Trim(Copy(S, 1, K - 1));
        S := Copy(S, K + 1, MaxInt);
      end
      else
      begin
        El := Trim(S);
        S := '';
      end;
      K := FObjSetList.Items.IndexOf(El);
      if K >= 0 then
        FObjSetList.Checked[K] := True;
    end;
    FObjActive := FObjSetList;
  end
  else
  begin
    // Строку правим в читаемом виде, без кавычек и #кодов - при записи
    // она закодируется обратно
    FObjEditIsStr := ((TI <> nil) and
                      (TI^.Kind in [tkString, tkLString, tkWString])) or
                     ((TI = nil) and (Raw <> '') and (Raw[1] in ['''', '#']));
    if FObjEditIsStr then
      FObjEdit.Text := DecodeDfmString(Raw)
    else
      FObjEdit.Text := Raw;
    FObjActive := FObjEdit;
  end;

  if FObjActive = FObjSetList then
  begin
    // Список галок - под ячейкой, на нужное число строк, но не выше сетки
    H := FObjSetList.ItemHeight * FObjSetList.Items.Count + 6;
    if H > 200 then
      H := 200;
    FObjSetList.SetBounds(R.Left, R.Top, R.Right - R.Left, H);
  end
  else
    FObjActive.SetBounds(R.Left, R.Top, R.Right - R.Left,
                         R.Bottom - R.Top + 2);

  FObjActive.Visible := True;
  FObjActive.SetFocus;
  if FObjActive = FObjEdit then
    FObjEdit.SelectAll;
  FObjEditing := True;
end;

procedure TForm1.ObjCancelEdit;
begin
  if not FObjEditing then
    Exit;
  FObjEditing := False;
  if FObjEdit <> nil then
    FObjEdit.Visible := False;
  if FObjCombo <> nil then
    FObjCombo.Visible := False;
  if FObjSetList <> nil then
    FObjSetList.Visible := False;
end;

// Запись значения. Существующее свойство - замена его строки .dfm; серое,
// которого в .dfm нет, - новая строка сразу под заголовком object: порядок
// строк Delphi не важен, а место под заголовком всегда однострочное.
//
// Перед записью значение проверяется по типу. Не подходит - сообщение, и
// поле остаётся открытым: набранное не пропадает.
//
// Строка .dfm сверяется перед записью: если с момента разбора файл
// поменялся и на этом месте уже не то, ничего не пишем - иначе испортили
// бы чужую строку.
// Свойство компонента, созданного в коде: значение пишется в .pas.
//
// Есть строка присваивания (FObjEditLine) - меняется её правая часть, до
// точки с запятой; комментарий в конце строки остаётся. Строки нет (серое
// свойство или значение пришло из снимка живой формы) - строка добавляется
// после последнего присваивания этой переменной, а если их нет - сразу
// после строки создания.
//
// Значение берётся тем же текстом, что показывает инспектор: у чисел,
// True/False, элементов перечислений, наборов в скобках, строк в апострофах
// и цветов запись в .dfm и в Паскале совпадает.
procedure TForm1.ObjApplyCodeEdit(AObj: TObject; const AName, AValue: string);

// Сколько пробелов и табуляций в начале строки
  function LeadSpacesOf(const S: string): Integer;
  begin
    Result := 0;
    while (Result < Length(S)) and (S[Result + 1] in [' ', #9]) do
      Inc(Result);
  end;

var
  N: TDfmNode;
  Pas, Txt, T, Pre, Tail, Ind, VarNm: string;
  SL: TStringList;
  I, Ins, P, Q, L, CL: Integer;
  InsLine: Integer;       // номер вставленной строки, -1 - строка заменена
  Relined: Boolean;       // сохранённый номер не подошёл, строка найдена заново

  // Строка начинается с "APre :=" (пробелы вокруг любые)
  function IsAssign(const S, APre: string): Boolean;
  var
    U: string;
  begin
    U := UpperCase(TrimLeft(S));
    Result := (Copy(U, 1, Length(APre)) = UpperCase(APre)) and
              (Copy(TrimLeft(Copy(U, Length(APre) + 1, MaxInt)), 1, 2) = ':=');
  end;

// Ближайшая к AHint строка, которая удовлетворяет условию: присваивание
// APre или (ACreate) создание переменной. -1 - такой нет.
  function Nearest(const APre: string; ACreate: Boolean; AHint: Integer): Integer;
  var
    J, Best: Integer;
  begin
    Result := -1;
    Best := MaxInt;
    for J := 0 to SL.Count - 1 do
      if IsAssign(SL[J], APre) and
         (not ACreate or (Pos('.CREATE', UpperCase(SL[J])) > 0)) and
         (Abs(J - AHint) < Best) then
      begin
        Best := Abs(J - AHint);
        Result := J;
      end;
  end;

begin
  N := TDfmNode(AObj);
  InsLine := -1;
  Relined := False;
  // Компонент из кода адресуется переменной: имя в .dfm у него обычно пустое
  VarNm := N.Name;
  if VarNm = '' then
    VarNm := N.VarName;
  if VarNm = '' then
  begin
    ShowMessage('18786:У этого компонента нет ни имени, ни переменной - ' +
    'записать свойство в код не получится.');
                Exit;
  end;
  Pas := ObjFormUnit;
  if Pas = '' then
  begin
    ShowMessage('18793:Модуль формы ' + FObjFormClass + ' не найден.');
    Exit;
  end;
  Txt := DsgFileText(Pas);
  if Txt = '' then
  begin
    ShowMessage('18799:Текст модуля ' + ExtractFileName(Pas) + ' прочитать не ' +
    'удалось.');
                Exit;
  end;

  SL := TStringList.Create;
  try
    SL.Text := Txt;
    Pre := VarNm + '.' + AName;

    if FObjEditLine >= 0 then
    begin
      // Правим готовую строку: "  FTabs.HotTrack := False;  // что-то".
      // Номер не подошёл - ближайшее к нему присваивание того же свойства.
      L := FObjEditLine;
      if (L >= SL.Count) or not IsAssign(SL[L], Pre) then
      begin
        L := Nearest(Pre, False, FObjEditLine);
        if L < 0 then
        begin
          ShowMessage('18819:Текст модуля изменился после разбора. Обновите ' +
          'инспектор.');
                      ObjScheduleRefresh(N, AName);
                      Exit;
        end;
        Relined := True;
        if (FObjEditIdx >= 0) and (FObjEditIdx < N.PropN.Count) then
          N.PropN.Objects[FObjEditIdx] := TObject(L);
      end;
      T := SL[L];
      P := Pos(':=', T);
      Q := P + 2;
      while (Q <= Length(T)) and (T[Q] <> ';') do
        Inc(Q);
      if Q > Length(T) then
        Tail := ''
      else
        Tail := Copy(T, Q + 1, MaxInt);
      SL[L] := Copy(T, 1, P + 1) + ' ' + AValue + ';' + Tail;
    end
    else
    begin
      // Такой строки нет - добавляем после последнего присваивания этой
      // переменной, но не выходя за пределы своей процедуры
      if N.CreateLine < 0 then
        Exit;
      // Строка создания не на месте - ближайшая к ней "Переменная :=
      // ...Create", а нет такой - любое присваивание переменной (компонент
      // мог прийти из помощника: Btn := MakeBtn(...))
      CL := N.CreateLine;
      if (CL >= SL.Count) or not IsAssign(SL[CL], VarNm) then
      begin
        CL := Nearest(VarNm, True, N.CreateLine);
        if CL < 0 then
          CL := Nearest(VarNm, False, N.CreateLine);
        if CL < 0 then
        begin
          ShowMessage('18856:Строка создания ' + VarNm + ' в модуле не найдена. ' +
          'Обновите инспектор.');
                      ObjScheduleRefresh(N, AName);
                      Exit;
        end;
        N.CreateLine := CL;
        Relined := True;
      end;
      Ins := CL;
      for I := CL + 1 to SL.Count - 1 do
      begin
        T := Trim(SL[I]);
        if (LeadSpacesOf(SL[I]) = 0) and
           ((CompareText(Copy(T, 1, 10), 'procedure ') = 0) or
            (CompareText(Copy(T, 1, 9), 'function ') = 0) or
            (CompareText(T, 'end;') = 0)) then
          Break;
        if (CompareText(Copy(T, 1, Length(VarNm) + 1), VarNm + '.') = 0) and
           (Pos(':=', T) > 0) then
          Ins := I;
      end;
      Ind := Copy(SL[Ins], 1, LeadSpacesOf(SL[Ins]));
      SL.Insert(Ins + 1, Ind + Pre + ' := ' + AValue + ';');
      InsLine := Ins + 1;
    end;

    DsgSetFileText(Pas, SL.Text);
  finally
    SL.Free;
  end;

  if Relined then
    FObjLinesUnsure := True;

  // Как и для .dfm - на месте, без разбора модуля
  if CompareText(AName, 'Name') = 0 then
    ObjScheduleRefresh(N, AName)
  else
  begin
    ObjPointUpdate(N, AName, AValue, InsLine, True);
    // Номера остальных узлов - разбором, форма конструктора остаётся
    if Relined then
      ObjScheduleRelines(N, AName);
  end;
end;

// Выключить перерисовку редактора на время правки из инспектора или
// конструктора и запомнить каретку с прокруткой
procedure TForm1.EditorFreeze;
begin
  Inc(FEdFreeze);
  if FEdFreeze <> 1 then
    Exit;
  FEdFreezeSel := RichEdit1.SelStart;
  FEdFreezeTop := SendMessageA(RichEdit1.Handle, EM_GETFIRSTVISIBLELINE, 0, 0);
  SendMessageA(RichEdit1.Handle, WM_SETREDRAW, 0, 0);
end;

// Вернуть перерисовку, каретку и прокрутку
procedure TForm1.EditorThaw;
var
  Top: Integer;
begin
  if FEdFreeze = 0 then
    Exit;
  Dec(FEdFreeze);
  if FEdFreeze > 0 then
    Exit;

  if FEdFreezeSel > RichEdit1.GetTextLen then
    FEdFreezeSel := RichEdit1.GetTextLen;
  RichEdit1.SelStart := FEdFreezeSel;
  RichEdit1.SelLength := 0;
  Top := SendMessageA(RichEdit1.Handle, EM_GETFIRSTVISIBLELINE, 0, 0);
  if Top <> FEdFreezeTop then
    SendMessageA(RichEdit1.Handle, EM_LINESCROLL, 0, FEdFreezeTop - Top);

  SendMessageA(RichEdit1.Handle, WM_SETREDRAW, 1, 0);
  RedrawWindow(RichEdit1.Handle, nil, 0,
               RDW_ERASE or RDW_FRAME or RDW_INVALIDATE or RDW_ALLCHILDREN);
  UpdateLineNumbers;
end;

procedure TForm1.ObjApplyEdit;
var
  Obj: TDfmNode;
  PName, NewRaw, NewLine, Cur, Dfm, Txt, Msg, S: string;
  Line, WinIdx, LS, LL, P, K: Integer;
  SL: TStringList;
  EndsWithBreak: Boolean;
  InsLine: Integer;       // номер вставленной строки, -1 - строка заменена
  Relined: Boolean;       // сохранённый номер не подошёл, строка найдена заново

  // Строка - то самое свойство с тем самым значением?
  function MatchesProp(const AText: string): Boolean;
  var
    T: string;
  begin
    T := Trim(AText);
    Result := (CompareText(Copy(T, 1, Length(PName) + 3), PName + ' = ') = 0) and
              (Copy(T, Length(PName) + 4, MaxInt) = FObjEditOld);
  end;

// Строка - заголовок нужного объекта?
  function MatchesHeader(const AText: string): Boolean;
  var
    T, U: string;
  begin
    T := Trim(AText);
    U := UpperCase(T);
    Result := (Copy(U, 1, 7) = 'OBJECT ') or (Copy(U, 1, 10) = 'INHERITED ') or
              (Copy(U, 1, 7) = 'INLINE ');
    if Result and (Obj.Name <> '') then
      Result := Pos(UpperCase(Obj.Name) + ':', U) > 0;
  end;

  function IndentOf(const AText: string): string;
  var
    J: Integer;
  begin
    J := 1;
    while (J <= Length(AText)) and (AText[J] in [' ', #9]) do
      Inc(J);
    Result := Copy(AText, 1, J - 1);
  end;

  procedure Changed;
  begin
    ShowMessage('18984:Текст формы изменился после разбора. Обновите инспектор.');
    ObjScheduleRefresh(Obj, PName);
  end;

begin
  if not FObjEditing or (FObjActive = nil) then
    Exit;

  // Объект RapidQ - запись в его блок CREATE
  if FObjRapidQ then
  begin
    RapidQApplyEdit;
    Exit;
  end;

  // --- новое значение из того редактора, что открыт
  if FObjActive = FObjSetList then
  begin
    S := '';
    for K := 0 to FObjSetList.Items.Count - 1 do
      if FObjSetList.Checked[K] then
      begin
        if S <> '' then
          S := S + ', ';
        S := S + FObjSetList.Items[K];
      end;
    NewRaw := '[' + S + ']';
  end
  else if FObjActive = FObjCombo then
  begin
    NewRaw := Trim(FObjCombo.Text);
    // «(цвет темы)» - системный цвет, который перекрашивает тема
    if (FObjThemeColor <> '') and (NewRaw = ObjThemeItem) then
      NewRaw := FObjThemeColor;
  end
  else if FObjEditIsStr then
    NewRaw := EncodeDfmString(FObjEdit.Text)
  else
    NewRaw := Trim(FObjEdit.Text);

  // Не изменилось - просто закрываем. Серое свойство без правки в .dfm не
  // добавляем: там было бы то же значение по умолчанию.
  // У группы сравнивать не с чем: FObjEditOld - значение одного текущего
  // компонента. Width = 32 у группы, где 32 только у текущего, должно
  // дойти до остальных; кому менять нечего, ObjGroupApply не тронет.
  if ((NewRaw = FObjEditOld) and not FObjEditGroup) or (NewRaw = '') then
  begin
    ObjCancelEdit;
    Exit;
  end;

  // Горячая клавиша: в .dfm она числом, а вводят её как Ctrl+S
  if (FObjEditType <> nil) and
     (PTypeInfo(FObjEditType)^.Name = 'TShortCut') then
  begin
    Val(NewRaw, K, P);
    if (P <> 0) and (TextToShortCut(NewRaw) <> 0) then
      NewRaw := IntToStr(TextToShortCut(NewRaw));
  end;

  // --- проверка по типу: не подходит - поле остаётся открытым
  if not ValidatePropValue(FObjEditType, NewRaw, Msg) then
  begin
    FObjEditing := False;   // сообщение уведёт фокус - уход не должен писать
    ShowMessage('19033:' + Msg);
    FObjEditing := True;
    if FObjActive.CanFocus then
      FObjActive.SetFocus;
    Exit;
  end;

  FObjEditing := False;   // до всего остального: уход фокуса снова вызовет нас
  FObjActive.Visible := False;

  if FObjCurNode = nil then
    Exit;
  Obj := TDfmNode(FObjCurNode);
  PName := FObjEditName;
  Relined := False;
  // Текст .dfm до правки: по нему спрятанный второй вид конструктора
  // получит ту же правку (ObjPointUpdate -> DsgOtherSyncProp)
  if FDsgOther <> nil then
    FDsgEditOldText := DsgGetText
  else
    FDsgEditOldText := '';

  // Выделена группа - значение всем её компонентам
  if not FObjEditCode and not FObjEditArray and
     ObjGroupApply(PName, NewRaw) then
    Exit;
  // Выделена группа из компонентов кода (кнопки палитры) - элементам
  // массивов, в editor.ini
  if FObjEditArray and ObjGroupApplyArray(PName, NewRaw) then
    Exit;

  // Своя запись в текст - не правка руками: номера строк узлов поправит
  // ObjPointUpdate, а не сдвиг по редактору (ObjLinesPost)
  Inc(FObjOwnWrite);
  try

    // Элемент массива компонентов - в editor.ini и на живой компонент
    if FObjEditArray then
    begin
      ObjApplyArrayEdit(Obj, PName, NewRaw);
      Exit;
    end;

    // Компонент из кода - пишем в .pas, а не в .dfm
    if FObjEditCode then
    begin
      ObjApplyCodeEdit(Obj, PName, NewRaw);
      Exit;
    end;

    if FObjEditInsert then
    begin
      Line := Obj.Line;                    // заголовок object
      InsLine := Line + 1;                 // новая строка - сразу под ним
    end
    else
    begin
      if (FObjEditIdx < 0) or (FObjEditIdx >= Obj.PropN.Count) then
        Exit;
      Line := Integer(Obj.PropN.Objects[FObjEditIdx]);
      InsLine := -1;
    end;

    Dfm := FObjDfmFile;
    WinIdx := WindowOfFile(Dfm);

    if (WinIdx >= 0) and (WinIdx = FWindowsIndex) then
    begin
      // --- .dfm в активной вкладке: обычная правка текста редактора
      EditorFreeze;
      try
        LS := SendMessageA(RichEdit1.Handle, EM_LINEINDEX, Line, 0);
        Cur := '';
        if LS >= 0 then
        begin
          LL := SendMessageA(RichEdit1.Handle, EM_LINELENGTH, LS, 0);
          Cur := ReadLineText(Line, LS, LL);
        end;

        // Номер не подошёл (текст правили без снимка правки) - строка ищется
        // по имени объекта и свойства
        if (LS < 0) or (FObjEditInsert and not MatchesHeader(Cur)) or
           (not FObjEditInsert and not MatchesProp(Cur)) then
        begin
          SL := TStringList.Create;
          try
            SL.Text := GetEditorText;
            K := ObjFindDfmLine(SL, Obj, PName, FObjEditOld, FObjEditInsert);
          finally
            SL.Free;
          end;
          if K < 0 then
          begin
            Changed;
            Exit;
          end;
          Line := K;
          Relined := True;
          LS := SendMessageA(RichEdit1.Handle, EM_LINEINDEX, Line, 0);
          if LS < 0 then
          begin
            Changed;
            Exit;
          end;
          LL := SendMessageA(RichEdit1.Handle, EM_LINELENGTH, LS, 0);
          Cur := ReadLineText(Line, LS, LL);
        end;

        if FObjEditInsert then
        begin
          if not MatchesHeader(Cur) then
          begin
            Changed;
            Exit;
          end;
          NewLine := IndentOf(Cur) + '  ' + PName + ' = ' + NewRaw;
          // В начало следующей строки; заголовок последний - в конец текста
          LS := SendMessageA(RichEdit1.Handle, EM_LINEINDEX, Line + 1, 0);
          if LS < 0 then
          begin
            RichEdit1.SelStart := RichEdit1.GetTextLen;
            RichEdit1.SelLength := 0;
            RichEdit1.SelText := #13#10 + NewLine;
          end
          else
          begin
            RichEdit1.SelStart := LS;
            RichEdit1.SelLength := 0;
            RichEdit1.SelText := NewLine + #13#10;
          end;
        end
        else
        begin
          if not MatchesProp(Cur) then
          begin
            Changed;
            Exit;
          end;
          NewLine := IndentOf(Cur) + PName + ' = ' + NewRaw;
          RichEdit1.SelStart := LS;
          RichEdit1.SelLength := LL;
          RichEdit1.SelText := NewLine;
        end;
      finally
        EditorThaw;
      end;
    end
    else
    begin
      SL := TStringList.Create;
      try
        if WinIdx >= 0 then
          Txt := FWindows[WinIdx].Text
        else
        begin
          with TFileStream.Create(Dfm, fmOpenRead or fmShareDenyNone) do
          try
            SetLength(Txt, Size);
            if Size > 0 then
              ReadBuffer(Txt[1], Size);
          finally
            Free;
          end;
        end;
        EndsWithBreak := (Txt <> '') and (Txt[Length(Txt)] in [#13, #10]);
        SL.Text := Txt;

        // Номер не подошёл - строка ищется по имени объекта и свойства
        if (Line < 0) or (Line >= SL.Count) or
           (FObjEditInsert and not MatchesHeader(SL[Line])) or
           (not FObjEditInsert and not MatchesProp(SL[Line])) then
        begin
          K := ObjFindDfmLine(SL, Obj, PName, FObjEditOld, FObjEditInsert);
          if K < 0 then
          begin
            Changed;
            Exit;
          end;
          Line := K;
          Relined := True;
        end;

        if FObjEditInsert then
        begin
          if not MatchesHeader(SL[Line]) then
          begin
            Changed;
            Exit;
          end;
          SL.Insert(Line + 1, IndentOf(SL[Line]) + '  ' + PName + ' = ' + NewRaw);
        end
        else
        begin
          if not MatchesProp(SL[Line]) then
          begin
            Changed;
            Exit;
          end;
          SL[Line] := IndentOf(SL[Line]) + PName + ' = ' + NewRaw;
        end;

        Txt := SL.Text;
        // TStringList всегда дописывает перевод строки в конце - лишний
        // убираем, чтобы файл не менялся там, где его не трогали
        if not EndsWithBreak then
        begin
          P := Length(Txt);
          while (P > 0) and (Txt[P] in [#13, #10]) do
            Dec(P);
          SetLength(Txt, P);
        end;

        if WinIdx >= 0 then
        begin
          // --- .dfm открыт в другой вкладке: правим её текст
          FWindows[WinIdx].Text := Txt;
          FWindows[WinIdx].Modified := True;
          FWindows[WinIdx].MapValid := False;
          UpdateTabCaption(WinIdx);
        end
        else
        begin
          // --- .dfm нигде не открыт: файл на диске
          with TFileStream.Create(Dfm, fmCreate) do
          try
            if Txt <> '' then
              WriteBuffer(Txt[1], Length(Txt));
          finally
            Free;
          end;
        end;
      finally
        SL.Free;
      end;
    end;

    // Строка нашлась не по сохранённому номеру: номер - в узел, а номера
    // остальных узлов, видимо, тоже ушли
    if Relined then
    begin
      if FObjEditInsert then
      begin
        Obj.Line := Line;
        InsLine := Line + 1;
      end
      else
        Obj.PropN.Objects[FObjEditIdx] := TObject(Line);
      FObjLinesUnsure := True;
    end;

    // Узел, таблица и форма конструктора - на месте, без разбора: узел,
    // строка свойства и компонент известны. Имя - это ещё и ссылки на
    // компонент в других узлах и в модуле: тогда разбор целиком.
    if CompareText(PName, 'Name') = 0 then
      ObjScheduleRefresh(Obj, PName)
    else
    begin
      ObjPointUpdate(Obj, PName, NewRaw, InsLine, False);
      // Номера остальных узлов - разбором, форма конструктора остаётся
      if Relined then
        ObjScheduleRelines(Obj, PName);
    end;
  finally
    Dec(FObjOwnWrite);
  end;
end;

// ---------------------------------------------------------------------------
//  Отложенное перестроение после правки в инспекторе
//
//  Обычная правка обходится без него - см. ObjPointUpdate. Сюда - смена
//  Name, расхождение текста при сверке, узел не нашёлся.
//
//  Правка заканчивается щелчком: по другой строке таблицы, по другому
//  компоненту в дереве или на форме конструктора. Запись в текст идёт
//  сразу (ObjApplyEdit), а разбор, дерево и форма конструктора
//  перестраиваются сообщением WM_USER + 316 - когда щелчок уже дошёл до
//  своей строки или компонента. Иначе перестроение шло бы посреди его
//  обработки, и выделение возвращалось бы на записанное свойство.
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
//  Правка из инспектора - на месте
//
//  Значение записано в текст (ObjApplyEdit, ObjApplyCodeEdit). Дальше всё
//  известно без разбора: узел - FObjCurNode, номер свойства в нём -
//  FObjEditIdx, компонент на форме конструктора - по имени. Поэтому новое
//  значение ставится в узел, в строку таблицы и одному компоненту на форме.
//
//  Строку вставили (серое свойство или новое присваивание в .pas) - номера
//  строк ниже неё у всех узлов того же файла сдвигаются на одну.
//
//  Полный разбор (ObjScheduleRefresh) остаётся для смены Name, для
//  расхождения текста при сверке и для случая, когда конструктор не нашёл
//  компонент.
// ---------------------------------------------------------------------------

procedure TForm1.ObjPointUpdate(AObj: TObject; const AProp, ARaw: string;
                                AInsLine: Integer; ACode: Boolean);
var
  N: TDfmNode;
  Idx, I: Integer;
  Shown, Nm: string;
  It: TListItem;
begin
  N := TDfmNode(AObj);
  if N = nil then
    Exit;

  if AInsLine >= 0 then
    ObjShiftLines(AInsLine, ACode);

  // Показ - как у разбора: строка без апострофов и #кодов
  Shown := DecodeDfmString(ARaw);

  // --- узел
  if FObjEditInsert then
  begin
    // Серое свойство стало записанным: строка в тексте у него теперь есть
    Idx := N.PropN.AddObject(AProp, TObject(AInsLine));
    N.PropV.Add(Shown);
    if ACode then
      N.PropRaw.AddObject(ARaw, TObject(1)) // как у разбора кода
    else
      N.PropRaw.AddObject(ARaw, nil);
  end
  else
  begin
    Idx := FObjEditIdx;
    if (Idx < 0) or (Idx >= N.PropN.Count) or (Idx >= N.PropV.Count) or
       (Idx >= N.PropRaw.Count) then
    begin
      ObjScheduleRefresh(AObj, AProp);
      Exit;
    end;
    // Значение было только в снимке - теперь у него своя строка в коде
    if ACode and (AInsLine >= 0) then
      N.PropN.Objects[Idx] := TObject(AInsLine);
    N.PropV[Idx] := Shown;
    N.PropRaw[Idx] := ARaw;
  end;

  // --- строка таблицы, если показан этот узел. Data у строки - то, что
  // было в FObjEditIdx; серое становится обычным (Data >= 0).
  if (FObjCurNode = AObj) and (FObjProps <> nil) then
    for I := 0 to FObjProps.Items.Count - 1 do
    begin
      It := FObjProps.Items[I];
      if Integer(It.Data) = FObjEditIdx then
      begin
        if It.SubItems.Count > 0 then
          It.SubItems[0] := Shown
        else
          It.SubItems.Add(Shown);
        It.Data := Pointer(Idx);
        // Новое значение - снова «Theme color» или уже свой цвет
        if not N.IsSnap and not N.IsLink then
          ObjMarkSchemeItem(It, RttiClassFor(N));
        FObjProps.UpdateItems(I, I);
        Break;
      end;
    end;

  // --- компонент на форме конструктора. Созданный в коде назван там по
  // переменной (см. DsgAddRuntime).
  if (FDesigner <> nil) and not N.IsSnap and
     (CompareText(FObjDfmFile, FDsgDfm) = 0) then
  begin
    Nm := N.Name;
    if Nm = '' then
      Nm := N.VarName;
    if (Nm = '') or not FDesigner.SetPropText(Nm, AProp, ARaw) then
      DsgReload
      // То же - спрятанному второму виду. Правка в коде (.pas) текст .dfm не
      // меняет - «до правки» это нынешний текст.
    else if ACode then
      DsgOtherSyncProp(DsgGetText, Nm, AProp, ARaw)
    else
      DsgOtherSyncProp(FDsgEditOldText, Nm, AProp, ARaw);
  end;

  // Текст и узлы согласованы - кэш по ним
  ObjCacheSaveCurrent;
end;

// Вставлена строка AFrom: у узлов того же файла номера от неё и ниже - на
// одну больше. ACode - строка в .pas: сдвигаются строки создания (они есть
// и у узлов снимка, сопоставленных с кодом) и строки присваиваний у узлов
// из кода. Иначе - строка в .dfm: заголовки, end, свойства и события узлов
// .dfm. Номера строк снимка (у узлов IsSnap) - строки его текста, не файла.
procedure TForm1.ObjShiftLines(AFrom: Integer; ACode: Boolean);

  procedure ShiftList(L: TStrings);
  var
    K, V: Integer;
  begin
    for K := 0 to L.Count - 1 do
    begin
      V := Integer(L.Objects[K]);
      if V >= AFrom then
        L.Objects[K] := TObject(V + 1);
    end;
  end;

var
  I: Integer;
  N: TDfmNode;
begin
  if FDfmNodes = nil then
    Exit;
  for I := 0 to FDfmNodes.Count - 1 do
  begin
    N := TDfmNode(FDfmNodes[I]);
    if N = nil then
      Continue;
    if ACode then
    begin
      if N.CreateLine >= AFrom then
        N.CreateLine := N.CreateLine + 1;
      if N.FromCode then
      begin
        ShiftList(N.PropN);
        ShiftList(N.EvN);
      end;
    end
    else if not N.FromCode and not N.IsSnap then
    begin
      if N.Line >= AFrom then
        N.Line := N.Line + 1;
      if N.EndLine >= AFrom then
        N.EndLine := N.EndLine + 1;
      ShiftList(N.PropN);
      ShiftList(N.EvN);
    end;
  end;
end;

// ---------------------------------------------------------------------------
//  Номера строк в узлах инспектора при правке в редакторе
//
//  Узлы помнят номера строк: заголовок и свойства в .dfm, строки создания
//  и присваиваний в модуле. Правка руками выше них эти номера сдвигает.
//  Разбирать заново не нужно: перед правкой (CaptureWidthPre) снимаются
//  выделение, длина и число строк, после (ApplyWidthEdit) - число строк
//  стало другим на D, и номера за правкой сдвигаются на D.
//
//  Строка, задетая правкой, - по месту её начала: начало осталось левее
//  правки - номер прежний; строка начиналась там, где правка кончилась, -
//  сдвиг на D; строка удалена целиком - номер неизвестен (FObjLinesUnsure).
//  Неизвестный номер находит сверка при следующей правке из инспектора
//  (ObjFindDfmLine, поиск присваивания в модуле).
// ---------------------------------------------------------------------------

// Какой файл правится в редакторе: 0 - не тот, что показан в инспекторе,
// 1 - его .dfm, 2 - модуль формы (то же имя, расширение Паскаля)
function TForm1.ObjEditRelation: Integer;
begin
  Result := 0;
  if (FObjDfmFile = '') or (FCurrentFileName = '') then
    Exit;
  if CompareText(FCurrentFileName, FObjDfmFile) = 0 then
    Result := 1
  else if IsPascalExt(LowerCase(ExtractFileExt(FCurrentFileName))) and
          (CompareText(ChangeFileExt(FCurrentFileName, ''),
                       ChangeFileExt(FObjDfmFile, '')) = 0) then
    Result := 2;
end;

// Шрифт и формат символов текста не меняют - номера строк на месте
function IsFormatOnlyMsg(Msg: Cardinal): Boolean;
begin
  Result := (Msg = WM_SETFONT) or (Msg = EM_SETCHARFORMAT) or
            (Msg = EM_SETPARAFORMAT);
end;

procedure TForm1.ObjLinesPre(const Message: TMessage; AWhole: Boolean);
var
  Sel: TCharRange;
  Rel: Integer;
begin
  FObjPreValid := False;
  if (FObjOwnWrite > 0) or (FDfmNodes = nil) or (FDfmNodes.Count = 0) then
    Exit;
  Rel := ObjEditRelation;
  if Rel = 0 then
    Exit;
  if AWhole then
  begin
    // Undo, Redo, замена текста целиком: где правка - неизвестно
    if not IsFormatOnlyMsg(Message.Msg) then
      FObjLinesUnsure := True;
    Exit;
  end;
  if not RichEdit1.HandleAllocated then
    Exit;
  SendMessageA(RichEdit1.Handle, EM_EXGETSEL, 0, Integer(@Sel));
  FObjPreMin := Sel.cpMin;
  FObjPreMax := Sel.cpMax;
  FObjPreLen := TextLenInternal;
  FObjPreLines := SendMessageA(RichEdit1.Handle, EM_GETLINECOUNT, 0, 0);
  FObjPreLineMin := SendMessageA(RichEdit1.Handle, EM_EXLINEFROMCHAR, 0,
                                 Sel.cpMin);
  FObjPreLineMax := SendMessageA(RichEdit1.Handle, EM_EXLINEFROMCHAR, 0,
                                 Sel.cpMax);
  FObjPreStartMin := SendMessageA(RichEdit1.Handle, EM_LINEINDEX,
                                  FObjPreLineMin, 0);
  FObjPreCode := Rel = 2;
  FObjPreValid := True;
  FObjLoadPending := False;
end;

procedure TForm1.ObjLinesPost;
var
  NewLen, NewLines, D, Post, R1, LA, LB, SA, K, I: Integer;
  Sel: TCharRange;
  N: TDfmNode;
  Unsure: Boolean;

  // Номер строки после правки. LA..LB - строки, задетые правкой, R1 - её
  // начало, SA - начало строки LA.
  function Map(L: Integer): Integer;
  begin
    if L < LA then
      Result := L
    else if L > LB then
      Result := L + D
    else if (L = LA) and (SA < R1) then
      Result := L                 // начало строки левее правки - на месте
    else if L = LB then
      Result := L + D             // строка начиналась там, где правка кончилась
    else
    begin
      Result := LA;               // строка удалена целиком
      Unsure := True;
    end;
  end;

  procedure MapList(L: TStrings);
  var
    J, V: Integer;
  begin
    for J := 0 to L.Count - 1 do
    begin
      V := Integer(L.Objects[J]);
      if V >= 0 then
        L.Objects[J] := TObject(Map(V));
    end;
  end;

begin
  if not FObjPreValid then
  begin
    // Запоздалое уведомление о заливке текста вкладки - не правка
    if FObjLoadPending and (TextLenInternal = FObjLoadLen) then
    begin
      FObjLoadPending := False;
      Exit;
    end;
    // Текст поменялся без снимка до правки - где, неизвестно
    if (FObjOwnWrite = 0) and (FDfmNodes <> nil) and (FDfmNodes.Count > 0) and
       (ObjEditRelation <> 0) then
      FObjLinesUnsure := True;
    Exit;
  end;
  FObjPreValid := False;
  if (FDfmNodes = nil) or (FDfmNodes.Count = 0) then
    Exit;

  NewLines := SendMessageA(RichEdit1.Handle, EM_GETLINECOUNT, 0, 0);
  D := NewLines - FObjPreLines;
  if D = 0 then
    Exit; // строк столько же - номера на месте
  NewLen := TextLenInternal;
  SendMessageA(RichEdit1.Handle, EM_EXGETSEL, 0, Integer(@Sel));
  Post := Sel.cpMin;

  if FObjPreMin < FObjPreMax then
  begin
    // Было выделение - оно и заменено (набором, вставкой или удалением)
    R1 := FObjPreMin;
    LA := FObjPreLineMin;
    SA := FObjPreStartMin;
    LB := FObjPreLineMax;
  end
  else if NewLen >= FObjPreLen then
  begin
    // Вставка в точку каретки
    R1 := FObjPreMin;
    LA := FObjPreLineMin;
    SA := FObjPreStartMin;
    LB := LA;
  end
  else
  begin
    // Удаление без выделения: BackSpace - левее каретки, Delete - правее
    K := FObjPreLen - NewLen;
    if Post < FObjPreMin then
      R1 := FObjPreMin - K
    else
      R1 := FObjPreMin;
    // Текст левее правки не менялся - строка и её начало те же, что до неё
    LA := SendMessageA(RichEdit1.Handle, EM_EXLINEFROMCHAR, 0, R1);
    SA := SendMessageA(RichEdit1.Handle, EM_LINEINDEX, LA, 0);
    // Вставки не было: сколько строк убавилось, столько переводов стёрто
    LB := LA - D;
  end;

  Unsure := False;
  for I := 0 to FDfmNodes.Count - 1 do
  begin
    N := TDfmNode(FDfmNodes[I]);
    if N = nil then
      Continue;
    if FObjPreCode then
    begin
      if N.CreateLine >= 0 then
        N.CreateLine := Map(N.CreateLine);
      if N.FromCode then
      begin
        MapList(N.PropN);
        MapList(N.EvN);
      end;
    end
    else if not N.FromCode and not N.IsSnap then
    begin
      if N.Line >= 0 then
        N.Line := Map(N.Line);
      if N.EndLine >= 0 then
        N.EndLine := Map(N.EndLine);
      MapList(N.PropN);
      MapList(N.EvN);
    end;
  end;
  if Unsure then
    FObjLinesUnsure := True;
end;

// Правка под блокировкой подсветки (массовая замена и т. п.): снимка до
// неё нет, номера строк - неизвестны
procedure TForm1.ObjLinesLocked(const Message: TMessage);
begin
  if (FObjOwnWrite > 0) or (FDfmNodes = nil) or (FDfmNodes.Count = 0) then
    Exit;
  if IsFormatOnlyMsg(Message.Msg) then
    Exit;
  if ObjEditRelation <> 0 then
    FObjLinesUnsure := True;
end;

// Строка .dfm, если сохранённый номер не подошёл: заголовок объекта - по
// имени (имена в форме уникальны), свойство - в теле объекта, на уровне
// его собственных свойств (вложенные объекты глубже). -1 - не нашлось.
function TForm1.ObjFindDfmLine(ALines: TStrings; AObj: TObject;
                               const AProp, AOld: string;
                               AHeader: Boolean): Integer;
var
  N: TDfmNode;
  I, H, HI, Ind: Integer;
  T, U, Nm: string;

  function IndentOf(const S: string): Integer;
  begin
    Result := 0;
    while (Result < Length(S)) and (S[Result + 1] in [' ', #9]) do
      Inc(Result);
  end;

begin
  Result := -1;
  N := TDfmNode(AObj);
  if (N = nil) or (N.Name = '') then
    Exit;
  Nm := UpperCase(N.Name) + ':';

  H := -1;
  for I := 0 to ALines.Count - 1 do
  begin
    T := UpperCase(Trim(ALines[I]));
    if (Copy(T, 1, 7) = 'OBJECT ') or (Copy(T, 1, 7) = 'INLINE ') then
      U := TrimLeft(Copy(T, 8, MaxInt))
    else if Copy(T, 1, 10) = 'INHERITED ' then
      U := TrimLeft(Copy(T, 11, MaxInt))
    else
      Continue;
    if Copy(U, 1, Length(Nm)) = Nm then
    begin
      H := I;
      Break;
    end;
  end;
  if H < 0 then
    Exit;
  if AHeader then
  begin
    Result := H;
    Exit;
  end;

  HI := IndentOf(ALines[H]);
  for I := H + 1 to ALines.Count - 1 do
  begin
    T := ALines[I];
    if Trim(T) = '' then
      Continue;
    Ind := IndentOf(T);
    if Ind <= HI then
      Break; // end объекта
    if Ind <> HI + 2 then
      Continue;
    T := Trim(T);
    if (CompareText(Copy(T, 1, Length(AProp) + 3), AProp + ' = ') = 0) and
       (Copy(T, Length(AProp) + 4, MaxInt) = AOld) then
    begin
      Result := I;
      Exit;
    end;
  end;
end;

procedure TForm1.ObjScheduleRefresh(AObj: TObject; const AProp: string);
begin
  FObjRefreshDsg := True;
  ObjPostRefresh(AObj, AProp);
end;

// То же, но форма конструктора не перестраивается: правка на ней уже
// показана, разбор нужен только ради номеров строк
procedure TForm1.ObjScheduleRelines(AObj: TObject; const AProp: string);
begin
  if not FObjRefreshPending then
    FObjRefreshDsg := False;
  ObjPostRefresh(AObj, AProp);
end;

procedure TForm1.ObjPostRefresh(AObj: TObject; const AProp: string);
var
  N: TDfmNode;
begin
  N := TDfmNode(AObj);
  FObjRefreshNode := AObj;
  FObjRefreshName := '';
  if N <> nil then
  begin
    FObjRefreshName := N.Name;
    if FObjRefreshName = '' then
      FObjRefreshName := N.VarName;
  end;
  FObjRefreshProp := AProp;
  FObjDfmKey := '';
  if not FObjRefreshPending then
  begin
    FObjRefreshPending := True;
    PostMessage(Handle, WM_USER + 316, 0, 0);
  end;
end;

// Вторая половина переключения вкладки (см. конец ActivateWindow):
// таблица подпрограмм, инспектор объектов, дерево кода. Приходит, когда
// текст новой вкладки уже нарисован. Вкладку за это время сменили ещё раз
// - номер в сообщении устарел, работа пойдёт по последнему сообщению.
//
// Часов вместо курсора нет (FTabWork). Если в прошлый раз эта работа для
// этого окна шла дольше TabWorkShowMs, сразу показывается жёлтая панель
// хода в строке состояния (BusyBegin) с названием этапа. Иначе панели нет
// вовсе: на быстрых переключениях ничего не появляется и не мигает. Время
// обеих половин - в HiLite log.
procedure TForm1.WMTabSwitched(var Msg: TMessage);
const
  TabWorkShowMs = 300;
var
  W: Integer;
  T0, TSub, TObj, TCode: Cardinal;
begin
  W := Msg.WParam;
  if (W <> FWindowsIndex) or (Msg.LParam <> FTabSwitchGen) then
    Exit;
  if (W < 0) or (W > WindowsItemCount - 1) or not FWindows[W].Used then
    Exit;

  FTabWork := True;
  FTabWorkShown := FWindows[W].WorkMs > TabWorkShowMs;
  if FTabWorkShown then
    BusyBegin('Разбор ' + ExtractFileName(FWindows[W].FileName));
  T0 := GetTickCount;
  TSub := 0;
  TObj := 0;
  TCode := 0;
  try
    if FSubListViewPending then
    begin
      TabWorkStage('Список подпрограмм');
      FillSubListView;
      TSub := GetTickCount - T0;
    end;

    TabWorkStage('Инспектор объектов');
    // Форма нового окна - в инспектор, если его вкладка открыта
    RefreshObjectInspector(False);
    TObj := GetTickCount - T0 - TSub;

    // Дерево компонентов кода - под новый файл, если вкладка Code открыта
    if (FRightPages <> nil) and (FRightPages.ActivePage = FTabCode) then
    begin
      TabWorkStage('Дерево кода');
      RefreshCodeTree;
      TCode := GetTickCount - T0 - TSub - TObj;
    end;

    // Список include - под новый файл, если вкладка Includes открыта
    if (FRightPages <> nil) and (FRightPages.ActivePage = FTabIncludes) then
    begin
      TabWorkStage('Includes');
      RefreshIncludes;
    end;
  finally
    FTabWork := False;
    FWindows[W].WorkMs := GetTickCount - T0;
    if FTabWorkShown then
      BusyEnd('', True);
    FTabWorkShown := False;
  end;

  Dbg('19245: вкладка ' + ExtractFileName(FWindows[W].FileName) +
  ': после показа ' + IntToStr(FWindows[W].WorkMs) + ' мс (подпрограммы ' +
      IntToStr(TSub) + ', инспектор ' + IntToStr(TObj) + ', дерево кода ' +
      IntToStr(TCode) + ')', clGray);
end;

// Этап второй половины переключения - в панель хода, если она показана
procedure TForm1.TabWorkStage(const AStage: string);
begin
  if FTabWorkShown then
    BusyStage(AStage);
end;

procedure TForm1.WMObjRefresh(var Msg: TMessage);
var
  Nm, Prop: string;
  N: TDfmNode;
  Dsg: Boolean;
begin
  if not FObjRefreshPending or (FObjTree = nil) then
    Exit;

  // В конструкторе тянут мышью: перестроить его форму сейчас - сорвать
  // перетаскивание. Ждём, пока кнопку отпустят.
  if ((FDesigner <> nil) and FDesigner.Dragging) or
     ((FRqDesigner <> nil) and FRqDesigner.Dragging) then
  begin
    FObjRefreshTimer.Enabled := True;
    Exit;
  end;
  FObjRefreshPending := False;

  // Куда вернуть выделение: туда, куда щёлкнули, закончив правку, - другой
  // компонент или другая строка того же. Щелчка не было (Enter) - на
  // записанное свойство.
  Nm := FObjRefreshName;
  Prop := FObjRefreshProp;
  if (FObjTree.Selected <> nil) and (FObjTree.Selected.Data <> nil) and
     (FObjTree.Selected.Data <> FObjRefreshNode) then
  begin
    N := TDfmNode(FObjTree.Selected.Data);
    Nm := N.Name;
    if Nm = '' then
      Nm := N.VarName;
    Prop := '';
  end;
  if FObjProps.Selected <> nil then
    Prop := ObjPropRowName(FObjProps.Selected);

  FObjDfmKey := '';
  RefreshObjectInspector(True);

  // Та же форма в конструкторе - показать правку и там (если она ещё не
  // показана на месте)
  Dsg := FObjRefreshDsg and (FDesigner <> nil) and
         (CompareText(FObjDfmFile, FDsgDfm) = 0);
  if Dsg then
    DsgReload;

  if (Nm <> '') and ObjSelectAnyName(Nm) then
  begin
    // Узел мог остаться тем же - тогда OnChange дерева не придёт, а форма
    // конструктора после перезагрузки без выделения
    if Dsg and (FDesigner <> nil) then
      FDesigner.SelectByName(Nm);
    ObjSelectPropRow(Prop);
  end;
end;

procedure TForm1.ObjRefreshRetryTick(Sender: TObject);
begin
  FObjRefreshTimer.Enabled := False;
  PostMessage(Handle, WM_USER + 316, 0, 0);
end;

// Строка свойства по имени; нет такой - выделение не трогаем
procedure TForm1.ObjSelectPropRow(const AProp: string);
var
  I: Integer;
  It: TListItem;
begin
  if (AProp = '') or (FObjProps = nil) then
    Exit;
  for I := 0 to FObjProps.Items.Count - 1 do
  begin
    It := FObjProps.Items[I];
    if CompareText(ObjPropRowName(It), AProp) = 0 then
    begin
      FObjProps.Selected := It;
      It.MakeVisible(False);
      Exit;
    end;
  end;
end;

// Уведомления списка приходят его родителю (таблице свойств) и
// возвращаются списку как CN_COMMAND. CBN_SELENDOK - значение выбрано в
// раскрытом списке мышью или Enter; запись - сообщением, когда список
// закроется.
procedure TForm1.ObjComboWndProc(var Message: TMessage);
begin
  FObjComboOldProc(Message);
  if (Message.Msg = CN_COMMAND) and
     (TWMCommand(Message).NotifyCode = CBN_SELENDOK) and
     FObjEditing and (FObjActive = FObjCombo) then
    PostMessage(Handle, WM_USER + 317, 0, 0);
end;

procedure TForm1.WMObjCommit(var Msg: TMessage);
begin
  if not FObjEditing or (FObjActive <> FObjCombo) then
    Exit;
  ObjApplyEdit;
  if not FObjEditing and FObjProps.CanFocus then
    FObjProps.SetFocus;
end;

// Выделить узел по имени и классу и строку свойства по имени - после
// перестроения дерева выделение иначе уходит на корень
procedure TForm1.ObjSelect(const AName, AClass, AProp: string);
var
  I: Integer;
  N: TDfmNode;
  It: TListItem;
begin
  for I := 0 to FObjTree.Items.Count - 1 do
  begin
    N := TDfmNode(FObjTree.Items[I].Data);
    if (N <> nil) and not N.IsSnap and (CompareText(N.Name, AName) = 0) and
       (CompareText(N.ClassNm, AClass) = 0) then
    begin
      FObjTree.Selected := FObjTree.Items[I];
      FObjTree.Selected.MakeVisible;
      ObjTreeChange(nil, FObjTree.Selected);
      Break;
    end;
  end;

  if AProp = '' then
    Exit;
  for I := 0 to FObjProps.Items.Count - 1 do
  begin
    It := FObjProps.Items[I];
    if CompareText(ObjPropRowName(It), AProp) = 0 then
    begin
      FObjProps.Selected := It;
      It.MakeVisible(False);
      Break;
    end;
  end;
end;

procedure TForm1.ObjPropsDblClick(Sender: TObject);
begin
  ObjBeginEdit;
end;

procedure TForm1.ObjPropsKeyDown(Sender: TObject; var Key: Word;
                                 Shift: TShiftState);
begin
  if (Key = VK_RETURN) or (Key = VK_F2) then
  begin
    Key := 0;
    ObjBeginEdit;
  end
  // Узел (Font) таблицы RapidQ: + раскрыть, - свернуть
  else if ((Key = VK_ADD) or (Key = VK_SUBTRACT)) and
          RqPropIsNode(FObjProps.Selected) then
  begin
    RqPropExpand(ObjPropRowName(FObjProps.Selected), Key = VK_ADD);
    Key := 0;
  end;
end;

procedure TForm1.ObjEditKeyDown(Sender: TObject; var Key: Word;
                                Shift: TShiftState);
begin
  if Key = VK_RETURN then
  begin
    Key := 0;
    ObjApplyEdit;
    // Значение не прошло проверку - поле открыто, фокус остаётся в нём
    if not FObjEditing then
      FObjProps.SetFocus;
  end
  else if Key = VK_ESCAPE then
  begin
    Key := 0;
    ObjCancelEdit;
    FObjProps.SetFocus;
  end;
end;

procedure TForm1.ObjEditExit(Sender: TObject);
begin
  if FObjInColorDlg then
    Exit;
  ObjApplyEdit;
end;

// Цвет по тексту из списка значений: имя (clRed, clBtnFace), «Theme color»
// (цвет темы этого свойства), $00BBGGRR, &HBBGGRR, десятичное число,
// константа программы RapidQ. False - не цвет.
function TForm1.ObjColorOfText(const AText: string; var AColor: TColor): Boolean;
var
  Txt: string;
  Value: Integer;
begin
  Result := False;
  Txt := Trim(AText);
  if (CompareText(Txt, ObjThemeItem) = 0) and (FObjThemeColor <> '') then
    Txt := FObjThemeColor;
  if Txt = '' then
    Exit;
  if IdentToColor(Txt, Value) then
    Result := True
  else if Txt[1] = '$' then
    Result := TryStrToInt(Txt, Value)
  else if UpperCase(Copy(Txt, 1, 2)) = '&H' then
    Result := TryStrToInt('$' + Copy(Txt, 3, MaxInt), Value)
  else if Txt[1] in ['0'..'9', '-'] then
    Result := TryStrToInt(Txt, Value)
  else
    Result := RqConstValue(Txt, Value);
  if Result then
    AColor := TColor(Value);
end;

// Строка списка значений: у цвета - квадратик этого цвета слева от имени
procedure TForm1.ObjComboDrawItem(Control: TWinControl; Index: Integer;
                                  Rect: TRect; State: TOwnerDrawState);
var
  Cv: TCanvas;
  ItemText: string;
  ItemColor: TColor;
  TextLeft: Integer;
  Swatch: TRect;
begin
  Cv := FObjCombo.Canvas;
  Cv.FillRect(Rect);
  if (Index < 0) or (Index >= FObjCombo.Items.Count) then
    Exit;
  ItemText := FObjCombo.Items[Index];
  TextLeft := Rect.Left + 2;
  if FObjComboColors then
  begin
    Swatch.Left := Rect.Left + 2;
    Swatch.Top := Rect.Top + 2;
    Swatch.Right := Swatch.Left + 14;
    Swatch.Bottom := Rect.Bottom - 2;
    Cv.Pen.Color := clGray;
    if ObjColorOfText(ItemText, ItemColor) and (ItemColor <> clNone) and
       (ItemColor <> clDefault) then
    begin
      Cv.Brush.Color := ColorToRGB(ItemColor);
      Cv.Rectangle(Swatch.Left, Swatch.Top, Swatch.Right, Swatch.Bottom);
    end
    else
    begin
      // clNone, clDefault и не цвет - рамка с косой чертой
      Cv.Brush.Style := bsClear;
      Cv.Rectangle(Swatch.Left, Swatch.Top, Swatch.Right, Swatch.Bottom);
      Cv.MoveTo(Swatch.Left, Swatch.Bottom - 1);
      Cv.LineTo(Swatch.Right - 1, Swatch.Top);
    end;
    TextLeft := Swatch.Right + 4;
  end;
  Cv.Brush.Style := bsClear;
  Cv.TextOut(TextLeft, Rect.Top + (Rect.Bottom - Rect.Top -
             Cv.TextHeight(ItemText)) div 2, ItemText);
end;

// Двойной щелчок по полю цвета - диалог цвета; свой цвет записывается
// числом: $00BBGGRR (Delphi) или &HBBGGRR (RapidQ)
procedure TForm1.ObjComboDblClick(Sender: TObject);
var
  Dlg: TUiColorDialog;
  CurColor: TColor;
begin
  if not FObjEditing or (FObjActive <> FObjCombo) or not FObjComboColors then
    Exit;
  if FObjCombo.DroppedDown then
    FObjCombo.DroppedDown := False;
  // Свой диалог в цветах темы IDE (UiStdDlgs), как в IDE Options
  Dlg := TUiColorDialog.Create(Self);
  FObjInColorDlg := True;
  try
    Dlg.Options := [cdFullOpen, cdAnyColor];
    if ObjColorOfText(FObjCombo.Text, CurColor) and (CurColor <> clNone) and
       (CurColor <> clDefault) then
      Dlg.Color := ColorToRGB(CurColor);
    if not Dlg.Execute then
      Exit;
    if FObjColorRq then
      FObjCombo.Text := '&H' + IntToHex(Dlg.Color and $FFFFFF, 6)
    else
      FObjCombo.Text := '$' + IntToHex(Dlg.Color and $FFFFFF, 8);
  finally
    FObjInColorDlg := False;
    Dlg.Free;
  end;
  // Записать сразу, как выбор из списка
  PostMessage(Handle, WM_USER + 317, 0, 0);
end;

// ---------------------------------------------------------------------------
//  Переход от runtime-компонента к строке, где он создаётся
//
//  Имени у созданного в коде компонента обычно нет: FToolbar - поле класса,
//  а не Name, и RTTI Delphi 7 закрытых полей не видит. Поэтому строка
//  ищется в тексте модуля по признакам, от самого точного к общему:
//    1. компонент с именем - присваивание Имя := TКласс.Create или
//       X.Name := 'Имя' после создания;
//    2. есть Caption или Text - создание TКласс.Create, за которым в
//       нескольких строках идёт X.Caption := 'та же подпись';
//    3. та же подпись литералом где угодно в коде - так создаются кнопки
//       и пункты меню через помощники: MakeBtn('<-Find', ...);
//    4. любое создание TКласс.Create.
//  Одно совпадение - переходим. Несколько - список на выбор.
// ---------------------------------------------------------------------------

// Текст модуля: из вкладки, если он открыт, иначе с диска
function TForm1.UnitTextOf(const APas: string): string;
var
  W: Integer;
begin
  Result := '';
  W := WindowOfFile(APas);
  if W = FWindowsIndex then
    Result := GetEditorText
  else if W >= 0 then
    Result := FWindows[W].Text
  else if FileExists(APas) then
    with TFileStream.Create(APas, fmOpenRead or fmShareDenyNone) do
    try
      SetLength(Result, Size);
      if Size > 0 then
        ReadBuffer(Result[1], Size);
    finally
      Free;
    end;
end;

// Модуль формы: рядом с .dfm, а если показан только снимок - среди
// открытых вкладок тот, где объявлен класс формы
function TForm1.ObjFormUnit: string;
var
  I: Integer;
  Pat: string;
begin
  Result := '';
  if FObjDfmFile <> '' then
  begin
    Result := UnitFileFor(FObjDfmFile);   // .pas или .pp
    if Result <> '' then
      Exit;
  end;

  if FObjFormClass = '' then
    Exit;
  Pat := AnsiUpperCase(FObjFormClass + ' = class');
  StoreCurrentWindow;
  for I := 0 to WindowsItemCount - 1 do
    if FWindows[I].Used and
       IsPascalExt(ExtractFileExt(FWindows[I].FileName)) and
       (Pos(Pat, AnsiUpperCase(FWindows[I].Text)) > 0) then
    begin
      Result := FWindows[I].FileName;
      Exit;
    end;
end;

// Строка, где создаётся компонент узла. -1 - не нашлась или выбор отменён.
function TForm1.FindCreateLine(const AText: string; ANode: TObject): Integer;
var
  N: TDfmNode;
  Lines, Cands, CapHit, LitHit: TStringList;
  I, J, K, P: Integer;
  Cap, Lit, U, L, Lhs, Cls, S: string;

  // "  FToolbar := TPanel.Create(Self);" -> класс и переменная слева
  function ParseCreate(const ALine: string; var AClass, ALhs: string): Boolean;
  var
    T, TU: string;
    Q, E, B: Integer;
  begin
    Result := False;
    T := Trim(ALine);
    if Copy(T, 1, 2) = '//' then
      Exit;
    TU := UpperCase(T);
    Q := CodeCreatePos(TU);
    if Q <= 0 then
      Exit;
    // класс - идентификатор прямо перед .Create
    E := Q - 1;
    B := E;
    while (B >= 1) and (T[B] in ['a'..'z', 'A'..'Z', '0'..'9', '_']) do
      Dec(B);
    AClass := Copy(T, B + 1, E - B);
    if AClass = '' then
      Exit;
    // слева от класса - ":=" и переменная, если присваивание есть
    ALhs := '';
    P := Pos(':=', T);
    if (P > 0) and (P < B) then
      ALhs := Trim(Copy(T, 1, P - 1));
    Result := True;
  end;

// Из строки "X.Caption := 'текст';  // пояснение" - текст; '' - справа
// не литерал. Литерал берётся от начала до первого символа, который в
// него не входит: так отсекаются и ';', и комментарий за ним.
  function LiteralAfterAssign(const ALine: string): string;
  var
    T: string;
    Q, E: Integer;
    InQ: Boolean;
  begin
    Result := '';
    T := Trim(ALine);
    Q := Pos(':=', T);
    if Q <= 0 then
      Exit;
    T := Trim(Copy(T, Q + 2, MaxInt));
    if (T = '') or not (T[1] in ['''', '#']) then
      Exit;

    E := 1;
    InQ := False;
    while E <= Length(T) do
    begin
      if T[E] = '''' then
        InQ := not InQ         // '' внутри строки - два переключения подряд
      else if not InQ and not (T[E] in ['#', '0'..'9', '+', ' ']) then
        Break;
      Inc(E);
    end;
    Result := DecodeDfmString(Trim(Copy(T, 1, E - 1)));
  end;

  function Choose(AList: TStringList): Integer;
  var
    Sel: string;
  begin
    Result := -1;
    if AList.Count = 0 then
      Exit;
    if AList.Count = 1 then
    begin
      Result := Integer(AList.Objects[0]);
      Exit;
    end;
    Sel := ChooseFromList('Где создаётся ' + N.ClassNm,
    'Подходящих строк несколько:', AList);
                          if Sel <> '' then
                          Result := Integer(AList.Objects[AList.IndexOf(Sel)]);
  end;

  procedure AddCand(AList: TStringList; ALine: Integer);
  begin
    AList.AddObject(Format('%5d:  %s', [ALine + 1, Trim(Lines[ALine])]),
                    TObject(ALine));
  end;

begin
  Result := -1;
  N := TDfmNode(ANode);
  Lines := TStringList.Create;
  Cands := TStringList.Create;
  CapHit := TStringList.Create;
  LitHit := TStringList.Create;
  try
    Lines.Text := AText;

    // Подпись узла - для сверки
    Cap := '';
    K := N.PropN.IndexOf('Caption');
    if K < 0 then
      K := N.PropN.IndexOf('Text');
    if K >= 0 then
      Cap := N.PropV[K];

    for I := 0 to Lines.Count - 1 do
    begin
      if not ParseCreate(Lines[I], Cls, Lhs) then
        Continue;
      if CompareText(Cls, N.ClassNm) <> 0 then
        Continue;
      AddCand(Cands, I);

      // 1. имя - слева от := или в X.Name := 'Имя' ниже
      if N.Name <> '' then
      begin
        if CompareText(Lhs, N.Name) = 0 then
        begin
          Result := I;
          Exit;
        end;
        for J := I + 1 to I + 40 do
        begin
          if J >= Lines.Count then
            Break;
          if (Lhs <> '') and
             (Pos(AnsiUpperCase(Lhs + '.Name'), AnsiUpperCase(Lines[J])) > 0) and
             (LiteralAfterAssign(Lines[J]) = N.Name) then
          begin
            Result := I;
            Exit;
          end;
        end;
      end;

      // 2. подпись ниже создания: X.Caption := 'та же'
      if (Cap <> '') and (Lhs <> '') then
        for J := I + 1 to I + 40 do
        begin
          if J >= Lines.Count then
            Break;
          U := AnsiUpperCase(Trim(Lines[J]));
          if ((Pos(AnsiUpperCase(Lhs + '.Caption'), U) = 1) or
              (Pos(AnsiUpperCase(Lhs + '.Text'), U) = 1)) and
             (LiteralAfterAssign(Lines[J]) = Cap) then
          begin
            AddCand(CapHit, I);
            Break;
          end;
          // Дошли до создания следующего - дальше не наше
          if ParseCreate(Lines[J], S, L) then
            Break;
        end;
    end;

    Result := Choose(CapHit);
    if (Result >= 0) or (CapHit.Count > 1) then
      Exit;

    // 3. подпись литералом где угодно в коде: помощники вроде MakeBtn
    if Cap <> '' then
    begin
      Lit := EncodeDfmString(Cap);
      for I := 0 to Lines.Count - 1 do
      begin
        L := Trim(Lines[I]);
        if Copy(L, 1, 2) = '//' then
          Continue;
        if Pos(Lit, L) > 0 then
          AddCand(LitHit, I);
      end;
      Result := Choose(LitHit);
      if (Result >= 0) or (LitHit.Count > 1) then
        Exit;
    end;

    // 4. любое создание этого класса
    Result := Choose(Cands);
  finally
    LitHit.Free;
    CapHit.Free;
    Cands.Free;
    Lines.Free;
  end;
end;

// Строка модуля формы: открыть модуль и встать на неё
procedure TForm1.JumpToUnitLine(ALine: Integer);
var
  Pas: string;
begin
  Pas := ObjFormUnit;
  if Pas = '' then
  begin
    ShowMessage('20208:Модуль формы ' + FObjFormClass + ' не найден.');
    Exit;
  end;
  OpenNamedFile(Pas);
  GotoLine(ALine);
end;

// Щелчок мышью по runtime-узлу - к строке его создания. Именно щелчок,
// а не смена выделения: ходить по дереву стрелками можно, не прыгая по
// коду на каждом шаге.
procedure TForm1.ObjTreeClick(Sender: TObject);
var
  Pt: TPoint;
begin
  if (FObjTree.Selected = nil) or (FObjTree.Selected.Data = nil) then
    Exit;

  // Щелчок по плюсику раскрывает ветку - это не выбор компонента
  GetCursorPos(Pt);
  Pt := FObjTree.ScreenToClient(Pt);
  if FObjTree.GetHitTestInfoAt(Pt.X, Pt.Y) *
     [htOnItem, htOnIcon, htOnLabel] = [] then
    Exit;
  ObjJumpToSelected;
  // Переход к строке (GotoLine) отдаёт фокус редактору - возвращаем его
  // дереву: по нему продолжают ходить мышью и стрелками
  if FObjTree.CanFocus then
    FObjTree.SetFocus;
end;

// Переход к выделенному в дереве компоненту в тексте: заголовок object в
// .dfm или строка создания в .pas. Из щелчка в дереве и из конструктора -
// поэтому без проверки, где сейчас мышь.
procedure TForm1.ObjJumpToSelected;
var
  N: TDfmNode;
  Pas, Txt, Dfm, Arr: string;
  Line, ArrIdx, K: Integer;

  // Runtime-узел, которого нет ни в .dfm, ни в коде модуля: его создал сам
  // компонент-владелец из своих свойств. Так TRadioGroup делает TGroupButton
  // на каждую строку Items. Переход - к владельцу в .dfm: к строке с
  // подписью узла внутри его блока (строка Items.Strings), иначе к
  // заголовку object владельца. False - владельца из .dfm нет.
  //
  // Предок ищется по узлам ДЕРЕВА, а не по N.Parent: MergeSnapNode
  // переставляет узел снимка под узел .dfm, но поле Parent у него остаётся
  // прежним - узел-родитель в снимке, а снимок целиком из узлов IsSnap.
  function JumpToDfmOwner: Boolean;
  var
    A: TDfmNode;
    TN: TTreeNode;
    Cap, Lit, LitW, F: string;
    L0, L1, K, I: Integer;
    W: WideString;
    SL: TStringList;
  begin
    Result := False;
    if (FObjDfmFile = '') or FObjDfmBinary or (FObjTree.Selected = nil) then
      Exit;
    A := nil;
    TN := FObjTree.Selected.Parent;
    while TN <> nil do
    begin
      if TN.Data <> nil then
      begin
        A := TDfmNode(TN.Data);
        if not (A.IsRuntime or A.IsSnap or A.FromCode) then
          Break;
        A := nil;
      end;
      TN := TN.Parent;
    end;
    if (A = nil) or (A.Line < 0) then
      Exit;

    // Всё нужное - до OpenNamedFile: он перестраивает дерево, и узлы
    // освобождаются
    L0 := A.Line;
    L1 := A.EndLine;
    F := FObjDfmFile;
    Cap := '';
    K := N.PropN.IndexOf('Caption');
    if K < 0 then
      K := N.PropN.IndexOf('Text');
    if K >= 0 then
      Cap := N.PropV[K];

    Line := L0;
    if Cap <> '' then
    begin
      // Подпись в .dfm записана либо как есть, либо кодами #1053 -
      // проверяются оба вида
      Lit := EncodeDfmString(Cap);
      W := Cap;
      LitW := '';
      for I := 1 to Length(W) do
        if Ord(W[I]) > 127 then
          LitW := LitW + '#' + IntToStr(Ord(W[I]))
        else
          LitW := LitW + Char(W[I]);
      SL := TStringList.Create;
      try
        SL.Text := UnitTextOf(F);
        if (L1 < 0) or (L1 >= SL.Count) then
          L1 := SL.Count - 1;
        for I := L0 to L1 do
          if (Pos(Lit, SL[I]) > 0) or
             ((LitW <> Cap) and (Pos(LitW, SL[I]) > 0)) then
          begin
            Line := I;
            Break;
          end;
      finally
        SL.Free;
      end;
    end;

    OpenNamedFile(F);
    GotoLine(Line);
    Result := True;
  end;

begin
  if (FObjTree.Selected = nil) or (FObjTree.Selected.Data = nil) then
    Exit;
  N := TDfmNode(FObjTree.Selected.Data);

  // Объект RapidQ - к его строке CREATE в открытом файле
  if FObjRapidQ then
  begin
    if N.CreateLine >= 0 then
      GotoLine(N.CreateLine);
    Exit;
  end;

  // Компонент из .dfm - к строке его заголовка object в тексте формы.
  // Номер строки и имя файла берём ДО OpenNamedFile: переключение вкладки
  // перестраивает инспектор, а при этом старые узлы освобождаются, и
  // читать N.Line после было бы чтением из освобождённой памяти.
  if not N.IsRuntime and not N.IsSnap and not N.FromCode then
  begin
    if (FObjDfmFile = '') or FObjDfmBinary or (N.Line < 0) then
      Exit;
    Line := N.Line;
    Dfm := FObjDfmFile;
    OpenNamedFile(Dfm);
    GotoLine(Line);
    Exit;
  end;

  // Элемент массива компонентов - к строке, где создаются элементы
  if N.IsSnap and ObjArrayOf(N.Name, Arr, ArrIdx) then
  begin
    K := -1;
    if FObjArrayLines <> nil then
      K := FObjArrayLines.IndexOf(Arr + '.CREATE');
    if K < 0 then
      ShowMessage('20584:Создание элементов ' + Arr + ' в модуле формы не ' +
      'найдено.')
    else
      JumpToUnitLine(Integer(FObjArrayLines.Objects[K]));
    Exit;
  end;

  if not N.IsRuntime then
    Exit;

  // Кнопки TRadioGroup в коде не создаются никогда - сразу к владельцу
  if (CompareText(N.ClassNm, 'TGroupButton') = 0) or
     (CompareText(N.ClassNm, 'TUiGroupButton') = 0) then
  begin
    if not JumpToDfmOwner then
      ShowMessage('20358:' + N.ClassNm + ' создаёт владелец, а его в .dfm ' +
      'не найти.');
                  Exit;
  end;

  Pas := ObjFormUnit;
  if Pas = '' then
  begin
    ShowMessage('20366:Модуль формы ' + FObjFormClass + ' не найден. Откройте его ' +
    'во вкладке и повторите.');
                Exit;
  end;

  Txt := UnitTextOf(Pas);

  // Переменная найдена при разборе - строка создания известна. Сверяем:
  // модуль могли поправить, и номера строк уехали
  Line := -1;
  if (N.VarName <> '') and (N.CreateLine >= 0) then
    with TStringList.Create do
    try
      Text := Txt;
      // Строка создания: X := TКласс.Create(...) или через помощник модуля
      // X := MakeBtn(...) - тогда .Create в ней нет, но есть присваивание
      if (N.CreateLine < Count) and
         (Pos(AnsiUpperCase(N.VarName), AnsiUpperCase(Strings[N.CreateLine])) > 0) and
         ((CodeCreatePos(AnsiUpperCase(Strings[N.CreateLine])) > 0) or
          (Pos(':=', Strings[N.CreateLine]) > 0)) then
        Line := N.CreateLine;
    finally
      Free;
    end;
  if Line < 0 then
    Line := FindCreateLine(Txt, N);
  if Line < 0 then
  begin
    // В коде создания нет - узел мог создать владелец из .dfm
    if JumpToDfmOwner then
      Exit;
    ShowMessage('20397:Создание ' + N.ClassNm + ' в ' + ExtractFileName(Pas) +
    ' не найдено.');
                Exit;
  end;

  OpenNamedFile(Pas);
  GotoLine(Line);
end;

// ---------------------------------------------------------------------------
//  Визуальный конструктор форм (модуль FormDesigner)
//
//  Конструктор строит живую форму из текста .dfm и отдаёт сюда изменения:
//  имя компонента и новые Left / Top / Width / Height. Пишутся они в текст
//  ВКЛАДКИ с .dfm, а не на диск: видно, что форма изменена, и в файл ничего
//  не попадает без Save. Вкладки нет - открывается, и активной остаётся
//  та, где работали. У конструктора свой откат - Ctrl+Z в его окне.
// ---------------------------------------------------------------------------

// Текст формы, которую показывает конструктор: из редактора, если вкладка
// активна, иначе из её хранилища
function TForm1.DsgGetText: string;
var
  Idx: Integer;
begin
  Result := '';
  Idx := WindowOfFile(FDsgDfm);
  if Idx < 0 then
    Exit;
  if Idx = FWindowsIndex then
    Result := GetEditorText
  else
    Result := FWindows[Idx].Text;
end;

procedure TForm1.DsgSetText(const AText: string);
begin
  DsgSetFileText(FDsgDfm, AText);
end;

// Файл во вкладке: нет - открывается, активной остаётся та, где работали.
// Номер вкладки, -1 - открыть не удалось.
function TForm1.DsgOpenKeep(const AFile: string): Integer;
var
  Prev: Integer;
begin
  Result := WindowOfFile(AFile);
  if Result >= 0 then
    Exit;
  Prev := FWindowsIndex;
  OpenNamedFile(AFile);
  if (Prev >= 0) and (Prev <> FWindowsIndex) and FWindows[Prev].Used then
    ActivateWindow(Prev);
  Result := WindowOfFile(AFile);
end;

// Текст файла из его вкладки (модуль формы при удалении компонента)
function TForm1.DsgFileText(const AFile: string): string;
var
  Idx: Integer;
begin
  Result := '';
  Idx := DsgOpenKeep(AFile);
  if Idx < 0 then
    Exit;
  if Idx = FWindowsIndex then
    Result := GetEditorText
  else
    Result := FWindows[Idx].Text;
end;

// Новый текст во вкладку файла. На диск ничего не пишется - до Save.
//
// В активной вкладке заменяется только изменившаяся середина: общее начало
// и общий конец старого и нового текста остаются в контроле. Удаление
// компонента меняет в модуле одну строку поля, а прежняя замена всего
// текста гоняла через RichEdit весь модуль (у Unit1.pas - мегабайты).
procedure TForm1.DsgSetFileText(const AFile, AText: string);
var
  Idx, HeadLen, TailLen, OldLen, NewLen: Integer;
  OldCR, NewCR: string;
begin
  // Вкладку могли закрыть, пока конструктор был открыт - открываем снова
  Idx := DsgOpenKeep(AFile);
  if Idx < 0 then
    Exit;

  if Idx = FWindowsIndex then
  begin
    // Весь текст одной правкой: Undo редактора вернёт его тоже одним шагом.
    // Перерисовка на это время выключена - иначе видно, как текст
    // выделяется целиком и тут же заменяется.
    //
    // Сравнение - в координатах контрола: перевод строки одним CR
    OldCR := GetEditorTextCR;
    // Без Msftedit текст приходит с CRLF - позиции контрола те же, по CR
    OldCR := StringReplace(OldCR, #13#10, #13, [rfReplaceAll]);
    NewCR := StringReplace(AText, #13#10, #13, [rfReplaceAll]);
    NewCR := StringReplace(NewCR, #10, #13, [rfReplaceAll]);
    if NewCR = OldCR then
      Exit;
    OldLen := Length(OldCR);
    NewLen := Length(NewCR);
    HeadLen := 0;
    while (HeadLen < OldLen) and (HeadLen < NewLen) and
          (OldCR[HeadLen + 1] = NewCR[HeadLen + 1]) do
      Inc(HeadLen);
    TailLen := 0;
    while (TailLen < OldLen - HeadLen) and (TailLen < NewLen - HeadLen) and
          (OldCR[OldLen - TailLen] = NewCR[NewLen - TailLen]) do
      Inc(TailLen);
    EditorFreeze;
    try
      RichEdit1.SelStart := HeadLen;
      RichEdit1.SelLength := OldLen - HeadLen - TailLen;
      RichEdit1.SelText := Copy(NewCR, HeadLen + 1,
                                NewLen - HeadLen - TailLen);
    finally
      EditorThaw;
    end;
  end
  else
  begin
    FWindows[Idx].Text := AText;
    FWindows[Idx].Modified := True;
    FWindows[Idx].MapValid := False;
    UpdateTabCaption(Idx);
  end;
end;

// Выделить в дереве инспектора компонент по имени - компоненты .dfm, не
// снимок и не ссылки
procedure TForm1.ObjSelectName(const AName: string);
var
  I: Integer;
  N: TDfmNode;
begin
  if FObjTree = nil then
    Exit;
  for I := 0 to FObjTree.Items.Count - 1 do
  begin
    N := TDfmNode(FObjTree.Items[I].Data);
    if (N <> nil) and not N.IsSnap and not N.IsLink and not N.FromCode and
       (CompareText(N.Name, AName) = 0) then
    begin
      FObjTree.Selected := FObjTree.Items[I];
      FObjTree.Selected.MakeVisible;
      Exit;
    end;
  end;
end;

// Узел по имени компонента - любой, включая созданные в коде (runtime) и
// перенесённые. Ветки над ним раскрываются. False - такого имени нет.
function TForm1.ObjSelectAnyName(const AName: string): Boolean;
var
  I: Integer;
  N: TDfmNode;
  T, P: TTreeNode;
begin
  Result := False;
  if (FObjTree = nil) or (AName = '') then
    Exit;
  T := nil;
  for I := 0 to FObjTree.Items.Count - 1 do
  begin
    N := TDfmNode(FObjTree.Items[I].Data);
    if (N = nil) or N.IsLink then
      Continue;
    if (CompareText(N.Name, AName) <> 0) and
       not ((N.Name = '') and (CompareText(N.VarName, AName) = 0)) then
      Continue;
    T := FObjTree.Items[I];
    if not N.IsSnap then
      Break; // узел .dfm или кода важнее узла снимка
  end;
  if T = nil then
    Exit;

  P := T.Parent;
  while P <> nil do
  begin
    P.Expanded := True;
    P := P.Parent;
  end;
  T.Expanded := True;
  FObjTree.Selected := T;
  T.MakeVisible;
  Result := True;
end;

// Слово под кареткой в редакторе: Button1 в "Button1.Caption := ...".
// '' - каретка не на слове.
function TForm1.IdentAtCaret: string;
var
  P, LineIdx, LineStart, Col, A, B: Integer;
  S: string;
begin
  Result := '';
  P := RichEdit1.SelStart;
  LineIdx := SendMessage(RichEdit1.Handle, EM_LINEFROMCHAR, P, 0);
  if (LineIdx < 0) or (LineIdx >= RichEdit1.Lines.Count) then
    Exit;
  LineStart := SendMessage(RichEdit1.Handle, EM_LINEINDEX, LineIdx, 0);
  S := RichEdit1.Lines[LineIdx];
  Col := P - LineStart + 1;
  if (Col < 1) or (Col > Length(S) + 1) then
    Exit;

  A := Col;
  // Каретка стоит за словом - смотрим знак слева
  if (A > Length(S)) or not (S[A] in ['A'..'Z', 'a'..'z', '0'..'9', '_']) then
    Dec(A);
  if (A < 1) or (A > Length(S)) or
     not (S[A] in ['A'..'Z', 'a'..'z', '0'..'9', '_']) then
    Exit;
  B := A;
  while (A > 1) and (S[A - 1] in ['A'..'Z', 'a'..'z', '0'..'9', '_']) do
    Dec(A);
  while (B < Length(S)) and (S[B + 1] in ['A'..'Z', 'a'..'z', '0'..'9', '_']) do
    Inc(B);
  Result := Copy(S, A, B - A + 1);
  if Result[1] in ['0'..'9'] then
    Result := ''; // число, не имя
end;

// Каретка переехала: если под ней имя компонента из дерева, он там же и
// выделяется, с раскрытием веток. Имени в дереве нет - выделение остаётся
// как было.
procedure TForm1.ObjSyncFromCaret;
var
  Id: string;
begin
  if (FObjTree = nil) or (FObjTree.Items.Count = 0) or FObjRebuilding or
     FDsgSelecting then
    Exit;
  Id := IdentAtCaret;
  if (Id = '') or (CompareText(Id, FObjLastIdent) = 0) then
    Exit;
  FObjLastIdent := Id;
  ObjSelectAnyName(Id);
end;

procedure TForm1.DesignFormClick(Sender: TObject);
var
  Ext, Dfm, Txt, Err: string;
  Prev: Integer;
begin
  // Файл RapidQ - форма из блоков CREATE
  if (FCurrentFileName <> '') and IncludesApply then
  begin
    RqDsgOpen;
    Exit;
  end;
  Ext := LowerCase(ExtractFileExt(FCurrentFileName));
  if IsFormExt(Ext) then
    Dfm := FCurrentFileName
  else if IsPascalExt(Ext) then
    Dfm := FormFileFor(FCurrentFileName)
  else
    Dfm := '';
  if Dfm = '' then
  begin
    ShowMessage('20628:У активного файла нет формы. Откройте модуль формы или ' +
    'её .dfm.');
                Exit;
  end;

  // Двоичная форма при открытии во вкладку сама переводится в текст
  // (LoadTextFile), так что конструктор работает и с ней
  if WindowOfFile(Dfm) < 0 then
  begin
    // Текст формы должен жить во вкладке - открываем, но остаёмся там, где
    // работали
    Prev := FWindowsIndex;
    OpenNamedFile(Dfm);
    if (Prev >= 0) and (Prev <> FWindowsIndex) and FWindows[Prev].Used then
      ActivateWindow(Prev);
  end;

  // Свой снимок снят до того, как у формы изменился состав (окно настроек
  // построило контролы при первом открытии) - дерево по нему устарело, а
  // конструктор ставит компоненты из кода по дереву. Перестроить сначала.
  if not FSnapOff and IsOwnProject and (FObjFormClass <> '') and
     OwnSnapStale(FObjFormClass) then
    RefreshObjectInspector(True)
    // Дерево инспектора - от другой формы: справа открыта не вкладка
    // Objects, и при переходе на эту форму оно не строилось. Строим - вместе
    // со снимком (для окна настроек TakeOwnSnap сначала его построит).
  else if CompareText(FObjDfmFile, Dfm) <> 0 then
    RefreshObjectInspector(True);

  FDsgDfm := Dfm;
  Txt := DsgGetText;
  if DfmBinaryKind(Txt) <> 0 then
  begin
    // Перевод при открытии не удался - во вкладке остались байты
    ShowMessage('20662:Двоичную форму не удалось перевести в текст - ' +
    'конструктору нужен текст .dfm.');
                Exit;
  end;

  if FDesigner = nil then
    FDesigner := DsgNewDesigner;
  // Спрятанный второй вид - от прежней формы или прежнего текста
  DsgFreeOther;
  FDsgUndo.Clear;
  FDsgUndoPas.Clear;

  // Форма строится невидимой и показывается уже в цветах темы и с
  // компонентами из кода (DsgAddRuntime): без мелькания цвета из .dfm
  if FDesigner.Load(Txt, Err, True) then
  begin
    DsgAddRuntime;
    FDesigner.ShowForm;
  end
  else
  begin
    ShowMessage('20686:Форму не удалось построить:'#13#10 + Err);
    FreeAndNil(FDesigner);
    DsgPaletteReset;
  end;
end;

// Конструктор форм с обработчиками главного окна
function TForm1.DsgNewDesigner: TFormDesigner;
begin
  Result := TFormDesigner.Create;
  Result.OnSelect := DsgSelect;
  Result.OnChange := DsgChange;
  Result.OnKey := DsgKey;
  Result.OnClose := DsgClose;
  Result.OnPlace := DsgPlace;
  Result.OnDblClick := DsgDblClick;
  Result.OnContext := DsgContext;
  Result.OnPageChange := DsgPageChange;
  Result.OnBatch := DsgBatch;
  Result.OnGroupChange := DsgGroupChange;
  Result.OnMapClass := DsgMapClass;
  Result.ForeignColor := UiColor('Dsg.Foreign');
  EnvApplyDesigner(Result);   // IDE Options - Designer
end;

// По чему построена форма конструктора: текст .dfm, номер снимка, режим
// темы IDE. Совпал у спрятанного второго вида - он годится как есть.
function TForm1.DsgViewKeyOf(const AText: string): string;
begin
  Result := FDsgDfm + '|' + IntToHex(Crc32Of(AText), 8) + ':' +
            IntToStr(Length(AText)) + '|' + IntToStr(FObjSnapGen) + '|' +
            IntToStr(FIdeMode);
end;

function TForm1.DsgViewKey: string;
begin
  Result := DsgViewKeyOf(DsgGetText);
end;

// Спрятанный второй вид больше не нужен: другая форма, закрытие
// конструктора, смена проекта
procedure TForm1.DsgFreeOther;
begin
  if FDsgOtherTimer <> nil then
    FDsgOtherTimer.Enabled := False;
  FreeAndNil(FDsgOther);
  FreeAndNil(FDsgOtherMade);
  FreeAndNil(FDsgOtherGlyph);
  FDsgOtherKey := '';
end;

// ---------------------------------------------------------------------------
//  Два вида формы в конструкторе: live look и .dfm look
//
//  Две формы (два TFormDesigner): видимая - FDesigner, спрятанная другого
//  вида - FDsgOther. Переключение - спрятанную показать, видимую спрятать
//  (DsgSwitchView). Правки видимой сразу переносятся в спрятанную:
//    - свойства (перенос и размер мышью, инспектор, группа) - тем же
//      свойством ей (DsgOtherSync);
//    - остальное (добавление, удаление, вставка, откат - видимая строится
//      заново) - спрятанная строится заново невидимой, когда программа
//      ничем не занята (DsgOtherLater, через 1,5 с после правки).
//  FDsgOtherKey - по какому тексту .dfm построена спрятанная; не совпал с
//  нынешним при переключении - строится заново перед показом.
//  Вторая форма появляется при первом переключении вида.
// ---------------------------------------------------------------------------

// Видимая <-> спрятанная: вместе с формой - и её списки (компоненты из кода,
// скопированные значки) и вид. Всё остальное работает с FDesigner.
procedure TForm1.DsgSwapOther;
var
  TmpDsg: TFormDesigner;
  TmpMade: TStringList;
  TmpGlyph: TList;
begin
  TmpDsg := FDesigner;
  FDesigner := FDsgOther;
  FDsgOther := TmpDsg;
  TmpMade := FDsgMade;
  FDsgMade := FDsgOtherMade;
  FDsgOtherMade := TmpMade;
  TmpGlyph := FDsgGlyphCopied;
  FDsgGlyphCopied := FDsgOtherGlyph;
  FDsgOtherGlyph := TmpGlyph;
  FDsgLiveView := not FDsgLiveView;
end;

// Построить спрятанную форму другого вида по нынешнему тексту - невидимой.
// Видимая при этом не меняется.
function TForm1.DsgBuildOther: Boolean;
var
  Err: string;
  T0: Cardinal;
begin
  Result := False;
  if (FDesigner = nil) or (FDesigner.Form = nil) then
    Exit;
  T0 := GetTickCount;
  if FDsgOther = nil then
    FDsgOther := DsgNewDesigner;
  if FDsgOtherMade = nil then
    FDsgOtherMade := TStringList.Create;
  DsgSwapOther;               // строим как текущую: DsgAddRuntime - с FDesigner
  try
    Result := FDesigner.Load(DsgGetText, Err, True);
    if Result then
    begin
      DsgAddRuntime;
      FDesigner.DropOldForm;  // прежняя спрятанная - больше не нужна
    end;
  finally
    DsgSwapOther;
  end;
  if Result then
  begin
    FDsgOtherKey := DsgViewKey;
    Dbg('22991: конструктор: второй вид формы построен, ' +
        IntToStr(GetTickCount - T0) + ' мс', clGray);
  end
  else
  begin
    FDsgOtherKey := '';
    Dbg('22990: второй вид формы не удалось построить: ' + Err, clRed);
  end;
end;

// Правка свойств видимой формы - та же спрятанной. Только если спрятанная
// была по тексту до правки: тогда после неё она - по тексту после. Иначе
// (уже отстала) - её перестроит DsgOtherLater или переключение.
procedure TForm1.DsgOtherSync(const AOldText, ANewText, AName: string;
                              AProps: TStrings);
var
  PropIdx: Integer;
  Ok: Boolean;
begin
  if (FDsgOther = nil) or (FDsgOther.Form = nil) or (AProps = nil) or
     (FDsgOtherKey <> DsgViewKeyOf(AOldText)) then
    Exit;
  Ok := True;
  for PropIdx := 0 to AProps.Count - 1 do
    if not FDsgOther.SetPropText(AName, AProps.Names[PropIdx],
                                 Copy(AProps[PropIdx], Length(AProps.Names[PropIdx]) + 2, MaxInt)) then
      Ok := False;
  if Ok then
    FDsgOtherKey := DsgViewKeyOf(ANewText)
  else
    DsgOtherLater;
end;

procedure TForm1.DsgOtherSyncProp(const AOldText, AName, AProp, ARaw: string);
var
  One: TStringList;
begin
  if FDsgOther = nil then
    Exit;
  One := TStringList.Create;
  try
    One.Add(AProp + '=' + ARaw);
    DsgOtherSync(AOldText, DsgGetText, AName, One);
  finally
    One.Free;
  end;
end;

// Спрятанная отстала (видимую построили заново) - перестроить её, когда
// правки на время прекратятся
procedure TForm1.DsgOtherLater;
begin
  if FDsgOther = nil then
    Exit;
  if FDsgOtherTimer = nil then
  begin
    FDsgOtherTimer := TTimer.Create(Self);
    FDsgOtherTimer.Enabled := False;
    FDsgOtherTimer.Interval := 1500;
    FDsgOtherTimer.OnTimer := DsgOtherTimerTick;
  end;
  FDsgOtherTimer.Enabled := False;   // отсчёт - заново от последней правки
  FDsgOtherTimer.Enabled := True;
end;

procedure TForm1.DsgOtherTimerTick(Sender: TObject);
begin
  // Идёт работа (правка в инспекторе, сборка, мышь держат) - позже
  if FObjEditing or (FBusyDepth > 0) or (GetKeyState(VK_LBUTTON) < 0) then
    Exit;
  FDsgOtherTimer.Enabled := False;
  if (FDsgOther = nil) or (FDesigner = nil) or (FDesigner.Form = nil) or
     (FDsgOtherKey = DsgViewKey) then
    Exit;
  DsgBuildOther;
end;

// Переключение вида: спрятанная форма показывается на месте видимой,
// видимая прячется. Спрятанной ещё нет или она отстала - сначала строится
// (невидимой).
procedure TForm1.DsgSwitchView;
var
  OldDsg: TFormDesigner;
  SelName: string;
  WasVisible: Boolean;
  PosLeft, PosTop: Integer;
begin
  if (FDesigner = nil) or (FDesigner.Form = nil) then
  begin
    FDsgLiveView := not FDsgLiveView;
    Exit;
  end;
  if FDsgOtherTimer <> nil then
    FDsgOtherTimer.Enabled := False;
  if (FDsgOther = nil) or (FDsgOther.Form = nil) or
     (FDsgOtherKey <> DsgViewKey) then
  begin
    if not DsgBuildOther then
    begin
      ShowMessage('22993:Второй вид формы не удалось построить - остаётся ' +
      'этот. Подробности - в HiLite log.');
                  Exit;
    end;
  end
  else
    Dbg('22992: конструктор: второй вид формы - готовый', clGray);

  OldDsg := FDesigner;
  WasVisible := OldDsg.Form.Visible;
  SelName := OldDsg.SelectedName;
  PosLeft := OldDsg.Form.Left;
  PosTop := OldDsg.Form.Top;
  DsgSwapOther;
  // Прежняя видимая построена по нынешнему тексту - это теперь спрятанная
  FDsgOtherKey := DsgViewKey;

  // Всё, что меняет вид формы (выделение и маркеры, кнопки палитры по
  // вкладкам), - до показа: показ (ShowForm) выводит форму уже
  // нарисованной, а прежняя прячется после этого
  FDesigner.Form.Left := PosLeft;
  FDesigner.Form.Top := PosTop;
  DsgPaletteTabs;
  FDesigner.SelectByName(SelName);
  if WasVisible then
    FDesigner.ShowForm;
  OldDsg.Form.Hide;
end;

// Папка Bin установки Delphi для значков палитры - по реестру, как у
// сборки (FindDelphiRoots), с предпочтением Delphi 7. '' - не нашлась:
// палитра будет с именами классов вместо значков.
function TForm1.DsgDelphiBin: string;
var
  Found: TStringList;
  I: Integer;
begin
  Result := '';
  Found := TStringList.Create;
  try
    if FindDelphiRoots(Found) > 0 then
    begin
      I := Found.IndexOfName('Delphi 7');
      if I < 0 then
        I := 0;
      Result := Copy(Found[I], Pos('=', Found[I]) + 1, MaxInt);
    end;
  finally
    Found.Free;
  end;
  if Result <> '' then
    Result := IncludeTrailingPathDelimiter(Result) + 'Bin\';
end;

// Выбор на палитре - имя класса в заголовке группы
procedure TForm1.DsgPaletteSelect(Sender: TObject);
begin
  if grpPalette = nil then
    Exit;
  if RqPalSelected <> '' then
    grpPalette.Caption := 'Components - ' + RqPalSelected + ' (RapidQ)'
  else if FDsgPalette.SelectedForeign <> '' then
    grpPalette.Caption := 'Components - ' +
      Copy(FDsgPalette.SelectedForeign,
           Pos('.', FDsgPalette.SelectedForeign) + 1, MaxInt) + ' (сторонний)'
  else if FDsgPalette.SelectedClass = nil then
    grpPalette.Caption := 'Components'
  else
    grpPalette.Caption := 'Components - ' + FDsgPalette.SelectedClass.ClassName;
end;

// Узел лежит в отдельном дереве снимка (под узлом «снимок ...»)
function InSnapTree(N: TDfmNode): Boolean;
begin
  Result := False;
  while N <> nil do
  begin
    if N.SnapRoot then
    begin
      Result := True;
      Exit;
    end;
    N := N.Parent;
  end;
end;

// Компоненты, созданные в коде модуля, - на форму конструктора, только для
// просмотра: чтобы форма выглядела так, как в работе, а не пустой.
// Берутся из дерева инспектора, если оно построено для этой же формы.
// Порядок узлов дерева - сначала родитель, потом дети, так что родитель
// к моменту ребёнка уже на форме. Свойства - как записаны в коде или взяты
// из снимка; выражения, которые не разобрать, пропускаются.
// Место узла в дереве: номера среди братьев от верхнего уровня, через "/".
// По нему компонент конструктора находит свой узел и после перестройки
// дерева с тем же составом.
function TreeNodePath(T: TTreeNode): string;
begin
  Result := '';
  while T <> nil do
  begin
    Result := '/' + IntToStr(T.Index) + Result;
    T := T.Parent;
  end;
end;

// Узел по месту (TreeNodePath); nil - такого места в дереве нет
function TreeNodeAtPath(ATree: TTreeView; const APath: string): TTreeNode;
var
  S, Part: string;
  P, K, I: Integer;
begin
  Result := nil;
  S := APath;
  while S <> '' do
  begin
    if S[1] = '/' then
      Delete(S, 1, 1);
    P := Pos('/', S);
    if P = 0 then
    begin
      Part := S;
      S := '';
    end
    else
    begin
      Part := Copy(S, 1, P - 1);
      Delete(S, 1, P - 1);
    end;
    K := StrToIntDef(Part, -1);
    if K < 0 then
    begin
      Result := nil;
      Exit;
    end;
    if Result = nil then
    begin
      Result := ATree.Items.GetFirstNode;
      for I := 1 to K do
        if Result <> nil then
          Result := Result.getNextSibling;
    end
    else if K < Result.Count then
      Result := Result.Item[K]
    else
      Result := nil;
    if Result = nil then
      Exit;
  end;
end;

// Узел и компонент - одна пара из AMade: класс узла совпадает с классом
// компонента (или компонент - заглушка неизвестного класса). Дерево могли
// перестроить с другим составом - тогда по старому месту стоит чужой узел.
function DsgMadeMatch(T: TTreeNode; C: TComponent): Boolean;
var
  N: TDfmNode;
begin
  Result := False;
  if (T = nil) or (C = nil) or (T.Data = nil) then
    Exit;
  N := TDfmNode(T.Data);
  Result := (CompareText(N.ClassNm, C.ClassName) = 0) or (C is TDsgStub);
end;

// Узел дерева компонента, поставленного DsgAddRuntime; nil - не из них
function DsgMadeNode(AMade: TStringList; ATree: TTreeView;
                     C: TComponent): TTreeNode;
var
  I: Integer;
begin
  Result := nil;
  if (AMade = nil) or (ATree = nil) or (C = nil) then
    Exit;
  I := AMade.IndexOfName(IntToHex(Integer(C), 8));
  if I < 0 then
    Exit;
  Result := TreeNodeAtPath(ATree,
                           Copy(AMade[I], Pos('=', AMade[I]) + 1, MaxInt));
  if not DsgMadeMatch(Result, C) then
    Result := nil;
end;

// Компонент конструктора, поставленный DsgAddRuntime по узлу T; nil - нет
function DsgMadeComp(AMade: TStringList; T: TTreeNode): TComponent;
var
  I: Integer;
  Path: string;
begin
  Result := nil;
  if (AMade = nil) or (T = nil) then
    Exit;
  Path := TreeNodePath(T);
  for I := 0 to AMade.Count - 1 do
    if Copy(AMade[I], Pos('=', AMade[I]) + 1, MaxInt) = Path then
    begin
      Result := TComponent(AMade.Objects[I]);
      Break;
    end;
  if not DsgMadeMatch(T, Result) then
    Result := nil;
end;

procedure TForm1.DsgAddRuntime;
var
  I, J, K: Integer;
  N: TDfmNode;
  Props, Made: TStringList;
  Nm, ParNm, Val: string;
  ParComp: TComponent;
  T0, TFin, TTheme, TLive, TickMark: Cardinal;
  Cnt: Integer;
  LinkMoves: string;   // переставленные по коду компоненты .dfm - для журнала
begin
  T0 := GetTickCount;
  LinkMoves := '';
  TTheme := 0;
  TLive := 0;
  Cnt := 0;
  // Форма конструктора построена заново - прежних компонентов нет
  if FDsgMade <> nil then
    FDsgMade.Clear;
  if FDsgGlyphCopied <> nil then
    FDsgGlyphCopied.Clear;
  if (FDesigner = nil) or (FDesigner.Form = nil) or (FObjTree = nil) then
    Exit;
  if CompareText(FObjFormClass, DfmRootClass(DsgGetText)) <> 0 then
    Exit; // дерево от другой формы

  Props := TStringList.Create;
  // Узел дерева -> созданный по нему компонент: так ребёнок находит
  // родителя и без имени (вкладки палитры внутри TDsgPalette созданы в
  // чужом модуле, переменных у них в разборе нет)
  Made := TStringList.Create;
  Made.Sorted := True;
  // Серия: форма конструктора не перерисовывается и не пересчитывает
  // раскладку на каждое свойство - один раз в FinishRuntime
  FDesigner.BeginRuntime;
  TFin := 0;
  try
    Dbg('20777: DsgAddRuntime: узлов в дереве ' + IntToStr(FObjTree.Items.Count),
        clNavy);
    for I := 0 to FObjTree.Items.Count - 1 do
    begin
      N := TDfmNode(FObjTree.Items[I].Data);
      // Отдельное дерево снимка (узел «снимок ...») - не часть формы. А
      // узлы снимка, приставшие к форме (IsRuntime: код их не распознал,
      // но они живые - например, кнопки из помощника), ставим: их места
      // известны из снимка.
      if (N = nil) or InSnapTree(N) then
        Continue;

      ParNm := '';
      if N.Parent <> nil then
      begin
        ParNm := N.Parent.Name;
        if ParNm = '' then
          ParNm := N.Parent.VarName;
      end;

      // Компонент .dfm, которому код меняет родителя: переставить туда же
      if N.IsLink then
      begin
        FDesigner.Reparent(N.Name, ParNm);
        if LinkMoves <> '' then
          LinkMoves := LinkMoves + ', ';
        LinkMoves := LinkMoves + N.Name + ' -> ' + ParNm;
        Continue;
      end;
      if not (N.FromCode or N.IsRuntime) then
        Continue;

      // Кнопки TRadioGroup из снимка не ставим: конструктор создаёт
      // TRadioGroup по .dfm, и тот сам строит свои кнопки по Items. Вторые,
      // из снимка, легли бы поверх заглушками неизвестного класса.
      if (CompareText(N.ClassNm, 'TGroupButton') = 0) or
         (CompareText(N.ClassNm, 'TUiGroupButton') = 0) then
        Continue;

      // Под служебной веткой «(родитель не определён)» - ставить некуда:
      // у этой ветки нет своего родителя, и без проверки её дети легли бы
      // прямо на форму
      if (N.Parent <> nil) and (Copy(N.Parent.ClassNm, 1, 1) = '(') then
      begin
        Dbg('20817: runtime ' + N.VarName + ' ' + N.ClassNm +
        ': родитель не определён - пропущен', clGray);
            Continue;
      end;

      // Родитель уже создан здесь по своему узлу - берём его самого
      ParComp := nil;
      if (N.Parent <> nil) and (N.Parent.Parent <> nil) then
      begin
        K := Made.IndexOf(IntToHex(Integer(N.Parent), 8));
        if K >= 0 then
          ParComp := TComponent(Made.Objects[K]);
      end;

      // Родитель есть, но безымянный, не корень и здесь не создан - это
      // ветка «родитель не определён»: ставить некуда
      if (ParComp = nil) and (N.Parent <> nil) and (N.Parent.Parent <> nil) and
         (ParNm = '') then
      begin
        Dbg('20836: runtime ' + N.VarName + ' ' + N.ClassNm +
        ': родитель не определён - пропущен', clGray);
            Continue;
      end;

      Nm := N.Name;
      if Nm = '' then
        Nm := N.VarName;

      Props.Clear;
      for J := 0 to N.PropN.Count - 1 do
      begin
        if J < N.PropRaw.Count then
          Val := N.PropRaw[J]
        else
          Val := N.PropV[J];
        Props.Add(N.PropN[J] + '=' + Val);
      end;
      FDesigner.RuntimeParent := ParComp;
      try
        FDesigner.AddRuntime(Nm, N.ClassNm, ParNm, Props);
      finally
        FDesigner.RuntimeParent := nil;
      end;
      if FDesigner.LastRuntime <> nil then
      begin
        Made.AddObject(IntToHex(Integer(N), 8), FDesigner.LastRuntime);
        if FDsgMade <> nil then
          FDsgMade.AddObject(IntToHex(Integer(FDesigner.LastRuntime), 8) +
          '=' + TreeNodePath(FObjTree.Items[I]),
                             FDesigner.LastRuntime);
        Inc(Cnt);
      end;
    end;
    // Своя форма - в цветах темы IDE, затем в живом виде; внутри серии:
    // раскладка - один раз
    if LinkMoves <> '' then
      Dbg('22025: DsgAddRuntime: родитель по коду - ' + LinkMoves, clGray);
    TickMark := GetTickCount;
    DsgThemeLook;
    TTheme := GetTickCount - TickMark;
    TickMark := GetTickCount;
    DsgLiveLook;
    TLive := GetTickCount - TickMark;
  finally
    // И при ошибке: без него форма конструктора осталась бы без
    // перерисовки и выравнивания
    TFin := GetTickCount;
    FDesigner.FinishRuntime;
    DsgMirrorBuffering;
    TFin := GetTickCount - TFin;
    Made.Free;
    Props.Free;
  end;
  // Одна строка итога: построчный журнал каждого компонента и свойства -
  // только при DsgLogVerbose (FormDesigner)
  Dbg('20877: DsgAddRuntime: готово, компонентов ' + IntToStr(Cnt) + ', ' +
      IntToStr(GetTickCount - T0) + ' мс (из них цвета темы ' +
      IntToStr(TTheme) + ', живой вид ' + IntToStr(TLive) +
  ', раскладка в конце ' + IntToStr(TFin) + ')', clNavy);
      DsgPaletteTabs;
end;

// ---------------------------------------------------------------------------
//  Своя форма редактора в конструкторе - в живом виде
//
//  Любая своя форма, у которой есть живой экземпляр: главное окно, окно
//  настроек и другие (OwnLiveForm).
//  Конструктор строит форму из .dfm вкладки. Часть вида при запуске задаёт
//  код: тёмную тему (UiApplyForm), места панели поиска (BuildSearchPanel),
//  значки кнопок, видимость. Что именно задал код, видно по сравнению двух
//  текстов одной и той же формы:
//    - .dfm, из которого собран работающий exe, - ресурс с именем класса
//      формы в самом exe: TFORM1, TFORM2 (OwnFormResText);
//    - снимок живой формы (FormSnapshot) - какие значения стали после кода.
//  Свойство, у которого они расходятся, задал код: в конструкторе оно
//  берётся из снимка. Остальные остаются как в .dfm вкладки - в том числе
//  только что поправленные, ещё не собранные.
//
//  Место и размер, которые задал код, в конструкторе не меняются - по
//  отдельности: у cmbScope код ставит Left, а Top - из .dfm, и тянуть его
//  можно вверх и вниз (FDesigner.MarkCodePlaced, буквы L T W H).
//
//  Значков в снимке нет: у кнопки без значка он берётся у живой кнопки с тем
//  же именем, иначе плоская кнопка не видна.
//
//  В .dfm ничего не пишется. Выключается в меню конструктора (Show .dfm
//  values, FDsgLiveView). Вызывается из DsgAddRuntime внутри серии
//  AddRuntime: раскладка пересчитается один раз, в FinishRuntime.
// ---------------------------------------------------------------------------

// Текст .dfm своей формы класса AClass, из которого собран работающий exe:
// ресурс RCDATA с именем класса. Exe за время работы не меняется - каждая
// форма читается один раз.
function TForm1.OwnFormResText(const AClass: string): string;
var
  ResName: string;
  Res: TResourceStream;
  Txt: TStringStream;
  K: Integer;
  PT: TProbeText;
begin
  Result := '';
  if FDsgResTexts = nil then
    FDsgResTexts := TStringList.Create;
  K := FDsgResTexts.IndexOf(AClass);
  if K >= 0 then
  begin
    Result := TProbeText(FDsgResTexts.Objects[K]).Text;
    Exit;
  end;
  ResName := UpperCase(AClass);
  if (ResName = '') or
     (FindResource(HInstance, PChar(ResName), RT_RCDATA) = 0) then
    Exit;
  Res := TResourceStream.Create(HInstance, ResName, RT_RCDATA);
  Txt := TStringStream.Create('');
  try
    ObjectBinaryToText(Res, Txt);
    Result := Txt.DataString;
  finally
    Txt.Free;
    Res.Free;
  end;
  PT := TProbeText.Create;
  PT.Text := Result;
  FDsgResTexts.AddObject(AClass, PT);
end;

// Имена компонентов в тексте .dfm: строки "object Имя: Класс" (и
// inherited, inline). Без разбора в узлы - только имена.
procedure DfmCollectNames(const AText: string; ANames: TStringList);
var
  Lines: TStringList;
  LineIdx, Colon, Space: Integer;
  Line: string;
begin
  Lines := TStringList.Create;
  try
    Lines.Text := AText;
    for LineIdx := 0 to Lines.Count - 1 do
    begin
      Line := Trim(Lines[LineIdx]);
      Space := Pos(' ', Line);
      if Space = 0 then
        Continue;
      if (CompareText(Copy(Line, 1, Space - 1), 'object') <> 0) and
         (CompareText(Copy(Line, 1, Space - 1), 'inherited') <> 0) and
         (CompareText(Copy(Line, 1, Space - 1), 'inline') <> 0) then
        Continue;
      Colon := Pos(':', Line);
      if Colon <= Space then
        Continue;
      Line := Trim(Copy(Line, Space + 1, Colon - Space - 1));
      if IsValidIdent(Line) then
        ANames.Add(Line);
    end;
  finally
    Lines.Free;
  end;
end;

// Имена, которые были в .dfm формы AClass при сборке работающего exe
// (OwnFormResText), а в тексте ADfmText их нет: вырезаны, удалены или
// переименованы в конструкторе. Только у своей формы с живым экземпляром -
// у формы чужого проекта с тем же именем класса ресурс exe не её.
procedure TForm1.OwnFormGoneNames(const AClass, ADfmText: string;
                                  AGone: TStrings);
var
  BuiltNames, NowNames: TStringList;
  NameIdx: Integer;
begin
  AGone.Clear;
  if not IsOwnProject or (OwnLiveForm(AClass) = nil) then
    Exit;
  BuiltNames := TStringList.Create;
  NowNames := TStringList.Create;
  try
    DfmCollectNames(OwnFormResText(AClass), BuiltNames);
    NowNames.Sorted := True;
    NowNames.Duplicates := dupIgnore;
    NowNames.CaseSensitive := False;
    DfmCollectNames(ADfmText, NowNames);
    for NameIdx := 0 to BuiltNames.Count - 1 do
      if NowNames.IndexOf(BuiltNames[NameIdx]) < 0 then
        AGone.Add(BuiltNames[NameIdx]);
  finally
    NowNames.Free;
    BuiltNames.Free;
  end;
  if AGone.Count > 0 then
    Dbg('21430: ' + AClass + ': убраны из .dfm после сборки exe - ' +
        IntToStr(AGone.Count) + ' (' + Copy(StringReplace(AGone.CommaText,
    ',', ', ', [rfReplaceAll]), 1, 200) + ')', clGray);
end;

// Значение свойства из записи .dfm - в виде для сравнения: строки
// расшифрованы (#1053 и буква - одно и то же), числа и цвета - числом
// (15790320 и $00F0F0F0, clBtnFace и его код), в наборах и списках без
// пробелов, остальное прописными
function DsgNormValue(const AValue: string): string;
var
  T: string;
  N: Integer;
  C: Longint;
begin
  T := Trim(AValue);
  Result := '';
  if T = '' then
    Exit;
  case T[1] of
    '''', '#':
    Result := 'S' + DecodeDfmString(T);
    '[', '(':
    Result := UpperCase(StringReplace(T, ' ', '', [rfReplaceAll]));
  else
    if TryStrToInt(T, N) then
      Result := 'N' + IntToStr(N)
    else if IdentToColor(T, C) then
      Result := 'N' + IntToStr(C)
    else if IdentToCursor(T, C) then
      Result := 'N' + IntToStr(C)
    else
      Result := UpperCase(T);
  end;
end;

// Значение свойства ANm у узла AN - как записано; нет строки - умолчание
// класса (ADefs), нет и его - ''
function DsgNodeValue(AN: TDfmNode; const ANm: string;
                      ADefs: TStrings): string;
var
  K: Integer;
begin
  K := AN.PropN.IndexOf(ANm);
  if (K >= 0) and (K < AN.PropRaw.Count) then
    Result := AN.PropRaw[K]
  else if ADefs <> nil then
    Result := ADefs.Values[ANm]
  else
    Result := '';
end;

// Узлы с именами - в список "имя -> узел" для поиска
procedure DsgIndexNodes(ANodes: TList; AIndex: TStringList);
var
  I: Integer;
  N: TDfmNode;
begin
  AIndex.Sorted := True;
  AIndex.Duplicates := dupIgnore;
  AIndex.CaseSensitive := False;
  for I := 0 to ANodes.Count - 1 do
  begin
    N := TDfmNode(ANodes[I]);
    if N.Name <> '' then
      AIndex.AddObject(N.Name, N);
  end;
end;

// Координата AProp (Left, Top, Width, Height) контрола C - своя, а не от
// родителя: у выровненного своя только свободная сторона, у прижатого к
// правому (нижнему) краю Left (Top) и растянутого Width (Height) - от
// размера родителя, а он в конструкторе другой
function DsgOwnBound(C: TControl; const AProp: string): Boolean;
var
  A: TAnchors;
begin
  Result := False;
  A := C.Anchors;
  case C.Align of
    alNone:
      if AProp = 'Left' then
      Result := not ((akRight in A) and not (akLeft in A))
    else if AProp = 'Width' then
      Result := not ((akLeft in A) and (akRight in A))
    else if AProp = 'Top' then
      Result := not ((akBottom in A) and not (akTop in A))
    else if AProp = 'Height' then
      Result := not ((akTop in A) and (akBottom in A));
    alTop, alBottom:
      Result := AProp = 'Height';
    alLeft, alRight:
      Result := AProp = 'Width';
  end;
end;

// Контрол, которому живая форма ставит свои полосы прокрутки
// (UiPaintControl): список, дерево, таблица, мемо или лог, прокручиваемая
// панель
function DsgNeedsUiScroll(C: TControl): Boolean;
begin
  Result := (C is TCustomTreeView) or (C is TCustomListView) or
            (C is TCustomListBox) or (C is TCustomGrid) or
            (C is TCustomMemo) or (C is TScrollBox);
end;

// У таблицы тема выключила сетку Windows и рисует линии сама (UiListGrid)
function DsgHasGridMark(ALV: TListView): Boolean;
var
  K: Integer;
begin
  Result := False;
  for K := 0 to ALV.ComponentCount - 1 do
    if ALV.Components[K] is TUiGridMark then
    begin
      Result := True;
      Exit;
    end;
end;

// Раскрытые узлы - как у живого дерева того же состава
procedure DsgCopyExpanded(ADst, ASrc: TTreeView);
var
  D, S: TTreeNode;
begin
  D := ADst.Items.GetFirstNode;
  S := ASrc.Items.GetFirstNode;
  while (D <> nil) and (S <> nil) do
  begin
    if S.Expanded and D.HasChildren then
      D.Expanded := True;
    D := D.GetNext;
    S := S.GetNext;
  end;
end;

// Сверки живого вида - прочь (другой снимок, конец работы)
procedure TForm1.DsgLiveDiffClear;
var
  Idx: Integer;
begin
  FDsgLiveDiffKey := '';
  if FDsgLiveDiff = nil then
    Exit;
  for Idx := 0 to FDsgLiveDiff.Count - 1 do
    FDsgLiveDiff.Objects[Idx].Free;
  FDsgLiveDiff.Clear;
end;

procedure TForm1.DsgLiveLook;
const
  // Строк таблицы или узлов дерева больше - не копируются: это содержимое,
  // а не вид, и копия заметно тормозила бы построение формы
  DsgItemsMax = 2000;
  BoundNames: array[0..3] of string = ('Left', 'Top', 'Width', 'Height');
var
  LF: TCustomForm;
  I, J, Comps, Props, Placed, Glyphs, Scrolls, Lists, Grids: Integer;
  C, L: TComponent;
  DC, LC: TControl;
  ResTxt, SnapTxt, Nm, SV, Sides: string;
  ResNodes, SnapNodes, TabNodes: TList;
  ResIdx, SnapIdx, TabIdx, Names: TStringList;
  Defs: TStringList;
  ResRoot, SnapRoot, TabRoot, TabNode: TDfmNode;
  SameParent: Boolean;
  TickStart, TickSnap, TickParsed, TickComps: Cardinal;
  TickPart, TGlyphs, TLists: Cardinal;
  Parsed: Boolean;
  DiffKey, Entry, NormRV: string;
  Entries: TStringList;
  SepPos, Computed: Integer;

  // Снимок и ресурс - в узлы, один раз и только если нужны (сверка
  // компонента, которого ещё нет в FDsgLiveDiff)
  procedure EnsureParsed;
  begin
    if Parsed then
      Exit;
    Parsed := True;
    ResRoot := ParseDfmNodes(ResTxt, False, ResNodes);
    SnapRoot := ParseDfmNodes(SnapTxt, True, SnapNodes);
    DsgIndexNodes(ResNodes, ResIdx);
    DsgIndexNodes(SnapNodes, SnapIdx);
  end;

// Расхождения снимка с ресурсом у компонента AName (LC - живой): из
// FDsgLiveDiff, нет там - сверка и запись туда. nil - компонента нет в
// снимке или в ресурсе (создан кодом или добавлен после сборки).
  function DiffFor(const AName: string; ALive: TControl): TStringList;
  var
    Pos0, PropIdx: Integer;
    SnapNode, ResNode: TDfmNode;
    PropName, SnapVal, ResVal: string;
    ClassDefs, Seen: TStringList;
  begin
    Pos0 := FDsgLiveDiff.IndexOf(AName);
    if Pos0 >= 0 then
    begin
      Result := TStringList(FDsgLiveDiff.Objects[Pos0]);
      Exit;
    end;
    Result := nil;
    Inc(Computed);
    EnsureParsed;
    Pos0 := SnapIdx.IndexOf(AName);
    if Pos0 >= 0 then
    begin
      SnapNode := TDfmNode(SnapIdx.Objects[Pos0]);
      Pos0 := ResIdx.IndexOf(AName);
      if Pos0 >= 0 then
      begin
        ResNode := TDfmNode(ResIdx.Objects[Pos0]);
        ClassDefs := DefaultsFor(ALive.ClassType);
        // Свойства снимка (в нём все) и ресурса - в порядке снимка, как
        // их и ставили раньше: порядок бывает важен (Items до ItemIndex)
        Names.Clear;
        Names.AddStrings(SnapNode.PropN);
        Seen := TStringList.Create;
        try
          Seen.Sorted := True;
          Seen.Duplicates := dupIgnore;
          Seen.AddStrings(SnapNode.PropN);
          for PropIdx := 0 to ResNode.PropN.Count - 1 do
            if Seen.IndexOf(ResNode.PropN[PropIdx]) < 0 then
            begin
              Seen.Add(ResNode.PropN[PropIdx]);
              Names.Add(ResNode.PropN[PropIdx]);
            end;
        finally
          Seen.Free;
        end;
        Result := TStringList.Create;
        for PropIdx := 0 to Names.Count - 1 do
        begin
          PropName := Names[PropIdx];
          // Имя - в заголовке; размер клиентской части следует из
          // размера; картинки в снимке - только их размеры
          if (PropName = 'Name') or (PropName = 'ClientWidth') or
             (PropName = 'ClientHeight') or
             (Copy(PropName, 1, 6) = 'Glyph.') or
             (Copy(PropName, 1, 8) = 'Picture.') then
            Continue;
          SnapVal := DsgNodeValue(SnapNode, PropName, ClassDefs);
          ResVal := DsgNormValue(DsgNodeValue(ResNode, PropName, ClassDefs));
          if (SnapVal = '') or (DsgNormValue(SnapVal) = ResVal) then
            Continue;
          // Заглушки снимка вместо содержимого: текст богатого редактора,
          // длинный список, коллекция
          if Copy(SnapVal, 1, 2) = '''(' then
            Continue;
          Result.Add(PropName + #1 + SnapVal + #1 + ResVal);
        end;
      end;
    end;
    FDsgLiveDiff.AddObject(AName, Result);
  end;

begin
  if (FDesigner = nil) or (FDesigner.Form = nil) or not FDsgLiveView or
     not IsOwnProject then
    Exit;
  // Живая форма того же класса: главное окно, окно настроек и другие.
  // Окна, которое ещё ни разу не строилось, нет - вид по .dfm.
  LF := OwnLiveForm(FObjFormClass);
  if (LF = nil) or
     (CompareText(LF.ClassName, DfmRootClass(DsgGetText)) <> 0) then
    Exit;
  ResTxt := OwnFormResText(LF.ClassName);
  if ResTxt = '' then
  begin
    Dbg('21487: конструктор: в exe нет ресурса формы ' + LF.ClassName +
    ' - живой вид не строится', clRed);
        Exit;
  end;
  TickStart := GetTickCount;
  TickParsed := TickStart;
  TickComps := TickStart;
  TGlyphs := 0;
  TLists := 0;
  // После смены темы прежний снимок - в старых цветах: снимаем заново
  if FDsgFreshSnap then
    SnapTxt := ''
  else
    SnapTxt := OwnSnapFor(LF.ClassName);
  if SnapTxt = '' then
    SnapTxt := FormSnapshotText(LF);
  TickSnap := GetTickCount;

  Comps := 0;
  Props := 0;
  Placed := 0;
  Glyphs := 0;
  Scrolls := 0;
  Lists := 0;
  Grids := 0;
  ResNodes := TList.Create;
  SnapNodes := TList.Create;
  ResIdx := TStringList.Create;
  SnapIdx := TStringList.Create;
  // .dfm вкладки - тот текст, по которому построена форма конструктора.
  // Свойство, которое в нём уже не такое, как в ресурсе exe, правили после
  // сборки: правка важнее живого значения. Иначе, пока работает exe,
  // собранный до правки, конструктор показывает прежнее значение (цвет
  // панели, место), а новая сборка - уже правку.
  TabNodes := TList.Create;
  TabIdx := TStringList.Create;
  Names := TStringList.Create;
  Parsed := False;
  ResRoot := nil;
  SnapRoot := nil;
  Computed := 0;
  try
    // Сверки прежнего снимка не годятся: другой снимок или другая форма
    DiffKey := LF.ClassName + '|' + IntToStr(Length(SnapTxt)) + ':' +
               IntToHex(Crc32Of(SnapTxt), 8) + '|' + IntToStr(Length(ResTxt));
    if FDsgLiveDiff = nil then
    begin
      FDsgLiveDiff := TStringList.Create;
      FDsgLiveDiff.Sorted := True;
      FDsgLiveDiff.CaseSensitive := False;
    end;
    if DiffKey <> FDsgLiveDiffKey then
    begin
      DsgLiveDiffClear;
      FDsgLiveDiffKey := DiffKey;
    end;
    TabRoot := ParseDfmNodes(DsgGetText, False, TabNodes);
    DsgIndexNodes(TabNodes, TabIdx);

    // Цвет самой формы: запись '|root' - Color снимка и ресурса
    J := FDsgLiveDiff.IndexOf('|root');
    if J < 0 then
    begin
      EnsureParsed;
      Entries := nil;
      if (ResRoot <> nil) and (SnapRoot <> nil) then
      begin
        Entries := TStringList.Create;
        Entries.Add('Color' + #1 +
                    DsgNormValue(DsgNodeValue(SnapRoot, 'Color', nil)) + #1 +
                    DsgNormValue(DsgNodeValue(ResRoot, 'Color', nil)));
      end;
      FDsgLiveDiff.AddObject('|root', Entries);
      J := FDsgLiveDiff.IndexOf('|root');
    end;
    Entries := TStringList(FDsgLiveDiff.Objects[J]);
    TickParsed := GetTickCount;
    if (Entries <> nil) and (Entries.Count > 0) then
    begin
      Entry := Entries[0];
      SepPos := Pos(#1, Entry);
      Entry := Copy(Entry, SepPos + 1, MaxInt);
      SepPos := Pos(#1, Entry);
      SV := Copy(Entry, 1, SepPos - 1);
      NormRV := Copy(Entry, SepPos + 1, MaxInt);
      if (SV <> NormRV) and
         ((TabRoot = nil) or
          (DsgNormValue(DsgNodeValue(TabRoot, 'Color', nil)) = NormRV)) then
        FDesigner.Form.Color := LF.Color;
    end;

    for I := 0 to FDesigner.Form.ComponentCount - 1 do
    begin
      C := FDesigner.Form.Components[I];
      if (C.Name = '') or not (C is TControl) then
        Continue;
      // Живой того же класса или его наследник: RichEdit1 и логи у живой
      // формы - TRichEdit из Unit1 (наследник ComCtrls.TRichEdit), а
      // конструктор ставит ComCtrls.TRichEdit
      L := LF.FindComponent(C.Name);
      if (L = nil) or not L.InheritsFrom(C.ClassType) then
        Continue;
      DC := TControl(C);
      LC := TControl(L);


      TickPart := GetTickCount;
      // Значок - у живой кнопки (у неё он уже под тему, UiApplyGlyph).
      // И у компонентов из кода: в снимке значков нет.
      if (DC is TUiIconButton) and
         (TUiIconButton(DC).Glyph.Empty or
          ((FDsgGlyphCopied <> nil) and
           (FDsgGlyphCopied.IndexOf(DC) >= 0))) and
         not TUiIconButton(LC).Glyph.Empty then
      begin
        TUiIconButton(DC).Glyph.Assign(TUiIconButton(LC).Glyph);
        if FDsgGlyphCopied = nil then
          FDsgGlyphCopied := TList.Create;
        if FDsgGlyphCopied.IndexOf(DC) < 0 then
          FDsgGlyphCopied.Add(DC);
        Inc(Glyphs);
      end;
      if (DC is TSpeedButton) and
         (TSpeedButton(DC).Glyph.Empty or
          ((FDsgGlyphCopied <> nil) and
           (FDsgGlyphCopied.IndexOf(DC) >= 0))) and
         not TSpeedButton(LC).Glyph.Empty then
      begin
        TSpeedButton(DC).Glyph.Assign(TSpeedButton(LC).Glyph);
        TSpeedButton(DC).NumGlyphs := TSpeedButton(LC).NumGlyphs;
        TSpeedButton(DC).Flat := TSpeedButton(LC).Flat;
        if FDsgGlyphCopied = nil then
          FDsgGlyphCopied := TList.Create;
        if FDsgGlyphCopied.IndexOf(DC) < 0 then
          FDsgGlyphCopied.Add(DC);
        Inc(Glyphs);
      end;

      Inc(TGlyphs, GetTickCount - TickPart);
      TickPart := GetTickCount;
      // Строки таблиц и узлы деревьев - у живых: в снимке их нет
      try
        if (DC is TListView) and (LC is TListView) and
           not TListView(DC).OwnerData and not TListView(LC).OwnerData and
           (TListView(LC).Items.Count <= DsgItemsMax) then
        begin
          TListView(DC).Items.Assign(TListView(LC).Items);
          Inc(Lists);
        end
        else if (DC is TTreeView) and (LC is TTreeView) and
                (TTreeView(LC).Items.Count <= DsgItemsMax) then
        begin
          TTreeView(DC).Items.Assign(TTreeView(LC).Items);
          DsgCopyExpanded(TTreeView(DC), TTreeView(LC));
          Inc(Lists);
        end;
      except
        // не скопировалось - остаётся пустым, как в .dfm
      end;

      Inc(TLists, GetTickCount - TickPart);
      // Созданных кодом в ресурсе нет - они и так стоят по снимку и
      // отсеиваются ниже. Компонент .dfm, которому код сменил родителя
      // (RichEdit1, логи), конструктор держит среди компонентов из кода
      // (Reparent), но он из .dfm: свойства сверяются как у всех, место -
      // нет, оно у другого родителя.
      // Компонента нет в снимке или не было при сборке (nil) - всё из
      // .dfm вкладки
      Entries := DiffFor(C.Name, LC);
      if Entries = nil then
        Continue;
      TabNode := nil;
      J := TabIdx.IndexOf(C.Name);
      if J >= 0 then
        TabNode := TDfmNode(TabIdx.Objects[J]);
      Defs := DefaultsFor(LC.ClassType);
      Inc(Comps);

      SameParent := not FDesigner.IsRuntime(DC) and
                    (DC.Parent <> nil) and (LC.Parent <> nil) and
                    (DC.Align = LC.Align) and
                    (((DC.Parent = FDesigner.Form) and (LC.Parent = LF)) or
                     (CompareText(DC.Parent.Name, LC.Parent.Name) = 0));
      Sides := '';
      for J := 0 to Entries.Count - 1 do
      begin
        // Запись: свойство #1 значение снимка #1 значение ресурса
        Entry := Entries[J];
        SepPos := Pos(#1, Entry);
        Nm := Copy(Entry, 1, SepPos - 1);
        Entry := Copy(Entry, SepPos + 1, MaxInt);
        SepPos := Pos(#1, Entry);
        SV := Copy(Entry, 1, SepPos - 1);
        NormRV := Copy(Entry, SepPos + 1, MaxInt);
        // Видимость листов переключает сам TPageControl
        if (DC is TTabSheet) and (Nm = 'Visible') then
          Continue;
        // Во вкладке значение уже другое, чем при сборке exe, - правка
        // после сборки, остаётся значение из .dfm вкладки
        if (TabNode <> nil) and
           (DsgNormValue(DsgNodeValue(TabNode, Nm, Defs)) <> NormRV) then
          Continue;

        if (Nm = 'Left') or (Nm = 'Top') or (Nm = 'Width') or
           (Nm = 'Height') then
        begin
          if not SameParent or not DsgOwnBound(LC, Nm) then
            Continue;
          if Nm = 'Left' then
            DC.Left := LC.Left
          else if Nm = 'Top' then
            DC.Top := LC.Top
          else if Nm = 'Width' then
            DC.Width := LC.Width
          else
            DC.Height := LC.Height;
          Sides := Sides + Nm[1];
        end
        else
        begin
          FDesigner.SetPropText(DC.Name, Nm, SV);
          Inc(Props);
        end;
      end;
      // И координаты, которые код задаёт по тексту модуля (ObjCodeProps),
      // даже если к снимку ещё не выполнялся: значение - из .dfm, но
      // двигать его бесполезно
      if SameParent then
        for J := Low(BoundNames) to High(BoundNames) do
          if (Pos(BoundNames[J][1], Sides) = 0) and
             (ObjCodeProps.IndexOf(DC.Name + '.' + BoundNames[J]) >= 0) and
             DsgOwnBound(LC, BoundNames[J]) then
            Sides := Sides + BoundNames[J][1];
      if Sides <> '' then
      begin
        FDesigner.MarkCodePlaced(DC, Sides);
        Inc(Placed);
      end;
    end;

    TickComps := GetTickCount;
    // Свои полосы прокрутки (UiScroll) - отдельные окна поверх полос
    // Windows: ни в .dfm, ни в снимке их нет. Ставятся по тому же правилу,
    // что у живой формы (UiPaintControl): списки, деревья, таблицы, мемо и
    // логи, прокручиваемые панели. Есть живой с тем же именем - как у него
    // (у RichEdit1 свои полосы редактора, UiScroll нет). Нет - по классу:
    // окно настроек строит контролы кодом без имён (Name), и по имени их
    // не найти. Щелчок по такой полосе в конструкторе выделяет родителя
    // списка.
    for I := 0 to FDesigner.Form.ComponentCount - 1 do
    begin
      C := FDesigner.Form.Components[I];
      if not (C is TWinControl) or (TWinControl(C).Parent = nil) or
         not DsgNeedsUiScroll(TControl(C)) or
         (UiScrollFind(TWinControl(C)) <> nil) then
        Continue;
      L := nil;
      if C.Name <> '' then
        L := LF.FindComponent(C.Name);
      if (L is TWinControl) and (UiScrollFind(TWinControl(L)) = nil) then
        Continue;
      TUiListScroll.Attach(TWinControl(C));
      Inc(Scrolls);
    end;

    // Линии сетки таблиц. Тема выключает таблице сетку Windows и рисует
    // линии сама (UiListGrid) - поэтому в снимке у неё GridLines = False, и
    // без этого шага таблица в конструкторе была бы без линий. Живая с тем
    // же именем - как у неё; без имени - по GridLines копии.
    for I := 0 to FDesigner.Form.ComponentCount - 1 do
    begin
      C := FDesigner.Form.Components[I];
      if not (C is TListView) or DsgHasGridMark(TListView(C)) then
        Continue;
      L := nil;
      if C.Name <> '' then
        L := LF.FindComponent(C.Name);
      if L is TListView then
      begin
        if not DsgHasGridMark(TListView(L)) then
          Continue;
        TListView(C).GridLines := True;
      end
      else if not TListView(C).GridLines then
        Continue;
      UiListGrid(TListView(C));
      Inc(Grids);
    end;
  finally
    for I := 0 to ResNodes.Count - 1 do
      TObject(ResNodes[I]).Free;
    for I := 0 to SnapNodes.Count - 1 do
      TObject(SnapNodes[I]).Free;
    for I := 0 to TabNodes.Count - 1 do
      TObject(TabNodes[I]).Free;
    Names.Free;
    TabIdx.Free;
    SnapIdx.Free;
    ResIdx.Free;
    TabNodes.Free;
    SnapNodes.Free;
    ResNodes.Free;
  end;
  Dbg('21720: конструктор, живой вид: компонентов ' + IntToStr(Comps) +
  ' (сверено заново ' + IntToStr(Computed) + ')' +
  ', свойств от кода ' + IntToStr(Props) + ', место от кода у ' +
      IntToStr(Placed) + ', значков ' + IntToStr(Glyphs) +
  ', полос прокрутки ' + IntToStr(Scrolls) + ', таблиц и деревьев ' +
      IntToStr(Lists) + ', сеток ' + IntToStr(Grids) + '; время: снимок ' +
      IntToStr(TickSnap - TickStart) + ' мс, разбор текстов ' +
      IntToStr(TickParsed - TickSnap) + ', компоненты ' +
      IntToStr(TickComps - TickParsed) + ' (значки ' + IntToStr(TGlyphs) +
  ', строки таблиц и деревьев ' + IntToStr(TLists) + '), полосы и сетки ' +
      IntToStr(GetTickCount - TickComps), clGray);
end;

// Смена режима IDE при открытой своей форме в конструкторе: перекрасить на
// месте - тема, затем живой вид по новому снимку. Форма не строится заново:
// окно конструктора не пропадает и не появляется снова, выделение остаётся.
// Серия AddRuntime - раскладка и перерисовка один раз, в конце.
// Своя форма в конструкторе: двойная буферизация - тем же контролам, что у
// живой формы. У живой она ставится в FormCreate, кодом (в .dfm её нет),
// поэтому копии в конструкторе её не получали, и при протяжке рамки формы
// конструктора панель палитры, тулбар и вкладки моргали.
procedure TForm1.DsgMirrorBuffering;
var
  LiveForm: TCustomForm;
  CompIdx: Integer;
  DsgComp, LiveComp: TComponent;
begin
  if (FDesigner = nil) or (FDesigner.Form = nil) or not IsOwnProject then
    Exit;
  LiveForm := OwnLiveForm(FObjFormClass);
  if LiveForm = nil then
    Exit;
  for CompIdx := 0 to FDesigner.Form.ComponentCount - 1 do
  begin
    DsgComp := FDesigner.Form.Components[CompIdx];
    if not (DsgComp is TWinControl) then
      Continue;
    // Коробка с кнопками палитры в конструкторе - копия без имени, по
    // имени её у живой формы не найти; у живой она буферизована
    // (TDsgPalette.CreatePalette)
    if (DsgComp.Name = '') and (DsgComp is TScrollBox) then
    begin
      TWinControl(DsgComp).DoubleBuffered := True;
      Continue;
    end;
    if DsgComp.Name = '' then
      Continue;
    LiveComp := LiveForm.FindComponent(DsgComp.Name);
    if (LiveComp is TWinControl) and TWinControl(LiveComp).DoubleBuffered and
       not TWinControl(DsgComp).DoubleBuffered then
      TWinControl(DsgComp).DoubleBuffered := True;
  end;
end;

procedure TForm1.DsgRetheme;
begin
  // Спрятанный второй вид - в прежних цветах: построится при переключении
  DsgFreeOther;
  if (FDesigner = nil) or (FDesigner.Form = nil) then
    Exit;
  FDesigner.BeginRuntime;
  FDsgFreshSnap := True;
  try
    DsgThemeLook;
    DsgLiveLook;
  finally
    FDsgFreshSnap := False;
    FDesigner.FinishRuntime;
  end;
end;

// Своя форма в конструкторе - в цветах текущей темы IDE (Light / Dark /
// Custom), как её красит тема при работе (UiPaintColors): системные цвета
// .dfm (clBtnFace, clWindow, clWindowText) и цвета ролей - в цвета ролей
// темы; свой цвет, заданный в .dfm, остаётся. Работает и при виде по .dfm
// (.dfm look): это цвета самой темы, а не значения из снимка.
// Компоненты, которые красит не тема, а код (редактор, полоса номеров,
// вкладки файлов), не трогаются - их цвета берёт живой вид.
procedure TForm1.DsgThemeLook;
var
  I: Integer;
  C: TComponent;
begin
  if (FDesigner = nil) or (FDesigner.Form = nil) or not IsOwnProject or
     (OwnLiveForm(FObjFormClass) = nil) then
    Exit;
  // Сама форма
  if FIdeDark then
    FDesigner.Form.Color := UiColor('Ide.WindowBG');
  for I := 0 to FDesigner.Form.ComponentCount - 1 do
  begin
    C := FDesigner.Form.Components[I];
    if not (C is TControl) then
      Continue;
    if (CompareText(C.Name, 'RichEdit1') = 0) or
       (CompareText(C.Name, 'Panel1') = 0) or
       (CompareText(C.Name, 'FTabs') = 0) or
       (CompareText(C.Name, 'FDeclPanel') = 0) or
       (CompareText(C.Name, 'FBusyPanel') = 0) then
      Continue;
    UiPaintColors(TControl(C));
  end;
end;

// Палитра редактора в конструкторе его же формы. Кнопки в снимке спрятаны
// по страницам (ShowPage), конструктор показал бы все сразу, одну поверх
// другой, с красной рамкой. Какая кнопка на какой странице, знает живая
// палитра (PageOf) - список "PalBtn<номер>=страница" уходит конструктору
// (SetTabMembers): видны кнопки открытой вкладки, щелчок по вкладке
// переключает.
procedure TForm1.DsgPaletteTabs;
var
  I, Page: Integer;
  B: TComponent;
  P: TWinControl;
  Members: TStringList;
begin
  if (FDesigner = nil) or (FDesigner.Form = nil) or (FDsgPalette = nil) or
     (PalBtnCount = 0) or not IsOwnProject or
     (CompareText(FObjFormClass, ClassName) <> 0) or
     (CompareText(FObjFormClass, DfmRootClass(DsgGetText)) <> 0) then
    Exit;
  // Вкладки палитры в конструкторе - предок копии кнопки
  P := nil;
  B := FDesigner.Form.FindComponent(PalBtn[1].Name);
  if B is TControl then
    P := TControl(B).Parent;
  while (P <> nil) and not (P is TTabControl) do
    P := P.Parent;
  if P = nil then
  begin
    Dbg('21806: конструктор: вкладки палитры не найдены - видны кнопки всех ' +
    'страниц', clGray);
        Exit;
  end;

  Members := TStringList.Create;
  try
    for I := 1 to PalBtnCount do
    begin
      Page := FDsgPalette.PageOf(PalBtn[I]);
      if Page >= 0 then
        Members.Add(PalBtn[I].Name + '=' + IntToStr(Page));
    end;
    FDesigner.SetTabMembers(TTabControl(P), Members);
  finally
    Members.Free;
  end;
end;

// Конструктор закрыт или форма не построилась - выбор на палитре снят
// ---------------------------------------------------------------------------
//  Массивы компонентов
//
//  Компоненты одного назначения, которых нужно много, - массивом, как DIM в
//  RapidQ: PalBtn: array[1..PalBtnMax] of TSpeedButton. Каждый элемент -
//  компонент формы с именем <массив><номер> (PalBtn17): по имени его находят
//  настройки из editor.ini (ApplyArrayIni) и инспектор. Свойства элементов
//  заполняет код; поправки поверх - в editor.ini, раздел [Array <массив>].
// ---------------------------------------------------------------------------

// Кнопки палитры компонентов - массив PalBtn, по кнопке на класс. Номер
// сквозной по всем страницам DsgClasses, по порядку: страница за страницей,
// на странице сначала компоненты Delphi, потом свои (Custom). Кнопка
// создаётся один раз и получает имя PalBtn<номер>. Ставит её на страницу и
// заполняет (значок, подсказка, место) сама палитра - PlaceButton; смена
// вкладки только переключает видимость. Новый класс в середине списка
// DsgClasses сдвигает номера всех кнопок за ним - поправки в editor.ini
// тогда надо перенести на новые номера.
procedure TForm1.BuildPaletteButtons;
var
  Page, I: Integer;
  L: TList;
  T0: Cardinal;

  procedure AddBtn(AClass: TComponentClass; APage: Integer; ACustom: Boolean);
  begin
    if PalBtnCount >= PalBtnMax then
    begin
      Dbg('21854: палитра: кнопок больше PalBtnMax (' + IntToStr(PalBtnMax) +
      ') - ' + AClass.ClassName + ' не поставлен');
          Exit;
    end;
    Inc(PalBtnCount);
    PalBtn[PalBtnCount] := TSpeedButton.Create(Self);
    PalBtn[PalBtnCount].Name := 'PalBtn' + IntToStr(PalBtnCount);
    FDsgPalette.PlaceButton(PalBtn[PalBtnCount], AClass, APage, ACustom);
  end;

begin
  T0 := GetTickCount;
  PalBtnCount := 0;
  for Page := 0 to DsgPageCount - 1 do
  begin
    L := DsgPageClasses(Page);
    for I := 0 to L.Count - 1 do
      AddBtn(TComponentClass(L[I]), Page, False);
    L := DsgPageCustomClasses(Page);
    if L <> nil then
      for I := 0 to L.Count - 1 do
        AddBtn(TComponentClass(L[I]), Page, True);
  end;
  DsgAddRapidQPages;
  DsgAddForeignPages;
  FDsgPalette.ShowPage;
  ApplyArrayIni('PalBtn', PalBtnCodeProps);
  Dbg('21879: палитра: кнопок ' + IntToStr(PalBtnCount) + ', ' +
      IntToStr(GetTickCount - T0) + ' мс', clGray);
end;

// Сторонние компоненты - страницы палитры после страниц Delphi. Что и на
// какой странице, берётся из установленной Delphi 7 (DsgForeign): пакеты из
// Known Packages и раскладка палитры из реестра. Значки - из их
// design-пакетов. Кнопки не входят в массив PalBtn: ими владеет палитра,
// класса у них нет (Tag = 0), выбор - строкой "Модуль.Класс".
procedure TForm1.DsgAddForeignPages;
var
  StartTick, StageTick, ScanTick, LibsTick: Cardinal;
  CompIdx, PageIdx, LibIdx, LogIdx: Integer;
  PageMap: TStringList;
  Comp: TDsgForeignComp;
  ForeignBtn: TSpeedButton;
  BinDir, RootDir: string;
begin
  StartTick := GetTickCount;
  if FDsgForeign = nil then
    FDsgForeign := TDsgForeignList.Create;
  BinDir := DsgDelphiBin;
  RootDir := '';
  if BinDir <> '' then
    RootDir := ExtractFilePath(ExcludeTrailingPathDelimiter(BinDir));
  StageTick := GetTickCount;
  try
    FDsgForeign.Scan(RootDir, ExtractFilePath(Application.ExeName) +
    'dsgcache\palette_foreign.txt');
  except
    on E: Exception do
    begin
      Dbg('21881: палитра: сторонние компоненты не прочитаны - ' +
          E.Message);
      Exit;
    end;
  end;
  ScanTick := GetTickCount - StageTick;
  StageTick := GetTickCount;
  for LibIdx := 0 to FDsgForeign.IconLibs.Count - 1 do
    FDsgPalette.AddIconLib(FDsgForeign.IconLibs[LibIdx]);
  LibsTick := GetTickCount - StageTick;
  StageTick := GetTickCount;

  PageMap := TStringList.Create;
  try
    for PageIdx := 0 to FDsgForeign.Pages.Count - 1 do
      PageMap.AddObject(FDsgForeign.Pages[PageIdx],
                        TObject(FDsgPalette.AddPage(FDsgForeign.Pages[PageIdx])));
    for CompIdx := 0 to FDsgForeign.Count - 1 do
    begin
      Comp := FDsgForeign[CompIdx];
      PageIdx := PageMap.IndexOf(Comp.PageName);
      if PageIdx < 0 then
        Continue;
      ForeignBtn := TSpeedButton.Create(FDsgPalette);
      FDsgPalette.PlaceForeign(ForeignBtn, Comp.CompUnit, Comp.CompClass,
                               Comp.CompClass + ' (' + Comp.CompUnit + ', ' +
                               ExtractFileName(Comp.RuntimePkg) + ') - ' + Comp.PkgDescr,
                               Integer(PageMap.Objects[PageIdx]));
    end;
  finally
    PageMap.Free;
  end;
  for LogIdx := 0 to FDsgForeign.Log.Count - 1 do
    Dbg('21880: палитра, сторонние: ' + FDsgForeign.Log[LogIdx], clGray);
  Dbg('21880: палитра, сторонние: ' + IntToStr(GetTickCount - StartTick) +
  ' мс (список ' + IntToStr(ScanTick) + ', пакеты значков ' +
      IntToStr(LibsTick) + ', кнопки ' +
      IntToStr(GetTickCount - StageTick) + ')', clGray);
end;

