    FIndentSize: Integer;

    // УРОВЕНЬ ВЛОЖЕННОСТИ КАЖДОЙ СТРОКИ - сколько направляющих полос рисовать
    // слева. Считается по блокам (begin/end, class, record, try, а также
    // оператор без begin под then/do/else), а НЕ по пробелам в строке:
    // раздел var или type отступ даёт, а блоком не является и полосы не
    // даёт. Заполняет RebuildLineDepths вместе с картой комментариев.
    FLineDepth: TIntArray;
    // Засечка конца раздела объявлений (const, type, var): номер полосы
    // плюс один на последней строке раздела, 0 - засечки нет. У раздела
    // нет закрывающего слова, и без засечки его полоса обрывается в
    // пустоте - у блока begin ... end конец виден по самому end.
    FLineTick: TIntArray;
    FHotTabColors: array[0..HotTabLevels - 1] of TColor; // Цвета полос по уровням
    FHotTabBarWidth: Integer;       // Ширина маркера отступа В ПИКСЕЛЯХ
    FHotTabPale: Integer;           // Бледность направляющих, 0..100 %

    // Кодировка открытого файла. Редактор внутри всегда работает в ANSI,
    // эти флаги нужны, чтобы сохранить файл в той же кодировке, в какой он был.
    FFileIsUtf8: Boolean;
    FFileHasBom: Boolean;




    // ОТМЕТКА СТРОК (разделы LineMark, LineMark2, ... схемы): строка, где
    // есть одно из слов группы вне строк и комментариев, заливается фоном
    // этой группы целиком, на всю ширину. Цвет текста - её же; clNone -
    // текст остаётся цветом своей подсветки. Сами группы - в MarkGroups.
    // Список подпрограмм текущего файла и слова, по которым он строится.
