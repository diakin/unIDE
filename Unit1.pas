// Удалить: отмеченные маски - из списка, после вопроса; список - в
// editor.ini ([FindInFiles] DiskExts)
procedure TForm1.FifExtDeleteClick(Sender: TObject);
var
  Dlg: TDlgFifDisk;
  ItemIdx, CheckedCount: Integer;
  Names: string;
begin
  if (FFifDlg = nil) or FFifProject or FFifRunning or FFifListing then
    Exit;
  Dlg := TDlgFifDisk(FFifDlg);
  Names := '';
  CheckedCount := 0;
  for ItemIdx := 0 to Dlg.lstExt.Items.Count - 1 do
    if Dlg.lstExt.Checked[ItemIdx] then
    begin
      Inc(CheckedCount);
      if Names <> '' then
        Names := Names + ', ';
      Names := Names + FifExtOfItem(Dlg.lstExt.Items[ItemIdx]);
    end;
  if CheckedCount = 0 then
  begin
    FifStatus('Отметьте маски, которые удалить из списка');
    Exit;
  end;
  if MessageDlg('Удалить из списка масок (' + IntToStr(CheckedCount) + '):'#13#10 +
                Names + '?', mtConfirmation, [mbYes, mbNo], 0) <> mrYes then
    Exit;
  Dlg.lstExt.Items.BeginUpdate;
  try
    for ItemIdx := Dlg.lstExt.Items.Count - 1 downto 0 do
      if Dlg.lstExt.Checked[ItemIdx] then
        Dlg.lstExt.Items.Delete(ItemIdx);
  finally
    Dlg.lstExt.Items.EndUpdate;
  end;
  FifSaveSettings;
  FifStatus('Удалено из списка масок: ' + Names);
end;

// Add: маски вида *.ext (и .ext) из поля "Доп. маски" - в список масок,
// отмеченными; остальные маски остаются в поле. Список - в editor.ini
procedure TForm1.FifMaskAddClick(Sender: TObject);
var
  Dlg: TDlgFifDisk;
  AddedCount: Integer;
begin
  if (FFifDlg = nil) or FFifProject or FFifRunning or FFifListing then
    Exit;
  Dlg := TDlgFifDisk(FFifDlg);
  if Trim(Dlg.edMask.Text) = '' then
  begin
    FifStatus('Поле "Доп. маски" пустое: впишите маски через ";" (*.txt;.log)');
    Exit;
  end;
  AddedCount := FifMasksToExts;
  FifSaveSettings;
  if Trim(Dlg.edMask.Text) <> '' then
    FifStatus('Добавлено в список масок: ' + IntToStr(AddedCount) +
              '. В поле остались маски не вида *.ext - они ищутся как есть: ' +
              Dlg.edMask.Text)
  else
    FifStatus('Добавлено в список масок: ' + IntToStr(AddedCount));
end;

// Поиск по настройкам окна Find In Files. Уже идёт - остановить
procedure TForm1.FifRun;
var
  Dlg: TDlgFifDisk;
  Pattern, Exts, OtherMasks, Masks, DirText, Missing, Note, FinalText,
    Rest, Ext: string;
  List, Dirs: TStringList;
  Total, Files, FileIdx, DirIdx, SemiAt: Integer;
  Cancel: Boolean;
begin
  if FFifRunning or FFifListing then
  begin
    FFifAbort := True;
    Exit;
  end;
  if FFifDlg = nil then
    Exit;
  Dlg := TDlgFifDisk(FFifDlg);
  FFifListAborted := False;

  Pattern := cmbFind.Text; // без Trim: образец - как введён
  // Искать файл: образец не нужен, ищутся имена по маскам
  if FFifFileMode then
    Pattern := ''
  else
  begin
    if Pattern = '' then
    begin
      FifStatus('Образец поиска пуст: введите его в поле Find главного окна');
      Dbg('Find In Files: поиск не начат - образец пуст', clGray);
      Exit;
    end;
    AddHistory(cmbFind, Pattern);
  end;

  if not FFifProject then
    FifMasksToExts;
  Exts := FifCheckedExts;
  OtherMasks := '';
  if not FFifProject then
    OtherMasks := Trim(Dlg.edMask.Text);
  if (Exts = '') and (OtherMasks = '') then
  begin
    FifStatus('Не отмечено ни одного расширения');
    Dbg('Find In Files: поиск не начат - не отмечено ни одной маски', clGray);
    Exit;
  end;

  // Диск: папки через ";" - каждая должна быть на диске
  DirText := '';
  if not FFifProject then
  begin
    Dirs := TStringList.Create;
    try
      FifSplitDirs(Trim(Dlg.edDir.Text), Dirs);
      Missing := '';
      for DirIdx := 0 to Dirs.Count - 1 do
      begin
        if not DirectoryExists(Dirs[DirIdx]) then
          Missing := Missing + ' ' + Dirs[DirIdx];
        if DirText <> '' then
          DirText := DirText + ';';
        DirText := DirText + Dirs[DirIdx];
      end;
      if Dirs.Count = 0 then
        Missing := ' (папка не указана)';
    finally
      Dirs.Free;
    end;
    if Missing <> '' then
    begin
      FifStatus('Папка не найдена:' + Missing);
      Dbg('Find In Files: поиск не начат - папка не найдена:' + Missing, clGray);
      Exit;
    end;
    Dlg.edDir.Text := DirText;
  end;
  FifSaveSettings;
  Dbg('Find In Files: поиск начат, образец "' + Pattern + '", маски ' + Exts +
      ' ' + OtherMasks, clGray);

  // Текущее окно - в свой слот: ищем по тексту в памяти
  StoreCurrentWindow;

  FFifRunning := True;
  FFifAbort := False;
  FFifListTaken := False;
  FFifCloseAfter := False;
  FFifTotal := 0;
  FFifFiles := 0;
  FFifChecked := 0;
  FFifLastTick := 0;
  Dlg.btnOk.Caption := 'Стоп';

  EnsureMatchForm;
  FMatchPattern := Pattern;
  ResetMatchRows;
  FillMatchGrid;
  if FFifFileMode then
    FMatchForm.Caption := 'Match list - поиск файлов'
  else
    FMatchForm.Caption := 'Match list - поиск: ' + Pattern;
  if not FMatchForm.Visible then
    PlaceMatchForm;
  FMatchForm.Show;

  Total := 0;
  Files := 0;
  Cancel := False;
  Note := '';
  FinalText := '';
  List := TStringList.Create;
  try
    if FFifProject then
    begin
      // Список, только что собранный для галок расширений (FifFillExts), -
      // он же; иначе обход заново, с ходом в окне
      if FFifProjCacheValid then
      begin
        List.Text := FFifProjCache;
        Note := FFifProjCacheNote;
        FFifProjCacheValid := False;
        FFifProjCache := '';
      end
      else if not FifProjectFiles(List, Note) then
      begin
        FinalText := 'Проект не открыт';
        Exit;
      end;
      // только отмеченные расширения
      for FileIdx := List.Count - 1 downto 0 do
        if not FifExtInList(LowerCase(ExtractFileExt(List[FileIdx])), Exts) then
          List.Delete(FileIdx);
    end
    else
    begin
      Masks := '';
      Rest := Exts;
      while Rest <> '' do
      begin
        SemiAt := Pos(';', Rest);
        if SemiAt = 0 then
          SemiAt := Length(Rest) + 1;
        Ext := Copy(Rest, 1, SemiAt - 1);
        Delete(Rest, 1, SemiAt);
        if Masks <> '' then
          Masks := Masks + ';';
        Masks := Masks + '*' + Ext;
      end;
      if OtherMasks <> '' then
      begin
        if Masks <> '' then
          Masks := Masks + ';';
        Masks := Masks + OtherMasks;
      end;
      if FFifFileMode then
        FifCollectDirs(DirText, Masks, Dlg.chkSub.Checked, List, Cancel)
      else
      begin
        // Файл найден - сразу поиск в нём, его вхождения - в Match list,
        // потом обход идёт к следующему файлу (FifFileFound)
        FFifPattern := Pattern;
        FFifListCount := 0;
        FifOpenMapBuild;
        FFifSeen := TStringList.Create;
        try
          FFifSeen.Sorted := True;
          FifCollectDirs(DirText, Masks, Dlg.chkSub.Checked, List, Cancel,
                         FifFileFound);
        finally
          FreeAndNil(FFifSeen);
          FreeAndNil(FFifOpen);
        end;
        Total := FFifTotal;
        Files := FFifFiles;
      end;
    end;
    if FFifFileMode then
    begin
      // Только имена файлов, без содержимого
      if not Cancel and not FFifAbort then
        FifListFilesOnly(List);
      Files := List.Count;
      Total := List.Count;
    end
    else if FFifProject and not Cancel and not FFifAbort then
      FifScanList(List, Pattern, Total, Files, Cancel);
  finally
    FFifRunning := False;
    Cancel := Cancel or FFifAbort;
    List.Free;
    Dlg.btnOk.Caption := 'Найти';
    if not FFifListTaken then
    begin
      FifGridGrow;
      if Total = 0 then
        FMatchForm.Caption := 'Match list - ничего не найдено'
      else if FFifFileMode then
        FMatchForm.Caption := Format('Match list - файлов: %d', [Files])
      else
        FMatchForm.Caption :=
          Format('Match list - %d в %d файлах', [Total, Files]);
      if Cancel then
        FMatchForm.Caption := FMatchForm.Caption + ' (поиск прерван)';
      if Note <> '' then
        FMatchForm.Caption := FMatchForm.Caption + ' - ' + Note;
      if not FFifProject then
        FMatchForm.Caption := FMatchForm.Caption + ' - ' + DirText;
      // Find-> пойдёт по этому списку
      if FFifProject then
        FMatchKey := MatchKeyFor(ScopeProject, Pattern)
      else
        FMatchKey := MatchKeyFor(ScopeDisk, Pattern);
      FMatchCur := -1;
    end;
    if (FinalText = '') and FFifFileMode then
      FinalText := Format('Найдено файлов: %d', [Files]);
    if FinalText = '' then
    begin
      FinalText := Format('Найдено: %d в %d файлах, просмотрено файлов: %d',
                          [Total, Files, FFifChecked]);
      if Cancel then
        FinalText := FinalText + ' (поиск прерван)';
    end;
    FifStatus(FinalText);
    RefreshStatusBar;
    if FFifCloseAfter then
      Close;
  end;
end;

// Обход папки для Find In Files - FifCollectFiles (FileSearch); здесь
// только строка состояния и Esc
procedure TForm1.FifCollectDir(const ADir, AMasks: string; ASubDirs: Boolean;
                               AList: TStrings; var ACancel: Boolean;
                               AOnFile: TFifFileFound);
begin
  FifCollectFiles(ADir, AMasks, ASubDirs, AList, ACancel, FifProgress,
                  AOnFile);
end;

// Несколько папок через ";" (FifSplitDirs). Папка внутри другой
// отмеченной даёт те же файлы ещё раз - повторы убираются, порядок
// остаётся
procedure TForm1.FifCollectDirs(const ADirs, AMasks: string;
                                ASubDirs: Boolean; AList: TStrings;
                                var ACancel: Boolean;
                                AOnFile: TFifFileFound);
var
  Dirs, Seen: TStringList;
  DirIdx, FileIdx, Found: Integer;
begin
  Dirs := TStringList.Create;
  Seen := TStringList.Create;
  try
    FifSplitDirs(ADirs, Dirs);
    for DirIdx := 0 to Dirs.Count - 1 do
    begin
      FifCollectDir(IncludeTrailingPathDelimiter(Dirs[DirIdx]), AMasks,
                    ASubDirs, AList, ACancel, AOnFile);
      if ACancel then
        Break;
    end;
    if Dirs.Count > 1 then
    begin
      // первое вхождение каждого имени остаётся
      Seen.Sorted := True;
      FileIdx := 0;
      while FileIdx < AList.Count do
        if Seen.Find(AnsiLowerCase(AList[FileIdx]), Found) then
          AList.Delete(FileIdx)
        else
        begin
          Seen.Add(AnsiLowerCase(AList[FileIdx]));
          Inc(FileIdx);
        end;
    end;
  finally
    Seen.Free;
    Dirs.Free;
  end;
end;

// Ход обхода папок: папка и сколько файлов подошло под маски - в строку
// хода окна Find In Files; Стоп - прервать. Вне поиска (список расширений
// проекта, FifFillExts) очередь сообщений не трогается
procedure TForm1.FifProgress(const ADir: string; ACount: Integer;
                             var ACancel: Boolean);
begin
  if FFifAbort then
    ACancel := True;
  if ACancel or not (FFifRunning or FFifListing) then
    Exit;
  if FFifListing then
  begin
    if not FifStep(FifPathLine('Список файлов проекта: ', ADir) +
                   #13#10'Файлов: ' + IntToStr(ACount) + ' (Стоп - прервать)') then
      ACancel := True;
  end
  else if FFifFileMode or FFifProject then
  begin
    if not FifStep(FifPathLine('Папка: ', ADir) +
                   #13#10'Найдено файлов по маскам: ' + IntToStr(ACount)) then
      ACancel := True;
  end
  else if not FifStep(FifPathLine('Папка: ', ADir) +
                      #13#10'Проверено файлов: ' + IntToStr(FFifChecked) +
                      '; найдено: ' + IntToStr(FFifTotal) + ' совпадений в ' +
                      IntToStr(FFifFiles) + ' файлах') then
    ACancel := True;
end;

// Все файлы текущего проекта. False - проект не открыт.
//   Delphi: .dpr, модули из его uses (с "in 'файл'"), их .dfm и .inc
//           из папки проекта.
//   Остальные типы: папка проекта с вложенными, по расширениям типа.
// Проект старой раскладки (описание в общей папке projects, цели нет) -
// папку не обходим, чтобы не искать по всем проектам сразу: берутся
// только открытые окна, ANote об этом.
function TForm1.FifProjectFiles(AList: TStrings; var ANote: string): Boolean;
var
  Tp, Target, Dir, Rec, FileNm, Masks: string;
  Units: TStringList;
  I, P: Integer;
  Cancel: Boolean;
  SR: TSearchRec;

  procedure AddFile(const AFile: string);
  begin
    if (AFile <> '') and FileExists(AFile) and (AList.IndexOf(AFile) < 0) then
      AList.Add(AFile);
  end;

begin
  Result := False;
  ANote := '';
  AList.Clear;
  if FCurrentProject = '' then
    Exit;
  Result := True;

  Tp := ProjectTypeOf(FCurrentProject);
  Target := ProjectTargetOf(FCurrentProject);

  if (CompareText(Tp, 'Delphi') = 0) and (Target <> '') and
     FileExists(Target) then
  begin
    Dir := ExtractFilePath(Target);
    AddFile(Target);
    Units := TStringList.Create;
    try
      ParseDprUnits(Target, Units);
      for I := 0 to Units.Count - 1 do
      begin
        // UnitName|FileName|Form|Class
        Rec := Units[I];
        P := Pos('|', Rec);
        Rec := Copy(Rec, P + 1, MaxInt);
        P := Pos('|', Rec);
        FileNm := Copy(Rec, 1, P - 1);
        if FileNm = '' then
          Continue;
        if not ((Length(FileNm) >= 2) and (FileNm[2] = ':')) and
           (Copy(FileNm, 1, 2) <> '\\') then
          FileNm := ExpandFileName(Dir + FileNm);
        AddFile(FileNm);
        AddFile(ChangeFileExt(FileNm, '.dfm'));
      end;
    finally
      Units.Free;
    end;
    if FindFirst(Dir + '*.inc', faAnyFile, SR) = 0 then
    try
      repeat
        if (SR.Attr and faDirectory) = 0 then
          AddFile(Dir + SR.Name);
      until FindNext(SR) <> 0;
    finally
      FindClose(SR);
    end;
    Exit;
  end;

  // Остальные типы - папка проекта по расширениям типа
  if (Target <> '') and FileExists(Target) then
    Dir := ExtractFilePath(Target)
  else
    Dir := ProjectDir(FCurrentProject);
  if (Dir = '') or (CompareText(Dir, ProjectsDir) = 0) then
  begin
    for I := 0 to WindowsItemCount - 1 do
      if FWindows[I].Used then
        AddFile(FWindows[I].FileName);
    ANote := 'папки проекта нет, только открытые окна';
    Exit;
  end;

  if (CompareText(Tp, 'RapidQ Basic') = 0) or
     (CompareText(Tp, 'FreeBASIC') = 0) then
    Masks := '*.bas;*.inc;*.bi'
  else if CompareText(Tp, 'Visual Basic') = 0 then
    Masks := '*.bas;*.frm;*.cls;*.vbp'
  else if CompareText(Tp, 'Arduino') = 0 then
    Masks := '*.ino;*.h;*.c;*.cpp'
  else if CompareText(Tp, 'C project') = 0 then
    Masks := '*.c;*.h'
  else if CompareText(Tp, 'CPP project') = 0 then
    Masks := '*.cpp;*.c;*.h;*.hpp'
  else if CompareText(Tp, 'Lazarus') = 0 then
    Masks := '*.lpr;*.pas;*.pp;*.inc;*.lfm'
  else if CompareText(Tp, 'Delphi') = 0 then
    Masks := '*.dpr;*.pas;*.inc;*.dfm'   // цели нет - по папке
  else if CompareText(Tp, 'Go') = 0 then
    Masks := '*.go'
  else if CompareText(Tp, 'Python') = 0 then
    Masks := '*.py'
  else if CompareText(Tp, 'Rust') = 0 then
    Masks := '*.rs;*.toml'
  else if CompareText(Tp, 'WebSite') = 0 then
    Masks := '*.html;*.htm;*.css;*.js;*.php'
  else
    Masks := MainMasksFor(Tp);
  if Masks = '' then
    Masks := '*.*';

  Cancel := False;
  FifCollectDir(Dir, Masks, True, AList, Cancel);
end;

// Поиск по списку файлов. Открытый файл - из памяти, остальные - с диска.
//
// Открытые окна сверяются по готовому списку полных имён, а не через
// IndexOfWindowByFile: та на каждый вызов обращается к диску
// (ExtractShortPathName) по всем окнам, и на тысячах файлов папки это
// заметно. Поиск немодальный (FifStep): окно из списка могли закрыть или
// открыть в нём другой файл - перед чтением слот сверяется с именем.
// Искать файл: найденные файлы - строками Match list без вхождений.
// HitCount = -1 - строка-файл: справа размер и время, щелчок открывает
// файл (MatchGridDrawCell, MatchGridMouseDown)
procedure TForm1.FifListFilesOnly(AList: TStrings);
var
  FileIdx, RowIdx: Integer;
  Found: TSearchRec;
begin
  for FileIdx := 0 to AList.Count - 1 do
  begin
    RowIdx := AddMatchGroup(AList[FileIdx], IndexOfWindowByFile(AList[FileIdx]));
    FMatchRows[RowIdx].HitCount := -1;
    if FindFirst(AList[FileIdx], faAnyFile, Found) = 0 then
    try
      FMatchRows[RowIdx].Text := FormatFloat('#,##0', Found.Size) + ' байт, ' +
        FormatDateTime('dd.mm.yyyy hh:nn', FileDateToDateTime(Found.Time));
    finally
      FindClose(Found);
    end;
  end;
  FillMatchGrid;
end;

procedure TForm1.FifScanList(AList: TStrings; const APattern: string;
                             var ATotal, AFiles: Integer; var ACancel: Boolean);
var
  FileIdx: Integer;
begin
  FFifPattern := APattern;
  FFifListCount := AList.Count;
  FFifTotal := ATotal;
  FFifFiles := AFiles;
  FifOpenMapBuild;
  try
    for FileIdx := 0 to AList.Count - 1 do
    begin
      FifScanFile(AList[FileIdx], ACancel);
      if ACancel then
        Break;
    end;
  finally
    FreeAndNil(FFifOpen);
    ATotal := FFifTotal;
    AFiles := FFifFiles;
  end;
end;

// Открытые окна: полный путь файла -> окно. Текст открытого файла берётся
// из окна (в памяти, с несохранёнными правками), а не с диска
procedure TForm1.FifOpenMapBuild;
var
  WinIdx: Integer;
begin
  FreeAndNil(FFifOpen);
  FFifOpen := TStringList.Create;
  FFifOpen.Sorted := True;
  FFifOpen.Duplicates := dupIgnore;
  for WinIdx := 0 to WindowsItemCount - 1 do
    if FWindows[WinIdx].Used and (FWindows[WinIdx].FileName <> '') then
      FFifOpen.AddObject(ExpandFileName(FWindows[WinIdx].FileName),
                         TObject(WinIdx));
end;

// Поиск FFifPattern в одном файле: вхождения - в Match list, счётчики -
// FFifTotal, FFifFiles, FFifChecked. ACancel - остановлен или набралось
// FifMaxHits вхождений
procedure TForm1.FifScanFile(const AFile: string; var ACancel: Boolean);
var
  WinIdx, MatchCount, Found: Integer;
  Txt, CountText: string;
begin
  if FFifAbort then
  begin
    ACancel := True;
    Exit;
  end;
  // Строка хода: текущий файл и счётчики. Текст собирается, только когда
  // его пора показать (FifStep - не чаще раза в 100 мс)
  if GetTickCount - FFifLastTick >= 100 then
  begin
    CountText := IntToStr(FFifChecked);
    if FFifListCount > 0 then
      CountText := CountText + ' из ' + IntToStr(FFifListCount);
    if not FifStep(FifPathLine('Файл: ', AFile) +
                   #13#10'Проверено файлов: ' + CountText + '; найдено: ' +
                   IntToStr(FFifTotal) + ' совпадений в ' +
                   IntToStr(FFifFiles) + ' файлах') then
    begin
      ACancel := True;
      Exit;
    end;
  end;

  WinIdx := -1;
  if (FFifOpen <> nil) and FFifOpen.Find(ExpandFileName(AFile), Found) then
  begin
    WinIdx := Integer(FFifOpen.Objects[Found]);
    if (WinIdx > WindowsItemCount - 1) or not FWindows[WinIdx].Used or
       (CompareText(ExpandFileName(FWindows[WinIdx].FileName),
                    ExpandFileName(AFile)) <> 0) then
      WinIdx := -1;
  end;
  if WinIdx >= 0 then
    Txt := FWindows[WinIdx].Text
  else if not FifReadFile(AFile, Txt) then
  begin
    Inc(FFifChecked);
    Exit;
  end;

  MatchCount := ScanTextForMatches(AFile, WinIdx, Txt, FFifPattern);
  Inc(FFifChecked);
  if MatchCount > 0 then
  begin
    Inc(FFifTotal, MatchCount);
    Inc(FFifFiles);
  end;
  if FFifTotal >= FifMaxHits then
    ACancel := True;
end;

// Обход папок нашёл файл: тот же файл второй раз (папка внутри другой
// отмеченной) - мимо, иначе сразу поиск в нём
procedure TForm1.FifFileFound(const AFile: string; var ACancel: Boolean);
var
  FileKey: string;
  Found: Integer;
begin
  if FFifSeen <> nil then
  begin
    FileKey := AnsiLowerCase(AFile);
    if FFifSeen.Find(FileKey, Found) then
      Exit;
    FFifSeen.Add(FileKey);
  end;
  FifScanFile(AFile, ACancel);
end;

// ---------------------------------------------------------------------------
//  Быстрый обмен текстом с редактором
//
//  Свойство RichEdit1.Lines.Text для этого не годится: TStrings.SetTextStr
//  добавляет строки ПО ОДНОЙ, каждую отдельным сообщением контролу, а чтение
//  идёт через EM_GETLINE на каждую строку.
//
//  Здесь и запись, и чтение - по одному обращению: WM_SETTEXT и WM_GETTEXT.
// ---------------------------------------------------------------------------

// Весь текст редактора для СОХРАНЕНИЯ и хранения: перевод строки - CRLF
function TForm1.GetEditorText: string;
begin
  Result := GetEditorTextEx(True);
end;

// Весь текст редактора в координатах контрола: перевод строки - один CR,
// позиция символа в строке (с 1) = индекс контрола + 1. Для карты
// комментариев и строк.
//
// RichEdit 4.1 отдаёт в WM_GETTEXT (RichEdit1.Text) перевод строки двумя
// символами - карта, построенная по такому тексту, уезжала на символ за
// каждую строку выше.
function TForm1.GetEditorTextCR: string;
begin
  Result := GetEditorTextEx(False);
end;

function TForm1.GetEditorTextEx(AUseCRLF: Boolean): string;
const
  EM_GETTEXTEX_ = WM_USER + 94;
  EM_GETTEXTLENGTHEX_ = WM_USER + 95;
  GT_USECRLF_ = 1;
  GTL_USECRLF_ = 1;
  GTL_PRECISE_ = 2;
  GTL_NUMBYTES_ = 16;
type
  TGetTextEx_ = record
    cb: DWORD;
    flags: DWORD;
    codepage: UINT;
    lpDefaultChar: PChar;
    lpUsedDefChar: PBOOL;
  end;
  TGetTextLengthEx_ = record
    flags: DWORD;
    codepage: UINT;
  end;
var
  GT: TGetTextEx_;
  GTL: TGetTextLengthEx_;
  Len, Got: Integer;
begin
  if not MsftEditActive then
  begin
    // RichEdit 3.0 - как было
    Result := RichEdit1.Text;
    Exit;
  end;

  // RichEdit 4.1: кодовая страница и CRLF указаны явно, а не остаются на
  // перекодирование Windows. Длина - точная, в байтах, с CRLF: WM_GETTEXTLENGTH
  // этого не обещает, а TControl.Text по ней выделяет буфер.
  Result := '';
  if not RichEdit1.HandleAllocated then
    Exit;

  if AUseCRLF then
    GTL.flags := GTL_USECRLF_ or GTL_PRECISE_ or GTL_NUMBYTES_
  else
    GTL.flags := GTL_PRECISE_ or GTL_NUMBYTES_;
  GTL.codepage := CP_ACP;
  Len := SendMessageA(RichEdit1.Handle, EM_GETTEXTLENGTHEX_, Integer(@GTL), 0);
  if Len <= 0 then
    Exit;

  SetLength(Result, Len + 1);
  FillChar(GT, SizeOf(GT), 0);
  GT.cb := Len + 1;
  if AUseCRLF then
    GT.flags := GT_USECRLF_
  else
    GT.flags := 0;
  GT.codepage := CP_ACP;
  Got := SendMessageA(RichEdit1.Handle, EM_GETTEXTEX_, Integer(@GT),
                      Integer(PChar(Result)));
  if Got < 0 then
    Got := 0;
  if Got > Len then
    Got := Len;
  SetLength(Result, Got);
end;

procedure TForm1.SetEditorText(const S: string);
begin
  Inc(FEditSerial);
  RichEdit1.SetTextBuf(PChar(S));
end;

procedure TForm1.ApplyTabStops;
begin
  ApplyTabStopsEx(True);
end;

// AWholeText = False - шаг табуляции у текста уже стоит (TabStopsInPlace):
// пересчитать только TabStopN и шрифт полосы номеров, без EM_SETPARAFORMAT
// на весь текст (на Unit1.pas это ~90 мс)
procedure TForm1.ApplyTabStopsEx(AWholeText: Boolean);
var
  PF: TParaFormat;
  DC: HDC;
  TM: TTextMetric;
  OldFont: HGDIOBJ;
  PixPerInch, TabTwips, CharW, I: Integer;
  OldStart, OldLen: Integer;
  WasModified: Boolean;
begin
  if not RichEdit1.HandleAllocated then
    Exit;
  if FTabChars < 1 then
    FTabChars := 4;

  // Шаг табуляции задан В СИМВОЛАХ, поэтому переводим его в пиксели по метрикам
  // ТЕКУЩЕГО шрифта редактора, а уже потом в твипы для EM_SETPARAFORMAT.
  CharW := 8;
  DC := GetDC(RichEdit1.Handle);
  try
    PixPerInch := GetDeviceCaps(DC, LOGPIXELSX);
    OldFont := SelectObject(DC, RichEdit1.Font.Handle);
    if GetTextMetrics(DC, TM) then
      CharW := TM.tmAveCharWidth;
    SelectObject(DC, OldFont);
  finally
    ReleaseDC(RichEdit1.Handle, DC);
  end;
  if PixPerInch <= 0 then
    PixPerInch := 96;
  if CharW < 1 then
    CharW := 1;

  TabStopN := FTabChars * CharW;

  TabTwips := MulDiv(TabStopN, 1440, PixPerInch);
  if TabTwips <= 0 then
    Exit;

  FillChar(PF, SizeOf(PF), 0);
  PF.cbSize := SizeOf(PF);
  PF.dwMask := PFM_TABSTOPS;
  PF.cTabCount := MAX_TAB_STOPS;
  for I := 0 to MAX_TAB_STOPS - 1 do
    PF.rgxTabs[I] := (I + 1) * TabTwips;

  // EM_SETPARAFORMAT действует на выделение, поэтому временно выделяем весь
  // текст, а затем возвращаем каретку и флаг изменений на место.
  if AWholeText then
  begin
    WasModified := RichEdit1.Modified;
    OldStart := RichEdit1.SelStart;
    OldLen := RichEdit1.SelLength;
    FLockHighlight := True;
    try
      RichEdit1.SelectAll;
      SendMessageA(RichEdit1.Handle, EM_SETPARAFORMAT, 0, Integer(@PF));
      RichEdit1.SelStart := OldStart;
      RichEdit1.SelLength := OldLen;
    finally
      FLockHighlight := False;
      RichEdit1.Modified := WasModified;
    end;
  end;

  // Номера строк должны жить в том же шрифте, что и текст редактора
  if PaintBox1 <> nil then
  begin
    PaintBox1.Font.Assign(RichEdit1.Font);
    UpdateGutterWidth; // шрифт другой - и ширина цифр другая
    PaintBox1.Invalidate;
  end;
  RichEdit1.Invalidate;
end;

// Шаг табуляции у текста в редакторе уже нынешний: первый и последний
// абзацы с теми же позициями табуляции, что поставил бы ApplyTabStops.
// Так бывает после заливки текста в окно, где шаг поставлен заранее, на
// пустом тексте (ActivateWindow): новый текст перенимает оформление
// абзаца. Не совпало - False, и шаг ставится на весь текст как раньше.
function TForm1.TabStopsInPlace: Boolean;
var
  PF: TParaFormat;
  DC: HDC;
  TM: TTextMetric;
  OldFont: HGDIOBJ;
  PixPerInch, TabTwips, CharW, TextLen, CheckIdx: Integer;
  OldSel, CheckSel: TCharRange;
begin
  Result := False;
  if not RichEdit1.HandleAllocated then
    Exit;
  if FTabChars < 1 then
    Exit;
  CharW := 8;
  DC := GetDC(RichEdit1.Handle);
  try
    PixPerInch := GetDeviceCaps(DC, LOGPIXELSX);
    OldFont := SelectObject(DC, RichEdit1.Font.Handle);
    if GetTextMetrics(DC, TM) then
      CharW := TM.tmAveCharWidth;
    SelectObject(DC, OldFont);
  finally
    ReleaseDC(RichEdit1.Handle, DC);
  end;
  if PixPerInch <= 0 then
    PixPerInch := 96;
  if CharW < 1 then
    CharW := 1;
  TabTwips := MulDiv(FTabChars * CharW, 1440, PixPerInch);
  if TabTwips <= 0 then
    Exit;

  TextLen := RichEdit1.GetTextLen;
  SendMessageA(RichEdit1.Handle, EM_EXGETSEL, 0, Integer(@OldSel));
  FLockHighlight := True;
  try
    Result := True;
    for CheckIdx := 0 to 1 do
    begin
      if CheckIdx = 0 then
        CheckSel.cpMin := 0
      else
        CheckSel.cpMin := TextLen;
      CheckSel.cpMax := CheckSel.cpMin;
      SendMessageA(RichEdit1.Handle, EM_EXSETSEL, 0, Integer(@CheckSel));
      FillChar(PF, SizeOf(PF), 0);
      PF.cbSize := SizeOf(PF);
      SendMessageA(RichEdit1.Handle, EM_GETPARAFORMAT, 0, Integer(@PF));
      if (PF.dwMask and PFM_TABSTOPS = 0) or
         (PF.cTabCount <> MAX_TAB_STOPS) or
         (PF.rgxTabs[0] <> TabTwips) or (PF.rgxTabs[1] <> 2 * TabTwips) then
      begin
        Result := False;
        Break;
      end;
    end;
  finally
    SendMessageA(RichEdit1.Handle, EM_EXSETSEL, 0, Integer(@OldSel));
    FLockHighlight := False;
  end;
end;

procedure TForm1.UpdateVisibleBounds;
var
  Rect: TRect;
  PtBottomRight: TPoint;
  LastVisibleCharIdx: Integer;
  TotalLinesInFile: Integer;
begin
  Windows.GetClientRect(RichEdit1.Handle, Rect);

  // 1. Узнаем индекс верхней строки
  FirstVisibleLine := SendMessageA(RichEdit1.Handle, EM_GETFIRSTVISIBLELINE, 0, 0);
  FirstChar := SendMessageA(RichEdit1.Handle, EM_LINEINDEX, FirstVisibleLine, 0);
  // 2. Вычисляем нижнюю строку
  PtBottomRight.X := Rect.Right;
  PtBottomRight.Y := Rect.Bottom;

  // EM_CHARFROMPOS в RichEdit: wParam = 0, lParam = адрес TPoint, возврат -
  // индекс символа. Это и есть нужное сообщение; EM_EXCHARFROMPOS в API
  // не существует, WM_USER + 53 - это EM_EXLIMITTEXT, ограничение длины.
  LastVisibleCharIdx := SendMessageA(RichEdit1.Handle, EM_CHARFROMPOS, 0,
                                     Integer(@PtBottomRight));

  // Узнаем общее число строк в файле
  TotalLinesInFile := SendMessageA(RichEdit1.Handle, EM_GETLINECOUNT, 0, 0);

  // ЗАЩИТА: Если при быстром скроллинге Windows вернула ошибку координат (-1)
  if (LastVisibleCharIdx < 0) or (LastVisibleCharIdx = -1) then
  begin
    // Рассчитываем нижнюю строку математически: верхняя строка + сколько строк влезает в экран
    // Высота шрифта Tahoma 11 со всеми отступами примерно 16 пикселей
    LastVisibleLine := FirstVisibleLine + (Rect.Bottom div 16) + 2;
  end
  else
  begin
    LastVisibleLine := SendMessageA(RichEdit1.Handle, EM_LINEFROMCHAR,
                                    LastVisibleCharIdx, 0);
  end;

  // ФИНАЛЬНАЯ СВЕРХНАДЕЖНАЯ КОРРЕКТИРОВКА ГРАНИЦ
  if LastVisibleLine >= TotalLinesInFile then
    LastVisibleLine := TotalLinesInFile - 1;

  if FirstVisibleLine < 0 then
    FirstVisibleLine := 0;

  // Если из-за лага скроллинга верх с низом перепутались, выравниваем их
  if FirstVisibleLine > LastVisibleLine then
    LastVisibleLine := FirstVisibleLine;
end;


// Номера строк зависят от номера верхней видимой строки, общего числа строк
// и строки, в которой стоит каретка - последняя подсвечивается. При ГОРИЗОНТАЛЬНОЙ прокрутке не меняется ни одна из них,
// поэтому панель трогать незачем. Раньше PaintBox1.Invalidate стоял безусловно
// на каждом WM_PAINT, а горизонтальный скролл инвалидирует редактор целиком -
// отсюда и дёрганье номеров на ровном месте.
procedure TForm1.UpdateLineNumbers;
var
  TopLine, TotalLines, CaretLine: Integer;
begin
  if PaintBox1 = nil then
    Exit;

  TopLine := SendMessageA(RichEdit1.Handle, EM_GETFIRSTVISIBLELINE, 0, 0);
  TotalLines := SendMessageA(RichEdit1.Handle, EM_GETLINECOUNT, 0, 0);
  CaretLine := CurrentLineIndex;

  if (TopLine = FNumTopLine) and (TotalLines = FNumTotalLines) and
     (CaretLine = FNumCaretLine) then
    Exit;

  // Номер последней строки стал длиннее или короче - полоса под него
  if (TotalLines <> FNumTotalLines) and
     (GutterDigitsFor(TotalLines) <> FGutterDigits) then
    UpdateGutterWidth;
  FNumTopLine := TopLine;
  FNumTotalLines := TotalLines;
  FNumCaretLine := CaretLine;
  PaintBox1.Invalidate;
end;

// Запрос куска текста у RichEdit. В RichEdit.pas от Delphi 7 ни структуры
// TTextRange, ни константы EM_GETTEXTRANGE нет, поэтому объявляем их сами.
// Имя константы своё, с подчёркиванием, - чтобы не столкнуться с версиями
// модуля, где она всё-таки есть. Порядок полей задан WinAPI, менять нельзя.
type
  TGetTextRange = record
    chrg: TCharRange; // TCharRange объявлен в RichEdit и уже используется
    lpstrText: PChar;
  end;

const
  EM_GET_TEXTRANGE = WM_USER + 75;

  // Один символ текста по абсолютной позиции.
  //
  // Раньше ради него читалась ВСЯ строка редактора: FullText := RichEdit1.Text.
  // Это WM_GETTEXT, то есть копия всего документа в новую строку - на файле
  // в 32 МБ по 32 МБ на каждое обновление статус-бара. EM_GETTEXTRANGE просит
  // у контрола ровно один символ.
function TForm1.CharAt(APos: Integer): Char;
var
  TR: TGetTextRange;
  Buf: array[0..7] of Char;
  WBuf: array[0..3] of WideChar;
begin
  Result := #0;
  if (APos < 0) or not RichEdit1.HandleAllocated then
    Exit;

  FillChar(Buf, SizeOf(Buf), 0);
  FillChar(WBuf, SizeOf(WBuf), 0);
  TR.chrg.cpMin := APos;
  TR.chrg.cpMax := APos + 1;

  // RichEdit 4.1 отдаёт UTF-16 - см. TRichEdit в начале модуля
  if MsftEditActive then
    TR.lpstrText := PChar(@WBuf[0])
  else
    TR.lpstrText := @Buf[0];

  // 0 означает "за концом текста" - там символа и нет
  if SendMessageA(RichEdit1.Handle, EM_GET_TEXTRANGE, 0, Integer(@TR)) <= 0 then
    Exit;

  if MsftEditActive then
    WideCharToMultiByte(CP_ACP, 0, @WBuf[0], 1, @Buf[0], SizeOf(Buf) - 1,
                        nil, nil);
  Result := Buf[0];
end;

// Кусок текста по абсолютным позициям. Тем же EM_GETTEXTRANGE, что и CharAt,
// но под произвольную длину: нужен для окна вокруг каретки.
function TForm1.TextRange(AFrom, ACount: Integer): string;
var
  TR: TGetTextRange;
  Got: Integer;
  W: WideString;
begin
  Result := '';
  if (ACount <= 0) or not RichEdit1.HandleAllocated then
    Exit;
  if AFrom < 0 then
    AFrom := 0;

  TR.chrg.cpMin := AFrom;
  TR.chrg.cpMax := AFrom + ACount;

  if MsftEditActive then
  begin
    // RichEdit 4.1 отдаёт UTF-16 - см. TRichEdit в начале модуля.
    // Плюс символ под завершающий ноль.
    SetLength(W, ACount + 1);
    FillChar(W[1], (ACount + 1) * SizeOf(WideChar), 0);
    TR.lpstrText := PChar(PWideChar(W));

    Got := SendMessageA(RichEdit1.Handle, EM_GET_TEXTRANGE, 0, Integer(@TR));
    if Got <= 0 then
      Exit;
    if Got > ACount then
      Got := ACount;

    // В однобайтовой кодовой странице символ - байт; запас на случай
    // многобайтовой
    SetLength(Result, Got * 2);
    Got := WideCharToMultiByte(CP_ACP, 0, PWideChar(W), Got,
                               PChar(Result), Length(Result), nil, nil);
    SetLength(Result, Got);
    Exit;
  end;

  // Плюс байт под завершающий ноль, который контрол дописывает сам
  SetLength(Result, ACount + 1);
  FillChar(Result[1], ACount + 1, 0);
  TR.lpstrText := PChar(Result);

  Got := SendMessageA(RichEdit1.Handle, EM_GET_TEXTRANGE, 0, Integer(@TR));
  if Got < 0 then
    Got := 0;
  SetLength(Result, Got);
end;

// Выделенный текст, не длиннее AMaxLen символов.
//
// Вместо RichEdit1.SelText: VCL читает его через EM_GETSELTEXT в буфер по
// байту на символ, а RichEdit 4.1 пишет туда UTF-16, по два байта - это
// порча памяти.
function TForm1.SelTextA(AMaxLen: Integer): string;
var
  Sel: TCharRange;
  N: Integer;
begin
  Result := '';
  if not RichEdit1.HandleAllocated then
    Exit;
  SendMessageA(RichEdit1.Handle, EM_EXGETSEL, 0, Integer(@Sel));
  N := Sel.cpMax - Sel.cpMin;
  if N > AMaxLen then
    N := AMaxLen;
  if N > 0 then
    Result := TextRange(Sel.cpMin, N);
end;

// Поиск вперёд. Параметры и ответ - как у RichEdit1.FindText: позиция
// найденного или -1; ищется в [StartPos .. StartPos + Len].
//
// FindText из VCL отдаёт контролу строку в ANSI, а RichEdit 4.1 читает её
// как UTF-16 - поиск ничего не находит (проверено в пробе). Здесь строка
// уходит в UTF-16 через EM_FINDTEXTW.
function TForm1.FindTextEd(const S: string; StartPos, Len: Integer;
                           Options: TSearchTypes): Integer;
const
  EM_FINDTEXTW_ = WM_USER + 123;
  FR_DOWN_ = $00000001;
  FR_WHOLEWORD_ = $00000002;
  FR_MATCHCASE_ = $00000004;
type
  TFindTextW_ = record
    chrg: TCharRange;
    lpstrText: PWideChar;
  end;
var
  FT: TFindTextW_;
  W: WideString;
  Flags: Integer;
begin
  if not MsftEditActive then
  begin
    Result := RichEdit1.FindText(S, StartPos, Len, Options);
    Exit;
  end;

  Result := -1;
  if (S = '') or not RichEdit1.HandleAllocated then
    Exit;

  W := S; // из ANSI по кодовой странице системы
  FT.chrg.cpMin := StartPos;
  FT.chrg.cpMax := StartPos + Len;
  FT.lpstrText := PWideChar(W);

  Flags := FR_DOWN_;
  if stWholeWord in Options then
    Flags := Flags or FR_WHOLEWORD_;
  if stMatchCase in Options then
    Flags := Flags or FR_MATCHCASE_;

  Result := SendMessageW(RichEdit1.Handle, EM_FINDTEXTW_, Flags, Integer(@FT));
end;



// Папка текущего проекта; проекта нет - папка самой программы. Окно
// настроек начинает с неё выбор путей вывода.
function TForm1.CurrentProjectDir: string;
begin
  Result := '';
  if FCurrentProject <> '' then
    Result := ProjectDir(FCurrentProject);
  if (Result = '') or not DirectoryExists(Result) then
    Result := ExtractFilePath(Application.ExeName);
end;




// Открывается ли в позиции литерал, и каким маркером. Побеждает самый
// длинный: чтобы тройная кавычка не проигрывала одинарной.
function TForm1.StrStartAt(const AText: string; APos: Integer;
                           var AKind: Integer): Boolean;
var
  I, BestLen, L: Integer;
  M: string;
begin
  Result := False;
  AKind := -1;
  BestLen := 0;

  for I := 0 to Length(FScheme.FStrExtra) do
  begin
    M := FScheme.StrMark(I);
    L := Length(M);
    if (L = 0) or (L <= BestLen) then
      Continue;
    // Сначала первый символ: Copy на каждый символ текста - выделение
    // строки в памяти, и на полном разборе это большая часть времени
    if (APos >= 1) and (APos + L - 1 <= Length(AText)) and
       (AText[APos] = M[1]) and
       ((L = 1) or (Copy(AText, APos, L) = M)) then
    begin
      BestLen := L;
      AKind := I;
      Result := True;
    end;
  end;
end;





// Открывается ли в позиции APos блочный комментарий, и какой парой.
// Совпасть могут несколько - побеждает самый длинный маркер: '/*' не должен
// перебивать '/**', если такая пара тоже задана.
function TForm1.BcStartAt(const AText: string; APos: Integer;
                          var AKind: Integer): Boolean;
var
  I, BestLen, L: Integer;
  M: string;
begin
  Result := False;
  AKind := -1;
  BestLen := 0;

  for I := 0 to Length(FScheme.FBcExtra) do
  begin
    M := FScheme.BcStartMark(I);
    L := Length(M);
    if (L = 0) or (L <= BestLen) then
      Continue;
    // Сначала первый символ: Copy на каждый символ текста - выделение
    // строки в памяти, и на полном разборе это большая часть времени
    if (APos >= 1) and (APos + L - 1 <= Length(AText)) and
       (AText[APos] = M[1]) and
       ((L = 1) or (Copy(AText, APos, L) = M)) then
    begin
      BestLen := L;
      AKind := I;
      Result := True;
    end;
  end;
end;


// Снимок состояния до правки: длина текста, выделение и окно текста вокруг
// каретки.
//
// Окно снимаем именно ЗДЕСЬ, до того как сообщение уйдёт в контрол. При
// удалении узнать постфактум, какой символ стёрли, уже неоткуда - а стереть
// могли звёздочку из "*/", и тогда два комментария слились в один.
procedure TForm1.CapturePreEdit;
var
  Sel: TCharRange;
  From, Cnt: Integer;
begin
  FPreValid := False;
  FPreWin := '';

  if not FUseSyntaxHighlight then
    Exit; // сдвигать нечего - карты нет
  if not RichEdit1.HandleAllocated then
    Exit;
  // Схема ещё не загружена - сверять не с чем, работаем по-старому
  if FScheme.FMarkerChars = [] then
    Exit;

  SendMessageA(RichEdit1.Handle, EM_EXGETSEL, 0, Integer(@Sel));
  FPreSelMin := Sel.cpMin;
  FPreSelMax := Sel.cpMax;
  // Длина в символах контрола: WM_GETTEXTLENGTH у RichEdit 4.1 считает
  // перевод строки за два, и Enter давал бы сдвиг на 2 вместо 1
  FPreLen := TextLenInternal;

  // Окно с запасом в маркер с каждой стороны: набранный символ может
  // ДОСТРОИТЬ маркер к уже стоящему рядом - '/' плюс '*' дают '/*'
  From := FPreSelMin - FScheme.FMaxMarkerLen - 1;
  Cnt := (FPreSelMax - From) + FScheme.FMaxMarkerLen + 1;
  FPreWin := TextRange(From, Cnt);

  FPreValid := True;
  FPreDepth := FMsgDepth;
end;

// Пытается обойтись сдвигом позиций вместо полного разбора.
// True - карта уже приведена в порядок, пересобирать не нужно.
//
// Работает только на самом частом случае: одиночный символ введён или удалён,
// выделения не было, ни один символ маркера рядом не участвовал. Всё
// остальное - вставка куска, правка поверх выделения, Undo - отдаётся полной
// пересборке: разбирать эти случаи дороже и опаснее, чем разобрать файл.
function TForm1.TryShiftMap: Boolean;
var
  Sel: TCharRange;
  NewLen, D, EditPos, I: Integer;
  PostWin: string;

  function HasMarker(const S: string): Boolean;
  var
    K: Integer;
  begin
    Result := True;
    for K := 1 to Length(S) do
      if S[K] in FScheme.FMarkerChars then
        Exit;
    Result := False;
  end;

begin
  Result := False;
  // Начало правки для RescanVisibleMap: меньшее из начала выделения до
  // правки и каретки после неё. Правка, сделанная не у каретки, сюда не
  // попадает - её поправит полная пересборка по таймеру.
  FMapEditPos := -1;
  if FPreValid and RichEdit1.HandleAllocated then
  begin
    SendMessageA(RichEdit1.Handle, EM_EXGETSEL, 0, Integer(@Sel));
    FMapEditPos := FPreSelMin;
    if Sel.cpMin < FMapEditPos then
      FMapEditPos := Sel.cpMin;
  end;
  try
    if not FPreValid then
      Exit;
    // Выделение могло накрывать десяток комментариев - это не наш случай
    if FPreSelMax <> FPreSelMin then
      Exit;

    NewLen := TextLenInternal;
    D := NewLen - FPreLen;

    // Ноль - замена символа на символ (режим замены), маркеры могли смениться.
    // Больше единицы - вставка или удаление куска.
    if (D <> 1) and (D <> -1) then
      Exit;

    SendMessageA(RichEdit1.Handle, EM_EXGETSEL, 0, Integer(@Sel));

    // Где именно текст изменился. У Delete каретка остаётся на месте,
    // у BackSpace уезжает на символ влево - по этому их и различаем.
    if D > 0 then
      EditPos := FPreSelMin
    else if Sel.cpMin = FPreSelMin then
      EditPos := FPreSelMin          // Delete: стёрли символ справа
    else
      EditPos := FPreSelMin - 1;     // BackSpace: стёрли символ слева

    if EditPos < 0 then
      Exit;

    // Окно после правки: символ мог не только исчезнуть, но и появиться
    PostWin := TextRange(EditPos - FScheme.FMaxMarkerLen - 1, FScheme.FMaxMarkerLen * 2 + 2);

    // Правка безобидна или нет - границы двигаем в любом случае.
    //
    // Если задет маркер, карта всё равно будет разобрана заново (по таймеру),
    // но до этого подсветка не должна уезжать от текста на каждый набранный
    // символ: неточной останется только сама правленая часть.
    //
    // Диапазон, НАЧАВШИЙСЯ после правки, уезжает целиком. Диапазон, внутри
    // которого правили, растягивается или сжимается - у него двигается только
    // конец. Остальные не трогаем.
    for I := 0 to High(CommentRanges) do
      if CommentRanges[I].StartPos >= EditPos then
      begin
        Inc(CommentRanges[I].StartPos, D);
        Inc(CommentRanges[I].EndPos, D);
      end
    else if CommentRanges[I].EndPos > EditPos then
      Inc(CommentRanges[I].EndPos, D);

    for I := 0 to High(StringRanges) do
      if StringRanges[I].StartPos >= EditPos then
      begin
        Inc(StringRanges[I].StartPos, D);
        Inc(StringRanges[I].EndPos, D);
      end
    else if StringRanges[I].EndPos > EditPos then
      Inc(StringRanges[I].EndPos, D);
    if FMapPartialEnd > EditPos then
      Inc(FMapPartialEnd, D);

    if HasMarker(FPreWin) or HasMarker(PostWin) then
      Exit; // задело маркер - ещё и полный разбор

    Result := True;
  finally
    // Снимок одноразовый: второй правке он уже не соответствует
    FPreValid := False;
  end;
end;

// Заказывает обновление статус-бара. Сам пересчёт делает RefreshStatusBar
// по таймеру, не раньше чем через 100 мс.
//
// Прямой вызов на каждое событие не годится. Удержанный BackSpace даёт около
// тридцати правок в секунду, и каждая меняет ВСЁ: длину текста, число строк,
// позицию каретки. Тридцать полных пересчётов в секунду по 32-мегабайтному
// файлу - это и есть та задержка, из-за которой курсор отставал от клавиши.
//
// В статус-баре лежит справочная информация, её читают глазами. Десять
// обновлений в секунду глаз не отличит от тридцати, а нагрузка втрое меньше.
//
// Повторный заказ таймер НЕ перезапускает: TTimer.SetEnabled сравнивает
// значение и при Enabled = True ничего не делает. Значит при непрерывной
// правке обновление идёт ровно раз в 100 мс, а не отодвигается бесконечно.
procedure TForm1.UpdateStatusBarInfo;
begin
  if FStatusTimer <> nil then
    FStatusTimer.Enabled := True
  else
    RefreshStatusBar; // таймера ещё нет - идёт FormCreate
end;

procedure TForm1.StatusTimerTick(Sender: TObject);
begin
  FStatusTimer.Enabled := False;
  RefreshStatusBar;
end;

// Пересчёт полей статус-бара. Всё - через WinAPI, без чтения текста целиком.
procedure TForm1.RefreshStatusBar;
var
  TotalLines: Integer;
  CurrentLine: Integer;
  TotalChars: Integer;
  CursorPos: Integer;
  LineStart, LineCol, LineLen: Integer;
  Selection: TCharRange;
  CurrentChar: Char;
  SubIdx: Integer;
  CtlPt: TPoint;
  OurX: Integer;
  NextStart, LineW, PrevStart, PrevLen: Integer;
  BreakKind, PrevKind: string;
  FaceBuf: array[0..63] of Char;
  DC: HDC;
  OldFont: HGDIOBJ;
begin
  // ЗАЩИТА: Если статус-бар не создан или в нем нет панелей, выходим, чтобы не было Access Violation
  if (StatusBar1 = nil) or (StatusBar1.Panels.Count < 5) then
    Exit;

  // 1. Общее число строк
  TotalLines := RichEdit1.Perform(EM_GETLINECOUNT, 0, 0);
  StatusBar1.Panels[0].Text := 'Строк:' + IntToStr(TotalLines);

  //  текущую позицию каретки (индекс символа под курсором)
  RichEdit1.Perform(EM_EXGETSEL, 0, Integer(@Selection));
  CursorPos := Selection.cpMin; // Глобальная позиция курсора в файле

  // 2. Текущая строка (начиная с 1)
  CurrentLine := RichEdit1.Perform(EM_EXLINEFROMCHAR, 0, CursorPos) + 1;
  StatusBar1.Panels[1].Text := 'Стр: ' + IntToStr(CurrentLine);

  TotalChars := TextLenInternal; // в тех же единицах, что и позиция

  // 3. Положение внутри текущей строки: отступ от её начала и длина строки.
  //    Индекс начала строки и её длину отдаёт сам контрол - читать текст
  //    ради этого не нужно.
  LineStart := SendMessageA(RichEdit1.Handle, EM_LINEINDEX,
                            CurrentLine - 1, 0);
  if LineStart < 0 then
  begin
    LineCol := 0;
    LineLen := 0;
  end
  else
  begin
    LineCol := CursorPos - LineStart;
    LineLen := SendMessageA(RichEdit1.Handle, EM_LINELENGTH, LineStart, 0);
  end;

  StatusBar1.Panels[2].Text := 'Поз в строке: ' + IntToStr(LineCol) +
  '/' + IntToStr(LineLen);

  // ДИАГНОСТИКА расхождения разметок. Пишется в LogEdit - см. LogDiag.
  //   кнт   - X каретки, как его считает контрол (EM_POSFROMCHAR)
  //   наш   - X того же символа по нашей разметке, по которой рисуем
  //   сдвиг - FScrollX
  //   шрифт - гарнитура, которую GDI реально выбрал для нашего HFONT
  // Если кнт и наш расходятся, текст рисуется не там, где его видит
  // контрол: каретка, клики и конец строки будут смещены.
if (LogEdit <> nil) and (FEditHost <> nil) and (LineStart >= 0) then
  begin
    SendMessageA(RichEdit1.Handle, EM_POSFROMCHAR, Integer(@CtlPt), CursorPos);
    OurX := LinePrefixWidth(CurrentLine - 1, LineCol);

    FaceBuf[0] := #0;
    DC := GetDC(RichEdit1.Handle);
    OldFont := SelectObject(DC, RichEdit1.Font.Handle);
    try
      GetTextFace(DC, SizeOf(FaceBuf), FaceBuf);
    finally
      SelectObject(DC, OldFont);
      ReleaseDC(RichEdit1.Handle, DC);
    end;

    // Какой перевод стоит в конце текущей строки контрола.
    // EM_LINEINDEX считает строки ОТОБРАЖЕНИЯ. Если следующая начинается
    // сразу за последним символом этой - между ними нет #13, и перенос
    // сделал сам контрол (мягкий). Если на символ дальше - перевод в тексте.
    NextStart := SendMessageA(RichEdit1.Handle, EM_LINEINDEX, CurrentLine, 0);
    if NextStart < 0 then
      BreakKind := 'посл'
    else if NextStart = LineStart + LineLen then
      BreakKind := 'МЯГКИЙ'
    else
      BreakKind := 'текст';
    LineW := LinePixelWidth(CurrentLine - 1);

    // То же для стыка с ПРЕДЫДУЩЕЙ строкой: её не нужно навещать кареткой
    PrevKind := '-';
    if CurrentLine > 1 then
    begin
      PrevStart := SendMessageA(RichEdit1.Handle, EM_LINEINDEX,
                                CurrentLine - 2, 0);
      if PrevStart >= 0 then
      begin
        PrevLen := SendMessageA(RichEdit1.Handle, EM_LINELENGTH, PrevStart, 0);
        if PrevStart + PrevLen = LineStart then
          PrevKind := 'МЯГКИЙ'
        else
          PrevKind := 'текст';
      end;
    end;

    LogDiag(
    'стр ' + IntToStr(CurrentLine) + '/' + IntToStr(TotalLines) +
    ' поз ' + IntToStr(LineCol) + '/' + IntToStr(LineLen) +
    ' | перенос пред ' + PrevKind + ' след ' + BreakKind + ' шир ' + IntToStr(LineW) + ' | ' +
    'X кнт ' + IntToStr(CtlPt.X) + ' наш ' + IntToStr(OurX) +
    ' сдвиг ' + IntToStr(FScrollX) +
    ' свой ' + IntToStr(FCtlScrollX) +
    ' | VW ' + IntToStr(ViewWidth) + ' хост ' +
      IntToStr(FEditHost.ClientWidth) + ' | ' + StrPas(FaceBuf) +
    ' / ' + RichEdit1.Font.Name + ' ' + IntToStr(RichEdit1.Font.Size) +
    ' | сбр ' + IntToStr(FInvalAll) +
    ' пр ' + IntToStr(FEditUpd) + '/' + IntToStr(FEditDrop) +
    ' en ' + IntToStr(FEnChangeIn) + '/' + IntToStr(FEnChangeOut) +
    ' гл ' + IntToStr(FEnNested) + '/' + IntToStr(FEnTop));
  end;

  // 4. Позиция в файле и общая длина текста
  StatusBar1.Panels[3].Text := 'Поз.: ' + IntToStr(CursorPos) +
  '/' + IntToStr(TotalChars);

  // 5. ASCII код символа СПРАВА от курсора - забираем его одного, см. CharAt
CurrentChar := CharAt(CursorPos);
  if CurrentChar <> #0 then
    StatusBar1.Panels[4].Text :=
    'ASCII: ' + IntToStr(Ord(CurrentChar)) + ' (''' + CurrentChar + ''')'
  else
    StatusBar1.Panels[4].Text := 'ASCII: ---';

  // 6. Кодировка файла. Обновляем здесь же: панель 0 занята счётчиком строк
  // и любая надпись в ней стиралась на первом же движении курсора.
  if StatusBar1.Panels.Count > 5 then
  begin
    if FFileIsUtf8 then
    begin
      if FFileHasBom then
        StatusBar1.Panels[5].Text := 'UTF-8 BOM'
      else
        StatusBar1.Panels[5].Text := 'UTF-8';
    end
    else
      StatusBar1.Panels[5].Text := 'ANSI';
  end;

  // 7. ЗАМЕР: наш код / контрол / отрисовка, миллисекунды на одно нажатие.
  // Плюс длительность последнего полного разбора карты.
  // Подпрограмма, внутри которой каретка, - справа на панели объявления
  if FSubLabel <> nil then
  begin
    SubIdx := SubAtLine(CurrentLine - 1);
    if SubIdx >= 0 then
      SubLabelShow(FSubs[SubIdx].Name)
    else
      SubLabelShow('');
  end;

  if StatusBar1.Panels.Count > 6 then
    StatusBar1.Panels[6].Text :=
      PerfMs(FPerfOur) + ' / ' + PerfMs(FPerfCtl) + ' / ' +
      PerfMs(FPerfPaint) + ' | карта ' + PerfMs(FPerfRebuild) +
    ' | стр ' + PerfMs(FPerfXPos) + ' фон ' + PerfMs(FPerfBase) +
    ' кс ' + PerfMs(FPerfKw) + ' ток ' + PerfMs(FPerfTok) +
    ' вызовов ' + IntToStr(FDrawCalls) +
    ' | полн ' + IntToStr(FInfoBuilds) +
    ' кмт ' + IntToStr(FCmtCalls) + '/' + PerfMs(FPerfCmt) +
    ' сбр ' + IntToStr(FInvalAll) +
    ' пр ' + IntToStr(FEditUpd) + '/' + IntToStr(FEditDrop) +
    ' en ' + IntToStr(FEnChangeIn) + '/' + IntToStr(FEnChangeOut) +
    ' гл ' + IntToStr(FEnNested) + '/' + IntToStr(FEnTop);
end;

type
  // Доступ к защищённым TopRow, RowCount и прочему у любой таблицы
  TGridAccess = class(TCustomGrid);

var
  // Остаток поворота колеса (мелкий шаг тачпада) и таблица, к которой он
  // относится
  GWheelAcc: Integer = 0;
  GWheelGrid: TCustomGrid = nil;

  // Прокрутка таблицы колесом мыши: видимые строки сдвигаются, как полосой
  // прокрутки, выбранная ячейка остаётся на месте. Шаг - системная настройка
  // "строк за щелчок колеса"; "на экран" - на видимую часть.
procedure ScrollGridByWheel(AGrid: TCustomGrid; ADelta: Integer);
var
  G: TGridAccess;
  Steps, Lines, NewTop, MaxTop: Integer;
begin
  G := TGridAccess(AGrid);
  if AGrid <> GWheelGrid then
  begin
    GWheelGrid := AGrid;
    GWheelAcc := 0;
  end;
  Inc(GWheelAcc, ADelta);
  Steps := GWheelAcc div WHEEL_DELTA;
  GWheelAcc := GWheelAcc mod WHEEL_DELTA;
  if Steps = 0 then
    Exit;

  Lines := 3;
  SystemParametersInfo(SPI_GETWHEELSCROLLLINES, 0, @Lines, 0);
  if (Lines <= 0) or (Lines > G.VisibleRowCount) then
    Lines := G.VisibleRowCount;
  if Lines < 1 then
    Lines := 1;

  MaxTop := G.RowCount - G.VisibleRowCount;
  if MaxTop < G.FixedRows then
    MaxTop := G.FixedRows;
  NewTop := G.TopRow - Steps * Lines;
  if NewTop > MaxTop then
    NewTop := MaxTop;
  if NewTop < G.FixedRows then
    NewTop := G.FixedRows;
  if NewTop <> G.TopRow then
    G.TopRow := NewTop;
end;

// Сообщения всего приложения до разбора окнами.
//
// Колесо мыши, пришедшее таблице (или её редактору ячейки), прокручивает
// строки. Сама таблица Delphi 7 на колесо двигает выбранную ячейку, и
// после щелчка по ячейке прокрутки не было. Касается всех таблиц
// программы - и окна настроек, и окна результатов поиска.
procedure TForm1.AppMessage(var Msg: TMsg; var Handled: Boolean);
var
  C: TWinControl;
  CursorPt: TPoint;
begin
  // unIDE FAR: клавиши его окна - ему первым. Что он разобрал, и все его
  // F-клавиши дальше не идут: ни к отладчику (F4..F9), ни к ярлыкам меню,
  // ни к полосе меню (F10, Alt+F1 ... приходят как WM_SYSKEYDOWN).
  // WM_CHAR - символы для поля ввода его диалогов (F5, F6, F7)
  if (FFar <> nil) and FFar.Visible and FFar.HandleAllocated and
     (Msg.hwnd = FFar.Handle) and
     ((Msg.message = WM_KEYDOWN) or (Msg.message = WM_SYSKEYDOWN) or
      (Msg.message = WM_KEYUP) or (Msg.message = WM_SYSKEYUP) or
      (Msg.message = WM_CHAR)) then
  begin
    if FFar.KeyMessage(Msg) then
      Handled := True;
    Exit;
  end;
  if FFarEatF10Up and (Msg.wParam = VK_F10) and
     ((Msg.message = WM_SYSKEYUP) or (Msg.message = WM_KEYUP)) then
  begin
    FFarEatF10Up := False;
    Handled := True;
    Exit;
  end;
  // Режим F4 unIDE FAR, клавиши редактора: Esc - закрыть редактор (если не
  // открыта подсказка Code Insight - её Esc закрывает, как раньше), F2 /
  // Shift+F2 - Save / Save As
  if FFarHalf and (FFar <> nil) and (Msg.message = WM_KEYDOWN) and
     RichEdit1.HandleAllocated and (Msg.hwnd = RichEdit1.Handle) and
     (GetKeyState(VK_CONTROL) >= 0) and (GetKeyState(VK_MENU) >= 0) then
  begin
    if (Msg.wParam = VK_ESCAPE) and (GetKeyState(VK_SHIFT) >= 0) and
       not CiCompletionShown and not FCiParamShown then
    begin
      FarEditorEsc;
      Handled := True;
      Exit;
    end;
    if Msg.wParam = VK_F2 then
    begin
      if GetKeyState(VK_SHIFT) < 0 then
        SaveAsClick(nil)
      else
        N3Click(nil);
      FFarEditSaved := True;
      Handled := True;
      Exit;
    end;
  end;
  // Щелчок по вкладке, когда FAR открыт на всю область: курсор FAR уже
  // поставлен на файл (TabsMouseDown), фокус - обратно ему
  if (FFar <> nil) and FFar.Visible and not FFarHalf and
     (Msg.message = WM_LBUTTONUP) and (FTabs <> nil) and
     FTabs.HandleAllocated and (Msg.hwnd = FTabs.Handle) and
     FFar.CanFocus then
    FFar.SetFocus;

  // Окно разделено: нажатие мыши в панели делает её активной (заголовок)
  if (FSplit <> nil) and ((Msg.message = WM_LBUTTONDOWN) or
     (Msg.message = WM_RBUTTONDOWN) or (Msg.message = WM_MBUTTONDOWN)) then
    SplitTrackClick(Msg.hwnd);
  // Страница IE (просмотр по формату): правый щелчок - своё меню (Как
  // текст / По формату, копирование) вместо меню IE. Отпускание клавиши Menu тоже не отдаётся
  // IE: меню по ней показывает FmtKey.
  if (FWebView <> nil) and FWebView.OwnsWindow(Msg.hwnd) then
  begin
    if Msg.message = WM_RBUTTONUP then
    begin
      GetCursorPos(CursorPt);
      FmtShowPopup(CursorPt);
      Handled := True;
      Exit;
    end;
    if (Msg.message = WM_KEYUP) and (Msg.wParam = VK_APPS) then
    begin
      Handled := True;
      Exit;
    end;
  end;
  // Страница IE во второй панели: правый щелчок - меню панели
  if (FSplit <> nil) and (Msg.message = WM_RBUTTONUP) and
     FSplit.WebOwnsWindow(Msg.hwnd) then
  begin
    GetCursorPos(CursorPt);
    FSplit.ShowMenu(CursorPt);
    Handled := True;
    Exit;
  end;

  // Клавиши отладчика, как в Delphi: F9 - Run и продолжение после
  // остановки, Ctrl+F2 - Program reset, F5 - точка останова на строке с
  // кареткой, F7 - Trace into, F8 - Step over, F4 - Run to cursor. Только
  // в главном окне: у конструктора и диалогов свои клавиши.
  // F3 / Shift+F3 в редакторе - поиск, см. FindKey
  // F1 в файле RapidQ - справка по слову под кареткой, см. HelpKey
  // F12 во вкладке .md, .html, .mht, .rtf, .rvf - текст / просмотр, см. FmtKey
  if (Msg.message = WM_KEYDOWN) and (Screen.ActiveForm = Self) then
  begin
    if DbgKey(Word(Msg.wParam)) or FindKey(Word(Msg.wParam)) or
       HelpKey(Word(Msg.wParam)) or FmtKey(Word(Msg.wParam)) then
      Handled := True;
    Exit;
  end;
  if Msg.message <> WM_MOUSEWHEEL then
    Exit;
  C := FindControl(Msg.hwnd);
  while (C <> nil) and not (C is TCustomGrid) do
    C := C.Parent;
  if C = nil then
    Exit;
  ScrollGridByWheel(TCustomGrid(C), SmallInt(HiWord(Msg.wParam)));
  Handled := True;
end;

// Схема подсветки - до inherited: при чтении формы из .dfm уже приходят
// сообщения, и подсветка может к ней обратиться
constructor TForm1.Create(AOwner: TComponent);
begin
  FScheme := TClrScheme.Create;
  // Поля, полоса номеров и Code Insight - по умолчанию до чтения настроек
  // (EnvInit): ширину полосы номеров считают уже при создании окна
  EdDefaultInsight(FEdIns, False);
  inherited Create(AOwner);
end;

// Схема - после inherited: FormDestroy и уничтожение окон идут внутри него
destructor TForm1.Destroy;
begin
  inherited Destroy;
  FreeAndNil(FScheme);
end;

type
  // Замер обработки сообщений окна: перерисовка, стирание фона, смена
  // размера и места. Дольше MsgTimerLimit - строка 17160 в HiLite log с
  // именем окна. Поставлен на окна правой панели, редактор и форму: при
  // резком сужении окна с открытым инспектором всё замирало на 100-300
  // мс, и по коду не видно, кто их забирает.
  TMsgTimer = class
  private
    FCtl: TControl;
    FOldProc: TWndMethod;
    FTitle: string;
    procedure TimedProc(var Message: TMessage);
    public
    constructor Create(ACtl: TControl; const ATitle: string);
  end;

const
  MsgTimerLimit = 30;

constructor TMsgTimer.Create(ACtl: TControl; const ATitle: string);
begin
  inherited Create;
  FCtl := ACtl;
  FTitle := ATitle;
  FOldProc := ACtl.WindowProc;
  ACtl.WindowProc := TimedProc;
end;

procedure TMsgTimer.TimedProc(var Message: TMessage);
var
  StartTick, Spent: Cardinal;
  MsgName: string;
begin
  StartTick := GetTickCount;
  FOldProc(Message);
  Spent := GetTickCount - StartTick;
  if Spent < MsgTimerLimit then
    Exit;
  case Message.Msg of
    WM_PAINT: MsgName := 'WM_PAINT';
    WM_ERASEBKGND: MsgName := 'WM_ERASEBKGND';
    WM_SIZE: MsgName := 'WM_SIZE';
    WM_WINDOWPOSCHANGED: MsgName := 'WM_WINDOWPOSCHANGED';
    WM_NCPAINT: MsgName := 'WM_NCPAINT';
    CN_NOTIFY: MsgName := 'CN_NOTIFY';
    WM_NOTIFY: MsgName := 'WM_NOTIFY';
  else
    MsgName := '$' + IntToHex(Message.Msg, 4);
  end;
  // При закрытии программы лог уже разрушается - не пишем
  if (Form1 <> nil) and not (csDestroying in Form1.ComponentState) then
    Form1.Dbg(Format('17160: %s - %s %d мс', [FTitle, MsgName, Spent]),
              clNavy);
end;

// Двойная буферизация панелям и рамкам внутри AParent, по всему дереву.
// Рамкам (TCustomGroupBox) ещё стиль WS_CLIPCHILDREN: без него рамка при
// перерисовке заливает фон и под дочерней панелью, и при протяжке окна это
// мелькало (подробнее - в FormCreate).
procedure BufferToolbarTree(AParent: TWinControl);
var
  Idx: Integer;
  Child: TControl;
  Wnd: HWND;
begin
  for Idx := 0 to AParent.ControlCount - 1 do
  begin
    Child := AParent.Controls[Idx];
    if not ((Child is TPanel) or (Child is TCustomGroupBox)) then
      Continue;
    TWinControl(Child).DoubleBuffered := True;
    if Child is TCustomGroupBox then
    begin
      Wnd := TWinControl(Child).Handle;
      SetWindowLong(Wnd, GWL_STYLE,
                    GetWindowLong(Wnd, GWL_STYLE) or WS_CLIPCHILDREN);
    end;
    BufferToolbarTree(TWinControl(Child));
  end;
end;

procedure TForm1.FormCreate(Sender: TObject);
var
  CurrentLeft: Integer;  // правый край ряда pnlToolbarIn - для ширины FLeftPanel
  CmpLeft: Integer;      // правый край ряда Delphi - для ширины FLeftPanel
  IconsLight: TBitmap;   // лента значков для IDE Light
  IconsDark: TBitmap;    // лента значков для IDE Dark

  // Правый край ряда - самый правый край его кнопок. Кнопки, их места и
  // порядок - в .dfm; порядок может быть любой.
  function RowRightEdge(const ARow: array of TControl): Integer;
  var
    BtnIdx: Integer;
  begin
    Result := 0;
    for BtnIdx := Low(ARow) to High(ARow) do
      if (ARow[BtnIdx] <> nil) and
         (ARow[BtnIdx].Left + ARow[BtnIdx].Width > Result) then
        Result := ARow[BtnIdx].Left + ARow[BtnIdx].Width;
  end;

begin
  // Запуск: окно невидимо (прозрачно), пока не готово, - видно окно
  // загрузки (SplashLoad). Прозрачное, а не скрытое: код запуска считает
  // окно показанным - фокус, размеры, FormShow работают как обычно.
  // Показывает его WMStartupFinish.
  if StartupActive then
  begin
    StartupStage('Главное окно: создание');
    AlphaBlendValue := 0;
    AlphaBlend := True;
  end;

  // Меню Started Util - после Window; пункты - UtilMenuUpdate (по простою)
  FUtilMenu := TMenuItem.Create(Self);
  FUtilMenu.Caption := 'Started Util';
  MainMenu1.Items.Insert(mWindows.MenuIndex + 1, FUtilMenu);
  FUtilSig := #1;
  UtilMenuUpdate;

  Position := poDesigned; // иначе VCL сам сдвинет окно при показе

  // Сторож зависаний: главный поток не выбирает сообщения 3 с (или Windows
  // считает главное окно зависшим) - снимок его стека с именами процедур
  // (по .map рядом с exe) в hang.log
  // Меню своей формы: инспектор и редактор - за ним (LiveMenuPopup)
  UiMenuPopupHook := LiveMenuPopup;
  UiMenuItemHook := LiveMenuItem;
  // Пункты Space Equally меню конструктора - сразу, а не при первом его
  // показе: появившись посреди работы, они меняли состав формы, и её
  // снимок (OwnSnapStale) снимался заново на первом Cut
  DsgAlignMenuExtra;
  DsgClipMenuExtra;
  DsgLayoutMenuExtra;

  // Переключатель сборщика: номер пункта - bkDelphi..bkArduino, последний
  // пункт Auto - снова выбор по файлу (UpdateBuildBar, cmbBuildKindChange)
  cmbBuildKind.Items.Clear;
  cmbBuildKind.Items.Add('Delphi');
  cmbBuildKind.Items.Add('RapidQ');
  cmbBuildKind.Items.Add('FreeBASIC');
  cmbBuildKind.Items.Add('Arduino');
  cmbBuildKind.Items.Add('Auto');
  // FreeBASIC: номер пункта - fbOutGui..fbOutDll; 32 и 64 бит
  if cmbFbKind <> nil then
  begin
    cmbFbKind.Items.Clear;
    cmbFbKind.Items.Add(FbOutName(fbOutGui));
    cmbFbKind.Items.Add(FbOutName(fbOutConsole));
    cmbFbKind.Items.Add(FbOutName(fbOutDll));
  end;
  if cmbFbBits <> nil then
  begin
    cmbFbBits.Items.Clear;
    cmbFbBits.Items.Add('32');
    cmbFbBits.Items.Add('64');
  end;
  // RapidQ: номер пункта - rqcRc..rqcFbCompat
  if cmbRqComp <> nil then
  begin
    cmbRqComp.Items.Clear;
    cmbRqComp.Items.Add('rc.exe');
    cmbRqComp.Items.Add('FB Smart');
    cmbRqComp.Items.Add('FB Compat');
    // Папка inc проекта - справа от него, в той же рамке (FillRqIncCombo)
    FRqIncItems := TStringList.Create;
    cmbRqInc := TUiComboBox.Create(Self);
    cmbRqInc.Parent := cmbRqComp.Parent;
    cmbRqInc.Style := csDropDownList;
    cmbRqInc.SetBounds(cmbRqComp.Left + cmbRqComp.Width + 4, cmbRqComp.Top,
                       120, cmbRqComp.Height);
    cmbRqInc.ShowHint := True;
    cmbRqInc.Visible := False;
    cmbRqInc.OnChange := cmbRqIncChange;
    // Строкой выше, за подписью цели: ширина - до правого края рамки
    cmbRqInc.Anchors := [akLeft, akTop, akRight];
    // Строгая проверка перед rc.exe - за "чем собирать"
    chkRqStrict := TUiCheckBox.Create(Self);
    chkRqStrict.Parent := cmbRqComp.Parent;
    chkRqStrict.SetBounds(cmbRqComp.Left + cmbRqComp.Width + 6,
                          cmbRqComp.Top + 2, 80, 17);
    chkRqStrict.Caption := 'FB smart';
    chkRqStrict.Hint := 'Строгая проверка исходника';
    chkRqStrict.ShowHint := True;
    chkRqStrict.Visible := False;
    chkRqStrict.OnClick := chkRqStrictClick;
    chkRqInfo := TUiCheckBox.Create(Self);
    chkRqInfo.Parent := cmbRqComp.Parent;
    chkRqInfo.SetBounds(chkRqStrict.Left + chkRqStrict.Width + 4,
                        chkRqStrict.Top, 80, 17);
    chkRqInfo.Caption := 'Info only';
    chkRqInfo.Hint := 'Ошибки строгой проверки - только в лог, rc.exe ' +
                      'собирает дальше. Без галки - окно с вариантами ' +
                      'исправления, rc.exe не запускается';
    chkRqInfo.ShowHint := True;
    chkRqInfo.Visible := False;
    chkRqInfo.OnClick := chkRqStrictClick;
  end;

  // Точки останова: щелчок по полосе номеров строк
  FBreakMarks := TList.Create;
  FWatchList := TStringList.Create;
  FWatchCondExprs := TStringList.Create;
  FWatchCondTexts := TStringList.Create;
  PaintBox1.OnMouseDown := PaintBox1MouseDown;

  // editor.ini записан самим редактором (TBufIniFile) - не правка снаружи
  IniBufOnWritten := IniOwnWritten;
  HangWatchStart(Application.Handle,
                 ExtractFilePath(Application.ExeName) + 'hang.log', Handle);

  // Прежний exe, переименованный при сборке из работающего редактора
  // (FreeBusyExe), - убрать, если его программа уже закрыта
  DeleteOldExes(Application.ExeName);

  // Возврат в программу - проверить, не изменили ли открытые файлы снаружи.
  // И раз в две секунды, пока программа активна: файл могли поменять, не
  // уводя фокус.
  Application.OnActivate := AppActivate;
  // С временем сборки exe - пока не открыт ни один файл, в заголовке было
  // бы Form1 из .dfm
  Caption := AppTitle;

  // editor.ini этой папки программы: файл другого компьютера уходит в
  // editorN.ini, свой возвращается (SelectEditorIni, PrjStore). Затем
  // проекты из описаний .prj - в editor.ini. До того, как editor.ini
  // кто-нибудь прочитает; что сделано - в FIniPathLog, в HiLite log.
  FIniPathLog := TStringList.Create;
  TidySwapAtStart;   // перезапуск после Tidy editor.ini
  SelectEditorIni(ExtractFilePath(Application.ExeName), FIniPathLog);
  MigratePrjProjects(FIniPathLog);

  // Пути в editor.ini - до того, как их кто-нибудь прочитает
  CheckIniPaths;

  // Отладочный вывод конструктора форм - в наш лог
  DsgLogProc := Dbg;

  // Вид кнопок - по состоянию, когда программе нечего делать
  Application.OnIdle := AppIdle;

  // Выбранная тема - до чтения цветов IDE и схем подсветки
  FFormLightColor := Color;
  ReadThemeSetting;
  Screen.OnActiveFormChange := UiActiveFormChange;
  // Help - FreeBASIC: пункты меню - до построения строки меню
  FbHelpMenuBuild;
  // Цвета оформления IDE - до создания вкладок и дерева объектов
  LoadUiSchema;

  FNumTopLine := -1;
  FNumCaretLine := -1;
  FInPaint := False;
  FPaintDC := 0;
  FNumTotalLines := -1;
  FLockHighlight := False;
  // Гасим мерцание номеров строк и панелей при изменении размеров окна
  Self.DoubleBuffered := True;
  FUseSyntaxHighlight := True; // По умолчанию подсветка работает
  FUseHotTab := False;
  FDsgLiveView := True;   // живой вид конструктора - при каждом запуске
  FTabChars := 4;
  FShowSpaces := False;
  FPairA1 := -1;
  FPairA2 := -1;
  FPairB1 := -1;
  FPairB2 := -1;
  FScheme.FPairFG := clNone;
  FScheme.FPairBG := $0080FFFF;
  FIndentKind := IndentSpaces;
  FIndentSize := 2;
  FFileIsUtf8 := False;
  FFileHasBom := False;
  FRecentFiles := TStringList.Create;
  FHotFolders := TStringList.Create;
  FRelocateAll := False;

  FLastRebuildMs := 0;
  FPerfRebuild := 0;
  if not QueryPerformanceFrequency(FPerfFreq) then
    FPerfFreq := 0;
  FPerfOur := 0;
  FPerfCtl := 0;
  FPerfPaint := 0;
  FLpwLine := -1;   // 0 - настоящий номер строки, кэш должен быть пуст
  FFoundLine := -1;


  FCompDfmNames := TStringList.Create;

  // Базовые цвета до чтения editor.ini
  FIniFontColor := clBlack;
  FIniBGColor := TColor($00F9F9F9);
  FGutterFG := TColor($00202020);
  FGutterBG := TColor($00FDF2E1);
  FScheme.FTextBG := FIniBGColor;
  FKwStale := True;
  FProgForm := nil;
  FProgAbort := False;
  FProjectSig := '';
  FScheme.FMarkerChars := [];  // заполнится при первой загрузке цветовой схемы
  FScheme.FMaxMarkerLen := 1;
  FPreValid := False;
  FNeedLineInv := False;
  FMapStale := False;
  FScrollX := 0;
  FMaxVisW := 0;
  FLockScroll := False;

  MakeBrokenGlyph;     // крестик нужен до первой сборки меню Windows
  FWindowsIndex := -1; // ни одно окно ещё не открыто
  FCurrentProject := '';
  FStartupProject := '';
  FReplaceBackup := '';
  FReplaceBackupWin := -1;
  FBmHistPos := 0;
  // Цвета направляющих отступов. Формат Delphi - $00BBGGRR, поэтому байты
  // идут в обратном порядке относительно привычного RGB.
  FHotTabColors[0] := $004BB43C; // зелёный    RGB(60,180,75)
  FHotTabColors[1] := $00DC783C; // синий      RGB(60,120,220)
  FHotTabColors[2] := $001E96F5; // оранжевый  RGB(245,150,30)
  FHotTabColors[3] := $00C850A0; // фиолетовый RGB(160,80,200)
  FHotTabColors[4] := $00B4AA00; // бирюзовый  RGB(0,170,180)
  FHotTabBarWidth := 3;    // тонкая полоска; 0 или меньше = во всю ширину символа
  FHotTabPale := 50;       // наполовину подмешан фон редактора

  // Значки тулбара и ряда Delphi: ленты 24x24 для светлой и тёмной темы
  // (см. SetToolIcon). У каждой кнопки остаются свои копии, ленты после
  // этого не нужны.
  IconsLight := TBitmap.Create;
  IconsDark := TBitmap.Create;
  try
    LoadToolStrip('BMP_ICONS_LIGHT', IconsLight);
    LoadToolStrip('BMP_ICONS_DARK', IconsDark);
    SetToolIcon(btnOpen, IconOpen, IconsLight, IconsDark);
    SetToolIcon(btnSave, IconSave, IconsLight, IconsDark);
    SetToolIcon(btnSavePrj, IconSavePrj, IconsLight, IconsDark);
    SetToolIcon(btnUndo, IconUndo, IconsLight, IconsDark);
    SetToolIcon(btnCut, IconCut, IconsLight, IconsDark);
    SetToolIcon(btnCopy, IconCopy, IconsLight, IconsDark);
    SetToolIcon(btnPaste, IconPaste, IconsLight, IconsDark);
    SetToolIcon(btnCompileRun, IconRun, IconsLight, IconsDark);
    SetToolIcon(btnViewUnit, IconViewUnit, IconsLight, IconsDark);
    SetToolIcon(btnViewForm, IconViewForm, IconsLight, IconsDark);
    SetToolIcon(btnNewForm, IconNewForm, IconsLight, IconsDark);
    SetToolIcon(btnPause, IconPause, IconsLight, IconsDark);
    SetToolIcon(btnProgReset, IconReset, IconsLight, IconsDark);
    SetToolIcon(btnTraceInto, IconTraceInto, IconsLight, IconsDark);
    SetToolIcon(btnStepOver, IconStepOver, IconsLight, IconsDark);
    SetToolIcon(btnArdVerify, IconArdVerify, IconsLight, IconsDark);
    SetToolIcon(btnArdUpload, IconArdUpload, IconsLight, IconsDark);
  finally
    IconsDark.Free;
    IconsLight.Free;
  end;

  // FLeftPanel.Width := 520;

  FCompilerBox := grpCompiler;   // заголовок меняется вместе с проектом

  // Дальше ряд кнопок, как в Delphi. Кнопки описаны в .dfm, значки
  // поставлены выше, здесь - правый край ряда в CmpLeft. Работают
  // View Unit, View Form (те же списки, что в меню View), New Form
  // (NewFormClick), Program pause, Program reset, Trace into и Step over
  // (отладчик, DbgEngine).
  CmpLeft := RowRightEdge([btnCompileRun, btnViewUnit, btnViewForm,
                          btnNewForm, btnPause, btnProgReset, btnTraceInto,
                          btnStepOver]);

  // Панель лога внизу описана в форме - здесь обработчики и стартовая
  // вкладка
  InitLogPanel;

  FTabs.OnChanging := TabsChanging;
  FTabs.OnChange := TabsChange;
  // Полный путь файла - в подсказке у вкладки (TabsMouseMove)
  FTabHintIdx := -1;
  FTabs.OnMouseMove := TabsMouseMove;
  FTabs.ShowHint := True;
  FTabs.DoubleBuffered := True;
  // Смена ширины и удаление вкладок - см. FitTabsToWidth
  FTabsOldProc := FTabs.WindowProc;
  FTabs.WindowProc := TabsWndProc;
  // Вкладки в несколько рядов: высота полосы - по числу рядов
  FTabsBaseHeight := FTabs.Height;

  // WM_DRAWITEM полоса вкладок шлёт своему родителю, то есть pnlMain.
  // Поэтому подписи рисуем из его обработчика: ни OnDrawTab, ни CN_DRAWITEM
  // у самой полосы в этой связке не срабатывают.
  FTabsHostProc := pnlMain.WindowProc;
  pnlMain.WindowProc := TabsHostWndProc;

  // Панель объявления - под вкладками, над редактором
  BuildDeclPanel;

  CurrentLeft := RowRightEdge([btnOpen, btnSave, btnSavePrj, btnUndo, btnCut,
                              btnCopy, btnPaste]);

  // Теперь известны правые края рядов - подгоняем под них левую панель.
  // Рядов два, панель шире того, который длиннее.
  {
    if CurrentLeft + 10 > CmpLeft + 10 then
      FLeftPanel.Width := CurrentLeft + 10
    else
      FLeftPanel.Width := CmpLeft + 10;
   //}
  BuildSearchPanel; // элементы поиска на группе Search and replace
  FitSearchBox;

  grpPalette.DoubleBuffered := True;
  // Splitter1 (безоконный) рисует pnlMain: без буфера при смене размера
  // окна pnlMain сначала заливал своим цветом и полосу сплиттера, потом
  // сплиттер рисовал себя - полоса мигала. Дети-окна буфер не задевает.
  pnlMain.DoubleBuffered := True;

  pnlPaletteIn.DoubleBuffered := True;

  RegisterDesignClasses;
  FDsgPalette := TDsgPalette.CreatePalette(Self, pnlPaletteIn, DsgDelphiBin);
  // Вкладки палитры в несколько рядов: тулбар выше на столько, сколько
  // добавили ряды (PaletteTabRows)
  FToolbarBaseHeight := FToolbar.Height;
  FDsgPalette.OnTabRows := PaletteTabRows;
  FDsgPalette.OnSelect := DsgPaletteSelect;
  FDsgPalette.OnGlyphLoaded := DsgPaletteGlyph;
  BuildPaletteButtons;
  FLangMode := -1;
  // Правая кнопка на кнопке палитры - окно значков с её значком
  FDsgIconPopup := TUiPopupMenu.Create(Self);
  FDsgIconPopup.AutoHotkeys := maManual;
  FDsgIconPopup.Items.Add(NewItem('Edit Icon...', 0, False, True,
                                  PaletteIconEditClick, 0, ''));
  FDsgPalette.ButtonPopup := FDsgIconPopup;
  // Обработчик - здесь, а не в .dfm: из .dfm назначаются только published
  // методы, а PaletteIconsClick объявлен в другой секции
  mViewIcons.OnClick := PaletteIconsClick;

  // Подсветка файла: в меню вкладки и в Options. Подпункты строит
  // HighlightMenuFill при открытии; пустой пункт - чтобы было подменю.
  FHlTabItem := TMenuItem.Create(Self);
  FHlTabItem.Caption := 'Подсветка';
  FHlTabItem.OnClick := HighlightMenuFill;
  FHlTabItem.Add(NewItem('-', 0, False, False, nil, 0, ''));
  FTabsPopup.Items.Insert(1, FHlTabItem);
  FHlViewItem := TMenuItem.Create(Self);
  FHlViewItem.Caption := 'Highlighting';
  FHlViewItem.OnClick := HighlightMenuFill;
  FHlViewItem.Add(NewItem('-', 0, False, False, nil, 0, ''));
  mOptions.Add(FHlViewItem);
  // Utils: пункты inc-файлов RapidQ - только в проектах Basic (по простою,
  // когда сменился проект, - UtilsMenuOpen)
  UtilsMenuOpen(nil);

  // ВАЖНО: подменю собираем только здесь, когда все пункты главного меню уже
  // созданы. Раньше эти вызовы стояли сразу после Add(mWindows), то есть ДО
  // создания mBookmarks, и BuildBookmarksMenu обращался к nil - отсюда
  // Access violation.
  BuildWindowsMenu;   // постоянные пункты плюс список открытых файлов
  BuildProjectsMenu;  // список проектов из папки projects
  BuildBookmarksMenu; // закладки текущего окна

  // Чтобы Hint пунктов меню доходил до статус-бара
  Application.ShowHint := True;
  Application.OnHint := AppHint;
  // Колесо мыши над таблицами - прокрутка строк, см. AppMessage
  Application.OnMessage := AppMessage;

  // КРИТИЧЕСКИЙ ШАГ: Привязываем созданное PopupMenu к нашему текстовому полю RichEdit1
  RichEdit1.PopupMenu := FPopupMenu;

  // Пункт Exit создан в дизайнере, но обработчик ему никогда не назначался
  mExit.OnClick := N4Click;

  // Собираем меню File целиком: New, Reopen, Save As и разделители
  BuildFileMenu;

  FStatus2.OnResize := Status2Resize;

  // Три панели: путь, размер файла на диске, дата его изменения
  FStatus2.Panels.Add;
  FStatus2.Panels.Add;
  FStatus2.Panels.Add;

  //  StatusBar1.Align := alNone;
  StatusBar1.Align := alBottom;
  FStatus2.Align := alNone;
  try
    // Основной статус-бар прижимаем к низу клиентской области,
    // второй - сразу над ним
    StatusBar1.Top := ClientHeight - StatusBar1.Height;
    FStatus2.Top := StatusBar1.Top - FStatus2.Height;
  finally
    StatusBar1.Align := alBottom;
    FStatus2.Align := alBottom;
  end;
  // Полоса пути (Panel2) - ровно по высоте своей строки состояния: лишняя
  // высота оставалась пустой полосой между горизонтальной прокруткой
  // редактора и путём файла
  Panel2.Height := FStatus2.Height;
  Realign;


  // Буферизация контролов, которые мерцали при смене ширины окна.
  //
  // Стоит В КОНЦЕ FormCreate: раньше блок был сразу после сборки тулбара, но
  // FStatus2 к тому моменту ещё не создан - обращение к нему давало Access
  // violation.
  //
  // Общий WS_EX_COMPOSITED на всю форму не подошёл: вместе с нашим
  // InvalidateRect внутри PaintDoubleBuffered он зацикливал перерисовку -
  // контролы мигали непрерывно и съедали четверть процессора. Здесь же
  // буферизуется только то, что действительно мерцало, а редактор со своей
  // отрисовкой остаётся нетронутым.
  FToolbar.DoubleBuffered := True;
  // Панели и рамки внутри тулбара - по дереву, а не по именам: состав
  // тулбара меняется в конструкторе, и удалённая там панель не должна
  // ломать сборку (BufferToolbarTree)
  BufferToolbarTree(FToolbar);
  FTabs.DoubleBuffered := True;
  Panel1.DoubleBuffered := True;
  Panel2.DoubleBuffered := True;
  FStatus2.DoubleBuffered := True;
  // Вкладки логов внизу моргали при протяжке рамки окна конструктора
  // (там та же форма), а значит, и здесь
  LogTabs.DoubleBuffered := True;

  // Ширины панелей второго бара - в StatusPanelsFit (после панелей
  // первого, ниже). Путь получает остаток, см. Status2Resize.

  // Групбоксам двойная буферизация VCL не помогает: это системные окна класса
  // Button, и WM_PRINTCLIENT они толком не поддерживают. Зато у них по
  // умолчанию нет стиля WS_CLIPCHILDREN - значит при перерисовке групбокс
  // закрашивает свой фон И под дочерней панелью, хотя та закрывает его
  // целиком. Этот лишний слой заливки и мелькал при протяжке рамки.
  // WS_CLIPCHILDREN рамкам тулбара ставит BufferToolbarTree (выше).

  // Шестая панель статус-бара - кодировка открытого файла. Создаём кодом,
  // чтобы не зависеть от того, сколько панелей описано в DFM.
  while StatusBar1.Panels.Count < 7 do
    StatusBar1.Panels.Add;
  StatusBar1.Panels[5].Text := 'ANSI';

  StatusPanelsFit;

  // Фильтр диалога открытия. Пункты идут парами "подпись|маска",
  // разделитель между парами - вертикальная черта.
  OpenDialog1.Filter :=
  'All Files *.*|*.*|' +
  'Source Code *.pas;*.dpr;*.cpp;*.c;*.h;*.cs;*.java|*.pas;*.dpr;*.cpp;*.c;*.h;*.cs;*.java|' +
  'Bas Files *.bas;*.rqb;*.vbs|*.bas;*.rqb;*.vbs|' +
  'Arduino Files *.ino;*.pde;*.h;*.c;*.cpp|*.ino;*.pde;*.h;*.c;*.cpp|' +
  'Script Files *.js;*.ts;*.py;*.r;*.rs;*.go;*.ps1;*.bat;*.cmd|*.js;*.ts;*.py;*.r;*.rs;*.go;*.ps1;*.bat;*.cmd|' +
  'Config Files *.yml;*.yaml;*.json|*.yml;*.yaml;*.json|' +
  'Ini Files *.ini;*.prj;*.iss;*.cfg|*.ini;*.prj;*.iss;*.cfg|' +
  'Inc Files *.inc;*.tpl|*.inc;*.tpl|' +
  'Sql Files *.sql|*.sql|' +
  'Log Files *.log|*.log|' +
  'Txt Files *.txt;*.md|*.txt;*.md|' +
  'Html Files *.*htm*;*.js;*.vbs;*.css|*.*htm*;*.js;*.vbs;*.css|' +
  'Form Files *.dfm;*.fmx|*.dfm;*.fmx';
OpenDialog1.FilterIndex := 1; // по умолчанию показываем все файлы

  // Диалог сохранения держим на том же списке
  SaveDialog1.Filter := OpenDialog1.Filter;
  SaveDialog1.FilterIndex := 1;

  // ofNoChangeDir - ключевой флаг. Без него Windows делает текущим каталогом
  // процесса ту папку, в которой пользователь в последний раз что-то выбрал.
  // Дальше любой диалог с пустым InitialDir открывается ИМЕННО ТАМ, и папка
  // вроде RQIDE прилипает на весь сеанс. Заодно это чинит и относительные
  // пути: они считаются от текущего каталога, а тот уезжал вместе с диалогом.
  OpenDialog1.Options := OpenDialog1.Options + [ofNoChangeDir];
  SaveDialog1.Options := SaveDialog1.Options + [ofNoChangeDir];

  // Свои полосы прокрутки вместо недостижимых родных
  BuildScrollBars;
  BuildRightPanel;
  Self.OnResize := FormResizeEvent;

  // Замер долгих сообщений (строка 17160 HiLite log). Объекты замера
  // принадлежат форме по времени жизни: живут до выхода из программы.
  TMsgTimer.Create(FObjTree, 'дерево инспектора');
  TMsgTimer.Create(FObjProps, 'свойства инспектора');
  TMsgTimer.Create(FObjEvents, 'события инспектора');
  TMsgTimer.Create(FRightPages, 'вкладки правой панели');
  TMsgTimer.Create(FRightPanel, 'правая панель');
  TMsgTimer.Create(RichEdit1, 'редактор');
  TMsgTimer.Create(Self, 'главное окно');

  // Меню Arduino: Sketchbook, Examples, Include Library, Board, Port ...
  ArdBuildMenu;

  // Журнал окна wnd.log рядом с exe: поиск давней ошибки - белые полосы на
  // полосе вкладок и строке состояния, когда поверх окна двигают другое
  // окно, и пропадание окна с экрана, как свёрнутого. Что пишется - в
  // WndWatch.pas. Включается файлом wnd.on рядом с exe (содержимое не
  // важно); без него журнал не ведётся и остальные вызовы WndWatch ничего
  // не делают.
  if FileExists(ExtractFilePath(Application.ExeName) + 'wnd.on') then
    WndWatchStart(ExtractFilePath(Application.ExeName) + 'wnd.log');
  WndWatchMainForm(Self, 'главное окно');
  WndWatchControl(FTabs, 'полоса вкладок', True, True);
  WndWatchControl(FStatus2, 'строка состояния', True, True);
  WndWatchControl(pnlMain, 'pnlMain', True);
  // Сообщения родителя полосы вкладок и главного окна - в журнал вместе с
  // белой полосой: видно, кому досталась перерисовка
  WndWatchTrace(pnlMain);
  WndWatchTrace(Self);
end;

// Пробная сборка редактора закрывается обычным образом после удачного
// запуска - она становится рабочей: <имя>.exe -> <имя>.exe.old (или .old1
// ...), сама <имя>_new.exe -> <имя>.exe, .map так же. Переименовать
// запущенный exe Windows позволяет - и этот, и рабочий, если он ещё открыт.
// Не вышло - сообщение, файлы остаются как были, результат False.
function OwnPromoteTrial: Boolean;
var
  TrialExe, MainExe, OldMain, TrialMap, MainMap: string;
begin
  Result := False;
  TrialExe := Application.ExeName;
  MainExe := ExtractFilePath(TrialExe) + OwnExeBase + '.exe';
  OldMain := '';
  if FileExists(MainExe) then
  begin
    OldMain := OwnOldName(MainExe);
    if not MoveFile(PChar(MainExe), PChar(OldMain)) then
    begin
      MessageBox(0, PChar('Не удалось переименовать ' + MainExe + ' в ' +
                          ExtractFileName(OldMain) + ': ' +
                          SysErrorMessage(GetLastError) + #13#10 +
      'Пробная сборка остаётся под именем ' +
                          ExtractFileName(TrialExe)), 'unIDE',
                 MB_OK or MB_ICONWARNING);
      Exit;
    end;
  end;
  if not MoveFile(PChar(TrialExe), PChar(MainExe)) then
  begin
    MessageBox(0, PChar('Не удалось переименовать ' + TrialExe + ' в ' +
                        ExtractFileName(MainExe) + ': ' +
                        SysErrorMessage(GetLastError)), 'unIDE',
               MB_OK or MB_ICONWARNING);
    // Прежний рабочий - на место
    if OldMain <> '' then
      MoveFile(PChar(OldMain), PChar(MainExe));
    Exit;
  end;
  // Манифест пробного exe больше не нужен: у рабочего свой
  // (OwnTrialInstall скопировал его с рабочего)
  if FileExists(TrialExe + '.manifest') and
     FileExists(MainExe + '.manifest') then
    DeleteFile(TrialExe + '.manifest');
  // Сведения о сборке - вместе с exe
  if FileExists(GitBuildInfoFile(TrialExe)) then
  begin
    if FileExists(GitBuildInfoFile(MainExe)) then
      DeleteFile(GitBuildInfoFile(MainExe));
    MoveFile(PChar(GitBuildInfoFile(TrialExe)), PChar(GitBuildInfoFile(MainExe)));
  end;
  TrialMap := ChangeFileExt(TrialExe, '.map');
  MainMap := ChangeFileExt(MainExe, '.map');
  if FileExists(TrialMap) then
  begin
    if FileExists(MainMap) and not DeleteFile(MainMap) then
      MoveFile(PChar(MainMap), PChar(OwnOldName(MainMap)));
    MoveFile(PChar(TrialMap), PChar(MainMap));
  end;
  Result := True;
end;

