// Файл .dpr, который считается целью: цель проекта, иначе открытый .dpr,
// иначе одноимённый .dpr рядом с открытым файлом. Порядок тот же, что в
// CompileDelphi, но без побочных действий - ни записи цели, ни сообщений:
// функция нужна и перед сборкой, и после неё.
function TForm1.DelphiTargetDpr: string;
var
  BuildPrj: string;
begin
  Result := '';
  if FCurrentFileName = '' then
    Exit;

  // Вкладка - описание проекта: цель этого проекта
  if CompareText(ExtractFileExt(FCurrentFileName), '.prj') = 0 then
  begin
    BuildPrj := BuildProject;
    if BuildPrj <> '' then
      Result := ProjectTargetFind(BuildPrj);
    Exit;
  end;

  if CompareText(ExtractFileExt(FCurrentFileName), '.dpr') = 0 then
  begin
    if FileExists(FCurrentFileName) then
      Result := FCurrentFileName;
    Exit;
  end;

  // .dpr папки вкладки, молча (без списка и переименования)
  Result := DelphiDprInFolder(ExtractFilePath(FCurrentFileName), False);
end;

// Куда dcc32 кладёт exe проекта ADpr. По порядку:
//   1. [Project] OutputDir в описании проекта (.prj), у которого ADpr -
//      цель. Относительный путь - от папки .dpr; пустое значение - сама
//      папка .dpr (как было до папки Output).
//   2. ExePath из настроек компилятора (IDE Options -> Compilers) - общий
//      для всех проектов, если задан.
//   3. Сам редактор (.dpr с именем его exe) - папка Output рядом с .dpr:
//      работающий редактор пишет рядом с собой editor.ini, UiLib,
//      dsgcache, а в папке .dpr они под git. Output - в .gitignore,
//      редактор запускается оттуда.
//   4. Папка самого .dpr.
// Этим же пользуются сборка (ключ -E) и Run - иначе Run искал бы exe не
// там, где он появился.
function TForm1.DelphiOutputDir(const ADpr, ARoot: string): string;
var
  Ini: TIniFile;
  Prj: TProjectIni;
  DprDir, OutDir, BuildPrj: string;
  HasKey: Boolean;
begin
  Result := '';
  if ADpr = '' then
    Exit;
  // Путь .dpr без папки или относительный: папка exe от него была бы
  // относительной ('Output\'), и ForceDirectories на ней падает с
  // "Unable to create directory"
  DprDir := ExtractFilePath(ExpandFileName(ADpr));

  // 1. Своя папка проекта
  BuildPrj := BuildProject;
  if (BuildPrj <> '') and
     (CompareText(ProjectTargetOf(BuildPrj), ADpr) = 0) then
  begin
    if ProjectExists(BuildPrj) then
    begin
      Prj := TProjectIni.Create(SettingsFileName, BuildPrj);
      try
        HasKey := Prj.ValueExists('Project', 'OutputDir');
        OutDir := Trim(StripIniComment(Prj.ReadString('Project', 'OutputDir',
        '')));
      finally
        Prj.Free;
      end;
      if HasKey then
      begin
        if OutDir = '' then
          Result := DprDir
        else if (ExtractFileDrive(OutDir) = '') and (OutDir[1] <> '\') then
          Result := ExpandFileName(DprDir + OutDir)
        else
          Result := OutDir;
        Result := IncludeTrailingPathDelimiter(Result);
        Exit;
      end;
    end;
  end;

  // 2. Общая папка из настроек компилятора
  if FileExists(SettingsFileName) then
  begin
    Ini := TIniFile.Create(SettingsFileName);
    try
      OutDir := StripIniComment(Ini.ReadString(CompilerSection('Delphi'),
      'ExePath', ''));
    finally
      Ini.Free;
    end;
    OutDir := ExpandDelphiRoot(Trim(OutDir), ARoot);
    if OutDir <> '' then
    begin
      // Относительный путь - от папки .dpr, как у OutputDir проекта
      if (ExtractFileDrive(OutDir) = '') and (OutDir[1] <> '\') then
        OutDir := ExpandFileName(DprDir + OutDir);
      Result := IncludeTrailingPathDelimiter(OutDir);
      Exit;
    end;
  end;

  // 3. Сам редактор - в Output
  if CompareText(ChangeFileExt(ExtractFileName(ADpr), ''),
                 OwnExeBase) = 0 then
  begin
    Result := IncludeTrailingPathDelimiter(DprDir + 'Output');
    Exit;
  end;

  // 4. По умолчанию - папка .dpr, как у самой Delphi
  Result := IncludeTrailingPathDelimiter(DprDir);
end;

function TForm1.DelphiExeOf(const ADpr: string): string;
begin
  Result := '';
  if ADpr = '' then
    Exit;
  Result := DelphiOutputDir(ADpr, '') +
            ChangeFileExt(ExtractFileName(ADpr), '.exe');
end;

// exe, который запускает Run: DelphiExeOf, а у самого редактора - пробная
// сборка, если она есть (OwnTrialInstall)
function TForm1.DelphiRunExeOf(const ADpr: string): string;
var
  TrialExe: string;
begin
  Result := DelphiExeOf(ADpr);
  if (Result = '') or
     (CompareText(ChangeFileExt(ExtractFileName(ADpr), ''), OwnExeBase) <> 0) then
    Exit;
  TrialExe := OwnTrialExeOf(Result);
  if FileExists(TrialExe) then
    Result := TrialExe;
end;

// Редактор, собранный в AStageDir, - пробным exe <ABase>_new.exe в
// AExeDir, его .map - рядом под тем же именем (по нему ищут адреса
// HangWatch и отладчик). Папка сборки удаляется. False - не вышло,
// причина в логе.
function TForm1.OwnTrialInstall(const AStageDir, AExeDir,
                                ABase: string): Boolean;
var
  StageDir, StageExe, TrialExe, StageMap, TrialMap: string;
  MainManifest, TrialManifest: string;
  Found: TSearchRec;
begin
  Result := False;
  // Папки - с обратной косой в конце: имя файла дописывается к ним прямо
  StageDir := IncludeTrailingPathDelimiter(AStageDir);
  StageExe := StageDir + ABase + '.exe';
  TrialExe := IncludeTrailingPathDelimiter(AExeDir) + ABase + OwnTrialSuffix +
  '.exe';
if not FileExists(StageExe) then
  begin
    LogComp('Пробная сборка: dcc32 не создал ' + StageExe);
    Exit;
  end;
  // Прежняя пробная сборка ещё запущена - она уходит в .old
  if not FreeBusyExe(TrialExe) then
    Exit;
  if FileExists(TrialExe) and not DeleteFile(TrialExe) then
  begin
    LogComp('Пробная сборка: не удалось заменить ' + TrialExe + ' (' +
            SysErrorMessage(GetLastError) + ')');
    Exit;
  end;
  if not MoveFile(PChar(StageExe), PChar(TrialExe)) then
  begin
    LogComp('Пробная сборка: не удалось перенести ' + StageExe + ' в ' +
            TrialExe + ' (' + SysErrorMessage(GetLastError) + ')');
    Exit;
  end;
  StageMap := ChangeFileExt(StageExe, '.map');
  TrialMap := ChangeFileExt(TrialExe, '.map');
  if FileExists(StageMap) then
  begin
    DeleteFile(TrialMap);
    if not MoveFile(PChar(StageMap), PChar(TrialMap)) then
      LogComp('Пробная сборка: .map не перенесён - ' + TrialMap);
  end;
  // Внешний манифест (<имя>.exe.manifest: стили Windows, Common Controls
  // 6.0) Windows ищет только по имени exe. У пробной сборки своего не было -
  // она запускалась без стилей и выглядела не так, как рабочая (кнопки,
  // цвета панелей). Копия - под именем пробного exe.
  MainManifest := IncludeTrailingPathDelimiter(AExeDir) + ABase + '.exe.manifest';
  TrialManifest := TrialExe + '.manifest';
  if FileExists(MainManifest) then
  begin
    if not Windows.CopyFile(PChar(MainManifest), PChar(TrialManifest), False) then
      LogComp('Пробная сборка: манифест не скопирован - ' + TrialManifest +
              ' (' + SysErrorMessage(GetLastError) + ')');
  end
  else
    LogComp('Пробная сборка: рядом нет ' + ExtractFileName(MainManifest) +
            ' - пробный exe запустится без стилей Windows, как и рабочий');
  // Остальное в папке сборки (.drc и т. п.) - убрать, и саму папку
  if FindFirst(StageDir + '*.*', faAnyFile and not faDirectory, Found) = 0 then
  try
    repeat
      DeleteFile(StageDir + Found.Name);
    until FindNext(Found) <> 0;
  finally
    FindClose(Found);
  end;
  RemoveDir(ExcludeTrailingPathDelimiter(StageDir));
  Result := True;
end;

// Собранный редактор запускается из папки вывода и ищет свои файлы рядом с
// собой (SettingsFileName, UiSchemaFileName, папка schemes). Копируются
// только те, которых там ещё нет: настройки, поменянные в запущенной копии,
// не затираются. Откуда - из папки .dpr, чего там нет - из папки
// работающего редактора. editor.ini, который там уже есть, дополняется:
// новые разделы и параметры дописываются, отличающиеся разделы
// сохраняются копиями [<Раздел>Old<N>] (MergeOwnSettings).
procedure TForm1.CopyOwnRunFiles(const ADprDir, AExeDir: string);
var
  SrcDirs: array[0..1] of string;
  DstDir: string;
  Copied, SrcIdx, Merged: Integer;

  // Файл ARel (путь от папки) - из первой папки-источника, где он есть
  procedure CopyIfMissing(const ARel: string);
  var
    DirIdx: Integer;
  begin
    if FileExists(DstDir + ARel) then
      Exit;
    for DirIdx := Low(SrcDirs) to High(SrcDirs) do
      if FileExists(SrcDirs[DirIdx] + ARel) then
      begin
        ForceDirectories(ExtractFilePath(DstDir + ARel));
        if CopyFile(PChar(SrcDirs[DirIdx] + ARel), PChar(DstDir + ARel),
                    True) then
          Inc(Copied);
        Exit;
      end;
  end;

// Файл ARel - из первой папки-источника, где он есть, если там он
// новее (описание компонентов RapidQ пересобирается, старая копия рядом
// с exe перекрыла бы новую)
  procedure CopyIfNewer(const ARel: string);
  var
    DirIdx: Integer;
  begin
    for DirIdx := Low(SrcDirs) to High(SrcDirs) do
      if FileExists(SrcDirs[DirIdx] + ARel) then
      begin
        if FileExists(DstDir + ARel) and
           (FileAge(DstDir + ARel) >= FileAge(SrcDirs[DirIdx] + ARel)) then
          Exit;
        ForceDirectories(ExtractFilePath(DstDir + ARel));
        if CopyFile(PChar(SrcDirs[DirIdx] + ARel), PChar(DstDir + ARel),
                    False) then
          Inc(Copied);
        Exit;
      end;
  end;

// Все файлы папки ARelDir (без вложенных) из всех источников
  procedure CopyDirIfMissing(const ARelDir: string);
  var
    DirIdx: Integer;
    Found: TSearchRec;
  begin
    for DirIdx := Low(SrcDirs) to High(SrcDirs) do
      if FindFirst(SrcDirs[DirIdx] + ARelDir + '\*.*', faAnyFile,
                   Found) = 0 then
      try
      repeat
        if (Found.Attr and faDirectory) = 0 then
          CopyIfMissing(ARelDir + '\' + Found.Name);
      until FindNext(Found) <> 0;
      finally
        FindClose(Found);
      end;
  end;

begin
  SrcDirs[0] := IncludeTrailingPathDelimiter(ADprDir);
  SrcDirs[1] := ExtractFilePath(Application.ExeName);
  DstDir := IncludeTrailingPathDelimiter(AExeDir);
  if CompareText(SrcDirs[0], DstDir) = 0 then
    Exit;   // exe рядом с .dpr - файлы и так на месте
  Copied := 0;
  Merged := 0;
  if FileExists(DstDir + 'editor.ini') then
  begin
    for SrcIdx := Low(SrcDirs) to High(SrcDirs) do
      if FileExists(SrcDirs[SrcIdx] + 'editor.ini') then
      begin
        if CompareText(ExpandFileName(SrcDirs[SrcIdx] + 'editor.ini'),
                       ExpandFileName(DstDir + 'editor.ini')) <> 0 then
          Merged := MergeOwnSettings(SrcDirs[SrcIdx] + 'editor.ini',
                                     DstDir + 'editor.ini');
        Break;
      end;
  end
  else
  begin
    CopyIfMissing('editor.ini');
    // Копия настроек того же компьютера: [Path] - папка нового exe, иначе
    // при запуске он счёл бы файл чужим (SelectEditorIni) и убрал проекты
    if FileExists(DstDir + 'editor.ini') then
      IniSetPath(DstDir + 'editor.ini', DstDir);
  end;
  CopyIfMissing('IDE.clr');
  CopyDirIfMissing('schemes');
  // Описание компонентов RapidQ для инспектора (RapidQComponentsReady)
  CopyIfNewer('rapidq_ref\ComponentAll.data');
  CopyIfMissing('rapidq_ref\Component.data');
  CopyIfMissing('rapidq_ref\Component1.data');
  // Справка RapidQ (Help - RapidQ, F1): CHM и слова для F1 (RqHelp)
  CopyIfNewer('rapidq_ref\help\rapidq.chm');
  CopyIfNewer('rapidq_ref\help\keywords.txt');
  // Руководство FreeBASIC (Help - FreeBASIC, F1): fb_ref\gen_fb_chm.py
  CopyIfNewer('fb_ref\help\freebasic.chm');
  CopyIfNewer('fb_ref\help\fbkeywords.txt');
  // Руководство unIDE (Help - unIDE manual)
  CopyIfNewer('unide_ref\help\unide.chm');
  if Copied > 0 then
    LogComp(Format('Рядом с exe скопировано файлов: %d (editor.ini, IDE.clr, ' +
    'schemes, rapidq_ref\Component*.data - которых там не было или ' +
    'были старее)', [Copied]));
                   if Merged > 0 then
                   LogComp(Format('editor.ini рядом с exe: изменено разделов: %d. Пути, ' +
      'которых нет на диске, при запуске берутся из копий [...Old<N>]',
                                  [Merged]));
end;

// Можно ли записать exe; занят - переименовать его в <имя>.exe.old (или
// .old1, .old2, если прежние ещё заняты). False - занят и не переименовался.
function TForm1.FreeBusyExe(const AExe: string): Boolean;
var
  Probe: THandle;
  OldName: string;
  OldNum: Integer;
begin
  Result := True;
  if not FileExists(AExe) then
    Exit;
  Probe := CreateFile(PChar(AExe), GENERIC_WRITE, 0, nil, OPEN_EXISTING,
                      FILE_ATTRIBUTE_NORMAL, 0);
  if Probe <> INVALID_HANDLE_VALUE then
  begin
    CloseHandle(Probe);
    Exit;   // свободен
  end;
  // .old прошлых сборок, чьи программы уже закрыты, - убрать
  DeleteOldExes(AExe);
  OldName := AExe + '.old';
  OldNum := 1;
  while FileExists(OldName) and (OldNum <= 20) do
  begin
    OldName := AExe + '.old' + IntToStr(OldNum);
    Inc(OldNum);
  end;
  if MoveFile(PChar(AExe), PChar(OldName)) then
  begin
    LogComp(ExtractFileName(AExe) + ' занят (программа запущена) - ' +
    'переименован в ' + ExtractFileName(OldName) + ', новый ' +
    'собирается под прежним именем');
            Exit;
  end;
  LogComp('Компиляция: ' + AExe + ' занят, и переименовать его не удалось (' +
          SysErrorMessage(GetLastError) + ')');
  Result := False;
end;

// Удалить <exe>.old* - прежние exe, переименованные при сборке. Файл, чья
// программа ещё работает, не удалится - останется до следующего раза.
procedure TForm1.DeleteOldExes(const AExe: string);
var
  Found: TSearchRec;
  Dir: string;
begin
  Dir := ExtractFilePath(AExe);
  if FindFirst(AExe + '.old*', faAnyFile, Found) = 0 then
  try
    repeat
      if (Found.Attr and faDirectory) = 0 then
        DeleteFile(Dir + Found.Name);
    until FindNext(Found) <> 0;
  finally
    FindClose(Found);
  end;
end;

// Запуск собранного exe. Ждать завершения нельзя: запущенная программа
// живёт своей жизнью, а среда должна остаться отзывчивой, поэтому дескрипторы
// процесса закрываются сразу.
//
// Рабочая папка - папка exe: программа ищет рядом с собой свои файлы, и
// при запуске из среды это должно работать так же, как при запуске из
// проводника.
procedure TForm1.RunTarget;
var
  Dpr, Exe, Dir, Cmd, ErrText: string;
  SI: TStartupInfo;
  PI: TProcessInformation;
  Con: TRunConsole;
  RapidQ: Boolean;
  Kind, OutKind, Bits: Integer;
begin
  ShowCompLog;
  AutoSaveEditorFiles;

  Kind := CurBuildKind;
  if (Kind <> bkDelphi) and (Kind <> bkRapidQ) and (Kind <> bkFreeBasic) then
  begin
    LogComp('Запуск: сборщик ' + BuildKindName(Kind) + ' (' + FBuildReason +
    ') здесь пока не подключён');
            Exit;
  end;
  // RapidQ: exe рядом с главным .bas, отладчика Delphi для него нет
  RapidQ := Kind = bkRapidQ;
  if Kind = bkFreeBasic then
  begin
    // FreeBASIC: exe рядом с главным .bas; отладчика пока нет
    Dpr := FbTargetBas(False);
    if Dpr = '' then
    begin
      LogComp('Запуск: главный .bas не найден. Откройте его и соберите ' +
      'программу');
              Exit;
    end;
    FbBuildOf(Dpr, OutKind, Bits);
    if OutKind = fbOutDll then
    begin
      LogComp('Запуск: ' + ExtractFileName(Dpr) + ' собирается как DLL - ' +
      'запускать нечего. Вид результата - в рамке Project');
              Exit;
    end;
    Exe := RqFbConvertedExe(Dpr);   // перевод из _rqfb - exe выше
  end
  else if RapidQ then
  begin
    Dpr := RapidQTargetBas(False);
    if Dpr = '' then
    begin
      LogComp('Запуск: главный .bas не найден. Откройте его и соберите проект');
      Exit;
    end;
    Exe := RqFbConvertedExe(Dpr);   // перевод из _rqfb - exe выше
  end
  else
  begin
    Dpr := DelphiTargetDpr;
    if Dpr = '' then
    begin
      LogComp('Запуск: цель не задана. Откройте .dpr проекта или соберите его');
      Exit;
    end;
    Exe := DelphiRunExeOf(Dpr);   // у самого редактора - пробная сборка
  end;

  if not FileExists(Exe) then
  begin
    LogComp('Запуск: файл не найден - ' + Exe +
    '. Соберите проект кнопкой Compile');
            Exit;
  end;

  Dir := ExtractFilePath(Exe);
  Cmd := '"' + Exe + '"';

  // Есть точки останова - под отладчиком. Не вышло (нет .map, нет строк в
  // нём) - обычный запуск, причина уже в логе.
  if (Kind = bkDelphi) and DbgWanted then
    if DbgStart(Exe, Dir) then
      Exit;

  // RapidQ под отладчиком - только exe отладочной сборки (CompileRapidQ):
  // в обычном проверок точек нет
  if RapidQ and (RqCompOf(Dpr) = rqcRc) and RqDbgWantedFor(Dpr) then
  begin
    if (FRqDbgInstr <> nil) and (FRqDbgExe <> '') and
       (CompareText(FRqDbgExe, ExpandFileName(Exe)) = 0) and
       (FileAge(Exe) = FRqDbgExeAge) then
    begin
      if RqDbgLaunch(Exe, Dir) then
        Exit;
    end
    else
      LogComp('Отладчик RapidQ: ' + ExtractFileName(Exe) + ' собран без ' +
      'отладки - запуск без отладчика. Для отладки - Compile & Run');
  end;
  // Exe отладочной сборки без отладчика: без файла команды он идёт без
  // остановок
  if RapidQ and not FRqDbgOn and (FRqDbgInstr <> nil) and
     FileExists(FRqDbgInstr.CmdFile) then
    DeleteFile(FRqDbgInstr.CmdFile);

  // Консольная программа (RapidQ без $APPTYPE GUI, FreeBASIC, консольная
  // Delphi): окно после её конца не закрывается до клавиши, а его текст
  // идёт в лог - иначе сообщение об ошибке при старте не прочитать
  if ExeIsConsole(Exe) then
  begin
    if not RunConsoleStart(Exe, Dir, PI.hProcess, Con, ErrText) then
    begin
      LogComp('Запуск не удался: ' + Exe + ' (' + ErrText + ')');
      Exit;
    end;
    if FRunCons = nil then
      FRunCons := TList.Create;
    FRunCons.Add(Con);
    RunAdd(ExpandFileName(Exe), PI.hProcess);
    FRunExeTick := 0;
    LogComp('--- Запуск: ' + Exe + ' (консоль: после конца программы окно ' +
            'ждёт клавишу, его текст - сюда)');
    if FEnv.MinimizeOnRun then
    begin
      FRunMinimized := True;
      Application.Minimize;
    end;
    Exit;
  end;

  FillChar(SI, SizeOf(SI), 0);
  SI.cb := SizeOf(SI);

  if not CreateProcess(nil, PChar(Cmd), nil, nil, False, 0,
                       nil, PChar(Dir), SI, PI) then
  begin
    LogComp('Запуск не удался: ' + Exe);
    Exit;
  end;

  CloseHandle(PI.hThread);
  // За запущенной программой следим всегда: пока она работает, Compile &
  // Run на вкладках с этой целью серая, а Program reset её останавливает
  // (как в Delphi). На вкладке с другой целью можно собрать и запустить
  // другую программу. Когда закроются все, вернётся и форма конструктора,
  // если запуск её прятал.
  RunAdd(ExpandFileName(Exe), PI.hProcess);
  FRunExeTick := 0;   // цель могла записаться при сборке - пересчитать
  LogComp('--- Запуск: ' + Exe);
  // Preferences - Minimize on run (запуск без отладчика): среда
  // развернётся, когда программа закроется (RunTimerTick)
  if FEnv.MinimizeOnRun then
  begin
    FRunMinimized := True;
    Application.Minimize;
  end;
end;

procedure TForm1.btnRunClick(Sender: TObject);
begin
  if FDbgSession <> nil then
  begin
    DbgResume;
    Exit;
  end;
  if RqDbgHere then
  begin
    RqDbgCommand(RqDbgModeRun, 0);
    Exit;
  end;
  // Скетч: запуск - это загрузка в плату, а загрузка у arduino-cli
  // compile идёт вместе со сборкой (как Upload в Arduino IDE)
  if CurBuildKind = bkArduino then
  begin
    if FBusyDepth = 0 then
      CompileArduino(True);
    Exit;
  end;
  DsgHideForRun;
  RunTarget;
  if (RunHere = 0) and (FDbgSession = nil) then
    DsgShowAfterRun;
end;

// ---------------------------------------------------------------------------
//  Отладчик: точки останова, остановка, продолжение (этап 1), шаги по
//  строкам и Run to cursor (этап 2)
//
//  Точка ставится и снимается щелчком по номеру строки или F5 на строке с
//  кареткой. Пока точки есть, сборка отладочная (см. CompileDelphi), а Run
//  запускает программу под отладчиком (DbgEngine). На точке программа
//  стоит, строка показана в редакторе; F9 или Run - дальше, Ctrl+F2 или
//  Program reset - снять программу.
//
//  На остановке: F8 (Step over) - до следующей строки, вызовы проходятся
//  целиком; F7 (Trace into) - с заходом в процедуры, у которых есть номера
//  строк; F4 (Run to cursor) - до строки с кареткой. Пока программа не
//  запущена, F7 и F8 собирают и запускают её с остановкой на begin
//  главного блока .dpr, F4 - с остановкой на строке с кареткой.
//
//  Адреса строк - из .map рядом с exe. Строка без кода в .map (пустая,
//  объявление, модуль без отладочной информации) - точка серая и не
//  сработает.
// ---------------------------------------------------------------------------

const
  DbgStartNone  = 0;   // обычный Run
  DbgStartStep  = 1;   // F7/F8 до запуска: стоп на begin .dpr
  DbgStartRunTo = 2;   // F4 до запуска: стоп на строке FDbgRunToLine

constructor TBreakMark.Create(const AFileName: string; ALine: Integer);
begin
  inherited Create;
  FileName := AFileName;
  Line := ALine;
  Offsets := TList.Create;
end;

destructor TBreakMark.Destroy;
begin
  Offsets.Free;
  inherited;
end;

// Сборка и запуск - с отладчиком: есть хотя бы одна точка или запуск с
// F7/F8/F4. Пробная сборка конструктора форм - никогда.
// RapidQ под отладчиком: точка останова в главном .bas этой программы или
// в её $INCLUDE-файле (с вложенными), или запуск с F7/F8/F4. Точки в
// других файлах (другая программа) отладку не включают. Пробная сборка
// снимка - никогда (CompileRapidQ).
function TForm1.RqDbgWantedFor(const ABas: string): Boolean;
var
  MarkIdx: Integer;
  AllInc: TStringList;
  MarkFile: string;
begin
  Result := FDbgStartMode <> DbgStartNone;
  if Result or (ABas = '') or (FBreakMarks = nil) or
     (FBreakMarks.Count = 0) then
    Exit;
  AllInc := TStringList.Create;
  try
    AllInc.Add(ExpandFileName(ABas));
    RqDbgIncludeSet(ABas, AllInc, nil);
    for MarkIdx := 0 to FBreakMarks.Count - 1 do
    begin
      MarkFile := ExpandFileName(TBreakMark(FBreakMarks[MarkIdx]).FileName);
      if AllInc.IndexOf(MarkFile) >= 0 then
      begin
        Result := True;
        Exit;
      end;
    end;
  finally
    AllInc.Free;
  end;
end;

// $INCLUDE-файлы программы ABas, с вложенными, по порядку строк; файл, уже
// встреченный выше, второй раз не смотрится (как у вкладки Includes и
// отладочной копии). AAll - все найденные (пути ExpandFileName). AInline
// (может быть nil) - те, что идут в отладочную копию: с точкой останова,
// открытые на вкладке с этим главным .bas (IncOwner), файл Run to cursor
// при запуске с F4 - и все include по пути к ним от главного (иначе rc.exe
// взял бы их исходные файлы).
procedure TForm1.RqDbgIncludeSet(const ABas: string; AAll, AInline: TStrings);
const
  MaxDepth = 20;
var
  MainDir, IncDir, IgnoredDir: string;
  Visited, Chain: TStringList;

  function Wanted(const AFull: string): Boolean;
  var
    MarkIdx, WinIdx: Integer;
  begin
    Result := True;
    if FBreakMarks <> nil then
      for MarkIdx := 0 to FBreakMarks.Count - 1 do
        if CompareText(ExpandFileName(TBreakMark(FBreakMarks[MarkIdx]).FileName),
                       AFull) = 0 then
          Exit;
    for WinIdx := 0 to WindowsItemCount - 1 do
      if FWindows[WinIdx].Used and (FWindows[WinIdx].IncOwner <> '') and
         (CompareText(ExpandFileName(FWindows[WinIdx].FileName), AFull) = 0) and
         (CompareText(ExpandFileName(FWindows[WinIdx].IncOwner),
                      ExpandFileName(ABas)) = 0) then
        Exit;
    if (FDbgStartMode = DbgStartRunTo) and (FDbgRunToFile <> '') and
       (CompareText(ExpandFileName(FDbgRunToFile), AFull) = 0) then
      Exit;
    Result := False;
  end;

  procedure AddInline(const AFull: string);
  begin
    if (AInline <> nil) and (AInline.IndexOf(AFull) < 0) then
      AInline.Add(AFull);
  end;

  procedure Walk(const AFile: string; ADepth: Integer);
  var
    FileLines: TStringList;
    LineIdx, ChainIdx: Integer;
    IncName, Full: string;
  begin
    FileLines := TStringList.Create;
    try
      try
        FileLines.LoadFromFile(AFile);
      except
        Exit;
      end;
      for LineIdx := 0 to FileLines.Count - 1 do
      begin
        IncName := RapidQIncludeName(FileLines[LineIdx]);
        if IncName = '' then
          Continue;
        Full := RapidQResolveInclude(IncName, MainDir, IncDir);
        if Full = '' then
          Continue;
        Full := ExpandFileName(Full);
        if Visited.IndexOf(Full) >= 0 then
          Continue;
        Visited.Add(Full);
        if (AAll <> nil) and (AAll.IndexOf(Full) < 0) then
          AAll.Add(Full);
        if Wanted(Full) then
        begin
          for ChainIdx := 0 to Chain.Count - 1 do
            AddInline(Chain[ChainIdx]);
          AddInline(Full);
        end;
        if ADepth < MaxDepth then
        begin
          Chain.Add(Full);
          Walk(Full, ADepth + 1);
          Chain.Delete(Chain.Count - 1);
        end;
      end;
    finally
      FileLines.Free;
    end;
  end;

begin
  if ABas = '' then
    Exit;
  // Папка поиска - папка главного .bas, как у копии (RqDbgBuild)
  RapidQIncludeDirs(IgnoredDir, IncDir);
  MainDir := ExtractFilePath(ExpandFileName(ABas));
  Visited := TStringList.Create;
  Chain := TStringList.Create;
  try
    Visited.Add(ExpandFileName(ABas));
    Walk(ABas, 1);
  finally
    Chain.Free;
    Visited.Free;
  end;
end;

// ---------------------------------------------------------------------------
//  Панель объявления для исходников RapidQ (DeclPanelUpdate зовёт
//  DeclPanelUpdateRq). Разбор - RqDeclFind: DIM, CONST, CREATE, DEF*,
//  SUB/FUNCTION, DECLARE, TYPE и его члены, $DEFINE, $RESOURCE, метки;
//  параметры и DIM внутри процедуры - только в ней.
//  Порядок поиска: локальные процедуры под кареткой; члены TYPE, внутри
//  которого каретка; затем объявления в этом файле, главном .bas и
//  $INCLUDE-файлах по порядку подключения - первое найденное. После
//  точки (Obj.Имя, .Имя в WITH) -
//  сначала члены TYPE, потом остальное.
//  Не нашлось - неявная переменная (без DIM): первое присваивание вне
//  процедур, иначе первое в своей процедуре; в панели - её тип по
//  суффиксу или $OPTION DIM.
// ---------------------------------------------------------------------------

// Вкладка - исходник RapidQ: .bas, .rqb, .rq; .inc и .bi - когда вкладка
// собирается RapidQ
function TForm1.DeclRqMode: Boolean;
var
  Ext: string;
begin
  Ext := LowerCase(ExtractFileExt(FCurrentFileName));
  Result := (IsRapidQSource(FCurrentFileName) or (Ext = '.inc') or
             (Ext = '.bi')) and (CurBuildKind = bkRapidQ);
end;

// Файлы, где ищется объявление (кроме самой вкладки): главный .bas вкладки
// и $INCLUDE-файлы - его и самой вкладки, с вложенными, по порядку строк.
// Обход читает файлы с диска, поэтому список держится 10 секунд, пока не
// сменились вкладка и главный файл.
procedure TForm1.RqDeclFileList(AFiles: TStrings);
var
  MainBas, CurFull, Key: string;
  Found: TStringList;
  FileIdx: Integer;
begin
  AFiles.Clear;
  MainBas := RapidQTargetBas(False);
  Key := UpperCase(FCurrentFileName + '|' + MainBas);
  if (FRqDeclFiles <> nil) and (Key = FRqDeclFilesKey) and
     (GetTickCount - FRqDeclFilesTick < 10000) then
  begin
    AFiles.Assign(FRqDeclFiles);
    Exit;
  end;
  if FRqDeclFiles = nil then
    FRqDeclFiles := TStringList.Create;
  FRqDeclFiles.Clear;
  CurFull := '';
  if FCurrentFileName <> '' then
    CurFull := ExpandFileName(FCurrentFileName);
  Found := TStringList.Create;
  try
    if (MainBas <> '') and FileExists(MainBas) then
    begin
      Found.Add(ExpandFileName(MainBas));
      RqDbgIncludeSet(MainBas, Found, nil);
    end;
    if (CurFull <> '') and FileExists(CurFull) then
      RqDbgIncludeSet(CurFull, Found, nil);
    for FileIdx := 0 to Found.Count - 1 do
      if (CompareText(Found[FileIdx], CurFull) <> 0) and
         (FRqDeclFiles.IndexOf(Found[FileIdx]) < 0) then
        FRqDeclFiles.Add(Found[FileIdx]);
  finally
    Found.Free;
  end;
  FRqDeclFilesKey := Key;
  FRqDeclFilesTick := GetTickCount;
  AFiles.Assign(FRqDeclFiles);
end;

// Строки файла AFile: из его вкладки, если он открыт (там могут быть
// несохранённые правки), иначе с диска. False - не прочитался.
function TForm1.RqDeclLoadLines(const AFile: string; ALines: TStrings): Boolean;
var
  WinIdx: Integer;
begin
  Result := False;
  WinIdx := IndexOfWindowByFile(AFile);
  if WinIdx >= 0 then
  begin
    ALines.Text := FWindows[WinIdx].Text;
    Result := True;
    Exit;
  end;
  try
    ALines.LoadFromFile(AFile);
    Result := True;
  except
    // файл занят или пропал
  end;
end;

procedure TForm1.DeclPanelUpdateRq;
var
  Sel: TCharRange;
  Line, LineStart, CharPos, WordStart, WordEnd, LineIdx: Integer;
  FileIdx, Found, PassIdx: Integer;
  SrcLines, Files, FileLines: TStringList;
  LineText, CleanText, WordUp, OwnerType, FoundFile, Suffix, DefType: string;
  InBrem, AfterDot, OwnIndex, IsImplicit: Boolean;
  CurIndex, FileIndex, FoundIndex: TRqDeclIndex;
  Kinds: array[0..1] of TRqDeclKind;
  Item: TRqDeclItem;

  // Объявление вида AKind: в этом файле, затем в файлах Files по порядку.
  // Нашлось - FoundIndex, Found, FoundFile ('' - этот файл), OwnIndex.
  function SearchKind(AKind: TRqDeclKind): Boolean;
  var
    SearchIdx: Integer;
  begin
    Result := True;
    Found := CurIndex.Find(WordUp, AKind, Line, '');
    if Found >= 0 then
    begin
      FoundIndex := CurIndex;
      Exit;
    end;
    for SearchIdx := 0 to Files.Count - 1 do
    begin
      // Открытый на вкладке - по тексту вкладки, остальные - из кэша
      if IndexOfWindowByFile(Files[SearchIdx]) >= 0 then
      begin
        if not RqDeclLoadLines(Files[SearchIdx], FileLines) then
          Continue;
        FileIndex := TRqDeclIndex.Create;
        FileIndex.Build(FileLines);
        Found := FileIndex.Find(WordUp, AKind, 0, '');
        if Found < 0 then
        begin
          FileIndex.Free;
          Continue;
        end;
        // Этот разбор создан здесь - освобождается в конце
        OwnIndex := True;
      end
      else
      begin
        FileIndex := FRqDeclCache.IndexOfFile(Files[SearchIdx]);
        if FileIndex = nil then
          Continue;
        Found := FileIndex.Find(WordUp, AKind, 0, '');
        if Found < 0 then
          Continue;
      end;
      FoundIndex := FileIndex;
      FoundFile := Files[SearchIdx];
      Exit;
    end;
    Result := False;
  end;

begin
  SendMessageA(RichEdit1.Handle, EM_EXGETSEL, 0, Integer(@Sel));
  Line := SendMessageA(RichEdit1.Handle, EM_EXLINEFROMCHAR, 0, Sel.cpMin);
  LineStart := SendMessageA(RichEdit1.Handle, EM_LINEINDEX, Line, 0);
  OwnIndex := False;
  FoundIndex := nil;

  SrcLines := TStringList.Create;
  Files := TStringList.Create;
  FileLines := TStringList.Create;
  CurIndex := TRqDeclIndex.Create;
  try
    SrcLines.Text := GetEditorText;
    if (Line < 0) or (Line >= SrcLines.Count) then
    begin
      DeclPanelShow;
      Exit;
    end;

    // Строка под кареткой очищенная (комментарии, строки, brem - пробелами)
    InBrem := False;
    CleanText := '';
    for LineIdx := 0 to Line do
      CleanText := RqDeclCleanLine(SrcLines[LineIdx], InBrem);

    // Имя под кареткой. Каретка сразу за именем или за его суффиксом
    // ($ % & ! # ?) - тоже оно.
    LineText := SrcLines[Line];
    CharPos := Sel.cpMin - LineStart + 1;
    if (CharPos > Length(LineText)) or (CharPos < 1) or
       not RqDeclIdChar(LineText[CharPos]) then
      Dec(CharPos);
    while (CharPos > 1) and (CharPos <= Length(LineText)) and
          RqDeclSuffix(LineText[CharPos]) do
      Dec(CharPos);
    if (CharPos < 1) or (CharPos > Length(LineText)) or
       not RqDeclIdChar(LineText[CharPos]) or
       (CharPos > Length(CleanText)) or (CleanText[CharPos] = ' ') then
    begin
      DeclPanelShow;
      Exit;
    end;
    WordStart := CharPos;
    while (WordStart > 1) and RqDeclIdChar(LineText[WordStart - 1]) do
      Dec(WordStart);
    WordEnd := CharPos;
    while (WordEnd < Length(LineText)) and RqDeclIdChar(LineText[WordEnd + 1]) do
      Inc(WordEnd);
    if not RqDeclIdStart(LineText[WordStart]) then
    begin
      DeclPanelShow;
      Exit;
    end;
    // Директива ($INCLUDE, $DEFINE) - не имя
    if (WordStart > 1) and (LineText[WordStart - 1] in ['$', '#']) then
    begin
      DeclPanelShow;
      Exit;
    end;
    while (WordEnd < Length(LineText)) and RqDeclSuffix(LineText[WordEnd + 1]) do
      Inc(WordEnd);
    FDeclWord := Copy(LineText, WordStart, WordEnd - WordStart + 1);
    WordUp := RqDeclStrip(FDeclWord);
    if RqDeclIsKeyword(WordUp) then
    begin
      DeclPanelShow;
      Exit;
    end;
    AfterDot := (WordStart > 1) and (LineText[WordStart - 1] = '.');

    FDeclFromPos := Sel.cpMin;
    FDeclFromLine := Line;
    CurIndex.Build(SrcLines);
    FoundIndex := nil;
    FoundFile := '';
    OwnIndex := False;
    Found := -1;

    // Локальные процедуры, члены своего TYPE
    if not AfterDot then
      Found := CurIndex.Find(WordUp, rdkLocal, Line, '');
    if Found < 0 then
    begin
      OwnerType := CurIndex.TypeAt(Line);
      if OwnerType <> '' then
        Found := CurIndex.Find(WordUp, rdkMember, Line, OwnerType);
    end;
    IsImplicit := False;
    RqDeclFileList(Files);
    if FRqDeclCache = nil then
      FRqDeclCache := TRqDeclCache.Create;
    if Found >= 0 then
      FoundIndex := CurIndex
    else
    begin
      if AfterDot then
      begin
        Kinds[0] := rdkMember;
        Kinds[1] := rdkGlobal;
      end
      else
      begin
        Kinds[0] := rdkGlobal;
        Kinds[1] := rdkMember;
      end;
      for PassIdx := 0 to 1 do
        if SearchKind(Kinds[PassIdx]) then
          Break;
    end;

    // Без DIM - неявная переменная: первое присваивание вне процедур (в
    // этом файле, главном .bas, $INCLUDE), иначе первое в своей процедуре
    if (FoundIndex = nil) and not AfterDot then
    begin
      if SearchKind(rdkImplicitGlobal) then
        IsImplicit := True
      else
      begin
        Found := CurIndex.Find(WordUp, rdkImplicitLocal, Line, '');
        if Found >= 0 then
        begin
          FoundIndex := CurIndex;
          IsImplicit := True;
        end;
      end;
    end;

    if FoundIndex = nil then
    begin
      FDeclLine := -1;
      FDeclMode := 1;
      FDeclNoneText := FDeclWord + ': объявление не найдено ни в этом файле, ' +
      'ни в главном .bas и его $INCLUDE-файлах';
if RqFindClass(WordUp) <> nil then
        FDeclNoneText := FDeclWord + ': класс RapidQ (встроенный или из ' +
        'описания компонентов), объявления в исходниках нет';
DeclPanelShow;
      Exit;
    end;

    Item := FoundIndex.Item(Found);
    FDeclLine := Item.Line;
    FDeclCol := Item.Col;
    if FoundFile = '' then
      FDeclText := Trim(StringReplace(SrcLines[Item.Line], #9, ' ',
                                      [rfReplaceAll]))
    else
    begin
      FDeclOtherFile := FoundFile;
      if IndexOfWindowByFile(FoundFile) < 0 then
        RqDeclLoadLines(FoundFile, FileLines);
      if Item.Line < FileLines.Count then
        FDeclText := Trim(StringReplace(FileLines[Item.Line], #9, ' ',
                                        [rfReplaceAll]))
      else
        FDeclText := '';
    end;
    // Неявной - тип: по суффиксу (как в щелчке, иначе как в присваивании),
    // без суффикса - $OPTION DIM (этот файл, затем остальные по порядку)
    if IsImplicit then
    begin
      Suffix := RqDeclSuffixOf(FDeclWord);
      if Suffix = '' then
        Suffix := Item.Suffix;
      DefType := CurIndex.OptionDim;
      FileIdx := 0;
      while (DefType = '') and (FileIdx < Files.Count) do
      begin
        FileIndex := FRqDeclCache.IndexOfFile(Files[FileIdx]);
        if FileIndex <> nil then
          DefType := FileIndex.OptionDim;
        Inc(FileIdx);
      end;
      FDeclText := '[без DIM, ' + RqDeclSuffixType(Suffix, DefType) + '] ' +
                   FDeclText;
    end;
    FDeclMode := 2;
  finally
    if OwnIndex then
      FoundIndex.Free;
    CurIndex.Free;
    FileLines.Free;
    Files.Free;
    SrcLines.Free;
  end;
  DeclPanelShow;
end;

// Точка копии сеанса на строке ALine (с 0, по тексту сборки) файла AFile;
// 0 - файла нет в копии или на строке нет кода
function TForm1.RqDbgPointAt(const AFile: string; ALine: Integer): Integer;
var
  FileIdx: Integer;
begin
  Result := 0;
  if (FRqDbgInstr = nil) or (ALine < 0) then
    Exit;
  FileIdx := FRqDbgInstr.FileIndex(AFile);
  if FileIdx >= 0 then
    Result := FRqDbgInstr.PointOfLine(FileIdx, ALine);
end;

function TForm1.DbgWanted: Boolean;
begin
  Result := (((FBreakMarks <> nil) and (FBreakMarks.Count > 0)) or
             (FDbgStartMode <> DbgStartNone)) and not FProbeActive;
end;

function TForm1.DbgMarkAt(const AFileName: string;
                          ALine: Integer): TBreakMark;
var
  MarkIdx: Integer;
begin
  Result := nil;
  if FBreakMarks = nil then
    Exit;
  for MarkIdx := 0 to FBreakMarks.Count - 1 do
    if (TBreakMark(FBreakMarks[MarkIdx]).Line = ALine) and
       (CompareText(TBreakMark(FBreakMarks[MarkIdx]).FileName,
                    AFileName) = 0) then
    begin
      Result := TBreakMark(FBreakMarks[MarkIdx]);
      Exit;
    end;
end;

// Что показать на строке текущего файла: 0 - ничего, 1 - точка останова,
// 2 - точка на строке без кода, 3 - программа стоит на этой строке
function TForm1.DbgLineKind(ALine: Integer): Integer;
var
  Mark: TBreakMark;
begin
  Result := 0;
  if FCurrentFileName = '' then
    Exit;
  if (FDbgExecFile <> '') and (ALine = FDbgExecLine) and
     (CompareText(FDbgExecFile, FCurrentFileName) = 0) then
  begin
    Result := 3;
    Exit;
  end;
  if (FBreakMarks = nil) or (FBreakMarks.Count = 0) then
    Exit;
  Mark := DbgMarkAt(FCurrentFileName, ALine);
  if Mark = nil then
    Exit;
  if Mark.NoCode then
    Result := 2
  else
    Result := 1;
end;

// Есть ли в текущем файле что-то, чьи номера строк едут при правке
function TForm1.DbgMarksInCurrent: Boolean;
var
  MarkIdx: Integer;
begin
  Result := False;
  if FCurrentFileName = '' then
    Exit;
  if (FDbgExecFile <> '') and
     (CompareText(FDbgExecFile, FCurrentFileName) = 0) then
  begin
    Result := True;
    Exit;
  end;
  if FBreakMarks = nil then
    Exit;
  for MarkIdx := 0 to FBreakMarks.Count - 1 do
    if CompareText(TBreakMark(FBreakMarks[MarkIdx]).FileName,
                   FCurrentFileName) = 0 then
    begin
      Result := True;
      Exit;
    end;
end;

procedure TForm1.DbgRepaint;
begin
  if PaintBox1 <> nil then
    PaintBox1.Invalidate;
  if RichEdit1.HandleAllocated then
    InvalidateRect(RichEdit1.Handle, nil, False);
end;

// Адреса точки в идущем сеансе, по .map сеанса
procedure TForm1.DbgResolveMark(AMark: TBreakMark);
var
  BuildLine: Integer;
begin
  AMark.Offsets.Clear;
  AMark.NoCode := False;
  if FDbgSession = nil then
    Exit;
  // Строка точки - по нынешнему тексту, .map - по тексту сборки. Строка,
  // вставленная после сборки, кода в exe не имеет.
  BuildLine := DbgLineThen(AMark.FileName, AMark.Line);
  if BuildLine >= 0 then
    FDbgSession.Map.OffsetsOfLine(ExtractFileName(AMark.FileName),
                                  BuildLine + 1, AMark.Offsets);
  AMark.NoCode := AMark.Offsets.Count = 0;
  if AMark.NoCode then
    LogComp('Точка останова: ' + ExtractFileName(AMark.FileName) +
    ', строка ' + IntToStr(AMark.Line + 1) + ' - в .map у неё ' +
    'нет кода (пустая строка, объявление или модуль собран без ' +
    'отладочной информации), точка не сработает');
end;

// Снять адреса точки в идущем сеансе
procedure TForm1.DbgMarkOff(AMark: TBreakMark);
var
  OfsIdx: Integer;
begin
  if (FDbgSession <> nil) and not FDbgSession.Finished then
    for OfsIdx := 0 to AMark.Offsets.Count - 1 do
      FDbgSession.SetBreakpoint(Cardinal(AMark.Offsets[OfsIdx]), False);
  AMark.Offsets.Clear;
end;

procedure TForm1.DbgToggleBreak(ALine: Integer);
var
  Mark: TBreakMark;
  OfsIdx: Integer;
begin
  if ALine < 0 then
    Exit;
  if FCurrentFileName = '' then
  begin
    LogComp('Точка останова: файл не сохранён на диск');
    Exit;
  end;
  Mark := DbgMarkAt(FCurrentFileName, ALine);
  if Mark <> nil then
  begin
    DbgMarkOff(Mark);
    FBreakMarks.Remove(Mark);
    Mark.Free;
  end
  else
  begin
    Mark := TBreakMark.Create(FCurrentFileName, ALine);
    FBreakMarks.Add(Mark);
    // Программа уже идёт - точка сразу в неё
    if (FDbgSession <> nil) and not FDbgSession.Finished then
    begin
      DbgResolveMark(Mark);
      for OfsIdx := 0 to Mark.Offsets.Count - 1 do
        FDbgSession.SetBreakpoint(Cardinal(Mark.Offsets[OfsIdx]), True);
    end;
    // RapidQ: точки программа берёт из команды на остановке
    if FRqDbgOn then
      RqDbgResolveMark(Mark);
  end;
  DbgRepaint;
end;

// Условие точки останова строки ALine (RapidQ): ввод; точки нет - она
// ставится с этим условием. Пустое условие - точка без условия. Условие
// вписывается в отладочную копию при сборке: заданное во время сеанса
// действует после пересборки (до неё точка не срабатывает).
procedure TForm1.DbgEditCondition(ALine: Integer);
var
  Mark: TBreakMark;
  CondText: string;
begin
  if ALine < 0 then
    Exit;
  if FCurrentFileName = '' then
  begin
    LogComp('Условие точки останова: файл не сохранён на диск');
    Exit;
  end;
  if not IdeBasicMode then
  begin
    LogComp('Условие точки останова: есть только у отладчика RapidQ');
    Exit;
  end;
  Mark := DbgMarkAt(FCurrentFileName, ALine);
  CondText := '';
  if Mark <> nil then
    CondText := Mark.Condition;
  if not InputQuery('Breakpoint condition', 'Строка ' + IntToStr(ALine + 1) +
  ': условие RapidQ (пусто - без условия)', CondText) then
                    Exit;
                    CondText := Trim(CondText);
                    if (CondText <> '') and not RqDbgExprInsertable(CondText) then
  begin
    ShowMessage('Условие не вписать в код: в нём ":" или комментарий ''. ' +
    'Нужно одно выражение, например  SumIdx = 2  или  ' +
    'Count > 10 AND Name$ = "abc"');
                Exit;
  end;
  if Mark = nil then
  begin
    if CondText = '' then
      Exit;
    Mark := TBreakMark.Create(FCurrentFileName, ALine);
    FBreakMarks.Add(Mark);
  end;
  if Mark.Condition = CondText then
    Exit;
  Mark.Condition := CondText;
  if CondText <> '' then
    LogComp('Точка останова: ' + ExtractFileName(FCurrentFileName) +
    ', строка ' + IntToStr(ALine + 1) + ', условие: ' + CondText)
  else
    LogComp('Точка останова: ' + ExtractFileName(FCurrentFileName) +
    ', строка ' + IntToStr(ALine + 1) + ' - без условия');
            if FRqDbgOn then
            RqDbgResolveMark(Mark);
            DbgRepaint;
end;

// Щелчок по номеру строки - точка останова на этой строке
procedure TForm1.PaintBox1MouseDown(Sender: TObject; Button: TMouseButton;
                                    Shift: TShiftState; X, Y: Integer);
var
  LineIdx, LineTotal: Integer;
begin
  if not (Button in [mbLeft, mbRight]) or (LineHeight <= 0) or
     (Y < YOffset) or not RichEdit1.HandleAllocated then
    Exit;
  LineIdx := FirstVisibleLine + (Y - YOffset) div LineHeight;
  LineTotal := SendMessageA(RichEdit1.Handle, EM_GETLINECOUNT, 0, 0);
  if (LineIdx < 0) or (LineIdx >= LineTotal) then
    Exit;
  // Правая кнопка - условие точки останова (RapidQ)
  if Button = mbRight then
    DbgEditCondition(LineIdx)
  else
    DbgToggleBreak(LineIdx);
end;

// Запуск под отладчиком. False - не вышло (нет .map или в нём нет номеров
// строк): RunTarget запустит программу как обычно.
function TForm1.DbgStart(const AExe, ADir: string): Boolean;
var
  MapFile: string;
  Map: TDbgLineMap;
  MarkIdx, OfsIdx, Armed: Integer;
  Mark: TBreakMark;
  Targets: TList;
begin
  Result := False;
  MapFile := ChangeFileExt(AExe, '.map');
  if not FileExists(MapFile) then
  begin
    LogComp('Отладчик: нет ' + MapFile + ' - программа запускается без ' +
    'отладчика');
            Exit;
  end;
  Map := TDbgLineMap.Create;
  if not Map.LoadFromFile(MapFile) then
  begin
    Map.Free;
    LogComp('Отладчик: в ' + ExtractFileName(MapFile) + ' нет номеров ' +
    'строк (нужна сборка с -$D+ и -GD) - программа запускается без ' +
    'отладчика');
            Exit;
  end;

  FDbgSession := TDbgSession.Create(AExe, ADir, Map);
  DbgClearEdits;   // .map только что собран - номера совпадают с текстом
  // Отладочная информация TD32 - для окна Watch. Нет её - программа
  // отлаживается так же, только значения переменных не видны.
  FreeAndNil(FDbgSyms);
  FDbgSyms := TDbgSymbols.Create;
  if FDbgSyms.LoadFromExe(AExe, FDbgSymsError) then
  begin
    FDbgSymsError := '';
    LogComp(Format('Отладчик: TD32 - процедур %d, параметров и локальных ' +
    '%d, данных модулей %d', [FDbgSyms.ProcCount,
                   FDbgSyms.LocalCount, FDbgSyms.DataCount]));
  end
  else
  begin
    LogComp('Отладчик: окно Watch значений не покажет - ' + FDbgSymsError);
    FreeAndNil(FDbgSyms);
  end;
  FDbgSession.OnStopped := DbgStopped;
  FDbgSession.OnLog := DbgLog;
  FDbgSession.OnExited := DbgExited;

  Armed := 0;
  for MarkIdx := 0 to FBreakMarks.Count - 1 do
  begin
    Mark := TBreakMark(FBreakMarks[MarkIdx]);
    DbgResolveMark(Mark);
    for OfsIdx := 0 to Mark.Offsets.Count - 1 do
      FDbgSession.SetBreakpoint(Cardinal(Mark.Offsets[OfsIdx]), True);
    if not Mark.NoCode then
      Inc(Armed);
  end;

  // F7/F8 до запуска - стоп на входе (begin главного блока .dpr), F4 -
  // на строке с кареткой
  case FDbgStartMode of
    DbgStartStep:
      FDbgSession.StopAtEntry := True;
    DbgStartRunTo:
    begin
      Targets := TList.Create;
      try
        Map.OffsetsOfLine(ExtractFileName(FDbgRunToFile), FDbgRunToLine + 1,
                          Targets);
        if Targets.Count > 0 then
          FDbgSession.RunTo(Targets)
        else
          LogComp('Run to cursor: ' + ExtractFileName(FDbgRunToFile) +
          ', строка ' + IntToStr(FDbgRunToLine + 1) + ' - в .map ' +
          'у неё нет кода, программа идёт до точки останова');
      finally
        Targets.Free;
      end;
    end;
  end;

  FDbgSession.Start;
  LogComp(Format('--- Запуск под отладчиком: %s, точек останова: %d из %d',
                 [AExe, Armed, FBreakMarks.Count]));
  DbgRepaint;
  Result := True;
end;

// Программа встала на точке. Строка - по точке, у которой этот адрес (её
// номер уже учёл правки), иначе по .map.
procedure TForm1.DbgStopped(Sender: TObject; AOffset: Cardinal);
var
  MarkIdx: Integer;
  Mark: TBreakMark;
  SrcFile, MapName, Where: string;
  SrcLine, MapLine: Integer;
begin
  SrcFile := '';
  SrcLine := -1;
  for MarkIdx := 0 to FBreakMarks.Count - 1 do
  begin
    Mark := TBreakMark(FBreakMarks[MarkIdx]);
    if Mark.Offsets.IndexOf(Pointer(AOffset)) >= 0 then
    begin
      SrcFile := Mark.FileName;
      SrcLine := Mark.Line;
      Break;
    end;
  end;
  if (SrcFile = '') and (FDbgSession <> nil) and
     FDbgSession.Map.LineOfOffset(AOffset, MapName, MapLine) then
  begin
    SrcFile := ResolveErrorFile(MapName, Where);
    // Номер в .map - по тексту на момент сборки; правки за сеанс сдвигают
    SrcLine := DbgLineNow(SrcFile, MapLine - 1);
  end;

  // Окно среды - вперёд: программа стоит, работать теперь здесь
  if IsIconic(Application.Handle) then
    Application.Restore;
  SetForegroundWindow(Handle);

  if SrcFile = '' then
  begin
    LogComp(Format('--- Остановка по адресу со смещением $%.8x, строки ' +
    'для него в .map нет. Продолжить - Run (F9)', [AOffset]));
                   DbgRepaint;
                   DbgWatchRefresh;
                   Exit;
  end;

  LogComp('--- Остановка: ' + ExtractFileName(SrcFile) + ', строка ' +
          IntToStr(SrcLine + 1) + '. Дальше: F9 - Run, F8 - Step over, ' +
  'F7 - Trace into, F4 - Run to cursor, Ctrl+F2 - Program reset');
          FDbgExecFile := SrcFile;
          FDbgExecLine := SrcLine;
          if CompareText(FCurrentFileName, SrcFile) <> 0 then
          OpenNamedFile(SrcFile);
          if CompareText(FCurrentFileName, SrcFile) = 0 then
          GotoLine(SrcLine);
          DbgRepaint;
          DbgWatchRefresh;
  // Значение под мышью - подсказкой, пока программа стоит
          if FDbgHintTimer = nil then
  begin
    FDbgHintTimer := TTimer.Create(Self);
    FDbgHintTimer.Interval := CiTickMs;   // Code Insight - Delay
    FDbgHintTimer.OnTimer := DbgHintTimerTick;
  end;
  FDbgHintTimer.Enabled := True;
end;

procedure TForm1.DbgLog(Sender: TObject; const AText: string);
begin
  LogComp(AText);
end;

// Программа закрылась. Сеанс освобождается позже (WMDbgDone): сейчас идёт
// его собственный обработчик.
procedure TForm1.DbgExited(Sender: TObject; AExitCode: Cardinal);
begin
  LogComp(Format('--- Программа завершилась, код %d', [Integer(AExitCode)]));
  DbgClearExec;
  DbgWatchRefresh;
  PostMessage(Handle, WM_USER + 321, 0, 0);
  DsgShowAfterRun;
end;

procedure TForm1.WMDbgDone(var Msg: TMessage);
var
  MarkIdx: Integer;
begin
  if (FDbgSession = nil) or not FDbgSession.Finished then
    Exit;
  FreeAndNil(FDbgSession);
  FreeAndNil(FDbgSyms);
  DbgClearEdits;
  DbgWatchRefresh;
  // Адреса были только этого сеанса. NoCode остаётся до следующего
  // запуска - по нему видно, какие точки не сработали.
  for MarkIdx := 0 to FBreakMarks.Count - 1 do
    TBreakMark(FBreakMarks[MarkIdx]).Offsets.Clear;
  DbgRepaint;
end;

// Continue: программа идёт дальше с точки, где стояла
procedure TForm1.DbgResume;
begin
  if (FDbgSession = nil) or not FDbgSession.Paused then
    Exit;
  DbgClearExec;
  FDbgSession.Resume;
  DbgWatchRefresh;
end;

// Шаг или Run to cursor можно: программа не запущена (будет запуск) или
// стоит. Пока идёт свободно - нельзя, как в Delphi.
function TForm1.DbgCanStep: Boolean;
begin
  if RqDbgHere then
    Result := FRqDbgPaused
  else if FDbgSession <> nil then
    Result := FDbgSession.Paused
  else
    Result := (RunHere = 0) and (FBusyDepth = 0) and not FRqDbgOn;
end;

// Сборка и запуск под отладчиком с остановкой (F7/F8 - на begin .dpr, F4 -
// на строке FDbgRunToLine). Тот же путь, что у Compile & Run: режим
// запуска виден DbgWanted (отладочная сборка) и DbgStart (цели).
procedure TForm1.DbgLaunch(AMode: Integer);
begin
  if (FBusyDepth > 0) or (FDbgSession <> nil) or (RunHere <> 0) then
    Exit;
  if FRqDbgOn then
  begin
    LogComp('Отладчик RapidQ: уже отлаживается ' + ExtractFileName(FRqDbgExe) +
    ' - сначала Program reset (Ctrl+F2)');
            Exit;
  end;
  // F7, F8, F4 у FreeBASIC: отладчика пока нет, иначе это был бы обычный
  // Compile & Run
  if (CurBuildKind = bkFreeBasic) or
     ((CurBuildKind = bkRapidQ) and (RqCompOf(RapidQTargetBas(False)) <> rqcRc)) then
  begin
    ShowCompLog;
    LogComp('Отладчик FreeBASIC пока не подключён: шаги и Run to cursor ' +
    'недоступны. Сборка и запуск - кнопка Compile & Run');
            Exit;
  end;
  FDbgStartMode := AMode;
  try
    btnCompileRunClick(btnCompileRun);
  finally
    FDbgStartMode := DbgStartNone;
  end;
end;

// Trace into (F7): до следующей строки с заходом в процедуры, у которых
// есть номера строк
procedure TForm1.DbgStepInto;
begin
  if RqDbgHere then
  begin
    RqDbgCommand(RqDbgModeInto, 0);
    Exit;
  end;
  if FDbgSession = nil then
  begin
    DbgLaunch(DbgStartStep);
    Exit;
  end;
  if not FDbgSession.Paused then
    Exit;
  DbgClearExec;
  FDbgSession.StepInto;
  DbgWatchRefresh;
end;

// Step over (F8): до следующей строки, вызовы целиком
procedure TForm1.DbgStepOver;
begin
  if RqDbgHere then
  begin
    RqDbgCommand(RqDbgModeOver, 0);
    Exit;
  end;
  if FDbgSession = nil then
  begin
    DbgLaunch(DbgStartStep);
    Exit;
  end;
  if not FDbgSession.Paused then
    Exit;
  DbgClearExec;
  FDbgSession.StepOver;
  DbgWatchRefresh;
end;

// Run to cursor (F4): до строки с кареткой. Адреса строки - по .map
// сеанса; после правок, сдвинувших строки, номер в .map может уже не
// совпадать с текстом.
procedure TForm1.DbgRunToCursor;
var
  LineIdx, BuildLine, PointId: Integer;
  Targets: TList;
begin
  if FCurrentFileName = '' then
  begin
    LogComp('Run to cursor: файл не сохранён на диск');
    Exit;
  end;
  LineIdx := CurrentLineIndex;
  if LineIdx < 0 then
    Exit;
  // RapidQ: точка строки по копии сеанса
  if RqDbgHere then
  begin
    if not FRqDbgPaused then
      Exit;
    BuildLine := DbgLineThen(FCurrentFileName, LineIdx);
    PointId := RqDbgPointAt(FCurrentFileName, BuildLine);
    if PointId = 0 then
    begin
      LogComp('Run to cursor: ' + ExtractFileName(FCurrentFileName) +
      ', строка ' + IntToStr(LineIdx + 1) + ' - кода нет (пустая ' +
      'строка, комментарий, объявление, CREATE) или файл не в ' +
      'отладочной сборке ' + ExtractFileName(FRqDbgInstr.SrcFile) +
      ' (в неё идут $INCLUDE-файлы с точками останова и вкладки с ' +
      'пометкой главного файла; новые - после пересборки)');
              Exit;
    end;
    RqDbgCommand(RqDbgModeRunTo, PointId);
    Exit;
  end;
  if FDbgSession = nil then
  begin
    FDbgRunToFile := FCurrentFileName;
    FDbgRunToLine := LineIdx;
    DbgLaunch(DbgStartRunTo);
    Exit;
  end;
  if not FDbgSession.Paused then
    Exit;
  Targets := TList.Create;
  try
    if DbgLineThen(FCurrentFileName, LineIdx) >= 0 then
      FDbgSession.Map.OffsetsOfLine(ExtractFileName(FCurrentFileName),
                                    DbgLineThen(FCurrentFileName, LineIdx) + 1,
                                    Targets);
    if Targets.Count = 0 then
    begin
      LogComp('Run to cursor: ' + ExtractFileName(FCurrentFileName) +
      ', строка ' + IntToStr(LineIdx + 1) + ' - в .map у неё нет ' +
      'кода (пустая строка, объявление или модуль без отладочной ' +
      'информации)');
              Exit;
    end;
    DbgClearExec;
    FDbgSession.RunTo(Targets);
    DbgWatchRefresh;
  finally
    Targets.Free;
  end;
end;

// ---------------------------------------------------------------------------
//  Отладчик RapidQ (этап 1): точки останова, Trace into, Step over, Run to
//  cursor, строка остановки в редакторе. Пауза и значения переменных -
//  позже.
//
//  Сборка с точками останова (или с F7/F8/F4) собирает не главный .bas, а
//  его копию <имя>_rqdbg.bas (RqDbgInstr): перед каждым оператором -
//  проверка номера точки. Exe - тот же <имя>.exe. Программа и unIDE
//  говорят через два файла рядом с .bas и два именованных события:
//    <имя>_rqdbg.cmd   - команда unIDE: режим, точка Run to cursor, номера
//                        точек останова;
//    <имя>_rqdbg.state - где программа остановилась: "s точка уровень";
//    события "stop" (программа встала) и "go" (дальше).
//  Программа на остановке ждёт "go" в WaitForSingleObject - стоит целиком,
//  её окна не перерисовываются, как под отладчиком Delphi.
//  Точки останова программа берёт из команды на каждой остановке: точка,
//  поставленная или снятая, пока программа идёт, начнёт действовать после
//  следующей остановки. Остановка на точке, которую уже сняли, - программа
//  сразу идёт дальше с той же командой.
//  $INCLUDE-файлы (RqDbgIncludeSet): в копию текстом вставляются те, где
//  есть точка останова, открытые на вкладке с пометкой этого главного .bas
//  (IncOwner) и файл Run to cursor при запуске с F4. Остальные - как есть,
//  без точек.
// ---------------------------------------------------------------------------

// Копия главного .bas с проверками точек. ACopy - её путь.
function TForm1.RqDbgBuild(const ABas: string; var ACopy: string): Boolean;
var
  BaseName, IgnoredDir, IncDir, IncText: string;
  WatchIdx, WatchPos, FileIdx, MarkIdx, CondCount: Integer;
  IncInline: TStringList;
  Built: Boolean;
begin
  Result := False;
  if FRqDbgInstr = nil then
    FRqDbgInstr := TRqDbgInstr.Create;
  BaseName := ChangeFileExt(ABas, '');
  ACopy := BaseName + '_rqdbg.bas';
  RapidQIncludeDirs(IgnoredDir, IncDir);
  // Условия строк Watch - в копию
  FRqDbgInstr.ClearWatchConditions;
  for WatchIdx := 0 to FWatchList.Count - 1 do
    if WatchCondGet(FWatchList[WatchIdx]) <> '' then
      FRqDbgInstr.SetWatchCondition(FWatchList[WatchIdx],
                                    WatchCondGet(FWatchList[WatchIdx]));
  // Условия точек останова - в копию
  FRqDbgInstr.ClearConditions;
  for MarkIdx := 0 to FBreakMarks.Count - 1 do
    if TBreakMark(FBreakMarks[MarkIdx]).Condition <> '' then
      FRqDbgInstr.AddCondition(TBreakMark(FBreakMarks[MarkIdx]).FileName,
                               TBreakMark(FBreakMarks[MarkIdx]).Line,
                               TBreakMark(FBreakMarks[MarkIdx]).Condition);
  IncInline := TStringList.Create;
  try
    RqDbgIncludeSet(ABas, nil, IncInline);
    // Имена событий - свои у каждой сборки: программа прежней сборки, если
    // ещё работает, их не поднимет
    // Описание компонентов - типы свойств для выражений Watch (Объект.Свойство)
    RapidQComponentsReady(False);
    Built := FRqDbgInstr.Build(ABas, ACopy, BaseName + '_rqdbg.cmd',
                               BaseName + '_rqdbg.state',
    'unIDE_RqDbg_' +
                               IntToStr(Integer(GetCurrentProcessId)) + '_' +
                               IntToStr(Integer(GetTickCount)),
                               FWatchList, IncDir, IncInline);
  finally
    IncInline.Free;
  end;
  if not Built then
  begin
    LogComp('Отладчик RapidQ: копия не построена - ' + FRqDbgInstr.LastError);
    Exit;
  end;
  // Номера строк точек - по тексту сборки: правки с этого момента
  // сдвигают их (DbgLineNow / DbgLineThen)
  DbgClearEdits;
  LogComp('Отладочная сборка RapidQ: ' + ExtractFileName(ACopy) + ', точек ' +
          IntToStr(FRqDbgInstr.PointCount));
  if FRqDbgInstr.FileCount > 1 then
  begin
    IncText := '';
    for FileIdx := 1 to FRqDbgInstr.FileCount - 1 do
    begin
      if IncText <> '' then
        IncText := IncText + ', ';
      IncText := IncText + ExtractFileName(FRqDbgInstr.FileName(FileIdx));
    end;
    LogComp('  $INCLUDE под отладкой: ' + IncText);
  end;
  // Условные точки: вписаны или нет (строка без кода, файл не в копии)
  CondCount := 0;
  for MarkIdx := 0 to FBreakMarks.Count - 1 do
    if TBreakMark(FBreakMarks[MarkIdx]).Condition <> '' then
    begin
      if FRqDbgInstr.PointCondition(
        RqDbgMarkPoint(TBreakMark(FBreakMarks[MarkIdx]))) <> '' then
        Inc(CondCount);
    end;
  if CondCount > 0 then
    LogComp('  точек с условием: ' + IntToStr(CondCount));
  // Условия Watch: где проверяются или почему нет
  for WatchIdx := 0 to FWatchList.Count - 1 do
  begin
    if WatchCondGet(FWatchList[WatchIdx]) = '' then
      Continue;
    WatchPos := FRqDbgInstr.WatchIndex(FWatchList[WatchIdx]);
    if FRqDbgInstr.WatchCondition(WatchPos) <> '' then
    begin
      if FRqDbgInstr.WatchCondWhere(WatchPos) = '*' then
        LogComp('  условие Watch ' + FWatchList[WatchIdx] + ' ' +
                FRqDbgInstr.WatchCondition(WatchPos) + ' - у всех точек ' +
        'останова')
      else
        LogComp('  условие Watch ' + FWatchList[WatchIdx] + ' ' +
                FRqDbgInstr.WatchCondition(WatchPos) + ' - у точек ' +
        'останова в: ' + FRqDbgInstr.WatchCondWhere(WatchPos));
    end
    else
      LogComp('  условие Watch ' + FWatchList[WatchIdx] + ' ' +
              WatchCondGet(FWatchList[WatchIdx]) + ' не вписано: ' +
              FRqDbgInstr.WatchCondNote(WatchPos));
  end;
  // Выражения Watch, которые не вставлены в копию, - с причиной
  if FWatchList <> nil then
    for WatchIdx := 0 to FWatchList.Count - 1 do
    begin
      WatchPos := FRqDbgInstr.WatchIndex(FWatchList[WatchIdx]);
      if (WatchPos >= 0) and (FRqDbgInstr.WatchNote(WatchPos) <> '') and
         not RqDbgPlainName(FWatchList[WatchIdx]) then
        LogComp('  Watch "' + FWatchList[WatchIdx] + '": ' +
                FRqDbgInstr.WatchNote(WatchPos));
    end;
  // Имена RqDbg... уже есть в программе - код отладчика взял другие
  if FRqDbgInstr.Prefix <> 'RqDbg' then
    LogComp('  имена кода отладчика в копии - ' + FRqDbgInstr.Prefix +
    '...: RqDbg... уже встречается в ' + ExtractFileName(ABas));
            Result := True;
end;

// Сеанс отладки RapidQ - у программы цели активной вкладки (или вкладка
// без цели: .ini, лог)
function TForm1.RqDbgHere: Boolean;
var
  HereExe: string;
begin
  Result := False;
  if not FRqDbgOn then
    Exit;
  HereExe := CurRunExe;
  Result := (HereExe = '') or (CompareText(HereExe, FRqDbgExe) = 0);
end;

// Точка копии на строке точки останова, 0 - нет (не тот файл, строка без
// кода, строка вставлена после сборки)
function TForm1.RqDbgMarkPoint(AMark: TBreakMark): Integer;
var
  BuildLine: Integer;
begin
  Result := 0;
  if (FRqDbgInstr = nil) or (FRqDbgInstr.SrcFile = '') then
    Exit;
  BuildLine := DbgLineThen(AMark.FileName, AMark.Line);
  Result := RqDbgPointAt(AMark.FileName, BuildLine);
end;

// Строка команды для точки останова: "b номер" - без условия, "c номер" -
// с условием, вписанным в копию. '' - точка не срабатывает: кода нет или
// условие задано (изменено) после сборки.
function TForm1.RqDbgMarkCmd(AMark: TBreakMark): string;
var
  PointId: Integer;
begin
  Result := '';
  PointId := RqDbgMarkPoint(AMark);
  if PointId = 0 then
    Exit;
  if AMark.Condition = '' then
    Result := 'b ' + IntToStr(PointId)
  else if AMark.Condition = FRqDbgInstr.PointCondition(PointId) then
    Result := 'c ' + IntToStr(PointId);
end;

// Точка, поставленная во время сеанса: есть ли у неё код
procedure TForm1.RqDbgResolveMark(AMark: TBreakMark);
begin
  AMark.Offsets.Clear;
  AMark.NoCode := RqDbgMarkCmd(AMark) = '';
  if AMark.NoCode and (RqDbgMarkPoint(AMark) > 0) then
    LogComp('Точка останова: ' + ExtractFileName(AMark.FileName) +
    ', строка ' + IntToStr(AMark.Line + 1) + ' - условие "' +
            AMark.Condition + '" не вписано в эту сборку; точка не ' +
    'сработает до пересборки (Ctrl+F2, затем F9)')
  else if AMark.NoCode then
    LogComp('Точка останова: ' + ExtractFileName(AMark.FileName) +
    ', строка ' + IntToStr(AMark.Line + 1) + ' - кода нет (пустая ' +
    'строка, комментарий, объявление, CREATE) или файла нет в ' +
    'отладочной сборке (новый $INCLUDE-файл - после пересборки), ' +
    'точка не сработает')
  else if not FRqDbgPaused then
    LogComp('Точка останова: программа идёт - точка начнёт действовать ' +
    'после следующей остановки');
end;

// Все точки к запуску: серые - те, у которых кода нет. Результат - сколько
// сработает.
function TForm1.RqDbgResolveMarks: Integer;
var
  MarkIdx, OtherFiles: Integer;
  Mark: TBreakMark;
begin
  Result := 0;
  OtherFiles := 0;
  for MarkIdx := 0 to FBreakMarks.Count - 1 do
  begin
    Mark := TBreakMark(FBreakMarks[MarkIdx]);
    Mark.Offsets.Clear;
    Mark.NoCode := RqDbgMarkCmd(Mark) = '';
    if not Mark.NoCode then
      Inc(Result)
    else if FRqDbgInstr.FileIndex(Mark.FileName) < 0 then
      Inc(OtherFiles)
    else if RqDbgMarkPoint(Mark) > 0 then
      LogComp('Точка останова: ' + ExtractFileName(Mark.FileName) +
      ', строка ' + IntToStr(Mark.Line + 1) + ' - условие "' +
              Mark.Condition + '" не вписано в копию, точка не сработает')
    else
      LogComp('Точка останова: ' + ExtractFileName(Mark.FileName) +
      ', строка ' + IntToStr(Mark.Line + 1) + ' - кода нет (пустая ' +
      'строка, комментарий, объявление, CREATE), точка не сработает');
  end;
  if OtherFiles > 0 then
    LogComp('Точки останова в других файлах (' + IntToStr(OtherFiles) +
    ') не сработают: их нет в отладочной сборке ' +
            ExtractFileName(FRqDbgInstr.SrcFile) + ' (другая программа)');
  DbgRepaint;
end;

// Файл команды: "m режим", "r точка", "b точка" или "c точка" (с условием)
// на каждую точку останова (RqDbgMarkCmd), "k номер" на каждое условие
// Watch, "#end"
function TForm1.RqDbgWriteCmd(AMode, ARunTo: Integer): Boolean;
var
  CmdLines: TStringList;
  MarkIdx, WatchPos: Integer;
  CmdText: string;
begin
  Result := False;
  if FRqDbgInstr = nil then
    Exit;
  CmdLines := TStringList.Create;
  try
    CmdLines.Add('m ' + IntToStr(AMode));
    if ARunTo > 0 then
      CmdLines.Add('r ' + IntToStr(ARunTo));
    for MarkIdx := 0 to FBreakMarks.Count - 1 do
    begin
      CmdText := RqDbgMarkCmd(TBreakMark(FBreakMarks[MarkIdx]));
      if CmdText <> '' then
        CmdLines.Add(CmdText);
    end;
    // Условия Watch, вписанные в копию и с тех пор не изменённые
    for MarkIdx := 0 to FWatchList.Count - 1 do
    begin
      CmdText := WatchCondGet(FWatchList[MarkIdx]);
      if CmdText = '' then
        Continue;
      WatchPos := FRqDbgInstr.WatchIndex(FWatchList[MarkIdx]);
      if (WatchPos >= 0) and
         (FRqDbgInstr.WatchCondition(WatchPos) = CmdText) then
        CmdLines.Add('k ' + IntToStr(WatchPos));
    end;
    CmdLines.Add('#end');
    try
      CmdLines.SaveToFile(FRqDbgInstr.CmdFile);
      Result := True;
    except
      on E: Exception do
        LogComp('Отладчик RapidQ: не записан файл команды ' +
                FRqDbgInstr.CmdFile + ' (' + E.Message + ')');
    end;
  finally
    CmdLines.Free;
  end;
  if Result then
  begin
    FRqDbgLastMode := AMode;
    FRqDbgLastRunTo := ARunTo;
  end;
end;

// Запуск exe отладочной сборки под отладчиком. False - не вышло, причина
// в логе: RunTarget запустит программу как обычно.
function TForm1.RqDbgLaunch(const AExe, ADir: string): Boolean;
var
  StartInfo: TStartupInfo;
  ProcInfo: TProcessInformation;
  RunCmd: string;
  Mode, RunTo, Armed: Integer;
begin
  Result := False;
  if FRqDbgOn then
  begin
    LogComp('Отладчик RapidQ: уже отлаживается ' + ExtractFileName(FRqDbgExe));
    Exit;
  end;
  RqDbgCloseEvents;
  FRqDbgEvStop := CreateEvent(nil, False, False,
                              PChar(RqDbgStopEventName(FRqDbgInstr.EventBase)));
  FRqDbgEvGo := CreateEvent(nil, False, False,
                            PChar(RqDbgGoEventName(FRqDbgInstr.EventBase)));
  if (FRqDbgEvStop = 0) or (FRqDbgEvGo = 0) then
  begin
    LogComp('Отладчик RapidQ: события не созданы (' +
            SysErrorMessage(GetLastError) + ') - запуск без отладчика');
    RqDbgCloseEvents;
    Exit;
  end;
  ResetEvent(FRqDbgEvStop);
  ResetEvent(FRqDbgEvGo);

  Armed := RqDbgResolveMarks;
  // Первая команда: F7/F8 - стоять на первом операторе, F4 - на строке
  // курсора, иначе - до точки останова
  Mode := RqDbgModeRun;
  RunTo := 0;
  if FDbgStartMode = DbgStartStep then
    Mode := RqDbgModeInto
  else if FDbgStartMode = DbgStartRunTo then
  begin
    RunTo := RqDbgPointAt(FDbgRunToFile, DbgLineThen(FDbgRunToFile,
                                                     FDbgRunToLine));
    if RunTo > 0 then
      Mode := RqDbgModeRunTo
    else
      LogComp('Run to cursor: ' + ExtractFileName(FDbgRunToFile) +
      ', строка ' + IntToStr(FDbgRunToLine + 1) + ' - кода нет или ' +
      'файла нет в отладочной сборке; программа идёт до точки ' +
      'останова');
  end;
  DeleteFile(FRqDbgInstr.StateFile);
  if not RqDbgWriteCmd(Mode, RunTo) then
  begin
    RqDbgCloseEvents;
    Exit;
  end;

  FillChar(StartInfo, SizeOf(StartInfo), 0);
  StartInfo.cb := SizeOf(StartInfo);
  RunCmd := '"' + AExe + '"';
  if not CreateProcess(nil, PChar(RunCmd), nil, nil, False, 0, nil,
                       PChar(ADir), StartInfo, ProcInfo) then
  begin
    LogComp('Отладчик RapidQ: запуск не удался - ' + AExe + ' (' +
            SysErrorMessage(GetLastError) + ')');
    DeleteFile(FRqDbgInstr.CmdFile);
    RqDbgCloseEvents;
    Exit;
  end;
  CloseHandle(ProcInfo.hThread);
  RunAdd(ExpandFileName(AExe), ProcInfo.hProcess);
  FRunExeTick := 0;
  FRqDbgOn := True;
  FRqDbgPaused := False;
  if FRqDbgTimer = nil then
  begin
    FRqDbgTimer := TTimer.Create(Self);
    FRqDbgTimer.Interval := 50;
    FRqDbgTimer.OnTimer := RqDbgTimerTick;
  end;
  FRqDbgTimer.Enabled := True;
  LogComp('--- Запуск под отладчиком RapidQ: ' + AExe + ' (точек в копии ' +
          IntToStr(FRqDbgInstr.PointCount) + ', точек останова ' +
          IntToStr(Armed) + ')');
  Result := True;
end;

// Команда стоящей программе: файл команды, затем "go"
procedure TForm1.RqDbgCommand(AMode, ARunTo: Integer);
begin
  if not FRqDbgOn or not FRqDbgPaused then
    Exit;
  if not RqDbgWriteCmd(AMode, ARunTo) then
    Exit;
  FRqDbgPaused := False;
  DbgClearExec;
  if FRqDbgVars <> nil then
    FRqDbgVars.Clear;
  SetEvent(FRqDbgEvGo);
  DbgWatchRefresh;
end;

// Раз в 50 мс: не встала ли программа (событие "stop")
procedure TForm1.RqDbgTimerTick(Sender: TObject);
var
  StateLines: TStringList;
  StateText: string;
  PointId, SpacePos, LineIdx, BarPos, EqPos: Integer;
begin
  if not FRqDbgOn then
  begin
    FRqDbgTimer.Enabled := False;
    Exit;
  end;
  if FRqDbgPaused or (FRqDbgEvStop = 0) then
    Exit;
  if WaitForSingleObject(FRqDbgEvStop, 0) <> WAIT_OBJECT_0 then
    Exit;
  // "s точка уровень", затем переменные "вид имя|тип=значение", "#end";
  // файл записан и закрыт до события
  PointId := 0;
  if FRqDbgVars = nil then
    FRqDbgVars := TStringList.Create;
  FRqDbgVars.Clear;
  StateLines := TStringList.Create;
  try
    try
      StateLines.LoadFromFile(FRqDbgInstr.StateFile);
    except
      StateLines.Clear;
    end;
    if StateLines.Count > 0 then
    begin
      StateText := Trim(StateLines[0]);
      if Copy(StateText, 1, 2) = 's ' then
      begin
        StateText := Trim(Copy(StateText, 3, MaxInt));
        SpacePos := Pos(' ', StateText);
        if SpacePos > 0 then
          StateText := Copy(StateText, 1, SpacePos - 1);
        PointId := StrToIntDef(StateText, 0);
      end;
    end;
    for LineIdx := 1 to StateLines.Count - 1 do
    begin
      StateText := StateLines[LineIdx];
      if Copy(StateText, 1, 4) = '#end' then
        Break;
      // Значение - всё после первого "=" за "|" (в строке бывает и "=")
      BarPos := Pos('|', StateText);
      if (Length(StateText) < 3) or (StateText[2] <> ' ') or (BarPos = 0) then
        Continue;
      EqPos := BarPos + Pos('=', Copy(StateText, BarPos + 1, MaxInt));
      if EqPos = BarPos then
        Continue;
      FRqDbgVars.Add(StateText[1] + #9 + Copy(StateText, 3, BarPos - 3) + #9 +
                     Copy(StateText, BarPos + 1, EqPos - BarPos - 1) + #9 +
                     Copy(StateText, EqPos + 1, MaxInt));
    end;
  finally
    StateLines.Free;
  end;
  FRqDbgWhere := FRqDbgInstr.ProcOfPoint(PointId);
  FRqDbgPaused := True;
  RqDbgStopped(PointId);
end;

// Программа встала на точке APoint: строка в редакторе
procedure TForm1.RqDbgStopped(APoint: Integer);
var
  SrcFile: string;
  SrcLine, MarkIdx: Integer;
  OnMark: Boolean;
begin
  SrcLine := FRqDbgInstr.LineOfPoint(APoint);

  // Точку сняли, пока программа шла (в программе флаг ещё стоял), - дальше
  // с той же командой, уже без неё
  if (SrcLine >= 0) and
     ((FRqDbgLastMode = RqDbgModeRun) or
      ((FRqDbgLastMode = RqDbgModeRunTo) and (APoint <> FRqDbgLastRunTo))) then
  begin
    OnMark := False;
    for MarkIdx := 0 to FBreakMarks.Count - 1 do
      if (RqDbgMarkPoint(TBreakMark(FBreakMarks[MarkIdx])) = APoint) and
         (RqDbgMarkCmd(TBreakMark(FBreakMarks[MarkIdx])) <> '') then
      begin
        OnMark := True;
        Break;
      end;
    if not OnMark then
    begin
      RqDbgCommand(FRqDbgLastMode, FRqDbgLastRunTo);
      Exit;
    end;
  end;

  // Окно среды - вперёд: программа стоит, работать теперь здесь
  if IsIconic(Application.Handle) then
    Application.Restore;
  SetForegroundWindow(Handle);

  if SrcLine < 0 then
  begin
    LogComp('--- Остановка в точке ' + IntToStr(APoint) + ' - строки для ' +
    'неё нет (файл состояния ' + FRqDbgInstr.StateFile + '). ' +
    'Продолжить - Run (F9)');
            DbgRepaint;
            Exit;
  end;
  // Файл точки: главный или вставленный $INCLUDE
  SrcFile := FRqDbgInstr.FileName(FRqDbgInstr.FileOfPoint(APoint));
  if SrcFile = '' then
    SrcFile := FRqDbgInstr.SrcFile;
  if CompareText(ExpandFileName(FCurrentFileName), ExpandFileName(SrcFile)) <> 0 then
    OpenNamedFile(SrcFile);
  // Вкладка include без пометки главного файла - с пометкой: с неё F7/F8/F9
  // идут этому сеансу
  if (FWindowsIndex >= 0) and
     (CompareText(ExpandFileName(FCurrentFileName),
                  ExpandFileName(SrcFile)) = 0) and
     (CompareText(ExpandFileName(SrcFile),
                  ExpandFileName(FRqDbgInstr.SrcFile)) <> 0) and
     (FWindows[FWindowsIndex].IncOwner = '') then
    SetIncOwner(FWindowsIndex, FRqDbgInstr.SrcFile);
  // Путь - как у вкладки: так его сравнивают точки и правки (FDbgEdits)
  if CompareText(ExpandFileName(FCurrentFileName), ExpandFileName(SrcFile)) = 0 then
    SrcFile := FCurrentFileName;
  // Номер строки - по тексту сборки; правки после неё сдвигают его
  SrcLine := DbgLineNow(SrcFile, SrcLine);
  LogComp('--- Остановка: ' + ExtractFileName(SrcFile) + ', строка ' +
          IntToStr(SrcLine + 1) + '. Дальше: F9 - Run, F8 - Step over, ' +
  'F7 - Trace into, F4 - Run to cursor, Ctrl+F2 - Program reset');
          FDbgExecFile := SrcFile;
          FDbgExecLine := SrcLine;
          if CompareText(FCurrentFileName, SrcFile) = 0 then
          GotoLine(SrcLine);
          DbgRepaint;
          DbgWatchRefresh;
  // Значение под мышью - подсказкой, пока программа стоит
          if FDbgHintTimer = nil then
  begin
    FDbgHintTimer := TTimer.Create(Self);
    FDbgHintTimer.Interval := CiTickMs;   // Code Insight - Delay
    FDbgHintTimer.OnTimer := DbgHintTimerTick;
  end;
  FDbgHintTimer.Enabled := True;
end;

procedure TForm1.RqDbgCloseEvents;
begin
  if FRqDbgEvStop <> 0 then
    CloseHandle(FRqDbgEvStop);
  if FRqDbgEvGo <> 0 then
    CloseHandle(FRqDbgEvGo);
  FRqDbgEvStop := 0;
  FRqDbgEvGo := 0;
end;

// Программа сеанса закрылась или снята (RunTimerTick)
procedure TForm1.RqDbgEnd;
begin
  if not FRqDbgOn then
    Exit;
  FRqDbgOn := False;
  FRqDbgPaused := False;
  if FRqDbgTimer <> nil then
    FRqDbgTimer.Enabled := False;
  RqDbgCloseEvents;
  if FRqDbgInstr <> nil then
  begin
    DeleteFile(FRqDbgInstr.CmdFile);
    DeleteFile(FRqDbgInstr.StateFile);
  end;
  DbgClearExec;
  if FRqDbgVars <> nil then
    FRqDbgVars.Clear;
  DbgWatchRefresh;
  LogComp('--- Программа завершилась (отладчик RapidQ)');
  // Лог сборки и сеанса (остановки, команды) - рядом с .bas: окно лога
  // очищает следующая сборка
  if FRqDbgInstr <> nil then
    SaveCompileLog(ChangeFileExt(FRqDbgInstr.SrcFile, '') + '_rqdbg.log');
  DbgRepaint;
end;

// Значение переменной RapidQ на остановке. Сначала параметры и локальные,
// потом глобальные; имя без учёта регистра. Имя под мышью приходит без
// суффикса ($, %...) - тогда подходит и имя с суффиксом.
function TForm1.RqDbgVarFind(const AExpr: string; var AValue,
                             AType: string): Boolean;
var
  Pass, VarIdx: Integer;
  Fields: TStringList;
  BaseName: string;
begin
  Result := False;
  AValue := '';
  AType := '';
  if (FRqDbgVars = nil) or (Trim(AExpr) = '') then
    Exit;
  Fields := TStringList.Create;
  try
    for Pass := 1 to 4 do
      for VarIdx := 0 to FRqDbgVars.Count - 1 do
      begin
        Fields.Text := StringReplace(FRqDbgVars[VarIdx], #9, #13#10,
                                     [rfReplaceAll]);
        if Fields.Count < 3 then
          Continue;
        // 1, 2 - локальные и параметры, 3, 4 - глобальные; нечётные -
        // точное имя, чётные - имя без суффикса
        if (Pass <= 2) <> (Fields[0] <> 'g') then
          Continue;
        BaseName := Fields[1];
        if not Odd(Pass) then
          while (BaseName <> '') and
                (BaseName[Length(BaseName)] in ['$', '%', '&', '!', '#', '?']) do
            Delete(BaseName, Length(BaseName), 1);
        if CompareText(BaseName, Trim(AExpr)) <> 0 then
          Continue;
        AType := Fields[2];
        if Fields.Count > 3 then
          AValue := Fields[3];
        if AType = 'STRING' then
          AValue := '"' + AValue + '"';
        Result := True;
        Exit;
      end;
  finally
    Fields.Free;
  end;
end;

// Простое имя: буквы, цифры, _ и суффикс типа
function TForm1.RqDbgPlainName(const AExpr: string): Boolean;
var
  CharIdx: Integer;
begin
  Result := Trim(AExpr) <> '';
  for CharIdx := 1 to Length(Trim(AExpr)) do
    if not (Trim(AExpr)[CharIdx] in ['A'..'Z', 'a'..'z', '0'..'9', '_',
    '$', '%', '&', '!', '#', '?']) then
            Result := False;
end;

// Значение выражения Watch, вычисленного копией (строки "w номер" файла
// состояния). False - значения нет, ANote - почему (в угловых скобках).
function TForm1.RqDbgWatchValue(const AExpr: string; var AValue,
                                ANote: string): Boolean;
var
  WatchPos, VarIdx: Integer;
  KeyText, Where, Entry: string;
begin
  Result := False;
  AValue := '';
  ANote := '';
  if FRqDbgInstr = nil then
    Exit;
  WatchPos := FRqDbgInstr.WatchIndex(AExpr);
  if WatchPos < 0 then
  begin
    ANote := '<выражение добавлено после сборки - значение будет после ' +
    'пересборки (Compile & Run)>';
Exit;
  end;
  if FRqDbgVars <> nil then
  begin
    KeyText := 'w'#9 + IntToStr(WatchPos) + #9;
    for VarIdx := 0 to FRqDbgVars.Count - 1 do
      if Copy(FRqDbgVars[VarIdx], 1, Length(KeyText)) = KeyText then
      begin
        // "w<TAB>номер<TAB>тип<TAB>значение"
        Entry := Copy(FRqDbgVars[VarIdx], Length(KeyText) + 1, MaxInt);
        AValue := Copy(Entry, Pos(#9, Entry) + 1, MaxInt);
        Result := True;
        Exit;
      end;
  end;
  Where := FRqDbgInstr.WatchWhere(WatchPos);
  if FRqDbgInstr.WatchNote(WatchPos) <> '' then
    ANote := '<' + FRqDbgInstr.WatchNote(WatchPos) + '>'
  else if (Where <> '') and (Where <> '*') then
    ANote := '<вычисляется только в: ' + Where + '>'
  else
    ANote := '<нет значения>';
end;

// Окно Watch под отладчиком RapidQ: значения - из файла состояния
// остановки. Показываются объявленные переменные простых типов; массивы,
// объекты, выражения - пока нет.
procedure TForm1.RqDbgWatchRefresh;
var
  ExprIdx: Integer;
  State, ValueText, TypeText, Where, ExprText, NoteText: string;
  Item: TListItem;

  procedure SetSub(AItem: TListItem; ASubIdx: Integer; const AText: string);
  begin
    while AItem.SubItems.Count <= ASubIdx do
      AItem.SubItems.Add('');
    if AItem.SubItems[ASubIdx] <> AText then
      AItem.SubItems[ASubIdx] := AText;
  end;

begin
  State := '';
  if not FRqDbgOn then
    State := '<программа не запущена>'
  else if not FRqDbgPaused then
    State := '<программа выполняется>';
  if State <> '' then
    Where := State
  else if FRqDbgWhere = '' then
    Where := 'Остановка в главной части'
  else
    Where := 'Остановка в ' + FRqDbgWhere;
  if FWatchWnd.lblWhere.Caption <> ' ' + Where then
    FWatchWnd.lblWhere.Caption := ' ' + Where;

  FWatchWnd.lvWatch.Items.BeginUpdate;
  try
    while FWatchWnd.lvWatch.Items.Count > FWatchList.Count do
      FWatchWnd.lvWatch.Items.Delete(FWatchWnd.lvWatch.Items.Count - 1);
    while FWatchWnd.lvWatch.Items.Count < FWatchList.Count do
      FWatchWnd.lvWatch.Items.Add;
    for ExprIdx := 0 to FWatchList.Count - 1 do
    begin
      Item := FWatchWnd.lvWatch.Items[ExprIdx];
      ExprText := Trim(FWatchList[ExprIdx]);
      if Item.Caption <> FWatchList[ExprIdx] then
        Item.Caption := FWatchList[ExprIdx];
      TypeText := '';
      if State <> '' then
        ValueText := State
      else if not RqDbgVarFind(ExprText, ValueText, TypeText) then
      begin
        // Выражение, вычисленное копией; простое имя без значения -
        // своё пояснение
        if RqDbgWatchValue(ExprText, ValueText, NoteText) then
          TypeText := '(выражение)'
        else if RqDbgPlainName(ExprText) and (FRqDbgInstr <> nil) and
                (FRqDbgInstr.WatchIndex(ExprText) >= 0) then
          ValueText := '<нет: не объявлена через DIM в этой SUB или ' +
          'глобально, массив, объект или из $INCLUDE не под ' +
          'отладкой>'
        else
          ValueText := NoteText;
      end;
      SetSub(Item, 0, ValueText);
      SetSub(Item, 1, WatchCondGet(ExprText));
      SetSub(Item, 2, TypeText);
    end;
  finally
    FWatchWnd.lvWatch.Items.EndUpdate;
  end;
  WatchArrShow(False);
end;

