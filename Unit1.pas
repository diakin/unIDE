//
// По нажатию Alt Windows шлёт WM_UPDATEUISTATE, чтобы показать подчёркивания
// в подписях. VCL 7 при этом стирает часть контролов и не перерисовывает их -
// кнопки и панели просто пропадают с экрана.
//
// Глушить сам Alt в FormKeyDown тоже помогает, но тогда перестаёт работать
// вызов меню с клавиатуры. Здесь мы пропускаем сообщение как есть и следом
// принудительно перерисовываем всё дерево окон.
// Фон формы не стираем.
//
// Клиентская область целиком закрыта контролами: тулбар и вкладки сверху,
// панель номеров слева, редактор по центру, лог, поле пути и статус-бар снизу.
// Собственный фон формы нигде не виден, зато его стирание при протяжке рамки
// успевает мелькнуть под контролами - отсюда мерцание, которое оставалось
// после включения двойной буферизации.
procedure TForm1.WMEraseBkgnd(var Message: TWMEraseBkgnd);
begin
  Message.Result := 1; // сообщаем, что фон уже обработан
end;

procedure TForm1.WMUpdateUIState(var Message: TMessage);
begin
  // Сообщение НЕ передаём дальше - ни inherited, ни DefWindowProc.
  //
  // Перерисовка после обработки не помогала: контролы стирались уже ПОСЛЕ
  // нашего RedrawWindow. Проще не дать состоянию измениться вовсе - тогда
  // и перерисовывать нечего. Заодно обрывается рассылка сообщения дочерним
  // окнам, из-за которой всё и происходит.
  //
  // Плата: подчёркивания в подписях по Alt не появляются. Сам вызов меню
  // с клавиатуры при этом работает - и Alt, и Alt+F, и буквы-ускорители.
  Message.Result := 0;
end;

// Разбор текста FullText на блочные комментарии и строки - автомат карты.
// Диапазоны ДОПИСЫВАЮТСЯ в CommentRanges и StringRanges; позиции в них -
// позиции контрола, FullText начинается с позиции ABase. Начало FullText
// должно быть в обычном коде (не в комментарии и не в строке).
procedure TForm1.ScanCommentRanges(const FullText: string; ABase: Integer);
var
  TextLen, I: Integer;
  InBlock: Boolean;
  InSingleLine: Boolean;
  InString: Boolean;
  StartPos: Integer;
  StringStartPos: Integer;
  // Длины маркеров активной схемы (кэшируем, чтобы не считать в цикле)
  LcLen: Integer;
  // Флаги совпадения маркеров комментариев в текущей позиции
  HitLine, HitBlock, HitStr: Boolean;
  SLen, LLen, BLen: Integer; // длины совпавших маркеров
  // Пара маркеров открытого блочного комментария и найденная в позиции
  BlockKind, HitKind, P: Integer;
  StrKind, StrHitKind, CurLen: Integer;
  CurMark: string;
  EndMark: string;

  // Проверяет, стоит ли в FullText начиная с 1-базовой позиции APos
  // ровно маркер Marker. Пустой маркер не совпадает никогда.
  function MatchesAt(const Marker: string; APos: Integer): Boolean;
  var
    M: Integer;
  begin
    Result := False;
    if Marker = '' then
      Exit;
    if APos < 1 then
      Exit;
    if APos + Length(Marker) - 1 > TextLen then
      Exit;
    for M := 1 to Length(Marker) do
      if FullText[APos + M - 1] <> Marker[M] then
        Exit;
    Result := True;
  end;

begin
  TextLen := Length(FullText);

  // Длины динамических маркеров текущей языковой схемы
  LcLen  := Length(FScheme.FLineCommentMarker);

  // Инициализируем флаги состояний автомата
  InBlock := False;
  BlockKind := 0;
  StrKind := 0;
  InSingleLine := False;
  InString := False;
  StartPos := 0;
  StringStartPos := 0;
  I := 1;

  // 2. ГЛАВНЫЙ ПОСИМВОЛЬНЫЙ ЦИКЛ АВТОМАТА РАЗБОРА
  while I <= TextLen do
  begin

    // СОСТОЯНИЕ №1: Мы внутри строкового литерала
    if InString then
    begin
      CurMark := FScheme.StrMark(StrKind);
      CurLen := Length(CurMark);

      // Знак экранирования: следующий символ к разбору не относится.
      // В C и JavaScript это обратная косая, и без неё \" закрыло бы
      // литерал раньше времени.
      if (FScheme.FStrEscape <> #0) and (FullText[I] = FScheme.FStrEscape) then
      begin
        Inc(I, 2);
        Continue;
      end;

      if (CurLen > 0) and MatchesAt(CurMark, I) then
      begin
        // Экранирование удвоением маркера ('' в Pascal, "" в Бейсике);
        // там, где задан знак экранирования, удвоение не применяется
        if (FScheme.FStrEscape = #0) and MatchesAt(CurMark, I + CurLen) then
          Inc(I, CurLen * 2)
        else
        begin
          InString := False;
          SetLength(StringRanges, Length(StringRanges) + 1);
          StringRanges[High(StringRanges)].StartPos := StringStartPos;
          StringRanges[High(StringRanges)].Kind := StrKind;
          StringRanges[High(StringRanges)].EndPos := ABase + I + CurLen - 1;
          Inc(I, CurLen);
        end;
      end
      else
        Inc(I);
      Continue;
    end;

    // СОСТОЯНИЕ №2: Мы внутри однострочного комментария
    // Выйти можно только через перевод строки. Любые блочные маркеры
    // и кавычки внутри строчного комментария полностью игнорируются.
    if InSingleLine then
    begin
      if (FullText[I] = #13) or (FullText[I] = #10) then
        InSingleLine := False;
      Inc(I);
      Continue;
    end;

    // СОСТОЯНИЕ №3: Мы внутри многострочного блочного комментария.
    //
    // Закрывающий маркер ищется ТОЙ ЖЕ пары, которой комментарий открыт:
    // иначе в языке с двумя видами комментариев '*/' закрывало бы блок,
    // начатый с '/'''. И ищется сразу до конца, через PosEx: внутри
    // комментария разбирать всё равно нечего, а посимвольный проход по
    // длинному закомментированному куску - самая дорогая часть разбора.
    if InBlock then
    begin
      EndMark := FScheme.BcEndMark(BlockKind);
      if EndMark = '' then
        P := 0
      else
        P := PosEx(EndMark, FullText, I);

      InBlock := False;
      SetLength(CommentRanges, Length(CommentRanges) + 1);
      CommentRanges[High(CommentRanges)].StartPos := StartPos;
      CommentRanges[High(CommentRanges)].Kind := BlockKind;

      if P = 0 then
      begin
        // Закрытия в тексте нет - комментарий тянется до конца
        CommentRanges[High(CommentRanges)].EndPos := ABase + TextLen;
        Break;
      end;

      CommentRanges[High(CommentRanges)].EndPos := ABase + P + Length(EndMark) - 1;
      I := P + Length(EndMark);
      Continue;
    end;

    // СОСТОЯНИЕ №4: Мы в обычном коде. Смотрим, какой маркер открывается.

    // ОТКРЫТИЕ ТОКЕНА. Все три маркера проверяются вместе, потому что один
    // может быть префиксом другого: '/' и '//' в C, а в Питоне кавычка и
    // тройная кавычка - там """ это блочный комментарий, а не начало
    // строки. Побеждает самый длинный совпавший маркер; при равной длине
    // комментарий важнее литерала.
    HitStr   := StrStartAt(FullText, I, StrHitKind);
    HitLine  := MatchesAt(FScheme.FLineCommentMarker, I);
    HitBlock := BcStartAt(FullText, I, HitKind);

    SLen := 0;
    if HitStr then
      SLen := Length(FScheme.StrMark(StrHitKind));
    LLen := 0;
    if HitLine then
      LLen := LcLen;
    BLen := 0;
    if HitBlock then
      BLen := Length(FScheme.BcStartMark(HitKind));

    if (BLen > 0) and (BLen >= LLen) and (BLen >= SLen) then
    begin
      InBlock := True;
      BlockKind := HitKind;
      StartPos := ABase + I - 1;
      Inc(I, BLen);
      Continue;
    end;

    if (LLen > 0) and (LLen >= SLen) then
    begin
      InSingleLine := True;
      Inc(I, LLen);
      Continue;
    end;

    if SLen > 0 then
    begin
      InString := True;
      StrKind := StrHitKind;
      StringStartPos := ABase + I - 1;
      Inc(I, SLen);
      Continue;
    end;

    // Маркеров нет - просто переходим к следующему символу
    Inc(I);
  end;

  // 3. ФИНАЛЬНАЯ ЗАЩИТА: файл закончился, а строка так и не была закрыта.
  // Незакрытый блочный комментарий дописывается в своей ветке, там же, где
  // ищется закрывающий маркер. Сюда он попадает, только если маркер
  // открытия - последние символы текста: до той ветки цикл не доходит.

  if InBlock then
  begin
    SetLength(CommentRanges, Length(CommentRanges) + 1);
    CommentRanges[High(CommentRanges)].StartPos := StartPos;
    CommentRanges[High(CommentRanges)].Kind := BlockKind;
    CommentRanges[High(CommentRanges)].EndPos := ABase + TextLen;
  end;

  if InString then
  begin
    SetLength(StringRanges, Length(StringRanges) + 1);
    StringRanges[High(StringRanges)].StartPos := StringStartPos;
    StringRanges[High(StringRanges)].Kind := StrKind;
    StringRanges[High(StringRanges)].EndPos := ABase + TextLen;
  end;
end;

procedure TForm1.RebuildCommentRangeMap;
var
  FullText: string;
  I: Integer;
  T0: Int64; // замер длительности разбора, точным счётчиком
begin
  // Во время переключения окна в редакторе ещё лежит текст предыдущего файла,
  // и строить по нему карту бессмысленно - ActivateWindow сделает это сам,
  // когда текст будет на месте.
  if FSuppressMapRebuild then
    Exit;
  FMapRebuilt := True;
  FMapPartialEnd := 0;

  // Карты меняются - строчные комментарии длинных строк искать заново
  Inc(FMapVer);
  FMapMarkersSig := FScheme.MarkersSig;

  // Заказ, если он был, только что исполнен здесь - снимаем его, иначе
  // таймер сделал бы ту же работу второй раз
  if FMapTimer <> nil then
    FMapTimer.Enabled := False;

  // Подсветка выключена - карту никто не читает, строить её незачем.
  // На 32-мегабайтном файле это полсекунды впустую при каждом открытии.
  // Помечаем устаревшей: когда подсветку включат обратно, отрисовка сама
  // закажет разбор.
  if not FUseSyntaxHighlight then
  begin
    SetLength(CommentRanges, 0);
    SetLength(StringRanges, 0);
    FMapStale := True;
    Exit;
  end;

  T0 := PerfNow;

  // 1. Очищаем старые карты перед пересчётом
  SetLength(CommentRanges, 0);
  SetLength(StringRanges, 0);

  // Читаем весь текст редактора в память за один раз. Перевод строки должен
  // быть ОДНИМ символом, как в индексах контрола: позиции карты - это они.
  FullText := GetEditorTextCR;
  ScanCommentRanges(FullText, 0);

  // Подстраиваем интервал таймера под РЕАЛЬНУЮ стоимость разбора на этом
  // файле. Фиксированные 150 мс одинаково плохи с обеих сторон: на небольшом
  // файле подсветка зря отстаёт от клавиатуры, на 32-мегабайтном даже они
  // могут оказаться мало.
  //
  // Меряем ТОЧНЫМ счётчиком, а не GetTickCount: у того шаг около 15 мс, и
  // разбор файла в триста килобайт укладывался в один тик - на экране было
  // ровно "0", хотя работа шла.
  //
  // Тройной запас означает, что на пересборку уходит не больше трети времени.
  // Список подпрограмм - по тому же тексту, карты уже готовы
  RebuildSubList(FullText);
  // Имена компонентов - тоже: присваивания Create(Self) могли появиться
  RebuildCompNames(FullText);
  // Уровни вложенности строк - по тому же тексту
  RebuildLineDepths(FullText);

  FPerfRebuild := PerfNow - T0;
  FMapStale := False;

  if FPerfFreq > 0 then
    FLastRebuildMs := (FPerfRebuild * 1000) div FPerfFreq
  else
    FLastRebuildMs := 0;

  if FMapTimer <> nil then
  begin
    I := FLastRebuildMs * 3;
    if I < 50 then
      I := 50;    // чаще нет смысла: глаз не различит
    // Верхняя граница высокая осознанно. При разборе в 600 мс потолок
    // в 400 означал бы, что таймер запускает новый разбор раньше, чем
    // кончился предыдущий, - программа встала бы намертво.
    if I > 3000 then
      I := 3000;
    FMapTimer.Interval := I;
  end;
end;

// Карта заново - только до конца видимой части экрана.
//
// Правка, задевшая маркер (открыла или закрыла комментарий, кавычку),
// меняет раскраску всего текста после себя. Полная пересборка идёт по
// таймеру (ScheduleMapRebuild), и на большом файле вместе с задержкой
// таймера (втрое больше длительности разбора, до 3 с) экран до неё
// показывал прежнюю раскраску. Здесь разбирается кусок от последнего
// диапазона, закончившегося до правки, до нижней видимой строки - экран
// раскрашивается сразу, остальное делает таймер.
//
// Диапазоны, закончившиеся до AEditPos, остаются как были, остальные
// выбрасываются; FMapPartialEnd - докуда карта теперь верна. Отрисовка,
// дойдя ниже этой позиции (прокрутили до полной пересборки), вызывает
// эту же процедуру с AEditPos = FMapPartialEnd.
procedure TForm1.RescanVisibleMap(AEditPos: Integer; AInvalidate: Boolean);
var
  KeepComments, KeepStrings, ResumePos, LimitPos, TopLine, LastLine: Integer;
  ClientRect: TRect;
begin
  if not FUseSyntaxHighlight or FMapStale or (AEditPos < 0) or
     (LineHeight <= 0) or not RichEdit1.HandleAllocated then
    Exit;

  // Нижняя граница - начало строки под последней видимой
  Windows.GetClientRect(RichEdit1.Handle, ClientRect);
  TopLine := SendMessageA(RichEdit1.Handle, EM_GETFIRSTVISIBLELINE, 0, 0);
  LastLine := TopLine + ClientRect.Bottom div LineHeight + 2;
  LimitPos := SendMessageA(RichEdit1.Handle, EM_LINEINDEX, LastLine, 0);
  if LimitPos < 0 then
    LimitPos := TextLenInternal;
  // Правка ниже экрана или видимая часть уже разобрана
  if LimitPos <= AEditPos then
    Exit;

  // Запас в маркер: правка могла достроить или разбить маркер слева
  AEditPos := AEditPos - FScheme.FMaxMarkerLen - 1;
  if AEditPos < 0 then
    AEditPos := 0;

  // Диапазоны идут по возрастанию и не пересекаются - остаются первые,
  // закончившиеся до правки. После конца диапазона - обычный код, с него
  // разбор и продолжается.
  KeepComments := 0;
  while (KeepComments <= High(CommentRanges)) and
        (CommentRanges[KeepComments].EndPos <= AEditPos) do
    Inc(KeepComments);
  KeepStrings := 0;
  while (KeepStrings <= High(StringRanges)) and
        (StringRanges[KeepStrings].EndPos <= AEditPos) do
    Inc(KeepStrings);
  ResumePos := 0;
  if KeepComments > 0 then
    ResumePos := CommentRanges[KeepComments - 1].EndPos;
  if (KeepStrings > 0) and (StringRanges[KeepStrings - 1].EndPos > ResumePos) then
    ResumePos := StringRanges[KeepStrings - 1].EndPos;

  SetLength(CommentRanges, KeepComments);
  SetLength(StringRanges, KeepStrings);
  ScanCommentRanges(TextRange(ResumePos, LimitPos - ResumePos), ResumePos);

  if LimitPos >= TextLenInternal then
    FMapPartialEnd := 0
  else
    FMapPartialEnd := LimitPos;
  // Кэш строк сверяет версию карты - строки разберутся заново
  Inc(FMapVer);

  if AInvalidate then
    Windows.InvalidateRect(RichEdit1.Handle, nil, False);
end;

// Показания системного счётчика высокого разрешения. GetTickCount с его
// шагом в 15 мс для замера одного нажатия не годится.
function TForm1.PerfNow: Int64;
var
  C: Int64;
begin
  if QueryPerformanceCounter(C) then
    Result := C
  else
    Result := 0;
end;

// Тики в миллисекунды, с одним знаком после запятой
function TForm1.PerfMs(ATicks: Int64): string;
begin
  if FPerfFreq <= 0 then
  begin
    Result := '?';
    Exit;
  end;
  Result := Format('%.1f', [ATicks * 1000 / FPerfFreq]);
end;

// Заказывает пересборку карты. Сама работа - через 150 мс, в MapTimerTick.
//
// RebuildCommentRangeMap читает ВЕСЬ текст редактора и проходит его посимвольно.
// Вызов на каждое EN_CHANGE означал полный разбор 32-мегабайтного файла по
// тридцать раз в секунду при удержанном BackSpace - это и была основная
// задержка при правке, куда более дорогая, чем статус-бар.
//
// Цена отсрочки: до полутора десятых секунды подсветка комментариев и строк
// отрисовывается по ПРЕЖНЕЙ карте. Позиции в ней уже не совпадают с текстом,
// поэтому в момент набора цвет на экране может быть неверным. Через 150 мс
// после последнего нажатия всё встаёт на место.
//
// Таймер, как и у статус-бара, повторным заказом не перезапускается.
procedure TForm1.ScheduleMapRebuild;
begin
  if not FUseSyntaxHighlight then
    Exit; // читать карту некому

  if FMapTimer = nil then
  begin
    RebuildCommentRangeMap; // таймера ещё нет - идёт FormCreate
    Exit;
  end;

  // Срок ОТОДВИГАЕМ: пока клавишу держат, разбор не нужен - он всё равно
  // устареет на следующем нажатии. Бесконечно откладывать не боимся:
  // отпускание клавиши исполняет заказ немедленно, см. WM_KEYUP
  // в NewRichEditProc.
  FMapTimer.Enabled := False;
  FMapTimer.Enabled := True;
end;

// Выполняет отложенную пересборку прямо сейчас.
//
// Нужна там, где карту СОХРАНЯЮТ, а не показывают: StoreCurrentWindow кладёт
// CommentRanges в запись окна и помечает MapValid. Если в этот момент заказ
// ещё висит, в кэш окна легла бы устаревшая карта - и она осталась бы там
// навсегда, ведь пересобирать её при возврате на вкладку уже не станут.
procedure TForm1.FlushMapRebuild;
begin
  if (FMapTimer = nil) or not FMapTimer.Enabled then
    Exit;

  RebuildCommentRangeMap; // она сама снимет заказ

  // Экран рисовался по СТАРОЙ карте, и сам по себе он об этом не узнает.
  // Без этой строки после отпускания клавиши картинка так и оставалась
  // с неверной подсветкой до первой прокрутки.
  RichEdit1.Invalidate;
end;

// Помечает грязной ТОЛЬКО строку, в которой стоит каретка.
//
// При одиночной правке без маркеров меняется ровно эта строка: перевод строки
// в набор маркеров входит, значит соседние строки сдвинуться не могли.
// Перерисовывать из-за неё весь экран не только дорого, но и вредно: карта
// в момент правки может отставать от текста, и незатронутые строки
// перерисовались бы по устаревшим диапазонам - отсюда и бегущие артефакты
// на подсветке строковых литералов. Не трогаем их пиксели - остаётся
// прежняя, верная картинка.
// Родная отрисовка RichEdit - ОТКЛЮЧЕНА.
//
// Раньше при снятых галках подсветки и направляющих WM_PAINT отдавался
// контролу. С нынешней конструкцией это не работает: контрол не знает ни
// нашего горизонтального сдвига FScrollX, ни своей каретки (её рисуем мы,
// см. SyncCaretX), а на длинных строках его координаты правее 32767
// недостоверны. При снятых галках на экране оказывался не тот кусок текста.
//
// Своя отрисовка без подсветки рисует только базовый слой и выделение -
// это недорого. Функция оставлена, чтобы не трогать места вызова.
function TForm1.NativePaintMode: Boolean;
begin
  Result := False;
end;

procedure TForm1.InvalidateCaretLine;
var
  Sel: TCharRange;
  LineIdx, LineStart: Integer;
  Pt: TPoint;
  R: TRect;
begin
  if not RichEdit1.HandleAllocated then
    Exit;
  if LineHeight <= 0 then
  begin
    Windows.InvalidateRect(RichEdit1.Handle, nil, False);
    Exit;
  end;

  SendMessageA(RichEdit1.Handle, EM_EXGETSEL, 0, Integer(@Sel));
  LineIdx := SendMessageA(RichEdit1.Handle, EM_EXLINEFROMCHAR, 0, Sel.cpMin);
  LineStart := SendMessageA(RichEdit1.Handle, EM_LINEINDEX, LineIdx, 0);
  if LineStart < 0 then
    Exit;

  // Y берём у контрола: он уже учитывает прокрутку, в том числе неполную
  SendMessageA(RichEdit1.Handle, EM_POSFROMCHAR, Integer(@Pt), LineStart);

  Windows.GetClientRect(RichEdit1.Handle, R);
  R.Top := Pt.Y;
  R.Bottom := Pt.Y + LineHeight;

  // Строка уехала за пределы видимой области - перерисовывать нечего
  if (R.Bottom < 0) or (R.Top > R.Bottom) then
    Exit;

  Windows.InvalidateRect(RichEdit1.Handle, @R, False);
end;

procedure TForm1.MapTimerTick(Sender: TObject);
begin
  RebuildCommentRangeMap; // заказ снимается внутри
  RichEdit1.Invalidate;   // экран рисовался по старой карте - перерисовать
end;

// Единая точка настройки табуляции.
//
// Раньше шаг передавался через EM_SETTABSTOPS, который принимает значение в
// dialog template units. Перевод пикселей в эти единицы делался через
// tmAveCharWidth шрифта РЕДАКТОРА, тогда как Windows пересчитывает их обратно
// через базовые единицы СИСТЕМНОГО шрифта. Для непропорционального Source Code
// Pro эти две ширины не совпадают, поэтому реальный шаг табуляции в RichEdit
// отличался от шага 48 px, которым рисует TabbedTextOut. Ошибка копилась на
// каждом символе табуляции - отсюда и уезжающая подсветка.
//
// EM_SETPARAFORMAT принимает позиции в твипах (1 дюйм = 1440 твипов), то есть
// в абсолютных единицах, не зависящих ни от какого шрифта. Перевод пикселей в
// твипы однозначен через LOGPIXELSX, и шаг RichEdit точно совпадает с нашим.
// Настройки редактора храним отдельно от цветовых схем: .clr привязаны к
// расширению исходника, а это общие параметры, одни на все языки.
function TForm1.SettingsFileName: string;
begin
  Result := ExtractFilePath(Application.ExeName) + 'editor.ini';
end;

// Схема цветов самой IDE. Отдельно от схем подсветки (*.clr в папке схем):
// это оформление окна, а не текста.
function TForm1.UiSchemaFileName: string;
begin
  Result := ExtractFilePath(Application.ExeName) + 'IDE.clr';
end;

// Цвет по умолчанию. Вызывается при запуске, до чтения схемы: так список
// ключей известен целиком, даже если файла схемы нет.
procedure TForm1.UiDefault(const AKey: string; ADef: TColor; ADark: TColor);
begin
  if FUiColors = nil then
    FUiColors := TStringList.Create;
  if FUiLight = nil then
    FUiLight := TStringList.Create;
  if FUiDark = nil then
    FUiDark := TStringList.Create;
  if FUiDarkDef = nil then
    FUiDarkDef := TStringList.Create;
  // Тёмный цвет не задан - тот же, что светлый (красный крестик и т.п.)
  if ADark = clDefault then
    ADark := ADef;
  if FUiLight.IndexOfName(AKey) < 0 then
    FUiLight.Add(AKey + '=' + ColorToString(ADef));
  if FUiDark.IndexOfName(AKey) < 0 then
    FUiDark.Add(AKey + '=' + ColorToString(ADark));
  if FUiDarkDef.IndexOfName(AKey) < 0 then
    FUiDarkDef.Add(AKey + '=' + ColorToString(ADark));
  if FUiColors.IndexOfName(AKey) < 0 then
    if FIdeDark then
      FUiColors.Add(AKey + '=' + ColorToString(ADark))
    else
      FUiColors.Add(AKey + '=' + ColorToString(ADef));
end;
function TForm1.UiColor(const AKey: string): TColor;
var
  I: Integer;
begin
  Result := clBtnFace;
  if FUiColors = nil then
    Exit;
  I := FUiColors.IndexOfName(AKey);
  if I >= 0 then
    Result := StringToColor(Copy(FUiColors[I], Length(AKey) + 2, MaxInt));
end;

procedure TForm1.UiSetColor(const AKey: string; AColor: TColor);
var
  I: Integer;
  L: TStringList;
begin
  if FUiColors = nil then
    Exit;
  I := FUiColors.IndexOfName(AKey);
  if I >= 0 then
    FUiColors[I] := AKey + '=' + ColorToString(AColor)
  else
    FUiColors.Add(AKey + '=' + ColorToString(AColor));
  // И в список своего режима - по нему пишется IDE.clr
  if FIdeMode = IdeModeCustom then
    L := UiCustomSet(FIdeCustom)
  else if FIdeMode = IdeModeDark then
    L := FUiDark
  else
    L := FUiLight;
  if L <> nil then
    L.Values[AKey] := ColorToString(AColor);
end;
