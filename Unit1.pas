      UiGlyphReset(TControl(Btns[BtnIdx]));
  finally
    Btns.Free;
  end;
end;

// AProp есть в списке AList через запятую? Без учёта регистра.
function PropInList(const AList, AProp: string): Boolean;
var
  Rest, Item: string;
  P: Integer;
begin
  Result := False;
  Rest := AList;
  while Rest <> '' do
  begin
    P := Pos(',', Rest);
    if P = 0 then
      P := Length(Rest) + 1;
    Item := Trim(Copy(Rest, 1, P - 1));
    Rest := Copy(Rest, P + 1, MaxInt);
    if CompareText(Item, AProp) = 0 then
    begin
      Result := True;
      Exit;
    end;
  end;
end;

// Поправки свойств элементов массива AArray из editor.ini, раздел
// [Array <массив>], строки "<номер>.<свойство>=<значение>":
//   [Array PalBtn]
//   17.Caption=Надпись
//   17.Hint=Надпись на форме
// Элемент - компонент формы <массив><номер>. Значение - как в .dfm, без
// кавычек у строк. Не нашёлся элемент или свойство, не подошло значение -
// строка пропускается, причина - в HiLite log. Так же пропускаются Name и
// свойства из ACodeProps (список через запятую): ими управляет код.
procedure TForm1.ApplyArrayIni(const AArray, ACodeProps: string);
var
  Ini: TIniFile;
  Keys: TStringList;
  I, P: Integer;
  Section, Key, Prop, Value: string;
  C: TComponent;
begin
  if not FileExists(SettingsFileName) then
    Exit;
  Section := 'Array ' + AArray;
  Ini := TIniFile.Create(SettingsFileName);
  Keys := TStringList.Create;
  try
    Ini.ReadSection(Section, Keys);
    for I := 0 to Keys.Count - 1 do
    begin
      Key := Keys[I];
      P := Pos('.', Key);
      if P < 2 then
        Continue;
      Prop := Copy(Key, P + 1, MaxInt);
      if (CompareText(Prop, 'Name') = 0) or PropInList(ACodeProps, Prop) then
      begin
        Dbg('21939: [' + Section + '] ' + Key + ': свойством управляет код - ' +
        'строка пропущена');
            Continue;
      end;
      C := FindComponent(AArray + Copy(Key, 1, P - 1));
      if C = nil then
      begin
        Dbg('21946: [' + Section + '] ' + Key + ': компонента ' + AArray +
            Copy(Key, 1, P - 1) + ' нет');
        Continue;
      end;
      Value := Ini.ReadString(Section, Key, '');
      if not SetPropFromText(C, Prop, Value) then
        Dbg('21952: [' + Section + '] ' + Key + ': свойство не записано (' +
            C.ClassName + ', значение "' + Value + '")');
    end;
  finally
    Keys.Free;
    Ini.Free;
  end;
end;

// Свойство AProp объекта AObj из текста AValue - через RTTI: строка,
// символ, целое (у TColor - и имя цвета: clRed), перечисление (в том числе
// True/False), множество ([fsBold, fsItalic]). AProp может быть путём
// через вложенные объекты: Font.Style. False - свойства нет, оно только
// для чтения, другого типа или значение не подошло.
function TForm1.SetPropFromText(AObj: TObject; const AProp,
                                AValue: string): Boolean;
var
  PI: PPropInfo;
  N, P: Integer;
  Obj: TObject;
  Path: string;
begin
  Result := False;
  // Вложенное свойство (Font.Style): спуск по объектным свойствам
  Obj := AObj;
  Path := AProp;
  P := Pos('.', Path);
  while P > 0 do
  begin
    PI := GetPropInfo(Obj, Copy(Path, 1, P - 1));
    if (PI = nil) or (PI^.PropType^^.Kind <> tkClass) then
      Exit;
    Obj := GetObjectProp(Obj, PI);
    if Obj = nil then
      Exit;
    Path := Copy(Path, P + 1, MaxInt);
    P := Pos('.', Path);
  end;
  PI := GetPropInfo(Obj, Path);
  if (PI = nil) or (PI^.SetProc = nil) then
    Exit;
  try
    case PI^.PropType^^.Kind of
      tkString, tkLString, tkWString:
        SetStrProp(Obj, PI, AValue);
      tkChar:
        if AValue <> '' then
        SetOrdProp(Obj, PI, Ord(AValue[1]))
      else
        Exit;
      tkInteger:
      begin
        if (PI^.PropType^ = TypeInfo(TColor)) and IdentToColor(AValue, N) then
          SetOrdProp(Obj, PI, N)
        else
          SetOrdProp(Obj, PI, StrToInt(AValue));
      end;
      tkEnumeration:
        SetEnumProp(Obj, PI, AValue);
      tkSet:
        SetSetProp(Obj, PI, AValue);
    else
      Exit;
    end;
    Result := True;
  except
    Result := False;
  end;
end;

procedure TForm1.DsgPaletteReset;
begin
  if FDsgPalette <> nil then
    FDsgPalette.ClearSelection;
end;

// Щелчок по компоненту в конструкторе - он же в дереве инспектора
procedure TForm1.DsgSelect(const AName: string);
var
  T, P: TTreeNode;
begin
  FDsgSelecting := True;
  try
    if AName = '' then
    begin
      // Безымянный компонент (кнопки и вкладки палитры, созданные в чужом
      // модуле): по имени его узел не найти - берём узел, по которому
      // DsgAddRuntime его поставил
      T := nil;
      if FDesigner <> nil then
        T := DsgMadeNode(FDsgMade, FObjTree, FDesigner.SelControl);
      if T <> nil then
      begin
        P := T.Parent;
        while P <> nil do
        begin
          P.Expanded := True;
          P := P.Parent;
        end;
        FObjTree.Selected := T;
        T.MakeVisible;
      end;
    end
    // Сначала узлы .dfm; нет такого - компонент из кода (по переменной)
    else if not ObjSelectAnyName(AName) then
      ObjSelectName(AName);
  finally
    FDsgSelecting := False;
  end;
  FDsgJumpTimer.Enabled := False;
  FDsgJumpTimer.Enabled := True;
end;

// Выделенный в конструкторе компонент - в тексте: заголовок object в .dfm
// или строка создания в .pas (тот же переход, что по щелчку в дереве).
// Фокус возвращается конструктору: Delete и Ctrl+Z должны идти ему, а не
// тексту.
procedure TForm1.DsgJumpTimerTick(Sender: TObject);
begin
  if (FDesigner <> nil) and FDesigner.Dragging then
    Exit; // кнопка мыши ещё нажата - ждём
  FDsgJumpTimer.Enabled := False;
  if (FDesigner = nil) or (FObjTree = nil) or (FObjTree.Selected = nil) then
    Exit;
  ObjJumpToSelected;
  if (FDesigner <> nil) and (FDesigner.Form <> nil) and
     FDesigner.Form.Visible then
    FDesigner.Form.SetFocus;
end;

// Компонент подвинули или потянули - новые значения в текст .dfm
procedure TForm1.DsgChange(const AName: string; AProps: TStrings);
var
  Old, New: string;
  Pos2: TStringList;
  PosOnly: Boolean;
begin
  // Открытая правка инспектора - в текст до правки конструктора: после неё
  // строки .dfm могли сдвинуться
  if FObjEditing then
    ObjApplyEdit;
  Old := DsgGetText;
  New := DfmSetProps(Old, AName, AProps);
  if New = Old then
    Exit;

  // Серия (перенос группы, выравнивание): один шаг отката на всю серию,
  // инспектор - в конце (DsgBatch)
  if FDsgBatch > 0 then
  begin
    if not FDsgBatchPushed then
    begin
      DsgPushUndo(Old, '');
      FDsgBatchPushed := True;
    end;
    DsgSetText(New);
    DsgOtherSync(Old, New, AName, AProps);   // то же - спрятанному виду
    Exit;
  end;

  // Окно формы только подвинули по экрану: это место окна, а не правка
  // формы. В откат такой шаг не идёт - Ctrl+Z не должен возвращать окно
  // назад. Изменение размера формы - правка, оно в откат идёт.
  PosOnly := False;
  if (FDesigner <> nil) and (CompareText(AName, FDesigner.RootName) = 0) then
  begin
    Pos2 := TStringList.Create;
    try
      Pos2.Add('Left=' + AProps.Values['Left']);
      Pos2.Add('Top=' + AProps.Values['Top']);
      PosOnly := DfmSetProps(Old, AName, Pos2) = New;
    finally
      Pos2.Free;
    end;
  end;

  if not PosOnly then
    DsgPushUndo(Old, '');
  DsgSetText(New);
  DsgOtherSync(Old, New, AName, AProps);     // то же - спрятанному виду

  // Инспектор - по новому тексту, выделение в дереве - то, что выделено
  // маркерами в конструкторе. Это не всегда AName: окно формы тянут за
  // заголовок, а выделен компонент на ней - тогда AName - сама форма, а
  // выделение остаётся на компоненте. Пока дерево перестраивается,
  // конструктор своё выделение не меняет.
  FDsgSelecting := True;
  try
    FObjDfmKey := '';
    RefreshObjectInspector(False);
    if (FDesigner <> nil) and (FDesigner.SelectedName <> '') then
      ObjSelectName(FDesigner.SelectedName)
    else
      ObjSelectName(AName);
  finally
    FDsgSelecting := False;
  end;
end;

// Серия правок конструктора: начало и конец. В конце - инспектор по
// новому тексту, выделение прежнее; конструктор своё не меняет (группа
// остаётся).
procedure TForm1.DsgBatch(ABegin: Boolean);
begin
  if ABegin then
  begin
    if FObjEditing then
      ObjApplyEdit;
    Inc(FDsgBatch);
    if FDsgBatch = 1 then
      FDsgBatchPushed := False;
    Exit;
  end;
  if FDsgBatch > 0 then
    Dec(FDsgBatch);
  if (FDsgBatch > 0) or not FDsgBatchPushed then
    Exit;
  FDsgBatchPushed := False;
  FDsgSelecting := True;
  try
    FObjDfmKey := '';
    RefreshObjectInspector(False);
    if FDesigner <> nil then
      ObjSelectName(FDesigner.SelectedName);
  finally
    FDsgSelecting := False;
  end;
end;

// Состав группы в конструкторе изменился - таблица свойств по группе
// (ObjGroupView). Выделение в конструкторе не трогаем.
procedure TForm1.DsgGroupChange(Sender: TObject);
begin
  if (FObjTree = nil) or (FObjTree.Selected = nil) then
    Exit;
  FDsgSelecting := True;
  try
    ObjTreeChange(FObjTree, FObjTree.Selected);
  finally
    FDsgSelecting := False;
  end;
end;

// Имена выделенных в конструкторе (группа или один) - без тех, чей
// родитель тоже выделен: копия и удаление родителя их и так захватывают
procedure TForm1.DsgSelNames(ANames: TStrings);
var
  I: Integer;
  Txt, P: string;
  Nested: Boolean;
begin
  ANames.Clear;
  if FDesigner = nil then
    Exit;
  FDesigner.GroupNames(ANames);
  if ANames.Count < 2 then
    Exit;
  Txt := DsgGetText;
  for I := ANames.Count - 1 downto 0 do
  begin
    Nested := False;
    P := DfmParentOf(Txt, ANames[I]);
    while (P <> '') and not Nested do
    begin
      if ANames.IndexOf(P) >= 0 then
        Nested := True
      else
        P := DfmParentOf(Txt, P);
    end;
    if Nested then
      ANames.Delete(I);
  end;
end;

// Текст формы поменялся не в конструкторе (инспектор, откат) - строим
// форму заново, выделение сохраняется
procedure TForm1.DsgReload;
var
  Err: string;
  WasVisible: Boolean;
  TickStart, TickLoad, TickRuntime: Cardinal;
begin
  if FDesigner = nil then
    Exit;
  TickStart := GetTickCount;
  // Новая форма строится невидимой, прежняя остаётся на экране до её
  // показа (TFormDesigner.ShowForm) - без мелькания. Спрятанная (Hide form,
  // запуск программы) остаётся спрятанной.
  WasVisible := (FDesigner.Form <> nil) and FDesigner.Form.Visible;
  if FDesigner.Load(DsgGetText, Err, True) then
  begin
    TickLoad := GetTickCount;
    DsgAddRuntime;
    TickRuntime := GetTickCount;
    if WasVisible then
      FDesigner.ShowForm
    else
      FDesigner.DropOldForm;
    Dbg('21992: конструктор, форма заново: .dfm ' +
        IntToStr(TickLoad - TickStart) + ' мс, из кода и живой вид ' +
        IntToStr(TickRuntime - TickLoad) + ' мс, показ ' +
        IntToStr(GetTickCount - TickRuntime) + ' мс', clNavy);
    // Спрятанный второй вид отстал - перестроится, когда правки стихнут
    DsgOtherLater;
  end
  else
  begin
    ShowMessage('20990:Форму не удалось построить:'#13#10 + Err);
    FreeAndNil(FDesigner);
    DsgFreeOther;
    DsgPaletteReset;
  end;
end;

// Текст .dfm с тем местом окна формы, где оно стоит сейчас: откат
// возвращает компоненты, но не окно, которое с тех пор подвинули
function TForm1.DsgKeepFormPos(const AText: string): string;
var
  L: TStringList;
begin
  Result := AText;
  if (FDesigner = nil) or (FDesigner.Form = nil) then
    Exit;
  L := TStringList.Create;
  try
    L.Add('Left=' + IntToStr(FDesigner.Form.Left));
    L.Add('Top=' + IntToStr(FDesigner.Form.Top));
    Result := DfmSetProps(AText, FDesigner.RootName, L);
  finally
    L.Free;
  end;
end;

// Шаг отката конструктора: текст .dfm до правки и, если правка меняла
// модуль формы, его текст ('' - модуль не менялся)
procedure TForm1.DsgPushUndo(const ADfm, APas: string);
begin
  FDsgUndo.Add(ADfm);
  FDsgUndoPas.Add(APas);
  if FDsgUndo.Count > 100 then
  begin
    FDsgUndo.Delete(0);
    FDsgUndoPas.Delete(0);
  end;
end;

// Delete в конструкторе: выделенный компонент и всё, что в нём лежит,
// уходят из .dfm; их поля - из объявления класса формы в .pas; ссылки на
// них в свойствах других компонентов (ActivePage, PopupMenu, Images) -
// тоже. Обработчики событий остаются, как и в Delphi: в них может быть код.
// Пишется во вкладки, на диск - только по Save. Ctrl+Z возвращает оба
// файла одним шагом.
procedure TForm1.DsgDelete;
var
  OldDfm, NewDfm, PasFile, OldPas, NewPas: string;
  Names, Sel, One: TStringList;
  I: Integer;
  TickStart, TickText, TickInsp: Cardinal;
  WasDeferred: Boolean;
begin
  if FDesigner = nil then
    Exit;
  if FObjEditing then
    ObjApplyEdit;
  TickStart := GetTickCount;
  // Таблица свойств - после правки, когда она стихнет (ObjPropsTimerTick)
  WasDeferred := FObjDeferProps;
  FObjDeferProps := True;
  try
    OldDfm := DsgGetText;
    Names := TStringList.Create;
    Sel := TStringList.Create;
    One := TStringList.Create;
    try
      // Выделенные - группа или один; сама форма и компоненты из кода не
      // входят (DsgSelNames)
      DsgSelNames(Sel);
      if Sel.Count = 0 then
        Exit;
      NewDfm := OldDfm;
      for I := 0 to Sel.Count - 1 do
        if DfmObjectNames(NewDfm, Sel[I], One) then
        begin
          Names.AddStrings(One);
          NewDfm := DfmDeleteObject(NewDfm, Sel[I]);
        end;
      if NewDfm = OldDfm then
        Exit;
      NewDfm := DfmRemoveRefs(NewDfm, Names);

      // Модуль формы: читаем до записи .dfm - DsgFileText может открыть
      // его вкладку
      OldPas := '';
      NewPas := '';
      PasFile := UnitFileFor(FDsgDfm);
      if PasFile <> '' then
      begin
        OldPas := DsgFileText(PasFile);
        if OldPas <> '' then
          NewPas := PasRemoveFields(OldPas, DfmRootClass(OldDfm), Names);
        if NewPas = OldPas then
        begin
          OldPas := '';
          NewPas := '';
        end;
      end;

      DsgPushUndo(OldDfm, OldPas);
      DsgSetText(NewDfm);
      if NewPas <> '' then
        DsgSetFileText(PasFile, NewPas);
    finally
      One.Free;
      Sel.Free;
      Names.Free;
    end;
    TickText := GetTickCount;

    FDsgSelecting := True;
    try
      FObjDfmKey := '';
      RefreshObjectInspector(False);
    finally
      FDsgSelecting := False;
    end;
    TickInsp := GetTickCount;
    DsgReload;
    Dbg('21993: конструктор, удаление: тексты вкладок ' +
        IntToStr(TickText - TickStart) + ' мс, инспектор ' +
        IntToStr(TickInsp - TickText) + ' мс, форма ' +
        IntToStr(GetTickCount - TickInsp) + ' мс', clNavy);
  finally
    FObjDeferProps := WasDeferred;
  end;
end;

// ---------------------------------------------------------------------------
//  Меню конструктора по правому щелчку
//
//  Edit    - Undo, Cut, Copy, Paste, Delete
//  Control - Bring to Front, Send to Back
//
//  Буфер обмена - обычный текст блока object ... end, как у Delphi: его
//  можно вставить и в саму Delphi, и из неё. Горячие клавиши те же и в
//  окне конструктора (Ctrl+Z, Ctrl+X, Ctrl+C, Ctrl+V, Del) - они
//  забираются раньше меню главного окна, см. DsgOwnKey.
// ---------------------------------------------------------------------------

procedure TForm1.DsgContext(const AScreen: TPoint);
var
  Nm: string;
  Sel, CanPaste: Boolean;
begin
  if FDesigner = nil then
    Exit;
  // Меню общее с конструктором RapidQ: пункты, которые он прячет, - назад
  FDsgMenuRq := False;
  FDsgMiReplace.Visible := True;
  FDsgMenuGrp3.Visible := True;
  FDsgMiLiveSep.Visible := True;
  FDsgMiLiveView.Visible := True;

  // Что доступно: выделен компонент (не сама форма и не из кода), есть
  // шаг отката, в буфере - текст объекта
  Nm := FDesigner.SelectedName;
  Sel := (Nm <> '') and (CompareText(Nm, FDesigner.RootName) <> 0) and
         not FDesigner.IsRuntime(FDesigner.Form.FindComponent(Nm));
  CanPaste := Clipboard.HasFormat(CF_TEXT) and
              (CompareText(Copy(TrimLeft(Clipboard.AsText), 1, 7), 'object ') = 0);
  // Нет в буфере обмена - вставится последний Cut или Copy из истории
  DsgClipLoad;
  if not CanPaste and (FDsgClipTexts.Count > 0) then
    CanPaste := True;
  if FDsgMiClipHist <> nil then
  begin
    FDsgMiClipHist.Visible := True;
    FDsgMiClipHist.Enabled := FDsgClipTexts.Count > 0;
  end;
  if FDsgMiLayoutLog <> nil then
    FDsgMiLayoutLog.Visible := True;
  FDsgMiUndo.Enabled := FDsgUndo.Count > 0;
  FDsgMiCut.Enabled := Sel;
  FDsgMiCopy.Enabled := Sel;
  FDsgMiPaste.Enabled := CanPaste;
  FDsgMiDelete.Enabled := Sel;
  FDsgMiFront.Enabled := Sel;
  FDsgMiBack.Enabled := Sel;
  // Переименование - одного компонента; замена класса - и группы
  FDsgMiRename.Enabled := Sel and (FDesigner.GroupCount < 2);
  FDsgMiReplace.Enabled := Sel and
    not ((FDesigner.GroupCount > 1) and FDesigner.GroupIsRuntime);
  FDsgMiCopyNames.Enabled := Nm <> '';
  // Выравнивание - у группы (Shift+щелчок), по первому выделенному
  // Группу из компонентов кода не выравнивают: их место задаёт код
  DsgAlignMenuExtra;
  FDsgMenuGrpAlign.Enabled := (FDesigner.GroupCount > 1) and
                              not FDesigner.GroupIsRuntime;
  // Шаблоном сохраняется выделенное меню (TMainMenu, TPopupMenu)
  FDsgMiMenuSave.Enabled := Sel and
    (FDesigner.Form.FindComponent(Nm) is TMenu);
  // Пункты - когда в дереве объектов выбран пункт меню этой формы
  FDsgMiItemIns.Enabled := DsgMenuItemName <> '';
  FDsgMiItemDel.Enabled := FDsgMiItemIns.Enabled;
  FDsgMiItemSub.Enabled := FDsgMiItemIns.Enabled;
  // Вид формы - живой или по .dfm: только у своей формы редактора
  FDsgMiLiveView.Enabled := IsOwnProject and
                            (OwnLiveForm(FObjFormClass) <> nil);
  if FDsgLiveView then
    FDsgMiLiveView.Caption := DsgCapDfm
  else
    FDsgMiLiveView.Caption := DsgCapLive;

  // Правый щелчок выделил компонент, и DsgSelect завёл таймер перехода к
  // коду. Меню - свой цикл сообщений, таймер срабатывает внутри него:
  // переход переключает вкладку и фокус, и меню закрывается, едва
  // появившись. При правом щелчке к коду не переходим - как в Delphi.
  if FDsgJumpTimer <> nil then
    FDsgJumpTimer.Enabled := False;

  FDsgMenu.Popup(AScreen.X, AScreen.Y);
end;

// Пункты Align, которых нет в .dfm, - в конец подменю при первом показе
// меню: расставить группу по ширине или высоте родителя на равных
// промежутках (TFormDesigner.SpaceGroup). Созданы в коде - в .dfm их
// можно перенести потом, как остальные пункты этого меню.
procedure TForm1.DsgAlignMenuExtra;

  function NewItem(const ACaption: string): TMenuItem;
  begin
    Result := TMenuItem.Create(Self);
    Result.Caption := ACaption;
    Result.OnClick := DsgMenuClick;
    FDsgMenuGrpAlign.Add(Result);
  end;

begin
  if (FDsgMiSpaceH <> nil) or (FDsgMenuGrpAlign = nil) then
    Exit;
  NewItem('-');
  FDsgMiSpaceH := NewItem('Space Equally Across Width');
  FDsgMiSpaceV := NewItem('Space Equally Across Height');
end;

// Hide/Show form: окно конструктора - спрятать или показать как было
procedure TForm1.DsgShowHideClick(Sender: TObject);
var
  Shown: TFormDesigner;
begin
  // В Basic - конструктор RapidQ, в Delphi - конструктор Delphi
  Shown := ShownDesigner;
  if (Shown = nil) or (Shown.Form = nil) then
    Exit;
  if Shown.Form.Visible then
    Shown.Form.Hide    // не Close: Close закрыл бы конструктор
  else
  begin
    // ShowForm, а не Form.Show: форма появляется уже нарисованной
    Shown.ShowForm;
    if Shown = FDesigner then
      FDsgHiddenForRun := False; // показали вручную - запуск её уже не вернёт
  end;
  UpdateToolbarState;
end;

procedure TForm1.DsgMenuClick(Sender: TObject);
begin
  // Меню открыл конструктор RapidQ - его команды
  if FDsgMenuRq then
  begin
    RqDsgMenuClick(Sender);
    Exit;
  end;
  if Sender = FDsgMiUndo then
    DsgUndo
  else if Sender = FDsgMiCut then
    DsgCut
  else if Sender = FDsgMiCopy then
    DsgCopy
  else if Sender = FDsgMiPaste then
    DsgPaste
  else if Sender = FDsgMiClipHist then
    DsgClipHistory
  else if Sender = FDsgMiLayoutLog then
    DsgLayoutLog
  else if Sender = FDsgMiDelete then
    DsgDelete
  else if Sender = FDsgMiFront then
    DsgOrder(True)
  else if Sender = FDsgMiBack then
    DsgOrder(False)
  else if Sender = FDsgMiRename then
    DsgRename
  else if Sender = FDsgMiReplace then
    DsgReplace
  else if Sender = FDsgMiCopyNames then
    DsgCopyNames
  else if Sender = FDsgMiMenuWizard then
    DsgMenuWizard
  else if Sender = FDsgMiMenuSave then
    DsgMenuSaveTemplate
  else if Sender = FDsgMiMenuDelTpl then
    DsgMenuDeleteTemplates
  else if Sender = FDsgMiMenuRes then
    DsgMenuFromResource
  else if Sender = FDsgMiMenuSelect then
    DsgMenuSelect
  else if Sender = FDsgMiMenuEdit then
    DsgMenuEdit
  else if Sender = FDsgMiItemIns then
    DsgMenuItemInsert(False)
  else if Sender = FDsgMiItemSub then
    DsgMenuItemInsert(True)
  else if Sender = FDsgMiItemDel then
    DsgMenuItemDelete
  else if Sender = FDsgMiAlignLeft then
    FDesigner.AlignGroup(0)
  else if Sender = FDsgMiAlignRight then
    FDesigner.AlignGroup(1)
  else if Sender = FDsgMiAlignTop then
    FDesigner.AlignGroup(2)
  else if Sender = FDsgMiAlignBottom then
    FDesigner.AlignGroup(3)
  else if Sender = FDsgMiAlignWidth then
    FDesigner.AlignGroup(4)
  else if Sender = FDsgMiAlignHeight then
    FDesigner.AlignGroup(5)
  else if Sender = FDsgMiSpaceH then
    FDesigner.AlignGroup(6)
  else if Sender = FDsgMiSpaceV then
    FDesigner.AlignGroup(7)
  else if Sender = FDsgMiLiveView then
    DsgSwitchView;
end;

// Имя свободно в форме конструктора: нет объекта в .dfm и слова в .pas
function TForm1.DsgMenuNameFree(const AName: string): Boolean;
var
  RangeStart, RangeEnd: Integer;
begin
  Result := not DfmObjectRange(FMenuWizDfm, AName, RangeStart, RangeEnd) and
            ((FMenuWizPas = '') or not PasHasIdent(FMenuWizPas, AName));
end;

// «Перенести в .dfm»: разбор компонентов дерева объектов - какие из
// созданных кодом можно перенести в .dfm и что останется в коде. Окно
// разбора немодальное: по его строкам ходят в редакторе; в нём же
// отмеченные компоненты переносятся и перенос откатывается.
procedure TForm1.ObjMoveClick(Sender: TObject);
var
  PasFile, PasText, DfmText, FormClass: string;
  List: TList;
  Index: Integer;
  Host: TDfmMoveHost;
begin
  if (FObjTree = nil) or (FObjDfmFile = '') or (FObjTree.Items.Count = 0) then
  begin
    ShowMessage('Дерево объектов пусто: откройте .pas или .dfm формы.');
    Exit;
  end;
  PasFile := UnitFileFor(FObjDfmFile);
  if PasFile = '' then
  begin
    ShowMessage('Модуль формы (.pas) для ' + ExtractFileName(FObjDfmFile) +
    ' не найден.');
                Exit;
  end;
  DfmText := DsgFileText(FObjDfmFile);
  PasText := DsgFileText(PasFile);
  FormClass := DfmRootClass(DfmText);
  List := TList.Create;
  try
    DfmMoveAnalyze(FObjTree, PasText, FormClass, List);
  except
    for Index := 0 to List.Count - 1 do
      TObject(List[Index]).Free;
    List.Free;
    raise;
  end;
  // Окно разбора забирает список себе и освободит при закрытии
  Host.GoLine := ObjMoveGoLine;
  Host.GetText := ObjMoveGetText;
  Host.SetTexts := ObjMoveSetTexts;
  Host.Done := ObjMoveDone;
  FObjMoveDfm := FObjDfmFile;
  DfmMoveShowReport(List, PasFile, FObjDfmFile, FormClass, PasText, DfmText,
                    Host);
end;

// Окно разбора: встать на строку модуля формы
procedure TForm1.ObjMoveGoLine(ALine: Integer);
begin
  JumpToUnitLine(ALine);
end;

// Окно разбора: текст файла из его вкладки
function TForm1.ObjMoveGetText(const AFile: string): string;
begin
  Result := DsgFileText(AFile);
end;

// Перенос в .dfm или его откат: оба текста - во вкладки, на диск - по Save.
// Открыт конструктор этой формы - прежние тексты идут ещё и шагом в его
// откат (Ctrl+Z в форме), а форма в нём перестраивается.
procedure TForm1.ObjMoveSetTexts(const APasFile, APasText, ADfmFile,
                                 ADfmText: string);
var
  InDesigner: Boolean;
begin
  ObjCancelEdit;
  InDesigner := (FDesigner <> nil) and (CompareText(FDsgDfm, ADfmFile) = 0);
  if InDesigner then
    DsgPushUndo(DsgFileText(ADfmFile), DsgFileText(APasFile));
  DsgSetFileText(APasFile, APasText);
  DsgSetFileText(ADfmFile, ADfmText);
  if InDesigner then
    DsgReload;
end;

// Перенос или откат сделан. Окно разбора в этот момент ещё внутри своего
// обработчика - дерево и разбор перестраиваются следом, сообщением.
procedure TForm1.ObjMoveDone;
begin
  PostMessage(Handle, WM_USER + 318, 0, 0);
end;

// Дерево объектов - по новым текстам; разбор - заново, если на вкладке
// Objects та же форма
procedure TForm1.WMObjMoveAgain(var Msg: TMessage);
begin
  FObjDfmKey := '';
  RefreshObjectInspector(True);
  if (FObjMoveDfm <> '') and (CompareText(FObjDfmFile, FObjMoveDfm) = 0) then
    ObjMoveClick(nil);
end;

// Мастер меню (Insert From Template): наборы и, в конце списка, меню самой
// формы
procedure TForm1.DsgMenuWizard;
var
  Templates: TList;
begin
  Templates := TList.Create;
  try
    MenuLoadTemplates(MenuTemplateDir, Templates);
    DsgMenuWizardShow(Templates, '', False);
  finally
    MenuFreeTemplates(Templates);
    Templates.Free;
  end;
end;

// Edit Menu: мастер сразу на меню формы - выделенном в конструкторе или
// первом; его пункты снимаются, переименовываются, им меняется клавиша
procedure TForm1.DsgMenuEdit;
var
  Templates: TList;
  MenuName: string;
  Comp: TComponent;
begin
  if (FDesigner = nil) or (FDesigner.Form = nil) then
    Exit;
  MenuName := FDesigner.SelectedName;
  Comp := nil;
  if MenuName <> '' then
    Comp := FDesigner.Form.FindComponent(MenuName);
  if not (Comp is TMenu) then
    MenuName := '';
  Templates := TList.Create;
  try
    MenuLoadTemplates(MenuTemplateDir, Templates);
    DsgMenuWizardShow(Templates, MenuName, True);
  finally
    MenuFreeTemplates(Templates);
    Templates.Free;
  end;
end;

// Общий запуск мастера: текст формы и модуля - для проверки имён, по
// закрытии - выделить последнее вставленное или правленое меню
procedure TForm1.DsgMenuWizardShow(ATemplates: TList; const ASelect: string;
                                   AEditMode: Boolean);
var
  Host: TMenuWizardHost;
  PasFile: string;
begin
  if (FDesigner = nil) or (FDesigner.Form = nil) then
    Exit;
  if FObjEditing then
    ObjApplyEdit;
  FMenuWizDfm := DsgGetText;
  PasFile := UnitFileFor(FDsgDfm);
  FMenuWizPas := '';
  if PasFile <> '' then
    FMenuWizPas := DsgFileText(PasFile);
  FMenuWizLast := '';

  Host.NameFree := DsgMenuNameFree;
  Host.OnAdd := DsgMenuWizardAdd;
  Host.OnUndo := DsgMenuWizardUndo;
  Host.HasMain := DsgMenuHasMain;
  Host.OnApply := DsgMenuWizardApply;
  Host.OnExisting := DsgMenuExisting;
  Host.OnDelete := DsgMenuWizardDelete;
  Host.SelectMenu := ASelect;
  Host.EditMode := AEditMode;
  try
    if (MenuWizardRun(ATemplates, Host) > 0) and (FMenuWizLast <> '') and
       (FDesigner <> nil) then
    begin
      FDesigner.SelectByName(FMenuWizLast);
      DsgSelect(FMenuWizLast);
    end;
  finally
    FMenuWizDfm := '';
    FMenuWizPas := '';
    FMenuWizLast := '';
  end;
end;

// Меню формы (TMainMenu, TPopupMenu) - шаблонами «в форме» в конец списка
procedure TForm1.DsgMenuExisting(AList: TList);
var
  AllNames: TStringList;
  Index: Integer;
  MenuClass: string;
begin
  if (FDesigner = nil) or (FMenuWizDfm = '') then
    Exit;
  AllNames := TStringList.Create;
  try
    if not DfmObjectNames(FMenuWizDfm, FDesigner.RootName, AllNames) then
      Exit;
    for Index := 0 to AllNames.Count - 1 do
    begin
      MenuClass := DfmObjectClass(FMenuWizDfm, AllNames[Index]);
      if MenuIsMainClass(MenuClass) or MenuIsPopupClass(MenuClass) then
        AList.Add(MenuTemplateFromDfmObj(
          DfmObjectText(FMenuWizDfm, AllNames[Index]), AllNames[Index],
          MenuIsPopupClass(MenuClass)));
    end;
  finally
    AllNames.Free;
  end;
end;

// «Удалить» мастера: меню формы целиком - из .dfm со всеми пунктами, их
// поля - из .pas, ссылка Menu у формы - тоже. Обработчики пунктов в коде
// остаются, как при Delete в конструкторе. Одним шагом отката.
function TForm1.DsgMenuWizardDelete(const AMenuName: string): Boolean;
var
  OldDfm, NewDfm, PasFile, OldPas, NewPas: string;
  Names: TStringList;
begin
  Result := False;
  if FDesigner = nil then
    Exit;
  OldDfm := DsgGetText;
  Names := TStringList.Create;
  try
    if not DfmObjectNames(OldDfm, AMenuName, Names) then
      Exit;
    NewDfm := DfmDeleteObject(OldDfm, AMenuName);
    if NewDfm = OldDfm then
      Exit;
    NewDfm := DfmRemoveRefs(NewDfm, Names);
    PasFile := UnitFileFor(FDsgDfm);
    OldPas := '';
    NewPas := '';
    if PasFile <> '' then
    begin
      OldPas := DsgFileText(PasFile);
      if OldPas <> '' then
        NewPas := PasRemoveFields(OldPas, DfmRootClass(OldDfm), Names);
      if NewPas = OldPas then
        NewPas := '';
    end;
    DsgApply(OldDfm, NewDfm, PasFile, OldPas, NewPas, '');
  finally
    Names.Free;
  end;
  if CompareText(FMenuWizLast, AMenuName) = 0 then
    FMenuWizLast := '';
  FMenuWizDfm := DsgGetText;
  if PasFile <> '' then
    FMenuWizPas := DsgFileText(PasFile);
  Result := True;
end;

// Новый пункт шаблона AIndex меню формы - в текст .dfm: перед ближайшим
// следующим соседом того же уровня, который уже есть в форме, иначе
// последним в своего владельца (пункт уровнем выше, для верхнего уровня -
// само меню). Имя - по подписи; поле - в APas. Пункту шаблона ставится
// это имя: в него лягут его новые подпункты.
function TForm1.DsgMenuInsertNew(ATemplate: TMenuTemplate; AIndex: Integer;
                                 const ADfm: string; var APas: string; const AFormClass: string;
                                 AUsed: TStrings): string;
var
  Item, Other: TMenuTplItem;
  ItemPos, First, Last, Code: Integer;
  NewName, Before, OwnerName, ObjText: string;
begin
  Result := ADfm;
  Item := TMenuTplItem(ATemplate.Items[AIndex]);

  // Следующий сосед, который уже в форме
  Before := '';
  ItemPos := AIndex + 1;
  while ItemPos < ATemplate.Items.Count do
  begin
    Other := TMenuTplItem(ATemplate.Items[ItemPos]);
    if Other.Level < Item.Level then
      Break;
    if (Other.Level = Item.Level) and Other.Checked and
       (Other.ItemName <> '') and
       DfmObjectRange(Result, Other.ItemName, First, Last) then
    begin
      Before := Other.ItemName;
      Break;
    end;
    Inc(ItemPos);
  end;

  // Владелец: ближайший выше пункт уровнем меньше
  OwnerName := ATemplate.MenuName;
  if Item.Level > 0 then
  begin
    OwnerName := '';
    for ItemPos := AIndex - 1 downto 0 do
    begin
      Other := TMenuTplItem(ATemplate.Items[ItemPos]);
      if Other.Level < Item.Level then
      begin
        OwnerName := Other.ItemName;
        Break;
      end;
    end;
    if (OwnerName = '') or not DfmObjectRange(Result, OwnerName, First, Last) then
      Exit;                   // владельца в форме нет (снят) - и пункту некуда
  end;

  NewName := MenuNewItemName(Item.Caption, DsgMenuNameFree, AUsed);
  Code := 0;
  if Item.ShortCutText <> '' then
    Code := TextToShortCut(Item.ShortCutText);
  ObjText := MenuItemDfm(NewName, Item.Caption, Code);
  if Before <> '' then
    Result := MenuDfmInsertBefore(Result, Before, ObjText)
  else
    Result := DfmInsertObject(Result, OwnerName, ObjText);
  if Result = ADfm then
    Exit;
  Item.ItemName := NewName;
  Item.OrigCaption := Item.Caption;
  Item.OrigShortCut := Item.ShortCutText;
  if APas <> '' then
    APas := PasAddField(APas, AFormClass, NewName, 'TMenuItem');
end;

// Правки меню формы из мастера: снятые пункты - из формы (с подменю, их
// поля - из .pas), у остальных - новая подпись и клавиша. Остальные
// свойства пунктов (OnClick, Checked, Hint...) и их имена не трогаются.
// Одним шагом отката конструктора.
function TForm1.DsgMenuWizardApply(ATemplate: TMenuTemplate): Boolean;
var
  OldDfm, NewDfm, PasFile, OldPas, NewPas, FormClass: string;
  Names, Props, Used: TStringList;
  Index, First, Last, Code: Integer;
  Item: TMenuTplItem;
begin
  Result := False;
  if (FDesigner = nil) or (ATemplate = nil) or (ATemplate.MenuName = '') then
    Exit;
  OldDfm := DsgGetText;
  PasFile := UnitFileFor(FDsgDfm);
  OldPas := '';
  if PasFile <> '' then
    OldPas := DsgFileText(PasFile);
  FormClass := DfmRootClass(OldDfm);
  NewDfm := OldDfm;
  NewPas := OldPas;

  Names := TStringList.Create;
  Props := TStringList.Create;
  Used := TStringList.Create;
  // Имена новых пунктов проверяются по тексту формы до правок
  FMenuWizDfm := OldDfm;
  FMenuWizPas := OldPas;
  try
    for Index := 0 to ATemplate.Items.Count - 1 do
    begin
      Item := TMenuTplItem(ATemplate.Items[Index]);
      // Новый пункт (добавлен в мастере) - в .dfm на своё место
      if Item.ItemName = '' then
      begin
        if Item.Checked then
          NewDfm := DsgMenuInsertNew(ATemplate, Index, NewDfm, NewPas,
                                     FormClass, Used);
        Continue;
      end;
      if not DfmObjectRange(NewDfm, Item.ItemName, First, Last) then
        Continue;             // уже ушёл вместе со снятым владельцем
      if not Item.Checked then
      begin
        if not DfmObjectNames(NewDfm, Item.ItemName, Names) then
          Continue;
        NewDfm := DfmDeleteObject(NewDfm, Item.ItemName);
        NewDfm := DfmRemoveRefs(NewDfm, Names);
        if NewPas <> '' then
          NewPas := PasRemoveFields(NewPas, FormClass, Names);
        Continue;
      end;
      Props.Clear;
      if Item.Caption <> Item.OrigCaption then
        Props.Add('Caption=' + MenuDfmQuote(Item.Caption));
      if Item.ShortCutText <> Item.OrigShortCut then
      begin
        // Не разобралась - без клавиши, как пустое поле
        Code := 0;
        if Item.ShortCutText <> '' then
          Code := TextToShortCut(Item.ShortCutText);
        Props.Add('ShortCut=' + IntToStr(Code));
      end;
      if Props.Count > 0 then
        NewDfm := DfmSetProps(NewDfm, Item.ItemName, Props);
    end;
  finally
    Used.Free;
    Props.Free;
    Names.Free;
  end;

  if NewDfm = OldDfm then
  begin
    ShowMessage('Изменений в меню ' + ATemplate.MenuName + ' нет.');
    Exit;
  end;
  if NewPas = OldPas then
    NewPas := '';
  DsgApply(OldDfm, NewDfm, PasFile, OldPas, NewPas, '');
  FMenuWizLast := ATemplate.MenuName;
  FMenuWizDfm := DsgGetText;
  if PasFile <> '' then
    FMenuWizPas := DsgFileText(PasFile);
  Result := True;
end;

// Набор из мастера - компонентом меню в форму, пункты - полями в .pas,
// Menus - в uses. Одним шагом отката конструктора.
function TForm1.DsgMenuWizardAdd(const AChoice: TMenuWizardChoice): Boolean;
var
  ItemNames, AllNames, OldNames: TStringList;
  OldDfm, NewDfm, PasFile, OldPas, NewPas, ObjText, FormClass: string;
  BaseDfm, BasePas: string;
  Props: TStringList;
  Index: Integer;
begin
  Result := False;
  if (FDesigner = nil) or (FDesigner.Form = nil) then
    Exit;
  OldDfm := DsgGetText;
  PasFile := UnitFileFor(FDsgDfm);
  OldPas := '';
  if PasFile <> '' then
    OldPas := DsgFileText(PasFile);
  FMenuWizDfm := OldDfm;
  FMenuWizPas := OldPas;

  ItemNames := TStringList.Create;
  AllNames := TStringList.Create;
  OldNames := TStringList.Create;
  try
    // Главное меню у формы одно: прежние TMainMenu - из формы вместе с
    // пунктами, полями и ссылкой Menu. Тем же шагом отката, что и вставка.
    BaseDfm := OldDfm;
    BasePas := OldPas;
    FormClass := DfmRootClass(OldDfm);
    if not AChoice.IsPopup and
       DfmObjectNames(OldDfm, FDesigner.RootName, AllNames) then
      for Index := 0 to AllNames.Count - 1 do
        if MenuIsMainClass(DfmObjectClass(OldDfm, AllNames[Index])) then
        begin
          if not DfmObjectNames(BaseDfm, AllNames[Index], OldNames) then
            Continue;
          BaseDfm := DfmDeleteObject(BaseDfm, AllNames[Index]);
          BaseDfm := DfmRemoveRefs(BaseDfm, OldNames);
          if BasePas <> '' then
            BasePas := PasRemoveFields(BasePas, FormClass, OldNames);
        end;
    // Имена убранного снова свободны
    FMenuWizDfm := BaseDfm;
    FMenuWizPas := BasePas;

    ObjText := MenuBuildDfm(AChoice, 24, 24, DsgMenuNameFree, ItemNames);
    NewDfm := DfmInsertObject(BaseDfm, FDesigner.RootName, ObjText);
    if NewDfm = BaseDfm then
      Exit;
    if AChoice.AssignToForm then
    begin
      Props := TStringList.Create;
      try
        Props.Add('Menu=' + AChoice.Name);
        NewDfm := DfmSetProps(NewDfm, FDesigner.RootName, Props);
      finally
        Props.Free;
      end;
    end;

    NewPas := '';
    if BasePas <> '' then
    begin
      if AChoice.IsPopup and AChoice.Themed then
        NewPas := PasAddField(BasePas, FormClass, AChoice.Name, 'TUiPopupMenu')
      else if AChoice.IsPopup then
        NewPas := PasAddField(BasePas, FormClass, AChoice.Name, 'TPopupMenu')
      else if AChoice.Themed then
        NewPas := PasAddField(BasePas, FormClass, AChoice.Name, 'TUiMainMenu')
      else
        NewPas := PasAddField(BasePas, FormClass, AChoice.Name, 'TMainMenu');
      for Index := 0 to ItemNames.Count - 1 do
        NewPas := PasAddField(NewPas, FormClass, ItemNames[Index],
        'TMenuItem');
                              NewPas := PasAddUses(NewPas, 'Menus');
      // Свои компоненты - их модуль
                              if AChoice.Themed then
                              NewPas := PasAddUses(NewPas, 'UiMenus');
    end;

    // Без выделения: пока мастер открыт, переход к коду по выделению
    // переключал бы вкладки под окном мастера
    DsgApply(OldDfm, NewDfm, PasFile, OldPas, NewPas, '');
    FMenuWizLast := AChoice.Name;
    // Новые имена заняты - следующая вставка их обойдёт
    FMenuWizDfm := DsgGetText;
    if PasFile <> '' then
      FMenuWizPas := DsgFileText(PasFile);
    Result := True;
  finally
    OldNames.Free;
    AllNames.Free;
    ItemNames.Free;
  end;
end;

// Есть ли главное меню в форме (по тексту, который видит мастер)
function TForm1.DsgMenuHasMain: Boolean;
var
  AllNames: TStringList;
