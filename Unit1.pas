// Выделенное меню формы - шаблоном в папку MenuTemplates. Мастер покажет
// его в списке наборов; с названием встроенного - вместо встроенного.
procedure TForm1.DsgMenuSaveTemplate;
var
  MenuName, Title, ObjText, FileName: string;
  Comp: TComponent;
begin
  if (FDesigner = nil) or (FDesigner.Form = nil) then
    Exit;
  MenuName := FDesigner.SelectedName;
  Comp := FDesigner.Form.FindComponent(MenuName);
  if not (Comp is TMenu) then
    Exit;
  ObjText := DfmObjectText(DsgGetText, MenuName);
  if ObjText = '' then
    Exit;
  Title := MenuName;
  if not InputQuery('Шаблон меню', 'Название шаблона:', Title) then
    Exit;
  Title := Trim(Title);
  if Title = '' then
    Exit;
  FileName := MenuSaveTemplate(Title,
                               MenuTemplateFromDfm(ObjText, Title, Comp is TPopupMenu));
  ShowMessage('Шаблон меню сохранён:'#13#10 + FileName);
end;

procedure TForm1.DsgMenuDeleteTemplates;
