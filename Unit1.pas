begin
  Result := '';
  if (FDesigner = nil) or (FObjCurNode = nil) then
    Exit;
  Node := TDfmNode(FObjCurNode);
  if (CompareText(Node.ClassNm, 'TMenuItem') <> 0) or (Node.Name = '') then
