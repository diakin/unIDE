// ---------------------------------------------------------------------------
//  Прокрутка своими силами
//
//  RichEdit растянут на ширину рабочего стола и обрезается формой - так у
//  него не меняется ширина при протяжке рамки, из-за которой и было мерцание.
//  Плата: обе его полосы прокрутки уехали за правый край и пользователю
//  недоступны, а сам контрол никогда не прокручивается вбок - ему кажется,
//  что всё уже помещается.
//
//  Поэтому: своя вертикальная полоса поверх правого края, своя горизонтальная
//  в отдельной полоске внизу, и свой сдвиг FScrollX, который учитывает вся
//  отрисовка. Видимая ширина считается от формы, а не от контрола.
// ---------------------------------------------------------------------------

// Ширина области, в которой реально виден текст.
//
// Считается в экранных координатах: от левого края клиентской области
// RichEdit1 (после его рамки) до правого края контейнера или левого края
// вертикальной полосы - что левее. Прежний FEditHost.ClientWidth не
// учитывал рамку контрола; по логу видимая ширина выходила больше
// настоящей, и последние символы длинной строки оставались за краем:
// EnsureCaretVisibleX считал, что каретка ещё видна.
function TForm1.ViewWidth: Integer;
var
  P0, P1, P2: TPoint;
begin
  if (FEditHost <> nil) and FEditHost.HandleAllocated and
     RichEdit1.HandleAllocated then
  begin
    P0 := Point(0, 0);
    Windows.ClientToScreen(RichEdit1.Handle, P0);
    P1 := Point(FEditHost.ClientWidth, 0);
    Windows.ClientToScreen(FEditHost.Handle, P1);
    if (FVScroll <> nil) and FVScroll.Visible and FVScroll.HandleAllocated then
    begin
      P2 := Point(0, 0);
      Windows.ClientToScreen(FVScroll.Handle, P2);
      if P2.X < P1.X then
        P1.X := P2.X;
    end;
    Result := P1.X - P0.X;
  end
  else if FEditHost <> nil then
    Result := FEditHost.ClientWidth
  else
    Result := ClientWidth - RichEdit1.Left;

  if Result < 50 then
    Result := 50;
end;

procedure TForm1.BuildScrollBars;
begin
  // Номера строк - из DFM на форме, переносим на левую панель
  if Panel1 <> nil then
  begin
    Panel1.Parent := FLeftHost;
    Panel1.Align := alLeft;
  end;
  // Полоса меток закрашивает себя целиком: фон панели под ней не стираем,
  // иначе метки мигают при прокрутке
  if MarksBox <> nil then
    MarksBox.ControlStyle := MarksBox.ControlStyle + [csOpaque];

  RichEdit1.Parent := FEditHost;
  RichEdit1.Left := 0;
  RichEdit1.Top := 0;
  RichEdit1.Align := alLeft;
  RichEdit1.Width := EditorFixedWidth;

  FHBar.Top := FLeftHost.ClientHeight; // alBottom - ниже всех на панели
  FHBar.Height := GetSystemMetrics(SM_CYHSCROLL);

  FHScroll.OnChange := HScrollChange;

  FVScroll.Width := GetSystemMetrics(SM_CXVSCROLL);
  FVScroll.OnChange := VScrollChange;

  // Сплиттер лога и рамка окна меняют высоту панели редактора - пересчёт
  // полосы и области текста RichEdit, см. EditHostResize
  FEditHost.OnResize := EditHostResize;

  LayoutScrollBars;
end;

procedure TForm1.LayoutScrollBars;
begin
  if (FVScroll = nil) or (FHScroll = nil) then
    Exit;

  // Вертикальную раскладывает VCL по alRight - её трогать не надо.
  // Горизонтальную подгоняем под контейнер, чтобы она не заезжала под
  // панель номеров строк слева и под вертикальную полосу справа.
  if FEditHost <> nil then
    FHScroll.SetBounds(FEditHost.Left, 0, FEditHost.Width, FHBar.ClientHeight)
  else
    FHScroll.SetBounds(RichEdit1.Left, 0, ViewWidth, FHBar.ClientHeight);
end;

// Панель, на которой лежит полоса вкладок: сюда приходит WM_DRAWITEM от
// полосы, и здесь рисуются подписи вкладок
procedure TForm1.TabsHostWndProc(var Message: TMessage);
var
  DI: PDrawItemStruct;
begin
  if Message.Msg = WM_DRAWITEM then
  begin
    DI := PDrawItemStruct(Message.LParam);
    if (DI <> nil) and (FTabs <> nil) and FTabs.HandleAllocated and
       (DI^.hwndItem = FTabs.Handle) then
    begin
      TabsDrawTab(DI^.hDC, DI^.rcItem, DI^.itemID,
                  (DI^.itemState and ODS_SELECTED) <> 0);
      Message.Result := 1;
      Exit;
    end;
  end;
  FTabsHostProc(Message);
end;

// Полоса вкладок: после смены размера и удаления вкладки - подтянуть
// вкладки к правому краю, см. FitTabsToWidth
procedure TForm1.TabsWndProc(var Message: TMessage);
const
  TCM_SETITEMA_ = $1300 + 6;
  TCM_INSERTITEMA_ = $1300 + 7;
  TCM_DELETEITEM_ = $1300 + 8;
  TCM_DELETEALLITEMS_ = $1300 + 9;
var
  DI: PDrawItemStruct;
begin
  // Подписи вкладок рисуем сами. Ловим здесь, а не в OnDrawTab: событие в
  // этой связке Delphi 7 / Windows 7 не поднимается, а CN_DRAWITEM контрол
  // получает всегда - VCL пересылает ему WM_DRAWITEM родителя.
  if Message.Msg = CN_DRAWITEM then
  begin
    DI := PDrawItemStruct(Message.LParam);
    if DI <> nil then
    begin
      TabsDrawTab(DI^.hDC, DI^.rcItem, DI^.itemID,
                  (DI^.itemState and ODS_SELECTED) <> 0);
      Message.Result := 1;
      Exit;
    end;
  end;

  FTabsOldProc(Message);
  if (Message.Msg = WM_SIZE) or (Message.Msg = TCM_DELETEITEM_) then
    FitTabsToWidth;
  // Число рядов меняют ширина полосы, вкладки и их подписи, шрифт
  if (Message.Msg = WM_SIZE) or (Message.Msg = TCM_DELETEITEM_) or
     (Message.Msg = TCM_INSERTITEMA_) or (Message.Msg = TCM_SETITEMA_) or
     (Message.Msg = TCM_DELETEALLITEMS_) or (Message.Msg = WM_SETFONT) then
    UpdateTabsHeight;
end;

// Стиль вкладок - tsButtons (Unit1.dfm): у обычных вкладок в несколько
// рядов Windows при выборе вкладки из другого ряда переставляет ряды (ряд
// выбранной - к редактору). Расчёт - что у кнопок ряды остаются на
// месте; в документации Windows ни то, ни другое не описано, проверяется
// на Windows 7 (2026-10-10).
//
// Вкладки в несколько рядов (MultiLine): высота полосы - высота с одним
// рядом (из .dfm) плюс то, на сколько нижний край последнего ряда ниже
// нижнего края первого. Ряды по высоте перекрываются на пару точек,
// поэтому берутся края ярлычков (TabRect), а не число рядов на высоту
// ярлычка. Редактор и панель объявления (Align) сдвигаются сами.
procedure TForm1.UpdateTabsHeight;
var
  TabIdx, TopBottom, LowBottom, NewHeight: Integer;
  TabBox: TRect;
begin
  if (FTabs = nil) or not FTabs.HandleAllocated or FInTabsHeight or
     (FTabsBaseHeight <= 0) then
    Exit;
  TopBottom := MaxInt;
  LowBottom := 0;
  for TabIdx := 0 to FTabs.Tabs.Count - 1 do
  begin
    TabBox := FTabs.TabRect(TabIdx);
    if TabBox.Bottom <= TabBox.Top then
      Continue;
    if TabBox.Bottom < TopBottom then
      TopBottom := TabBox.Bottom;
    if TabBox.Bottom > LowBottom then
      LowBottom := TabBox.Bottom;
  end;
  if TopBottom = MaxInt then
    NewHeight := FTabsBaseHeight
  else
    NewHeight := FTabsBaseHeight + (LowBottom - TopBottom);
  if NewHeight = FTabs.Height then
    Exit;
  FInTabsHeight := True;
  try
    FTabs.Height := NewHeight;
  finally
    FInTabsHeight := False;
  end;
end;

// Вкладки не помещаются, полоса прокручена, а справа от последней вкладки
// есть место (окно растянули, вкладку закрыли), - прокрутить полосу влево
// ровно настолько, чтобы последняя вкладка осталась видна целиком.
//
// Сама полоса этого не делает: первая видимая вкладка у неё не меняется,
// и справа остаётся пустое место.
//
// Первая видимая вкладка - первая, у которой левый край (TCM_GETITEMRECT)
// не отрицательный: вкладки левее видимой области полоса отдаёт со сдвигом.
// Прокрутка - WM_HSCROLL с SB_THUMBPOSITION, как по стрелкам полосы; место
// стрелок (up-down) из ширины вычитается.
procedure TForm1.FitTabsToWidth;
const
  TCM_GETITEMRECT_ = $1300 + 10;
  UDM_SETPOS_ = WM_USER + 103;
var
  N, First, I: Integer;
  R: TRect;
  UpDown: HWND;

  function LastFits: Boolean;
  var
    Limit: Integer;
    UR: TRect;
  begin
    SendMessage(FTabs.Handle, TCM_GETITEMRECT_, N - 1, Integer(@R));
    Limit := FTabs.ClientWidth;
    UpDown := FindWindowEx(FTabs.Handle, 0, 'msctls_updown32', nil);
    if (UpDown <> 0) and IsWindowVisible(UpDown) then
    begin
      GetWindowRect(UpDown, UR);
      Dec(Limit, UR.Right - UR.Left);
    end;
    Result := R.Right <= Limit;
  end;

begin
  if (FTabs = nil) or not FTabs.HandleAllocated or FInFitTabs then
    Exit;
  N := FTabs.Tabs.Count;
  if N < 2 then
    Exit;

  FInFitTabs := True;
  try
    First := 0;
    for I := 0 to N - 1 do
    begin
      SendMessage(FTabs.Handle, TCM_GETITEMRECT_, I, Integer(@R));
      if R.Left >= 0 then
      begin
        First := I;
        Break;
      end;
    end;
    if First = 0 then
      Exit;

    while (First > 0) and LastFits do
    begin
      SendMessage(FTabs.Handle, WM_HSCROLL,
                  MakeLong(SB_THUMBPOSITION, First - 1), 0);
      if not LastFits then
      begin
        // Шаг лишний - последняя вкладка ушла за край; вернуть
        SendMessage(FTabs.Handle, WM_HSCROLL,
                    MakeLong(SB_THUMBPOSITION, First), 0);
        Break;
      end;
      Dec(First);
    end;
    SendMessage(FTabs.Handle, WM_HSCROLL, MakeLong(SB_ENDSCROLL, 0), 0);

    // Стрелки полосы - на ту же позицию, иначе их следующий шаг был бы
    // от прежней
    UpDown := FindWindowEx(FTabs.Handle, 0, 'msctls_updown32', nil);
    if UpDown <> 0 then
      SendMessage(UpDown, UDM_SETPOS_, 0, MakeLong(First, 0));
  finally
    FInFitTabs := False;
  end;
end;

// Правая панель у края окна: [левая панель] | [правая панель].
//
// Разделитель - полоска внутри самой правой панели, у её левого края.
// Обычный TSplitter здесь не годится: он и панель - два соседа с
// Align = alRight, а их порядок VCL берёт из их же координат, и панель
// оказывалась за краем окна. Полоска внутри панели от порядка не зависит:
// ширину панели она меняет сама, по движению мыши.
procedure TForm1.BuildRightPanel;
begin
  if FRightPanelWidth < RightPanelMinWidth then
    FRightPanelWidth := RightPanelDefWidth;

  FRightPanel.Width := FRightPanelWidth;

  // Свернуть / развернуть панель: кнопки справа в строке вкладок, поверх
  // FRightPages
  FRightBtnMin := TUiButton.Create(Self);
  FRightBtnMin.Parent := FRightPanel;
  FRightBtnMin.Caption := '_';
  FRightBtnMin.Hint := 'Свернуть правую панель';
  FRightBtnMin.ShowHint := True;
  FRightBtnMin.OnClick := RightPanelBtnClick;
  FRightBtnRestore := TUiButton.Create(Self);
  FRightBtnRestore.Parent := FRightPanel;
  FRightBtnRestore.Caption := '[]';
  FRightBtnRestore.Hint := 'Развернуть правую панель до прежней ширины';
  FRightBtnRestore.ShowHint := True;
  FRightBtnRestore.OnClick := RightPanelBtnClick;
  FRightBtnRestore.Enabled := False;
  RightPanelPlaceButtons;

  // Инспектор объектов разбирает .dfm только когда его вкладку открыли
  FRightPages.OnChange := RightPagesChange;
  // Двойной щелчок в Includes - открыть файл
  if FIncTree <> nil then
    FIncTree.OnDblClick := IncludesDblClick;

  BuildObjectInspector;
end;

// Палитре нужна другая высота (ряды вкладок, ряды кнопок): тулбар на ту же
// разницу, но не ниже исходного (FToolbarBaseHeight) - столько нужно левой
// части (кнопки и рамка Project). Прежде добавлялась вся высота лишних
// рядов вкладок, хотя исходный тулбар их уже вмещал, - снизу палитры
// оставалось пустое место.
procedure TForm1.PaletteTabRows(Sender: TObject);
var
  NewHeight: Integer;
begin
  if (FToolbarBaseHeight <= 0) or (FDsgPalette = nil) or
     (FDsgPalette.NeededHeight <= 0) then
    Exit;
  NewHeight := FToolbar.Height + FDsgPalette.NeededHeight - FDsgPalette.Height;
  if NewHeight < FToolbarBaseHeight then
    NewHeight := FToolbarBaseHeight;
  if NewHeight <> FToolbar.Height then
    FToolbar.Height := NewHeight;
end;

// Кнопки _ и [] - в правом верхнем углу панели, в строке вкладок; у
// свёрнутой - одна [] сразу за разделителем
procedure TForm1.RightPanelPlaceButtons;
const
  BtnW = 22;
  BtnH = 18;
var
  RightEdge: Integer;
begin
  if (FRightBtnMin = nil) or (FRightBtnRestore = nil) then
    Exit;
  RightEdge := FRightPanel.ClientWidth - 2;
  if FRightCollapsed then
  begin
    FRightBtnMin.Visible := False;
    FRightBtnRestore.SetBounds(FSplitBar.Width + 1, 2,
                               FRightPanel.ClientWidth - FSplitBar.Width - 2,
                               BtnH);
    FRightBtnRestore.Enabled := True;
  end
  else
  begin
    FRightBtnRestore.SetBounds(RightEdge - BtnW, 2, BtnW, BtnH);
    FRightBtnMin.SetBounds(RightEdge - 2 * BtnW - 2, 2, BtnW, BtnH);
    FRightBtnMin.Visible := True;
    // Развёрнута - разворачивать нечего
    FRightBtnRestore.Enabled := False;
  end;
  FRightBtnRestore.Anchors := [akTop, akRight];
  FRightBtnMin.Anchors := [akTop, akRight];
  FRightBtnRestore.Visible := True;
  FRightBtnMin.BringToFront;
  FRightBtnRestore.BringToFront;
end;

procedure TForm1.RightPanelBtnClick(Sender: TObject);
begin
  RightPanelCollapse(Sender = FRightBtnMin);
end;

// Свернуть правую панель до полоски с кнопкой [] или вернуть прежнюю
// ширину (FRightPanelWidth - её не трогает сворачивание)
procedure TForm1.RightPanelCollapse(ACollapse: Boolean);
var
  KeepWidth: Integer;
begin
  if (FRightPanel = nil) or (ACollapse = FRightCollapsed) then
    Exit;
  KeepWidth := FRightPanelWidth;
  if ACollapse then
  begin
    if FRightPanel.Width >= RightPanelMinWidth then
      KeepWidth := FRightPanel.Width;
    FRightCollapsed := True;
    FRightPages.Visible := False;
    ApplyRightPanelWidth(RightPanelCollapsedWidth);
  end
  else
  begin
    FRightCollapsed := False;
    if KeepWidth < RightPanelMinWidth then
      KeepWidth := RightPanelDefWidth;
    if KeepWidth > ClientWidth - RightPanelMinLeft then
      KeepWidth := ClientWidth - RightPanelMinLeft;
    if KeepWidth < RightPanelMinWidth then
      KeepWidth := RightPanelMinWidth;
    FRightPages.Visible := True;
    ApplyRightPanelWidth(KeepWidth);
  end;
  FRightPanelWidth := KeepWidth;
  RightPanelPlaceButtons;
end;

// Перетаскивание разделителя правой панели.
//
// Пока кнопка мыши нажата, ширина панели не меняется: на форме рисуется
// только линия-след (узор PATINVERT, как у TSplitter с ResizeStyle =
// rsPattern). Ширина ставится один раз при отпускании (ApplyRightPanelWidth).
// Живое изменение ширины на каждом движении мыши заставляло заново
// раскладывать всё содержимое панели (вкладки, дерево, список свойств) и
// редактор; Windows при сдвиге окна переносит его старое изображение, и
// дочерние окна с двойной буферизацией не успевали перерисоваться - на
// экране оставались полосы и куски прежней картинки.
procedure TForm1.SplitBarMouseDown(Sender: TObject; Button: TMouseButton;
                                   Shift: TShiftState; X, Y: Integer);
var
  P: TPoint;
begin
  if Button <> mbLeft then
    Exit;
  // У свёрнутой панели тянуть нечего - разворачиваем
  if FRightCollapsed then
  begin
    RightPanelCollapse(False);
    Exit;
  end;
  GetCursorPos(P);
  FSplitDrag := True;
  FSplitStartX := P.X;
  FSplitStartW := FRightPanel.Width;
  FSplitNewW := FSplitStartW;
  FSplitLineX := FRightPanel.Left;
  // DC формы без DCX_CLIPCHILDREN: линия видна и поверх дочерних окон
  FSplitLineDC := GetDCEx(Handle, 0, DCX_CACHE or DCX_CLIPSIBLINGS or
                          DCX_LOCKWINDOWUPDATE);
  if FSplitLineDC <> 0 then
  begin
    if FSplitLineBrush = nil then
    begin
      FSplitLineBrush := TBrush.Create;
      // Узор - общий объект Graphics, освобождать его не нужно
      FSplitLineBrush.Bitmap := AllocPatternBitmap(clBlack, clWhite);
    end;
    FSplitLineOld := SelectObject(FSplitLineDC, FSplitLineBrush.Handle);
    SplitLineDraw;
  end;
  // Мышь ловим сами: свойство MouseCapture у TControl защищённое
  SetCapture(FSplitBar.Handle);
end;

// Линия-след на месте будущего левого края панели. PATINVERT: второй
// вызов на том же месте стирает линию.
procedure TForm1.SplitLineDraw;
begin
  if FSplitLineDC = 0 then
    Exit;
  PatBlt(FSplitLineDC, FSplitLineX, FRightPanel.Top, FSplitBar.Width,
         FRightPanel.Height, PATINVERT);
end;

// Конец перетаскивания: линию стереть, DC отдать, захват мыши снять.
// AApply - поставить новую ширину.
procedure TForm1.SplitDragEnd(AApply: Boolean);
begin
  if not FSplitDrag then
    Exit;
  FSplitDrag := False;
  if FSplitLineDC <> 0 then
  begin
    SplitLineDraw;
    SelectObject(FSplitLineDC, FSplitLineOld);
    ReleaseDC(Handle, FSplitLineDC);
    FSplitLineDC := 0;
  end;
  if GetCapture = FSplitBar.Handle then
    ReleaseCapture;
  if AApply and (FSplitNewW <> FRightPanel.Width) then
    ApplyRightPanelWidth(FSplitNewW);
end;

// Новая ширина правой панели. Перерисовка на время раскладки выключена,
// потом форма перерисовывается целиком, со всеми дочерними окнами: иначе
// части, которые Windows перенесла при сдвиге панели, оставались на экране
// в прежнем виде.
procedure TForm1.ApplyRightPanelWidth(ANewWidth: Integer);
begin
  SendMessage(Handle, WM_SETREDRAW, 0, 0);
  try
    FRightPanel.Width := ANewWidth;
    FRightPanelWidth := ANewWidth;
    // Видимая область редактора стала другой - полосы прокрутки заново
    FormResizeEvent(Self);
  finally
    SendMessage(Handle, WM_SETREDRAW, 1, 0);
    RedrawWindow(Handle, nil, 0, RDW_ERASE or RDW_FRAME or RDW_INVALIDATE or
                 RDW_ALLCHILDREN or RDW_UPDATENOW);
  end;
end;

// Панель тянется влево - шире, вправо - уже. Уже RightPanelMinWidth и шире,
// чем окно минус RightPanelMinLeft, не даём.
procedure TForm1.SplitBarMouseMove(Sender: TObject; Shift: TShiftState;
                                   X, Y: Integer);
var
  P: TPoint;
  NewW, MaxW: Integer;
begin
  if not FSplitDrag then
    Exit;
  // Кнопку отпустили, а MouseUp не пришёл (захват мыши забрало другое окно)
  if not (ssLeft in Shift) then
  begin
    SplitDragEnd(True);
    Exit;
  end;
  GetCursorPos(P);
  NewW := FSplitStartW + (FSplitStartX - P.X);
  MaxW := ClientWidth - RightPanelMinLeft;
  if MaxW < RightPanelMinWidth then
    MaxW := RightPanelMinWidth;
  if NewW > MaxW then
    NewW := MaxW;
  if NewW < RightPanelMinWidth then
    NewW := RightPanelMinWidth;
  if NewW = FSplitNewW then
    Exit;

  SplitLineDraw;     // стереть прежнюю
  FSplitNewW := NewW;
  // Правый край панели на месте, левый - на ширину левее
  FSplitLineX := FRightPanel.Left + FRightPanel.Width - NewW;
  SplitLineDraw;
end;

procedure TForm1.SplitBarMouseUp(Sender: TObject; Button: TMouseButton;
                                 Shift: TShiftState; X, Y: Integer);
begin
  SplitDragEnd(True);
end;

// Список подпрограмм файла для правой панели.
//
// Идёт по строкам уже прочитанного текста (перевод строки - один символ,
// как в индексах контрола). Строка считается объявлением, если её первое
// слово есть в FSubWords, а само слово не попало в строковый литерал или
// комментарий - это видно по общим картам.
//
// Конец подпрограммы: строка, начинающаяся с одного из FSubEndWords
// ("end sub"), а если таких слов у языка нет - строка перед началом
// следующей подпрограммы.
// Позиция в тексте, начиная с которой ищутся подпрограммы: первый символ
// строки, ПОСЛЕ которой стоит слово из раздела SubScope. В Паскале это
// implementation, и всё, что выше, - объявления без тел.
//
// Слово ищется первым словом строки, вне строковых литералов и комментариев.
// Нет такой строки (или раздела SubScope в схеме нет) - вернётся 1, то есть
// ищем весь файл: у .dpr секции implementation не бывает, и ограничение
// оставило бы список пустым.
function TForm1.SubScopeStart(const AText: string): Integer;
var
  I, Len, P, WordEnd: Integer;
begin
  Result := 1;
  if FScheme.FSubScope = '' then
    Exit;

  Len := Length(AText);
  P := 1;
  I := 1;
  while I <= Len + 1 do
  begin
    if (I > Len) or (AText[I] = #13) or (AText[I] = #10) then
    begin
      // Первое слово строки [P .. I-1], без ведущих пробелов
      while (P < I) and ((AText[P] = ' ') or (AText[P] = #9)) do
        Inc(P);
      WordEnd := P;
      while (WordEnd < I) and
            (AText[WordEnd] in ['a'..'z', 'A'..'Z', '0'..'9', '_']) do
        Inc(WordEnd);

      if (WordEnd > P) and
         (CompareText(Copy(AText, P, WordEnd - P), FScheme.FSubScope) = 0) and
         not InRanges(StringRanges, P - 1) and
         not InRanges(CommentRanges, P - 1) then
      begin
        Result := I; // сама строка со словом в область поиска не входит
        Exit;
      end;

      if (I < Len) and (AText[I] = #13) and (AText[I + 1] = #10) then
        Inc(I);
      P := I + 1;
    end;
    Inc(I);
  end;
end;

// Последний элемент строки: слово целиком, а если строка кончается не
// буквой - этот последний символ. Нужно для языков, где блок открывает и
// закрывает одиночный знак: '{' в конце строки - такое же слово блока, как
// 'then' в Паскале.
function TForm1.LastToken(const S: string): string;
var
  E, J: Integer;
begin
  Result := '';
  E := Length(S);
  while (E >= 1) and (S[E] = ' ') do
    Dec(E);
  if E < 1 then
    Exit;

  if not (S[E] in ['a'..'z', 'A'..'Z', '0'..'9', '_']) then
  begin
    Result := S[E];
    Exit;
  end;

  J := E;
  while (J >= 1) and (S[J] in ['a'..'z', 'A'..'Z', '0'..'9', '_']) do
    Dec(J);
  Result := Copy(S, J + 1, E - J);
end;

// Перенос, с которым открыт блок глубины ADepth (TBlockState.HangBase);
// 0 - блока нет или он открыт без переноса
function BlockHangBase(const B: TBlockState; ADepth: Integer): Integer;
begin
  if (ADepth >= 0) and (ADepth < Length(B.HangBase)) then
    Result := B.HangBase[ADepth]
  else
    Result := 0;
end;

// Разметка строки [ALineStart .. ALineEnd] - см. TLineScan. Состояние B
// нужно только для одного: внутри объявительного блока (class, record в
// разделе type) слово procedure - это объявление метода, а не заголовок.
procedure TForm1.ScanLine(const AText: string; ALineStart, ALineEnd: Integer;
                          const B: TBlockState; var L: TLineScan);
var
  K, WordEnd, MarkLen: Integer;
begin
  L.FirstPos := ALineStart;
  while (L.FirstPos <= ALineEnd) and
        ((AText[L.FirstPos] = ' ') or (AText[L.FirstPos] = #9)) do
    Inc(L.FirstPos);
  L.LastPos := ALineEnd;
  while (L.LastPos >= L.FirstPos) and
        ((AText[L.LastPos] = ' ') or (AText[L.LastPos] = #9)) do
    Dec(L.LastPos);

  L.FirstWordPos := L.FirstPos;
  L.Indent := L.FirstPos - ALineStart;
  L.Empty := L.FirstPos > L.LastPos;
  L.CmtPos := L.LastPos + 1;
  L.Code := '';
  L.First := '';
  L.Last := '';
  L.IsHeader := False;
  L.IsOutdent := False;
  L.IsSect := False;
  L.CaseElse := False;
  L.IsOpen := False;
  L.IsHang := False;
  L.Inside := False;

  if L.Empty then
    Exit;

  L.Inside := InRanges(CommentRanges, L.FirstPos - 1) or
              InRanges(StringRanges, L.FirstPos - 1);
  if L.Inside then
    Exit; // строка внутри блочного комментария или литерала - разбирать нечего

  // Начало строчного комментария: маркер вне литералов и блочных комментариев
  MarkLen := Length(FScheme.FLineCommentMarker);
  if MarkLen > 0 then
  begin
    K := L.FirstPos;
    while K <= L.LastPos - MarkLen + 1 do
    begin
      if (AText[K] = FScheme.FLineCommentMarker[1]) and
         (Copy(AText, K, MarkLen) = FScheme.FLineCommentMarker) and
         not InRanges(StringRanges, K - 1) and
         not InRanges(CommentRanges, K - 1) then
      begin
        L.CmtPos := K;
        Break;
      end;
      Inc(K);
    end;
  end;

  // Кодовая часть: до комментария, без хвостовых пробелов
  K := L.CmtPos - 1;
  while (K >= L.FirstPos) and InRanges(CommentRanges, K - 1) do
    Dec(K);
  while (K >= L.FirstPos) and ((AText[K] = ' ') or (AText[K] = #9)) do
    Dec(K);
  if K >= L.FirstPos then
    L.Code := Copy(AText, L.FirstPos, K - L.FirstPos + 1);

  // Первое слово строки. Строка, начатая знаком - '}' в C, - даёт этот знак:
  // для счётчика блоков он такое же слово, как end в Паскале.
  WordEnd := L.FirstPos;
  while (WordEnd <= L.LastPos) and (AText[WordEnd] in ['a'..'z', 'A'..'Z', '0'..'9', '_']) do
    Inc(WordEnd);
  if WordEnd > L.FirstPos then
    L.First := Copy(AText, L.FirstPos, WordEnd - L.FirstPos)
  else
    L.First := Copy(AText, L.FirstPos, 1);

  // Модификаторы начала строки пропускаем: в 'Public Sub Foo' значащее
  // слово - Sub. Пропуск идёт по цепочке, 'Public Shared Sub' тоже
  // разберётся. Declare в списке нет, поэтому 'Declare Sub' остаётся
  // объявлением и блока не открывает.
  while (FScheme.FSubSkip <> nil) and (FScheme.FSubSkip.IndexOf(L.First) >= 0) do
  begin
    K := WordEnd;
    while (K <= L.LastPos) and ((AText[K] = ' ') or (AText[K] = #9)) do
      Inc(K);
    if (K > L.LastPos) or not (AText[K] in ['a'..'z', 'A'..'Z', '_']) then
      Break;

    L.FirstWordPos := K;
    WordEnd := K;
    while (WordEnd <= L.LastPos) and (AText[WordEnd] in ['a'..'z', 'A'..'Z', '0'..'9', '_']) do
      Inc(WordEnd);
    L.First := Copy(AText, L.FirstWordPos, WordEnd - L.FirstWordPos);
  end;

  // Последний элемент кодовой части
  L.Last := LastToken(L.Code);

  if L.First = '' then
    Exit;

  // Внутри объявительного блока procedure - объявление метода, не заголовок.
  // Выше слова SubScope - тоже объявление: тел там не бывает.
  L.IsHeader := (FScheme.FSubWords.IndexOf(L.First) >= 0) and
                not B.BeforeScope and
                not ((B.Depth > 0) and (B.Depth <= Length(B.DeclBlock)) and
                     B.DeclBlock[B.Depth - 1]);
  L.IsOutdent := FScheme.FFmtOutdent.IndexOf(L.First) >= 0;
  // В режиме тегов строку, начатую закрывающим тегом, пишем на уровень
  // левее - её </div> встаёт вровень со своим <div>
  if FScheme.FSubTags and (Copy(AText, L.FirstPos, 2) = '</') then
    L.IsOutdent := True;
  // Внутри незакрытой скобки var и const - модификаторы параметров в
  // перенесённом списке, а не начало раздела:
  //   function StrStartAt(const AText: string; APos: Integer;
  //                       var AKind: Integer): Boolean;
  L.IsSect := (FScheme.FFmtSection.IndexOf(L.First) >= 0) and (B.Paren <= 0);
  L.IsOpen := FScheme.FSubOpenWords.IndexOf(L.First) >= 0;
  L.IsHang := FScheme.FFmtHang.IndexOf(L.First) >= 0;

  // else внутри открытого case - и предыдущая ветка закончена (переноса
  // от незавершённого if ... then нет): это else самого case. Он стоит
  // вровень с case, как end, а не переносит один оператор, как у if.
  //   case Key of
  //     '0'..'9': ;
  //   else
  //     Key := #0;
  //     Beep;
  //   end;
  // У Free Pascal вместо else бывает otherwise - то же самое
  L.CaseElse := ((L.IsHang and (CompareText(L.First, 'else') = 0)) or
                 (CompareText(L.First, 'otherwise') = 0)) and
                (B.Hang = BlockHangBase(B, B.Depth)) and (B.Depth > 0) and
                (B.Depth <= Length(B.CaseBlock)) and B.CaseBlock[B.Depth - 1];
  if L.CaseElse then
  begin
    L.IsHang := False;
    L.IsOutdent := True;
  end;
end;

// Открывает ли слово W блок, стоя ПЕРВЫМ словом строки. Разбирает записи
// раздела SubOpenFirst, три формы:
//   while     - открывает всегда, лишь бы стояло в начале строки;
//   if=then   - открывает, только если строка КОНЧАЕТСЯ словом then;
//   type!as   - открывает, только если слова as в строке НЕТ.
// Вторая форма нужна однострочному 'if x then y = 1', третья -
// однострочному синониму типа 'type Foo as any' в FreeBASIC: и то и
// другое блока не открывает.
function TForm1.OpensAtLineStart(const W: string; const L: TLineScan): Boolean;
var
  I, P, K, WordEnd: Integer;
  Item, Tail, Wd: string;
  Negate: Boolean;
begin
  Result := False;
  if (FScheme.FSubOpenFirst = nil) or (FScheme.FSubOpenFirst.Count = 0) or (W = '') then
    Exit;

  for I := 0 to FScheme.FSubOpenFirst.Count - 1 do
  begin
    Item := FScheme.FSubOpenFirst[I];
    Negate := False;
    P := Pos('=', Item);
    if P = 0 then
    begin
      P := Pos('!', Item);
      Negate := P > 0;
    end;

    if P > 0 then
    begin
      Tail := Trim(Copy(Item, P + 1, Length(Item)));
      Item := Trim(Copy(Item, 1, P - 1));
    end
    else
      Tail := '';

    if CompareText(Item, W) <> 0 then
      Continue;

    if Tail = '' then
      Result := True
    else if not Negate then
      // Условие на последнее слово строки
      Result := CompareText(L.Last, Tail) = 0
    else
    begin
      // Условие "такого слова в строке нет" - ищем целым словом по
      // кодовой части, комментарий в счёт не идёт
      Result := True;
      K := 1;
      while K <= Length(L.Code) do
      begin
        if L.Code[K] in ['a'..'z', 'A'..'Z', '_'] then
        begin
          WordEnd := K;
          while (WordEnd <= Length(L.Code)) and
                (L.Code[WordEnd] in ['a'..'z', 'A'..'Z', '0'..'9', '_']) do
            Inc(WordEnd);
          Wd := Copy(L.Code, K, WordEnd - K);
          if CompareText(Wd, Tail) = 0 then
          begin
            Result := False;
            Break;
          end;
          K := WordEnd;
        end
        else
          Inc(K);
      end;
    end;
    Exit;
  end;
end;

procedure TForm1.BlockInit(var B: TBlockState);

// Односимвольные образцы списка - в набор символов
  procedure AddChars(AList: TStringList);
  var
    I: Integer;
  begin
    if AList = nil then
      Exit;
    for I := 0 to AList.Count - 1 do
      if Length(AList[I]) = 1 then
        Include(B.Chars, AList[I][1]);
  end;

begin
  B.Depth := 0;
  B.Hang := 0;
  B.Paren := 0;
  B.InSection := False;
  B.BeforeScope := False;   // включают те, кто разбирает текст с начала
  B.Top := -1;
  B.ClosedCount := 0;
  B.TagTop := -1;
  B.Opaque := '';
  SetLength(B.TagStack, 0);
  B.Chars := [];
  AddChars(FScheme.FSubOpenWords);
  AddChars(FScheme.FSubEndWords);
  AddChars(FScheme.FSubNoBodyWords);
  AddChars(FScheme.FFmtClass);
  SetLength(B.HangBase, 0);
  SetLength(B.StartDepth, 0);
  SetLength(B.Tags, 0);
  SetLength(B.Opened, 0);
  SetLength(B.DeclBlock, 0);
  SetLength(B.CaseBlock, 0);
  SetLength(B.Closed, 0);
  SetLength(B.ClosedAtBegin, 0);
end;

// Что делается ДО расчёта отступа строки: закрывается раздел объявлений,
// поправляется Hang, сбрасывается счёт скобок. Вызывается на каждой кодовой
// строке; на строке продолжения все ветки всё равно ничего не меняют - её
// первое слово не бывает ни словом блока, ни словом переноса.
procedure TForm1.BlockBeforeLine(const L: TLineScan; var B: TBlockState);
begin
  if L.Code = '' then
    Exit;

  // Раздел var или type кончается на заголовке, на begin и на словах уровня
  // модуля (implementation). Внутри класса private раздел не закрывает:
  // глубина там не нулевая.
  if L.IsSect or L.IsHeader or L.IsOpen or
     ((B.Top < 0) and (B.Depth = 0) and
      (FScheme.FFmtStmtEnd.IndexOf(L.First) >= 0)) then
    B.InSection := False;

  // Оператор без begin: begin под then и слово else возвращаются на уровень
  // своего if. Строка, начатая end (until, finally), встаёт вровень со
  // своим begin: перенос - тот, с которым блок открыт.
  if L.IsHeader or L.IsSect then
    B.Hang := 0
  else if L.IsOutdent then
    B.Hang := BlockHangBase(B, B.Depth)
  else if L.IsOpen or L.IsHang then
    if B.Hang > 0 then
      Dec(B.Hang);

  // Строка явно начинает оператор - счёт незакрытых скобок сбрасываем: так
  // ошибка счёта не утащит за собой весь остаток файла
  if L.IsHeader or L.IsOutdent or L.IsSect or L.IsOpen or L.IsHang or
     (FScheme.FFmtStmtEnd.IndexOf(L.First) >= 0) then
    B.Paren := 0;
end;

// Заголовок подпрограммы на стек. ATag - номер записи у вызывающего, -1
// если он ему не нужен.
procedure TForm1.BlockPushHeader(ATag: Integer; var B: TBlockState);
begin
  Inc(B.Top);
  SetLength(B.StartDepth, B.Top + 1);
  SetLength(B.Tags, B.Top + 1);
  SetLength(B.Opened, B.Top + 1);
  B.StartDepth[B.Top] := B.Depth;
  B.Tags[B.Top] := ATag;
  B.Opened[B.Top] := False;
end;

// Уровень строки, начатой закрывающим тегом. Его нельзя считать как
// "текущий минус один": </td> сматывает стек через все незакрытые внутри
// <li> и <span> сразу, и вставать должен вровень со своим <td>. Это и
// есть номер парного тега в стеке. False - пары нет, закрытие лишнее, и
// строка остаётся на текущем уровне.
function TForm1.TagCloseLevel(const AText: string; const L: TLineScan;
                              const B: TBlockState; var ALevel: Integer): Boolean;
var
  E, NameEnd, I: Integer;
  Nm: string;
begin
  Result := False;
  ALevel := 0;
  if not FScheme.FSubTags or L.Empty or L.Inside then
    Exit;
  if Copy(AText, L.FirstPos, 2) <> '</' then
    Exit;

  E := L.FirstPos + 2;
  NameEnd := E;
  while (NameEnd <= L.LastPos) and (AText[NameEnd] in ['a'..'z', 'A'..'Z', '0'..'9', '_', '-', ':']) do
    Inc(NameEnd);
  Nm := LowerCase(Copy(AText, E, NameEnd - E));
  if Nm = '' then
    Exit;

  for I := B.TagTop downto 0 do
    if B.TagStack[I] = Nm then
    begin
      ALevel := I;
      Result := True;
      Exit;
    end;
end;

// ПАРА ПОД КАРЕТКОЙ: скобка со своей парной либо тег со своим закрывающим.
//
// Считается на каждое движение каретки и запоминается двумя отрезками. Если
// они не изменились, перерисовка не заказывается - иначе каждое нажатие
// стрелки гоняло бы отрисовку впустую.
//
// Скобки ищутся счётчиком вложенности, теги - тем же счётчиком по именам.
// И там и там пропускается всё, что лежит внутри строковых литералов и
// комментариев: <div> в комментарии парой не считается.
procedure TForm1.UpdatePairMatch;
const
  OpenCh = '([{';
  CloseCh = ')]}';
var
  Txt: string;
  Len, Caret, P, K, Depth, A1, A2, B1, B2: Integer;
  Ch, Mate: Char;
  Forward_: Boolean;
  TagName, Nm: string;
  Closing, IsClose: Boolean;
  TagStart, TagEnd, NameEnd, J: Integer;
  OldA1, OldB1: Integer;
  OldBrackets, NewBrackets: string;  // скобки строки - для сравнения
  Level, BrIdx: Integer;
  LineIdx, LineBeg, Col: Integer;
  LineTxt: string;
  Quick: Boolean;

  // Позиция вне литералов и комментариев (индексы в Txt от единицы,
  // в картах - от нуля)
  function Live(APos: Integer): Boolean;
  begin
    Result := not InRanges(StringRanges, APos - 1) and
              not InRanges(CommentRanges, APos - 1);
  end;

begin
  OldA1 := FPairA1;
  OldB1 := FPairB1;
  OldBrackets := '';
  for BrIdx := 0 to High(FLineBrackets) do
    OldBrackets := OldBrackets + IntToStr(FLineBrackets[BrIdx].X) + ',';
  SetLength(FLineBrackets, 0);
  FPairA1 := -1;
  FPairA2 := -1;
  FPairB1 := -1;
  FPairB2 := -1;

  if not FUseSyntaxHighlight or FMapStale then
  begin
    // Карта устарела - искать не по чему; на следующем перестроении найдём
    if (OldA1 >= 0) or (OldB1 >= 0) or (OldBrackets <> '') then
      RichEdit1.Invalidate;
    Exit;
  end;

  // СНАЧАЛА ДЕШЁВАЯ ПРОВЕРКА по одной строке. Весь текст копировать на
  // каждое движение каретки нельзя - он бывает в сотни килобайт, а пара
  // ищется только когда каретка стоит на скобке или внутри тега.
  LineIdx := SendMessageA(RichEdit1.Handle, EM_LINEFROMCHAR,
                          RichEdit1.SelStart, 0);
  LineBeg := SendMessageA(RichEdit1.Handle, EM_LINEINDEX, LineIdx, 0);
  if (LineIdx < 0) or (LineBeg < 0) then
  begin
    if (OldA1 >= 0) or (OldB1 >= 0) or (OldBrackets <> '') then
      RichEdit1.Invalidate;
    Exit;
  end;

  LineTxt := RichEdit1.Lines[LineIdx];
  Col := RichEdit1.SelStart - LineBeg + 1;

  Quick := False;
  if (Col >= 1) and (Col <= Length(LineTxt)) and
     (Pos(LineTxt[Col], OpenCh + CloseCh) > 0) then
    Quick := True
  else if (Col - 1 >= 1) and (Col - 1 <= Length(LineTxt)) and
          (Pos(LineTxt[Col - 1], OpenCh + CloseCh) > 0) then
    Quick := True
  else if FScheme.FSubTags then
  begin
    // Внутри тега: слева от каретки есть '<', и '>' между ними нет
    K := Col;
    if K > Length(LineTxt) then
      K := Length(LineTxt);
    while K >= 1 do
    begin
      if LineTxt[K] = '>' then
        Break;
      if LineTxt[K] = '<' then
      begin
        Quick := True;
        Break;
      end;
      Dec(K);
    end;
  end;

  if not Quick then
  begin
    if (OldA1 >= 0) or (OldB1 >= 0) or (OldBrackets <> '') then
      RichEdit1.Invalidate;
    Exit;
  end;

  Txt := GetEditorTextCR;
  Len := Length(Txt);
  Caret := RichEdit1.SelStart + 1; // в тексте позиции от единицы
  if (Len = 0) or (Caret < 1) or (Caret > Len + 1) then
  begin
    if (OldA1 >= 0) or (OldB1 >= 0) or (OldBrackets <> '') then
      RichEdit1.Invalidate;
    Exit;
  end;

  // СКОБКИ. Смотрим символ под кареткой, потом слева от неё - так пара
  // находится и когда каретка стоит сразу за скобкой.
  P := 0;
  if (Caret <= Len) and Live(Caret) and
     ((Pos(Txt[Caret], OpenCh) > 0) or (Pos(Txt[Caret], CloseCh) > 0)) then
    P := Caret
  else if (Caret - 1 >= 1) and Live(Caret - 1) and
          ((Pos(Txt[Caret - 1], OpenCh) > 0) or
           (Pos(Txt[Caret - 1], CloseCh) > 0)) then
    P := Caret - 1;

  if P > 0 then
  begin
    // Все скобки строки каретки - по уровню вложенности в этой строке:
    // открывающая - на текущем уровне, закрывающая - на уровень выше
    // своего содержимого; пара получает один уровень, а значит один цвет
    Level := 0;
    for J := 1 to Length(LineTxt) do
    begin
      K := LineBeg + J;   // позиция в Txt (от единицы)
      if (K > Len) or not Live(K) then
        Continue;
      if Pos(Txt[K], OpenCh) > 0 then
      begin
        SetLength(FLineBrackets, Length(FLineBrackets) + 1);
        FLineBrackets[High(FLineBrackets)] := Point(K - 1, Level);
        Inc(Level);
      end
      else if Pos(Txt[K], CloseCh) > 0 then
      begin
        if Level > 0 then
          Dec(Level);
        SetLength(FLineBrackets, Length(FLineBrackets) + 1);
        FLineBrackets[High(FLineBrackets)] := Point(K - 1, Level);
      end;
    end;

    Ch := Txt[P];
    K := Pos(Ch, OpenCh);
    Forward_ := K > 0;
    if Forward_ then
      Mate := CloseCh[K]
    else
      Mate := OpenCh[Pos(Ch, CloseCh)];

    Depth := 0;
    K := P;
    while (K >= 1) and (K <= Len) do
    begin
      if Live(K) then
      begin
        if Txt[K] = Ch then
          Inc(Depth)
        else if Txt[K] = Mate then
        begin
          Dec(Depth);
          if Depth = 0 then
          begin
            FPairA1 := P - 1;
            FPairA2 := P - 1;
            FPairB1 := K - 1;
            FPairB2 := K - 1;
            Break;
          end;
        end;
      end;
      if Forward_ then
        Inc(K)
      else
        Dec(K);
    end;
  end
  // ТЕГИ. Каретка внутри <...>: ищем начало тега слева от неё.
  else if FScheme.FSubTags then
  begin
    TagStart := 0;
    K := Caret;
    if K > Len then
      K := Len;
    while (K >= 1) and (Caret - K < 1024) do
    begin
      if Live(K) then
        if Txt[K] = '>' then
          Break // сначала встретилось закрытие - каретка вне тега
        else if Txt[K] = '<' then
        begin
          TagStart := K;
          Break;
        end;
      Dec(K);
    end;

    if TagStart > 0 then
    begin
      // Конец тега и его имя
      TagEnd := TagStart;
      while (TagEnd <= Len) and not ((Txt[TagEnd] = '>') and Live(TagEnd)) do
        Inc(TagEnd);
      if TagEnd > Len then
        TagEnd := Len;

      Closing := (TagStart < Len) and (Txt[TagStart + 1] = '/');
      J := TagStart + 1;
      if Closing then
        Inc(J);
      NameEnd := J;
      while (NameEnd <= Len) and (Txt[NameEnd] in ['a'..'z', 'A'..'Z', '0'..'9', '_', '-', ':']) do
        Inc(NameEnd);
      TagName := LowerCase(Copy(Txt, J, NameEnd - J));

      // Самозакрытый и пустой тег пары не имеют
      if (TagName <> '') and (FScheme.FTagVoid.IndexOf(TagName) < 0) and
         not ((TagEnd > TagStart) and (Txt[TagEnd - 1] = '/')) then
      begin
        A1 := TagStart - 1;
        A2 := TagEnd - 1;
        Depth := 0;
        B1 := -1;
        B2 := -1;

        if Closing then
          K := TagStart - 1
        else
          K := TagEnd + 1;

        // Идём по тексту, считая одноимённые теги
        while (K >= 1) and (K <= Len) do
        begin
          if (Txt[K] = '<') and Live(K) then
          begin
            IsClose := (K < Len) and (Txt[K + 1] = '/');
            J := K + 1;
            if IsClose then
              Inc(J);
            NameEnd := J;
            while (NameEnd <= Len) and (Txt[NameEnd] in ['a'..'z', 'A'..'Z', '0'..'9', '_', '-', ':']) do
              Inc(NameEnd);
            Nm := LowerCase(Copy(Txt, J, NameEnd - J));

            if Nm = TagName then
            begin
              if IsClose = Closing then
                Inc(Depth)
              else if Depth > 0 then
                Dec(Depth)
              else
              begin
                // Нашли пару - её границы
                B1 := K - 1;
                J := K;
                while (J <= Len) and not ((Txt[J] = '>') and Live(J)) do
                  Inc(J);
                if J > Len then
                  J := Len;
                B2 := J - 1;
                Break;
              end;
            end;
          end;

          if Closing then
            Dec(K)
          else
            Inc(K);
        end;

        if B1 >= 0 then
        begin
          FPairA1 := A1;
          FPairA2 := A2;
          FPairB1 := B1;
          FPairB2 := B2;
        end;
      end;
    end;
  end;

  // Перерисовываем, только если пара или скобки строки изменились
  NewBrackets := '';
  for BrIdx := 0 to High(FLineBrackets) do
    NewBrackets := NewBrackets + IntToStr(FLineBrackets[BrIdx].X) + ',';
  if (FPairA1 <> OldA1) or (FPairB1 <> OldB1) or (NewBrackets <> OldBrackets) then
    RichEdit1.Invalidate;
end;

// РАЗБОР ПО ТЕГАМ (SubStyle tags). Уровень дают парные <name> и </name>.
//
// Закрывающий тег сматывает стек до парного имени: незакрытые <p> и <li>
// снимаются вместе с объемлющим </td>, а закрытие без пары - например,
// парное тегу, который остался внутри незакрытого комментария, - просто
// пропускается, и остаток документа не съезжает.
//
// Уровня не дают: теги из списка TagVoid (br, img, meta), самозакрытые
// <div/>, объявления <!doctype> и комментарии <!-- -->. Содержимое script
// и style - один непрозрачный кусок: внутри JavaScript свои правила, и
// знак < там встречается как сравнение.
procedure TForm1.ScanTags(const AText: string; const L: TLineScan;
                          var B: TBlockState);
var
  K, E, NameEnd, J, Found: Integer;
  Nm: string;
  Closing, SelfClose: Boolean;

  procedure PushTag(const AName: string);
  begin
    Inc(B.TagTop);
    if B.TagTop >= Length(B.TagStack) then
      SetLength(B.TagStack, B.TagTop + 16);
    B.TagStack[B.TagTop] := AName;
    Inc(B.Depth);
  end;

// Смотать стек до парного имени. Пары нет - не трогаем ничего.
  procedure UnwindTo(const AName: string);
  var
    I: Integer;
  begin
    I := B.TagTop;
    while (I >= 0) and (B.TagStack[I] <> AName) do
      Dec(I);
    if I < 0 then
      Exit;

    while B.TagTop >= I do
    begin
      Dec(B.TagTop);
      if B.Depth > 0 then
        Dec(B.Depth);
    end;
  end;

begin
  K := L.FirstPos;
  while K <= L.LastPos do
  begin
    // Внутри script или style ищем только его закрывающий тег
    if B.Opaque <> '' then
    begin
      if (AText[K] = '<') and
         (CompareText(Copy(AText, K, Length(B.Opaque) + 2),
      '</' + B.Opaque) = 0) then
      begin
        UnwindTo(B.Opaque);
        Inc(K, Length(B.Opaque) + 2);
        B.Opaque := '';
      end
      else
        Inc(K);
      Continue;
    end;

    if (AText[K] <> '<') or InRanges(StringRanges, K - 1) or
       InRanges(CommentRanges, K - 1) then
    begin
      Inc(K);
      Continue;
    end;

    // <!doctype, <![CDATA - объявления, уровня не дают
    if (K < L.LastPos) and (AText[K + 1] = '!') then
    begin
      Inc(K);
      Continue;
    end;

    Closing := (K < L.LastPos) and (AText[K + 1] = '/');
    E := K + 1;
    if Closing then
      Inc(E);

    NameEnd := E;
    while (NameEnd <= L.LastPos) and (AText[NameEnd] in ['a'..'z', 'A'..'Z', '0'..'9', '_', '-', ':']) do
      Inc(NameEnd);
    Nm := LowerCase(Copy(AText, E, NameEnd - E));
    if Nm = '' then
    begin
      Inc(K);
      Continue;
    end;

    // Ищем конец тега. '>' внутри кавычек атрибута не считается: он попал
    // в карту строковых литералов.
    SelfClose := False;
    J := NameEnd;
    while J <= L.LastPos do
    begin
      if not InRanges(StringRanges, J - 1) then
      begin
        if AText[J] = '>' then
          Break;
        if (AText[J] = '/') and (J < L.LastPos) and (AText[J + 1] = '>') then
          SelfClose := True;
      end;
      Inc(J);
    end;

    if Closing then
      UnwindTo(Nm)
    else if not SelfClose and (FScheme.FTagVoid.IndexOf(Nm) < 0) then
    begin
      PushTag(Nm);
      // Содержимое скрипта и стилей разбирать нечем - пропускаем целиком
      if (Nm = 'script') or (Nm = 'style') then
        B.Opaque := Nm;
    end;

    K := J + 1;
  end;

  // Закрывшихся подпрограмм в этом режиме не бывает
  Found := 0;
  B.ClosedCount := Found;
end;

// Слова и скобки кодовой части строки - один проход на все три разбора.
// Здесь и только здесь живут правила блоков: SubOpen поднимает глубину,
// SubEnd опускает, FmtClass открывает блок при наличии '=' на строке и
// отсутствии точки с запятой в конце, SubNoBody закрывает заголовок без
// тела, FmtHang в конце строки добавляет уровень следующему оператору.
// Закрывшиеся за строку подпрограммы остаются в B.Closed.
procedure TForm1.BlockAfterLine(const AText: string; const L: TLineScan;
                                var B: TBlockState);
var
  K, WordEnd, TokStart: Integer;
  W: string;
  EqSeen, Masked: Boolean;

  procedure AddClosed(ATag: Integer; AAtBegin: Boolean);
  begin
    if B.ClosedCount >= Length(B.Closed) then
    begin
      SetLength(B.Closed, B.ClosedCount + 8);
      SetLength(B.ClosedAtBegin, B.ClosedCount + 8);
    end;
    B.Closed[B.ClosedCount] := ATag;
    B.ClosedAtBegin[B.ClosedCount] := AAtBegin;
    Inc(B.ClosedCount);
  end;

begin
  B.ClosedCount := 0;
  if L.Empty or L.Inside then
    Exit;

  // Разбор по тегам идёт своим путём
  if FScheme.FSubTags then
  begin
    ScanTags(AText, L, B);
    Exit;
  end;

  EqSeen := False;
  K := L.FirstPos;
  while K < L.CmtPos do
  begin
    TokStart := K;
    Masked := InRanges(StringRanges, K - 1) or
              InRanges(CommentRanges, K - 1);

    // Слово целиком либо один знак: '{' и '}' в C-подобных языках - такие
    // же слова блока, как begin и end, только состоят из одного символа
    if AText[K] in ['a'..'z', 'A'..'Z', '_'] then
    begin
      WordEnd := K;
      while (WordEnd < L.CmtPos) and (AText[WordEnd] in ['a'..'z', 'A'..'Z', '0'..'9', '_']) do
        Inc(WordEnd);
      W := Copy(AText, K, WordEnd - K);
      K := WordEnd;
    end
    else
    begin
      W := AText[K];
      if not Masked then
      begin
        if W = '=' then
          EqSeen := True
        else if W = '(' then
          Inc(B.Paren)
        else if W = ')' then
          if B.Paren > 0 then
            Dec(B.Paren);
      end;
      Inc(K);
      // Знак, которого нет среди слов блоков, дальше не разбираем
      if not (W[1] in B.Chars) then
        Continue;
    end;

    if not Masked then
    begin
      if (FScheme.FSubOpenWords.IndexOf(W) >= 0) or
         ((TokStart = L.FirstWordPos) and OpensAtLineStart(W, L)) or
         ((FScheme.FFmtClass.IndexOf(W) >= 0) and EqSeen and (L.Code <> '') and
          (L.Code[Length(L.Code)] <> ';')) then
      begin
        Inc(B.Depth);
        // Перенос, с которым открыт блок: его тело и end - от него
        if Length(B.HangBase) <= B.Depth then
          SetLength(B.HangBase, B.Depth + 1);
        B.HangBase[B.Depth] := B.Hang;
        if Length(B.DeclBlock) < B.Depth then
          SetLength(B.DeclBlock, B.Depth);
        if Length(B.CaseBlock) < B.Depth then
          SetLength(B.CaseBlock, B.Depth);
        B.CaseBlock[B.Depth - 1] := CompareText(W, 'case') = 0;
        // Объявительный блок: class, object или record в разделе type
        B.DeclBlock[B.Depth - 1] := B.InSection or
                                    (FScheme.FFmtClass.IndexOf(W) >= 0);
        if (B.Top >= 0) and (B.Depth > B.StartDepth[B.Top]) then
          B.Opened[B.Top] := True;
      end
      // Тела не будет: forward, external. Запись кончается своей строкой,
      // иначе она осталась бы на стеке до конца файла и её "открыл" бы
      // первый же record или case ниже.
      else if (B.Top >= 0) and not B.Opened[B.Top] and
              (FScheme.FSubNoBodyWords.IndexOf(W) >= 0) then
      begin
        AddClosed(B.Tags[B.Top], True);
        Dec(B.Top);
      end
      else if FScheme.FSubEndWords.IndexOf(W) >= 0 then
      begin
        if B.Depth > 0 then
          Dec(B.Depth);
        // Закрылись все, чьё тело вернулось на свою глубину
        while (B.Top >= 0) and B.Opened[B.Top] and
              (B.Depth <= B.StartDepth[B.Top]) do
        begin
          AddClosed(B.Tags[B.Top], False);
          Dec(B.Top);
        end;
        // Закрылся блок, внутри которого стоял заголовок, а тело так и не
        // началось (объявление метода в type ... class)
        while (B.Top >= 0) and not B.Opened[B.Top] and
              (B.Depth < B.StartDepth[B.Top]) do
        begin
          AddClosed(B.Tags[B.Top], True);
          Dec(B.Top);
        end;
      end;
    end;
  end;

  // Чем кончилась кодовая часть: слово из FmtHang - следующий оператор идёт
  // правее; точка с запятой - оператор закончен
  if L.Code <> '' then
  begin
    // else самого case переноса не даёт: за ним список операторов
    if (L.Last <> '') and (FScheme.FFmtHang.IndexOf(L.Last) >= 0) and
       not L.CaseElse then
      Inc(B.Hang)
    else if L.Code[Length(L.Code)] = ';' then
      // Оператор закончен - перенос того блока, в котором он стоит
      B.Hang := BlockHangBase(B, B.Depth);

    if L.IsSect then
      B.InSection := True;
  end;

  // Дошли до implementation - ниже начинаются тела
  if B.BeforeScope and (FScheme.FSubScope <> '') and
     (CompareText(L.First, FScheme.FSubScope) = 0) then
    B.BeforeScope := False;
end;

// Уровень вложенности каждой строки - для направляющих полос.
//
// Разбор общий: ScanLine размечает строку, BlockAfterLine ведёт глубину.
// Разделы объявлений (var, type) уровень дают: под ними всё идёт правее,
// как под then без begin. Строка, начатая закрывающим
// словом, показывается на уровень левее - её end стоит вровень со своим
// begin. Результат - FLineDepth по номерам строк от нуля.
procedure TForm1.RebuildLineDepths(const AText: string);
var
  I, Len, LineStart, LineNo, Lv, Cap, K, J, V: Integer;
  B: TBlockState;
  L: TLineScan;
  Blank: array of Boolean;     // строка только из пробелов
  HasCode: array of Boolean;   // в строке есть код, не одни комментарии
  Outd: array of Boolean;      // строка начата закрывающим словом (end)
  SectIdx: TIntArray;          // полоса раздела объявлений на строке, -1 - нет
  NextNB: TIntArray;           // ближайшая непустая строка ниже, -1 - нет
  Prev, Unop: Integer;
begin
  SetLength(FLineDepth, 0);
  SetLength(FLineTick, 0);
  if not FScheme.FSubTags and
     ((FScheme.FSubOpenWords = nil) or (FScheme.FSubOpenWords.Count = 0)) and
     ((FScheme.FSubOpenFirst = nil) or (FScheme.FSubOpenFirst.Count = 0)) then
    Exit; // язык без слов блоков и без тегов - полосы по пробелам

  Len := Length(AText);
  if Len = 0 then
    Exit;

  // Строк не больше, чем переводов строки плюс один; растём порциями
  Cap := 1024;
  SetLength(FLineDepth, Cap);
  SetLength(Blank, Cap);
  SetLength(HasCode, Cap);
  SetLength(Outd, Cap);
  SetLength(SectIdx, Cap);

  BlockInit(B);
  // Разбор идёт с первой строки файла, значит секция объявлений впереди
  B.BeforeScope := (FScheme.FSubScope <> '') and (SubScopeStart(AText) > 1);
  LineNo := 0;
  LineStart := 1;

  I := 1;
  while I <= Len + 1 do
  begin
    if (I > Len) or (AText[I] = #13) or (AText[I] = #10) then
    begin
      ScanLine(AText, LineStart, I - 1, B, L);
      BlockBeforeLine(L, B);

      // Раздел объявлений даёт уровень, как оператор без begin под then:
      // сам var или type стоит на уровне окружения, а всё под ним -
      // на уровень правее. Само объявление записи тогда первый уровень,
      // её поля - второй. Правило то же, что в FormatIndentText.
      // Закрывающий тег - на уровень своего парного, см. TagCloseLevel
      if FScheme.FSubTags then
      begin
        if not TagCloseLevel(AText, L, B, Lv) then
          Lv := B.Depth;
      end
      else
      begin
        // Та же формула, что у FormatIndentText: полоса должна стоять там,
        // где форматирование ставит отступ. Объявленная, но ещё не
        // открытая подпрограмма уровень даёт - так вложенная function
        // оказывается на уровень правее внешней процедуры, а её тело ещё
        // на один. Своя объявительная часть уровня не добавляет: var и
        // begin стоят вровень с заголовком.
        Unop := 0;
        for K := 0 to B.Top do
          if (K <= High(B.Opened)) and not B.Opened[K] then
            Inc(Unop);
        Lv := B.Depth + Unop;
        if not L.IsHeader and (B.Top >= 0) and (B.Top <= High(B.Opened)) and
           not B.Opened[B.Top] then
          Dec(Lv);
        Inc(Lv, B.Hang);
        if B.InSection and not L.IsHeader then
          Inc(Lv);
        if L.IsOutdent then
          Dec(Lv);
      end;
      if Lv < 0 then
        Lv := 0;

      if LineNo >= Cap then
      begin
        Cap := Cap * 2;
        SetLength(FLineDepth, Cap);
        SetLength(Blank, Cap);
        SetLength(HasCode, Cap);
        SetLength(Outd, Cap);
        SetLength(SectIdx, Cap);
      end;

      // Полоса раздела - последний уровень строки: его и добавляет раздел.
      // Сама строка var / const / type в раздел не входит. Состояние берём
      // до BlockAfterLine, как и сам уровень.
      if not FScheme.FSubTags and B.InSection and not L.IsHeader and
         not L.IsSect then
        SectIdx[LineNo] := Lv - 1
      else
        SectIdx[LineNo] := -1;
      Outd[LineNo] := L.IsOutdent;
      // Строка с кодом, а не одни комментарии: засечка ставится по
      // последнему объявлению, а не по комментарию под ним - он обычно
      // относится к тому, что идёт ниже
      HasCode[LineNo] := Trim(L.Code) <> '';

      Blank[LineNo] := True;
      for K := LineStart to I - 1 do
        if not (AText[K] in [' ', #9]) then
        begin
          Blank[LineNo] := False;
          Break;
        end;

      if L.IsHeader then
        BlockPushHeader(-1, B);
      BlockAfterLine(AText, L, B);

      FLineDepth[LineNo] := Lv;

      if (I < Len) and (AText[I] = #13) and (AText[I + 1] = #10) then
        Inc(I);
      Inc(LineNo);
      LineStart := I + 1;
    end;
    Inc(I);
  end;

  SetLength(FLineDepth, LineNo);
  if LineNo = 0 then
    Exit;

  // --- пустые строки: уровень - по строке ниже
  //
  // Пустая строка относится к тому, что идёт под ней: после begin - к телу
  // блока (полоса тела начинается сразу под begin, без разрыва), после
  // конца раздела var - к следующей подпрограмме (полоса раздела не висит
  // в пустоте).
  //
  // Исключение - когда ниже закрывающее слово (end): блок ещё не кончился,
  // и пустая строка остаётся в нём - на уровень тела, то есть на один
  // правее самого end, но не глубже строки над ней. Так полоса тела
  // доходит до end без разрыва, а хвост под if ... then не тянется вниз.
  SetLength(NextNB, LineNo);
  J := -1;
  for K := LineNo - 1 downto 0 do
  begin
    NextNB[K] := J;
    if not Blank[K] then
      J := K;
  end;

  Prev := -1;
  for K := 0 to LineNo - 1 do
  begin
    if Blank[K] then
    begin
      J := NextNB[K];
      if J < 0 then
        V := 0                        // хвост файла
      else if Outd[J] then
      begin
        // Ниже end: строка ещё в блоке - на уровне его тела
        V := FLineDepth[J] + 1;
        if Prev < 0 then
          V := 0
        else if FLineDepth[Prev] < V then
          V := FLineDepth[Prev];
      end
      else
        V := FLineDepth[J];
      FLineDepth[K] := V;
    end
    else
      Prev := K;
  end;

  // --- засечки: последнее объявление раздела
  //
  // Полоса, на которой стоит раздел, часто идёт дальше: у раздела var
  // процедуры это полоса самой процедуры, она тянется через вложенные
  // подпрограммы до её end. Поэтому конец раздела ищется не по концу
  // полосы, а по самому разделу: строка с кодом - последняя, если
  // следующая строка с кодом уже не в этом разделе (заголовок вложенной
  // подпрограммы, begin, другой раздел). Комментарии и пустые строки между
  // ними не считаются. Вложенная запись или класс раздел не прерывают:
  // уровень внутри них выше, полоса раздела продолжается.
  SetLength(FLineTick, LineNo);
  for K := 0 to LineNo - 1 do
    FLineTick[K] := 0;
  for K := 0 to LineNo - 1 do
  begin
    if Blank[K] or not HasCode[K] or (SectIdx[K] < 0) then
      Continue;
    if FLineDepth[K] <= SectIdx[K] then
      Continue; // полосы раздела на самой строке нет

    J := K + 1;
    while (J < LineNo) and (Blank[J] or not HasCode[J]) do
      Inc(J);
    // Дальше закрывающее слово - это конец записи или класса внутри
    // раздела: у такого блока конец виден по его end, засечка не нужна
    if (J < LineNo) and Outd[J] then
      Continue;
    if (J >= LineNo) or (SectIdx[J] < 0) or (SectIdx[J] < SectIdx[K]) then
      FLineTick[K] := SectIdx[K] + 1;
  end;
end;

procedure TForm1.RebuildSubList(const AText: string);
var
  I, Len, LineStart, LineNo, P, WordEnd, Open, K, ScopeStart: Integer;
  Word, LineStr: string;

  function LineMatchesEnd(const S: string): Boolean;
  var
    J, L: Integer;
  begin
    Result := False;
    for J := 0 to FScheme.FSubEndWords.Count - 1 do
    begin
      L := Length(FScheme.FSubEndWords[J]);
      if (L > 0) and (Length(S) >= L) and
         (CompareText(Copy(S, 1, L), FScheme.FSubEndWords[J]) = 0) and
         ((Length(S) = L) or not (S[L + 1] in ['a'..'z', 'A'..'Z', '0'..'9', '_'])) then
      begin
        Result := True;
        Exit;
      end;
    end;
  end;

begin
  SetLength(FSubs, 0);

  // Языки с фигурными скобками разбираются иначе: там у объявления нет
  // ключевого слова, есть имя, круглые скобки и тело в { }
  if FScheme.FSubBraces then
  begin
    RebuildSubListBraces(AText);
    Exit;
  end;

  if (FScheme.FSubWords = nil) or (FScheme.FSubWords.Count = 0) then
  begin
    FillSubListView;
    Exit;
  end;

  // Есть слова открытия блока - конец подпрограммы считается по вложенности
  if ((FScheme.FSubOpenWords <> nil) and (FScheme.FSubOpenWords.Count > 0)) or
     ((FScheme.FSubOpenFirst <> nil) and (FScheme.FSubOpenFirst.Count > 0)) then
  begin
    RebuildSubListBlocks(AText);
    Exit;
  end;

  // Граница: ниже слова из SubScope. Слова в файле нет - ищем с начала
  ScopeStart := SubScopeStart(AText);

  Len := Length(AText);
  LineNo := 0;
  LineStart := 1;
  Open := -1; // индекс незакрытой подпрограммы

  I := 1;
  while I <= Len + 1 do
  begin
    if (I > Len) or (AText[I] = #13) or (AText[I] = #10) then
    begin
      // Строка [LineStart .. I-1]
      P := LineStart;
      while (P < I) and ((AText[P] = ' ') or (AText[P] = #9)) do
        Inc(P);

      if P < I then
      begin
        WordEnd := P;
        while (WordEnd < I) and
              (AText[WordEnd] in ['a'..'z', 'A'..'Z', '0'..'9', '_']) do
          Inc(WordEnd);
        Word := Copy(AText, P, WordEnd - P);
        LineStr := Trim(Copy(AText, P, I - P));
        if Length(LineStr) > 300 then
          SetLength(LineStr, 300);

        // Позиции в картах - от нуля, как индексы контрола
        if (Word <> '') and (P >= ScopeStart) and
           (FScheme.FSubWords.IndexOf(Word) >= 0) and
           not InRanges(StringRanges, P - 1) and
           not InRanges(CommentRanges, P - 1) then
        begin
          // Предыдущая кончается перед этой, если концов у языка нет
          if (Open >= 0) and (FScheme.FSubEndWords.Count = 0) then
            FSubs[Open].EndLine := LineNo - 1;
          SetLength(FSubs, Length(FSubs) + 1);
          Open := High(FSubs);
          FSubs[Open].Name := LineStr;
          FSubs[Open].BeginLine := LineNo;
          FSubs[Open].EndLine := LineNo;
        end
        else if (Open >= 0) and (FScheme.FSubEndWords.Count > 0) and
                LineMatchesEnd(LineStr) and
                not InRanges(StringRanges, P - 1) and
                not InRanges(CommentRanges, P - 1) then
        begin
          FSubs[Open].EndLine := LineNo;
          Open := -1;
        end;
      end;

      // Перевод строки: CR, LF или CRLF
      if (I < Len) and (AText[I] = #13) and (AText[I + 1] = #10) then
        Inc(I);
      Inc(LineNo);
      LineStart := I + 1;
    end;
    Inc(I);
  end;

  // Последняя незакрытая - до конца файла
  if Open >= 0 then
    FSubs[Open].EndLine := LineNo - 1;
  for K := 0 to High(FSubs) do
    if FSubs[K].EndLine < FSubs[K].BeginLine then
      FSubs[K].EndLine := FSubs[K].BeginLine;

  FillSubListView;
end;

// Список подпрограмм для языков, где тело обрамлено словами: begin ... end
// в Паскале. Заголовок ищется по первому слову строки, а КОНЕЦ берётся не
// "перед следующим заголовком" и не по первому слову end, а по вложенности
// блоков - её ведёт BlockAfterLine, общая с форматировщиком и с уровнями
// строк. Закрывшиеся за строку записи приходят в B.Closed.
//
// Чего эта схема не берёт: вариантную часть записи (case внутри record
// закрывается общим end) - там глубина уйдёт вверх и подпрограмма закроется
// позже, чем надо.
procedure TForm1.RebuildSubListBlocks(const AText: string);
var
  I, Len, LineStart, LineNo, K, ScopeStart, Idx: Integer;
  LineStr: string;
  B: TBlockState;
  L: TLineScan;
begin
  SetLength(FSubs, 0);
  ScopeStart := SubScopeStart(AText);

  Len := Length(AText);
  BlockInit(B);
  LineNo := 0;
  LineStart := 1;

  I := 1;
  while I <= Len + 1 do
  begin
    if (I > Len) or (AText[I] = #13) or (AText[I] = #10) then
    begin
      ScanLine(AText, LineStart, I - 1, B, L);
      BlockBeforeLine(L, B);

      // ЗАГОЛОВОК: выше границы SubScope подпрограмм не ищем - там лежат
      // объявления интерфейса, тел у них нет
      if L.IsHeader and (L.FirstPos >= ScopeStart) then
      begin
        LineStr := Trim(Copy(AText, L.FirstPos, I - L.FirstPos));
        if Length(LineStr) > 300 then
          SetLength(LineStr, 300);

        SetLength(FSubs, Length(FSubs) + 1);
        FSubs[High(FSubs)].Name := LineStr;
        FSubs[High(FSubs)].BeginLine := LineNo;
        FSubs[High(FSubs)].EndLine := LineNo;
        BlockPushHeader(High(FSubs), B);
      end;

      BlockAfterLine(AText, L, B);

      // Закрывшиеся: с телом - по этой строке, без тела (forward, external,
      // объявление метода) - длиной в свою строку
      for K := 0 to B.ClosedCount - 1 do
      begin
        Idx := B.Closed[K];
        if (Idx >= 0) and (Idx <= High(FSubs)) then
          if B.ClosedAtBegin[K] then
            FSubs[Idx].EndLine := FSubs[Idx].BeginLine
          else
            FSubs[Idx].EndLine := LineNo;
      end;

      // Перевод строки: CR, LF или CRLF
      if (I < Len) and (AText[I] = #13) and (AText[I + 1] = #10) then
        Inc(I);
      Inc(LineNo);
      LineStart := I + 1;
    end;
    Inc(I);
  end;

  // Осталось незакрытым: тело так и не началось - это объявление, длиной в
  // свою строку; тело началось, но не кончилось - файл оборван, до конца
  while B.Top >= 0 do
  begin
    Idx := B.Tags[B.Top];
    if (Idx >= 0) and (Idx <= High(FSubs)) then
      if B.Opened[B.Top] then
        FSubs[Idx].EndLine := LineNo - 1
      else
        FSubs[Idx].EndLine := FSubs[Idx].BeginLine;
    Dec(B.Top);
  end;

  for K := 0 to High(FSubs) do
    if FSubs[K].EndLine < FSubs[K].BeginLine then
      FSubs[K].EndLine := FSubs[K].BeginLine;

  FillSubListView;
end;

// Список подпрограмм для языков с фигурными скобками (C, C++, .ino).
//
// Ключевого слова у объявления там нет, поэтому ищем открывающую скобку
// тела на нулевом уровне вложенности: перед ней должны стоять круглые
// скобки, а перед ними - имя. Управляющие слова (if, for, while и прочие)
// отбрасываются: у них тоже есть скобки и тело.
//
// Конец - парная закрывающая скобка. Комментарии и строковые литералы
// пропускаются по общим картам, так что скобки внутри них не считаются.
procedure TForm1.RebuildSubListBraces(const AText: string);
var
  I, Len, LineNo, Depth, J, K, NameEnd, NameStart, ParDepth, BegLine: Integer;
  Open: Integer;
  Nm, LineStr: string;

  // Символ в комментарии или строке?
  function Skip(APos: Integer): Boolean;
  begin
    Result := InRanges(StringRanges, APos - 1) or
              InRanges(CommentRanges, APos - 1);
  end;

// Номер строки позиции APos (APos <= AFrom), если позиция AFrom лежит в
// строке AFromLine: считаем переводы строк между ними
  function LineOf(AFrom, AFromLine, APos: Integer): Integer;
  var
    M: Integer;
  begin
    Result := AFromLine;
    M := APos;
    while M < AFrom do
    begin
      if AText[M] = #13 then
        Dec(Result)
      else if (AText[M] = #10) and ((M = 1) or (AText[M - 1] <> #13)) then
        Dec(Result);
      Inc(M);
    end;
  end;

begin
  Len := Length(AText);
  LineNo := 0;
  Depth := 0;
  Open := -1;

  I := 1;
  while I <= Len do
  begin
    if AText[I] = #13 then
    begin
      if (I < Len) and (AText[I + 1] = #10) then
        Inc(I);
      Inc(LineNo);
    end
    else if AText[I] = #10 then
      Inc(LineNo)
    else if not Skip(I) then
    begin
      if AText[I] = '{' then
      begin
        if (Depth = 0) and (Open < 0) then
        begin
          // Назад до ')' через пробелы и переводы строк
          J := I - 1;
          while (J >= 1) and ((AText[J] = ' ') or (AText[J] = #9) or
                              (AText[J] = #13) or (AText[J] = #10)) do
            Dec(J);

          if (J >= 1) and (AText[J] = ')') and not Skip(J) then
          begin
            // Парная '(' - с учётом вложенных скобок
            ParDepth := 0;
            K := J;
            while K >= 1 do
            begin
              if not Skip(K) then
              begin
                if AText[K] = ')' then
                  Inc(ParDepth)
                else if AText[K] = '(' then
                begin
                  Dec(ParDepth);
                  if ParDepth = 0 then
                    Break;
                end;
              end;
              Dec(K);
            end;

            if (K >= 1) and (ParDepth = 0) then
            begin
              // Имя перед '('
              NameEnd := K - 1;
              while (NameEnd >= 1) and ((AText[NameEnd] = ' ') or
                                        (AText[NameEnd] = #9)) do
                Dec(NameEnd);
              NameStart := NameEnd;
              while (NameStart >= 1) and
                    (AText[NameStart] in ['a'..'z', 'A'..'Z', '0'..'9', '_']) do
                Dec(NameStart);
              Inc(NameStart);

              if NameEnd >= NameStart then
              begin
                Nm := Copy(AText, NameStart, NameEnd - NameStart + 1);
                if (CompareText(Nm, 'if') <> 0) and
                   (CompareText(Nm, 'for') <> 0) and
                   (CompareText(Nm, 'while') <> 0) and
                   (CompareText(Nm, 'switch') <> 0) and
                   (CompareText(Nm, 'do') <> 0) and
                   (CompareText(Nm, 'else') <> 0) and
                   (CompareText(Nm, 'catch') <> 0) then
                begin
                  // Строка объявления: от начала строки с именем до ')'
                  K := NameStart;
                  while (K > 1) and (AText[K - 1] <> #13) and
                        (AText[K - 1] <> #10) do
                    Dec(K);
                  LineStr := Trim(Copy(AText, K, J - K + 1));
                  if Length(LineStr) > 300 then
                    SetLength(LineStr, 300);

                  BegLine := LineOf(I, LineNo, NameStart);

                  SetLength(FSubs, Length(FSubs) + 1);
                  Open := High(FSubs);
                  FSubs[Open].Name := LineStr;
                  FSubs[Open].BeginLine := BegLine;
                  FSubs[Open].EndLine := BegLine;
                end;
              end;
            end;
          end;
        end;
        Inc(Depth);
      end
      else if AText[I] = '}' then
      begin
        if Depth > 0 then
          Dec(Depth);
        if (Depth = 0) and (Open >= 0) then
        begin
          FSubs[Open].EndLine := LineNo;
          Open := -1;
        end;
      end;
    end;
    Inc(I);
  end;

  if Open >= 0 then
    FSubs[Open].EndLine := LineNo;

  FillSubListView;
end;

// Список подпрограмм - в таблицу правой панели. Номера строк показываем
// с единицы, как в статус-баре.
// Подпись в SubList: слово FUNCTION в начале (в любом регистре) - Fn, чтобы
// имя помещалось. Сам FSubs[].Name не меняется.
function SubListCaption(const AName: string): string;
const
  FuncWord = 'function';
var
  Lead: Integer;
begin
  Result := AName;
  Lead := 1;
  while (Lead <= Length(AName)) and (AName[Lead] in [' ', #9]) do
    Inc(Lead);
  if (CompareText(Copy(AName, Lead, Length(FuncWord)), FuncWord) = 0) and
     ((Lead + Length(FuncWord) > Length(AName)) or
      (AName[Lead + Length(FuncWord)] in [' ', #9, '('])) then
    Result := 'Fn' + Copy(AName, Lead + Length(FuncWord), MaxInt);
end;

procedure TForm1.FillSubListView;
var
  K: Integer;
  It: TListItem;
begin
  if lvSubList = nil then
    Exit;
  // Переключение вкладки: сам список FSubs уже готов (он нужен отрисовке
  // текста), а таблицу заполнит вторая половина переключения, после показа
  if FTabSwitching then
  begin
    FSubListViewPending := True;
    Exit;
  end;
  FSubListViewPending := False;
  lvSubList.Items.BeginUpdate;
  try
    lvSubList.Items.Clear;
    for K := 0 to High(FSubs) do
    begin
      if (FSubFilterText <> '') and
         (Pos(FSubFilterText, LowerCase(FSubs[K].Name)) = 0) then
        Continue;
      It := lvSubList.Items.Add;
      It.Caption := SubListCaption(FSubs[K].Name);
      It.SubItems.Add(IntToStr(FSubs[K].BeginLine + 1));
      It.SubItems.Add(IntToStr(FSubs[K].EndLine + 1));
      It.Data := Pointer(K);
    end;
  finally
    lvSubList.Items.EndUpdate;
  end;
  // Полоса прокрутки могла появиться или уйти - ширина Name по новой
  SubListFitColumns;
end;

// SubList сменил размер - колонка Name по ширине, Begin и End у правого края
procedure TForm1.SubListResize(Sender: TObject);
begin
  SubListFitColumns;
end;

// Колонка Name занимает всё, что осталось от Begin и End: они остаются
// своей ширины (заданной в .dfm или перетащенной мышью) и стоят у правого
// края. Ширина клиентской области уже без вертикальной полосы, поэтому
// горизонтальная полоса не появляется. Name не уже 60 пикселей.
procedure TForm1.SubListFitColumns;
var
  NameWidth: Integer;
begin
  if (lvSubList = nil) or not lvSubList.HandleAllocated or
     (lvSubList.Columns.Count < 3) or FSubListFitting then
    Exit;
  NameWidth := lvSubList.ClientWidth - lvSubList.Columns[1].Width -
               lvSubList.Columns[2].Width;
  if NameWidth < 60 then
    NameWidth := 60;
  if lvSubList.Columns[0].Width = NameWidth then
    Exit;
  FSubListFitting := True;
  try
    lvSubList.Columns[0].Width := NameWidth;
  finally
    FSubListFitting := False;
  end;
  SubFilterPlace;
end;

// Поле фильтра - в шапке колонки Name, справа от её подписи
procedure TForm1.SubFilterPlace;
const
  LVM_GETHEADER = $1000 + 31;
var
  HeaderWnd: HWND;
  HeaderRect: TRect;
  HeaderH, TextW, FilterLeft, FilterW: Integer;
  Origin: TPoint;
  MeasureBmp: TBitmap;
begin
  if (FSubFilter = nil) or (lvSubList = nil) or not lvSubList.HandleAllocated or
     (lvSubList.Columns.Count < 1) or (FSubFilter.Parent = nil) then
    Exit;
  HeaderH := 24;
  HeaderWnd := SendMessage(lvSubList.Handle, LVM_GETHEADER, 0, 0);
  if (HeaderWnd <> 0) and GetWindowRect(HeaderWnd, HeaderRect) and
     (HeaderRect.Bottom - HeaderRect.Top > 8) then
    HeaderH := HeaderRect.Bottom - HeaderRect.Top;
  // Ширина подписи Name - шрифтом списка (им же рисуется шапка)
  MeasureBmp := TBitmap.Create;
  try
    MeasureBmp.Canvas.Font.Assign(lvSubList.Font);
    TextW := MeasureBmp.Canvas.TextWidth(lvSubList.Columns[0].Caption);
  finally
    MeasureBmp.Free;
  end;
  FilterLeft := TextW + 16;
  FilterW := lvSubList.Columns[0].Width - FilterLeft - 6;
  Origin := FSubFilter.Parent.ScreenToClient(lvSubList.ClientOrigin);
  if FilterW < 30 then
  begin
    FSubFilter.Visible := False;
    Exit;
  end;
  FSubFilter.SetBounds(Origin.X + FilterLeft, Origin.Y + 2, FilterW,
                       HeaderH - 4);
  FSubFilter.Visible := lvSubList.Visible;
  FSubFilter.BringToFront;
end;

procedure TForm1.SubFilterChange(Sender: TObject);
begin
  FSubFilterText := LowerCase(Trim(FSubFilter.Text));
  FillSubListView;
end;

// Esc - очистить фильтр, Enter - перейти к первой найденной, вниз - в список
procedure TForm1.SubFilterKeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
begin
  case Key of
    VK_ESCAPE:
      begin
        FSubFilter.Text := '';
        Key := 0;
      end;
    VK_RETURN:
      begin
        if lvSubList.Items.Count > 0 then
        begin
          if lvSubList.Selected = nil then
            lvSubList.Items[0].Selected := True;
          SubListDblClick(lvSubList);
        end;
        Key := 0;
      end;
    VK_DOWN:
      if lvSubList.Items.Count > 0 then
      begin
        if lvSubList.Selected = nil then
          lvSubList.Items[0].Selected := True;
        lvSubList.SetFocus;
        Key := 0;
      end;
  end;
end;

// Строка ALine (от нуля) - объявление подпрограммы из списка SubList?
// Список построен по возрастанию строк, поэтому поиск двоичный: он идёт
// на каждую видимую строку кадра.
// Отметки Format text (FFmtSusLine): отмечена ли строка ALineIdx. Строка
// должна быть той же, что при отметке, - исправленная гаснет сама.
function TForm1.FmtSuspectAt(ALineIdx: Integer): Boolean;
var
  K, LineStart, LineLen: Integer;
begin
  Result := False;
  for K := 0 to High(FFmtSusLine) do
    if FFmtSusLine[K] = ALineIdx then
    begin
      LineStart := SendMessageA(RichEdit1.Handle, EM_LINEINDEX, ALineIdx, 0);
      if LineStart < 0 then
        Exit;
      LineLen := SendMessageA(RichEdit1.Handle, EM_LINELENGTH, LineStart, 0);
      Result := (K <= High(FFmtSusText)) and
                (LineLen = Length(FFmtSusText[K])) and
                (TextRange(LineStart, LineLen) = FFmtSusText[K]);
      Exit;
    end;
end;

// Перед отрисовкой кадра: другой файл или строк стало больше/меньше -
// номера отметок уже не те, снимаем все
procedure TForm1.FmtSuspectCheck;
begin
  if Length(FFmtSusLine) = 0 then
    Exit;
  if (FFmtSusFile <> FCurrentFileName) or
     (FFmtSusLines <> SendMessageA(RichEdit1.Handle, EM_GETLINECOUNT, 0, 0)) then
    FmtSuspectClear;
end;

procedure TForm1.FmtSuspectClear;
begin
  SetLength(FFmtSusLine, 0);
  SetLength(FFmtSusText, 0);
  FFmtSusFile := '';
  FFmtSusLines := 0;
end;

function TForm1.IsSubBeginLine(ALine: Integer): Boolean;
var
  Lo, Hi, Mid: Integer;
begin
  Result := False;
  Lo := 0;
  Hi := High(FSubs);
  while Lo <= Hi do
  begin
    Mid := (Lo + Hi) div 2;
    if FSubs[Mid].BeginLine = ALine then
    begin
      Result := True;
      Exit;
    end
    else if FSubs[Mid].BeginLine < ALine then
      Lo := Mid + 1
    else
      Hi := Mid - 1;
  end;
end;

// Подпрограмма, внутри которой лежит строка ALine (от нуля), или -1
function TForm1.SubAtLine(ALine: Integer): Integer;
var
  K: Integer;
begin
  Result := -1;
  for K := 0 to High(FSubs) do
    if (ALine >= FSubs[K].BeginLine) and (ALine <= FSubs[K].EndLine) then
    begin
      Result := K;
      Exit;
    end;
end;

// Двойной щелчок по строке списка - переход к объявлению
procedure TForm1.SubListDblClick(Sender: TObject);
var
  K, Idx, VisLines, Target, First: Integer;
begin
  if (lvSubList = nil) or (lvSubList.Selected = nil) then
    Exit;
  K := Integer(lvSubList.Selected.Data);
  if (K < 0) or (K > High(FSubs)) then
    Exit;
  Idx := SendMessageA(RichEdit1.Handle, EM_LINEINDEX, FSubs[K].BeginLine, 0);
  if Idx < 0 then
    Exit;
  SendMessageA(RichEdit1.Handle, EM_SETSEL, Idx, Idx);

  // Строку объявления - на середину экрана, а не к нижнему краю, куда её
  // поставил бы EM_SCROLLCARET
  VisLines := 1;
  if LineHeight > 0 then
    VisLines := EditViewHeight div LineHeight;
  Target := FSubs[K].BeginLine - VisLines div 2;
  if Target < 0 then
    Target := 0;
  First := SendMessageA(RichEdit1.Handle, EM_GETFIRSTVISIBLELINE, 0, 0);
  if Target <> First then
    SendMessageA(RichEdit1.Handle, EM_LINESCROLL, 0, Target - First);

  // Отметка найденной строки - цветом LineMark
  FFoundLine := FSubs[K].BeginLine;

  if RichEdit1.CanFocus then
    RichEdit1.SetFocus;
  EnsureCaretVisibleX;
  RichEdit1.Invalidate;
end;

// ---------------------------------------------------------------------------
//  Инспектор объектов: дерево компонентов формы и их свойства
//
//  Источник - .dfm формы. В нём записаны только свойства, отличные от
//  значений по умолчанию, поэтому список короче, чем в инспекторе Delphi:
//  тот знает классы через RTTI, а у нас классов из чужого проекта нет.
//  Пока только просмотр.
// ---------------------------------------------------------------------------

// Подписи двух разных переключателей - по действию, которое сделает щелчок:
//   кнопка инспектора (FObjSnapBtn, FSnapOff) - снимок живой формы поверх
//   дерева объектов: живые значения и компоненты, которых разбор кода не
//   нашёл;
//   пункт меню конструктора (FDsgMiLiveView, FDsgLiveView) - вид формы в
//   конструкторе: значения, поставленные кодом, или только из .dfm.
// При запуске оба включены: снимок и живой вид.
const
  SnapCapShow = 'Show snapshot values';
  SnapCapHide = 'Show .dfm values only';
  // Та же кнопка у файла RapidQ (снимок - RapidQProbeRun)
  RqSnapCapShow = 'Show snapshot values';
  // Начало строки лога с путём сохранённого лога компиляции
  // (SaveCompileLog, LogEditClick)
  LogSavedTag = 'Лог сохранён: ';
  RqSnapCapHide = 'Show source values only';
  // Снимок есть, но текст после него менялся - щелчок снимает заново
  RqSnapCapStale = 'Update snapshot';
  DsgCapLive = 'live look';
  DsgCapDfm = '.dfm look';

procedure TForm1.BuildObjectInspector;
var
  Measure: TBitmap;
  CapWidth: Integer;
begin
  FDfmNodes := TList.Create;

  FObjSnapBtn.Hint := 'Созданные в коде компоненты видны и так - из ' +
  'исходника. Снимок добавляет их текущие значения и то, ' +
  'чего разбор кода не раскрыл. ' + SnapCapHide +
  ' только скрывает снимок; Ctrl+щелчок по ' + SnapCapShow +
  ' - новый пробный запуск';
  FObjSnapHint := FObjSnapBtn.Hint;
  // Снимка ещё нет - он снимется сам, когда откроется форма (ObjAutoSnap).
  // Ширина - под более длинную из двух подписей.
  FObjSnapBtn.Caption := SnapCapShow;
  Measure := TBitmap.Create;
  try
    Measure.Canvas.Font := FObjSnapBtn.Font;
    CapWidth := Measure.Canvas.TextWidth(SnapCapShow);
    if Measure.Canvas.TextWidth(SnapCapHide) > CapWidth then
      CapWidth := Measure.Canvas.TextWidth(SnapCapHide);
  finally
    Measure.Free;
  end;
  if CapWidth + 20 > FObjSnapBtn.Width then
    FObjSnapBtn.Width := CapWidth + 20;

  FObjDsgBtn.Left := FObjSnapBtn.Left + FObjSnapBtn.Width + 4;

  FObjDsgShowBtn.Left := FObjDsgBtn.Left + FObjDsgBtn.Width + 4;

  FObjMoveBtn.Left := FObjDsgShowBtn.Left + FObjDsgShowBtn.Width + 4;
  FObjMoveBtn.Hint := 'Какие компоненты, созданные в коде, можно перенести ' +
  'в .dfm и что останется в коде';

FDsgUndo := TStringList.Create;
  FDsgUndoPas := TStringList.Create;
  FDsgMade := TStringList.Create;

  FObjTree.Top := BtnPnl.Top + BtnPnl.Height;
  FObjTree.OnChange := ObjTreeChange;
  FObjTree.OnCustomDrawItem := ObjTreeDrawItem; // цвет выделенного узла

  Split.Top := FObjTree.Top + FObjTree.Height;

  FObjHeader.Top := Split.Top + Split.Height;

  // Выбор значения из выпадающего списка записывается сразу, как в Delphi
  FObjComboOldProc := FObjCombo.WindowProc;
  FObjCombo.WindowProc := ObjComboWndProc;
  // Цвета в списке - с квадратиком цвета; двойной щелчок - диалог цвета
  FObjCombo.ListOwnerDraw := True;
  FObjCombo.OnDrawItem := ObjComboDrawItem;
  FObjCombo.OnDblClick := ObjComboDblClick;

  // Свойства, которых нет в .dfm, - серым
  FObjProps.OnCustomDrawItem := ObjPropsDrawItem;
  FObjProps.OnCustomDrawSubItem := ObjPropsDrawSubItem;

  FObjMissing := TStringList.Create;
  FRqExpanded := TStringList.Create;
  FRqExpanded.Sorted := True;
  FRqExpanded.CaseSensitive := False;
  FRttiDefaults := TStringList.Create;
  RegisterVclClasses;

  FObjEvents.Columns[0].Caption := 'Событие';
  FObjEvents.Columns[1].Caption := 'Обработчик';
  // События без обработчика - серым, как свойства не из .dfm
  FObjEvents.OnCustomDrawItem := ObjPropsDrawItem;
  FObjEvents.OnCustomDrawSubItem := ObjPropsDrawSubItem;
end;

procedure TForm1.ClearDfmNodes;
var
  I: Integer;
begin
  if FObjRoots <> nil then
    FObjRoots.Clear;
  if FDfmNodes = nil then
    Exit;
  for I := 0 to FDfmNodes.Count - 1 do
    TDfmNode(FDfmNodes[I]).Free;
  FDfmNodes.Clear;
end;

// Текст формы. Двоичная переводится в текст средствами Classes:
// ObjectBinaryToText - с подписи TPF0, ObjectResourceToText - с заголовком
// ресурса перед ней (см. DfmBinaryKind). Текст возвращается как есть,
// не удалось - ''.
function TForm1.DfmToText(const ARaw: string): string;
var
  Src, Dst: TStringStream;
  Kind: Integer;
begin
  Result := ARaw;
  Kind := DfmBinaryKind(ARaw);
  if Kind = 0 then
    Exit;

  Src := TStringStream.Create(ARaw);
  Dst := TStringStream.Create('');
  try
    try
      if Kind = 2 then
        ObjectResourceToText(Src, Dst)
      else
        ObjectBinaryToText(Src, Dst);
      Result := Dst.DataString;
    except
      Result := '';
    end;
  finally
    Dst.Free;
    Src.Free;
  end;
end;




// Подпись узла. Безымянный (в снимке так выглядят созданные в коде) - с
// его Caption или Text: иначе десяток строк TPanel подряд не различить.
function TForm1.DfmNodeCaption(ANode: TObject): string;
var
  N: TDfmNode;
  K, ArrIdx: Integer;
  ArrName: string;
  IsArr: Boolean;
begin
  N := TDfmNode(ANode);
  // Элемент массива компонентов: PalBtn17 - PalBtn[17]. Только узел
  // снимка: компонент из .dfm или из кода с таким же именем - не элемент.
  IsArr := N.IsSnap and ObjArrayOf(N.Name, ArrName, ArrIdx);
  if IsArr then
    Result := ArrName + '[' + IntToStr(ArrIdx) + ']: ' + N.ClassNm
  else if N.Name <> '' then
    Result := N.Name + ': ' + N.ClassNm
  else if N.VarName <> '' then
  begin
    // Созданный в коде - с именем переменной из исходника
    Result := N.ClassNm + ' (' + N.VarName + ')';
    // Узел снимка с переменной остаётся отдельным, когда одна строка кода
    // создаёт несколько компонентов (цикл): различаются они подписью
    if N.IsSnap then
    begin
      K := N.PropN.IndexOf('Caption');
      if K < 0 then
        K := N.PropN.IndexOf('Text');
      if (K >= 0) and (N.PropV[K] <> '') then
        Result := Result + '  "' + N.PropV[K] + '"';
    end;
  end
  else
  begin
    Result := N.ClassNm;
    K := N.PropN.IndexOf('Caption');
    if K < 0 then
      K := N.PropN.IndexOf('Text');
    if (K >= 0) and (N.PropV[K] <> '') then
      Result := Result + '  "' + N.PropV[K] + '"';
  end;

  if IsArr then
    Result := Result + '  (элемент массива)'
  else if N.SnapRoot then
    Result := Result + '  (снимок ' + TimeToStr(FObjSnapTime) + ')'
  else if N.IsLink then
    Result := Result + '  (из .dfm, перенесён в коде)'
  else if N.IsLive then
    Result := Result + '  (runtime, значения из снимка)'
  else if N.IsRuntime then
    Result := Result + '  (runtime)';
  // Приписка узла: у объектов RapidQ - номер строки CREATE
  if N.Note <> '' then
    Result := Result + '   ' + N.Note;
end;

// Узлы - в дерево на экране. Внутрь ссылок не спускаемся: их содержимое
// показано на своём месте.
//
// Дерево обходится только по ссылкам узлов (первый ребёнок, следующий
// брат), с номером среди братьев, который считается по ходу. Items[I] и
// TTreeNode.Index здесь не используются: Index каждый раз пересчитывает
// братьев от первого, а ключ узла (путь с номерами) строился для каждого
// узла по всем его предкам. Время по частям - в строке 17150 HiLite log.
procedure TForm1.RenderObjTree(ARoots: TList);
var
  Expanded: TStringList;
  SelKey, TopKey: string;
  OldSel, OldTop, Sel, TopN: TTreeNode;
  HadState: Boolean;
  RootIdx: Integer;
  StartTick, StageTick, TSave, TAdd, TRestore, TShow, TProps: Cardinal;

  procedure AddNode(AParent: TTreeNode; N: TDfmNode);
  var
    T: TTreeNode;
    I: Integer;
  begin
    T := FObjTree.Items.AddChildObject(AParent, DfmNodeCaption(N), N);
    if N.IsLink then
      Exit;
    for I := 0 to N.Children.Count - 1 do
      AddNode(T, TDfmNode(N.Children[I]));
  end;

// Ключ узла - путь из подписей с номером среди братьев: подписи у
// безымянных runtime-узлов повторяются. По Data ключ не строим: к моменту
// перестроения старые узлы TDfmNode уже освобождены, живы только подписи.
// Обход - от AFirst по братьям и вглубь; APrefix - ключ родителя.
  procedure SaveState(AFirst: TTreeNode; const APrefix: string);
  var
    Node: TTreeNode;
    SibIdx: Integer;
    Key: string;
  begin
    Node := AFirst;
    SibIdx := 0;
    while Node <> nil do
    begin
      Key := APrefix + Node.Text + '#' + IntToStr(SibIdx) + '\';
      if Node.Expanded then
        Expanded.Add(Key);
      if Node = OldSel then
        SelKey := Key;
      if Node = OldTop then
        TopKey := Key;
      if Node.getFirstChild <> nil then
        SaveState(Node.getFirstChild, Key);
      Node := Node.getNextSibling;
      Inc(SibIdx);
    end;
  end;

// Раскрытые ветки, выделение и верх - по ключам; ветки runtime раскрыты
// всегда (что создано в коде, видно сразу)
  procedure RestoreState(AFirst: TTreeNode; const APrefix: string);
  var
    Node, ParentNode: TTreeNode;
    SibIdx: Integer;
    Key: string;
    Obj: TDfmNode;
  begin
    Node := AFirst;
    SibIdx := 0;
    while Node <> nil do
    begin
      Key := APrefix + Node.Text + '#' + IntToStr(SibIdx) + '\';
      if HadState then
      begin
        if Expanded.IndexOf(Key) >= 0 then
          Node.Expanded := True;
        if Key = SelKey then
          Sel := Node;
        if Key = TopKey then
          TopN := Node;
      end;
      Obj := TDfmNode(Node.Data);
      if (Obj <> nil) and (Obj.IsRuntime or Obj.FromCode) then
      begin
        ParentNode := Node;
        while ParentNode <> nil do
        begin
          if not ParentNode.Expanded then
            ParentNode.Expanded := True;
          ParentNode := ParentNode.Parent;
        end;
      end;
      if Node.getFirstChild <> nil then
        RestoreState(Node.getFirstChild, Key);
      Node := Node.getNextSibling;
      Inc(SibIdx);
    end;
  end;

begin
  StartTick := GetTickCount;
  // Состояние дерева до перестроения: раскрытые ветки, выделение и
  // верхняя видимая строка. Дерево перестраивается при каждой смене окна
  // и после правки - сворачивать его всякий раз значило бы терять место,
  // где человек смотрел.
  Expanded := TStringList.Create;
  try
    Expanded.Sorted := True;
    SelKey := '';
    TopKey := '';
    OldSel := FObjTree.Selected;
    OldTop := FObjTree.TopItem;
    HadState := FObjTree.Items.GetFirstNode <> nil;
    if HadState then
      SaveState(FObjTree.Items.GetFirstNode, '');
    TSave := GetTickCount - StartTick;

    // Пока дерево перестраивается, ObjTreeChange не должен трогать Data
    // старых узлов - они уже освобождены
    FObjRebuilding := True;
    FObjTree.Items.BeginUpdate;
    try
      StageTick := GetTickCount;
      FObjTree.Items.Clear;
      for RootIdx := 0 to ARoots.Count - 1 do
        AddNode(nil, TDfmNode(ARoots[RootIdx]));
      TAdd := GetTickCount - StageTick;

      StageTick := GetTickCount;
      Sel := nil;
      TopN := nil;
      RestoreState(FObjTree.Items.GetFirstNode, '');

      if FObjTree.Items.GetFirstNode <> nil then
      begin
        if not HadState then
          FObjTree.Items.GetFirstNode.Expand(False);
        if Sel = nil then
          Sel := FObjTree.Items.GetFirstNode;
        FObjTree.Selected := Sel;
      end;
      TRestore := GetTickCount - StageTick;
    finally
      StageTick := GetTickCount;
      FObjTree.Items.EndUpdate;
      FObjRebuilding := False;
    end;

    // Прокрутку - после EndUpdate: до него дерево размеров не знает
    if TopN <> nil then
      FObjTree.TopItem := TopN;
    TShow := GetTickCount - StageTick;
  finally
    Expanded.Free;
  end;

  // Внутри BeginUpdate дерево может не поднять OnChange - заполняем сетки
  // сами, по тому, что выбрано
  StageTick := GetTickCount;
  ObjTreeChange(nil, FObjTree.Selected);
  TProps := GetTickCount - StageTick;

  Dbg(Format('17150: дерево инспектора - %d мс (состояние %d, узлы %d, ' +
  'раскрытие %d, показ %d, свойства выбранного %d)',
             [GetTickCount - StartTick, TSave, TAdd, TRestore, TShow,
             TProps]), clNavy);
end;

// Какую форму показывать - по активному окну: открыт .dfm - разбираем текст
// из редактора, открыт .pas - соседний .dfm с диска. Файл с диска заново не
// разбираем, пока не изменилась его дата и не сменился снимок: иначе при
// каждом переключении вкладок терялось бы выделение в дереве.
//
// Снимок, если он есть, вливается поверх .dfm (MergeSnapNode). Относится он
// к другой форме - встаёт отдельным корнем, .dfm не трогая.
//
// AEvenHidden - разобрать, даже если вкладка Objects не на виду. Без этого
// разбор шёл бы на каждое переключение окна впустую.
procedure TForm1.RefreshObjectInspector(AEvenHidden: Boolean);
var
  Dfm, Ext, Key, Raw, Src: string;
  FromEditor, Binary: Boolean;
  BufIdx: Integer;
  UnitFile, UnitSrc: string;
  Grp: TDfmNode;
  ByLine: TStringList;
  Roots: TList;
  Index: TStringList;
  Gone: TStringList;   // убраны из .dfm вкладки после сборки exe
  DfmRoot, SnapRoot: TDfmNode;
  I: Integer;
  SnapTxt: string;
  DfmText, Cls, CacheFile, CacheKey: string;
  FromCache: Boolean;
  T0: Cardinal;
  // Замер по этапам (мс) - в строке «разобран» HiLite log
  TA, TPrep, TCode, TSnap, TNames, TDedup, TRender, TWrite: Cardinal;
  // Подготовка по частям: тексты формы и модуля, массивы компонентов,
  // снимок и убранные имена, ключ кэша, чтение кэша или разбор .dfm
  TPText, TPArr, TPSnap, TPKey, TPRead: Cardinal;
begin
  // Открытая правка в инспекторе - записать, пока FObjDfmFile и узел ещё
  // прежние: разбор ниже её выбросил бы. Сюда приходят переход к другому
  // окну и вкладке, снимок, правки в конструкторе.
  if FObjEditing then
    ObjApplyEdit;

  if (FObjTree = nil) or (FRightPages = nil) then
    Exit;
  // Красная подпись и подсказка устаревшего снимка RapidQ - только у
  // файла RapidQ: его ветка ниже поставит их заново
  if (FObjSnapBtn <> nil) and (FObjSnapBtn.TextColor <> clNone) then
  begin
    FObjSnapBtn.TextColor := clNone;
    FObjSnapBtn.Hint := FObjSnapHint;
  end;
  if not AEvenHidden and (FRightPages.ActivePage <> FTabObjects) then
    Exit;

  // Файл RapidQ (те же правила, что у вкладки Includes) - объекты CREATE
  if (FCurrentFileName <> '') and IncludesApply then
  begin
    RefreshRapidQInspector;
    Exit;
  end;
  FObjRapidQ := False;

  Ext := LowerCase(ExtractFileExt(FCurrentFileName));
  // Форма Delphi (.dfm) или Lazarus (.lfm) - один и тот же текстовый вид
  FromEditor := IsFormExt(Ext);
  if FromEditor then
    Dfm := FCurrentFileName
  else if IsPascalExt(Ext) then
    Dfm := FormFileFor(FCurrentFileName)
  else
    Dfm := '';
  if (Dfm <> '') and not FromEditor and not FileExists(Dfm) then
    Dfm := '';

  // .dfm открыт в другой вкладке - берём её текст, а не файл: иначе после
  // правки через инспектор показывалось бы старое значение с диска
  BufIdx := -1;
  if (Dfm <> '') and not FromEditor then
  begin
    BufIdx := WindowOfFile(Dfm);
    if BufIdx = FWindowsIndex then
      BufIdx := -1;
  end;

  // Ключ: файл, его дата и номер снимка. Текст в редакторе или во вкладке
  // мог измениться в любой момент - его разбираем всегда.
  if FromEditor or (BufIdx >= 0) then
    Key := ''
  else
    Key := Dfm + '|' + IntToStr(FileAge(Dfm)) + '|' + IntToStr(FObjSnapGen);
  if (Key <> '') and (Key = FObjDfmKey) then
    Exit;
  FObjDfmKey := Key;
  FObjDfmFile := Dfm;

  // Узлы не трогаем, пока не ясно, что дерево надо строить заново - см.
  // сверку ключа ниже
  Roots := TList.Create;
  Index := TStringList.Create;
  Gone := TStringList.Create;
  try
    // --- .dfm
    T0 := GetTickCount;
    TCode := 0;
    TSnap := 0;
    TNames := 0;
    TDedup := 0;
    DfmRoot := nil;
    SnapRoot := nil;
    Grp := nil;
    Binary := False;
    DfmText := '';
    Cls := '';
    UnitFile := '';
    UnitSrc := '';
    SnapTxt := '';
    CacheFile := '';
    CacheKey := '';
    FromCache := False;
    TPText := 0;
    TPArr := 0;
    TPSnap := 0;
    TPKey := 0;
    TPRead := 0;
    if FObjRoots = nil then
      FObjRoots := TList.Create;
    if Dfm <> '' then
    begin
      TA := GetTickCount;
      if FromEditor then
        Raw := GetEditorText
      else if BufIdx >= 0 then
        Raw := FWindows[BufIdx].Text
      else
      begin
        // Двоичный .dfm через TStringList читать нельзя: нули и переводы
        // строки внутри данных его ломают. Читаем файл целиком потоком.
        with TFileStream.Create(Dfm, fmOpenRead or fmShareDenyNone) do
        try
          SetLength(Raw, Size);
          if Size > 0 then
            ReadBuffer(Raw[1], Size);
        finally
          Free;
        end;
      end;
      Binary := DfmBinaryKind(Raw) <> 0;
      DfmText := DfmToText(Raw);

      // Модуль и снимок известны до разбора. По ним и тексту формы - ключ
      // кэша (dsgcache): совпал - дерево из файла кэша, без разбора.
      Cls := DfmRootClass(DfmText);
      if Cls <> '' then
      begin
        FObjFormClass := Cls;   // ObjFormUnit ищет по нему
        UnitFile := ObjFormUnit;
        if UnitFile <> '' then
          UnitSrc := UnitTextOf(UnitFile);
        TPText := GetTickCount - TA;
        // Массивы компонентов модуля - до подписей дерева (DfmNodeCaption)
        TA := GetTickCount;
        ObjCollectArrays(UnitSrc);
        TPArr := GetTickCount - TA;
        TA := GetTickCount;
        SnapTxt := ObjSnapTextFor(Cls);
        // Своя форма: снимок - с живой формы, собранной из прежнего .dfm.
        // Вырезанное или удалённое в конструкторе она ещё держит - без
        // этого списка оно встало бы в дерево как созданное в коде
        // (MergeSnapNode). Список - и в ключ кэша: дерево зависит от него.
        if SnapTxt <> '' then
          OwnFormGoneNames(Cls, DfmText, Gone);
        TPSnap := GetTickCount - TA;
        TA := GetTickCount;
        CacheFile := ObjCacheFileFor(Dfm);
        CacheKey := ObjCacheKey(DfmText, UnitFile, UnitSrc,
                                IntToHex(Crc32Of(SnapTxt), 8) + ':' +
                                IntToStr(Length(SnapTxt)) + ' gone ' +
                                IntToHex(Crc32Of(Gone.Text), 8));
        TPKey := GetTickCount - TA;


        // Дерево в памяти построено по тем же текстам формы и модуля и по
        // тому же снимку, номера строк в нём верные - перестраивать нечего.
        // Так бывает при переходе между .dfm и .pas той же формы и при
        // повторном щелчке по компоненту в конструкторе.
        if (CacheKey = FObjTreeKey) and (CompareText(Dfm, FObjTreeDfm) = 0) and
           not FObjLinesUnsure and (FObjRoots.Count > 0) then
        begin
          Dbg('16981: инспектор: ' + ExtractFileName(Dfm) +
          ' без изменений - дерево оставлено', clGray);
              Exit;
        end;
      end;
    end;

    // Дерево строится заново: прежние узлы - прочь
    ObjCancelEdit;
    FObjCurNode := nil;
    FObjDfmBinary := Binary;
    ClearDfmNodes;
    FObjTreeKey := '';

    TA := GetTickCount;
    if Dfm <> '' then
    begin
      if CacheKey <> '' then
        FromCache := ObjCacheRead(CacheFile, CacheKey, Roots);

      if FromCache then
      begin
        // Первый корень - форма из .dfm; снимок чужой формы помечен
        for I := 0 to Roots.Count - 1 do
          if TDfmNode(Roots[I]).SnapRoot then
            SnapRoot := TDfmNode(Roots[I])
          else if I = 0 then
            DfmRoot := TDfmNode(Roots[I]);
      end
      else
      begin
        DfmRoot := ParseDfmNodes(DfmText, False, FDfmNodes);
        if DfmRoot <> nil then
          Roots.Add(DfmRoot);
      end;
    end;

    // Подготовка: тексты, ключ, снимок, попытка кэша, разбор .dfm
    TPRead := GetTickCount - TA;
    TPrep := GetTickCount - T0;

    if not FromCache then
    begin
      // --- созданное в коде: разбор исходника модуля формы. Основной путь
      // для runtime-компонентов - работает без запуска и для любого проекта.
      if DfmRoot <> nil then
      begin
        if Cls = '' then
        begin
          // Класс по тексту не определился, а разбор форму нашёл
          FObjFormClass := DfmRoot.ClassNm;
          UnitFile := ObjFormUnit;
          if UnitFile <> '' then
            UnitSrc := UnitTextOf(UnitFile);
          ObjCollectArrays(UnitSrc);
          SnapTxt := ObjSnapTextFor(DfmRoot.ClassNm);
          if SnapTxt <> '' then
            OwnFormGoneNames(DfmRoot.ClassNm, DfmText, Gone);
        end;
        TA := GetTickCount;
        if UnitFile <> '' then
          Grp := BuildCodeRuntime(DfmRoot, UnitSrc, FObjFormClass, False,
                                  FDfmNodes);
        TCode := GetTickCount - TA;
      end;

      // --- снимок поверх: живые значения и то, чего разбор не раскрыл
      if SnapTxt <> '' then
      begin
        TA := GetTickCount;
        // Имена узлов .dfm - до разбора снимка, чтобы в указатель не попали
        // узлы самого снимка
        Index.Sorted := True;
        Index.Duplicates := dupIgnore;
        Index.CaseSensitive := False;
        for I := 0 to FDfmNodes.Count - 1 do
          if (TDfmNode(FDfmNodes[I]).Name <> '') and
             not TDfmNode(FDfmNodes[I]).IsLink then
            Index.AddObject(TDfmNode(FDfmNodes[I]).Name, FDfmNodes[I]);
        SnapRoot := ParseDfmNodes(SnapTxt, True, FDfmNodes);
        if SnapRoot <> nil then
          if (DfmRoot <> nil) and SameText(DfmRoot.ClassNm, SnapRoot.ClassNm) then
          begin
            MergeSnapNode(DfmRoot, SnapRoot, Index, Gone);
            TSnap := GetTickCount - TA;
            if UnitSrc <> '' then
            begin
              // Узлы снимка - к переменным, а совпавшие с узлами из кода по
              // строке создания сливаются с ними
              TA := GetTickCount;
              ResolveRuntimeNames(DfmRoot, UnitSrc);
              TNames := GetTickCount - TA;
              TA := GetTickCount;
              ByLine := TStringList.Create;
            try
              ByLine.Sorted := True;
              ByLine.Duplicates := dupIgnore;
              for I := 0 to FDfmNodes.Count - 1 do
                if TDfmNode(FDfmNodes[I]).FromCode and
                   (TDfmNode(FDfmNodes[I]).CreateLine >= 0) then
                  ByLine.AddObject(IntToStr(TDfmNode(FDfmNodes[I]).CreateLine),
                                   FDfmNodes[I]);
              DedupeSnapNodes(DfmRoot, ByLine, FDfmNodes);
            finally
              ByLine.Free;
            end;
              TDedup := GetTickCount - TA;
            end;
          end
        else
        begin
          SnapRoot.SnapRoot := True;
          Roots.Add(SnapRoot);
        end;
      end;

      // Что создано в коде, но к родителю не привязалось - отдельной веткой.
      // Снимок мог расставить всех по местам - тогда ветка пустая и не нужна.
      if (Grp <> nil) and (Grp.Children.Count > 0) then
        Roots.Add(Grp);
    end;

    if DfmRoot <> nil then
      FObjFormClass := DfmRoot.ClassNm
    else if SnapRoot <> nil then
      FObjFormClass := SnapRoot.ClassNm
    else
      FObjFormClass := '';

    // Снимок чужой формы стоит отдельно - имена его узлам из её модуля
    // (в кэше они уже расставлены)
    if not FromCache and (SnapRoot <> nil) and SnapRoot.SnapRoot then
    begin
      Src := ObjFormUnit;
      if Src <> '' then
        ResolveRuntimeNames(SnapRoot, UnitTextOf(Src));
    end;

    TA := GetTickCount;
    RenderObjTree(Roots);
    TRender := GetTickCount - TA;

    // Корни и ключ - для записи кэша после правок из инспектора. Номера
    // строк только что из разбора или из кэша - им можно верить.
    for I := 0 to Roots.Count - 1 do
      FObjRoots.Add(Roots[I]);
    FObjCacheFile := CacheFile;
    FObjCacheSnapKey := IntToHex(Crc32Of(SnapTxt), 8) + ':' +
                        IntToStr(Length(SnapTxt));
    FObjTreeKey := CacheKey;
    FObjTreeDfm := Dfm;
    FObjLinesUnsure := False;
    TA := GetTickCount;
    if not FromCache and (CacheFile <> '') and (DfmRoot <> nil) then
      // Перестройка после правки в конструкторе - запись позже, когда
      // правки стихнут
      if FDsgSelecting then
        ObjCacheWriteLater
      else
        ObjCacheWrite(CacheFile, CacheKey);
    TWrite := GetTickCount - TA;
    FObjTreeCached := FromCache;
    if Dfm <> '' then
      if FromCache then
        Dbg('17134: инспектор: ' + ExtractFileName(Dfm) + ' из кэша, ' +
            IntToStr(GetTickCount - T0) + ' мс (подготовка ' +
            IntToStr(TPrep) + ': тексты ' + IntToStr(TPText) + ', массивы ' +
            IntToStr(TPArr) + ', снимок ' + IntToStr(TPSnap) + ', ключ ' +
            IntToStr(TPKey) + ', чтение кэша ' + IntToStr(TPRead) +
        '; дерево ' + IntToStr(TRender) + ')', clNavy)
      else
        // По этапам: подготовка - тексты, ключ, снимок своей формы, разбор
        // .dfm; код - BuildCodeRuntime; снимок - его разбор и слияние с
        // .dfm; имена - ResolveRuntimeNames; места - DedupeSnapNodes;
        // дерево - RenderObjTree; кэш - запись файла
        Dbg('17142: инспектор: ' + ExtractFileName(Dfm) + ' разобран, ' +
            IntToStr(GetTickCount - T0) + ' мс (подготовка ' +
            IntToStr(TPrep) + ': тексты ' + IntToStr(TPText) +
        ', массивы ' + IntToStr(TPArr) + ', снимок ' + IntToStr(TPSnap) +
        ', ключ ' + IntToStr(TPKey) + ', разбор .dfm ' + IntToStr(TPRead) +
        '; код ' + IntToStr(TCode) + ', снимок ' +
            IntToStr(TSnap) + ', имена ' + IntToStr(TNames) + ', места ' +
            IntToStr(TDedup) + ', дерево ' + IntToStr(TRender) + ', кэш ' +
            IntToStr(TWrite) + ')', clNavy);

    // Подпись: откуда данные, и как убрать снимок
    if Dfm = '' then
      Src := '  У этого файла нет формы'
    else
    begin
      Src := '  ' + ExtractFileName(Dfm);
      if Binary then
        Src := Src + ' (двоичный)';
    end;
    if (SnapTxt <> '') and (SnapTxt = FObjSnapText) then
      Src := Src + '  +  снимок ' + TimeToStr(FObjSnapTime) +
      '.  Щелчок здесь - убрать снимок'
    else if SnapTxt <> '' then
      Src := Src + '  +  пробный запуск ' + TimeToStr(FProbeTime) +
      '.  Щелчок здесь - убрать';
FObjSource.Caption := Src;
  finally
    Gone.Free;
    Index.Free;
    Roots.Free;
  end;
end;

procedure TForm1.RightPagesChange(Sender: TObject);
begin
  if FRightPages.ActivePage = FTabObjects then
  begin
    RefreshObjectInspector(True);
