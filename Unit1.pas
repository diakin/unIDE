// F1 в редакторе файла RapidQ - справка по слову под кареткой: страница
// из rapidq_ref\help\keywords.txt, иначе указатель CHM с этим словом
function TForm1.HelpKey(AKey: Word): Boolean;
var
  BuildKind: Integer;
  ChmFile: string;
begin
  Result := False;
  if (AKey <> VK_F1) or (GetKeyState(VK_CONTROL) < 0) or
     (GetKeyState(VK_SHIFT) < 0) or (GetKeyState(VK_MENU) < 0) or
     (ActiveControl <> RichEdit1) then
    Exit;
  BuildKind := CurBuildKind;
  if BuildKind = bkFreeBasic then
  begin
    // Файл FreeBASIC - руководство FreeBASIC, слово по его указателю
    Result := True;
    ChmFile := FbHelpFile(True);
    if (ChmFile <> '') and not FbHelpKeyword(ChmFile, HelpWordAtCaret) then
      ShowMessage('Справка FreeBASIC: ' + RqHelpLastError);
    Exit;
  end;
  if BuildKind <> bkRapidQ then
    Exit;
  Result := True;
  if not RqHelpKeyword(HelpWordAtCaret) then
    ShowMessage('Справка RapidQ: ' + RqHelpLastError);
end;

// Слово для F1: выделение в пределах строки, иначе имя под кареткой (или
// перед ней) вместе с суффиксом типа ($ % & ! # ?) и знаком $ директивы
// в начале ($INCLUDE)
function TForm1.HelpWordAtCaret: string;
const
  NameChars = ['A'..'Z', 'a'..'z', '0'..'9', '_'];
var
  LineText, SelText: string;
  LineIdx, LineStart, CharPos, StartCol, EndCol: Integer;
begin
  Result := '';
  if not RichEdit1.HandleAllocated then
    Exit;
  if RichEdit1.SelLength > 0 then
  begin
    // Не RichEdit1.SelText: его чтение портит память (см. SelTextA)
    SelText := Trim(SelTextA(100));
    if (SelText <> '') and (Pos(#13, SelText) = 0) and
       (Pos(#10, SelText) = 0) then
    begin
      Result := SelText;
      Exit;
    end;
  end;
  LineText := CiLineOf(RichEdit1.SelStart, LineIdx, LineStart);
  CharPos := RichEdit1.SelStart - LineStart + 1;
  if (CharPos > Length(LineText)) or
     ((CharPos >= 1) and not (LineText[CharPos] in NameChars)) then
  begin
    // каретка сразу за именем (или за его суффиксом: STRF$|)
    Dec(CharPos);
    while (CharPos > 1) and (CharPos <= Length(LineText)) and
          (LineText[CharPos] in ['$', '%', '&', '!', '#', '?']) do
      Dec(CharPos);
  end;
  if (CharPos < 1) or (CharPos > Length(LineText)) or
     not (LineText[CharPos] in NameChars) then
    Exit;
  StartCol := CharPos;
  EndCol := CharPos;
  while (StartCol > 1) and (LineText[StartCol - 1] in NameChars) do
    Dec(StartCol);
  while (EndCol < Length(LineText)) and (LineText[EndCol + 1] in NameChars) do
    Inc(EndCol);
  if (StartCol > 1) and (LineText[StartCol - 1] = '$') then
    Dec(StartCol);
  while (EndCol < Length(LineText)) and
        (LineText[EndCol + 1] in ['$', '%', '&', '!', '#', '?']) do
    Inc(EndCol);
  Result := Copy(LineText, StartCol, EndCol - StartCol + 1);
  if (Result <> '') and (Result[1] in ['0'..'9']) then
    Result := '';   // число, а не имя
end;

// Меняет шрифт и базовые цвета редактора, не трогая флаг "файл изменён".
//
// Присваивание RichEdit1.Font переписывает форматирование ВСЕГО текста, и
// контрол честно взводит Modified. Из-за этого после смены шрифта редактор
// спрашивал "Сохранить изменения в файле?", хотя ни одной буквы не тронули.
// Флаг запоминаем до и возвращаем после - вместе со звёздочкой на вкладке
// и в заголовке окна, их успевает поставить EN_CHANGE.
//
// clNone в качестве цвета означает "не менять", nil в качестве шрифта - тоже.
// Карта комментариев и строк - заново, если маркеры не те, под которые она
// построена. Смена одних цветов карту не трогает: на большом файле полный
// разбор занимает сотни миллисекунд.
procedure TForm1.RefreshMapIfMarkersChanged;
var
  Sig: string;
begin
  Sig := FScheme.MarkersSig;
  if Sig = FMapMarkersSig then
    Exit;
  FScheme.BuildMarkerChars;
  InvalidateWidthCache;
  RebuildCommentRangeMap; // запоминает новую подпись
  FMapMarkersSig := Sig;
end;

// Схема активной вкладки - заново из файла. Окно настроек зовёт это при
// отмене: цвета и маркеры, показанные для предпросмотра, пропадают.
procedure TForm1.ReloadActiveClrSchema;
var
  Ext, WinFile: string;
  OldSuppress: Boolean;
begin
  WinFile := ActiveWindowFile;
  if (FWindowsIndex >= 0) and FWindows[FWindowsIndex].Used then
    Ext := WindowExt(FWindows[FWindowsIndex].FileName)
  else
    Ext := ExtractFileExt(FCurrentFileName);
  // Карту комментариев и строк LoadCustomClrSchema строила заново всегда -
  // на Unit1.pas это около 0,8 с. Здесь текст тот же, и карта нужна новая
  // только при других маркерах: это проверяет RefreshMapIfMarkersChanged.
  OldSuppress := FSuppressMapRebuild;
  FSuppressMapRebuild := True;
  try
    LoadCustomClrSchema(Ext, WinFile);
  finally
    FSuppressMapRebuild := OldSuppress;
  end;
  RefreshMapIfMarkersChanged;
  RichEdit1.Invalidate;
  if PaintBox1 <> nil then
    PaintBox1.Invalidate;
end;

// Фон пустого места редактора (BGColor в editor.ini). Схема его не меняет.
// Без раздела Text в схеме тот же цвет служит и подложкой под символами.
procedure TForm1.SetEditorBG(AColor: TColor);
var
  WasModified: Boolean;
begin
  WasModified := RichEdit1.Modified;
  try
    FIniBGColor := AColor;
    RichEdit1.Color := AColor;
    if not FScheme.FSchemaHasText then
      FScheme.FTextBG := AColor;
    // Зазор между номерами строк и текстом - тем же цветом
    if Panel1 <> nil then
      Panel1.Color := AColor;
  finally
    RichEdit1.Modified := WasModified;
  end;
  SaveSettings;
  RichEdit1.Invalidate;
  if PaintBox1 <> nil then
    PaintBox1.Invalidate;
end;

