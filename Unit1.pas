    // Геометрия отрисовки
    YOffset: Integer;
    LineHeight: Integer;
    TabStopN: Integer;
    InNumber: Boolean;



    // Параметры редактора
    FUseSyntaxHighlight: Boolean;
    FUseHotTab: Boolean;            // Направляющие отступов по табуляциям
    FTabChars: Integer;             // Ширина табуляции В СИМВОЛАХ
    // ОТСТУП. Чем форматировщик пишет отступы (меню Format text) и по чему
    // считаются уровни у направляющих полос.
    // FIndentKind - IndentSpaces, IndentTabs или IndentNone.
    // FIndentSize - сколько символов в одном уровне: пробелов при
    //   IndentSpaces, табуляций при IndentTabs. Полосам подсветки он нужен
    //   всегда: в открытом файле отступы могут быть пробельными при любой
    //   настройке, и уровни считаются по этому же числу.
    // FTabChars к этому отношения не имеет: он задаёт лишь ШИРИНУ символа
    // табуляции на экране и структуру текста не меняет.
    // ПАРА ПОД КАРЕТКОЙ: скобка со своей парной либо тег со своим закрытием.
    // Хранятся два отрезка в координатах текста, от нуля, включительно;
    // -1 - пары нет. Считает UpdatePairMatch на каждое движение каретки,
    // рисует HighlightVisibleText поверх текста.
    FPairA1, FPairA2: Integer;
    FPairB1, FPairB2: Integer;
    // Каретка на скобке: все скобки её строки - X позиция в тексте (от
    // нуля), Y уровень вложенности в строке; цвет - цвет линии отступа
    // этого уровня (FHotTabColors). Считает UpdatePairMatch.
    FLineBrackets: array of TPoint;
    // Активная вкладка - перевод RqToFb в папке _rqfb (RqFbIsGenerated):
    // текст только для чтения, правка свойств в инспекторе уходит в
    // исходник RapidQ и повторяется здесь (RqFbLinkedSet)
    FRqFbTab: Boolean;
    // Просмотр .md, .html, .mht поверх редактора (TWebBrowser); оба
    // просмотра создаются при первом показе, см. FmtApplyTab
    FWebView: TWebPreview;
    // Просмотр RTF и RVF поверх редактора (RichEdit только для чтения)
    FRtfView: TRtfPreview;
    // Вторая панель редактора: окно вкладки в ней (FSplitWin, -1 - нет),
    // её вид (текст / по формату), таймеры обновления и смены панелей,
    // место щелчка по её тексту. См. раздел "Вторая панель редактора"
    FSplit: TSplitPane;
    // Заголовок панели редактора (сверху FLeftHost), виден при разделении;
    // FSplitActive - работают во второй панели (её заголовок подсвечен)
    FEditHeader: TPaneHeader;
    FSplitActive: Boolean;
