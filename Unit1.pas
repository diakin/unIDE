// ---------------------------------------------------------------------------
//  Полоса меток (MarksBox) - между номерами строк и текстом, как в Delphi.
//  Закладка окна - квадратик с её номером в списке закладок (Bookmarks),
//  точка останова - красный кружок, строка остановки - стрелка.
//  Щелчок - закладка на строке (снова щелчок - снять), двойной щелчок -
//  точка останова.
// ---------------------------------------------------------------------------

// Строка под координатой Y полосы; -1 - ниже текста
function TForm1.MarksLineAtY(AY: Integer): Integer;
var
  LineStartChar, LineTotal, TopY, TopLine: Integer;
  FirstPt: TPoint;
begin
  Result := -1;
  if not RichEdit1.HandleAllocated or (LineHeight <= 0) then
    Exit;
  // Верхняя строка - у контрола напрямую: UpdateVisibleBounds ищет ещё и
  // нижнюю через EM_CHARFROMPOS, на большом файле это заметно
  TopLine := SendMessageA(RichEdit1.Handle, EM_GETFIRSTVISIBLELINE, 0, 0);
  TopY := 0;
  LineStartChar := SendMessageA(RichEdit1.Handle, EM_LINEINDEX, TopLine, 0);
  if LineStartChar >= 0 then
  begin
    SendMessageA(RichEdit1.Handle, EM_POSFROMCHAR, Integer(@FirstPt),
                 LineStartChar);
    TopY := FirstPt.Y;
  end;
  if AY < TopY then
    Exit;
  Result := TopLine + (AY - TopY) div LineHeight;
  LineTotal := SendMessageA(RichEdit1.Handle, EM_GETLINECOUNT, 0, 0);
  if (Result < 0) or (Result >= LineTotal) then
    Result := -1;
end;

// Размеры полосы меток по высоте строки. Слева - квадратик закладки:
// высота по строке, ширина - под номер из двух цифр (шрифт ставится на
// ACanvas); справа от него - кружок точки останова диаметром ADotD и там
// же стрелка строки остановки. AWidth - ширина всей полосы.
procedure TForm1.MarksLayout(ACanvas: TCanvas; var ABmH, ABmW, ADotD,
                             AWidth: Integer);
var
  LineH: Integer;
begin
  LineH := LineHeight;
  if LineH <= 0 then
    LineH := 16;
  ABmH := LineH - 2;
  if ABmH > 16 then
    ABmH := 16;
  if ABmH < 9 then
    ABmH := 9;
  ACanvas.Font.Name := 'Tahoma';
  ACanvas.Font.Height := -(ABmH - 3);
  ACanvas.Font.Style := [fsBold];
  ABmW := ACanvas.TextWidth('88') + 5;
  if ABmW < ABmH then
    ABmW := ABmH;
  ADotD := LineH - 7;
  if ADotD > 8 then
    ADotD := 8;
  if ADotD < 5 then
    ADotD := 5;
  AWidth := 1 + ABmW + 3 + ADotD + 4;
end;

procedure TForm1.MarksBoxPaint(Sender: TObject);
var
  BoxCanvas: TCanvas;
  LineIdx, LineTotal, LineY, TopY, LineStartChar, TopLine: Integer;
  MarkSize, CenterX, CenterY, BmIdx, BmNum: Integer;
  BmH, BmW, DotD, MarksW: Integer;
  FirstPt: TPoint;
  Mark: TBreakMark;
  MarkRect: TRect;
  NumText: string;
  Arrow: array[0..6] of TPoint;
  BgColor: TColor;
begin
  BoxCanvas := MarksBox.Canvas;
  BgColor := UiColor('Gutter.MarksBG');
  if BgColor = clDefault then
    BgColor := MarksAutoColor;
  BoxCanvas.Brush.Style := bsSolid;
  BoxCanvas.Brush.Color := BgColor;
  BoxCanvas.FillRect(MarksBox.ClientRect);
  if not RichEdit1.HandleAllocated or (LineHeight <= 0) then
    Exit;

  // Верхняя строка - у контрола напрямую: UpdateVisibleBounds ищет ещё и
  // нижнюю через EM_CHARFROMPOS, на большом файле это заметно
  TopLine := SendMessageA(RichEdit1.Handle, EM_GETFIRSTVISIBLELINE, 0, 0);
  TopY := 0;
  LineStartChar := SendMessageA(RichEdit1.Handle, EM_LINEINDEX, TopLine, 0);
  if LineStartChar >= 0 then
  begin
    SendMessageA(RichEdit1.Handle, EM_POSFROMCHAR, Integer(@FirstPt),
                 LineStartChar);
    TopY := FirstPt.Y;
  end;
  LineTotal := SendMessageA(RichEdit1.Handle, EM_GETLINECOUNT, 0, 0);

  // Квадратик закладки слева, кружок и стрелка - справа от него (шрифт
  // номера закладки ставит MarksLayout)
  MarksLayout(BoxCanvas, BmH, BmW, DotD, MarksW);
  CenterX := 1 + BmW + 3 + DotD div 2;
  MarkSize := DotD + 2;     // стрелка строки остановки

  for LineIdx := TopLine to MaxInt - 1 do
  begin
    if LineIdx >= LineTotal then
      Break;
    LineY := TopY + (LineIdx - TopLine) * LineHeight;
    if LineY + LineHeight < 0 then
      Continue;
    if LineY > MarksBox.Height then
      Break;
    CenterY := LineY + LineHeight div 2;

    // Точка останова - кружок
    Mark := nil;
    if FCurrentFileName <> '' then
      Mark := DbgMarkAt(FCurrentFileName, LineIdx);
    if Mark <> nil then
    begin
      BoxCanvas.Pen.Style := psSolid;
      if Mark.NoCode then
      begin
        BoxCanvas.Brush.Color := UiColor('Debug.NoCodeBG');
        BoxCanvas.Pen.Color := UiColor('Debug.NoCodeBG');
      end
      else
      begin
        BoxCanvas.Brush.Color := UiColor('Gutter.BreakDot');
        BoxCanvas.Pen.Color := UiColor('Gutter.BreakDot');
      end;
      BoxCanvas.Brush.Style := bsSolid;
      // Точка с условием - кольцо
      if Mark.Condition <> '' then
      begin
        BoxCanvas.Brush.Style := bsClear;
        BoxCanvas.Pen.Width := 2;
      end;
      BoxCanvas.Ellipse(CenterX - DotD div 2, CenterY - DotD div 2,
                        CenterX - DotD div 2 + DotD,
                        CenterY - DotD div 2 + DotD);
      BoxCanvas.Pen.Width := 1;
      BoxCanvas.Brush.Style := bsSolid;
    end;

    // Строка остановки - стрелка вправо
    if DbgLineKind(LineIdx) = 3 then
    begin
      Arrow[0] := Point(CenterX - MarkSize div 2, CenterY - MarkSize div 4);
      Arrow[1] := Point(CenterX, CenterY - MarkSize div 4);
      Arrow[2] := Point(CenterX, CenterY - MarkSize div 2);
      Arrow[3] := Point(CenterX + MarkSize div 2, CenterY);
      Arrow[4] := Point(CenterX, CenterY + MarkSize div 2);
      Arrow[5] := Point(CenterX, CenterY + MarkSize div 4);
      Arrow[6] := Point(CenterX - MarkSize div 2, CenterY + MarkSize div 4);
      BoxCanvas.Brush.Style := bsSolid;
      BoxCanvas.Brush.Color := UiColor('Gutter.ExecArrow');
      BoxCanvas.Pen.Color := UiColor('Gutter.BmBorder');
      BoxCanvas.Polygon(Arrow);
    end;

    // Закладка - квадратик с номером, слева
    if (FWindowsIndex >= 0) and FWindows[FWindowsIndex].Used then
      for BmIdx := 0 to High(FWindows[FWindowsIndex].Bookmarks) do
        if (FWindows[FWindowsIndex].Bookmarks[BmIdx].LineNo = LineIdx + 1) and
           not FWindows[FWindowsIndex].Bookmarks[BmIdx].Missing then
        begin
          MarkRect.Left := 1;
          MarkRect.Top := CenterY - BmH div 2;
          MarkRect.Right := MarkRect.Left + BmW;
          MarkRect.Bottom := MarkRect.Top + BmH;
          BoxCanvas.Brush.Style := bsSolid;
          BoxCanvas.Brush.Color := UiColor('Gutter.BmBG');
          BoxCanvas.Pen.Style := psSolid;
          BoxCanvas.Pen.Color := UiColor('Gutter.BmBorder');
          BoxCanvas.Rectangle(MarkRect.Left, MarkRect.Top, MarkRect.Right,
                              MarkRect.Bottom);
          BmNum := (BmIdx + 1) mod 100;
          NumText := IntToStr(BmNum);
          BoxCanvas.Brush.Style := bsClear;
          BoxCanvas.Font.Color := UiColor('Gutter.BmText');
          DrawTextA(BoxCanvas.Handle, PChar(NumText), Length(NumText),
                    MarkRect, DT_CENTER or DT_VCENTER or DT_SINGLELINE or
                    DT_NOCLIP);
          Break;
        end;
  end;
end;

procedure TForm1.MarksBoxMouseDown(Sender: TObject; Button: TMouseButton;
                                   Shift: TShiftState; X, Y: Integer);
var
  CondLine: Integer;
begin
  if Button = mbLeft then
    FMarkClickLine := MarksLineAtY(Y)
  else if Button = mbRight then
  begin
    // Как на номерах строк: условие точки останова
    CondLine := MarksLineAtY(Y);
    if CondLine >= 0 then
      DbgEditCondition(CondLine);
  end;
end;

// Задержка закладки после щелчка по полосе меток, мс
const
  MarkClickDelay = 250;

  // Одиночный щелчок ждёт MarkClickDelay, не станет ли он двойным: закладку
  // ставит таймер. Задержка короче системного времени двойного щелчка:
  // медленный двойной щелчок успевает поставить закладку - её снимает
  // MarksBoxDblClick.
procedure TForm1.MarksBoxClick(Sender: TObject);
begin
  if FMarkClickLine < 0 then
    Exit;
  if FMarkTimer = nil then
  begin
    FMarkTimer := TTimer.Create(Self);
    FMarkTimer.Enabled := False;
    FMarkTimer.OnTimer := MarkTimerTick;
  end;
  FMarkTimer.Enabled := False;
  FMarkTimer.Interval := MarkClickDelay;
  FMarkTimer.Enabled := True;
end;

procedure TForm1.MarkTimerTick(Sender: TObject);
begin
  FMarkTimer.Enabled := False;
  BmToggleAtLine(FMarkClickLine);
  FMarkBmLine := FMarkClickLine;
  FMarkBmTick := GetTickCount;
end;

procedure TForm1.MarksBoxDblClick(Sender: TObject);
begin
  if FMarkTimer <> nil then
  begin
    // Первый щелчок двойного уже переключил закладку - вернуть как было
    if not FMarkTimer.Enabled and (FMarkClickLine >= 0) and
       (FMarkBmLine = FMarkClickLine) and
       (GetTickCount - FMarkBmTick <= GetDoubleClickTime) then
      BmToggleAtLine(FMarkClickLine);
    FMarkTimer.Enabled := False;
  end;
  FMarkBmLine := -1;
  if FMarkClickLine >= 0 then
    DbgToggleBreak(FMarkClickLine);
end;

// Закладка на строке ALineIdx (с 0): есть - снимается, нет - ставится в
// конец списка закладок окна
procedure TForm1.BmToggleAtLine(ALineIdx: Integer);
var
  BmIdx, MoveIdx, BmCount: Integer;
begin
  if (ALineIdx < 0) or (FWindowsIndex < 0) or
     not FWindows[FWindowsIndex].Used then
    Exit;

  for BmIdx := 0 to High(FWindows[FWindowsIndex].Bookmarks) do
    if (FWindows[FWindowsIndex].Bookmarks[BmIdx].LineNo = ALineIdx + 1) and
       not FWindows[FWindowsIndex].Bookmarks[BmIdx].Missing then
    begin
      for MoveIdx := BmIdx to High(FWindows[FWindowsIndex].Bookmarks) - 1 do
        FWindows[FWindowsIndex].Bookmarks[MoveIdx] :=
          FWindows[FWindowsIndex].Bookmarks[MoveIdx + 1];
      SetLength(FWindows[FWindowsIndex].Bookmarks,
                Length(FWindows[FWindowsIndex].Bookmarks) - 1);
      BmHistDeleted(FWindowsIndex, BmIdx);
      RebuildBookmarksMenu;
      MarksBox.Invalidate;
      Exit;
    end;

  BmCount := Length(FWindows[FWindowsIndex].Bookmarks);
  SetLength(FWindows[FWindowsIndex].Bookmarks, BmCount + 1);
  FWindows[FWindowsIndex].Bookmarks[BmCount].LineNo := ALineIdx + 1;
  FWindows[FWindowsIndex].Bookmarks[BmCount].CharPos :=
    SendMessageA(RichEdit1.Handle, EM_LINEINDEX, ALineIdx, 0);
  if ALineIdx < RichEdit1.Lines.Count then
    FWindows[FWindowsIndex].Bookmarks[BmCount].Text :=
      Trim(RichEdit1.Lines[ALineIdx])
  else
    FWindows[FWindowsIndex].Bookmarks[BmCount].Text := '';
  // Новая закладка - сразу в историю посещений, а значит, и в Hot Bookmarks
  PushBmHistory(FWindowsIndex, BmCount);
  RebuildBookmarksMenu;
  MarksBox.Invalidate;
end;


// ---------------------------------------------------------------------------
//  Окно Watch
//
//  Ctrl+F5 в редакторе - выражение под кареткой (выделение, иначе имя с
//  цепочкой «Имя.Имя» слева от него) в список и окно Watch. На каждой
//  остановке значения пересчитываются по отладочной информации TD32 exe
//  (DbgSymbols; сборка с -V - см. CompileDelphi) и регистрам потока,
//  который стоит. Пока программа идёт или не запущена - вместо значения
//  состояние.
// ---------------------------------------------------------------------------

// Выражение для Watch: выделение в одну строку, иначе имя под кареткой
// вместе с «Объект.» слева (Edit1.Tag, Self.FCount)
function TForm1.DbgExprAtCaret: string;
var
  SelText: string;
begin
  Result := '';
  if not RichEdit1.HandleAllocated then
    Exit;
  if RichEdit1.SelLength > 0 then
  begin
    SelText := SelTextA(200);
    if (Pos(#13, SelText) = 0) and (Pos(#10, SelText) = 0) then
    begin
      Result := Trim(SelText);
      Exit;
    end;
  end;
  Result := DbgExprAtChar(RichEdit1.SelStart);
  if Result = '' then
    Exit;
  Result := DbgDeclNameAt(RichEdit1.SelStart, Result);
end;

// Каретка правее двоеточия в строке описания («T100: array[0..9] of Real»,
// «K, L: Integer»): в Watch идёт описанная переменная (первая из списка),
// а не слово типа под кареткой. Иначе - AWord как есть.
function TForm1.DbgDeclNameAt(ACharPos: Integer; const AWord: string): string;
var
  LineIdx, LineStart, CaretCol, ColonPos, NameIdx: Integer;
  LineText, NamePart: string;
begin
  Result := AWord;
  LineIdx := SendMessage(RichEdit1.Handle, EM_LINEFROMCHAR, ACharPos, 0);
  if (LineIdx < 0) or (LineIdx >= RichEdit1.Lines.Count) then
    Exit;
  LineStart := SendMessage(RichEdit1.Handle, EM_LINEINDEX, LineIdx, 0);
  LineText := RichEdit1.Lines[LineIdx];
  CaretCol := ACharPos - LineStart + 1;
  ColonPos := Pos(':', LineText);
  if (ColonPos = 0) or (CaretCol <= ColonPos) or
     (Copy(LineText, ColonPos + 1, 1) = '=') then
    Exit;
  NamePart := Trim(Copy(LineText, 1, ColonPos - 1));
  if Pos(',', NamePart) > 0 then
    NamePart := Trim(Copy(NamePart, 1, Pos(',', NamePart) - 1));
  // Слева от двоеточия - только имя (var-строка, поле записи)
  if (NamePart = '') or not (NamePart[1] in ['A'..'Z', 'a'..'z', '_']) then
    Exit;
  for NameIdx := 2 to Length(NamePart) do
    if not (NamePart[NameIdx] in ['A'..'Z', 'a'..'z', '0'..'9', '_']) then
      Exit;
  Result := NamePart;
end;

// Имя у символа ACharPos (на нём или сразу за ним, как у каретки) вместе с
// цепочкой «Объект.» слева. Число, знак, пробел - пустая строка.
function TForm1.DbgExprAtChar(ACharPos: Integer): string;
var
  LineText: string;
  LineIdx, LineStart, StartCol, EndCol, PartEnd: Integer;
begin
  Result := '';
  if not RichEdit1.HandleAllocated or (ACharPos < 0) then
    Exit;
  LineIdx := SendMessage(RichEdit1.Handle, EM_LINEFROMCHAR, ACharPos, 0);
  if (LineIdx < 0) or (LineIdx >= RichEdit1.Lines.Count) then
    Exit;
  LineStart := SendMessage(RichEdit1.Handle, EM_LINEINDEX, LineIdx, 0);
  LineText := RichEdit1.Lines[LineIdx];
  StartCol := ACharPos - LineStart + 1;
  // Символ не буква - смотрим знак слева (позиция сразу за словом)
  if (StartCol > Length(LineText)) or (StartCol < 1) or
     not (LineText[StartCol] in ['A'..'Z', 'a'..'z', '0'..'9', '_']) then
    Dec(StartCol);
  if (StartCol < 1) or (StartCol > Length(LineText)) or
     not (LineText[StartCol] in ['A'..'Z', 'a'..'z', '0'..'9', '_']) then
    Exit;
  EndCol := StartCol;
  while (StartCol > 1) and
        (LineText[StartCol - 1] in ['A'..'Z', 'a'..'z', '0'..'9', '_']) do
    Dec(StartCol);
  while (EndCol < Length(LineText)) and
        (LineText[EndCol + 1] in ['A'..'Z', 'a'..'z', '0'..'9', '_']) do
    Inc(EndCol);
  if LineText[StartCol] in ['0'..'9'] then
    Exit; // число, не имя
  // #13 и $FF - тоже не имена
  if (StartCol > 1) and (LineText[StartCol - 1] in ['#', '$']) then
    Exit;
  Result := Copy(LineText, StartCol, EndCol - StartCol + 1);
  // Цепочка слева через точки
  while (StartCol > 2) and (LineText[StartCol - 1] = '.') and
        (LineText[StartCol - 2] in ['A'..'Z', 'a'..'z', '0'..'9', '_']) do
  begin
    PartEnd := StartCol - 2;
    StartCol := PartEnd;
    while (StartCol > 1) and
          (LineText[StartCol - 1] in ['A'..'Z', 'a'..'z', '0'..'9', '_']) do
      Dec(StartCol);
    Result := Copy(LineText, StartCol, PartEnd - StartCol + 1) + '.' + Result;
  end;
end;

// Символ под точкой APoint клиентской области редактора; -1 - за концом
// строки или ниже текста. X поправляется на наш сдвиг FScrollX: контрол
// считает от начала текста (см. NewRichEditProc).
function TForm1.DbgCharAtClient(const APoint: TPoint): Integer;
var
  TextPt: TPoint;
  LineIdx, LineStart, LineTotal: Integer;
begin
  Result := -1;
  if not RichEdit1.HandleAllocated or (APoint.X < 0) or (APoint.Y < 0) or
     (APoint.Y >= RichEdit1.ClientHeight) then
    Exit;
  TextPt.X := APoint.X + FScrollX;
  TextPt.Y := APoint.Y;
  LineIdx := LineAtY(APoint.Y);
  LineTotal := SendMessageA(RichEdit1.Handle, EM_GETLINECOUNT, 0, 0);
  if (LineIdx < 0) or (LineIdx >= LineTotal) then
    Exit;
  // Правее конца строки - пусто (контрол отдал бы последний символ)
  if TextPt.X >= LinePixelWidth(LineIdx) then
    Exit;
  Result := SendMessageA(RichEdit1.Handle, EM_CHARFROMPOS, 0,
                         Integer(@TextPt));
  if Result < 0 then
    Exit;
  LineStart := SendMessageA(RichEdit1.Handle, EM_LINEINDEX, LineIdx, 0);
  if (Result < LineStart) or
     (SendMessageA(RichEdit1.Handle, EM_EXLINEFROMCHAR, 0, Result) <>
      LineIdx) then
    Result := -1;
end;

// Значение выражения на остановке. False - программа не стоит, нет
// отладочной информации или выражение не вычислилось (ответ вида <...>).
function TForm1.DbgEvalText(const AExpr: string; var AValue: string): Boolean;
var
  TypeText: string;
begin
  Result := False;
  AValue := '';
  if (FDbgSession = nil) and FRqDbgOn then
  begin
    if FRqDbgPaused then
      Result := RqDbgVarFind(AExpr, AValue, TypeText) or
                RqDbgWatchValue(AExpr, AValue, TypeText);
    Exit;
  end;
  if (AExpr = '') or (FDbgSession = nil) or FDbgSession.Finished or
     not FDbgSession.Paused or (FDbgSyms = nil) then
    Exit;
  AValue := FDbgSyms.Evaluate(AExpr, FDbgSession.ImageBase,
                              FDbgSession.StopEip, FDbgSession.StopRegs,
                              FDbgSession.ReadMemory, TypeText);
  Result := (AValue <> '') and (AValue[1] <> '<');
end;

procedure TForm1.DbgHintHide;
begin
  FDbgHintExpr := '';
  if (FDbgHintWnd <> nil) and FDbgHintWnd.HandleAllocated and
     IsWindowVisible(FDbgHintWnd.Handle) then
    FDbgHintWnd.ReleaseHandle;
end;

// Подсказка со значением под мышью. Таймер идёт, пока программа стоит:
// мышь задержалась над именем на тик - показываем «Имя = значение» у
// курсора; ушла с имени - убираем.
procedure TForm1.DbgHintTimerTick(Sender: TObject);
var
  CursorPt, ClientPt: TPoint;
  CharPos: Integer;
  Expr, ValueText, HintText: string;
  HintRect: TRect;
begin
  // Editor Options - Code Insight - Tooltip expression evaluation
  if not FEdIns.TooltipEval then
  begin
    DbgHintHide;
    Exit;
  end;
  if not (FRqDbgOn and FRqDbgPaused) and
     ((FDbgSession = nil) or FDbgSession.Finished or
      not FDbgSession.Paused) then
  begin
    if FDbgHintTimer <> nil then
      FDbgHintTimer.Enabled := False;
    DbgHintHide;
    Exit;
  end;
  // Подсказку держим только над редактором активного окна IDE
  if not Application.Active or not RichEdit1.HandleAllocated or
     not GetCursorPos(CursorPt) or
     (WindowFromPoint(CursorPt) <> RichEdit1.Handle) or
     (GetKeyState(VK_LBUTTON) < 0) or (GetKeyState(VK_RBUTTON) < 0) then
  begin
    DbgHintHide;
    FDbgHintPt := Point(-1, -1);
    Exit;
  end;

  ClientPt := RichEdit1.ScreenToClient(CursorPt);
  CharPos := DbgCharAtClient(ClientPt);
  if CharPos >= 0 then
    Expr := DbgExprAtChar(CharPos)
  else
    Expr := '';

  if Expr = '' then
  begin
    DbgHintHide;
    FDbgHintPt := CursorPt;
    Exit;
  end;
  // Та же подсказка уже показана - мышь ходит по тому же имени
  if (Expr = FDbgHintExpr) then
    Exit;
  // Ждём, пока мышь постоит на месте один тик
  if (CursorPt.X <> FDbgHintPt.X) or (CursorPt.Y <> FDbgHintPt.Y) then
  begin
    DbgHintHide;
    FDbgHintPt := CursorPt;
    Exit;
  end;

  DbgHintHide;
  if not DbgEvalText(Expr, ValueText) then
    Exit;
  HintText := Expr + ' = ' + ValueText;
  if FDbgHintWnd = nil then
    FDbgHintWnd := HintWindowClass.Create(Self);
  HintRect := FDbgHintWnd.CalcHintRect(700, HintText, nil);
  OffsetRect(HintRect, CursorPt.X + 12, CursorPt.Y + 18);
  FDbgHintWnd.ActivateHint(HintRect, HintText);
  FDbgHintExpr := Expr;
end;

procedure TForm1.DbgAddWatch(const AExpr: string);
var
  ExprIdx: Integer;
begin
  DbgWatchShow;
  if Trim(AExpr) = '' then
  begin
    LogComp('Watch: под кареткой нет имени - выражение можно добавить в ' +
    'окне Watch (Ins)');
            Exit;
  end;
  ExprIdx := FWatchList.IndexOf(Trim(AExpr));
  if ExprIdx < 0 then
    ExprIdx := FWatchList.Add(Trim(AExpr));
  DbgWatchRefresh;
  if (ExprIdx >= 0) and (ExprIdx < FWatchWnd.lvWatch.Items.Count) then
  begin
    FWatchWnd.lvWatch.Selected := FWatchWnd.lvWatch.Items[ExprIdx];
    FWatchWnd.lvWatch.Selected.MakeVisible(False);
  end;
end;

// Окно Watch: создаётся один раз, при первом показе встаёт у правого края
// главного окна. Владелец окна - главное окно: остаётся над ним.
procedure TForm1.DbgWatchShow;
var
  FirstShow: Boolean;
begin
  FirstShow := FWatchWnd = nil;
  if FirstShow then
  begin
    FWatchWnd := TDlgWatch.Create(Self);
    FWatchWnd.miWatchAdd.OnClick := WatchAddClick;
    FWatchWnd.miWatchEdit.OnClick := WatchEditClick;
    FWatchWnd.miWatchDelete.OnClick := WatchDeleteClick;
    FWatchWnd.miWatchDeleteAll.OnClick := WatchDeleteAllClick;
    FWatchWnd.miWatchLocals.OnClick := WatchLocalsClick;
    FWatchWnd.miWatchCond.OnClick := WatchCondClick;
    FWatchWnd.lvWatch.OnKeyDown := WatchKeyDown;
    FWatchWnd.lvWatch.OnDblClick := WatchDblClick;
    FWatchWnd.lvWatch.OnSelectItem := WatchSelectItem;
    WatchArrBuild;
    FWatchWnd.Left := Left + Width - FWatchWnd.Width - 40;
    FWatchWnd.Top := Top + Height - FWatchWnd.Height - 80;
    if FWatchWnd.Left < Screen.WorkAreaLeft then
      FWatchWnd.Left := Screen.WorkAreaLeft;
    if FWatchWnd.Top < Screen.WorkAreaTop then
      FWatchWnd.Top := Screen.WorkAreaTop;
    UiApplyForm(FWatchWnd);
  end;
  if not FWatchWnd.Visible then
  begin
    FWatchWnd.Show;
    SetWindowLong(FWatchWnd.Handle, GWL_HWNDPARENT, Integer(Handle));
  end;
  // Работа - в редакторе: фокус обратно
  if RichEdit1.CanFocus then
    RichEdit1.SetFocus;
end;

// ---------------------------------------------------------------------------
//  Окна Arduino: Board Manager, Library Manager, Arduino CLI Help
// ---------------------------------------------------------------------------
//
// Перенос окон RQdebugger. Вся работа - в самих окнах (DlgArdBoards,
// DlgArdLibs, DlgArdCli) и в ArduinoCli; здесь - создание при первом
// показе, файл настроек, тема и владелец. Окна не модальные; владелец -
// главное окно, они остаются над ним.

procedure TForm1.ArdWndShow(AWnd: TForm);
begin
  if not AWnd.Visible then
  begin
    AWnd.Show;
    SetWindowLong(AWnd.Handle, GWL_HWNDPARENT, Integer(Handle));
  end
  else if AWnd.WindowState = wsMinimized then
    AWnd.WindowState := wsNormal;
  AWnd.BringToFront;
end;

