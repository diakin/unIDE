unit Unit1;

interface

uses
  Windows, Messages, SysUtils, Variants, Classes, Graphics, Controls, Forms,
  Dialogs, StdCtrls, ComCtrls, StrUtils, Menus, ExtCtrls, RichEdit, ColorGrd,
  Buttons, IniFiles, ShellAPI, CheckLst, Grids, Clipbrd, FileCtrl,
  FormDesigner,   // визуальный конструктор форм
  DsgClasses,     // классы палитры для конструктора и инспектора
  DsgPalette,     // окно палитры компонентов
  DsgForeign,     // сторонние компоненты палитры (пакеты, установленные в Delphi)
  ClrScheme,      // цветовая схема подсветки (.clr) - TClrScheme
  RqDeclFind,     // объявления в исходниках RapidQ - панель объявления
  UiTheme,        // темы своих элементов: Light / Dark / Custom, цвета ролей
  UiScroll,       // полоса прокрутки, которую рисует программа
  UiButton,       // кнопка, которую рисует программа (вместо TButton)
  UiGroupBox,     // рамка с подписью своими цветами (вместо TGroupBox)
  UiStdCtrls,     // флажок, переключатель и прочие свои элементы Standard
  UiEditCtrls,    // поле ввода, многострочное поле, список, список выбора
  UiComCtrls,     // вкладки, строка состояния, дерево, таблица, счётчик
  UiMenus,        // своё меню по теме: строка меню и выпадающие окна
  MenuWizard,     // мастер меню конструктора форм: готовые наборы меню
  DfmMove,        // «Перенести в .dfm»: разбор созданного кодом
  DbgEngine,      // отладчик: точки останова, остановка, продолжение
  DbgSymbols,     // отладочная информация TD32: значения переменных (Watch)
  RqDbgInstr,     // отладчик RapidQ: копия программы с проверками точек
  DlgWatch,       // окно Watch
  DlgCompProgress, // окно хода сборки (этапы, полоса) - CompDlgOpen
  DlgArdBoards,   // Arduino: Board Manager
  DlgArdLibs,     // Arduino: Library Manager
  DlgArdCli,      // Arduino: Arduino CLI Help
  DlgArdSerial,   // Arduino: Serial Monitor
  DlgTidyIni,     // Tidy editor.ini: поиск проектов, разбор editor.ini
  ArduinoCli,     // Arduino: настройки, запуск arduino-cli
  ArduinoHw,      // Arduino: платформы, платы, библиотеки, скетчи с диска
  ArduinoPorts,   // Arduino: COM-порты и событие подключения устройства
  EnvOptions,     // IDE Options: Preferences, Designer, Environment Variables
  CodeInsight,    // Code Insight: имена для списка подстановки, сам список
  WndWatch,       // журнал главного окна и перерисовки (wnd.log)
  FmtView,        // просмотр по формату во вкладке: .md, .html, .mht, .rtf, .rvf
  SplitPane,      // вторая панель редактора: вкладка только для чтения
  FileSearch,     // Find In Files: маски, чтение файлов, обход папок (TFifFileFound)
  UnFar,          // unIDE FAR: двухпанельный файловый менеджер (Utils)
// Окна сообщений по теме. Последним: его ShowMessage, MessageDlg,
// InputQuery перекрывают одноимённые функции Dialogs
  UiDialogs;

const
  // Кнопок палитры компонентов (массив PalBtn) - по одной на класс всех
  // страниц DsgClasses; сейчас их чуть больше сотни
  PalBtnMax = 256;
  // Свойства кнопок палитры, которыми управляет сам код: класс кнопки
  // (Tag - по нему CompClick узнаёт класс), страница (Visible - её
  // переключает ShowPage), нажатие и группа выбора (Down, GroupIndex,
  // AllowAllUp). Поправки к ним из editor.ini не применяются, инспектор их
  // не правит, а ведёт к этой строке. Имя <массив>CodeProps - по нему
  // строку находит инспектор (ObjCollectArrays).
  PalBtnCodeProps = 'Tag,Visible,Down,GroupIndex,AllowAllUp';

  // Знаки, которыми показываются непечатные символы: точка на месте пробела
  // и двойная стрелка на месте табуляции. Коды ANSI, шрифт редактора их
  // содержит. Текст файла при этом не трогается - знаки только рисуются.
  SpaceMarkChar = #183;
  TabMarkChar   = #187;

  // Режим IDE ([Themes] Mode): цвета самой IDE и вид своих элементов
  IdeModeLight  = 0;   // как Windows
  IdeModeDark   = 1;   // тёмный
  IdeModeCustom = 2;   // своя тема из списка (IDE.clr, Ключ@Ide:Имя)
  WhiteMarkColor = $00A0A0A0;

  // Сколько цветов чередуется в направляющих отступов
  HotTabLevels = 5;

  // Чем форматировщик делает отступы (меню Format text) - выбор в окне
  // настроек, группа Indent. Подсветка отступов от этого не зависит:
  // у неё своя галка, и файл могли открыть чужой, с любым оформлением.
  IndentSpaces = 0;
  IndentTabs   = 1;
  IndentNone   = 2; // отступов не делать вовсе

  // Постоянная ширина RichEdit1, пикселей.
  //
  // Раньше была ширина рабочего стола. Строка шире неё выводила каретку за
  // правую границу контрола, и он начинал прокручиваться вбок сам - замер
  // показал это прямо: X каретки по контролу упирался в 1918 при столе
  // 1920, а собственный сдвиг контрола рос на остаток.
  //
  // 32000 - с запасом под пределом 32767: дальше не работают координаты мыши,
  // которые уходят контролу знаковым 16-битным числом. Строка шире этого
  // заставляет контрол прокручиваться самого - CheckCtlScrollX такой сдвиг
  // сразу сбрасывает.
  //
  // Горизонтальные координаты контрола правее 32767 недостоверны: RichEdit 4.1
  // отдаёт X в EM_POSFROMCHAR обрезанным до 16 бит (проба RichLimitTest,
  // "Длинная строка"). Поэтому X символов считает НАША разметка -
  // см. MeasureRun и GetLineInfo.
  //
  // Задаётся один раз, до загрузки текста. Затраты на изменение ширины,
  // растущие с документом, к этому моменту не возникают - документа ещё нет.
  EditorFixedWidth = 32000;


  // Ширина своей каретки, пикселей - см. SyncCaretX
  OwnCaretWidth = 2;

  // Правая панель (SubList, Objects, Includes): ширина по умолчанию,
  // наименьшая ширина самой панели и наименьшая ширина, остающаяся слева
  RightPanelDefWidth = 300;
  RightPanelMinWidth = 80;
  RightPanelMinLeft = 200;
  // Свёрнутая правая панель (кнопка _ ): полоска разделителя и кнопка [] 
  RightPanelCollapsedWidth = 30;

  // Длинные строки. От LongLineMin символов строка рисуется окном: из неё
  // читается и меряется только видимый кусок, а X его начала берётся из
  // разреженной таблицы - X в начале каждого блока в XBlockLen символов.
  // LineInfoCount - сколько таких строк держит кэш (см. GetLineInfo).
  LongLineMin = 4096;
  XBlockLen = 1024;
  LineInfoCount = 256;

  // Панель номеров строк: сколько цифр помещается самое меньшее. Номера
  // длиннее (больше 99999 строк) - полоса шире на нужное число знакомест,
  // см. GutterDigitsFor и UpdateGutterWidth.
  GutterMinDigits = 5;

  // Предел объёма текста для RichEdit1 (EM_EXLIMITTEXT), символов.
  // Раньше был 65535 * 32 = 2 097 120 - меньше больших файлов в 15 раз.
  EditorTextLimit = $7FFFFFF0;

  // Размерность массива текстовых окон
  WindowsItemCount = 48;

  // Приходит при смене режима показа подчёркиваний в подписях - то есть по
  // нажатию Alt. В Messages.pas Delphi 7 этой константы нет.
  //
  // Объявлена в interface, а не рядом с остальными служебными константами
  // модуля: директива message в объявлении класса требует, чтобы константа
  // была видна здесь же.
  WM_UPDATE_UISTATE = $0128; // WM_UPDATEUISTATE

  // Окно результатов поиска.
  //
  // Ширина - на треть меньше прежних 620. Окно встаёт справа от главного, но
  // не встык: MatchOverlap - тот самый небольшой нахлёст, по которому видно,
  // что список относится к редактору, а не живёт сам по себе.
  MatchFormWidth  = 413;
  MatchOverlap    = 40;
  MatchRowHeight  = 18;

  // Насколько глубоко обходить горячие папки, когда файл ищется по ИМЕНИ.
  // Без ограничения один отмеченный корень диска подвесил бы программу.
  HotSearchDepth = 6;
  // Сколько миллисекунд искать потерянный файл в дереве над папкой
  // программы (RelocateFile). Горячие папки - без предела: их выбрал сам
  // пользователь.
  RelocateSearchMs = 3000;

type

  TCommentRange = record
    // Диапазон ПОЛУОТКРЫТЫЙ, индексы от нуля, как их считает контрол:
    // StartPos - первый символ открывающего маркера, EndPos - позиция ЗА
    // последним символом закрывающего. Именно так сравнивает InRanges.
    // Так же устроены и диапазоны строковых литералов.
    StartPos: Integer;
    Kind: Integer;        // Номер пары маркеров: 0 - основная, дальше
    // FBcExtra[Kind - 1]. У строковых литералов не
    // используется.
    EndPos: Integer;   // Глобальный индекс '/' (конец '*/') в тексте
  end;

  // Именованный тип обязателен. Каждое инлайновое "array of TCommentRange"
  // Delphi считает ОТДЕЛЬНЫМ анонимным типом, поэтому поле записи и поле
  // класса, объявленные так по отдельности, оказались бы несовместимы.
  TCommentRangeArray = array of TCommentRange;

  // Именованная закладка внутри одного окна.
  //
  // В .prj она лежит двумя ключами: bmarkCaption<окно>,<номер> хранит подпись
  // вида "<номер строки> <текст строки>", а bmarkPosic<окно>,<номер> - позицию
  // каретки. Номер строки держим отдельным полем: по нему работает сортировка.
  TBookmark = record
    LineNo: Integer;  // 1-базовый номер строки, он же в начале подписи
    CharPos: Integer; // позиция каретки, куда переходим по клику
    Text: string;     // текст строки
    // Строки с таким текстом в файле нет (BmValidateWindow): пункт в меню
    // серый, метки на полосе нет. В .prj не пишется - проверяется заново.
    Missing: Boolean;
    // Закреплена в Hot Bookmarks: стоит вверху списка и не вытесняется
    // новыми. В .prj - ключ bmarkHot<номер>,<окно>.
    Pinned: Boolean;
  end;

  TBookmarkArray = array of TBookmark;

  // Строка в окне результатов поиска.
  //
  // Грид плоский, поэтому заголовки файлов и сами вхождения лежат в одном
  // массиве и различаются полем Kind. Индекс строки грида и индекс в массиве
  // связаны как Row = Idx + 1: нулевую строку занимает шапка.
  TMatchRowKind = (mrkGroup, mrkHit);

  TMatchRow = record
    Kind: TMatchRowKind;
    FileName: string;   // полный путь; у вхождения тот же, что у его группы
    WinIdx: Integer;    // слот в FWindows или -1, если файл не открыт
    LineNo: Integer;    // 0-базовый номер строки, только у mrkHit
    MatchPos: Integer;  // 1-базовая позиция вхождения В СТРОКЕ, только у mrkHit
    Text: string;       // текст найденной строки, только у mrkHit
    HitCount: Integer;  // сколько вхождений в файле, только у mrkGroup
    Collapsed: Boolean; // группа свёрнута, только у mrkGroup
  end;

  TMatchRowArray = array of TMatchRow;

  // Копия до замены All по вкладкам, проекту, диску (Undo): текст окна
  // или байты файла на диске
  TReplBackup = record
    FileName: string;
    Text: string;
    OnDisk: Boolean;    // файл не был открыт - перезаписан на диске
    // Кодировка файла окна: окно закрыли - прежний текст пишется на диск
    IsUtf8: Boolean;
    HasBom: Boolean;
  end;
  TReplBackupArray = array of TReplBackup;

  // Текст файла на диске на момент последнего чтения или записи здесь
  TDiskBase = class
  public
    Text: string;
  end;

  // Подпрограмма из списка SubList: имя (строка объявления), первая и
  // последняя строки
  TSubInfo = record
    Name: string;
    BeginLine: Integer;
    EndLine: Integer;
  end;

  // Именованные типы - по той же причине, что TCommentRangeArray: поле
  // записи окна и поле формы должны быть совместимы при присваивании
  TSubInfoArray = array of TSubInfo;
  TIntArray = array of Integer;

  // Метка направляющей отступов у верхнего или нижнего края редактора:
  // полоса уровня Level строки Line уходит за край окна. Box - где
  // нарисована, в координатах окна редактора.
  TGuideMark = record
    Box: TRect;
    Line: Integer;
    Level: Integer;
    AtTop: Boolean;   // у верхнего края (щелчок - начало блока), иначе у
                      // нижнего (щелчок - конец блока)
  end;
  TStrArray = array of string;

  // Одно текстовое окно: файл целиком в памяти плюс его состояние.
  //
  // В исходном варианте на BASIC под это отводились параллельные массивы
  // Window, CmdParam, CursWin и Modif. Здесь они сведены в запись: поля
  // одного окна лежат рядом и не могут разъехаться по индексам.
  TEditorWindow = record
    Used: Boolean;      // слот занят
    FileName: string;   // было CmdParam()
    Text: string;       // было Window()
    CursorPos: Integer; // было CursWin()
    Modified: Boolean;  // было Modif()
    IsUtf8: Boolean;    // кодировка файла на диске
    HasBom: Boolean;
    Broken: Boolean;    // файла нет на диске - окно помечается как нерабочее
    // Главный .bas, к которому файл подключён через $INCLUDE: файл открыт
    // из дерева вкладки Includes (или остановкой отладчика в нём). На
    // вкладке - после имени; сборка и запуск с этой вкладки - его. '' - нет.
    IncOwner: string;

    // Кэш карт комментариев и строковых литералов этого окна.
    // Построение карты - полный проход по тексту, и при переключении окон
    // повторять его незачем: текст с прошлого раза не изменился.
    MapValid: Boolean;
    CommentRanges: TCommentRangeArray;
    StringRanges: TCommentRangeArray;
    // Остальной разбор для отрисовки - по тому же тексту, MapValid
    // относится и к нему (см. «Кэш разбора текста»): список подпрограмм,
    // уровни строк, хеш имён компонентов. CompDfmKey - соседний .dfm
    // (путь и дата), по которому строились имена; '' - не сверять.
    Subs: TSubInfoArray;
    LineDepth: TIntArray;
    CompSlots: TIntArray;
    CompWords: TStrArray;
    CompMask: Integer;
    CompDfmKey: string;
    // Подпись схемы, при которой всё это построено, - для ключа на диске.
    // MapSaved - на диске (mapcache) лежит этот же разбор, при выходе
    // писать не нужно.
    MapSchemeSig: string;
    MapSaved: Boolean;

    // Закладки принадлежат окну: в .prj они и привязаны к его индексу
    Bookmarks: TBookmarkArray;

    // Сколько мс в прошлый раз шла вторая половина переключения на это
    // окно (WMTabSwitched): по нему решается, показывать ли панель хода
    WorkMs: Cardinal;

    // Вкладка показана просмотром по формату (F12, Txt / Fmt), а не
    // текстом. См. FmtApplyTab
    FmtShown: Boolean;
  end;

type
  // TRichEdit с окном RichEdit 4.1 (msftedit.dll, класс RICHEDIT50W).
  //
  // Объявлен в этом модуле ДО TForm1, поэтому RichEdit1 и LogEdit из DFM
  // создаются этим классом. Всё остальное - от VCL.
  //
  // Зачем: RichEdit 3.0 (riched20.dll) режет строку шире 24576 пикселей на
  // строки отображения (3071 символ при 8 px), 4.1 - нет. Проверено в пробе
  // RichLimitTest: до миллиона символов строка одна.
  //
  // Что меняется для кода. Класс только Unicode. Окно VCL регистрирует
  // ANSI-функцией, и стандартные сообщения (WM_SETTEXT, WM_GETTEXT,
  // EM_GETLINE, EM_REPLACESEL) Windows перекодирует сама. Собственные
  // сообщения RichEdit - нет: EM_GETTEXTRANGE, EM_GETSELTEXT, EM_FINDTEXT
  // работают с UTF-16. Поэтому текст через них берётся только функциями
  // TextRange, CharAt, SelTextA и FindTextEd. RichEdit1.SelText на чтение и
  // RichEdit1.FindText напрямую НЕ использовать.
  //
  // Lines.Add и Lines.Insert у этих контролов тоже НЕ использовать, в том
  // числе через Lines.Strings в DFM. VCL после вставки сверяет позицию
  // каретки с длиной вставленной строки вместе с CRLF, а 4.1 хранит перевод
  // строки одним символом - сверка не сходится, и VCL поднимает
  // EOutOfResources 'RichEdit line insertion error'.
  //
  // Если msftedit.dll не загрузилась, остаётся RichEdit 3.0, и те же функции
  // работают по-старому - см. MsftEditActive.
  TRichEdit = class(ComCtrls.TRichEdit)
  protected
    procedure CreateParams(var Params: TCreateParams); override;
  end;

  // РАЗМЕТКА ОДНОЙ СТРОКИ - общая для трёх разборов текста: списка
  // подпрограмм (RebuildSubListBlocks), уровней вложенности
  // (RebuildLineDepths) и форматировщика (FormatIndentText). Заполняет
  // ScanLine, слова берутся из разделов схемы.
  TLineScan = record
    FirstPos: Integer;  // первый непробельный символ строки, 1-базовый
    FirstWordPos: Integer; // первое ЗНАЧАЩЕЕ слово: модификаторы начала
    // строки (Public, Private) пропущены
    LastPos: Integer;   // последний непробельный; < FirstPos у пустой строки
    CmtPos: Integer;    // начало строчного комментария, иначе LastPos + 1
    Indent: Integer;    // ведущих пробельных символов
    Empty: Boolean;     // в строке одни пробелы
    Inside: Boolean;    // строка начинается внутри блочного комментария или литерала
    Code: string;       // кодовая часть строки, без хвостового комментария
    First: string;      // первое слово строки
    Last: string;       // последнее слово кодовой части
    IsHeader: Boolean;  // заголовок подпрограммы (SubList)
    IsOutdent: Boolean; // строка пишется левее (FmtOutdent)
    IsSect: Boolean;    // раздел объявлений (FmtSection)
    IsOpen: Boolean;    // слово открытия блока (SubOpen)
    IsHang: Boolean;    // слово переноса оператора (FmtHang)
    // else самого case: пишется вровень с case, а за ним - список
    // операторов до end на уровне веток, без переноса как у if
    CaseElse: Boolean;
  end;

  // СОСТОЯНИЕ РАЗБОРА БЛОКОВ. Depth - вложенность, Hang - сколько уровней
  // добавил оператор без begin, стек - открытые подпрограммы. Tags хранит
  // произвольный номер записи (списку подпрограмм - индекс в FSubs),
  // Closed за строку отдаёт закрывшиеся: ClosedAtBegin помечает те, у
  // которых тела не было вовсе (forward, external).
  TBlockState = record
    Depth: Integer;
    Hang: Integer;
    // Hang, с которым открыт блок глубины N (HangBase[N]): begin под
    // then/do без своего begin у if - его тело правее на этот перенос, и
    // конец оператора (;) внутри блока возвращает Hang к нему, а не к нулю.
    // Иначе первая же ; внутри begin..end цикла, стоящего под if ... then,
    // сбрасывала перенос if, и следующие строки и end съезжали влево.
    HangBase: TIntArray;
    Paren: Integer;      // незакрытых круглых скобок
    InSection: Boolean;  // идём под var, type или const
    Top: Integer;        // вершина стека подпрограмм, -1 - пусто
    // Идём ВЫШЕ слова из раздела SubScope (в Паскале - implementation).
    // Там procedure и function - объявления без тел, и заголовками их
    // считать нельзя: иначе каждое следующее объявление вставало бы на
    // уровень правее предыдущего. В файле без этого слова (.dpr) поле
    // сразу False - заголовки считаются с первой строки.
    BeforeScope: Boolean;
    StartDepth: TIntArray;
    Tags: TIntArray;
    Opened: array of Boolean;
    DeclBlock: array of Boolean; // уровень открыт объявлением, а не кодом
    CaseBlock: array of Boolean; // уровень открыт словом case
    // РЕЖИМ ТЕГОВ (SubStyle tags). Стек имён открытых тегов: закрывающий
    // </name> сматывает его до парного имени, а не опускает уровень на
    // единицу. Так незакрытые <p> и <li> снимаются вместе с объемлющим
    // </td>, а лишнее закрытие - например, парное тегу, оставшемуся в
    // незакрытом комментарии, - просто не учитывается.
    // Opaque - имя тега, внутри которого разбор не идёт: script и style.
    TagStack: array of string;
    TagTop: Integer;
    Opaque: string;
    // Односимвольные слова блоков схемы: { и } в C-подобных языках.
    // Заполняет BlockInit - чтобы на каждую запятую и точку не лазить
    // в три списка.
    Chars: TSysCharSet;
    ClosedCount: Integer;
    Closed: TIntArray;
    ClosedAtBegin: array of Boolean;
  end;
  TBigIntArr = array[0..(MaxInt div SizeOf(Integer)) - 1] of Integer;
  PBigIntArr = ^TBigIntArr;

  // Сведения о длинной строке - см. GetLineInfo
  TLineInfo = record
    CUsed: Boolean;
    CVer: Cardinal;      // FTextVer на момент замера
    CStart: Integer;     // индекс первого символа строки
    CLen: Integer;       // длина строки по EM_LINELENGTH (ключ)
    CN: Integer;         // сколько символов реально прочитано (до #0)
    CFont: HFONT;
    CTab: Integer;
    // Опорные точки строки: сегмент k начинается с символа CSegIdx[k]
    // (от 0) на X = CSegX[k]; CSegTab[k] <> 0 - в сегменте есть табуляция.
    // Последний элемент - конец строки: CSegIdx = CN, CSegX = ширина.
    // При построении сегменты по XBlockLen символов; правка внутри строки
    // сдвигает точки, а не строит таблицу заново - см. UpdateLineAfterEdit.
    CSegIdx: TIntArray;
    CSegX: TIntArray;
    CSegTab: TIntArray;
    CTotalW: Integer;    // ширина всей строки
    // Строчный комментарий: позиция в строке (0 - нет) и уровень "!"
    CCommentKnown: Boolean;
    CMapVer: Cardinal;   // FMapVer на момент поиска
    CLineComment: Integer;
    CCommentLevel: Integer;
    // Группа отметки строки (LineMark), -1 - слов отметки в строке нет.
    // См. ComputeLineMark
    CMarkKnown: Boolean;
    CMarkMapVer: Cardinal;
    CMarkGroup: Integer;
  end;





  // Точка останова в исходнике. Номер строки едет вместе с текстом при
  // правке (DbgLinesPost).
  TBreakMark = class
  public
    FileName: string;   // полный путь
    Line: Integer;      // с 0
    NoCode: Boolean;    // в .map у строки нет кода - точка не сработает
    Offsets: TList;     // смещения кода в сеансе отладки (Cardinal)
    // Условие RapidQ: точка стоит, только если оно выполнено. Вписывается
    // в отладочную копию (RqDbgInstr); '' - без условия.
    Condition: string;
    constructor Create(const AFileName: string; ALine: Integer);
    destructor Destroy; override;
  end;

  // Правка исходника, сделанная во время сеанса отладки: строки .map -
  // по тексту на момент сборки, а в редакторе уже другие номера. По списку
  // таких правок номер строки переводится туда и обратно (DbgLineNow,
  // DbgLineThen). Правило сдвига - то же, что у точек (DbgLinesPost).
  TDbgLineEdit = class
  public
    FileName: string;
    FirstLine: Integer;     // первая строка правки, с 0
    LastLine: Integer;      // последняя строка правки до неё
    Delta: Integer;         // сколько строк прибавилось (меньше 0 - убыло)
    KeepFirst: Boolean;     // начало первой строки левее правки
  end;

