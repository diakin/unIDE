<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="12"/>
    <PathDelim Value="\"/>
    <General>
      <Flags>
        <MainUnitHasCreateFormStatements Value="False"/>
        <MainUnitHasTitleStatement Value="False"/>
        <MainUnitHasScaledStatement Value="False"/>
      </Flags>
      <SessionStorage Value="InProjectDir"/>
      <Title Value="unIDE"/>
      <UseAppBundle Value="False"/>
      <ResourceType Value="res"/>
      <!-- Без манифеста тем Windows, как сборка Delphi 7: свои Ui* рисуют сами (UiThemeNativeFor = False), стандартные элементы - классические -->
      <UseXPManifest Value="False"/>
      <Icon Value="0"/>
    </General>
    <BuildModes>
      <Item Name="Win32" Default="True"/>
      <Item Name="Win64">
        <CompilerOptions>
          <Version Value="11"/>
          <PathDelim Value="\"/>
          <Target>
            <Filename Value="..\Output\SyntaxHLClaude_laz64"/>
          </Target>
          <SearchPaths>
            <IncludeFiles Value="$(ProjOutDir);..\WebView4Delphi\source;..\RqLcl\dll\richmemo"/>
            <OtherUnitFiles Value="..\RqLcl\dll\richmemo;..\RqLcl\dll\richmemo\win32;..\WebView4Delphi\source"/>
            <UnitOutputDirectory Value="lib\$(TargetCPU)-$(TargetOS)"/>
          </SearchPaths>
          <Parsing>
            <SyntaxOptions>
              <SyntaxMode Value="Delphi"/>
            </SyntaxOptions>
          </Parsing>
          <CodeGeneration>
            <TargetCPU Value="x86_64"/>
            <TargetOS Value="win64"/>
          </CodeGeneration>
          <Linking>
            <Debugging>
              <DebugInfoType Value="dsDwarf3"/>
            </Debugging>
            <Options>
              <Win32>
                <GraphicApplication Value="True"/>
              </Win32>
            </Options>
          </Linking>
          <Other>
            <CustomOptions Value="-vm5023,5024,5025,5027,5028,5029,6058,5066,5043"/>
          </Other>
        </CompilerOptions>
      </Item>
      <!-- Linux (gtk2): модули-заменители WinAPI в lazarus/unix (Windows, Messages и др., WinImpl).
           Умная компоновка обязательна: реализованы только вызовы WinAPI, которые программа использует -->
      <Item Name="Linux64">
        <CompilerOptions>
          <Version Value="11"/>
          <PathDelim Value="\"/>
          <Target>
            <Filename Value="..\Output\SyntaxHLClaude_linux64"/>
          </Target>
          <SearchPaths>
            <IncludeFiles Value="$(ProjOutDir);..\lazarus\unix\wininc"/>
            <OtherUnitFiles Value="..\lazarus\unix;..\WebView4Delphi\source"/>
            <UnitOutputDirectory Value="lib\$(TargetCPU)-$(TargetOS)"/>
          </SearchPaths>
          <Parsing>
            <SyntaxOptions>
              <SyntaxMode Value="Delphi"/>
            </SyntaxOptions>
          </Parsing>
          <CodeGeneration>
            <SmartLinkUnit Value="True"/>
            <TargetCPU Value="x86_64"/>
            <TargetOS Value="linux"/>
          </CodeGeneration>
          <Linking>
            <Debugging>
              <DebugInfoType Value="dsDwarf3"/>
            </Debugging>
            <LinkSmart Value="True"/>
          </Linking>
          <Other>
            <CustomOptions Value="-vm5023,5024,5025,5027,5028,5029,6058,5066,5043"/>
          </Other>
        </CompilerOptions>
      </Item>
    </BuildModes>
    <PublishOptions>
      <Version Value="2"/>
    </PublishOptions>
    <RunParams>
      <FormatVersion Value="2"/>
    </RunParams>
    <RequiredPackages>
      <Item>
        <PackageName Value="LCL"/>
      </Item>
      <Item>
        <PackageName Value="TurboPowerIPro"/>
      </Item>
    </RequiredPackages>
    <Units>
      <Unit>
        <Filename Value="SyntaxHLClaude.lpr"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="SyntaxHLClaude"/>
      </Unit>
    </Units>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <PathDelim Value="\"/>
    <Target>
      <Filename Value="..\Output\SyntaxHLClaude_laz32"/>
    </Target>
    <SearchPaths>
      <IncludeFiles Value="$(ProjOutDir);..\WebView4Delphi\source;..\RqLcl\dll\richmemo"/>
      <OtherUnitFiles Value="..\RqLcl\dll\richmemo;..\RqLcl\dll\richmemo\win32;..\WebView4Delphi\source"/>
      <UnitOutputDirectory Value="lib\$(TargetCPU)-$(TargetOS)"/>
    </SearchPaths>
    <Parsing>
      <SyntaxOptions>
        <SyntaxMode Value="Delphi"/>
      </SyntaxOptions>
    </Parsing>
    <CodeGeneration>
      <TargetCPU Value="i386"/>
      <TargetOS Value="win32"/>
    </CodeGeneration>
    <Linking>
      <Debugging>
        <DebugInfoType Value="dsDwarf3"/>
      </Debugging>
      <Options>
        <Win32>
          <GraphicApplication Value="True"/>
        </Win32>
      </Options>
    </Linking>
    <Other>
      <CustomOptions Value="-vm5023,5024,5025,5027,5028,5029,6058,5066,5043"/>
    </Other>
  </CompilerOptions>
</CONFIG>
